    function collectSalarySetup() {
      const type = salaryEl('nvSalaryType')?.value || '';
      const isShift = type === 'theo_ca';
      const isHourly = type === 'theo_gio';
      const isStandardDay = type === 'theo_ngay';
      const isMonthly = type === 'theo_thang';
      const advancedEnabled = isShift ? !!salaryEl('nvShiftAdvancedEnabled')?.checked : (isHourly ? !!salaryEl('nvHourlyAdvancedEnabled')?.checked : (isStandardDay ? !!salaryEl('nvStandardDayAdvancedEnabled')?.checked : false));
      const shiftConditionRows = isShift && advancedEnabled ? collectAdvancedConditionRows('nvShiftAdvancedRows') : [];
      let amount = isShift ? salaryNumber(salaryEl('nvShiftSalaryAmount')?.value)
        : (isHourly ? salaryNumber(salaryEl('nvHourlySalaryAmount')?.value)
        : (isStandardDay ? salaryNumber(salaryEl('nvStandardDaySalaryAmount')?.value)
        : (isMonthly ? salaryNumber(salaryEl('nvMonthlySalaryAmount')?.value) : 0)));
      if (isShift && advancedEnabled) {
        amount = readShiftDefaultSalaryAmount();
      }
      const overtime = (isShift || isStandardDay) ? (isStandardDay ? collectOvertime('theo_ngay') : collectOvertime('theo_ca')) : {
        enabled: false,
        he_so_ngay_thuong: 150,
        he_so_ngay_thuong_kieu: 'phan_tram',
        he_so_thu_7: 200,
        he_so_thu_7_kieu: 'phan_tram',
        he_so_chu_nhat: 200,
        he_so_chu_nhat_kieu: 'phan_tram',
        he_so_ngay_nghi: 200,
        he_so_ngay_nghi_kieu: 'phan_tram',
        he_so_ngay_le_tet: 300,
        he_so_ngay_le_tet_kieu: 'phan_tram'
      };
      const bonusEnabled = !!salaryEl('nvBonusEnabled')?.checked;
      const commissionEnabled = !!salaryEl('nvCommissionEnabled')?.checked;
      const allowanceEnabled = !!salaryEl('nvAllowanceEnabled')?.checked;
      const deductionEnabled = !!salaryEl('nvDeductionEnabled')?.checked;
      const bonusRules = collectSalaryRows('nvBonusRows', row => {
        const input = row.querySelector('input');
        const bonusButton = row.querySelector('.nv-bonus-value-btn');
        const rule = { tu_doanh_thu: salaryNumber(input?.value), gia_tri_thuong: salaryNumber(bonusButton?.dataset.value) };
        return rule.tu_doanh_thu || rule.gia_tri_thuong ? rule : null;
      });
      const bonusUnit = document.querySelector('#nvBonusRows .nv-bonus-value-btn')?.dataset.unit || bonusMethodToUnit(salaryEl('nvBonusMethod')?.value);
      const commissionRules = collectSalaryRows('nvCommissionRows', row => {
        const revenueInput = row.querySelector('.nv-salary-money-input input') || row.querySelector('input[type="number"]');
        const loaiHinh = row.querySelector('.nv-commission-loai-hinh')?.value || 'tu_van_ban_hang';
        const valueBtn = row.querySelector('.nv-commission-value-btn');
        const unit = valueBtn?.dataset.unit === 'vnd' ? 'so_tien' : 'phan_tram';
        const rule = {
          loai_hinh: loaiHinh,
          tu_doanh_thu: salaryNumber(revenueInput?.value),
          kieu_hoa_hong: unit,
          gia_tri_hoa_hong: salaryNumber(valueBtn?.dataset.value)
        };
        return rule.tu_doanh_thu || rule.gia_tri_hoa_hong ? rule : null;
      });
      const allowanceItems = collectSalaryRows('nvAllowanceRows', row => {
        const selects = row.querySelectorAll('select');
        const input = row.querySelector('input');
        const allowanceName = selects[0]?.value === '__add_allowance_type' ? '' : (selects[0]?.value || '');
        const allowanceType = selects[1]?.value === 'theo_ngay_cong_chuan' ? 'theo_ngay_cong' : (selects[1]?.value || 'co_dinh_theo_thang');
        const item = { ten_phu_cap: allowanceName, loai_phu_cap: allowanceType, so_tien: salaryNumber(input?.value) };
        return item.ten_phu_cap || item.so_tien ? item : null;
      });
      const deductionItems = collectSalaryRows('nvDeductionRows', row => {
        const selects = row.querySelectorAll('select');
        const input = row.querySelector('input');
        const deductionName = selects[0]?.value === '__add_deduction_type' ? '' : (selects[0]?.value || '');
        const conditionButton = row.querySelector('.deduction-condition-button');
        const item = { ten_giam_tru: deductionName, loai_giam_tru: selects[1]?.value || 'khac', kieu_tinh: conditionButton?.dataset.value || 'theo_so_lan', gia_tri: salaryNumber(input?.value) };
        return item.ten_giam_tru || item.gia_tri ? item : null;
      });
      const enabled = !!type || amount > 0 || shiftConditionRows.length > 0 || advancedEnabled || overtime.enabled || bonusEnabled || commissionEnabled || allowanceEnabled || deductionEnabled;
      return {
        enabled: enabled,
        loai_luong: type || 'theo_ca',
        muc_luong: amount,
        nang_cao: advancedEnabled,
        muc_luong_nang_cao: collectAdvancedSalary(type || 'theo_ca'),
        lam_them_gio: overtime,
        thuong: {
          enabled: bonusEnabled,
          loai_thuong: salaryEl('nvBonusType')?.value || 'doanh_thu_ca_nhan',
          hinh_thuc: bonusUnitToMethod(bonusUnit),
          rules: bonusRules
        },
        hoa_hong: {
          enabled: commissionEnabled,
          rules: commissionRules
        },
        phu_cap: {
          enabled: allowanceEnabled,
          items: allowanceItems
        },
        giam_tru: {
          enabled: deductionEnabled,
          items: deductionItems
        }
      };
    }

