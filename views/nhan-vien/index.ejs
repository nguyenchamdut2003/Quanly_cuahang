    function toIsoDate(v) {
      if (!v) return '';
      const d = new Date(v);
      if (Number.isNaN(d.getTime())) return '';
      return d.toISOString().slice(0, 10);
    }

    function setAvatarPreview(url, name) {
      const el = document.getElementById('nvAvatarPreview');
      const letter = (name || 'N').trim().charAt(0).toUpperCase();
      if (url) {
        el.innerHTML = '<img src="' + url.replace(/"/g, '&quot;') + '" alt="">';
      } else {
        el.textContent = letter;
      }
    }

    function salaryEl(id) {
      return document.getElementById(id);
    }

    function salaryNumber(value) {
      const raw = String(value == null ? '' : value).replace(/[^0-9.-]/g, '');
      const number = Number(raw);
      return Number.isFinite(number) && number > 0 ? number : 0;
    }

    function salarySetValue(id, value) {
      const el = salaryEl(id);
      if (el) el.value = value == null ? '' : value;
    }

    function salarySetChecked(id, checked) {
      const el = salaryEl(id);
      if (el) el.checked = !!checked;
    }

    function salarySetSelect(select, value) {
      if (!select) return;
      const nextValue = value == null ? '' : String(value);
      if (nextValue && !Array.prototype.some.call(select.options, option => option.value === nextValue)) {
        const option = document.createElement('option');
        option.value = nextValue;
        option.textContent = nextValue;
        select.appendChild(option);
      }
      select.value = nextValue;
    }

    function salaryPercent(value, fallback) {
      const number = salaryNumber(value);
      return String(number || fallback || 0) + '%';
    }

    function salaryRateLabel(value, unit) {
      const number = salaryNumber(value);
      if (!number) return '+';
      return unit === 'vnd' ? number.toLocaleString('vi-VN') + ' VND' : number + '%';
    }

    function setAdvancedRateButton(button, value, unit) {
      if (!button) return;
      const number = salaryNumber(value);
      const nextUnit = unit === 'vnd' ? 'vnd' : 'phan_tram';
      button.dataset.value = String(number);
      button.dataset.unit = nextUnit;
      button.textContent = salaryRateLabel(number, nextUnit);
      button.classList.toggle('has-value', number > 0);
    }

