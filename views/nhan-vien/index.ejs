    function renderSalarySetup(salary) {
      salary = salary || {};
      const type = salary.loai_luong || '';
      salarySetValue('nvSalaryType', type);
      salarySetValue('nvSalaryTemplate', '');
      salarySetValue('nvShiftSalaryAmount', type === 'theo_ca' ? Number(salary.muc_luong || 0) : '');
      salarySetValue('nvHourlySalaryAmount', type === 'theo_gio' ? Number(salary.muc_luong || 0) : '');
      salarySetValue('nvStandardDaySalaryAmount', type === 'theo_ngay' ? Number(salary.muc_luong || 0) : '');
      salarySetValue('nvMonthlySalaryAmount', type === 'theo_thang' ? Number(salary.muc_luong || 0) : '');
      salarySetChecked('nvShiftAdvancedEnabled', type === 'theo_ca' && !!salary.nang_cao);
      salarySetChecked('nvHourlyAdvancedEnabled', type === 'theo_gio' && !!salary.nang_cao);
      salarySetChecked('nvStandardDayAdvancedEnabled', type === 'theo_ngay' && !!salary.nang_cao);
      fillAdvancedSalary('theo_ca', salary.muc_luong_nang_cao);
      fillAdvancedSalary('theo_gio', salary.muc_luong_nang_cao);
      fillAdvancedSalary('theo_ngay', salary.muc_luong_nang_cao);
      if (type === 'theo_ca') {
        const shiftDefaultInput = salaryFirstRowInputs('nvShiftAdvancedRows')[0];
        if (shiftDefaultInput) shiftDefaultInput.value = Number(salary.muc_luong || 0);
      }
      fillOvertime('theo_ca', salary.lam_them_gio);
      fillOvertime('theo_ngay', salary.lam_them_gio);
      salarySetChecked('nvBonusEnabled', salary.thuong && salary.thuong.enabled);
      salarySetValue('nvBonusType', salary.thuong?.loai_thuong || 'doanh_thu_ca_nhan');
      salarySetValue('nvBonusMethod', salary.thuong?.hinh_thuc || 'phan_tram_doanh_thu');
      renderBonusRows(salary.thuong?.rules || []);
      salarySetChecked('nvCommissionEnabled', salary.hoa_hong && salary.hoa_hong.enabled);
      renderCommissionRows(salary.hoa_hong?.rules || []);
      salarySetChecked('nvAllowanceEnabled', salary.phu_cap && salary.phu_cap.enabled);
      renderAllowanceRows(salary.phu_cap?.items || []);
      salarySetChecked('nvDeductionEnabled', salary.giam_tru && salary.giam_tru.enabled);
      renderDeductionRows(salary.giam_tru?.items || []);
      updateSalaryUi();
    }

