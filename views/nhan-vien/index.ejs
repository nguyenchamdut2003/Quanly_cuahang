<%
  const fmt = n => Number(n || 0).toLocaleString('vi-VN');
  const statusLabel = s => s === 'da_nghi' ? 'Đã nghỉ' : 'Đang làm việc';
  const statusClass = s => s === 'da_nghi' ? 'is-inactive' : 'is-active';
  const formatDate = v => {
    if (!v) return '---';
    const d = new Date(v);
    if (Number.isNaN(d.getTime())) return '---';
    return d.toLocaleDateString('vi-VN');
  };
%>
<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/stylesheets/style.css">
  <link rel="stylesheet" href="/stylesheets/responsive.css">
  <style>
    .employee-page{background:#f3f6f9;min-height:calc(100vh - 98px)}
    .employee-page .admin-shell{width:auto;max-width:none;margin:0;padding:30px}
    .employee-shell{display:grid;grid-template-columns:260px minmax(0,1fr);gap:12px;padding:0}
    .employee-main{background:#fff;border:1px solid #d7dde5;border-radius:8px;display:flex;flex-direction:column;min-height:calc(100vh - 140px)}
    .employee-toolbar{display:flex;align-items:center;gap:12px;padding:12px 14px;border-bottom:1px solid #e5e9ee;flex-wrap:wrap}
    .employee-toolbar h1{margin:0;font-size:20px;font-weight:700;flex:1}
    .employee-search{display:flex;align-items:center;gap:8px;background:#fff;border:1px solid #0070f4;border-radius:8px;padding:0 12px;height:34px;min-width:280px}
    .employee-search input{border:0;outline:0;flex:1;font-size:13px}
    .employee-table-wrap{overflow:visible;flex:1}
    .employee-table{width:100%;border-collapse:collapse;min-width:0;table-layout:fixed}
    .employee-table thead th{position:sticky;top:0;background:#e8f3ff;color:#111827;font-size:12px;font-weight:700;height:36px;padding:0 8px;text-align:left;border-bottom:1px solid #bcd9ff;white-space:normal;line-height:1.25}
    .employee-table tbody td{padding:8px;border-bottom:1px solid #e5e9ee;font-size:12px;line-height:1.35;vertical-align:middle;white-space:normal;overflow-wrap:anywhere}
    .employee-table th:nth-child(1),.employee-table td:nth-child(1){width:48px}
    .employee-table th:nth-child(2),.employee-table td:nth-child(2){width:135px}
    .employee-table th:nth-child(3),.employee-table td:nth-child(3){width:95px}
    .employee-table th:nth-child(4),.employee-table td:nth-child(4){width:210px}
    .employee-table th:nth-child(5),.employee-table td:nth-child(5){width:100px}
    .employee-table th:nth-child(6),.employee-table td:nth-child(6){width:135px}
    .employee-table th:nth-child(9),.employee-table td:nth-child(9){width:92px}
    .employee-table th:nth-child(11),.employee-table td:nth-child(11){width:96px}
    .employee-table th:nth-child(12),.employee-table td:nth-child(12){width:78px}
    .employee-table tbody tr:hover{background:#f8fbff}
    .employee-table tbody tr.is-selected{background:#f7fbff;outline:1px solid #0070f4;outline-offset:-1px}
    .employee-detail-row td{padding:0!important;background:#fff;border-bottom:1px solid #0070f4}
    .employee-detail-panel{border:1px solid #0070f4;border-top:0;background:#fff}
    .employee-detail-tabs{display:flex;align-items:center;gap:18px;height:36px;padding:0 20px;border-bottom:1px solid #e5e9ee}
    .employee-detail-tab{height:36px;border:0;background:transparent;border-bottom:2px solid transparent;padding:0 2px;color:#475467;font-size:12px;cursor:pointer}
    .employee-detail-tab.is-active{color:#0070f4;border-bottom-color:#0070f4;font-weight:700}
    .employee-detail-content{padding:20px}
    .employee-detail-info{display:grid;grid-template-columns:120px repeat(4,minmax(0,1fr));gap:18px 20px;align-items:start}
    .employee-detail-photo{width:100px;height:98px;background:#e5e7eb;border:1px solid #d8dde5;display:flex;align-items:center;justify-content:center;color:#9aa3af;font-size:36px;font-weight:700;overflow:hidden}
    .employee-detail-photo img{width:100%;height:100%;object-fit:cover}
    .employee-detail-field{min-height:52px;border-bottom:1px solid #e1e6ee;padding-bottom:8px}
    .employee-detail-label{display:block;margin-bottom:7px;color:#64748b;font-size:11px}
    .employee-detail-value{display:block;color:#111827;font-size:13px;min-height:18px;word-break:break-word}
    .employee-detail-value.is-link{color:#0070f4;font-weight:700}
    .employee-detail-note{width:100%;min-height:44px;border:1px solid #cfd8e3;border-radius:6px;padding:9px 10px;color:#64748b;font-size:13px;resize:vertical}
    .employee-detail-actions{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:12px;padding:12px 20px;border-top:1px solid #edf0f3}
    .employee-detail-left{display:flex;align-items:center;gap:8px;color:#344054;font-size:13px;font-weight:700}
    .employee-detail-right{display:flex;align-items:center;gap:8px}
    .employee-detail-placeholder{min-height:150px;display:flex;align-items:center;justify-content:center;background:#f8fafc;border:1px dashed #d8dde5;border-radius:6px;color:#64748b;font-size:13px}
    .employee-schedule-toolbar{display:flex;align-items:center;gap:10px;margin-bottom:16px;flex-wrap:wrap}
    .employee-schedule-select,.employee-week-btn{height:30px;border:1px solid #cfd8e3;border-radius:6px;background:#fff;color:#111827;font-size:12px;padding:0 10px}
    .employee-week-nav{height:30px;border:1px solid #cfd8e3;border-radius:6px;background:#fff;display:inline-flex;align-items:center;overflow:hidden}
    .employee-week-nav button{width:28px;height:100%;border:0;background:#fff;color:#475467;cursor:pointer}
    .employee-week-nav span{min-width:132px;text-align:center;font-size:12px;color:#111827}
    .employee-schedule-table-wrap{overflow:visible;border-bottom:1px solid #e5e9ee}
    .employee-schedule-table{width:100%;border-collapse:collapse;table-layout:fixed}
    .employee-schedule-table th{height:36px;background:#f0f1f3;border:1px solid #dde2e8;border-left:0;color:#111827;font-size:13px;text-align:left;padding:0 8px}
    .employee-schedule-table th:first-child{border-left:1px solid #dde2e8;width:220px}
    .employee-schedule-table td{height:38px;border:1px solid #e1e6ee;border-left:0;padding:5px 8px;font-size:13px;vertical-align:middle}
    .employee-schedule-table td:first-child{border-left:1px solid #e1e6ee}
    .employee-schedule-shift strong{display:block;font-size:13px;color:#111827}
    .employee-schedule-shift span{display:block;font-size:12px;color:#111827}
    .employee-schedule-check{text-align:center;color:#0070f4;font-size:16px;font-weight:800}
    .employee-day-badge{display:inline-flex;align-items:center;justify-content:center;width:22px;height:22px;border-radius:50%;background:#0070f4;color:#fff;margin-left:4px}
    .employee-schedule-actions{display:flex;justify-content:flex-end;margin-top:34px}
    .employee-salary-pane{padding:6px 0 0}
    .employee-salary-meta{display:grid;grid-template-columns:115px minmax(0,1fr);gap:12px 10px;max-width:520px;margin-bottom:8px;font-size:13px}
    .employee-salary-label{font-weight:800;color:#111827}
    .employee-salary-muted{color:#8a94a3}
    .employee-salary-table{width:100%;border-collapse:collapse;table-layout:fixed;margin:8px 0 18px}
    .employee-salary-table th{height:32px;background:#f0f1f3;border-bottom:1px solid #d8dde5;color:#111827;font-size:12px;text-align:left;padding:0 8px}
    .employee-salary-table th:not(:first-child),.employee-salary-table td:not(:first-child){text-align:right}
    .employee-salary-table td{height:30px;border-bottom:1px solid #e1e6ee;color:#111827;font-size:13px;padding:4px 8px}
    .employee-salary-table th:first-child{width:42%}
    .employee-salary-lines{display:grid;grid-template-columns:115px minmax(0,1fr);gap:12px 10px;max-width:540px;font-size:13px}
    .employee-salary-actions{display:flex;justify-content:flex-end;margin-top:28px}
    .employee-payroll-toolbar{display:flex;align-items:center;margin-bottom:14px}
    .employee-payroll-filter{height:30px;width:150px;border:1px solid #cfd8e3;border-radius:6px;background:#fff;color:#111827;font-size:12px;padding:0 10px}
    .employee-payroll-table{width:100%;border-collapse:collapse;table-layout:fixed}
    .employee-payroll-table th{height:32px;background:#f0f1f3;border-bottom:1px solid #d8dde5;color:#111827;font-size:12px;text-align:left;padding:0 8px}
    .employee-payroll-table td{height:30px;border-bottom:1px solid #e1e6ee;color:#111827;font-size:13px;padding:4px 8px}
    .employee-payroll-table th:nth-child(1){width:145px}
    .employee-payroll-table th:nth-child(2){width:230px}
    .employee-payroll-table th:nth-child(3),.employee-payroll-table th:nth-child(4),.employee-payroll-table th:nth-child(5){text-align:right}
    .employee-payroll-table td:nth-child(3),.employee-payroll-table td:nth-child(4),.employee-payroll-table td:nth-child(5){text-align:right}
    .employee-payroll-link{color:#0070f4;text-decoration:none;font-weight:500}
    .employee-payroll-actions{display:flex;justify-content:flex-end;margin-top:38px}
    .emp-avatar{width:36px;height:36px;border-radius:50%;object-fit:cover;background:#e8f3ff;display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:700;color:#0070f4}
    .emp-avatar img{width:100%;height:100%;border-radius:50%;object-fit:cover}
    .employee-empty{padding:60px 20px;text-align:center;color:#475467;font-size:14px}
    .employee-empty a{color:#0070f4;font-weight:600;cursor:pointer}
    .status-pill{display:inline-flex;align-items:center;height:22px;padding:0 8px;border-radius:5px;font-size:11px;font-weight:700}
    .status-pill.is-active{background:#dcfce7;color:#166534}
    .status-pill.is-inactive{background:#fee2e2;color:#991b1b}
    .hr-btn-icon{border:1px solid #cfd8e3;background:#fff;border-radius:6px;width:30px;height:28px;cursor:pointer;color:#344054}
    .nv-modal-overlay{position:fixed;inset:0;background:rgba(15,23,42,.45);display:none;align-items:center;justify-content:center;z-index:1200;padding:16px}
    .nv-modal-overlay.is-open{display:flex}
    .nv-modal{background:#fff;border-radius:10px;width:min(920px,100%);max-height:92vh;display:flex;flex-direction:column;box-shadow:0 20px 50px rgba(0,0,0,.2)}
    .nv-modal-head{padding:16px 20px;border-bottom:1px solid #e5e9ee;font-size:18px;font-weight:700}
    .nv-tabs{display:flex;gap:0;border-bottom:1px solid #e5e9ee;padding:0 20px}
    .nv-tab{border:0;background:transparent;height:42px;padding:0 16px;font-size:13px;font-weight:600;color:#64748b;border-bottom:2px solid transparent;cursor:pointer}
    .nv-tab.is-active{color:#0070f4;border-bottom-color:#0070f4}
    .nv-modal-body{padding:16px 20px;overflow:auto;flex:1}
    .nv-section{margin-bottom:18px}
    .nv-section h3{margin:0 0 10px;font-size:14px;font-weight:700;color:#111827}
    .nv-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
    .nv-grid label{display:grid;gap:4px;font-size:12px;color:#475467}
    .nv-grid input,.nv-grid select,.nv-grid textarea{height:34px;border:1px solid #cfd8e3;border-radius:7px;padding:0 10px;font-size:13px}
    .nv-grid textarea{height:70px;padding:8px 10px;resize:vertical}
    .nv-grid .span-2{grid-column:span 2}
    .nv-avatar-row{display:flex;align-items:center;gap:14px;margin-bottom:12px}
    .nv-avatar-preview{width:72px;height:72px;border-radius:50%;background:#e8f3ff;display:flex;align-items:center;justify-content:center;overflow:hidden;font-size:24px;font-weight:700;color:#0070f4}
    .nv-avatar-preview img{width:100%;height:100%;object-fit:cover}
    .nv-placeholder{padding:40px;text-align:center;color:#64748b;background:#f8fafc;border-radius:8px}
    .nv-salary-pane{display:grid;gap:16px;background:#e5e5e5;margin:-16px -20px;padding:16px 20px}
    .nv-salary-card{background:#fff;border-radius:8px;overflow:hidden}
    .nv-salary-card-head{min-height:56px;display:flex;align-items:center;padding:0 20px;border-bottom:1px solid #edf0f3}
    .nv-salary-card-title{font-size:15px;font-weight:800;color:#202938}
    .nv-salary-row{display:grid;grid-template-columns:130px minmax(260px,360px) minmax(0,1fr);align-items:center;gap:12px;padding:16px 20px}
    .nv-salary-main-extra{display:none;border-top:1px solid #edf0f3}
    .nv-salary-main-extra.is-open{display:block}
    .nv-salary-line{min-height:60px;display:grid;grid-template-columns:130px minmax(260px,340px) minmax(0,1fr);align-items:center;gap:12px;padding:0 20px;border-bottom:1px solid #edf0f3}
    .nv-salary-line:last-child{border-bottom:0}
    .nv-salary-label{font-size:13px;font-weight:700;color:#111827}
    .nv-salary-select{width:100%;height:34px;border:1px solid #cfd8e3;border-radius:7px;padding:0 10px;background:#fff;font-size:13px;color:#475467}
    .nv-salary-amount-wrap{height:34px;border:1px solid #cfd8e3;border-radius:7px;display:grid;grid-template-columns:minmax(0,1fr) 48px;align-items:center;background:#fff;overflow:hidden}
    .nv-salary-amount-wrap input{width:100%;height:100%;border:0;outline:0;padding:0 12px;text-align:right;font-size:13px}
    .nv-salary-unit{height:100%;display:flex;align-items:center;justify-content:center;color:#667085;border-left:1px solid #edf0f3;font-size:13px}
    .nv-salary-line-actions{display:flex;align-items:center;justify-content:flex-end;gap:12px;color:#344054;font-size:13px}
    .nv-salary-info{display:inline-flex;align-items:center;justify-content:center;width:16px;height:16px;border:1px solid #94a3b8;border-radius:50%;font-size:10px;color:#64748b;font-weight:800;margin-left:8px}
    .nv-shift-basic.is-hidden{display:none}
    .nv-shift-advanced{display:none;border-bottom:1px solid #edf0f3}
    .nv-shift-advanced.is-open{display:block}
    .nv-shift-advanced-head{min-height:54px;display:grid;grid-template-columns:130px minmax(0,1fr);align-items:center;gap:12px;padding:0 20px}
    .nv-shift-advanced-table-wrap{padding:0 20px 16px;overflow-x:auto}
    .nv-shift-table{width:100%;border-collapse:separate;border-spacing:0;table-layout:fixed}
    .nv-shift-table th{height:40px;background:#e2e2e2;color:#344054;font-size:12px;font-weight:800;text-align:left;padding:0 10px}
    .nv-shift-table th:first-child{border-radius:8px 0 0 0}
    .nv-shift-table th:last-child{border-radius:0 8px 0 0}
    .nv-shift-table td{height:44px;border-bottom:1px solid #e5e7eb;padding:4px 10px;font-size:13px;color:#344054}
    .nv-shift-table input{width:100%;height:32px;border:1px solid #cfd8e3;border-radius:7px;padding:0 10px;font-size:13px;min-width:0}
    .nv-shift-table select{width:100%;height:32px;border:1px solid #cfd8e3;border-radius:7px;padding:0 10px;font-size:13px;background:#fff;color:#344054;min-width:0}
    .nv-shift-plus{width:100%;height:32px;border:1px solid transparent;background:transparent;color:#7a8794;border-radius:7px;font-size:22px;line-height:1;cursor:pointer;text-align:center;min-width:0}
    .nv-shift-plus.has-value{border-color:#cfd8e3;background:#fff;color:#344054;font-size:13px;text-align:left;padding:0 12px}
    .nv-shift-add-link{margin-top:14px;border:0;background:transparent;color:#0070f4;font-size:13px;font-weight:700;cursor:pointer;padding:0}
    .nv-rate-popover{position:fixed;z-index:2500;width:310px;background:#fff;border-radius:8px;box-shadow:0 12px 30px rgba(15,23,42,.22);padding:16px;display:none}
    .nv-rate-popover.is-open{display:block}
    .nv-rate-input-wrap{height:32px;border:1px solid #cfd8e3;border-radius:7px;display:grid;grid-template-columns:minmax(0,1fr) 38px 38px;align-items:center;overflow:hidden}
    .nv-rate-input-wrap input{height:100%;border:0;outline:0;padding:0 12px;text-align:right;font-size:13px}
    .nv-rate-unit{height:24px;border:0;background:#fff;color:#344054;font-size:12px;font-weight:700;cursor:pointer}
    .nv-rate-unit.is-active{background:#0070f4;color:#fff;border-radius:5px}
    .nv-rate-actions{display:flex;justify-content:flex-end;gap:8px;margin-top:14px}
    .nv-bonus-popover{position:fixed;z-index:2500;width:222px;background:#fff;border-radius:8px;box-shadow:0 12px 30px rgba(15,23,42,.22);padding:14px;display:none}
    .nv-bonus-popover.is-open{display:block}
    .nv-bonus-popover-title{font-size:13px;color:#344054;margin-bottom:8px}
    .nv-bonus-unit-row{display:flex;align-items:center;gap:16px;margin-bottom:12px}
    .nv-bonus-unit-row label{display:inline-flex;align-items:center;gap:6px;font-size:13px;color:#344054}
    .nv-bonus-unit-row input{width:15px;height:15px;accent-color:#0070f4}
    .nv-bonus-field{display:grid;gap:6px;margin-bottom:12px}
    .nv-bonus-field label{font-size:13px;color:#344054}
    .nv-bonus-field input{height:32px;border:1px solid #cfd8e3;border-radius:7px;padding:0 10px;font-size:13px}
    .nv-bonus-actions{display:flex;justify-content:flex-end;gap:8px}
    .nv-overtime-config{display:none;padding:0 20px 16px;border-top:1px solid #edf0f3;overflow-x:auto}
    .nv-overtime-config.is-open{display:block}
    .nv-overtime-table{width:100%;border-collapse:separate;border-spacing:0;margin-top:12px;table-layout:fixed}
    .nv-overtime-table th{height:40px;background:#e2e2e2;color:#344054;font-size:12px;font-weight:800;text-align:left;padding:0 10px}
    .nv-overtime-table th:first-child{border-radius:8px 0 0 0}
    .nv-overtime-table th:last-child{border-radius:0 8px 0 0}
    .nv-overtime-table td{height:44px;border-bottom:1px solid #e5e7eb;padding:4px 10px;font-size:13px;color:#344054}
    .nv-overtime-table input{width:100%;height:32px;border:1px solid #cfd8e3;border-radius:7px;padding:0 10px;font-size:13px;min-width:0}
    .nv-overtime-table .nv-shift-plus{width:100%}
    .nv-salary-option{min-height:94px;display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:center;gap:16px;padding:18px 20px}
    .nv-salary-option h4{margin:0 0 8px;font-size:15px;color:#111827}
    .nv-salary-option p{margin:0;color:#667085;font-size:12px}
    .nv-switch{position:relative;display:inline-flex;width:36px;height:20px}
    .nv-switch input{position:absolute;opacity:0;pointer-events:none}
    .nv-switch span{position:absolute;inset:0;border-radius:999px;background:#98a2b3;cursor:pointer;transition:.18s}
    .nv-switch span:before{content:"";position:absolute;width:16px;height:16px;left:2px;top:2px;border-radius:50%;background:#fff;transition:.18s;box-shadow:0 1px 2px rgba(0,0,0,.18)}
    .nv-switch input:checked + span{background:#0070f4}
    .nv-switch input:checked + span:before{transform:translateX(16px)}
    .nv-salary-config{display:none;padding:0 20px 18px}
    .nv-salary-config.is-open{display:block}
    .nv-salary-config-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px}
    .nv-salary-field{display:grid;gap:6px}
    .nv-salary-field label{font-size:13px;color:#344054}
    .nv-salary-table{width:100%;border-collapse:separate;border-spacing:0}
    .nv-salary-table th{height:40px;background:#e2e2e2;color:#344054;font-size:12px;font-weight:800;text-align:left;padding:0 18px}
    .nv-salary-table th:first-child{border-radius:8px 0 0 0}
    .nv-salary-table th:last-child{border-radius:0 8px 0 0;width:46px}
    .nv-salary-table td{height:44px;border-bottom:1px solid #e5e7eb;padding:4px 18px;font-size:13px;color:#344054}
    .nv-salary-money-input{height:32px;border:1px solid #cfd8e3;border-radius:7px;display:grid;grid-template-columns:34px minmax(0,1fr);align-items:center;overflow:hidden;background:#fff}
    .nv-salary-money-input span{height:100%;display:flex;align-items:center;justify-content:center;color:#667085;border-right:1px solid #e5e7eb}
    .nv-salary-money-input input{width:100%;height:100%;border:0;outline:0;padding:0 10px;text-align:right;font-size:13px}
    .nv-salary-percent-input{width:260px;height:32px;border:1px solid #cfd8e3;border-radius:7px;padding:0 12px;font-size:13px}
    .nv-salary-row-delete{border:0;background:transparent;color:#475467;cursor:pointer;font-size:15px}
    .nv-salary-add-link{margin-top:14px;border:0;background:transparent;color:#0070f4;font-size:13px;font-weight:700;cursor:pointer;padding:0}
    .nv-salary-save-template{display:none}
    .nv-modal-foot{padding:12px 20px 16px;border-top:1px solid #e5e9ee;display:flex;justify-content:flex-end;gap:8px}
    .employee-status-filter{display:grid;gap:12px;margin-top:10px}
    .filter-check{display:flex;align-items:center;gap:8px;font-size:13px;color:#111827;line-height:1.2}
    .filter-check input[type="radio"]{width:14px;height:14px;margin:0;accent-color:#0070f4}
    .filter-title-row{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-top:18px;margin-bottom:8px}
    .filter-title-row h4{margin:0}
    .filter-title-actions{display:inline-flex;align-items:center;gap:5px}
    .filter-action-btn{width:24px;height:24px;border:1px solid #cfd8e3;border-radius:50%;background:#fff;color:#0070f4;display:inline-flex;align-items:center;justify-content:center;cursor:pointer;font-size:12px}
    .filter-action-btn:hover{background:#e8f3ff;border-color:#0070f4}
    .filter-action-btn.is-danger{color:#ef4444}
    .filter-action-btn.is-danger:hover{background:#fef2f2;border-color:#ef4444}
    .hr-manage-modal{max-width:520px}
    .hr-manage-modal .group-modal-body{padding:18px 24px;gap:12px}
    .hr-manage-modal .group-modal-body label,.hr-manage-modal .hr-status-row{display:grid;grid-template-columns:120px minmax(0,1fr);align-items:start;gap:12px}
    .hr-manage-modal .group-modal-body span,.hr-manage-modal .hr-status-label{padding-top:9px;color:#111827;font-size:13px;font-weight:700}
    .hr-manage-modal .group-modal-body input,.hr-manage-modal .group-modal-body textarea{width:100%;border:1px solid #cfd8e3;border-radius:7px;padding:0 10px;font-size:13px;font-family:inherit}
    .hr-manage-modal .group-modal-body input{height:34px}
    .hr-manage-modal .group-modal-body textarea{min-height:56px;padding:8px 10px;resize:vertical}
    .shift-work-modal{max-width:620px}
    .shift-work-modal .group-modal-body{padding:24px}
    .shift-work-form{display:grid;gap:12px}
    .shift-work-row{display:grid;grid-template-columns:180px minmax(0,1fr);align-items:center;gap:16px}
    .shift-work-row label{font-size:13px;font-weight:700;color:#111827}
    .shift-work-row input{height:34px;border:1px solid #cfd8e3;border-radius:7px;padding:0 10px;font-size:13px}
    .shift-time-line{display:flex;align-items:center;gap:14px;flex-wrap:wrap}
    .shift-time-line input[type="time"]{width:84px}
    .shift-duration{font-size:13px;color:#344054;min-width:34px}
    .commission-table-modal{max-width:620px}
    .commission-table-modal .group-modal-body{padding:24px}
    .commission-table-form{display:grid;gap:16px}
    .commission-table-row{display:grid;grid-template-columns:110px minmax(0,1fr);align-items:start;gap:12px}
    .commission-table-row>label{font-size:13px;font-weight:700;color:#111827;padding-top:8px}
    .commission-table-row input[type="text"]{height:34px;border:1px solid #cfd8e3;border-radius:7px;padding:0 10px;font-size:13px;width:100%}
    .commission-options{display:grid;gap:12px}
    .commission-option-line{display:grid;grid-template-columns:190px minmax(0,1fr);align-items:center;gap:36px;min-height:30px}
    .commission-option-line label{display:inline-flex;align-items:center;gap:8px;font-size:13px;color:#344054}
    .commission-option-line input[type="radio"]{width:15px;height:15px;accent-color:#0070f4}
    .commission-branch-select{height:30px;border:0;border-radius:7px;background:#f0f2f5;color:#98a2b3;padding:0 12px;font-size:13px}
    .allowance-type-modal{max-width:560px}
    .allowance-type-modal .group-modal-body{padding:24px}
    .allowance-type-form{display:grid;gap:12px}
    .allowance-type-field{display:grid;gap:8px}
    .allowance-type-field label,.allowance-type-label{font-size:13px;font-weight:700;color:#111827}
    .allowance-type-field input[type="text"],.allowance-type-field input[type="number"]{height:34px;border:1px solid #cfd8e3;border-radius:7px;padding:0 10px;font-size:13px}
    .allowance-type-options{display:grid;gap:12px}
    .allowance-type-options label,.allowance-reward-row label{display:flex;align-items:center;gap:8px;font-size:13px;color:#344054}
    .allowance-type-options input[type="radio"],.allowance-reward-row input[type="radio"]{width:15px;height:15px;accent-color:#0070f4}
    .allowance-reward-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:16px;margin-top:6px}
    .allowance-reward-row{display:flex;align-items:center;gap:20px;height:34px}
    .deduction-type-modal{max-width:660px}
    .deduction-type-modal .group-modal-body{padding:24px}
    .deduction-type-form{display:grid;gap:14px}
    .deduction-type-field{display:grid;gap:8px}
    .deduction-type-field label,.deduction-type-label{font-size:13px;font-weight:700;color:#111827}
    .deduction-type-field input[type="text"],.deduction-type-field input[type="number"]{height:34px;border:1px solid #cfd8e3;border-radius:7px;padding:0 10px;font-size:13px;width:100%}
    .deduction-radio-row{display:flex;align-items:center;gap:34px;min-height:30px;flex-wrap:wrap}
    .deduction-radio-row label,.deduction-condition-list label{display:inline-flex;align-items:center;gap:8px;font-size:13px;color:#344054}
    .deduction-radio-row input[type="radio"],.deduction-condition-list input[type="radio"]{width:15px;height:15px;accent-color:#0070f4}
    .deduction-condition-list{display:grid;gap:14px}
    .deduction-block-input{display:inline-grid;grid-template-columns:52px 48px;height:30px;border-radius:7px;background:#f0f2f5;overflow:hidden;align-items:center;margin-left:6px;color:#667085}
    .deduction-block-input input{height:100%!important;border:0!important;background:transparent;text-align:right;padding:0 8px!important}
    .deduction-block-input span{border-left:1px solid #d8dde5;padding-left:8px}
    .deduction-fixed-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:16px}
    .deduction-condition-popover{position:fixed;z-index:2500;width:278px;background:#fff;border-radius:8px;box-shadow:0 12px 30px rgba(15,23,42,.22);padding:14px;display:none}
    .deduction-condition-popover.is-open{display:block}
    .deduction-condition-popover .deduction-condition-list{gap:12px}
    .deduction-condition-actions{display:flex;justify-content:flex-end;gap:8px;margin-top:14px}
    .deduction-condition-button{height:32px;border:1px solid #cfd8e3;border-radius:7px;background:#fff;padding:0 12px;text-align:left;font-size:13px;color:#344054;width:160px}
    .hr-status-options{display:flex;align-items:center;gap:22px;min-height:34px;flex-wrap:wrap}
    .hr-status-options label{display:inline-flex!important;grid-template-columns:none!important;align-items:center!important;gap:7px!important;font-size:13px;color:#344054}
    .hr-status-options input{width:15px!important;height:15px!important;padding:0!important;accent-color:#0070f4}
    .nv-modal .address-type-wrapper{position:relative}
    .nv-modal .address-type-dropdown{z-index:1300}
    .nv-grid .address-type-header{display:flex;align-items:center;gap:8px}
    .nv-grid .address-type-trigger{flex:1}
    #nvPbModalOverlay,
    #nvCdModalOverlay,
    #nvShiftWorkModalOverlay,
    #nvCommissionTableModalOverlay,
    #nvAllowanceTypeModalOverlay,
    #nvDeductionTypeModalOverlay{z-index:3200!important}
    #nvPbModalOverlay .group-modal,
    #nvCdModalOverlay .group-modal,
    #nvShiftWorkModalOverlay .group-modal,
    #nvCommissionTableModalOverlay .group-modal,
    #nvAllowanceTypeModalOverlay .group-modal,
    #nvDeductionTypeModalOverlay .group-modal{position:relative;z-index:3201}
    @media (max-width: 1100px){
      .employee-detail-info{grid-template-columns:100px repeat(2,minmax(0,1fr))}
      .employee-detail-tabs{overflow-x:auto}
      .employee-detail-tab{white-space:nowrap}
    }
  </style>
  <script type="application/json" id="phongBansSeed"><%- JSON.stringify(phongBans || []) %></script>
  <script type="application/json" id="chucDanhsSeed"><%- JSON.stringify(chucDanhs || []) %></script>
</head>
<body class="admin-body employee-page">
  <%- include('../partials/header', { activeMenu: activeMenu, user: user }) %>
  <main class="admin-shell">
    <%- include('../partials/flash-message', { flash: flash }) %>
    <div class="employee-shell">
      <aside class="customer-filter">
        <h2>Nhân viên</h2>
        <form method="get" action="/nhan-vien" id="nvFilterForm">
          <section class="customer-filter-section">
            <h4>Trạng thái nhân viên</h4>
            <div class="employee-status-filter">
              <label class="filter-check">
                <input type="radio" name="trang_thai" value="dang_lam_viec" <%= (filter.trang_thai || []).includes('dang_lam_viec') ? 'checked' : '' %>>
                <span>Đang làm việc</span>
              </label>
              <label class="filter-check">
                <input type="radio" name="trang_thai" value="da_nghi" <%= (filter.trang_thai || []).includes('da_nghi') ? 'checked' : '' %>>
                <span>Đã nghỉ</span>
              </label>
            </div>
            <div class="filter-title-row">
              <h4>Phòng ban</h4>
              <div class="filter-title-actions">
                <button type="button" class="filter-action-btn js-pb-add" title="Thêm phòng ban"><i class="fa-solid fa-plus"></i></button>
                <button type="button" class="filter-action-btn js-pb-edit" title="Sửa phòng ban"><i class="fa-regular fa-pen-to-square"></i></button>
                <button type="button" class="filter-action-btn is-danger js-pb-delete" title="Xóa phòng ban"><i class="fa-regular fa-trash-can"></i></button>
              </div>
            </div>
            <select name="phong_ban_id">
              <option value="">Chọn phòng ban</option>
              <% (phongBans || []).forEach(function(pb) { %>
                <option value="<%= pb._id %>" <%= filter.phong_ban_id === String(pb._id) ? 'selected' : '' %>><%= pb.ten_phong_ban %></option>
              <% }) %>
            </select>
            <div class="filter-title-row">
              <h4>Chức danh</h4>
              <div class="filter-title-actions">
                <button type="button" class="filter-action-btn js-cd-add" title="Thêm chức danh"><i class="fa-solid fa-plus"></i></button>
                <button type="button" class="filter-action-btn js-cd-edit" title="Sửa chức danh"><i class="fa-regular fa-pen-to-square"></i></button>
                <button type="button" class="filter-action-btn is-danger js-cd-delete" title="Xóa chức danh"><i class="fa-regular fa-trash-can"></i></button>
              </div>
            </div>
            <select name="chuc_danh_id">
              <option value="">Chọn chức danh</option>
              <% (chucDanhs || []).forEach(function(cd) { %>
                <option value="<%= cd._id %>" <%= filter.chuc_danh_id === String(cd._id) ? 'selected' : '' %>><%= cd.ten_chuc_danh %></option>
              <% }) %>
            </select>
            <input type="hidden" name="keyword" value="<%= filter.keyword || '' %>" id="nvFilterKeyword">
            <div class="customer-filter-actions" style="margin-top:12px">
              <button class="btn btn-primary" type="submit">Áp dụng</button>
              <a class="btn btn-light" href="/nhan-vien">Xóa lọc</a>
            </div>
          </section>
        </form>
      </aside>

      <section class="employee-main">
        <div class="employee-toolbar">
          <h1>Danh sách nhân viên</h1>
          <div class="employee-search">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="search" id="nvKeyword" placeholder="Tìm theo mã, tên nhân viên" value="<%= filter.keyword || '' %>">
          </div>
          <button type="button" class="btn btn-primary" id="nvAddBtn">+ Nhân viên</button>
        </div>
        <div class="employee-table-wrap">
          <table class="employee-table">
            <thead>
              <tr>
                <th>Ảnh</th><th>Mã nhân viên</th><th>Mã chấm công</th><th>Tên nhân viên</th>
                <th>Số điện thoại</th><th>Số CMND/CCCD</th><th>Phòng ban</th><th>Chức danh</th>
                <th>Nợ và tạm ứng</th><th>Ghi chú</th><th>Trạng thái</th><th>Hành động</th>
              </tr>
            </thead>
            <tbody>
              <% if (!(employees || []).length) { %>
                <tr><td colspan="12" class="employee-empty">Gian hàng chưa có nhân viên. <a id="nvEmptyAdd">Nhấn vào đây để thêm mới nhân viên</a>.</td></tr>
              <% } %>
              <% (employees || []).forEach(function(emp) {
                const pb = emp.phong_ban_id || {};
                const cd = emp.chuc_danh_id || {};
                const initials = (emp.ten_nhan_vien || 'N').trim().charAt(0).toUpperCase();
              %>
                <tr data-id="<%= emp._id %>">
                  <td>
                    <div class="emp-avatar">
                      <% if (emp.anh_dai_dien) { %><img src="<%= emp.anh_dai_dien %>" alt=""><% } else { %><%= initials %><% } %>
                    </div>
                  </td>
                  <td><%= emp.ma_nhan_vien || '---' %></td>
                  <td><%= emp.ma_cham_cong || '---' %></td>
                  <td><strong><%= emp.ten_nhan_vien || '---' %></strong></td>
                  <td><%= emp.sdt || '---' %></td>
                  <td><%= emp.cccd || '---' %></td>
                  <td><%= pb.ten_phong_ban || '---' %></td>
                  <td><%= cd.ten_chuc_danh || '---' %></td>
                  <td class="num"><%= fmt(emp.no_va_tam_ung) %></td>
                  <td><%= emp.ghi_chu || '---' %></td>
                  <td><span class="status-pill <%= statusClass(emp.trang_thai) %>"><%= statusLabel(emp.trang_thai) %></span></td>
                  <td>
                    <button type="button" class="hr-btn-icon nv-edit" title="Sửa"><i class="fa-regular fa-pen-to-square"></i></button>
                    <button type="button" class="hr-btn-icon nv-delete" title="Cho nghỉ"><i class="fa-regular fa-trash-can"></i></button>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </section>
    </div>
  </main>

  <div class="nv-modal-overlay" id="nvModal">
    <div class="nv-modal">
      <div class="nv-modal-head" id="nvModalTitle">Thêm mới nhân viên</div>
      <div class="nv-tabs">
        <button type="button" class="nv-tab is-active" data-tab="info">Thông tin</button>
        <button type="button" class="nv-tab" data-tab="salary">Thiết lập lương</button>
      </div>
      <div class="nv-modal-body">
        <div id="nvPaneInfo">
          <div class="nv-section">
            <h3>Thông tin khởi tạo</h3>
            <div class="nv-avatar-row">
              <div class="nv-avatar-preview" id="nvAvatarPreview">NV</div>
              <div>
                <label style="font-size:12px;color:#475467">Ảnh đại diện (URL)</label>
                <input type="url" id="nvAnh" placeholder="https://..." style="width:100%;height:34px;border:1px solid #cfd8e3;border-radius:7px;padding:0 10px">
              </div>
            </div>
            <div class="nv-grid">
              <label>Mã nhân viên<input id="nvMa" placeholder="Tự động nếu để trống"></label>
              <label>Tên nhân viên *<input id="nvTen" required></label>
              <label>Số điện thoại<input id="nvSdt"></label>
              <label>Mã chấm công<input id="nvMaChamCong"></label>
            </div>
          </div>
          <div class="nv-section">
            <h3>Thông tin công việc</h3>
            <div class="nv-grid">
              <label>Ngày bắt đầu làm việc<input type="date" id="nvNgayBatDau"></label>
              <label>Phòng ban
                <div class="address-type-wrapper" id="nvPbPicker">
                  <div class="address-type-header">
                    <button class="address-type-trigger" type="button" id="nvPbTrigger">
                      <span id="nvPbLabel">Chọn phòng ban</span>
                      <span>▾</span>
                    </button>
                    <button class="btn btn-primary btn-sm" type="button" id="nvPbAddBtn">Thêm</button>
                  </div>
                  <input type="hidden" id="nvPhongBan" value="">
                  <div class="address-type-dropdown" id="nvPbDropdown"></div>
                </div>
              </label>
              <label>Chức danh
                <div class="address-type-wrapper" id="nvCdPicker">
                  <div class="address-type-header">
                    <button class="address-type-trigger" type="button" id="nvCdTrigger">
                      <span id="nvCdLabel">Chọn chức danh</span>
                      <span>▾</span>
                    </button>
                    <button class="btn btn-primary btn-sm" type="button" id="nvCdAddBtn">Thêm</button>
                  </div>
                  <input type="hidden" id="nvChucDanh" value="">
                  <div class="address-type-dropdown" id="nvCdDropdown"></div>
                </div>
              </label>
              <label>Tài khoản đăng nhập
                <select id="nvNguoiDung">
                  <option value="">-- Không liên kết --</option>
                  <% (nguoiDungs || []).forEach(function(u) { %>
                    <option value="<%= u._id %>"><%= u.ho_ten || u.email %></option>
                  <% }) %>
                </select>
              </label>
              <label>Nợ và tạm ứng<input type="number" id="nvNoTamUng" min="0" step="1" value="0"></label>
              <label class="span-2">Ghi chú<textarea id="nvGhiChu"></textarea></label>
            </div>
          </div>
          <div class="nv-section">
            <h3>Thông tin cá nhân</h3>
            <div class="nv-grid">
              <label>Số CMND/CCCD<input id="nvCccd"></label>
              <label>Ngày sinh<input type="date" id="nvNgaySinh"></label>
              <label>Giới tính
                <select id="nvGioiTinh">
                  <option value="">-- Chọn --</option>
                  <option value="nam">Nam</option>
                  <option value="nu">Nữ</option>
                  <option value="khac">Khác</option>
                </select>
              </label>
            </div>
          </div>
          <div class="nv-section">
            <h3>Thông tin liên hệ</h3>
            <div class="nv-grid">
              <label>Tỉnh/Thành phố
                <select id="nvTinh" class="js-nv-province" data-selected-name="">
                  <option value="">Chọn Tỉnh/Thành phố</option>
                </select>
                <input type="hidden" id="nvTinhId">
              </label>
              <label>Xã/Phường
                <select id="nvPhuong" class="js-nv-ward" data-selected-name="">
                  <option value="">Chọn Phường/Xã</option>
                </select>
                <input type="hidden" id="nvPhuongCode">
                <input type="hidden" id="nvQuanHuyen">
                <input type="hidden" id="nvQuanHuyenId">
              </label>
              <label>Địa chỉ chi tiết<input id="nvDiaChiChiTiet"></label>
              <label>Facebook<input id="nvFacebook"></label>
              <label>Email<input type="email" id="nvEmail"></label>
            </div>
          </div>
        </div>
        <div id="nvPaneSalary" style="display:none">
          <div class="nv-salary-pane">
            <section class="nv-salary-card">
              <div class="nv-salary-card-head">
                <div class="nv-salary-card-title">Lương chính</div>
              </div>
              <div class="nv-salary-row">
                <div class="nv-salary-label">Loại lương</div>
                <select class="nv-salary-select" id="nvSalaryType">
                  <option value="">Chọn Loại lương</option>
                  <option value="theo_ca">Theo ca làm việc</option>
                  <option value="theo_gio">Theo giờ làm việc</option>
                  <option value="theo_ngay">Theo ngày công chuẩn</option>
                  <option value="theo_thang">Cố định</option>
                </select>
                <div></div>
              </div>
              <div class="nv-salary-main-extra" id="nvSalaryShiftConfig">
                <div class="nv-salary-line nv-shift-basic" id="nvShiftBasicSalary">
                  <div class="nv-salary-label">Mức lương</div>
                  <div class="nv-salary-amount-wrap">
                    <input id="nvShiftSalaryAmount" type="number" min="0">
                    <span class="nv-salary-unit">/ ca</span>
                  </div>
                  <div class="nv-salary-line-actions">
                    <span>Thiết lập nâng cao</span>
                    <label class="nv-switch" title="Thiết lập nâng cao">
                      <input type="checkbox" id="nvShiftAdvancedEnabled">
                      <span></span>
                    </label>
                  </div>
                </div>
                <div class="nv-shift-advanced" id="nvShiftAdvancedConfig">
                  <div class="nv-shift-advanced-head">
                    <div class="nv-salary-label">Mức lương</div>
                    <div></div>
                  </div>
                  <div class="nv-shift-advanced-table-wrap">
                    <table class="nv-shift-table">
                      <thead>
                        <tr>
                          <th>Ca</th>
                          <th>Lương/ca</th>
                          <th>Thứ 7</th>
                          <th>Chủ nhật</th>
                          <th>Ngày nghỉ</th>
                          <th>Ngày lễ tết</th>
                        </tr>
                      </thead>
                      <tbody id="nvShiftAdvancedRows">
                        <tr>
                          <td>Mặc định</td>
                          <td><input type="number" min="0"></td>
                          <td><button type="button" class="nv-shift-plus" title="Thêm hệ số">+</button></td>
                          <td><button type="button" class="nv-shift-plus" title="Thêm hệ số">+</button></td>
                          <td><button type="button" class="nv-shift-plus has-value" data-value="100" data-unit="phan_tram" title="Thiết lập">100%</button></td>
                          <td><button type="button" class="nv-shift-plus has-value" data-value="100" data-unit="phan_tram" title="Thiết lập">100%</button></td>
                        </tr>
                      </tbody>
                    </table>
                    <button type="button" class="nv-shift-add-link" id="nvShiftAddCondition">Thêm điều kiện</button>
                  </div>
                </div>
                <div class="nv-salary-line">
                  <div class="nv-salary-label">Lương làm thêm giờ</div>
                  <div></div>
                  <div class="nv-salary-line-actions">
                    <label class="nv-switch" title="Bật lương làm thêm giờ">
                      <input type="checkbox" id="nvShiftOvertimeEnabled">
                      <span></span>
                    </label>
                  </div>
                </div>
                <div class="nv-overtime-config" id="nvShiftOvertimeConfig">
                  <table class="nv-overtime-table">
                    <thead>
                      <tr>
                        <th></th>
                        <th>Ngày thường</th>
                        <th>Thứ 7</th>
                        <th>Chủ nhật</th>
                        <th>Ngày nghỉ</th>
                        <th>Ngày lễ tết</th>
