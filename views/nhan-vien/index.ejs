    function resolveCaFromList(caId) {
      return (window.hrCaLamViecList || []).find(ca => String(ca._id) === String(caId));
    }

    function buildCaLamViecSelect(item) {
      item = item || {};
      const selectedId = item.ca_lam_viec_id ? String(item.ca_lam_viec_id) : '';
      const list = window.hrCaLamViecList || [];
      let found = false;
      let html = '<select class="nv-salary-select nv-advanced-condition-ca"><option value="">Chọn ca làm việc</option>';
      list.forEach(function(ca) {
        const id = String(ca._id || '');
        if (id === selectedId) found = true;
        html += '<option value="' + escapeOption(id) + '"' + (id === selectedId ? ' selected' : '') + '>' + escapeOption(caLamViecOptionLabel(ca)) + '</option>';
      });
      if (selectedId && !found) {
        const legacy = item.ten_ca || item.ten_dieu_kien || 'Ca cũ';
        html += '<option value="' + escapeOption(selectedId) + '" selected>' + escapeOption(legacy + ' (ngừng hoạt động)') + '</option>';
      } else if (!selectedId && (item.ten_ca || item.ten_dieu_kien)) {
        const legacyName = item.ten_ca || (String(item.ten_dieu_kien || '').indexOf('ca_tu_tao_') === 0 ? 'Ca tự tạo (dữ liệu cũ)' : item.ten_dieu_kien);
        html += '<option value="" selected disabled>' + escapeOption(legacyName + ' (chưa gắn ca)') + '</option>';
      }
      return html + '</select>';
    }

    function timeToMinutes(value) {
      const parts = String(value || '').split(':');
      const h = Number(parts[0] || 0);
      const m = Number(parts[1] || 0);
      return h * 60 + m;
    }

    function updateShiftWorkDuration() {
      const start = timeToMinutes(salaryEl('nvShiftWorkStart')?.value);
      const end = timeToMinutes(salaryEl('nvShiftWorkEnd')?.value);
      let minutes = end - start;
      if (minutes < 0) minutes += 24 * 60;
      const hours = Math.round((minutes / 60) * 10) / 10;
      const label = Number.isInteger(hours) ? String(hours) : String(hours).replace('.', ',');
      if (salaryEl('nvShiftWorkDuration')) salaryEl('nvShiftWorkDuration').textContent = label + 'h';
    }

