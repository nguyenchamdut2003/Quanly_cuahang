    });

    nvKeyword.addEventListener('keydown', function(e) {
      if (e.key !== 'Enter') return;
      nvFilterKeyword.value = nvKeyword.value.trim();
      document.getElementById('nvFilterForm').submit();
    });

    document.querySelector('.employee-table tbody')?.addEventListener('click', async function(event) {
      const tabButton = event.target.closest('.employee-detail-tab');
      if (tabButton) {
        const panel = tabButton.closest('.employee-detail-panel');
        if (panel) {
          activateEmployeeDetailTab(panel, tabButton.dataset.detailTab);
          if (tabButton.dataset.detailTab === 'schedule') loadEmployeeSchedule(panel, panel.dataset.scheduleWeek || new Date());
          if (tabButton.dataset.detailTab === 'payroll') loadEmployeePayroll(panel);
        }
        return;
      }
      const payrollFilter = event.target.closest('.employee-payroll-filter');
      if (payrollFilter) return;
      const payrollExport = event.target.closest('.employee-payroll-export');
      if (payrollExport) {
        const panel = payrollExport.closest('.employee-detail-panel');
        const params = new URLSearchParams();
        if (panel?.dataset.payrollStatus) params.set('trang_thai', panel.dataset.payrollStatus);
        const query = params.toString();
        window.location.href = '/api/bang-luong/nhan-vien/' + encodeURIComponent(panel?.dataset.id || '') + '/export' + (query ? '?' + query : '');
        return;
      }
      const schedulePrev = event.target.closest('.employee-schedule-prev');
      const scheduleNext = event.target.closest('.employee-schedule-next');
      const scheduleToday = event.target.closest('.employee-schedule-today');
      if (schedulePrev || scheduleNext || scheduleToday) {
        const panel = event.target.closest('.employee-detail-panel');
        if (!panel) return;
        let start = scheduleStartOfWeek(panel.dataset.scheduleWeek || new Date());
        if (schedulePrev) start = scheduleAddDays(start, -7);
        if (scheduleNext) start = scheduleAddDays(start, 7);
        if (scheduleToday) start = scheduleStartOfWeek(new Date());
        loadEmployeeSchedule(panel, start);
        return;
      }
      const scheduleUpdate = event.target.closest('.employee-schedule-update');
      if (scheduleUpdate) {
        const panel = scheduleUpdate.closest('.employee-detail-panel');
        const params = new URLSearchParams();
        if (panel?.dataset.id) params.set('nhan_vien_id', panel.dataset.id);
        const start = scheduleStartOfWeek(panel?.dataset.scheduleWeek || new Date());
        params.set('tu_ngay', scheduleDateInput(start));
        params.set('den_ngay', scheduleDateInput(scheduleAddDays(start, 6)));
        window.location.href = '/lich-lam-viec?' + params.toString();
        return;
      }
      const detailEdit = event.target.closest('.employee-detail-edit');
      if (detailEdit) {
        const panel = detailEdit.closest('.employee-detail-panel');
        const id = panel?.dataset.id;
        if (!id) return;
        const res = await fetch('/api/nhan-vien/' + id);
        const json = await res.json();
        if (!json.success) return alert(json.message || 'Không tải được nhân viên');
        openNvModal(json.item);
        return;
      }
      if (event.target.closest('button,a,input,select,textarea,label')) return;
      const row = event.target.closest('tr[data-id]');
      if (row) toggleEmployeeDetail(row);
    });

    document.querySelector('.employee-table tbody')?.addEventListener('change', function(event) {
      const payrollFilter = event.target.closest('.employee-payroll-filter');
      if (!payrollFilter) return;
      const panel = payrollFilter.closest('.employee-detail-panel');
      if (!panel) return;
      panel.dataset.payrollStatus = payrollFilter.value || '';
      loadEmployeePayroll(panel);
    });

    document.querySelectorAll('.nv-edit').forEach(btn => {
      btn.addEventListener('click', async function(event) {
        event.stopPropagation();
        const id = this.closest('tr').dataset.id;
        const res = await fetch('/api/nhan-vien/' + id);
        const json = await res.json();
        if (!json.success) return alert(json.message || 'Không tải được nhân viên');
        openNvModal(json.item);
      });
    });

    document.querySelectorAll('.nv-delete').forEach(btn => {
      btn.addEventListener('click', async function(event) {
        event.stopPropagation();
        const id = this.closest('tr').dataset.id;
        if (!confirm('Chuyển nhân viên sang trạng thái đã nghỉ?')) return;
        const res = await fetch('/api/nhan-vien/' + id, { method: 'DELETE' });
        const json = await res.json();
        if (!json.success) return alert(json.message || 'Lỗi');
        location.reload();
      });
    });

    document.getElementById('nvSaveBtn').addEventListener('click', async function() {
      const payload = collectPayload();
      if (!payload.ten_nhan_vien) return alert('Vui lòng nhập tên nhân viên');
      const url = nvEditId ? ('/api/nhan-vien/' + nvEditId) : '/api/nhan-vien';
      const method = nvEditId ? 'PUT' : 'POST';
      const res = await fetch(url, {
        method,
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify(payload)
      });
      const json = await res.json();
      if (!json.success) return alert(json.message || 'Lỗi lưu nhân viên');
      location.reload();
    });
  </script>
</body>
</html>
