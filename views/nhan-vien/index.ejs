  <script>
    const nvModal = document.getElementById('nvModal');
    const nvKeyword = document.getElementById('nvKeyword');
    const nvFilterKeyword = document.getElementById('nvFilterKeyword');
    let nvEditId = '';
    let nvProvinceCache = null;
    let nvWardCache = {};
    let nvShiftWorkTargetSelect = null;
    let nvShiftWorkCounter = 0;
    let nvCommissionTableTargetSelect = null;
    let nvCommissionTableCounter = 0;
    let nvAllowanceTypeTargetSelect = null;
    let nvAllowanceTypeCounter = 0;
    let nvDeductionTypeTargetSelect = null;
    let nvDeductionTypeCounter = 0;
    let employeeScheduleLookup = null;

    function escapeOption(value) {
      return String(value || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    function detailText(value) {
      if (value === null || value === undefined || value === '') return '---';
      return escapeOption(value);
    }

    function detailDate(value) {
      if (!value) return '---';
      const iso = toIsoDate(value);
      if (!iso) return '---';
      const parts = iso.split('-');
      return parts.length === 3 ? parts[2] + '/' + parts[1] + '/' + parts[0] : detailText(value);
    }

    function detailMoney(value) {
      return Number(value || 0).toLocaleString('vi-VN');
    }

    function detailGender(value) {
      if (value === 'nam') return 'Nam';
      if (value === 'nu') return 'Nữ';
      if (value === 'khac') return 'Khác';
      return '---';
    }

    function detailRefName(value, field) {
      if (!value) return '---';
      if (typeof value === 'object') return value[field] || '---';
      return '---';
    }

    function detailAddress(item) {
      return [item.dia_chi_chi_tiet, item.phuong_xa, item.quan_huyen, item.tinh_thanh].filter(Boolean).join(', ') || '---';
    }

    function detailField(label, value, extraClass) {
      return '<div class="employee-detail-field">' +
        '<span class="employee-detail-label">' + escapeOption(label) + '</span>' +
        '<span class="employee-detail-value ' + (extraClass || '') + '">' + detailText(value) + '</span>' +
      '</div>';
    }

    function renderEmployeeInfoPane(item) {
      const avatar = item.anh_dai_dien
        ? '<img src="' + escapeOption(item.anh_dai_dien) + '" alt="">'
        : '<i class="fa-regular fa-image"></i>';
      const login = item.nguoi_dung_id && typeof item.nguoi_dung_id === 'object'
        ? (item.nguoi_dung_id.ho_ten || item.nguoi_dung_id.email || '')
        : '';
      return '<div class="employee-detail-info">' +
        '<div class="employee-detail-photo">' + avatar + '</div>' +
        detailField('Mã nhân viên:', item.ma_nhan_vien) +
        detailField('Tên nhân viên:', item.ten_nhan_vien) +
        detailField('Mã chấm công:', item.ma_cham_cong) +
        detailField('Ngày sinh:', detailDate(item.ngay_sinh)) +
        '<div></div>' +
        detailField('Giới tính:', detailGender(item.gioi_tinh)) +
        detailField('Số CMND/CCCD:', item.cccd) +
        detailField('Phòng ban', detailRefName(item.phong_ban_id, 'ten_phong_ban')) +
        detailField('Chức danh:', detailRefName(item.chuc_danh_id, 'ten_chuc_danh')) +
        '<div></div>' +
        detailField('Ngày bắt đầu làm việc', detailDate(item.ngay_bat_dau_lam_viec)) +
        detailField('Cửa hàng trả lương:', 'Cửa hàng trung tâm') +
        detailField('Cửa hàng làm việc:', 'Cửa hàng trung tâm') +
        detailField('Tài khoản KiotViet:', item.sdt, item.sdt ? 'is-link' : '') +
        '<div></div>' +
        detailField('Số điện thoại:', item.sdt) +
        detailField('Email:', item.email) +
        detailField('Facebook:', item.facebook) +
        detailField('Địa chỉ:', detailAddress(item)) +
        '<div></div>' +
        detailField('Thiết bị di động:', '') +
        '<div class="employee-detail-field"><span class="employee-detail-label">Ghi chú:</span><textarea class="employee-detail-note" readonly>' + detailText(item.ghi_chu === '---' ? '' : item.ghi_chu) + '</textarea></div>' +
      '</div>';
    }

    function schedulePad(number) {
      return String(number).padStart(2, '0');
    }

    function scheduleDateInput(date) {
      return date.getFullYear() + '-' + schedulePad(date.getMonth() + 1) + '-' + schedulePad(date.getDate());
    }

    function scheduleParseDate(value) {
      if (value instanceof Date) return new Date(value.getFullYear(), value.getMonth(), value.getDate());
      const text = String(value || '').slice(0, 10);
      const parts = text.split('-').map(Number);
      if (parts.length === 3 && parts.every(Boolean)) return new Date(parts[0], parts[1] - 1, parts[2]);
      const date = new Date(value);
      return Number.isNaN(date.getTime()) ? null : new Date(date.getFullYear(), date.getMonth(), date.getDate());
    }

    function scheduleStartOfWeek(date) {
      date = scheduleParseDate(date) || new Date();
      const result = new Date(date.getFullYear(), date.getMonth(), date.getDate());
      const day = result.getDay() || 7;
      result.setDate(result.getDate() - day + 1);
      return result;
    }

    function scheduleAddDays(date, days) {
      const result = new Date(date.getFullYear(), date.getMonth(), date.getDate());
      result.setDate(result.getDate() + days);
      return result;
    }

    function scheduleWeekTitle(start) {
      const week = Math.ceil(start.getDate() / 7);
      return 'Tuần ' + week + ' - Th. ' + (start.getMonth() + 1) + ' ' + start.getFullYear();
    }

    function scheduleDayLabel(date, index) {
      const names = ['Thứ 2', 'Thứ 3', 'Thứ 4', 'Thứ 5', 'Thứ 6', 'Thứ 7', 'Chủ nhật'];
      const today = scheduleDateInput(new Date());
      const day = date.getDate();
      const dayText = scheduleDateInput(date) === today ? '<span class="employee-day-badge">' + day + '</span>' : day;
      return names[index] + ' ' + dayText;
    }

    function scheduleShiftKey(value) {
      if (!value) return '';
      return String(typeof value === 'object' ? (value._id || value.id || '') : value);
    }

    async function getEmployeeScheduleLookup() {
      if (employeeScheduleLookup) return employeeScheduleLookup;
      const res = await fetch('/api/lich-lam-viec/lookup-options', { headers: { Accept: 'application/json' } });
      const json = await res.json();
      if (!json.success) throw new Error(json.message || 'Không tải được danh sách ca');
      employeeScheduleLookup = json;
      return employeeScheduleLookup;
    }

    function renderEmployeeScheduleTable(panel, items, shifts, weekStart) {
      const days = Array.from({ length: 7 }, function(_, index) { return scheduleAddDays(weekStart, index); });
      const shiftMap = {};
      (shifts || []).forEach(function(shift) {
        shiftMap[scheduleShiftKey(shift._id)] = {
          _id: scheduleShiftKey(shift._id),
          ten_ca: shift.ten_ca || shift.ma_ca || 'Ca làm việc',
          gio_bat_dau: shift.gio_bat_dau || '',
          gio_ket_thuc: shift.gio_ket_thuc || ''
        };
      });
      (items || []).forEach(function(item) {
        const key = scheduleShiftKey(item.ca_lam_viec_id);
        if (!shiftMap[key]) {
          shiftMap[key] = {
            _id: key,
            ten_ca: item.ten_ca || item.ma_ca || 'Ca làm việc',
            gio_bat_dau: item.gio_bat_dau || '',
            gio_ket_thuc: item.gio_ket_thuc || ''
          };
        }
      });
      const rows = Object.values(shiftMap).sort(function(a, b) {
        return String(a.gio_bat_dau || '').localeCompare(String(b.gio_bat_dau || '')) || String(a.ten_ca || '').localeCompare(String(b.ten_ca || ''));
      });
      const checked = {};
      (items || []).forEach(function(item) {
        if (item.trang_thai === 'cancelled') return;
        const dateKey = scheduleDateInput(scheduleParseDate(item.ngay_lam_viec));
        checked[scheduleShiftKey(item.ca_lam_viec_id) + '|' + dateKey] = true;
      });
      const html = '<div class="employee-schedule-toolbar">' +
        '<select class="employee-schedule-select"><option>Xem theo bảng</option></select>' +
        '<div class="employee-week-nav">' +
          '<button type="button" class="employee-schedule-prev" title="Tuần trước"><i class="fa-solid fa-chevron-left"></i></button>' +
          '<span>' + escapeOption(scheduleWeekTitle(weekStart)) + '</span>' +
          '<button type="button" class="employee-schedule-next" title="Tuần sau"><i class="fa-solid fa-chevron-right"></i></button>' +
        '</div>' +
        '<button type="button" class="employee-week-btn employee-schedule-today">Tuần này</button>' +
      '</div>' +
      '<div class="employee-schedule-table-wrap">' +
        '<table class="employee-schedule-table">' +
          '<thead><tr><th>Ca</th>' + days.map(function(day, index) { return '<th>' + scheduleDayLabel(day, index) + '</th>'; }).join('') + '</tr></thead>' +
          '<tbody>' +
            (rows.length ? rows.map(function(shift) {
              return '<tr><td class="employee-schedule-shift"><strong>' + detailText(shift.ten_ca) + '</strong><span>' + detailText((shift.gio_bat_dau || '') + (shift.gio_ket_thuc ? ' - ' + shift.gio_ket_thuc : '')) + '</span></td>' +
                days.map(function(day) {
                  const key = shift._id + '|' + scheduleDateInput(day);
                  return '<td class="' + (checked[key] ? 'employee-schedule-check' : '') + '">' + (checked[key] ? '<i class="fa-solid fa-check"></i>' : '') + '</td>';
                }).join('') +
              '</tr>';
            }).join('') : '<tr><td colspan="8"><div class="employee-detail-placeholder">Chưa có ca làm việc để hiển thị.</div></td></tr>') +
          '</tbody>' +
        '</table>' +
      '</div>' +
      '<div class="employee-schedule-actions"><button type="button" class="btn btn-primary btn-sm employee-schedule-update"><i class="fa-solid fa-pen"></i> Cập nhật</button></div>';
      const pane = panel.querySelector('[data-detail-pane="schedule"]');
      if (pane) pane.innerHTML = html;
    }

    async function loadEmployeeSchedule(panel, weekStart) {
      if (!panel) return;
      weekStart = scheduleStartOfWeek(weekStart || panel.dataset.scheduleWeek || new Date());
      panel.dataset.scheduleWeek = scheduleDateInput(weekStart);
      const pane = panel.querySelector('[data-detail-pane="schedule"]');
      if (pane) pane.innerHTML = '<div class="employee-detail-placeholder">Đang tải lịch làm việc...</div>';
      try {
        const end = scheduleAddDays(weekStart, 6);
        const [lookup, res] = await Promise.all([
          getEmployeeScheduleLookup(),
          fetch('/api/lich-lam-viec?nhan_vien_id=' + encodeURIComponent(panel.dataset.id || '') + '&tu_ngay=' + encodeURIComponent(scheduleDateInput(weekStart)) + '&den_ngay=' + encodeURIComponent(scheduleDateInput(end)), { headers: { Accept: 'application/json' } })
        ]);
        const json = await res.json();
        if (!json.success) throw new Error(json.message || 'Không tải được lịch làm việc');
        renderEmployeeScheduleTable(panel, json.items || [], lookup.shifts || [], weekStart);
      } catch (error) {
        if (pane) pane.innerHTML = '<div class="employee-detail-placeholder">' + detailText(error.message || 'Không tải được lịch làm việc') + '</div>';
      }
    }

    function buildClientSalarySummary(salary) {
      salary = salary || {};
      const type = salary.loai_luong || 'theo_ca';
      const advanced = salary.muc_luong_nang_cao || {};
      const conditions = Array.isArray(advanced.dieu_kien) ? advanced.dieu_kien : [];
      const unit = type === 'theo_gio' ? '/giờ' : (type === 'theo_ngay' ? '/kỳ lương' : (type === 'theo_thang' ? '/tháng' : '/ca'));
      const typeLabel = type === 'theo_gio' ? 'Theo giờ làm việc' : (type === 'theo_ngay' ? 'Theo ngày công chuẩn' : (type === 'theo_thang' ? 'Cố định' : 'Theo ca làm việc'));
      const rate = function(value, rateUnit, fallback) {
        let number = Number(value || 0);
        if (!number && fallback != null) number = Number(fallback || 0);
        return rateUnit === 'vnd' ? number.toLocaleString('vi-VN') : number.toLocaleString('vi-VN') + ' %';
      };
      const rows = [];
      const showRows = salary.enabled || salary.muc_luong || salary.nang_cao;
      if (showRows && Number(salary.muc_luong || 0) > 0) {
        rows.push({
          muc_luong: 'Mặc định: ' + Number(salary.muc_luong || 0).toLocaleString('vi-VN') + unit,
          thu_7: rate(advanced.thu_7, advanced.thu_7_kieu, 100),
          ngay_nghi: rate(advanced.ngay_nghi, advanced.ngay_nghi_kieu, 100),
          ngay_le_tet: rate(advanced.ngay_le_tet, advanced.ngay_le_tet_kieu, 100)
        });
      }
      if (salary.nang_cao && conditions.length) {
        conditions.forEach(function(row) {
          rows.push({
            muc_luong: (row.ten_dieu_kien || row.ten_ca || 'Ca') + ': ' + Number(row.muc_luong || row.ngay_thuong || 0).toLocaleString('vi-VN') + unit,
            thu_7: rate(row.thu_7, row.thu_7_kieu, 100),
            ngay_nghi: rate(row.ngay_nghi, row.ngay_nghi_kieu, 100),
            ngay_le_tet: rate(row.ngay_le_tet, row.ngay_le_tet_kieu, 100)
          });
        });
      }
      return {
        mau_ap_dung: salary.mau_luong_id ? String(salary.mau_luong_id) : 'Không áp dụng',
        loai_luong: typeLabel,
        muc_luong_rows: salary.enabled || salary.muc_luong || salary.nang_cao ? rows : [],
        thuong: salary.thuong && salary.thuong.enabled ? 'Đã áp dụng' : 'Không áp dụng',
        hoa_hong: salary.hoa_hong && salary.hoa_hong.enabled ? 'Đã áp dụng' : 'Không áp dụng',
        luong_lam_them_gio: salary.lam_them_gio && salary.lam_them_gio.enabled ? 'Đã áp dụng' : 'Không áp dụng',
        phu_cap: salary.phu_cap && salary.phu_cap.enabled ? 'Đã áp dụng' : 'Không áp dụng',
        giam_tru: salary.giam_tru && salary.giam_tru.enabled ? 'Đã áp dụng' : 'Không áp dụng'
      };
    }

    function renderEmployeeSalaryPane(item) {
      const summary = item.salary_summary || buildClientSalarySummary(item.salary_setup || {});
      const rows = Array.isArray(summary.muc_luong_rows) ? summary.muc_luong_rows : [];
      const tableHtml = rows.length
        ? '<table class="employee-salary-table">' +
            '<thead><tr><th>Mức lương</th><th>Thứ 7</th><th>Ngày nghỉ</th><th>Ngày lễ tết</th></tr></thead>' +
            '<tbody>' + rows.map(function(row) {
              return '<tr>' +
                '<td>' + detailText(row.muc_luong) + '</td>' +
                '<td>' + detailText(row.thu_7) + '</td>' +
                '<td>' + detailText(row.ngay_nghi) + '</td>' +
                '<td>' + detailText(row.ngay_le_tet) + '</td>' +
              '</tr>';
            }).join('') + '</tbody></table>'
        : '<div class="employee-detail-placeholder">Chưa áp dụng thiết lập lương.</div>';
      return '<div class="employee-salary-pane">' +
        '<div class="employee-salary-meta">' +
          '<div class="employee-salary-label">Mẫu áp dụng:</div><div class="employee-salary-muted">' + detailText(summary.mau_ap_dung) + '</div>' +
          '<div class="employee-salary-label">Loại lương:</div><div>' + detailText(summary.loai_luong) + '</div>' +
        '</div>' +
        tableHtml +
        '<div class="employee-salary-lines">' +
          '<div class="employee-salary-label">Thưởng:</div><div class="employee-salary-muted">' + detailText(summary.thuong) + '</div>' +
          '<div class="employee-salary-label">Hoa hồng:</div><div class="employee-salary-muted">' + detailText(summary.hoa_hong) + '</div>' +
          '<div class="employee-salary-label">Lương làm thêm giờ:</div><div class="employee-salary-muted">' + detailText(summary.luong_lam_them_gio) + '</div>' +
          '<div class="employee-salary-label">Phụ cấp:</div><div class="employee-salary-muted">' + detailText(summary.phu_cap) + '</div>' +
          '<div class="employee-salary-label">Giảm trừ:</div><div class="employee-salary-muted">' + detailText(summary.giam_tru) + '</div>' +
        '</div>' +
        '<div class="employee-salary-actions"><button type="button" class="btn btn-primary btn-sm employee-detail-edit"><i class="fa-solid fa-gear"></i> Cập nhật</button></div>' +
      '</div>';
    }

    function payrollMoney(value) {
      return Number(value || 0).toLocaleString('vi-VN');
    }

    function renderEmployeePayrollPane(panel, items) {
      const currentStatus = panel.dataset.payrollStatus || '';
      const rows = Array.isArray(items) ? items : [];
      const body = rows.length ? rows.map(function(item) {
        const payrollHref = item.bang_luong_id ? '/bang-luong/' + encodeURIComponent(String(item.bang_luong_id)) : '#';
        return '<tr>' +
          '<td><a class="employee-payroll-link" href="' + payrollHref + '">' + detailText(item.ma_phieu) + '</a></td>' +
          '<td>' + detailText(item.ky_lam_viec) + '</td>' +
          '<td>' + payrollMoney(item.tong_luong) + '</td>' +
          '<td>' + payrollMoney(item.da_tra) + '</td>' +
          '<td>' + payrollMoney(item.con_can_tra) + '</td>' +
          '<td>' + detailText(item.trang_thai_label) + '</td>' +
        '</tr>';
      }).join('') : '<tr><td colspan="6"><div class="employee-detail-placeholder">Chưa có phiếu lương.</div></td></tr>';
      return '<div class="employee-payroll-pane">' +
        '<div class="employee-payroll-toolbar">' +
          '<select class="employee-payroll-filter">' +
            '<option value=""' + (!currentStatus ? ' selected' : '') + '>Tất cả trạng thái</option>' +
            '<option value="draft"' + (currentStatus === 'draft' ? ' selected' : '') + '>Tạm tính</option>' +
            '<option value="calculated"' + (currentStatus === 'calculated' ? ' selected' : '') + '>Đã tính</option>' +
            '<option value="locked"' + (currentStatus === 'locked' ? ' selected' : '') + '>Đã chốt</option>' +
            '<option value="cancelled"' + (currentStatus === 'cancelled' ? ' selected' : '') + '>Đã hủy</option>' +
          '</select>' +
        '</div>' +
        '<table class="employee-payroll-table">' +
          '<thead><tr><th>Mã phiếu</th><th>Kỳ làm việc</th><th>Tổng lương</th><th>Đã trả</th><th>Còn cần trả</th><th>Trạng thái</th></tr></thead>' +
          '<tbody>' + body + '</tbody>' +
        '</table>' +
        '<div class="employee-payroll-actions"><button type="button" class="btn btn-light btn-sm employee-payroll-export"><i class="fa-solid fa-file-export"></i> Xuất file</button></div>' +
      '</div>';
    }

    async function loadEmployeePayroll(panel) {
      if (!panel) return;
      const pane = panel.querySelector('[data-detail-pane="payroll"]');
      if (pane) pane.innerHTML = '<div class="employee-detail-placeholder">Đang tải phiếu lương...</div>';
      try {
        const params = new URLSearchParams();
        if (panel.dataset.payrollStatus) params.set('trang_thai', panel.dataset.payrollStatus);
        const query = params.toString();
        const res = await fetch('/api/bang-luong/nhan-vien/' + encodeURIComponent(panel.dataset.id || '') + (query ? '?' + query : ''), {
          headers: { Accept: 'application/json' }
        });
        const json = await res.json();
        if (!json.success) throw new Error(json.message || 'Không tải được phiếu lương');
        if (pane) pane.innerHTML = renderEmployeePayrollPane(panel, json.items || []);
      } catch (error) {
        if (pane) pane.innerHTML = '<div class="employee-detail-placeholder">' + detailText(error.message || 'Không tải được phiếu lương') + '</div>';
      }
    }

    function renderEmployeeDetailPanel(item) {
      const id = escapeOption(item._id || '');
      return '<div class="employee-detail-panel" data-id="' + id + '">' +
        '<div class="employee-detail-tabs">' +
          '<button type="button" class="employee-detail-tab is-active" data-detail-tab="info">Thông tin</button>' +
          '<button type="button" class="employee-detail-tab" data-detail-tab="schedule">Lịch làm việc</button>' +
          '<button type="button" class="employee-detail-tab" data-detail-tab="salary">Thiết lập lương</button>' +
          '<button type="button" class="employee-detail-tab" data-detail-tab="payroll">Phiếu lương</button>' +
          '<button type="button" class="employee-detail-tab" data-detail-tab="debt">Nợ và tạm ứng</button>' +
        '</div>' +
        '<div class="employee-detail-content" data-detail-pane="info">' + renderEmployeeInfoPane(item) + '</div>' +
        '<div class="employee-detail-content" data-detail-pane="schedule" style="display:none"><div class="employee-detail-placeholder">Chọn tab để tải lịch làm việc.</div></div>' +
        '<div class="employee-detail-content" data-detail-pane="salary" style="display:none">' + renderEmployeeSalaryPane(item) + '</div>' +
        '<div class="employee-detail-content" data-detail-pane="payroll" style="display:none"><div class="employee-detail-placeholder">Chọn tab để tải phiếu lương.</div></div>' +
        '<div class="employee-detail-content" data-detail-pane="debt" style="display:none"><div class="employee-detail-placeholder">Nợ và tạm ứng hiện tại: ' + detailMoney(item.no_va_tam_ung) + '</div></div>' +
        '<div class="employee-detail-actions">' +
          '<div class="employee-detail-left"><i class="fa-solid fa-user-xmark"></i><span>Ngừng làm việc</span></div>' +
          '<div class="employee-detail-right">' +
            '<button type="button" class="btn btn-primary btn-sm employee-detail-edit"><i class="fa-solid fa-square-check"></i> Cập nhật</button>' +
            '<button type="button" class="btn btn-light btn-sm"><i class="fa-solid fa-calculator"></i> Lấy mã xác nhận</button>' +
          '</div>' +
        '</div>' +
      '</div>';
    }

    function activateEmployeeDetailTab(panel, tab) {
      panel.querySelectorAll('.employee-detail-tab').forEach(function(button) {
        button.classList.toggle('is-active', button.dataset.detailTab === tab);
      });
      panel.querySelectorAll('[data-detail-pane]').forEach(function(pane) {
        pane.style.display = pane.dataset.detailPane === tab ? '' : 'none';
      });
    }

    async function toggleEmployeeDetail(row) {
      if (!row || !row.dataset.id) return;
      const next = row.nextElementSibling;
      if (next && next.classList.contains('employee-detail-row')) {
        next.remove();
        row.classList.remove('is-selected');
        return;
      }
      document.querySelectorAll('.employee-detail-row').forEach(function(detailRow) { detailRow.remove(); });
      document.querySelectorAll('.employee-table tbody tr.is-selected').forEach(function(selectedRow) { selectedRow.classList.remove('is-selected'); });
      row.classList.add('is-selected');
      const detailRow = document.createElement('tr');
      detailRow.className = 'employee-detail-row';
      const cell = document.createElement('td');
      cell.colSpan = document.querySelectorAll('.employee-table thead th').length || 12;
      cell.innerHTML = '<div class="employee-detail-panel"><div class="employee-detail-content"><div class="employee-detail-placeholder">Đang tải chi tiết nhân viên...</div></div></div>';
      detailRow.appendChild(cell);
      row.insertAdjacentElement('afterend', detailRow);
      const res = await fetch('/api/nhan-vien/' + row.dataset.id);
      const json = await res.json();
      if (!json.success) {
        cell.innerHTML = '<div class="employee-detail-panel"><div class="employee-detail-content"><div class="employee-detail-placeholder">' + detailText(json.message || 'Không tải được nhân viên') + '</div></div></div>';
        return;
      }
      cell.innerHTML = renderEmployeeDetailPanel(json.item);
    }

    function fetchAddressItems(url) {
      return fetch(url, { headers: { 'Accept': 'application/json' } })
        .then(function(res) { return res.json(); })
        .then(function(json) {
          if (!json || !json.success) throw new Error((json && json.message) || 'Không lấy được danh mục địa chỉ.');
          return Array.isArray(json.items) ? json.items : [];
        });
    }

    function getNvProvinces() {
      if (nvProvinceCache) return Promise.resolve(nvProvinceCache);
      return fetchAddressItems('/api/address/provinces').then(function(items) {
        nvProvinceCache = items;
        return items;
      });
    }

    function getNvWardsByProvince(provinceId) {
      if (!provinceId) return Promise.resolve([]);
      if (nvWardCache[provinceId]) return Promise.resolve(nvWardCache[provinceId]);
      return fetchAddressItems('/api/address/wards-by-province?province_id=' + encodeURIComponent(provinceId)).then(function(items) {
        nvWardCache[provinceId] = items;
        return items;
      });
    }

    function findAddressItem(items, selectedId, selectedName, idKey, nameKey) {
      selectedId = String(selectedId || '');
      selectedName = String(selectedName || '').trim();
      if (selectedId) {
        const byId = items.find(function(item) { return String(item[idKey] || '') === selectedId; });
        if (byId) return byId;
      }
      if (selectedName) {
        return items.find(function(item) { return String(item[nameKey] || '').trim() === selectedName; }) || null;
      }
      return null;
    }

    function selectedNvProvince() {
      const select = document.getElementById('nvTinh');
      const option = select && select.selectedOptions ? select.selectedOptions[0] : null;
      if (!option || !select.value) return null;
      return { province_id: option.getAttribute('data-id'), province_name: select.value };
    }

    function selectedNvWard() {
      const select = document.getElementById('nvPhuong');
      const option = select && select.selectedOptions ? select.selectedOptions[0] : null;
      if (!option || !select.value) return null;
      return {
        ward_code: option.getAttribute('data-code'),
        ward_name: select.value,
        district_id: option.getAttribute('data-district-id'),
        district_name: option.getAttribute('data-district-name') || ''
      };
    }

    function syncNvAddressHidden() {
      const province = selectedNvProvince();
      const ward = selectedNvWard();
      document.getElementById('nvTinhId').value = province ? (province.province_id || '') : '';
      document.getElementById('nvPhuongCode').value = ward ? (ward.ward_code || '') : '';
      document.getElementById('nvQuanHuyen').value = ward ? (ward.district_name || '') : '';
      document.getElementById('nvQuanHuyenId').value = ward ? (ward.district_id || '') : '';
    }

    function renderNvProvinces(items) {
      const select = document.getElementById('nvTinh');
      const selected = findAddressItem(items, select.getAttribute('data-selected-id'), select.getAttribute('data-selected-name') || select.value, 'province_id', 'province_name');
      select.innerHTML = '<option value="">Chọn Tỉnh/Thành phố</option>' + items.map(function(item) {
        return '<option value="' + escapeOption(item.province_name) + '" data-id="' + item.province_id + '">' + escapeOption(item.province_name) + '</option>';
      }).join('');
      if (selected) {
        select.value = selected.province_name;
        select.setAttribute('data-selected-id', selected.province_id);
        select.setAttribute('data-selected-name', selected.province_name);
      }
    }

    function renderNvWards(items) {
      const select = document.getElementById('nvPhuong');
      const selected = findAddressItem(items, select.getAttribute('data-selected-id'), select.getAttribute('data-selected-name') || select.value, 'ward_code', 'ward_name');
      select.innerHTML = '<option value="">Chọn Phường/Xã</option>' + items.map(function(item) {
        const label = item.ward_name + (item.district_name ? ' - ' + item.district_name : '');
        return '<option value="' + escapeOption(item.ward_name) + '" data-code="' + escapeOption(item.ward_code) + '" data-district-id="' + (item.district_id || '') + '" data-district-name="' + escapeOption(item.district_name || '') + '">' + escapeOption(label) + '</option>';
      }).join('');
      if (selected) {
        select.value = selected.ward_name;
        select.setAttribute('data-selected-id', selected.ward_code);
        select.setAttribute('data-selected-name', selected.ward_name);
      }
    }

    function resetNvWardSelect() {
      const wardSelect = document.getElementById('nvPhuong');
      wardSelect.innerHTML = '<option value="">Chọn Phường/Xã</option>';
      wardSelect.value = '';
      wardSelect.setAttribute('data-selected-id', '');
      wardSelect.setAttribute('data-selected-name', '');
    }

    async function initNvAddressSelects() {
      const provinceSelect = document.getElementById('nvTinh');
      const wardSelect = document.getElementById('nvPhuong');
      const provinces = await getNvProvinces();
      renderNvProvinces(provinces);
      const province = selectedNvProvince();
      syncNvAddressHidden();
      if (province) {
        const wards = await getNvWardsByProvince(province.province_id);
        renderNvWards(wards);
        syncNvAddressHidden();
      } else {
        resetNvWardSelect();
      }
      if (!provinceSelect.getAttribute('data-nv-bound')) {
        provinceSelect.setAttribute('data-nv-bound', '1');
        provinceSelect.addEventListener('change', async function() {
          provinceSelect.setAttribute('data-selected-id', '');
          provinceSelect.setAttribute('data-selected-name', provinceSelect.value || '');
          resetNvWardSelect();
          syncNvAddressHidden();
          const nextProvince = selectedNvProvince();
          if (!nextProvince) return;
          const wards = await getNvWardsByProvince(nextProvince.province_id);
          renderNvWards(wards);
          syncNvAddressHidden();
        });
        wardSelect.addEventListener('change', function() {
          wardSelect.setAttribute('data-selected-id', '');
          wardSelect.setAttribute('data-selected-name', wardSelect.value || '');
          syncNvAddressHidden();
        });
      }
    }

    function initHrPicker(config) {
      let items = config.seed.slice();
      let activeItem = null;
      let modalMode = 'add';

      function esc(text) {
        return String(text || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
      }

      function bindItems() {
        const nodes = Array.prototype.slice.call(config.dropdown.querySelectorAll('.address-type-item'));
        nodes.forEach(function(item) {
          const optionBtn = item.querySelector('.address-type-option');
          const editBtn = item.querySelector('.address-type-action-edit');
          const deleteBtn = item.querySelector('.address-type-action-delete');
          if (optionBtn) {
            optionBtn.addEventListener('click', function() {
              nodes.forEach(function(node) { node.classList.remove('is-active'); });
              item.classList.add('is-active');
              config.hidden.value = item.getAttribute('data-value') || '';
              config.label.textContent = item.getAttribute('data-name') || config.emptyLabel;
              config.dropdown.classList.remove('is-open');
            });
          }
          if (editBtn) {
            editBtn.addEventListener('click', function(event) {
              event.stopPropagation();
              activeItem = item;
              openModal('edit');
            });
          }
          if (deleteBtn) {
            deleteBtn.addEventListener('click', function(event) {
              event.stopPropagation();
              const id = item.getAttribute('data-id') || '';
              if (!id) return alert('Vui lòng chọn mục cần xóa.');
              if (!confirm('Bạn có chắc muốn xóa mục này không?')) return;
              request(config.deleteUrl(id), {}, '');
            });
          }
        });
      }

      function renderList(selectedId) {
        const selected = selectedId ? String(selectedId) : '';
        let html = (
          '<div class="address-type-item' + (!selected ? ' is-active' : '') + '" data-id="" data-value="" data-name="' + esc(config.emptyLabel) + '" data-desc="" data-status="active">' +
            '<button class="address-type-option" type="button">' + esc(config.emptyLabel) + '</button>' +
          '</div>'
        );
        items.forEach(function(row) {
          const id = String(row._id || '');
          const name = row[config.nameField] || '---';
          const desc = row.mo_ta || '';
          const status = row.trang_thai === 'inactive' ? 'inactive' : 'active';
          const isActive = id === selected;
          html += (
            '<div class="address-type-item' + (isActive ? ' is-active' : '') + '" data-id="' + id + '" data-value="' + id + '" data-name="' + esc(name) + '" data-desc="' + esc(desc) + '" data-status="' + status + '">' +
              '<button class="address-type-option" type="button">' + esc(name) + '</button>' +
              '<div class="address-type-actions">' +
                '<button class="address-type-action-edit" type="button">Sửa</button>' +
                '<button class="address-type-action-delete" type="button">Xóa</button>' +
              '</div>' +
            '</div>'
          );
        });
        config.dropdown.innerHTML = html;
        bindItems();
        if (selected) {
          const active = config.dropdown.querySelector('.address-type-item[data-value="' + selected + '"]');
          if (active) {
            config.hidden.value = selected;
            config.label.textContent = active.getAttribute('data-name') || config.emptyLabel;
          } else {
            config.hidden.value = '';
            config.label.textContent = config.emptyLabel;
          }
        } else {
          config.hidden.value = '';
          config.label.textContent = config.emptyLabel;
        }
        refreshFilterSelect();
      }

      function refreshFilterSelect() {
        if (!config.filterSelect) return;
        const selected = config.filterSelect.value || '';
        let opts = '<option value="">' + esc(config.filterEmptyLabel || 'Tất cả') + '</option>';
        items.forEach(function(row) {
          const id = String(row._id || '');
          opts += '<option value="' + id + '"' + (id === selected ? ' selected' : '') + '>' + esc(row[config.nameField] || '---') + '</option>';
        });
        config.filterSelect.innerHTML = opts;
      }

      function request(url, payload, selectedId) {
        const formBody = Object.keys(payload).map(function(key) {
          return encodeURIComponent(key) + '=' + encodeURIComponent(payload[key]);
        }).join('&');
        return fetch(url, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8',
            'X-Requested-With': 'XMLHttpRequest',
            'Accept': 'application/json'
          },
          body: formBody
        })
          .then(function(res) { return res.json(); })
          .then(function(data) {
            if (!data || !data.success) {
              alert((data && data.message) || 'Không thể xử lý dữ liệu.');
              return;
            }
            if (Array.isArray(data.items)) items = data.items;
            renderList(data.selectedId || (data.data && data.data._id) || selectedId || '');
            closeModal();
          })
          .catch(function(err) {
            alert((err && err.message) || 'Có lỗi xảy ra.');
          });
      }

      function openModal(mode) {
        modalMode = mode;
        const status = mode === 'edit' && activeItem && activeItem.getAttribute('data-status') === 'inactive' ? 'inactive' : 'active';
        if (mode === 'add') {
          config.modalTitle.textContent = config.addTitle;
          config.nameInput.value = '';
          config.descInput.value = '';
        } else {
          config.modalTitle.textContent = config.editTitle;
          config.nameInput.value = activeItem ? (activeItem.getAttribute('data-name') || '') : '';
          config.descInput.value = activeItem ? (activeItem.getAttribute('data-desc') || '') : '';
        }
        if (config.statusName) {
          const statusInput = document.querySelector('input[name="' + config.statusName + '"][value="' + status + '"]');
          if (statusInput) statusInput.checked = true;
        }
        config.modalOverlay.classList.add('is-open');
      }

      function closeModal() {
        config.modalOverlay.classList.remove('is-open');
      }

      function getItemById(id) {
        id = String(id || '');
        if (!id) return null;
        for (var i = 0; i < items.length; i += 1) {
          if (String(items[i]._id || '') === id) return items[i];
        }
        return null;
      }

      function ensureItem(row) {
        if (!row || !row._id || getItemById(row._id)) return;
        items.push(row);
      }

      function setActiveItemFromRow(row) {
        if (!row || !row._id) return false;
        activeItem = {
          getAttribute: function(name) {
            if (name === 'data-id') return String(row._id || '');
            if (name === 'data-name') return row[config.nameField] || '';
            if (name === 'data-desc') return row.mo_ta || '';
            if (name === 'data-status') return row.trang_thai === 'inactive' ? 'inactive' : 'active';
            return '';
          }
        };
        return true;
      }

      function editSelectedFromFilter() {
        if (!config.filterSelect) return;
        const id = config.filterSelect.value || '';
        const row = getItemById(id);
        if (!row) return alert('Vui lòng chọn mục cần sửa.');
        setActiveItemFromRow(row);
        openModal('edit');
      }

      function deleteSelectedFromFilter() {
        if (!config.filterSelect) return;
        const id = config.filterSelect.value || '';
        if (!id) return alert('Vui lòng chọn mục cần xóa.');
        if (!confirm('Bạn có chắc muốn xóa mục này không?')) return;
        request(config.deleteUrl(id), {}, '');
      }

      config.trigger.addEventListener('click', function() {
        config.dropdown.classList.toggle('is-open');
      });
      [config.addBtn].concat(config.extraAddBtns || []).forEach(function(btn) {
        if (btn) btn.addEventListener('click', function() { openModal('add'); });
      });
      (config.extraEditBtns || []).forEach(function(btn) {
        if (btn) btn.addEventListener('click', editSelectedFromFilter);
      });
      (config.extraDeleteBtns || []).forEach(function(btn) {
        if (btn) btn.addEventListener('click', deleteSelectedFromFilter);
      });
      config.modalClose.addEventListener('click', closeModal);
      config.modalCancel.addEventListener('click', closeModal);
      config.modalSubmit.addEventListener('click', function() {
        const name = config.nameInput.value.trim();
        const desc = config.descInput.value.trim();
        const statusInput = config.statusName ? document.querySelector('input[name="' + config.statusName + '"]:checked') : null;
        const status = statusInput && statusInput.value === 'inactive' ? 'inactive' : 'active';
        if (!name) return alert('Vui lòng nhập tên.');
        if (modalMode === 'add') {
          const body = {};
          body[config.nameKey] = name;
          body.mo_ta = desc;
          body.trang_thai = status;
          request(config.addUrl, body, '');
          return;
        }
        const id = activeItem ? (activeItem.getAttribute('data-id') || '') : '';
        if (!id) return alert('Vui lòng chọn mục cần sửa.');
        const body = {};
        body[config.nameKey] = name;
        body.mo_ta = desc;
        body.trang_thai = status;
        request(config.updateUrl(id), body, id);
      });

      renderList(config.hidden.value || '');
      return {
        setValue: function(id, fallbackRow) {
          ensureItem(fallbackRow);
          renderList(id || '');
        },
        getValue: function() { return config.hidden.value || ''; },
        setItems: function(newItems) {
          items = Array.isArray(newItems) ? newItems.slice() : [];
          renderList(config.hidden.value || '');
        }
      };
    }

    const phongBanPicker = initHrPicker({
      seed: JSON.parse(document.getElementById('phongBansSeed').textContent || '[]'),
      trigger: document.getElementById('nvPbTrigger'),
      label: document.getElementById('nvPbLabel'),
      hidden: document.getElementById('nvPhongBan'),
      dropdown: document.getElementById('nvPbDropdown'),
      addBtn: document.getElementById('nvPbAddBtn'),
      emptyLabel: 'Chọn phòng ban',
      nameField: 'ten_phong_ban',
      nameKey: 'ten_phong_ban',
      addUrl: '/nhan-vien/groups/phong-ban/add',
      updateUrl: function(id) { return '/nhan-vien/groups/phong-ban/' + id + '/update'; },
