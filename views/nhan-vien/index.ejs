      if (typeSelect) typeSelect.value = selectedKind === 'theo_ngay_cong_chuan' ? 'theo_ngay_cong' : selectedKind;
      const amountInput = row?.querySelector('input');
      if (amountInput) amountInput.value = salaryNumber(salaryEl('nvAllowanceTypeAmount')?.value);
      salaryEl('nvAllowanceTypeModalOverlay')?.classList.remove('is-open');
      nvAllowanceTypeTargetSelect = null;
    }

    function updateDeductionTypeUi() {
      const kind = document.querySelector('input[name="nvDeductionTypeKind"]:checked')?.value || 'di_muon';
      const isFixed = kind === 'co_dinh';
      if (salaryEl('nvDeductionConditionWrap')) salaryEl('nvDeductionConditionWrap').style.display = isFixed ? 'none' : '';
      if (salaryEl('nvDeductionAmountWrap')) salaryEl('nvDeductionAmountWrap').style.display = '';
      if (salaryEl('nvDeductionAmountMethodWrap')) salaryEl('nvDeductionAmountMethodWrap').style.display = isFixed ? '' : 'none';
      if (!isFixed) {
        const vnd = document.querySelector('input[name="nvDeductionAmountMethod"][value="vnd"]');
        if (vnd) vnd.checked = true;
      }
    }

    function openDeductionTypeModal(select) {
      nvDeductionTypeTargetSelect = select || null;
      salarySetValue('nvDeductionTypeName', '');
      salarySetValue('nvDeductionTypeAmount', 0);
      salarySetValue('nvDeductionBlockMinutes', 1);
      const defaultKind = document.querySelector('input[name="nvDeductionTypeKind"][value="di_muon"]');
      const defaultCondition = document.querySelector('input[name="nvDeductionCondition"][value="theo_so_lan"]');
      const defaultMethod = document.querySelector('input[name="nvDeductionAmountMethod"][value="vnd"]');
      if (defaultKind) defaultKind.checked = true;
      if (defaultCondition) defaultCondition.checked = true;
      if (defaultMethod) defaultMethod.checked = true;
      updateDeductionTypeUi();
      salaryEl('nvDeductionTypeModalOverlay')?.classList.add('is-open');
      salaryEl('nvDeductionTypeName')?.focus();
    }

    function closeDeductionTypeModal() {
      salaryEl('nvDeductionTypeModalOverlay')?.classList.remove('is-open');
      if (nvDeductionTypeTargetSelect && nvDeductionTypeTargetSelect.value === '__add_deduction_type') {
        nvDeductionTypeTargetSelect.value = '';
      }
      nvDeductionTypeTargetSelect = null;
    }

    function saveDeductionTypeModal() {
      if (!nvDeductionTypeTargetSelect) return closeDeductionTypeModal();
      const name = String(salaryEl('nvDeductionTypeName')?.value || '').trim();
      if (!name) return alert('Vui lòng nhập tên loại giảm trừ.');
      nvDeductionTypeCounter += 1;
      const value = 'giam_tru_tam_' + Date.now() + '_' + nvDeductionTypeCounter;
      const option = document.createElement('option');
      option.value = value;
      option.textContent = name;
      option.selected = true;
      const addOption = Array.prototype.find.call(nvDeductionTypeTargetSelect.options, item => item.value === '__add_deduction_type');
      nvDeductionTypeTargetSelect.insertBefore(option, addOption || null);
      nvDeductionTypeTargetSelect.value = value;
      const row = nvDeductionTypeTargetSelect.closest('tr');
      const kind = document.querySelector('input[name="nvDeductionTypeKind"]:checked')?.value || 'di_muon';
      const condition = document.querySelector('input[name="nvDeductionCondition"]:checked')?.value || 'theo_so_lan';
      const selects = row?.querySelectorAll('select') || [];
      if (selects[1]) selects[1].value = kind === 'co_dinh' ? 'khac' : kind;
      if (selects[2]) selects[2].value = kind === 'co_dinh' ? 'so_tien_co_dinh' : condition;
      const amountInput = row?.querySelector('input');
      if (amountInput) amountInput.value = salaryNumber(salaryEl('nvDeductionTypeAmount')?.value);
      salaryEl('nvDeductionTypeModalOverlay')?.classList.remove('is-open');
      nvDeductionTypeTargetSelect = null;
    }

    function deductionConditionLabel(value) {
      if (value === 'theo_phut') return 'Theo block';
      if (value === 'phan_tram_luong') return 'Theo hệ số lương';
      if (value === 'so_tien_co_dinh') return 'Số tiền cố định';
      return 'Theo số lần';
    }

    function setDeductionConditionButton(button, value, block) {
      if (!button) return;
      const nextValue = value || 'theo_so_lan';
      button.dataset.value = nextValue;
      button.dataset.block = String(salaryNumber(block) || 1);
      button.textContent = deductionConditionLabel(nextValue);
    }

    let activeDeductionConditionButton = null;
    function closeDeductionConditionPopover() {
      salaryEl('nvDeductionConditionPopover')?.classList.remove('is-open');
      activeDeductionConditionButton = null;
    }

    function ensureDeductionConditionPopover() {
      let popover = salaryEl('nvDeductionConditionPopover');
      if (popover) return popover;
      popover = document.createElement('div');
      popover.id = 'nvDeductionConditionPopover';
      popover.className = 'deduction-condition-popover';
      popover.innerHTML = (
        '<div class="deduction-condition-list">' +
          '<label><input type="radio" name="nvDeductionConditionPopoverValue" value="theo_so_lan"> Theo số lần</label>' +
          '<label><input type="radio" name="nvDeductionConditionPopoverValue" value="theo_phut"> Theo block <span class="deduction-block-input"><input id="nvDeductionConditionBlock" type="number" min="1" value="1"><span>phút</span></span> <span class="nv-salary-info" title="Số phút mỗi block">i</span></label>' +
        '</div>' +
        '<div class="deduction-condition-actions">' +
          '<button type="button" class="btn btn-light" id="nvDeductionConditionCancel">Bỏ qua</button>' +
          '<button type="button" class="btn btn-primary" id="nvDeductionConditionDone">Xong</button>' +
        '</div>'
      );
      document.body.appendChild(popover);
      salaryEl('nvDeductionConditionCancel')?.addEventListener('click', closeDeductionConditionPopover);
      salaryEl('nvDeductionConditionDone')?.addEventListener('click', function() {
        if (!activeDeductionConditionButton) return closeDeductionConditionPopover();
        const value = popover.querySelector('input[name="nvDeductionConditionPopoverValue"]:checked')?.value || 'theo_so_lan';
        setDeductionConditionButton(activeDeductionConditionButton, value, salaryEl('nvDeductionConditionBlock')?.value);
        closeDeductionConditionPopover();
      });
      return popover;
    }

    function openDeductionConditionPopover(button) {
      const popover = ensureDeductionConditionPopover();
      activeDeductionConditionButton = button;
      const value = button.dataset.value || 'theo_so_lan';
      const checked = popover.querySelector('input[name="nvDeductionConditionPopoverValue"][value="' + value + '"]');
      if (checked) checked.checked = true;
      salarySetValue('nvDeductionConditionBlock', button.dataset.block || 1);
      const rect = button.getBoundingClientRect();
      popover.style.left = Math.max(12, Math.min(window.innerWidth - 290, rect.left - 120)) + 'px';
      popover.style.top = Math.max(12, rect.bottom + 8) + 'px';
      popover.classList.add('is-open');
    }

    function addAdvancedConditionRow(tbodyId, item) {
      const tbody = salaryEl(tbodyId);
      if (!tbody) return;
      item = item || {};
      const row = document.createElement('tr');
      row.className = 'nv-advanced-condition-row';
      row.innerHTML = (
        '<td>' + buildCaLamViecSelect(item) + '</td>' +
        '<td><input class="nv-advanced-condition-salary" type="number" min="0" value="' + Number(item.muc_luong || 0) + '"></td>' +
        '<td>' + conditionRateButton(item.thu_7, item.thu_7_kieu) + '</td>' +
        '<td>' + conditionRateButton(item.chu_nhat, item.chu_nhat_kieu) + '</td>' +
        '<td>' + conditionRateButton(item.ngay_nghi, item.ngay_nghi_kieu) + '</td>' +
        '<td><div style="display:grid;grid-template-columns:minmax(0,1fr) 28px;align-items:center;gap:8px">' + conditionRateButton(item.ngay_le_tet, item.ngay_le_tet_kieu) + '<button class="nv-salary-row-delete" type="button" title="Xóa dòng"><i class="fa-regular fa-trash-can"></i></button></div></td>'
      );
      if (item.ca_lam_viec_id && (item.ten_ca || item.ten_dieu_kien)) {
        row.dataset.caTen = item.ten_ca || item.ten_dieu_kien;
      } else if (!item.ca_lam_viec_id && (item.ten_ca || item.ten_dieu_kien)) {
        row.dataset.legacyTen = item.ten_ca || item.ten_dieu_kien;
      }
      tbody.appendChild(row);
    }

    function renderAdvancedConditionRows(tbodyId, items) {
      const tbody = salaryEl(tbodyId);
      if (!tbody) return;
      tbody.querySelectorAll('.nv-advanced-condition-row').forEach(row => row.remove());
      (Array.isArray(items) ? items : []).forEach(item => addAdvancedConditionRow(tbodyId, item));
    }

    function isValidCaLamViecId(value) {
      const id = String(value || '').trim();
      if (!id || id.indexOf('ca_tu_tao_') === 0) return false;
      return /^[a-f0-9]{24}$/i.test(id);
    }

    function readShiftDefaultSalaryAmount() {
      return salaryNumber(salaryFirstRowInputs('nvShiftAdvancedRows')[0]?.value);
    }

    function collectAdvancedConditionRows(tbodyId) {
      const rows = Array.prototype.slice.call(salaryEl(tbodyId)?.querySelectorAll('.nv-advanced-condition-row') || []);
      return rows.map(row => {
        const buttons = row.querySelectorAll('.nv-shift-plus');
        const thu7 = readRateButton(buttons[0]);
        const chuNhat = readRateButton(buttons[1]);
        const ngayNghi = readRateButton(buttons[2]);
        const ngayLeTet = readRateButton(buttons[3]);
        const caId = row.querySelector('.nv-advanced-condition-ca')?.value || '';
        if (caId && !isValidCaLamViecId(caId)) return null;
        const ca = caId ? resolveCaFromList(caId) : null;
        const mucLuong = salaryNumber(row.querySelector('.nv-advanced-condition-salary')?.value);
        let tenCa = ca ? (ca.ten_ca || '') : (row.dataset.caTen || '');
        if (!tenCa && caId) {
          const opt = row.querySelector('.nv-advanced-condition-ca')?.selectedOptions?.[0];
          const optText = opt ? String(opt.textContent || '') : '';
          tenCa = optText.replace(/\s*\(ngừng hoạt động\)\s*$/, '').trim();
        }
        const legacyTen = row.dataset.legacyTen || '';
        const tenDieuKien = tenCa || legacyTen || '';
        const item = {
          muc_luong: mucLuong,
          ngay_thuong: mucLuong,
          ngay_thuong_kieu: mucLuong > 0 ? 'vnd' : 'phan_tram',
          thu_7: thu7.value,
          thu_7_kieu: thu7.unit,
          chu_nhat: chuNhat.value,
          chu_nhat_kieu: chuNhat.unit,
          ngay_nghi: ngayNghi.value,
          ngay_nghi_kieu: ngayNghi.unit,
          ngay_le_tet: ngayLeTet.value,
          ngay_le_tet_kieu: ngayLeTet.unit
        };
        if (caId) {
          item.ca_lam_viec_id = caId;
          if (tenCa) item.ten_ca = tenCa;
        }
        if (tenDieuKien) item.ten_dieu_kien = tenDieuKien;
        return item.ca_lam_viec_id || item.ten_dieu_kien || item.ten_ca || item.muc_luong || item.thu_7 || item.chu_nhat || item.ngay_nghi || item.ngay_le_tet ? item : null;
      }).filter(Boolean);
    }

    function salaryFirstRowInputs(tbodyId) {
      const row = salaryEl(tbodyId)?.querySelector('tr');
      return row ? Array.prototype.slice.call(row.querySelectorAll('input')) : [];
    }

    function collectAdvancedSalary(type) {
      const tbodyId = type === 'theo_gio' ? 'nvHourlyAdvancedRows' : (type === 'theo_ngay' ? 'nvStandardDayAdvancedRows' : 'nvShiftAdvancedRows');
      const inputs = salaryFirstRowInputs(tbodyId);
      const buttons = getAdvancedRateButtons(tbodyId);
      if (type === 'theo_ngay') {
        const ngayNghi = readRateButton(buttons[0]);
        const ngayLeTet = readRateButton(buttons[1]);
        return {
          ngay_thuong: salaryNumber(inputs[0]?.value),
          thu_7: 0,
          thu_7_kieu: 'phan_tram',
          chu_nhat: 0,
          chu_nhat_kieu: 'phan_tram',
          ngay_nghi: ngayNghi.value || 100,
          ngay_nghi_kieu: ngayNghi.unit,
          ngay_le_tet: ngayLeTet.value || 100,
          ngay_le_tet_kieu: ngayLeTet.unit,
          dieu_kien: []
        };
      }
      const thu7 = readRateButton(buttons[0]);
      const chuNhat = readRateButton(buttons[1]);
      const ngayNghi = readRateButton(buttons[2]);
      const ngayLeTet = readRateButton(buttons[3]);
      if (type === 'theo_ca') {
        return {
          ngay_thuong: 0,
          thu_7: thu7.value,
          thu_7_kieu: thu7.unit,
          chu_nhat: chuNhat.value,
          chu_nhat_kieu: chuNhat.unit,
          ngay_nghi: ngayNghi.value || 100,
          ngay_nghi_kieu: ngayNghi.unit,
          ngay_le_tet: ngayLeTet.value || 100,
          ngay_le_tet_kieu: ngayLeTet.unit,
          dieu_kien: collectAdvancedConditionRows(tbodyId)
        };
      }
      return {
        ngay_thuong: salaryNumber(inputs[0]?.value),
        thu_7: thu7.value,
        thu_7_kieu: thu7.unit,
        chu_nhat: chuNhat.value,
        chu_nhat_kieu: chuNhat.unit,
        ngay_nghi: ngayNghi.value || 100,
        ngay_nghi_kieu: ngayNghi.unit,
        ngay_le_tet: ngayLeTet.value || 100,
        ngay_le_tet_kieu: ngayLeTet.unit,
        dieu_kien: collectAdvancedConditionRows(tbodyId)
      };
    }

    function fillAdvancedSalary(type, values) {
      values = values || {};
      const tbodyId = type === 'theo_gio' ? 'nvHourlyAdvancedRows' : (type === 'theo_ngay' ? 'nvStandardDayAdvancedRows' : 'nvShiftAdvancedRows');
      const inputs = salaryFirstRowInputs(tbodyId);
      if (inputs[0] && type !== 'theo_ca') inputs[0].value = Number(values.ngay_thuong || 0);
      if (type !== 'theo_ngay') {
        const buttons = getAdvancedRateButtons(tbodyId);
        setAdvancedRateButton(buttons[0], values.thu_7, values.thu_7_kieu);
        setAdvancedRateButton(buttons[1], values.chu_nhat, values.chu_nhat_kieu);
        setAdvancedRateButton(buttons[2], values.ngay_nghi || 100, values.ngay_nghi_kieu);
        setAdvancedRateButton(buttons[3], values.ngay_le_tet || 100, values.ngay_le_tet_kieu);
      } else {
        const buttons = getAdvancedRateButtons(tbodyId);
        setAdvancedRateButton(buttons[0], values.ngay_nghi || 100, values.ngay_nghi_kieu);
        setAdvancedRateButton(buttons[1], values.ngay_le_tet || 100, values.ngay_le_tet_kieu);
      }
      renderAdvancedConditionRows(tbodyId, type === 'theo_ngay' ? [] : values.dieu_kien);
    }

    function collectOvertime(type) {
      const tbodyId = type === 'theo_ngay' ? 'nvStandardDayOvertimeConfig' : 'nvShiftOvertimeConfig';
      const buttons = Array.prototype.slice.call(salaryEl(tbodyId)?.querySelectorAll('tbody .nv-shift-plus') || []);
      const ngayThuong = readRateButton(buttons[0]);
      const thu7 = readRateButton(buttons[1]);
      const chuNhat = readRateButton(buttons[2]);
      const ngayNghi = readRateButton(buttons[3]);
      const ngayLeTet = readRateButton(buttons[4]);
      return {
        enabled: type === 'theo_ngay' ? !!salaryEl('nvStandardDayOvertimeEnabled')?.checked : !!salaryEl('nvShiftOvertimeEnabled')?.checked,
        he_so_ngay_thuong: ngayThuong.value || 150,
        he_so_ngay_thuong_kieu: ngayThuong.unit,
        he_so_thu_7: thu7.value || 200,
        he_so_thu_7_kieu: thu7.unit,
        he_so_chu_nhat: chuNhat.value || 200,
        he_so_chu_nhat_kieu: chuNhat.unit,
        he_so_ngay_nghi: ngayNghi.value || 200,
        he_so_ngay_nghi_kieu: ngayNghi.unit,
        he_so_ngay_le_tet: ngayLeTet.value || 300,
        he_so_ngay_le_tet_kieu: ngayLeTet.unit
      };
    }

    function fillOvertime(type, values) {
      values = values || {};
      const enabledId = type === 'theo_ngay' ? 'nvStandardDayOvertimeEnabled' : 'nvShiftOvertimeEnabled';
      const configId = type === 'theo_ngay' ? 'nvStandardDayOvertimeConfig' : 'nvShiftOvertimeConfig';
      salarySetChecked(enabledId, values.enabled);
      const buttons = Array.prototype.slice.call(salaryEl(configId)?.querySelectorAll('tbody .nv-shift-plus') || []);
      setAdvancedRateButton(buttons[0], values.he_so_ngay_thuong || 150, values.he_so_ngay_thuong_kieu);
      setAdvancedRateButton(buttons[1], values.he_so_thu_7 || 200, values.he_so_thu_7_kieu);
      setAdvancedRateButton(buttons[2], values.he_so_chu_nhat || 200, values.he_so_chu_nhat_kieu);
      setAdvancedRateButton(buttons[3], values.he_so_ngay_nghi || 200, values.he_so_ngay_nghi_kieu);
      setAdvancedRateButton(buttons[4], values.he_so_ngay_le_tet || 300, values.he_so_ngay_le_tet_kieu);
    }

