<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/stylesheets/style.css">
  <link rel="stylesheet" href="/stylesheets/responsive.css">
  <style>
    .admin-body .admin-shell{width:auto;max-width:none;margin:0;padding:30px}
    .hr-setup-shell{display:grid;grid-template-columns:260px minmax(0,1fr);gap:12px;padding:0}
    .hr-setup-main{background:#fff;border:1px solid #d7dde5;border-radius:8px;padding:14px 16px 16px;min-height:calc(100vh - 140px)}
    .hr-page-title{margin:0 0 14px;font-size:22px;font-weight:700;color:#111827}
    .hr-filters{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:10px;margin-bottom:12px;align-items:end}
    .hr-filters label{display:grid;gap:4px;font-size:12px;color:#475467}
    .hr-filters input,.hr-filters select{height:34px;border:1px solid #cfd8e3;border-radius:7px;padding:0 8px;font-size:13px}
    .hr-toolbar{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:12px;position:relative;z-index:2}
    .hr-toolbar .btn{cursor:pointer;position:relative;z-index:2}
    .hr-table-panel{border:1px solid #e5e9ee;border-radius:8px;overflow:auto}
    .hr-table{width:100%;border-collapse:collapse;min-width:1180px}
    .hr-table thead th{background:#e8f3ff;color:#111827;font-size:12px;font-weight:700;height:38px;padding:0 10px;text-align:left;border-bottom:1px solid #bcd9ff;white-space:nowrap}
    .hr-table tbody td{padding:9px 10px;border-bottom:1px solid #e5e9ee;font-size:12px;color:#111827}
    .hr-empty{padding:36px 20px;text-align:center;color:#475467}
    .status-pill{display:inline-flex;align-items:center;height:22px;padding:0 8px;border-radius:5px;font-size:11px;font-weight:700}
    .status-pill.is-draft{background:#f3f4f6;color:#374151}
    .status-pill.is-calculated{background:#dbeafe;color:#1d4ed8}
    .status-pill.is-locked{background:#dcfce7;color:#166534}
    .status-pill.is-cancelled{background:#fee2e2;color:#991b1b}
    .hr-actions{display:flex;gap:6px;flex-wrap:wrap}
    .hr-btn-icon{border:1px solid #cfd8e3;background:#fff;border-radius:6px;width:30px;height:28px;cursor:pointer;color:#344054}
    .modal-overlay{position:fixed;inset:0;background:rgba(15,23,42,.45);display:none;align-items:center;justify-content:center;z-index:3000;padding:20px;opacity:0;visibility:hidden}
    .modal-overlay.is-open{display:flex;opacity:1;visibility:visible}
    .modal-card{background:#fff;border-radius:10px;width:min(560px,100%);max-height:92vh;display:flex;flex-direction:column;box-shadow:0 20px 50px rgba(0,0,0,.18)}
    .modal-head{padding:16px 20px;border-bottom:1px solid #e5e9ee;font-size:18px;font-weight:700}
    .modal-body{padding:16px 20px;display:grid;gap:12px;overflow:auto}
    .modal-body label{display:grid;gap:4px;font-size:12px;color:#475467}
    .modal-body input,.modal-body textarea{height:34px;border:1px solid #cfd8e3;border-radius:7px;padding:0 10px;font-size:13px}
    .modal-body textarea{height:72px;padding:8px 10px;resize:vertical}
    .modal-grid-2{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
    .modal-foot{padding:12px 20px 16px;display:flex;justify-content:flex-end;gap:8px;border-top:1px solid #e5e9ee}
  </style>
</head>
<body class="admin-body">
  <%- include('../partials/header', { activeMenu: activeMenu, user: user }) %>
  <main class="admin-shell">
    <%- include('../partials/flash-message', { flash: flash }) %>
    <div class="hr-setup-shell">
      <%- include('../partials/hr-setup-nav', { activeHrPage: activeHrPage }) %>
      <section class="hr-setup-main">
        <h1 class="hr-page-title">Bảng lương</h1>

        <div class="hr-filters">
          <label>Từ ngày<input type="date" id="filterTuNgay" value="<%= filterDefaults.tu_ngay %>"></label>
          <label>Đến ngày<input type="date" id="filterDenNgay" value="<%= filterDefaults.den_ngay %>"></label>
          <label>Trạng thái
            <select id="filterTrangThai">
              <option value="">Tất cả</option>
              <option value="draft">Nháp</option>
              <option value="calculated">Đã tính</option>
              <option value="locked">Đã chốt</option>
              <option value="cancelled">Đã hủy</option>
            </select>
          </label>
          <label>Tìm kiếm<input type="search" id="filterKeyword" placeholder="Mã, tên bảng lương"></label>
          <div><button type="button" class="btn btn-light" id="filterApplyBtn">Lọc</button></div>
        </div>

        <div class="hr-toolbar">
          <button type="button" class="btn btn-primary" id="payrollAddBtn" onclick="if(window.openPayrollModal){window.openPayrollModal();}">+ Bảng lương</button>
        </div>

        <div class="hr-table-panel">
          <table class="hr-table">
            <thead>
              <tr>
                <th>Mã bảng lương</th>
                <th>Tên bảng lương</th>
                <th>Từ ngày</th>
                <th>Đến ngày</th>
                <th>Tổng nhân viên</th>
                <th>Tổng lương</th>
                <th>Đã trả</th>
                <th>Còn cần trả</th>
                <th>Trạng thái</th>
                <th>Hành động</th>
              </tr>
            </thead>
            <tbody id="payrollTableBody">
              <tr><td colspan="10" class="hr-empty">Đang tải...</td></tr>
            </tbody>
          </table>
        </div>
      </section>
    </div>
  </main>

  <div class="modal-overlay" id="payrollModal" aria-hidden="true">
    <div class="modal-card">
      <div class="modal-head">Tạo bảng lương</div>
      <form id="payrollForm" class="modal-body">
        <label>Tên bảng lương *<input type="text" id="payrollName" required></label>
        <div class="modal-grid-2">
          <label>Từ ngày *<input type="date" id="payrollTuNgay" required></label>
          <label>Đến ngày *<input type="date" id="payrollDenNgay" required></label>
        </div>
        <label>Ghi chú<textarea id="payrollNote"></textarea></label>
      </form>
      <div class="modal-foot">
        <button type="button" class="btn btn-light" id="payrollCancelBtn">Bỏ qua</button>
        <button type="submit" class="btn btn-primary" id="modalSaveBtn" form="payrollForm">Lưu</button>
      </div>
    </div>
  </div>

  <script>
    /*
     * Bật log UI (browser console):
     *   localStorage.setItem('HR_PAYROLL_UI_DEBUG', 'true'); location.reload();
     */
    const PAYROLL_UI_DEBUG = localStorage.getItem('HR_PAYROLL_UI_DEBUG') === 'true';
    function payrollUiLog(event, data) {
      if (!PAYROLL_UI_DEBUG) return;
      console.log('[HR_PAYROLL_UI]', event, data || {});
    }
    function payrollUiError(event, err, data) {
      console.error('[HR_PAYROLL_UI_ERROR]', event, err, data || {});
    }
    const STATUS_LABELS = { draft: 'Nháp', calculated: 'Đã tính', locked: 'Đã chốt', cancelled: 'Đã hủy' };
    const payrollTableBody = document.getElementById('payrollTableBody');
    const payrollModal = document.getElementById('payrollModal');

    function pad(n) {
      return String(n).padStart(2, '0');
    }
    function parseDate(value) {
      const parts = String(value || '').slice(0, 10).split('-').map(Number);
      if (parts.length === 3 && parts.every(function(n) { return Number.isFinite(n); })) {
        return new Date(parts[0], parts[1] - 1, parts[2]);
      }
      const d = new Date(value);
      return Number.isNaN(d.getTime()) ? new Date() : new Date(d.getFullYear(), d.getMonth(), d.getDate());
    }

    function escapeHtml(text) {
      return String(text || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }
    function formatMoney(value) {
      return new Intl.NumberFormat('vi-VN').format(Number(value || 0)) + ' VNĐ';
    }
    function formatDateDisplay(value) {
      if (!value) return '---';
      const d = new Date(value);
      if (Number.isNaN(d.getTime())) return '---';
      const vn = new Date(d.getTime() + 7 * 60 * 60000);
      return String(vn.getUTCDate()).padStart(2,'0') + '/' + String(vn.getUTCMonth()+1).padStart(2,'0') + '/' + vn.getUTCFullYear();
    }
    function formatInputDate(dateStr) {
      const d = parseDate(dateStr);
      return pad(d.getDate()) + '/' + pad(d.getMonth() + 1) + '/' + d.getFullYear();
    }
    function defaultPayrollName(tuNgay, denNgay) {
      const start = parseDate(tuNgay);
      const end = parseDate(denNgay);
      if (start.getMonth() === end.getMonth() && start.getFullYear() === end.getFullYear()) {
        return 'Bảng lương tháng ' + (start.getMonth() + 1) + '/' + start.getFullYear();
      }
      return 'Bảng lương ' + formatInputDate(tuNgay) + ' - ' + formatInputDate(denNgay);
    }
    function collectFilterParams() {
      const p = new URLSearchParams();
      const tu = document.getElementById('filterTuNgay').value;
      const den = document.getElementById('filterDenNgay').value;
      const st = document.getElementById('filterTrangThai').value;
      const kw = document.getElementById('filterKeyword').value.trim();
      if (tu) p.set('tu_ngay', tu);
      if (den) p.set('den_ngay', den);
      if (st) p.set('trang_thai', st);
      if (kw) p.set('keyword', kw);
      return p;
    }
    function renderRows(items) {
      if (!items.length) {
        payrollTableBody.innerHTML = '<tr><td colspan="10" class="hr-empty">Chưa có bảng lương.</td></tr>';
        return;
      }
      payrollTableBody.innerHTML = items.map(item => {
        const st = item.trang_thai || 'draft';
        return '<tr data-id="' + escapeHtml(String(item._id)) + '">' +
          '<td>' + escapeHtml(item.ma_bang_luong || '---') + '</td>' +
          '<td><strong>' + escapeHtml(item.ten_bang_luong || '---') + '</strong></td>' +
          '<td>' + formatDateDisplay(item.tu_ngay) + '</td>' +
          '<td>' + formatDateDisplay(item.den_ngay) + '</td>' +
          '<td>' + Number(item.tong_nhan_vien || 0) + '</td>' +
          '<td>' + formatMoney(item.tong_luong) + '</td>' +
          '<td>' + formatMoney(item.da_tra_nhan_vien) + '</td>' +
          '<td>' + formatMoney(item.con_can_tra) + '</td>' +
          '<td><span class="status-pill is-' + escapeHtml(st) + '">' + escapeHtml(STATUS_LABELS[st] || st) + '</span></td>' +
          '<td><div class="hr-actions">' +
            '<button type="button" class="hr-btn-icon payroll-view" title="Xem chi tiết"><i class="fa-regular fa-eye"></i></button>' +
            (st !== 'locked' && st !== 'cancelled' ? '<button type="button" class="hr-btn-icon payroll-calc" title="Tính lương"><i class="fa-solid fa-calculator"></i></button>' : '') +
            (st === 'calculated' ? '<button type="button" class="hr-btn-icon payroll-lock" title="Chốt"><i class="fa-solid fa-lock"></i></button>' : '') +
            (st !== 'locked' && st !== 'cancelled' ? '<button type="button" class="hr-btn-icon payroll-cancel" title="Hủy"><i class="fa-regular fa-trash-can"></i></button>' : '') +
          '</div></td></tr>';
      }).join('');
      bindActions();
    }
    async function loadList() {
      const params = collectFilterParams();
      payrollUiLog('payroll.ui.list.start', Object.fromEntries(params.entries()));
      try {
        const res = await fetch('/api/bang-luong?' + params.toString(), { headers: { Accept: 'application/json' } });
        const json = await res.json();
        if (!json.success) {
          payrollUiError('payroll.ui.list.error', json.message, { status: res.status });
          return alert(json.message || 'Không tải được bảng lương');
        }
        payrollUiLog('payroll.ui.list.success', { count: (json.items || []).length });
        renderRows(json.items || []);
      } catch (err) {
        payrollUiError('payroll.ui.list.error', err);
        alert(err.message || 'Không tải được bảng lương');
      }
    }
    async function postAction(id, action, confirmText) {
      if (confirmText && !confirm(confirmText)) return;
      payrollUiLog('payroll.ui.list_action.start', { bang_luong_id: id, action: action });
      try {
        const res = await fetch('/api/bang-luong/' + id + '/' + action, { method: 'POST', headers: { Accept: 'application/json' } });
        const json = await res.json();
        if (!json.success) {
          payrollUiError('payroll.ui.list_action.error', json.message, { bang_luong_id: id, action: action, status: res.status });
          return alert(json.message || 'Lỗi thao tác');
        }
        payrollUiLog('payroll.ui.list_action.success', { bang_luong_id: id, action: action });
        await loadList();
      } catch (err) {
        payrollUiError('payroll.ui.list_action.error', err, { bang_luong_id: id, action: action });
        alert(err.message || 'Lỗi thao tác');
      }
    }
    function bindActions() {
      document.querySelectorAll('.payroll-view').forEach(btn => btn.addEventListener('click', function() {
        location.href = '/bang-luong/' + this.closest('tr').dataset.id;
      }));
      document.querySelectorAll('.payroll-calc').forEach(btn => btn.addEventListener('click', function() {
        postAction(this.closest('tr').dataset.id, 'tinh-luong', 'Tính lại bảng lương này?');
      }));
      document.querySelectorAll('.payroll-lock').forEach(btn => btn.addEventListener('click', function() {
        postAction(this.closest('tr').dataset.id, 'chot', 'Chốt bảng lương này?');
      }));
      document.querySelectorAll('.payroll-cancel').forEach(btn => btn.addEventListener('click', function() {
        postAction(this.closest('tr').dataset.id, 'huy', 'Hủy bảng lương này?');
      }));
    }
    document.getElementById('filterApplyBtn').addEventListener('click', loadList);
    function openPayrollModal() {
      try {
        const tu = document.getElementById('filterTuNgay').value;
        const den = document.getElementById('filterDenNgay').value;
        document.getElementById('payrollTuNgay').value = tu;
        document.getElementById('payrollDenNgay').value = den;
        document.getElementById('payrollName').value = tu && den ? defaultPayrollName(tu, den) : '';
        document.getElementById('payrollNote').value = '';
        document.getElementById('modalSaveBtn').disabled = false;
        document.getElementById('modalSaveBtn').textContent = 'Lưu';
        payrollModal.classList.add('is-open');
        payrollModal.setAttribute('aria-hidden', 'false');
        document.getElementById('payrollName').focus();
        payrollUiLog('payroll.ui.create.modal_open', { tu_ngay: tu, den_ngay: den });
      } catch (err) {
        payrollUiError('payroll.ui.create.modal_open', err);
        alert('Không mở được form tạo bảng lương: ' + (err.message || err));
      }
    }
    function closePayrollModal() {
      payrollModal.classList.remove('is-open');
      payrollModal.setAttribute('aria-hidden', 'true');
    }
    const payrollAddBtn = document.getElementById('payrollAddBtn');
    if (payrollAddBtn) {
      payrollAddBtn.addEventListener('click', function(event) {
        event.preventDefault();
        openPayrollModal();
      });
    }
    document.getElementById('payrollCancelBtn').addEventListener('click', closePayrollModal);
    payrollModal.addEventListener('click', function(event) {
      if (event.target === payrollModal) closePayrollModal();
    });
    document.addEventListener('keydown', function(event) {
      if (event.key === 'Escape') closePayrollModal();
    });
    document.getElementById('payrollForm').addEventListener('submit', async function(e) {
      e.preventDefault();
      const saveBtn = document.getElementById('modalSaveBtn');
      const payload = {
        ten_bang_luong: document.getElementById('payrollName').value.trim(),
        tu_ngay: document.getElementById('payrollTuNgay').value,
        den_ngay: document.getElementById('payrollDenNgay').value,
        ghi_chu: document.getElementById('payrollNote').value.trim()
      };
      if (!payload.ten_bang_luong) return alert('Vui lòng nhập tên bảng lương');
      if (!payload.tu_ngay || !payload.den_ngay) return alert('Vui lòng chọn từ ngày và đến ngày');
      if (payload.den_ngay < payload.tu_ngay) return alert('Đến ngày không được nhỏ hơn từ ngày');
      payrollUiLog('payroll.ui.create.start', payload);
      saveBtn.disabled = true;
      saveBtn.textContent = 'Đang lưu...';
      try {
        const res = await fetch('/api/bang-luong', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(payload)
        });
        const json = await res.json();
        if (!json.success) {
          payrollUiError('payroll.ui.create.error', json.message, { status: res.status });
          return alert(json.message || 'Không tạo được bảng lương');
        }
        payrollUiLog('payroll.ui.create.success', {
          bang_luong_id: json.item && json.item._id,
          ma_bang_luong: json.item && json.item.ma_bang_luong
        });
        closePayrollModal();
        const newId = json.item && json.item._id;
        if (newId) {
          location.href = '/bang-luong/' + newId;
          return;
        }
        await loadList();
      } catch (err) {
        payrollUiError('payroll.ui.create.error', err);
        alert(err.message || 'Không tạo được bảng lương');
      } finally {
        saveBtn.disabled = false;
        saveBtn.textContent = 'Lưu';
      }
    });
    window.openPayrollModal = openPayrollModal;
    loadList().catch(function(err) {
      payrollUiError('payroll.ui.list.error', err);
      payrollTableBody.innerHTML = '<tr><td colspan="10" class="hr-empty">' + escapeHtml(err.message || 'Không tải được bảng lương') + '</td></tr>';
    });
  </script>
</body>
</html>
