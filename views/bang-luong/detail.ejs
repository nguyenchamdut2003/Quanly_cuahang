<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/stylesheets/style.css">
  <style>
    .hr-setup-shell{display:grid;grid-template-columns:260px minmax(0,1fr);gap:12px;padding:12px 20px 20px}
    .hr-setup-main{background:#fff;border:1px solid #d7dde5;border-radius:8px;padding:14px 16px 16px;min-height:calc(100vh - 140px)}
    .hr-head{display:flex;justify-content:space-between;gap:12px;align-items:flex-start;margin-bottom:12px}
    .hr-page-title{margin:0;font-size:22px;font-weight:700;color:#111827}
    .hr-subtitle{margin:6px 0 0;color:#475467;font-size:13px}
    .hr-toolbar{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
    .summary-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:10px;margin-bottom:12px}
    .summary-item{border:1px solid #e5e9ee;border-radius:8px;padding:10px 12px}
    .summary-label{font-size:11px;color:#667085;margin-bottom:4px}
    .summary-value{font-size:18px;font-weight:700;color:#111827}
    .hr-table-panel{border:1px solid #e5e9ee;border-radius:8px;overflow:auto}
    .hr-table{width:100%;border-collapse:collapse;min-width:1500px}
    .hr-table thead th{background:#e8f3ff;color:#111827;font-size:12px;font-weight:700;height:38px;padding:0 10px;text-align:left;border-bottom:1px solid #bcd9ff;white-space:nowrap}
    .hr-table tbody td{padding:9px 10px;border-bottom:1px solid #e5e9ee;font-size:12px;color:#111827}
    .hr-empty{padding:36px 20px;text-align:center;color:#475467}
    .status-pill{display:inline-flex;align-items:center;height:22px;padding:0 8px;border-radius:5px;font-size:11px;font-weight:700}
    .status-pill.is-draft{background:#f3f4f6;color:#374151}
    .status-pill.is-calculated{background:#dbeafe;color:#1d4ed8}
    .status-pill.is-locked{background:#dcfce7;color:#166534}
    .status-pill.is-cancelled{background:#fee2e2;color:#991b1b}
    .pay-action{white-space:nowrap}
    .pay-note{color:#667085;font-size:11px}
    .pay-paid{color:#166534;font-weight:700}
    .modal-backdrop{position:fixed;inset:0;background:rgba(15,23,42,.48);display:none;align-items:flex-start;justify-content:center;padding-top:42px;z-index:1000}
    .modal-backdrop.open{display:flex}
    .pay-modal{width:520px;max-width:calc(100vw - 32px);background:#fff;border-radius:8px;box-shadow:0 18px 46px rgba(15,23,42,.28);overflow:hidden}
    .pay-modal-head{height:58px;display:flex;align-items:center;justify-content:space-between;padding:0 18px;border-bottom:1px solid #e5e9ee}
    .pay-modal-title{margin:0;font-size:18px;font-weight:700}
    .pay-modal-close{border:0;background:#fff;font-size:24px;cursor:pointer;color:#667085}
    .pay-modal-body{padding:16px 18px;display:grid;gap:12px}
    .pay-grid{display:grid;grid-template-columns:130px minmax(0,1fr);gap:8px 12px;font-size:13px}
    .pay-grid span{color:#667085}
    .pay-field label{display:block;font-size:12px;color:#667085;margin-bottom:5px}
    .pay-field input,.pay-field select{width:100%;height:36px;border:1px solid #cfd8e3;border-radius:6px;padding:0 10px}
    .pay-help{margin-top:5px;font-size:11px;color:#667085}
    .pay-warning{margin-top:5px;font-size:11px;color:#b42318}
    .pay-modal-foot{display:flex;justify-content:flex-end;gap:8px;padding:14px 18px;border-top:1px solid #e5e9ee}
    .pay-history{margin-top:16px}
    .pay-history-title{margin:0 0 10px;font-size:16px;font-weight:700;color:#111827}
    .pay-history-table{width:100%;border-collapse:collapse;min-width:1100px}
    .pay-history-table th,.pay-history-table td{padding:8px 10px;border-bottom:1px solid #e5e9ee;font-size:12px;text-align:left}
    .pay-history-table th{background:#f8fafc;color:#475467;font-weight:700}
    .status-pill.is-paid{background:#dcfce7;color:#166534}
    .status-pill.is-cancelled-receipt{background:#fee2e2;color:#991b1b}
    .cancel-reason{color:#991b1b;font-size:11px;margin-top:4px}
  </style>
</head>
<body class="admin-body">
  <%- include('../partials/header', { activeMenu: activeMenu, user: user }) %>
  <main class="admin-shell">
    <%- include('../partials/flash-message', { flash: flash }) %>
    <div class="hr-setup-shell">
      <%- include('../partials/hr-setup-nav', { activeHrPage: activeHrPage }) %>
      <section class="hr-setup-main">
        <div class="hr-head">
          <div>
            <h1 class="hr-page-title" id="payrollTitle">Chi tiết bảng lương</h1>
            <div class="hr-subtitle" id="payrollMeta">Đang tải...</div>
          </div>
          <div class="hr-toolbar">
            <a class="btn btn-light" href="/bang-luong">Quay lại</a>
            <button type="button" class="btn btn-light" id="calculateBtn">Tính lương</button>
            <button type="button" class="btn btn-primary" id="lockBtn">Chốt</button>
          </div>
        </div>

        <div class="summary-grid" id="summaryGrid"></div>

        <div class="hr-table-panel">
          <table class="hr-table">
            <thead>
              <tr>
                <th>Mã NV</th>
                <th>Tên NV</th>
                <th>Phòng ban</th>
                <th>Chức danh</th>
                <th>Tổng ca</th>
                <th>Tổng công</th>
                <th>Đi muộn</th>
                <th>Về sớm</th>
                <th>Nghỉ làm</th>
                <th>Phút làm việc</th>
                <th>Phút OT</th>
                <th>Lương chính</th>
                <th>Tiền OT</th>
                <th>Thưởng</th>
                <th>Hoa hồng</th>
                <th>Phụ cấp</th>
                <th>Giảm trừ</th>
                <th>Tổng lương</th>
                <th>Đã trả</th>
                <th>Còn cần trả</th>
                <th>Thanh toán</th>
              </tr>
            </thead>
            <tbody id="detailTableBody">
              <tr><td colspan="21" class="hr-empty">Đang tải...</td></tr>
            </tbody>
          </table>
        </div>

        <div class="pay-history">
          <h2 class="pay-history-title">Lịch sử thanh toán</h2>
          <div class="hr-table-panel">
            <table class="pay-history-table">
              <thead>
                <tr>
                  <th>Mã phiếu</th>
                  <th>Nhân viên</th>
                  <th>Số tiền</th>
                  <th>Sổ quỹ</th>
                  <th>Phương thức</th>
                  <th>Ngày lập</th>
                  <th>Trạng thái</th>
                  <th>Ghi chú</th>
                  <th>Thao tác</th>
                </tr>
              </thead>
              <tbody id="paymentHistoryBody">
                <tr><td colspan="9" class="hr-empty">Chưa có phiếu thanh toán</td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </section>
    </div>
  </main>

  <div class="modal-backdrop" id="payModal">
    <form class="pay-modal" id="payForm">
      <div class="pay-modal-head">
        <h2 class="pay-modal-title">Thanh toán lương</h2>
        <button type="button" class="pay-modal-close" id="closePayModal">&times;</button>
      </div>
      <div class="pay-modal-body">
        <div class="pay-grid">
          <span>Nhân viên</span><strong id="payEmployee">---</strong>
          <span>Tổng lương</span><strong id="payTotal">0</strong>
          <span>Đã trả</span><strong id="payPaid">0</strong>
          <span>Còn cần trả</span><strong id="payRemaining">0</strong>
        </div>
        <div class="pay-field">
          <label>Số tiền trả</label>
          <input type="text" id="payAmount" required>
        </div>
        <div class="pay-field">
          <label>Sổ quỹ</label>
          <select id="payCashBook" required></select>
          <div class="pay-help" id="payCashBookHelp">Chon so quy de tao phieu chi luong.</div>
        </div>
        <div class="pay-field">
          <label>Phương thức thanh toán</label>
          <select id="payMethod">
            <option value="tien_mat">Tiền mặt</option>
            <option value="chuyen_khoan">Chuyển khoản</option>
            <option value="vi_dien_tu">Ví điện tử</option>
            <option value="khac">Khác</option>
          </select>
        </div>
        <div class="pay-field">
          <label>Ghi chú</label>
          <input type="text" id="payNote">
        </div>
      </div>
      <div class="pay-modal-foot">
        <button type="button" class="btn btn-light" id="cancelPayBtn">Bỏ qua</button>
        <button type="submit" class="btn btn-primary">Lưu</button>
      </div>
    </form>
  </div>

  <script>
    /*
     * Bật log UI (browser console):
     *   localStorage.setItem('HR_PAYROLL_UI_DEBUG', 'true'); location.reload();
     * Tắt:
     *   localStorage.removeItem('HR_PAYROLL_UI_DEBUG'); location.reload();
     */
    const PAYROLL_UI_DEBUG = localStorage.getItem('HR_PAYROLL_UI_DEBUG') === 'true';
    const payrollId = '<%= payrollId %>';
    const STATUS_LABELS = { draft: 'Nháp', calculated: 'Đã tính', locked: 'Đã chốt', cancelled: 'Đã hủy' };
    let currentPayroll = null;
    let currentDetails = [];
    let currentPayments = [];
    let cashBooks = [];
    let selectedPayDetail = null;

    function payrollUiLog(event, data) {
      if (!PAYROLL_UI_DEBUG) return;
      console.log('[HR_PAYROLL_UI]', event, data || {});
    }
    function payrollUiError(event, err, data) {
      console.error('[HR_PAYROLL_UI_ERROR]', event, err, data || {});
    }

    function escapeHtml(text) {
      return String(text || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }
    function formatMoney(value) {
      return new Intl.NumberFormat('vi-VN').format(Number(value || 0));
    }
    function formatMoneyText(value) {
      return formatMoney(value) + ' VNĐ';
    }
    function formatDateDisplay(value) {
      if (!value) return '---';
      const d = new Date(value);
      if (Number.isNaN(d.getTime())) return '---';
      const vn = new Date(d.getTime() + 7 * 60 * 60000);
      return String(vn.getUTCDate()).padStart(2,'0') + '/' + String(vn.getUTCMonth()+1).padStart(2,'0') + '/' + vn.getUTCFullYear();
    }
    function refName(ref, field) {
      if (!ref || typeof ref !== 'object') return '---';
      return ref[field] || '---';
    }
    function userName(user) {
      if (!user || typeof user !== 'object') return '---';
      return user.ho_ten || user.ten_dang_nhap || user.username || user.email || '---';
    }
    function paymentStatusLabel(status) {
      if (status === 'paid') return 'Đã thanh toán';
      if (status === 'cancelled') return 'Đã hủy';
      return status || '---';
    }
    function paymentMethodLabel(method) {
      const map = { tien_mat: 'Tiền mặt', chuyen_khoan: 'Chuyển khoản', vi_dien_tu: 'Ví điện tử', khac: 'Khác' };
      return map[method] || method || '---';
    }
    function updateCashBookSelectForMethod() {
      const select = document.getElementById('payCashBook');
      const help = document.getElementById('payCashBookHelp');
      if (!cashBooks.length) {
        select.innerHTML = '<option value="">Khong co so quy dang su dung</option>';
        help.className = 'pay-warning';
        help.textContent = 'Can tao hoac kich hoat so quy truoc khi chi luong.';
        return;
      }
      select.innerHTML =
        '<option value="">Chon so quy</option>' +
        cashBooks.map(book => '<option value="' + escapeHtml(book._id) + '">' +
          escapeHtml(book.ten_so_quy || 'So quy') +
          '</option>').join('');
      select.value = '';
      help.className = 'pay-help';
      help.textContent = 'Chon so quy de tao phieu chi luong.';
    }
    function renderPayments(items) {
      const body = document.getElementById('paymentHistoryBody');
      currentPayments = items || [];
      const paidCount = currentPayments.filter(p => p.trang_thai === 'paid').length;
      const cancelledCount = currentPayments.filter(p => p.trang_thai === 'cancelled').length;
      payrollUiLog('payroll.ui.render_payments', {
        total: currentPayments.length,
        paid: paidCount,
        cancelled: cancelledCount,
        ma_phieu: currentPayments.map(p => p.ma_phieu)
      });
      if (!currentPayments.length) {
        body.innerHTML = '<tr><td colspan="9" class="hr-empty">Chưa có phiếu thanh toán</td></tr>';
        return;
      }
      body.innerHTML = currentPayments.map(item => {
        const st = item.trang_thai || 'paid';
        const employeeName = refName(item.nhan_vien_id, 'ten_nhan_vien');
        const employeeCode = refName(item.nhan_vien_id, 'ma_nhan_vien');
        const cashBookName = refName(item.so_quy_id, 'ten_so_quy');
        let actionHtml = '<span class="pay-note">---</span>';
        if (st === 'paid') {
          actionHtml = '<button type="button" class="btn btn-light cancel-pay-btn" data-id="' + escapeHtml(item._id) + '">Hủy phiếu</button>';
        } else if (st === 'cancelled') {
          actionHtml = '<span class="pay-note">Đã hủy</span>';
        }
        const reasonHtml = st === 'cancelled' && item.ly_do_huy
          ? '<div class="cancel-reason">Lý do: ' + escapeHtml(item.ly_do_huy) + '</div>'
          : '';
        return '<tr>' +
          '<td><strong>' + escapeHtml(item.ma_phieu || '---') + '</strong></td>' +
          '<td>' + escapeHtml(employeeCode) + ' - ' + escapeHtml(employeeName) + '</td>' +
          '<td>' + formatMoneyText(item.gia_tri) + '</td>' +
          '<td>' + escapeHtml(cashBookName) + '</td>' +
          '<td>' + escapeHtml(paymentMethodLabel(item.phuong_thuc_thanh_toan)) + '</td>' +
          '<td>' + formatDateDisplay(item.ngay_lap) + '</td>' +
          '<td><span class="status-pill is-' + (st === 'paid' ? 'paid' : 'cancelled-receipt') + '">' + escapeHtml(paymentStatusLabel(st)) + '</span>' + reasonHtml + '</td>' +
          '<td>' + escapeHtml(item.ghi_chu || '---') + '</td>' +
          '<td class="pay-action">' + actionHtml + '</td>' +
        '</tr>';
      }).join('');
      body.querySelectorAll('.cancel-pay-btn').forEach(btn => btn.addEventListener('click', () => cancelPayrollReceipt(btn.dataset.id)));
    }
    async function cancelPayrollReceipt(receiptId) {
      const receipt = currentPayments.find(item => String(item._id) === String(receiptId));
      if (!receipt) return;
      payrollUiLog('payroll.ui.cancel_receipt.start', {
        phieu_id: receiptId,
        ma_phieu: receipt.ma_phieu,
        gia_tri: receipt.gia_tri
      });
      const ok = confirm('Bạn có chắc muốn hủy phiếu chi lương này? Số tiền sẽ được hoàn lại vào sổ quỹ và cập nhật lại bảng lương.');
      if (!ok) return;
      const reason = prompt('Nhập lý do hủy phiếu:', 'Nhập sai số tiền');
      if (reason == null) return;
      const lyDo = String(reason).trim();
      if (!lyDo) return alert('Lý do hủy không được để trống');
      payrollUiLog('payroll.ui.cancel_receipt.payload', { phieu_id: receiptId, ly_do_huy: lyDo });
      try {
        const res = await fetch('/api/bang-luong/phieu-luong/' + receiptId + '/huy', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ ly_do_huy: lyDo })
        });
        const json = await res.json();
        if (!json.success) {
          payrollUiError('payroll.ui.cancel_receipt.error', json.message, { status: res.status, phieu_id: receiptId });
          return alert(json.message || 'Không hủy được phiếu lương');
        }
        payrollUiLog('payroll.ui.cancel_receipt.success', { phieu_id: receiptId, message: json.message });
        await loadDetail();
        await loadCashBooks().catch(() => {});
      } catch (err) {
        payrollUiError('payroll.ui.cancel_receipt.error', err, { phieu_id: receiptId });
        alert(err.message || 'Không hủy được phiếu lương');
      }
    }
    function renderSummary(item) {
      const st = item.trang_thai || 'draft';
      document.getElementById('payrollTitle').textContent = (item.ma_bang_luong || '') + ' - ' + (item.ten_bang_luong || '');
      document.getElementById('payrollMeta').innerHTML =
        formatDateDisplay(item.tu_ngay) + ' - ' + formatDateDisplay(item.den_ngay) +
        ' | <span class="status-pill is-' + escapeHtml(st) + '">' + escapeHtml(STATUS_LABELS[st] || st) + '</span>';
      document.getElementById('summaryGrid').innerHTML = [
        ['Tổng nhân viên', Number(item.tong_nhan_vien || 0)],
        ['Tổng công', Number(item.tong_cong || 0)],
        ['Phút làm việc', Number(item.tong_phut_lam_viec || 0)],
        ['Phút OT', Number(item.tong_phut_tang_ca || 0)],
        ['Tiền OT', formatMoneyText(item.tong_tien_tang_ca) + ' (Phase 1 chưa tính tiền OT)'],
        ['Lương chính', formatMoneyText(item.tong_luong_chinh)],
        ['Phụ cấp', formatMoneyText(item.tong_phu_cap)],
        ['Giảm trừ', formatMoneyText(item.tong_giam_tru)],
        ['Tổng lương', formatMoneyText(item.tong_luong)],
        ['Đã trả NV', formatMoneyText(item.da_tra_nhan_vien)],
        ['Còn cần trả', formatMoneyText(item.con_can_tra)],
        ['Người chốt', userName(item.nguoi_chot_id)],
        ['Ngày chốt', formatDateDisplay(item.ngay_chot)]
      ].map(row => '<div class="summary-item"><div class="summary-label">' + escapeHtml(row[0]) + '</div><div class="summary-value">' + escapeHtml(row[1]) + '</div></div>').join('');
      document.getElementById('calculateBtn').style.display = st === 'locked' || st === 'cancelled' ? 'none' : '';
      document.getElementById('lockBtn').style.display = st === 'calculated' ? '' : 'none';
    }
    function renderDetails(items) {
      const body = document.getElementById('detailTableBody');
      currentDetails = items || [];
      let payBtnCount = 0;
      let paidRowCount = 0;
      if (!items.length) {
        body.innerHTML = '<tr><td colspan="21" class="hr-empty">Chưa có chi tiết lương. Bấm Tính lương để tạo.</td></tr>';
        payrollUiLog('payroll.ui.render_details', { rows: 0, pay_buttons: 0, paid_rows: 0 });
        return;
      }
      body.innerHTML = items.map(item => {
        const remaining = Number(item.con_can_tra || 0);
        const payrollLocked = (currentPayroll && currentPayroll.trang_thai) === 'locked';
        const itemLocked = item.trang_thai === 'locked';
        let actionHtml = '<span class="pay-note">Chỉ thanh toán sau khi chốt bảng lương</span>';
        if (payrollLocked && itemLocked && remaining > 0) {
          actionHtml = '<button type="button" class="btn btn-light pay-btn" data-id="' + escapeHtml(item._id) + '">Thanh toán</button>';
          payBtnCount += 1;
        } else if (payrollLocked && !itemLocked) {
          actionHtml = '<span class="pay-note">Dòng lương chưa chốt</span>';
        } else if (remaining <= 0 && Number(item.tong_luong || 0) > 0) {
          actionHtml = '<span class="pay-paid">Đã thanh toán</span>';
          paidRowCount += 1;
        }
        return '<tr>' +
        '<td>' + escapeHtml(item.ma_nhan_vien || '---') + '</td>' +
        '<td><strong>' + escapeHtml(item.ten_nhan_vien || '---') + '</strong></td>' +
        '<td>' + escapeHtml(refName(item.phong_ban_id, 'ten_phong_ban')) + '</td>' +
        '<td>' + escapeHtml(refName(item.chuc_danh_id, 'ten_chuc_danh')) + '</td>' +
        '<td>' + Number(item.tong_ca || 0) + '</td>' +
        '<td>' + Number(item.tong_cong_quy_doi || 0) + '</td>' +
        '<td>' + Number(item.so_lan_di_muon || 0) + '</td>' +
        '<td>' + Number(item.so_lan_ve_som || 0) + '</td>' +
        '<td>' + Number(item.so_lan_nghi_lam || 0) + '</td>' +
        '<td>' + Number(item.tong_phut_lam_viec || 0) + '</td>' +
        '<td>' + Number(item.tong_phut_tang_ca || 0) + '</td>' +
        '<td>' + formatMoneyText(item.luong_chinh) + '</td>' +
        '<td title="Phase 1 chua tinh tien OT">' + formatMoneyText(item.tien_tang_ca) + '</td>' +
        '<td>' + formatMoneyText(item.tien_thuong) + '</td>' +
        '<td>' + formatMoneyText(item.tien_hoa_hong) + '</td>' +
        '<td>' + formatMoneyText(item.tien_phu_cap) + '</td>' +
        '<td>' + formatMoneyText(item.tien_giam_tru) + '</td>' +
        '<td>' + formatMoneyText(item.tong_luong) + '</td>' +
        '<td>' + formatMoneyText(item.da_tra) + '</td>' +
        '<td>' + formatMoneyText(item.con_can_tra) + '</td>' +
        '<td class="pay-action">' + actionHtml + '</td>' +
      '</tr>';
      }).join('');
      body.querySelectorAll('.pay-btn').forEach(btn => btn.addEventListener('click', () => openPayModal(btn.dataset.id)));
      payrollUiLog('payroll.ui.render_details', {
        bang_luong_status: currentPayroll && currentPayroll.trang_thai,
        rows: items.length,
        pay_buttons: payBtnCount,
        paid_rows: paidRowCount
      });
    }
    async function loadCashBooks() {
      const res = await fetch('/api/so-quy/active', { headers: { Accept: 'application/json' } });
      const json = await res.json();
      if (!json.success) throw new Error(json.message || 'Không tải được sổ quỹ');
      cashBooks = json.items || [];
      payrollUiLog('payroll.ui.load_cashbooks', { count: cashBooks.length });
      updateCashBookSelectForMethod();
    }
    function openPayModal(detailId) {
      selectedPayDetail = currentDetails.find(item => String(item._id) === String(detailId));
      if (!selectedPayDetail) return;
      if (!cashBooks.length) loadCashBooks().catch(error => {
        document.getElementById('payCashBookHelp').className = 'pay-warning';
        document.getElementById('payCashBookHelp').textContent = error.message || 'Khong tai duoc so quy';
      });
      const remaining = Number(selectedPayDetail.con_can_tra || 0);
      payrollUiLog('payroll.ui.payment_modal.open', {
        ct_bang_luong_id: detailId,
        nhan_vien: selectedPayDetail.ten_nhan_vien || selectedPayDetail.ma_nhan_vien,
        tong_luong: selectedPayDetail.tong_luong,
        da_tra: selectedPayDetail.da_tra,
        con_can_tra: remaining
      });
      document.getElementById('payEmployee').textContent = selectedPayDetail.ten_nhan_vien || selectedPayDetail.ma_nhan_vien || '---';
      document.getElementById('payTotal').textContent = formatMoneyText(selectedPayDetail.tong_luong);
      document.getElementById('payPaid').textContent = formatMoneyText(selectedPayDetail.da_tra);
      document.getElementById('payRemaining').textContent = formatMoneyText(remaining);
      document.getElementById('payAmount').value = formatMoney(remaining);
      document.getElementById('payNote').value = '';
      updateCashBookSelectForMethod();
      document.getElementById('payModal').classList.add('open');
    }
    function closePayModal() {
      document.getElementById('payModal').classList.remove('open');
      selectedPayDetail = null;
    }
    function parseAmount(value) {
      return Number(String(value || '').replace(/\./g, '').replace(/,/g, '')) || 0;
    }
    async function submitPayment(event) {
      event.preventDefault();
      if (!selectedPayDetail) return;
      const amount = parseAmount(document.getElementById('payAmount').value);
      const remaining = Number(selectedPayDetail.con_can_tra || 0);
      const payload = {
        so_tien: amount,
        phuong_thuc_thanh_toan: document.getElementById('payMethod').value,
        ghi_chu: document.getElementById('payNote').value.trim()
      };
      const cashBookId = document.getElementById('payCashBook').value;
      if (!cashBookId) return alert('Vui lòng chọn sổ quỹ để chi lương.');
      payload.so_quy_id = cashBookId;
      payrollUiLog('payroll.ui.payment.submit.start', { ct_id: selectedPayDetail._id });
      payrollUiLog('payroll.ui.payment.submit.payload', payload);
      if (amount <= 0) return alert('Số tiền trả phải lớn hơn 0');
      if (amount > remaining) return alert('Số tiền trả vượt quá số tiền còn cần trả');
      try {
        const res = await fetch('/api/bang-luong/ct/' + selectedPayDetail._id + '/thanh-toan', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(payload)
        });
        const json = await res.json();
        if (!json.success) {
          payrollUiError('payroll.ui.payment.submit.error', json.message, { status: res.status, ct_id: selectedPayDetail._id });
          return alert(json.message || 'Không thanh toán được lương');
        }
        payrollUiLog('payroll.ui.payment.submit.success', {
          ct_id: selectedPayDetail._id,
          ma_phieu: json.receipt && json.receipt.ma_phieu,
          message: json.message
        });
        closePayModal();
        await loadDetail();
        await loadCashBooks().catch(() => {});
        alert('Da thanh toan luong' + (json.receipt && json.receipt.ma_phieu ? ': ' + json.receipt.ma_phieu : ''));
      } catch (err) {
        payrollUiError('payroll.ui.payment.submit.error', err, { ct_id: selectedPayDetail._id });
        alert(err.message || 'Không thanh toán được lương');
      }
    }
    async function loadDetail() {
      payrollUiLog('payroll.ui.load_detail.start', { bang_luong_id: payrollId });
      try {
        const res = await fetch('/api/bang-luong/' + payrollId, { headers: { Accept: 'application/json' } });
        const json = await res.json();
        if (!json.success) {
          payrollUiError('payroll.ui.load_detail.error', json.message, { status: res.status });
          return alert(json.message || 'Không tải được bảng lương');
        }
        currentPayroll = json.item;
        renderSummary(json.item);
        renderDetails(json.details || []);
        renderPayments(json.payments || []);
        payrollUiLog('payroll.ui.load_detail.success', {
          bang_luong_id: payrollId,
          status: json.item && json.item.trang_thai,
          detail_count: (json.details || []).length,
          payment_count: (json.payments || []).length,
          tong_luong: json.item && json.item.tong_luong,
          da_tra_nhan_vien: json.item && json.item.da_tra_nhan_vien,
          con_can_tra: json.item && json.item.con_can_tra
        });
      } catch (err) {
        payrollUiError('payroll.ui.load_detail.error', err, { bang_luong_id: payrollId });
        alert(err.message || 'Không tải được bảng lương');
      }
    }
    async function postAction(action, confirmText) {
      if (confirmText && !confirm(confirmText)) return;
      payrollUiLog('payroll.ui.post_action', { action: action, bang_luong_id: payrollId });
      const res = await fetch('/api/bang-luong/' + payrollId + '/' + action, { method: 'POST', headers: { Accept: 'application/json' } });
      const json = await res.json();
      if (!json.success) {
        payrollUiError('payroll.ui.post_action.error', json.message, { action: action, status: res.status });
        return alert(json.message || 'Lỗi thao tác');
      }
      payrollUiLog('payroll.ui.post_action.success', { action: action });
      await loadDetail();
    }
    document.getElementById('calculateBtn').addEventListener('click', () => postAction('tinh-luong', 'Tính lại bảng lương này?'));
    document.getElementById('lockBtn').addEventListener('click', () => postAction('chot', 'Chốt bảng lương này?'));
    document.getElementById('closePayModal').addEventListener('click', closePayModal);
    document.getElementById('cancelPayBtn').addEventListener('click', closePayModal);
    document.getElementById('payForm').addEventListener('submit', submitPayment);
    document.getElementById('payAmount').addEventListener('blur', event => { event.target.value = formatMoney(parseAmount(event.target.value)); });
    document.getElementById('payMethod').addEventListener('change', updateCashBookSelectForMethod);
    loadCashBooks().catch(() => {});
    loadDetail();
  </script>
</body>
</html>
