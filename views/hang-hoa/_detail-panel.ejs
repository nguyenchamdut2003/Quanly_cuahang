<div class="kv-detail-panel product-detail" data-product-id="<%= item._id %>">
  <div class="detail-tabs">
    <div class="detail-tab-list">
      <button class="detail-tab is-active" type="button" data-tab-target="product-info">Th&ocirc;ng tin</button>
      <button class="detail-tab" type="button" data-tab-target="product-note">M&ocirc; t&#7843;, ghi ch&uacute;</button>
      <button class="detail-tab" type="button" data-tab-target="product-card">Th&#7867; kho</button>
      <button class="detail-tab" type="button" data-tab-target="product-stock">T&#7891;n kho</button>
      <% if (item.quan_ly_theo_lo) { %>
        <button class="detail-tab" type="button" data-tab-target="product-lots">L&ocirc; HSD</button>
        <% } %>
          <button class="detail-tab" type="button" data-tab-target="product-lot-profit">L&#7901;i l&#7895; theo
            l&ocirc;</button>
    </div>
  </div>

  <div class="product-detail-body">
    <section class="detail-pane is-active" data-tab-panel="product-info">
      <div class="product-info-head">
        <div class="product-thumb">HH</div>
        <div>
          <h2>
            <%= item.ten_hang || 'H&agrave;ng h&oacute;a' %>
          </h2>
          <p>Nh&oacute;m h&agrave;ng: <%= item.nhom_hang_ten || '---' %>
          </p>
          <div class="tag-row">
            <span class="tag">H&agrave;ng h&oacute;a th&#432;&#7901;ng</span>
            <span class="tag tag-green"><%- item.ban_truc_tiep ? 'B&aacute;n tr&#7921;c ti&#7871;p'
                : 'Kh&ocirc;ng b&aacute;n tr&#7921;c ti&#7871;p' %></span>
            <span class="tag"><%- item.quan_ly_theo_lo ? 'Qu&#7843;n l&yacute; theo l&ocirc;'
                : 'Kh&ocirc;ng qu&#7843;n l&yacute; theo l&ocirc;' %></span>
          </div>
        </div>
      </div>

      <div class="product-info-grid">
        <div><span>M&atilde; h&agrave;ng</span><strong><%- refLink('product', item, item.ma_hang || '---' ) %></strong>
        </div>
        <div><span>Th&#7921;c t&#7871;</span><strong>
            <%= Number(item.ton_kho || 0).toLocaleString('vi-VN') %>
          </strong></div>
        <div><span>C&oacute; th&#7875; b&aacute;n</span><strong>
            <%= Number(item.ton_co_the_giao || 0).toLocaleString('vi-VN') %>
          </strong></div>
        <div><span>H&#7871;t h&#7841;n</span><strong>
            <%= Number(item.ton_het_han || 0).toLocaleString('vi-VN') %>
          </strong></div>
        <div><span>&#272;&#7883;nh m&#7913;c t&#7891;n</span><strong>
            <%= Number(item.dinh_muc_toi_thieu || 0).toLocaleString('vi-VN') %> - 0
          </strong></div>
        <div><span>Gi&aacute; v&#7889;n</span><strong>
            <%= Number(item.gia_von_trung_binh_hien_thi !=null ? item.gia_von_trung_binh_hien_thi : item.gia_von ||
              0).toLocaleString('vi-VN') %>
          </strong></div>
        <div><span>Gi&aacute; b&aacute;n</span><strong>
            <%= Number(item.gia_ban_hien_thi || 0).toLocaleString('vi-VN') %>
          </strong></div>
        <div><span>&#272;&#417;n v&#7883; t&iacute;nh</span><strong>
            <%= item.don_vi_tinh_ten || '---' %>
          </strong></div>
        <div><span>Nh&agrave; cung c&#7845;p</span><strong>
            <%= item.nha_cung_cap_ten || '---' %>
          </strong></div>
        <div><span>Tr&#7841;ng th&aacute;i</span><strong><%- item.trang_thai==='inactive' ? 'Ng&#7915;ng kinh doanh'
              : '&#272;ang kinh doanh' %></strong></div>
      </div>
      <% if (item.co_ton_nhung_khong_the_giao) { %>
        <div class="stock-warning-box">
          <strong>C&oacute; t&#7891;n th&#7921;c t&#7871; nh&#432;ng kh&ocirc;ng th&#7875; giao:</strong>
          <span>
            <%= item.ly_do_khong_the_giao || 'C&oacute; th&#7875; b&aacute;n = 0.' %>
          </span>
        </div>
        <% } %>
      <div class="page-actions product-detail-footer page-actions--sm">
        <button class="btn btn-danger btn-sm btn-trash-product" type="button" data-product-id="<%= item._id %>"
          data-product-code="<%= item.ma_hang || '' %>" data-product-name="<%= item.ten_hang || '' %>">X&oacute;a</button>
        <button class="btn btn-light btn-sm btn-copy-product" type="button"
          data-product='<%- JSON.stringify(item) %>'>Sao ch&eacute;p</button>
        <button class="btn btn-primary btn-sm btn-edit-product" type="button"
          data-product='<%- JSON.stringify(item) %>'>Ch&#7881;nh s&#7917;a</button>
        <button class="btn btn-light btn-sm btn-print-label" type="button"
          data-product='<%- JSON.stringify(item) %>'>In tem m&atilde;</button>
        <a class="btn btn-light btn-sm"
          href="/hang-hoa/hd-nguyen-tac?keyword=<%= encodeURIComponent(item.ma_hang || item.ten_hang || '') %>"
          target="_blank">H&#272; nguy&ecirc;n t&#7855;c</a>
      </div>
    </section>

    <% const moTaText=String(item.mo_ta || '' ).trim(); const ghiChuDatHangText=String(item.ghi_chu_dat_hang || ''
      ).trim(); %>
      <section class="detail-pane product-note-pane" data-tab-panel="product-note">
        <div class="product-note-toolbar">
          <button type="button" class="btn btn-light btn-sm" data-product-note-edit>Chỉnh sửa</button>
        </div>
        <div class="product-note-cards">
          <div class="product-note-card">
            <h4 class="product-note-card-title">Mô tả</h4>
            <div class="product-note-card-body" data-note-view="mo_ta">
              <% if (moTaText) { %>
                <div class="product-note-text">
                  <%= moTaText %>
                </div>
                <% } else { %>
                  <p class="product-note-empty">Chưa có mô tả</p>
                  <% } %>
            </div>
          </div>
          <div class="product-note-card">
            <h4 class="product-note-card-title">Ghi chú đặt hàng</h4>
            <div class="product-note-card-body" data-note-view="ghi_chu_dat_hang">
              <% if (ghiChuDatHangText) { %>
                <div class="product-note-text">
                  <%= ghiChuDatHangText %>
                </div>
                <% } else { %>
                  <p class="product-note-empty">Chưa có ghi chú</p>
                  <% } %>
            </div>
          </div>
        </div>
        <div class="product-note-modal" data-product-note-modal hidden>
          <div class="product-note-modal-backdrop" data-product-note-close></div>
          <div class="product-note-modal-dialog" role="dialog" aria-labelledby="productNoteModalTitle_<%= item._id %>">
            <div class="product-note-modal-header">
              <h3 id="productNoteModalTitle_<%= item._id %>">Chỉnh sửa mô tả, ghi chú</h3>
              <button type="button" class="product-note-modal-close" data-product-note-close
                aria-label="Đóng">&times;</button>
            </div>
            <div class="product-note-modal-body">
              <label class="product-note-field">
                <span>Mô tả</span>
                <textarea rows="5" data-product-note-input="mo_ta" placeholder="Nhập mô tả hàng hóa"></textarea>
              </label>
              <label class="product-note-field">
                <span>Ghi chú đặt hàng</span>
                <textarea rows="5" data-product-note-input="ghi_chu_dat_hang"
                  placeholder="Nhập ghi chú khi đặt hàng"></textarea>
              </label>
              <p class="product-note-modal-status muted-line" data-product-note-status></p>
            </div>
            <div class="product-note-modal-footer">
              <button type="button" class="btn btn-light btn-sm" data-product-note-close>Bỏ qua</button>
              <button type="button" class="btn btn-primary btn-sm" data-product-note-save>Lưu</button>
            </div>
          </div>
        </div>
      </section>

      <section class="detail-pane" data-tab-panel="product-card" data-product-lazy-tab="product-card"
        data-lazy-url="/hang-hoa/api/<%= item._id %>/card">
        <div class="empty-cell">Chọn tab để tải thẻ kho.</div>
      </section>

      <section class="detail-pane" data-tab-panel="product-stock" data-product-lazy-tab="product-stock"
        data-lazy-url="/hang-hoa/api/<%= item._id %>/stock">
        <div class="empty-cell">Chọn tab để tải tồn kho.</div>
      </section>

      <% if (item.quan_ly_theo_lo) { %>
        <section class="detail-pane" data-tab-panel="product-lots" data-product-lazy-tab="product-lots"
          data-lazy-url="/hang-hoa/api/<%= item._id %>/lots">
          <div class="empty-cell">Chọn tab để tải lô HSD.</div>
        </section>
        <% } %>

          <section class="detail-pane" data-tab-panel="product-lot-profit" id="lotProfitPane_<%= item._id %>">
            <div class="lot-profit-toolbar">
              <div class="lot-profit-filters">
                <label>Lô
                  <select class="lot-profit-filter" data-field="lo_hang_id">
                    <option value="">Tất cả</option>
                  </select>
                </label>
                <button type="button" class="btn btn-primary btn-sm lot-profit-export">Xuất file</button>
              </div>
            </div>
            <div class="lot-profit-status" data-lot-profit-status></div>
            <table class="admin-table product-inner-table lot-profit-table">
              <thead>
                <tr>
                  <th class="lot-col-expand"></th>
                  <th class="lot-profit-date-th">Ngày nhập lô</th>
                  <th>Tên hàng</th>
                  <th>Lô</th>
                  <th class="lot-profit-spec-th">Thuộc tính</th>
                  <th class="text-right">Số lượng nhập</th>
                  <th class="text-right">ĐG nhập</th>
                  <th class="text-right">Tổng giá vốn</th>
                  <th class="text-right">SL xuất</th>
                  <th class="text-right">ĐG xuất BQ</th>
                  <th class="text-right">Tổng doanh thu</th>
                  <th class="text-right">Lợi nhuận</th>
                </tr>
              </thead>
              <tbody data-lot-profit-body>
                <tr>
                  <td colspan="12" class="empty-cell">Chọn tab để tải báo cáo.</td>
                </tr>
              </tbody>
              <tfoot data-lot-profit-foot style="display:none">
                <tr class="lot-profit-total-row">
                  <td colspan="7" class="text-right"><strong>Tổng</strong></td>
                  <td class="text-right" data-sum-gia-von>0</td>
                  <td class="text-right" data-sum-sl-xuat>0</td>
                  <td></td>
                  <td class="text-right" data-sum-doanh-thu>0</td>
                  <td class="text-right" data-sum-loi-nhuan>0</td>
                </tr>
              </tfoot>
            </table>
          </section>
  </div>
</div>
