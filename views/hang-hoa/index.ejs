  <script id="productGroupsSeed" type="application/json"><%- JSON.stringify(groups || []) %></script>
  <script id="unitTypesSeed" type="application/json"><%- JSON.stringify(units || []) %></script>
  <script src="/js/kv-inline-detail.js"></script>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      var masterTable = document.querySelector('table[data-kv-master="hang-hoa"]');
      function productMoney(value) {
        return Number(value || 0).toLocaleString('vi-VN');
      }
      function loadVisibleProductMetrics() {
        if (!masterTable) return;
        var rows = Array.prototype.slice.call(masterTable.querySelectorAll('tr[data-kv-detail-id]')).slice(0, 10);
        var ids = rows.map(function(row) { return row.getAttribute('data-kv-detail-id') || ''; }).filter(Boolean);
        if (!ids.length) return;
        fetch('/hang-hoa/api/table-metrics?ids=' + encodeURIComponent(ids.join(',')), {
          credentials: 'same-origin',
          headers: { Accept: 'application/json', 'X-Requested-With': 'XMLHttpRequest' }
        })
          .then(function(response) { return response.json(); })
          .then(function(data) {
            if (!data || !data.success) throw new Error(data && data.message || 'Không tải được chỉ số hàng hóa.');
            var metrics = data.metrics || {};
            rows.forEach(function(row) {
              var id = row.getAttribute('data-kv-detail-id') || '';
              var metric = metrics[id] || {};
              var costCell = row.querySelector('[data-product-metric="gia_von_trung_binh"]');
              var saleCell = row.querySelector('[data-product-metric="gia_ban_trung_binh"]');
              var stockCell = row.querySelector('[data-product-metric="ton_kho"]');
              if (costCell) costCell.textContent = productMoney(metric.gia_von_trung_binh);
              if (saleCell) saleCell.textContent = metric.gia_ban_trung_binh == null ? '---' : productMoney(metric.gia_ban_trung_binh);
              if (stockCell) stockCell.textContent = productMoney(metric.ton_kho);
            });
          })
          .catch(function() {
            rows.forEach(function(row) {
              row.querySelectorAll('[data-product-metric]').forEach(function(cell) {
                cell.textContent = '---';
              });
            });
          });
      }
      loadVisibleProductMetrics();
      function fetchProductTabHtml(url) {
        return fetch(url, {
          credentials: 'same-origin',
          headers: { Accept: 'text/html', 'X-Requested-With': 'XMLHttpRequest' }
        }).then(function(response) {
          return response.text().then(function(html) {
            if (!response.ok) throw new Error(html || 'Không tải được dữ liệu tab.');
            return html;
          });
        });
      }
      function loadProductLazyPane(pane, url, force) {
        if (!pane || !url) return Promise.resolve();
        if (!force && pane.getAttribute('data-lazy-loaded') === '1') return Promise.resolve();
        pane.innerHTML = '<div class="empty-cell">Đang tải dữ liệu...</div>';
        return fetchProductTabHtml(url)
          .then(function(html) {
            pane.innerHTML = html;
            pane.setAttribute('data-lazy-loaded', '1');
            if (window.kvInlineBindDetailTabs) {
              window.kvInlineBindDetailTabs(pane);
            }
          })
          .catch(function(error) {
            pane.innerHTML = '<div class="empty-cell">' + (error.message || 'Không tải được dữ liệu tab.') + '</div>';
          });
      }
      function bindProductInlinePanel(rootEl) {
        var root = rootEl.querySelector('.product-detail') || rootEl;
        if (!root || root.getAttribute('data-product-lazy-bound') === '1') return;
        root.setAttribute('data-product-lazy-bound', '1');
        root.querySelectorAll('.detail-tab[data-tab-target]').forEach(function(tab) {
          tab.addEventListener('click', function() {
            var target = tab.getAttribute('data-tab-target') || '';
            var pane = root.querySelector('.detail-pane[data-tab-panel="' + target + '"]');
            if (!pane) return;
            loadProductLazyPane(pane, pane.getAttribute('data-lazy-url') || '', false);
          });
        });
        root.addEventListener('click', function(event) {
          var pageLink = event.target.closest('[data-product-tab-page-url]');
          if (!pageLink) return;
          event.preventDefault();
          if (pageLink.classList.contains('is-disabled') || pageLink.classList.contains('is-active')) return;
          var pane = pageLink.closest('.detail-pane[data-tab-panel]');
          loadProductLazyPane(pane, pageLink.getAttribute('data-product-tab-page-url') || pageLink.getAttribute('href') || '', true);
        });
      }
      if (masterTable && typeof KvInlineDetail !== 'undefined') {
        var kvHangHoa = new KvInlineDetail({
          table: masterTable,
          colspan: 9,
          buildUrl: function(id) {
            return '/hang-hoa/api/' + encodeURIComponent(id) + '/detail';
          },
          onOpen: function(id, root) {
            bindProductInlinePanel(root);
          }
        });
        if (/^#p-/.test(location.hash)) {
          var pid = decodeURIComponent(location.hash.slice(3));
          if (pid) {
            kvHangHoa.openById(pid);
            var clean = location.pathname + (location.search || '');
            history.replaceState(null, '', clean);
          }
        }
      }

      var createdRadios = Array.prototype.slice.call(document.querySelectorAll('input[name="created"]'));
      var customDateRange = document.getElementById('customDateRange');
      function toggleCustomDateRange() {
        if (!customDateRange) return;
        var selected = createdRadios.find(function(radio) { return radio.checked; });
        customDateRange.classList.toggle('is-visible', selected && selected.value === 'custom');
      }
      createdRadios.forEach(function(radio) {
        radio.addEventListener('change', toggleCustomDateRange);
      });
      toggleCustomDateRange();

      var pillButtons = Array.prototype.slice.call(document.querySelectorAll('.pill-btn'));
      pillButtons.forEach(function(btn) {
        btn.addEventListener('click', function() {
          var targetInputId = btn.getAttribute('data-target-input');
          var value = btn.getAttribute('data-value');
          var input = document.getElementById(targetInputId);
          if (!input) return;
          input.value = value;
          var siblings = Array.prototype.slice.call(btn.parentElement.querySelectorAll('.pill-btn'));
          siblings.forEach(function(item) { item.classList.remove('is-active'); });
          btn.classList.add('is-active');
        });
      });

      var openAddProductModalBtn = document.getElementById('openAddProductModal');
      var addProductModalOverlay = document.getElementById('addProductModalOverlay');
      var addProductModalClose = document.getElementById('addProductModalClose');
      var addProductModalCancel = document.getElementById('addProductModalCancel');
      var productModalTitle = document.getElementById('productModalTitle');
      var productModalSubmitBtn = document.getElementById('productModalSubmitBtn');
      var productCreateForm = document.getElementById('productCreateForm');
      var PRODUCT_VN_NUM_FIELDS = ['gia_von', 'gia_co_dinh', 'ton_ban_dau', 'dinh_muc_toi_thieu'];

      function parseProductNum(value) {
        var raw = String(value || '').replace(/\./g, '').replace(/,/g, '').replace(/[^\d]/g, '');
        return raw === '' ? '' : String(Math.max(0, Math.floor(Number(raw) || 0)));
      }

      function formatProductNum(value) {
        var parsed = parseProductNum(value);
        if (parsed === '') return '';
        return Number(parsed).toLocaleString('vi-VN');
      }

      function applyProductVNFormat(el) {
        if (!el) return;
        var start = el.selectionStart == null ? el.value.length : el.selectionStart;
        var digitsBefore = String(el.value).slice(0, start).replace(/\D/g, '').length;
        var raw = String(el.value).replace(/\./g, '').replace(/,/g, '').replace(/[^\d]/g, '');
        if (!raw) {
          el.value = '';
          return;
        }
        var formatted = formatProductNum(raw);
        el.value = formatted;
        var pos = formatted.length;
        if (digitsBefore > 0) {
          var digits = 0;
          for (var i = 0; i < formatted.length; i++) {
            if (/\d/.test(formatted[i])) {
              digits++;
              if (digits === digitsBefore) {
                pos = i + 1;
                break;
              }
            }
          }
        } else {
          pos = 0;
        }
        try { el.setSelectionRange(pos, pos); } catch (_) {}
      }

      function bindProductVNInput(el) {
        if (!el || el.dataset.vnBound === '1') return;
        el.dataset.vnBound = '1';
        el.addEventListener('input', function() {
          applyProductVNFormat(el);
        });
        el.addEventListener('blur', function() {
          var parsed = parseProductNum(el.value);
          el.value = parsed === '' ? '' : formatProductNum(parsed);
        });
      }

      function initProductVNInputs() {
        if (!productCreateForm) return;
        PRODUCT_VN_NUM_FIELDS.forEach(function(name) {
          var input = productCreateForm.querySelector('[name="' + name + '"]');
          if (!input) return;
          bindProductVNInput(input);
          input.value = formatProductNum(input.value || 0);
        });
      }

      function formatAllProductVNFields() {
        if (!productCreateForm) return;
        PRODUCT_VN_NUM_FIELDS.forEach(function(name) {
          var input = productCreateForm.querySelector('[name="' + name + '"]');
          if (!input) return;
          input.value = formatProductNum(input.value || 0);
        });
      }
      var productPriceType = document.getElementById('productPriceType');
      var fixedPriceWrap = document.getElementById('fixedPriceWrap');
      var productManageLotCheckbox = document.getElementById('productManageLotCheckbox');
      var initialLotFields = document.getElementById('initialLotFields');
      var hsdMacDinhInput = document.getElementById('hsdMacDinhInput');
      var hsdMacDinhPreview = document.getElementById('hsdMacDinhPreview');
      var selectAllProducts = document.getElementById('selectAllProducts');
      var productCheckboxes = Array.prototype.slice.call(document.querySelectorAll('.product-checkbox'));
      var customerTableWrap = document.querySelector('.customer-table-wrap');
      var openProductTrashModalBtn = document.getElementById('openProductTrashModal');
      var productTrashModalOverlay = document.getElementById('productTrashModalOverlay');
      var productTrashModalClose = document.getElementById('productTrashModalClose');
      var productTrashCancel = document.getElementById('productTrashCancel');
      var productTrashConfirm = document.getElementById('productTrashConfirm');
      var productTrashAlert = document.getElementById('productTrashAlert');
      var productTrashSelectedList = document.getElementById('productTrashSelectedList');
      var productTrashLoading = document.getElementById('productTrashLoading');
      var productTrashImpactTable = document.getElementById('productTrashImpactTable');
      var productTrashImpactRows = document.getElementById('productTrashImpactRows');
      var pendingProductTrashIds = [];
      function toggleFixedPrice() {
        if (!fixedPriceWrap || !productPriceType) return;
        fixedPriceWrap.style.display = productPriceType.value === 'co_dinh' ? '' : 'none';
      }

      function toggleInitialLotFields() {
        if (!initialLotFields || !productManageLotCheckbox) return;
        initialLotFields.style.display = productManageLotCheckbox.checked ? '' : 'none';
        if (productManageLotCheckbox.checked) updateHsdPreview();
      }

      function updateHsdPreview() {
        if (!hsdMacDinhPreview) return;
        var days = Number(hsdMacDinhInput && hsdMacDinhInput.value);
        if (!Number.isFinite(days) || days < 0) days = 0;
        var date = new Date();
        date.setHours(0, 0, 0, 0);
        date.setDate(date.getDate() + days);
        var dd = String(date.getDate()).padStart(2, '0');
        var mm = String(date.getMonth() + 1).padStart(2, '0');
        var yyyy = date.getFullYear();
        hsdMacDinhPreview.textContent = 'HSD dự kiến: ' + dd + '/' + mm + '/' + yyyy;
      }

      function setProductFormValue(name, value) {
        if (!productCreateForm) return;
        var input = productCreateForm.querySelector('[name="' + name + '"]');
        if (!input) return;
        if (PRODUCT_VN_NUM_FIELDS.indexOf(name) >= 0) {
          input.value = formatProductNum(value == null ? 0 : value);
          return;
        }
        input.value = value == null ? '' : String(value);
      }

      function setProductCheckbox(name, value) {
        if (!productCreateForm) return;
        var input = productCreateForm.querySelector('input[name="' + name + '"]');
        if (!input) return;
        input.checked = !!value;
      }

      function openAddProductModal() {
        if (!addProductModalOverlay) return;
        if (productModalTitle) productModalTitle.textContent = 'Tạo hàng hóa';
        if (productModalSubmitBtn) productModalSubmitBtn.textContent = 'Lưu';
        if (productCreateForm) {
          productCreateForm.setAttribute('action', '/hang-hoa/add');
          productCreateForm.reset();
          formatAllProductVNFields();
        }
        setProductFormValue('han_su_dung_mac_dinh_so_ngay', 5);
        if (typeof refreshProductFormGroup === 'function') refreshProductFormGroup('');
        if (typeof refreshProductFormUnit === 'function') refreshProductFormUnit('');
        addProductModalOverlay.classList.add('is-visible');
        toggleFixedPrice();
        toggleInitialLotFields();
        updateHsdPreview();
      }

      function openEditProductModal(product) {
        if (!addProductModalOverlay || !product || !product._id) return;
        if (productModalTitle) productModalTitle.textContent = 'Sửa hàng hóa';
        if (productModalSubmitBtn) productModalSubmitBtn.textContent = 'Cập nhật';
        if (productCreateForm) {
          productCreateForm.setAttribute('action', '/hang-hoa/' + product._id + '/update');
        }

        setProductFormValue('ma_hang', product.ma_hang || '');
        setProductFormValue('ten_hang', product.ten_hang || '');
        setProductFormValue('nha_cung_cap_id', product.nha_cung_cap_id || '');
        setProductFormValue('gia_von', Number(product.gia_von || 0));
        setProductFormValue('loai_gia', product.loai_gia || 'thi_truong');
        setProductFormValue('gia_co_dinh', Number(product.gia_co_dinh || 0));
        setProductFormValue('ton_ban_dau', Number(product.ton_ban_dau || 0));
        setProductFormValue('dinh_muc_toi_thieu', Number(product.dinh_muc_toi_thieu || 0));
        setProductFormValue('mo_ta', product.mo_ta || '');
        setProductFormValue('trang_thai', product.trang_thai || 'active');
        setProductCheckbox('ban_truc_tiep', !!product.ban_truc_tiep);
        setProductCheckbox('quan_ly_theo_lo', !!product.quan_ly_theo_lo);
        setProductFormValue(
          'han_su_dung_mac_dinh_so_ngay',
          product.han_su_dung_mac_dinh_so_ngay != null ? product.han_su_dung_mac_dinh_so_ngay : 5
        );

        if (typeof refreshProductFormGroup === 'function') {
          refreshProductFormGroup(product.nhom_hang_id || '');
        }
        if (typeof refreshProductFormUnit === 'function') {
          refreshProductFormUnit(product.don_vi_tinh_id || '');
        }

        addProductModalOverlay.classList.add('is-visible');
        toggleFixedPrice();
        toggleInitialLotFields();
        updateHsdPreview();
      }

      function closeAddProductModal() {
        if (!addProductModalOverlay) return;
        addProductModalOverlay.classList.remove('is-visible');
      }

      if (productPriceType) productPriceType.addEventListener('change', toggleFixedPrice);
      if (productManageLotCheckbox) productManageLotCheckbox.addEventListener('change', toggleInitialLotFields);
      if (hsdMacDinhInput) hsdMacDinhInput.addEventListener('input', updateHsdPreview);
      if (openAddProductModalBtn) openAddProductModalBtn.addEventListener('click', openAddProductModal);
      if (addProductModalClose) addProductModalClose.addEventListener('click', closeAddProductModal);
      if (addProductModalCancel) addProductModalCancel.addEventListener('click', closeAddProductModal);
      if (addProductModalOverlay && addProductModalOverlay.getAttribute('data-auto-open') === '1') openAddProductModal();
      initProductVNInputs();
      if (productCreateForm) {
        productCreateForm.addEventListener('submit', function() {
          PRODUCT_VN_NUM_FIELDS.forEach(function(name) {
            var input = productCreateForm.querySelector('[name="' + name + '"]');
            if (!input) return;
            var parsed = parseProductNum(input.value);
            input.value = parsed === '' ? '0' : parsed;
          });
        });
      }
      toggleFixedPrice();
      toggleInitialLotFields();

      function openCopyProductModal(product) {
        if (!product) return;
        openAddProductModal();
        if (productModalTitle) productModalTitle.textContent = 'Sao chép hàng hóa';
        if (productModalSubmitBtn) productModalSubmitBtn.textContent = 'Lưu';
        setProductFormValue('ma_hang', '');
        setProductFormValue('ten_hang', (product.ten_hang || '') + ' (bản sao)');
        setProductFormValue('nha_cung_cap_id', product.nha_cung_cap_id || '');
        setProductFormValue('gia_von', Number(product.gia_von || 0));
        setProductFormValue('loai_gia', product.loai_gia || 'thi_truong');
        setProductFormValue('gia_co_dinh', Number(product.gia_co_dinh || 0));
        setProductFormValue('ton_ban_dau', 0);
        setProductFormValue('dinh_muc_toi_thieu', Number(product.dinh_muc_toi_thieu || 0));
        setProductFormValue('mo_ta', product.mo_ta || '');
        setProductFormValue('trang_thai', 'active');
        setProductCheckbox('ban_truc_tiep', !!product.ban_truc_tiep);
        setProductCheckbox('quan_ly_theo_lo', !!product.quan_ly_theo_lo);
        setProductFormValue(
          'han_su_dung_mac_dinh_so_ngay',
          product.han_su_dung_mac_dinh_so_ngay != null ? product.han_su_dung_mac_dinh_so_ngay : 5
        );
        if (typeof refreshProductFormGroup === 'function') {
          refreshProductFormGroup(product.nhom_hang_id || '');
        }
        if (typeof refreshProductFormUnit === 'function') {
          refreshProductFormUnit(product.don_vi_tinh_id || '');
        }
        toggleInitialLotFields();
        updateHsdPreview();
      }

      function printProductLabel(product) {
        if (!product) return;
        const win = window.open('', '_blank');
        if (!win) return alert('Trình duyệt chặn cửa sổ in.');
        const price = Number(product.gia_co_dinh || product.gia_ban || 0).toLocaleString('vi-VN');
        const labelHtml = '<html><head><title>In tem ' + (product.ma_hang || '') + '</title><style>body{font-family:Arial;padding:16px}.label{width:220px;border:1px solid #ccc;padding:12px;margin:8px;display:inline-block}.code{font-size:18px;font-weight:700}</style></head><body><div class="label"><div class="code">' + (product.ma_hang || '') + '</div><div>' + (product.ten_hang || '') + '</div><div>Gi\u00e1: ' + price + '</div></div></body></html>';
        win.document.write(labelHtml);
        win.document.close();
        win.focus();
        win.print();
      }

      if (customerTableWrap) {
        customerTableWrap.addEventListener('click', function(event) {
          var button = event.target.closest('.btn-edit-product, .btn-copy-product, .btn-print-label, .btn-trash-product');
          if (!button || !customerTableWrap.contains(button)) return;
          event.preventDefault();
          event.stopPropagation();
          if (button.classList.contains('btn-trash-product')) {
            openProductTrashModalForRows([{
              id: button.getAttribute('data-product-id') || '',
              code: button.getAttribute('data-product-code') || '',
              name: button.getAttribute('data-product-name') || ''
            }]);
            return;
          }
          var payload = button.getAttribute('data-product') || '{}';
          try {
            var product = JSON.parse(payload);
            if (button.classList.contains('btn-edit-product')) openEditProductModal(product);
            else if (button.classList.contains('btn-copy-product')) openCopyProductModal(product);
            else if (button.classList.contains('btn-print-label')) printProductLabel(product);
          } catch (_error) {
            alert('Không đọc được dữ liệu hàng hóa.');
          }
        });
      }

      function escapeProductTrashHtml(value) {
        return String(value == null ? '' : value).replace(/[&<>"']/g, function(ch) {
          return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[ch];
        });
      }

      function getSelectedProductTrashRows() {
        return productCheckboxes.filter(function(cb) { return cb.checked; }).map(function(cb) {
          var row = cb.closest('tr');
          var cells = row ? row.querySelectorAll('td') : [];
          return {
            id: cb.value,
            code: cells[1] ? cells[1].textContent.trim() : '',
            name: cells[2] ? cells[2].textContent.trim() : ''
          };
        });
      }

      function setProductTrashAlert(message, type) {
        if (!productTrashAlert) return;
        productTrashAlert.style.display = message ? '' : 'none';
        productTrashAlert.classList.toggle('is-error', type === 'error');
        productTrashAlert.classList.toggle('is-warn', type !== 'error');
        productTrashAlert.textContent = message || '';
      }

      function closeProductTrashModal() {
        if (!productTrashModalOverlay) return;
        productTrashModalOverlay.classList.remove('is-open');
        productTrashModalOverlay.setAttribute('aria-hidden', 'true');
        pendingProductTrashIds = [];
      }

      function renderProductTrashSelected(rows) {
        if (!productTrashSelectedList) return;
        productTrashSelectedList.innerHTML = rows.map(function(row) {
          var label = (row.code ? row.code + ' - ' : '') + (row.name || 'Hàng hóa');
          return '<li>' + escapeProductTrashHtml(label) + '</li>';
        }).join('');
      }

      function renderProductTrashPreview(payload) {
        var groups = (payload && payload.aggregate_groups) || [];
        if (productTrashLoading) productTrashLoading.style.display = 'none';
        if (productTrashImpactTable) productTrashImpactTable.style.display = '';
        if (productTrashImpactRows) {
          if (!groups.length) {
            productTrashImpactRows.innerHTML = '<tr><td colspan="3">Không có phiếu hoặc dữ liệu ràng buộc.</td></tr>';
          } else {
            productTrashImpactRows.innerHTML = groups.map(function(group) {
              var samples = (group.samples || []).map(escapeProductTrashHtml).join(', ');
              return '<tr>'
                + '<td>' + escapeProductTrashHtml(group.label || group.entity_type || 'Dữ liệu liên quan') + '</td>'
                + '<td class="num">' + Number(group.count || 0).toLocaleString('vi-VN') + '</td>'
                + '<td>' + (samples || '---') + '</td>'
                + '</tr>';
            }).join('');
          }
        }
        if (!payload || !payload.can_proceed) {
          var blocked = ((payload && payload.items) || []).filter(function(item) { return !item.can_trash; });
          setProductTrashAlert(blocked[0] && blocked[0].block_reason ? blocked[0].block_reason : 'Không thể chuyển các hàng hóa đã chọn vào thùng rác.', 'error');
          if (productTrashConfirm) productTrashConfirm.disabled = true;
          return;
        }
        var relatedCount = Number(payload.total_related || 0);
        setProductTrashAlert(
          relatedCount > 0
            ? 'Có ' + relatedCount.toLocaleString('vi-VN') + ' phiếu/dòng dữ liệu sẽ vào thùng rác cùng hàng hóa.'
            : 'Hàng hóa không có phiếu liên quan.',
          'warn'
        );
        if (productTrashConfirm) productTrashConfirm.disabled = false;
      }

      async function openProductTrashModalForRows(selectedRows) {
        selectedRows = (selectedRows || []).filter(function(row) { return row && row.id; });
        if (!selectedRows.length) {
          alert('Vui lòng chọn ít nhất một hàng hóa.');
          return;
        }
        pendingProductTrashIds = selectedRows.map(function(row) { return row.id; });
        if (productTrashModalOverlay) {
          productTrashModalOverlay.classList.add('is-open');
          productTrashModalOverlay.setAttribute('aria-hidden', 'false');
        }
        renderProductTrashSelected(selectedRows);
        setProductTrashAlert('', 'warn');
        if (productTrashLoading) productTrashLoading.style.display = '';
        if (productTrashImpactTable) productTrashImpactTable.style.display = 'none';
        if (productTrashImpactRows) productTrashImpactRows.innerHTML = '';
        if (productTrashConfirm) productTrashConfirm.disabled = true;

        try {
          var response = await fetch('/hang-hoa/trash/preview', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ ids: pendingProductTrashIds })
          });
          var payload = await response.json();
          if (!response.ok || !payload.success) {
            throw new Error(payload.message || 'Không thể kiểm tra dữ liệu liên quan.');
          }
          renderProductTrashPreview(payload.data);
        } catch (error) {
          if (productTrashLoading) productTrashLoading.style.display = 'none';
          if (productTrashImpactTable) productTrashImpactTable.style.display = 'none';
          setProductTrashAlert(error.message || 'Không thể kiểm tra dữ liệu liên quan.', 'error');
          if (productTrashConfirm) productTrashConfirm.disabled = true;
        }
      }

      async function openProductTrashModal() {
        return openProductTrashModalForRows(getSelectedProductTrashRows());
      }

      async function confirmProductTrashMove() {
        if (!pendingProductTrashIds.length || !productTrashConfirm) return;
        productTrashConfirm.disabled = true;
        productTrashConfirm.textContent = 'Đang chuyển...';
        try {
          var response = await fetch('/hang-hoa/trash/move', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ ids: pendingProductTrashIds })
          });
          var payload = await response.json();
          if (!response.ok || !payload.success) {
            throw new Error(payload.message || 'Không thể chuyển hàng hóa vào thùng rác.');
          }
          window.location.href = '/hang-hoa?success=deleted';
        } catch (error) {
          setProductTrashAlert(error.message || 'Không thể chuyển hàng hóa vào thùng rác.', 'error');
          productTrashConfirm.disabled = false;
          productTrashConfirm.textContent = 'Chuyển vào thùng rác';
        }
      }

