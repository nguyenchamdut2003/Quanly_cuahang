<% if (pagination) { %>
  <div class="product-pagination">
    <div>Hiển thị <strong><%= pagination.from %>-<%= pagination.to %></strong> / <strong><%= pagination.total %></strong> dòng</div>
    <% if (pagination.totalPages > 1) { %>
      <div class="product-pagination__actions">
        <a class="product-page-link <%= pagination.hasPrev ? '' : 'is-disabled' %>" href="<%= baseUrl %>?page=<%= Math.max(1, pagination.page - 1) %>" data-product-tab-page-url="<%= baseUrl %>?page=<%= Math.max(1, pagination.page - 1) %>">‹</a>
        <% for (var pageNumber = 1; pageNumber <= pagination.totalPages; pageNumber++) { %>
          <a class="product-page-link <%= pageNumber === pagination.page ? 'is-active' : '' %>" href="<%= baseUrl %>?page=<%= pageNumber %>" data-product-tab-page-url="<%= baseUrl %>?page=<%= pageNumber %>"><%= pageNumber %></a>
        <% } %>
        <a class="product-page-link <%= pagination.hasNext ? '' : 'is-disabled' %>" href="<%= baseUrl %>?page=<%= Math.min(pagination.totalPages, pagination.page + 1) %>" data-product-tab-page-url="<%= baseUrl %>?page=<%= Math.min(pagination.totalPages, pagination.page + 1) %>">›</a>
      </div>
    <% } %>
  </div>
<% } %>
