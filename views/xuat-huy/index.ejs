<%
  const safeTickets = Array.isArray(locals.tickets) ? locals.tickets : [];
  const safeWarehouses = Array.isArray(locals.warehouses) ? locals.warehouses : [];
  const safeUsers = Array.isArray(locals.users) ? locals.users : [];
  const safeFilters = locals.filters || {};
  const safePagination = locals.pagination || { page: 1, totalPages: 1, total: 0, from: 0, to: 0, limit: 10 };
  const pageHref = page => {
    const query = typeof qs === 'function' ? qs({ page }) : '';
    return '/xuat-huy' + (query ? '?' + query : '');
  };
  const selectedStatuses = Array.isArray(safeFilters.trang_thai) ? safeFilters.trang_thai : (safeFilters.trang_thai ? [safeFilters.trang_thai] : []);
  const fmt = value => Number(value || 0).toLocaleString('vi-VN');
  const fmtMoney = value => fmt(value) + ' VNĐ';
  const badgeClass = status => status === 'draft' ? 'draft' : (status === 'cancelled' ? 'cancelled' : '');
  const exportParams = new URLSearchParams();
  Object.keys(safeFilters).forEach(function(key) {
    if (key === 'page' || key === 'page_size') return;
    const value = safeFilters[key];
    if (Array.isArray(value)) {
      value.forEach(function(item) { exportParams.append(key, item); });
    } else if (value !== undefined && value !== null && value !== '') {
      exportParams.append(key, value);
    }
  });
  const exportQuery = exportParams.toString();
  function branchLabel(t) {
    if (t.cua_hang_id && (t.cua_hang_id.ten_cua_hang || t.cua_hang_id.ma_cua_hang)) {
      return t.cua_hang_id.ten_cua_hang || t.cua_hang_id.ma_cua_hang;
    }
    if (t.kho_id && (t.kho_id.ten_kho || t.kho_id.ma_kho)) return t.kho_id.ten_kho || t.kho_id.ma_kho;
    return 'Cửa hàng trung tâm';
  }
  function detailNote(t) {
    const parts = [];
    if (t.ly_do_huy) parts.push(String(t.ly_do_huy));
    if (t.ghi_chu) parts.push(String(t.ghi_chu));
    return parts.length ? parts.join('\n') : 'Chưa có';
  }
%>
<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Xuất hủy</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/stylesheets/style.css">
  <link rel="stylesheet" href="/stylesheets/responsive.css">
  <style>
    .xh-page{display:block;width:100%;min-width:0}
    .xh-shell{min-height:calc(100vh - 58px)}
    .xh-content{min-width:0;padding:14px 16px 18px}
    .filter-block{display:grid;gap:8px;padding-bottom:16px;border-bottom:1px solid #f1f5f9;margin:0 0 16px}.filter-block:last-of-type{border-bottom:0}.filter-title{font-size:13px;font-weight:700;color:#475569;margin:0}
    .check-line{display:flex;align-items:center;gap:8px;min-height:30px;font-size:13px;font-weight:600;color:#334155}.check-line input,.radio-line input{width:16px!important;height:16px!important;padding:0!important;accent-color:#0070f4;flex:0 0 auto}
    .radio-line{display:flex;align-items:center;gap:9px;min-height:32px;font-size:13px;font-weight:600;color:#334155}.radio-pill{flex:1;display:flex;align-items:center;justify-content:space-between;gap:8px}
    .filter-control{margin-top:2px}
    .main{min-width:0}.toolbar{display:flex;align-items:center;justify-content:space-between;gap:12px}
    .search{flex:1;max-width:470px}.search input{width:100%;height:31px;border:1px solid #cfd8e3;border-radius:7px;padding:0 12px;font-size:13px;outline:none}
    .actions{display:flex;align-items:center;gap:8px}.xh-page .kv-btn,.xh-page .btn{height:36px;border-radius:5px;padding:0 14px;font-size:14px;font-weight:700;display:inline-flex;align-items:center;gap:7px;cursor:pointer;text-decoration:none}.xh-page .kv-btn.primary,.xh-page .btn.primary{border-color:#0070f4;color:#0070f4}
    .actions .order-delete-btn{display:inline-flex!important;background:#d92d20!important;color:#fff!important;border-color:#d92d20!important;visibility:visible!important;opacity:1!important}
    .actions .order-delete-btn:hover{background:#b42318!important;border-color:#b42318!important}
    .row-check{width:16px;height:16px;accent-color:#0070f4;cursor:pointer}
    .table-wrap{flex:1;min-height:0;background:#fff;border-radius:10px;overflow-x:auto;min-width:0}
    .xh-table{width:100%;table-layout:fixed;border-collapse:collapse;min-width:980px}
    .xh-table th{min-height:37px;background:#f1f6fb;color:#334155;font-size:12px;font-weight:800;text-align:left;border-bottom:1px solid #dbe4ef;padding:6px 10px;white-space:normal;word-break:break-word;line-height:1.25}
    .xh-table td{min-height:43px;border-bottom:1px solid #edf2f7;padding:7px 10px;font-size:13px;line-height:1.35;color:#111827}
    .xh-table tbody tr:hover td{background:#f9fbfe}.num{text-align:right}.check-col{width:36px;text-align:center}
    .code-col{width:150px}.time-col{width:160px}.money-col{width:125px}.qty-col{width:110px}.status-col{width:115px}.reason-col{width:140px}.ellipsis{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .status-badge{display:inline-flex;align-items:center;height:22px;border-radius:4px;background:#dff7e9;color:#008a3d;padding:0 7px;font-size:12px;font-weight:800}.status-badge.draft{background:#fff4d6;color:#9a6700}.status-badge.cancelled{background:#eef2f7;color:#667085}
    .xh-row{cursor:pointer}.xh-row.is-open td{background:#f8fafc}
    .detail-row td{height:auto;padding:0;background:#fff;border-bottom:1px solid #e2e8f0;word-break:break-word;vertical-align:top;width:100%;box-sizing:border-box}
    .detail-card{border:0;border-top:1px solid #e2e8f0;padding:10px 12px 12px;background:#fff;box-sizing:border-box;width:100%;max-width:100%;min-width:0}
    .xh-detail-split{display:flex;flex-wrap:wrap;align-items:flex-start;gap:30px;margin-top:12px;width:100%;min-width:0;box-sizing:border-box}
    .xh-detail-main{flex:1 1 0%;min-width:0}
    .xh-summary-box{flex:0 0 240px;width:240px;max-width:100%;box-sizing:border-box;border:1px solid #e2e8f0;border-radius:8px;padding:10px 12px;background:#fafcff;align-self:flex-start;min-width:min(240px,100%)}
    .xh-summary-title{font-size:12px;font-weight:800;color:#111827;margin:0 0 8px;padding-bottom:6px;border-bottom:1px solid #e2e8f0}
    .xh-summary-row{display:flex;justify-content:space-between;align-items:baseline;gap:8px;font-size:12px;line-height:1.3;margin:8px 0;color:#374151}
    .xh-summary-row .summary-val{text-align:right;font-weight:700;color:#111827;white-space:nowrap;font-variant-numeric:tabular-nums}
    .detail-tabs{height:28px;display:flex;align-items:center;border-bottom:1px solid #dbe4ee;margin:-2px -12px 10px;padding:0 12px}
    .detail-tab{font-size:12px;font-weight:800;color:#0070f4}
    .detail-head{display:flex;justify-content:space-between;gap:12px;margin-bottom:10px;flex-wrap:wrap;min-width:0}
    .detail-code{font-size:16px;font-weight:800;color:#111827;display:flex;align-items:center;flex-wrap:wrap;gap:8px;min-width:0;word-break:break-word;line-height:1.3}
    .detail-status{height:22px;border-radius:4px;background:#dff7e9;color:#008a3d;padding:0 8px;display:inline-flex;align-items:center;font-size:12px;font-weight:800}
    .detail-status.draft{background:#fff4d6;color:#9a6700}
    .detail-status.cancelled{background:#eef2f7;color:#667085}
    .detail-branch{font-size:12px;color:#111827;margin-top:2px;word-break:break-word;min-width:0;text-align:right}
    .detail-info{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,180px),1fr));gap:10px 14px;margin-bottom:10px;min-width:0}
    .info-line{display:grid;grid-template-columns:108px minmax(0,1fr);align-items:start;gap:6px;font-size:11px;margin:6px 0;color:#111827;min-width:0;line-height:1.35}
    .info-line input,.info-line select{height:26px;border:1px solid #cfd8e3;border-radius:5px;padding:0 6px;font-size:11px;background:#fff;width:100%;min-width:0;max-width:100%;box-sizing:border-box}
    .info-line .info-value{display:block;min-width:0;word-break:break-word;font-weight:600;line-height:1.35;padding:5px 7px;border:1px solid #cfd8e3;border-radius:5px;background:#fff;box-sizing:border-box;font-size:11px}
    .mini-table-wrap{min-width:0;width:100%;max-width:100%;margin-top:6px}
    .mini-table{width:100%;table-layout:fixed;border-collapse:collapse;min-width:680px}
    .mini-table thead th:nth-child(1),.mini-table tbody td:nth-child(1){width:14%}
    .mini-table thead th:nth-child(2),.mini-table tbody td:nth-child(2){width:28%}
    .mini-table thead th:nth-child(3),.mini-table tbody td:nth-child(3){width:16%}
    .mini-table thead th:nth-child(4),.mini-table tbody td:nth-child(4){width:12%}
    .mini-table thead th:nth-child(5),.mini-table tbody td:nth-child(5){width:14%}
    .mini-table thead th:nth-child(6),.mini-table tbody td:nth-child(6){width:16%}
    .mini-table th{font-size:11px;font-weight:700;background:#f0f2f4;border-bottom:1px solid #cfd8e3;white-space:nowrap;word-break:normal;line-height:1.2;padding:8px 8px}
    .mini-table td{font-size:11px;padding:8px 8px;line-height:1.35;vertical-align:top;word-break:normal;border-bottom:1px solid #eef2f6}
    .mini-table td.num{font-size:11px;white-space:nowrap;text-align:right;font-variant-numeric:tabular-nums;word-break:normal}
    .mini-table td.cell-code{color:#0070f4;font-size:11px;font-weight:600}
    .mini-table td.cell-code a{color:inherit;text-decoration:none}
    .mini-table td.cell-code a:hover{text-decoration:underline}
    .mini-table td.cell-ten{font-size:13px;line-height:1.35;color:#111827}
    .mini-wrap-meta{font-size:10px;color:#667085;margin-top:2px;line-height:1.25;word-break:break-word}
    .detail-note{min-height:56px;border:1px solid #cfd8e3;border-radius:6px;padding:8px;font-size:11px;line-height:1.4;color:#667085;margin-top:10px;background:#fff;white-space:pre-wrap;word-break:break-word}
    .empty{height:420px;text-align:center}.empty-box{height:100%;display:flex;align-items:center;justify-content:center;flex-direction:column;color:#667085}
    .empty-icon{width:78px;height:78px;border-radius:50%;background:#eff6ff;display:grid;place-items:center;color:#0070f4;font-size:34px;margin-bottom:12px}
    .empty-title{font-size:14px;font-weight:800;color:#111827;margin-bottom:6px}
    .footer{min-height:38px;font-size:12px;display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;color:#475569}
    .xh-page-size{font-weight:700}
    .xh-pagination{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
    .xh-page-link{min-width:46px;height:28px;padding:0 10px;border:1px solid #cbd5e1;border-radius:6px;background:#fff;color:#111827;text-decoration:none;display:inline-flex;align-items:center;justify-content:center;font-weight:700}
    .xh-page-link.is-disabled{color:#94a3b8;background:#f8fafc;cursor:not-allowed}
    .xh-page-current{font-weight:800;color:#111827}
    .invoice-trash-overlay{display:none;position:fixed;inset:0;background:rgba(15,23,42,.45);z-index:1450;align-items:center;justify-content:center;padding:16px}
    .invoice-trash-overlay.is-open{display:flex}
    .invoice-trash-modal{width:min(420px,calc(100vw - 24px));max-height:calc(100vh - 32px);background:#fff;border-radius:12px;box-shadow:0 20px 60px rgba(15,23,42,.28);display:flex;flex-direction:column;overflow:hidden}
    .invoice-trash-head{display:flex;align-items:center;justify-content:space-between;padding:18px 22px 12px;border-bottom:1px solid #e5e9ee}
    .invoice-trash-head h3{margin:0;font-size:18px;font-weight:800;color:#111827}
    .invoice-trash-close{border:0;background:transparent;color:#667085;font-size:26px;line-height:1;cursor:pointer}
    .invoice-trash-body{padding:14px 22px 18px;overflow:auto}
    .invoice-trash-desc{margin:0 0 12px;font-size:13px;line-height:1.5;color:#475467}
    .invoice-trash-foot{display:flex!important;align-items:center;justify-content:flex-end;gap:8px;padding:12px 22px 18px;border-top:1px solid #e5e9ee;flex:0 0 auto;background:#fff}
    .invoice-trash-foot .btn{display:inline-flex!important;align-items:center;justify-content:center;min-width:74px;visibility:visible!important;opacity:1!important}
    .invoice-trash-foot .btn.danger{background:#d92d20;color:#fff;border-color:#d92d20}
    @media(max-width:1100px){.xh-shell{padding:12px 30px;grid-template-columns:220px minmax(0,1fr)}}
    @media(max-width:1024px){.xh-detail-split{flex-direction:column;align-items:stretch;gap:20px}.xh-summary-box{flex:none;width:100%;max-width:100%;min-width:0}}

    /* Mobile — Xuất hủy (desktop giữ nguyên) */
    @media (max-width: 900px) {
      .xh-page {
        height: auto;
        min-height: calc(100vh - 98px);
        overflow: visible;
      }
      .xh-shell {
        display: flex !important;
        flex-direction: column !important;
        grid-template-columns: none !important;
        padding: 8px 10px 16px !important;
        gap: 10px !important;
        flex: none;
        min-height: 0;
      }
      .sidebar {
        width: 100%;
        max-height: none;
        overflow: visible;
        border-radius: 8px;
        border: 1px solid #e2e8f0;
        padding: 12px;
      }
      .title {
        font-size: 18px;
        margin-bottom: 12px;
      }
      .filter-block {
        margin-bottom: 14px;
      }
      .filter-control {
        min-height: 38px;
        height: auto;
      }
      .check-line,
      .radio-line {
        min-height: 36px;
      }
      .main {
        width: 100%;
        min-width: 0;
        flex: none;
      }
      .toolbar {
        flex-direction: column;
        align-items: stretch;
        gap: 10px;
      }
      .search {
        max-width: none;
        width: 100%;
      }
      .search input {
        min-height: 38px;
        height: auto;
      }
      .actions {
        width: 100%;
        flex-wrap: wrap;
        gap: 8px;
      }
      .actions .kv-btn {
        flex: 1 1 calc(50% - 4px);
        min-width: 0;
        justify-content: center;
        min-height: 38px;
        height: auto;
        padding: 8px 10px;
      }
      .table-wrap {
        flex: none;
        min-height: 220px;
        max-height: none;
        overflow-x: auto;
        overflow-y: visible;
        -webkit-overflow-scrolling: touch;
      }
      .table-wrap > table {
        min-width: 920px;
        table-layout: auto;
      }
      .footer {
        height: auto;
        min-height: 36px;
        flex-wrap: wrap;
        padding: 4px 0;
      }
      .footer select {
        flex: 1;
        min-width: 0;
        max-width: 140px;
        min-height: 34px;
      }
      .detail-card {
        padding: 10px;
      }
      .detail-head {
        flex-direction: column;
        align-items: stretch;
      }
      .detail-branch {
        text-align: left;
      }
      .info-line {
        grid-template-columns: 1fr;
        gap: 4px;
      }
      .mini-table-wrap {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
      }
      .mini-table {
        min-width: 680px;
      }
      .detail-note {
        min-height: 48px;
      }
    }
    @media (max-width: 520px) {
      .actions .kv-btn {
        flex: 1 1 100%;
      }
      .xh-shell {
        padding: 8px !important;
      }
    }
    .xh-page.admin-shell{max-width:none;padding:0}
    .xh-shell.customer-shell{gap:0;padding:0!important}
    .customer-filter.sidebar{border-radius:0;overflow:visible}
    .xh-content.main{display:block}
    .customer-search.search input{height:auto;border:0;border-radius:0;padding:0;font-size:14px}
    .xh-footer{min-height:42px;margin-top:10px;padding:0 4px;font-size:13px}
    .xh-page-link{min-width:34px;height:34px;border-color:#d0d5dd;color:#344054}
    @media(max-width:900px){
      .xh-shell.customer-shell{display:grid!important;grid-template-columns:1fr!important;gap:0!important;padding:0!important}
      .customer-toolbar.toolbar{align-items:stretch;flex-direction:column}
      .customer-search.search{width:100%;max-width:none}
      .customer-toolbar-actions.actions{width:100%;flex-wrap:wrap}
      .customer-toolbar-actions.actions .btn{flex:1 1 calc(50% - 4px);justify-content:center}
      .xh-footer{align-items:flex-start;flex-direction:column}
    }
    @media(max-width:520px){
      .customer-toolbar-actions.actions .btn{flex-basis:100%}
    }
  </style>
</head>
<body class="admin-body">
  <%- include('../partials/header', { activeMenu: activeMenu, user: user }) %>
  <form method="GET" action="/xuat-huy" class="admin-shell customer-page xh-page" id="xhFilterForm">
    <input type="hidden" name="page" id="xhPageInput" value="<%= safePagination.page %>">
    <div class="customer-shell xh-shell">
      <aside class="customer-filter sidebar">
        <h2 class="title">Xuất hủy</h2>
        <section class="customer-filter-section filter-block">
          <div class="filter-title">Trạng thái</div>
          <label class="check-line"><input type="checkbox" name="trang_thai" value="draft" <%= !selectedStatuses.length || selectedStatuses.includes('draft') ? 'checked' : '' %> onchange="submitXhFilters()"> Phiếu tạm</label>
          <label class="check-line"><input type="checkbox" name="trang_thai" value="completed" <%= !selectedStatuses.length || selectedStatuses.includes('completed') ? 'checked' : '' %> onchange="submitXhFilters()"> Đã hủy hàng</label>
          <label class="check-line"><input type="checkbox" name="trang_thai" value="cancelled" <%= selectedStatuses.includes('cancelled') ? 'checked' : '' %> onchange="submitXhFilters()"> Đã hủy phiếu</label>
        </section>
        <section class="customer-filter-section filter-block">
          <div class="filter-title">Thời gian</div>
          <label class="radio-line"><input type="radio" name="time_type" value="this_month" <%= safeFilters.time_type === 'this_month' ? 'checked' : '' %> onchange="submitXhFilters()"><span class="radio-pill">Tháng này <span>›</span></span></label>
          <label class="radio-line"><input type="radio" name="time_type" value="custom" <%= safeFilters.time_type === 'custom' ? 'checked' : '' %> onchange="submitXhFilters()"><span class="radio-pill">Tùy chỉnh <span>›</span></span></label>
          <input class="filter-control" type="date" name="date_from" value="<%= safeFilters.date_from || '' %>" onchange="submitXhFilters()">
          <input class="filter-control" type="date" name="date_to" value="<%= safeFilters.date_to || '' %>" onchange="submitXhFilters()">
        </section>
        <section class="customer-filter-section filter-block">
          <div class="filter-title">Kho</div>
          <select class="filter-control" name="kho_id" onchange="submitXhFilters()">
            <option value="">Chọn kho</option>
            <% safeWarehouses.forEach(function(k) { %>
              <option value="<%= k._id %>" <%= String(safeFilters.kho_id || '') === String(k._id) ? 'selected' : '' %>><%= k.ten_kho || k.ma_kho %></option>
            <% }) %>
          </select>
        </section>
        <section class="customer-filter-section filter-block">
          <div class="filter-title">Người tạo</div>
          <select class="filter-control" name="nguoi_tao" onchange="submitXhFilters()">
            <option value="">Chọn người tạo</option>
            <% safeUsers.forEach(function(u) { %>
              <option value="<%= u._id %>" <%= String(safeFilters.nguoi_tao || '') === String(u._id) ? 'selected' : '' %>><%= u.ho_ten || u.email %></option>
            <% }) %>
          </select>
        </section>
      </aside>
      <main class="customer-content xh-content main">
        <div class="customer-toolbar toolbar">
          <div class="customer-search search"><span>⌕</span><input name="q" value="<%= safeFilters.q || '' %>" placeholder="Theo mã xuất hủy"></div>
          <div class="customer-toolbar-actions actions">
            <a class="btn btn-primary xh-create-btn" href="/xuat-huy/create">+ Xuất hủy</a>
            <a class="btn btn-light" href="/xuat-huy/export.xlsx<%= exportQuery ? '?' + exportQuery : '' %>">Xuất file ▾</a>
            <button type="button" class="btn btn-danger order-delete-btn" id="xhDeleteSelectedBtn"><i class="fa-regular fa-trash-can"></i> Xóa</button>
          </div>
        </div>
        <div class="customer-table-wrap table-wrap">
          <table class="admin-table customer-table xh-table">
            <thead>
              <tr>
                <th class="check-col"><input class="row-check" type="checkbox" id="selectAllXhTickets"></th>
                <th class="code-col">Mã xuất hủy</th>
                <th class="time-col">Thời gian</th>
                <th>Kho</th>
                <th class="num qty-col">Tổng số lượng</th>
                <th class="num money-col">Tổng giá trị</th>
                <th class="reason-col">Lý do hủy</th>
                <th class="status-col">Trạng thái</th>
              </tr>
            </thead>
            <tbody>
              <% if (safeTickets.length) { %>
                <% safeTickets.forEach(function(t) { %>
                  <tr class="xh-row" data-detail-id="<%= t._id %>">
                    <td class="check-col"><input class="row-check xh-ticket-check" type="checkbox" value="<%= t._id %>"></td>
                    <td class="ellipsis"><%= t.ma_xuat_huy || '' %></td>
                    <td><%= formatDate(t.ngay_xuat || t.created_at) %></td>
                    <td class="ellipsis"><%= t.kho_id ? (t.kho_id.ten_kho || t.kho_id.ma_kho || '--') : '--' %></td>
                    <td class="num"><%= fmt(t.tong_so_luong || 0) %></td>
                    <td class="num"><%= fmtMoney(t.tong_gia_tri || 0) %></td>
                    <td class="ellipsis"><%= t.ly_do_huy || '--' %></td>
                    <td><span class="status-badge <%= badgeClass(t.trang_thai) %>"><%= statusLabel(t.trang_thai) %></span></td>
                  </tr>
                  <tr class="detail-row" id="detail-<%= t._id %>" style="display:none">
                    <td colspan="8">
                      <div class="detail-card">
                        <div class="detail-tabs"><span class="detail-tab">Thông tin</span></div>
                        <div class="detail-head">
                          <div>
                            <div class="detail-code">
                              <%= t.ma_xuat_huy || '--' %>
                              <span class="detail-status <%= badgeClass(t.trang_thai) %>"><%= statusLabel(t.trang_thai) %></span>
                            </div>
                          </div>
                          <div class="detail-branch"><%= branchLabel(t) %></div>
                        </div>
                        <div class="xh-detail-split">
                          <div class="xh-detail-main">
                            <div class="detail-info">
                              <div>
                                <div class="info-line"><span>Người tạo:</span><span class="info-value"><%= t.nguoi_tao_id ? (t.nguoi_tao_id.ho_ten || t.nguoi_tao_id.email || '--') : '--' %></span></div>
                              </div>
                              <div>
                                <div class="info-line"><span>Người xuất hủy:</span><select disabled><option><%= t.nguoi_tao_id ? (t.nguoi_tao_id.ho_ten || t.nguoi_tao_id.email || '--') : '--' %></option></select></div>
                              </div>
                              <div>
                                <div class="info-line"><span>Ngày xuất hủy:</span><input readonly value="<%= formatDate(t.ngay_xuat || t.created_at) %>"></div>
                              </div>
                            </div>
                            <div class="mini-table-wrap">
                              <table class="mini-table">
                                <thead>
                                  <tr>
                                    <th scope="col">Mã hàng</th>
                                    <th scope="col">Tên hàng</th>
                                    <th scope="col">Thuộc tính</th>
                                    <th scope="col" class="num">SL hủy</th>
                                    <th scope="col" class="num">Giá vốn</th>
                                    <th scope="col" class="num">Giá trị hủy</th>
                                  </tr>
                                </thead>
                                <tbody>
                                  <% if (!(t.detail_rows || []).length) { %>
                                    <tr><td colspan="6">Chưa có chi tiết hàng hủy.</td></tr>
                                  <% } %>
                                  <% (t.detail_rows || []).forEach(function(item) { %>
                                    <% const hh = item.hang_hoa_id; const hhId = hh && hh._id ? String(hh._id) : ''; const lineVal = Number(item.thanh_tien || (Number(item.so_luong || 0) * Number(item.gia_von || 0))); %>
                                    <tr>
                                      <td class="cell-code">
                                        <% if (hhId) { %>
                                          <a href="/hang-hoa#p-<%= hhId %>"><%= hh.ma_hang || '--' %></a>
                                        <% } else { %>--<% } %>
                                      </td>
                                      <td class="cell-ten">
                                        <%= hh ? (hh.ten_hang || '--') : '--' %>
                                        <% if (item.lo_hang_id) { %>
                                          <div class="mini-wrap-meta">Lô: <%= item.lo_hang_id.ten_lo || item.lo_hang_id.ma_lo || '--' %></div>
                                        <% } %>
                                      </td>
                                      <td><%= item.ten_quy_cach || 'Không có' %></td>
                                      <td class="num"><%= fmt(item.so_luong || 0) %></td>
                                      <td class="num"><%= fmtMoney(item.gia_von || 0) %></td>
                                      <td class="num"><%= fmtMoney(lineVal) %></td>
                                    </tr>
                                  <% }) %>
                                </tbody>
                              </table>
                            </div>
                            <div class="detail-note"><%= detailNote(t) %></div>
                          </div>
                          <aside class="xh-summary-box" aria-label="Tổng kết">
                            <h3 class="xh-summary-title">Tổng kết</h3>
                            <div class="xh-summary-row">
                              <span>Tổng số lượng hủy</span>
                              <span class="summary-val"><%= fmt(t.detail_summary ? t.detail_summary.tong_so_luong : (t.tong_so_luong || 0)) %></span>
                            </div>
                            <div class="xh-summary-row">
                              <span>Tổng giá trị hủy</span>
                              <span class="summary-val"><%= fmtMoney(t.detail_summary ? t.detail_summary.tong_gia_tri : (t.tong_gia_tri || 0)) %></span>
                            </div>
                          </aside>
                        </div>
                        <div class="page-actions page-actions--bordered">
                          <div class="page-actions__left">
                            <button type="button" class="btn btn-light btn-cancel-outline js-xh-cancel" data-id="<%= t._id %>" data-code="<%= t.ma_xuat_huy || '' %>">Hủy</button>
                            <a class="btn btn-light btn-copy-outline" href="/xuat-huy/create?copy_from=<%= t._id %>">Sao chép</a>
                            <a class="btn btn-primary" href="/xuat-huy/<%= t._id %>/export.xlsx">Xuất file</a>
                            <a class="btn btn-light" href="/chung-tu-kho/xuat-huy/<%= t._id %>" target="_blank" rel="noopener">Chứng từ</a>
                          </div>
                        </div>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="9" class="empty">
                    <div class="empty-box">
                      <div class="empty-icon">▤</div>
                      <div class="empty-title">Không tìm thấy kết quả</div>
                      <div>Không tìm thấy giao dịch nào phù hợp trong tháng này.</div>
                    </div>
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
        <div class="footer xh-footer">
          <span class="xh-page-size">Hiển thị 10 dòng/trang</span>
          <nav class="xh-pagination" aria-label="Phân trang xuất hủy">
            <% if (safePagination.page > 1) { %>
              <a class="xh-page-link" href="<%= pageHref(1) %>">Đầu</a>
              <a class="xh-page-link" href="<%= pageHref(safePagination.page - 1) %>">Trước</a>
            <% } else { %>
              <span class="xh-page-link is-disabled">Đầu</span>
              <span class="xh-page-link is-disabled">Trước</span>
            <% } %>
            <span class="xh-page-current"><%= safePagination.page %> / <%= safePagination.totalPages %></span>
            <% if (safePagination.page < safePagination.totalPages) { %>
              <a class="xh-page-link" href="<%= pageHref(safePagination.page + 1) %>">Sau</a>
              <a class="xh-page-link" href="<%= pageHref(safePagination.totalPages) %>">Cuối</a>
            <% } else { %>
              <span class="xh-page-link is-disabled">Sau</span>
              <span class="xh-page-link is-disabled">Cuối</span>
            <% } %>
          </nav>
          <span><%= safePagination.from %> - <%= safePagination.to %> trong <%= safePagination.total %> phiếu</span>
        </div>
      </main>
    </div>
  </form>
  <div id="xhTrashModalOverlay" class="invoice-trash-overlay" aria-hidden="true">
    <div class="invoice-trash-modal" role="dialog" aria-labelledby="xhTrashModalTitle" aria-modal="true">
      <div class="invoice-trash-head">
        <h3 id="xhTrashModalTitle">Xóa phiếu xuất hủy</h3>
        <button type="button" class="invoice-trash-close" id="xhTrashModalClose" aria-label="Đóng">×</button>
      </div>
      <div class="invoice-trash-body" id="xhTrashModalBody">
        <p class="invoice-trash-desc" id="xhTrashModalDesc">Bạn có chắc chắn muốn xóa các phiếu xuất hủy đã chọn không?</p>
      </div>
      <div class="invoice-trash-foot">
        <button type="button" class="btn" id="xhTrashCancelBtn">Không</button>
        <button type="button" class="btn danger" id="xhTrashConfirmBtn">Có</button>
      </div>
    </div>
  </div>
  <script>
    function submitXhFilters() {
      var pageInput = document.getElementById('xhPageInput');
      if (pageInput) pageInput.value = '1';
      document.getElementById('xhFilterForm').submit();
    }
    var xhFilterForm = document.getElementById('xhFilterForm');
    if (xhFilterForm) {
      xhFilterForm.addEventListener('submit', function() {
        var pageInput = document.getElementById('xhPageInput');
        if (pageInput) pageInput.value = '1';
      });
    }
    document.addEventListener('DOMContentLoaded', function() {
      function expandXhDetail(id, scroll) {
        var row = document.querySelector('.xh-row[data-detail-id="' + id + '"]');
        var detail = document.getElementById('detail-' + id);
        if (!row || !detail) return;
        document.querySelectorAll('.detail-row').forEach(function(x) { x.style.display = 'none'; });
        document.querySelectorAll('.xh-row').forEach(function(x) { x.classList.remove('is-open'); });
        detail.style.display = 'table-row';
        row.classList.add('is-open');
        if (scroll) row.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
      }

      document.querySelectorAll('.xh-row').forEach(function(row) {
        row.addEventListener('click', function(e) {
          if (e.target && e.target.closest('input,button,a,select')) return;
          var id = row.getAttribute('data-detail-id');
          var detail = document.getElementById('detail-' + id);
          if (!detail) return;
          var isOpen = detail.style.display !== 'none';
          document.querySelectorAll('.detail-row').forEach(function(x) { x.style.display = 'none'; });
          document.querySelectorAll('.xh-row').forEach(function(x) { x.classList.remove('is-open'); });
          if (!isOpen) {
            detail.style.display = 'table-row';
            row.classList.add('is-open');
          }
        });
      });

      var params = new URLSearchParams(window.location.search);
      var openId = params.get('open');
      if (openId) {
        expandXhDetail(openId, true);
        params.delete('open');
        var qs = params.toString();
        var path = window.location.pathname + (qs ? '?' + qs : '') + window.location.hash;
        try { window.history.replaceState({}, '', path); } catch (err) {}
      }

      var selectAll = document.getElementById('selectAllXhTickets');
      var ticketChecks = Array.prototype.slice.call(document.querySelectorAll('.xh-ticket-check'));
      var deleteBtn = document.getElementById('xhDeleteSelectedBtn');
      var trashOverlay = document.getElementById('xhTrashModalOverlay');
      var trashDesc = document.getElementById('xhTrashModalDesc');
      var trashClose = document.getElementById('xhTrashModalClose');
      var trashCancel = document.getElementById('xhTrashCancelBtn');
      var trashConfirm = document.getElementById('xhTrashConfirmBtn');
      var pendingTrashIds = [];

      function selectedTicketIds() {
        return ticketChecks.filter(function(cb) { return cb.checked; }).map(function(cb) { return cb.value; }).filter(Boolean);
      }

      function syncSelectAll() {
        if (!selectAll) return;
        var checkedCount = selectedTicketIds().length;
        selectAll.checked = ticketChecks.length > 0 && checkedCount === ticketChecks.length;
        selectAll.indeterminate = checkedCount > 0 && checkedCount < ticketChecks.length;
      }

      function openTrashModal(ids, message) {
        pendingTrashIds = ids || [];
        if (trashDesc) trashDesc.textContent = message || 'Bạn có chắc chắn muốn xóa các phiếu xuất hủy đã chọn không?';
        if (trashConfirm) {
          trashConfirm.disabled = false;
          trashConfirm.textContent = 'Có';
        }
        if (trashOverlay) {
          trashOverlay.classList.add('is-open');
          trashOverlay.setAttribute('aria-hidden', 'false');
        }
      }

      function closeTrashModal() {
        pendingTrashIds = [];
        if (trashOverlay) {
          trashOverlay.classList.remove('is-open');
          trashOverlay.setAttribute('aria-hidden', 'true');
        }
      }

      if (selectAll) {
        selectAll.addEventListener('change', function() {
          ticketChecks.forEach(function(cb) { cb.checked = selectAll.checked; });
          syncSelectAll();
        });
      }
      ticketChecks.forEach(function(cb) {
        cb.addEventListener('click', function(e) { e.stopPropagation(); });
        cb.addEventListener('change', syncSelectAll);
      });
      syncSelectAll();

      if (deleteBtn) {
        deleteBtn.addEventListener('click', function() {
          var ids = selectedTicketIds();
          if (!ids.length) {
            alert('Vui lòng chọn ít nhất một phiếu xuất hủy.');
            return;
          }
          openTrashModal(ids, 'Bạn có chắc chắn muốn xóa các phiếu xuất hủy đã chọn không?');
        });
      }

      document.body.addEventListener('click', function(e) {
        var cancelBtn = e.target.closest('.js-xh-cancel');
        if (!cancelBtn) return;
        var cid = cancelBtn.getAttribute('data-id');
        var code = cancelBtn.getAttribute('data-code') || '';
        if (!cid) return;
        openTrashModal([cid], 'Bạn có chắc chắn muốn hủy phiếu ' + (code || 'xuất hủy này') + ' không?');
      });

      if (trashClose) trashClose.addEventListener('click', closeTrashModal);
      if (trashCancel) trashCancel.addEventListener('click', closeTrashModal);
      if (trashOverlay) {
        trashOverlay.addEventListener('click', function(e) {
          if (e.target === trashOverlay) closeTrashModal();
        });
      }
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') closeTrashModal();
      });
      if (trashConfirm) {
        trashConfirm.addEventListener('click', function() {
          if (!pendingTrashIds.length) return;
          trashConfirm.disabled = true;
          trashConfirm.textContent = 'Đang xóa...';
          fetch('/xuat-huy/deactivate', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            credentials: 'same-origin',
            body: JSON.stringify({ ids: pendingTrashIds })
          })
            .then(function(res) {
              return res.json().then(function(data) {
                return { ok: res.ok, data: data };
              });
            })
            .then(function(result) {
              if (!result.ok || !result.data.success) {
                alert((result.data && result.data.message) || 'Không xóa được phiếu xuất hủy.');
                trashConfirm.disabled = false;
                trashConfirm.textContent = 'Có';
                return;
              }
              location.reload();
            })
            .catch(function() {
              alert('Không kết nối được máy chủ');
              trashConfirm.disabled = false;
              trashConfirm.textContent = 'Có';
            });
        });
      }
    });
  </script>
</body>
</html>
