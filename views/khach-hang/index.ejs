<!doctype html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <link rel="stylesheet" href="/stylesheets/style.css">
  <link rel="stylesheet" href="/stylesheets/responsive.css">
  <style>
    .customer-address-toolbar{display:flex;justify-content:flex-end;gap:8px;margin:0 0 10px}
    .customer-import-wrap{position:relative;display:inline-flex}
    .customer-import-menu{position:absolute;top:calc(100% + 6px);right:0;min-width:180px;display:none;z-index:20;border:1px solid #d0d5dd;border-radius:8px;background:#fff;box-shadow:0 14px 30px rgba(16,24,40,.15);overflow:hidden}
    .customer-import-menu.is-open{display:block}
    .customer-import-menu button,.customer-import-menu a{display:block;width:100%;border:0;background:#fff;text-align:left;padding:10px 14px;font-size:13px;color:#111827;text-decoration:none;cursor:pointer}
    .customer-import-menu button:hover,.customer-import-menu a:hover{background:#f8fafc}
    .customer-import-menu a + button{border-top:1px solid #f2f4f7}
    .customer-address-table{table-layout:fixed}
    .customer-address-table th:nth-child(1),
    .customer-address-table td:nth-child(1){width:78px;max-width:78px}
    .customer-address-table th:nth-child(3),
    .customer-address-table td:nth-child(3){width:104px;max-width:104px}
    .customer-address-table td:nth-child(3) > input{letter-spacing:0;padding:0 8px}
    .customer-address-table th:nth-child(6),
    .customer-address-table td:nth-child(6){width:118px;max-width:118px;white-space:nowrap;font-size:12px;padding-left:8px;padding-right:8px}
    .address-type-list{display:grid;gap:8px;max-height:280px;overflow:auto}
    .address-type-row{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:8px;align-items:center;border:1px solid #e2e8f0;border-radius:6px;padding:8px}
    .address-type-row.is-default{background:#f8fafc}
    .address-type-name{font-weight:700;color:#0f172a}
    .address-type-code{font-size:12px;color:#64748b;margin-top:2px}
    .address-type-actions{display:flex;gap:6px}
    .address-type-badge{display:inline-flex;align-items:center;height:24px;border-radius:999px;background:#eaf2ff;color:#0058d4;font-size:11px;font-weight:800;padding:0 8px}
    #addressTypeModalOverlay .group-modal{width:min(760px,calc(100vw - 96px));max-width:calc(100vw - 96px)}
    #addressTypeModalOverlay .group-modal-body{grid-template-columns:minmax(0,1.2fr) minmax(0,1fr);align-items:start;gap:14px 18px}
    #addressTypeModalOverlay .address-type-list{grid-row:span 2;max-height:420px}
    #addressTypeModalOverlay .address-type-row{padding:12px}
    .address-type-form-panel{display:grid;gap:14px;align-self:start}
    #addressTypeModalOverlay .group-modal-footer{justify-content:space-between}
    @media (max-width:900px){
      #addressTypeModalOverlay .group-modal{width:min(520px,calc(100vw - 24px));max-width:calc(100vw - 24px)}
      #addressTypeModalOverlay .group-modal-body{grid-template-columns:1fr}
      #addressTypeModalOverlay .address-type-list{grid-row:auto;max-height:280px}
      .address-type-form-panel{gap:10px}
      #addressTypeModalOverlay .group-modal-footer{justify-content:flex-end}
    }
    .debt-period-modal-overlay {
      display: none;
      position: fixed;
      inset: 0;
      z-index: 1200;
      background: rgba(15, 23, 42, 0.45);
      align-items: center;
      justify-content: center;
      padding: 16px;
    }
    .debt-period-modal-overlay.is-open { display: flex; }
    .debt-period-modal {
      width: min(420px, 100%);
      background: #fff;
      border-radius: 10px;
      box-shadow: 0 20px 50px rgba(15, 23, 42, 0.2);
      overflow: hidden;
    }
    .debt-period-modal__header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 14px 16px;
      border-bottom: 1px solid #e2e8f0;
    }
    .debt-period-modal__header h3 { margin: 0; font-size: 16px; }
    .debt-period-modal__close {
      border: none;
      background: transparent;
      font-size: 22px;
      line-height: 1;
      cursor: pointer;
      color: #64748b;
    }
    .debt-period-modal__body { padding: 16px; display: grid; gap: 12px; }
    .debt-period-option {
      display: flex;
      align-items: center;
      gap: 8px;
      font-weight: 600;
      cursor: pointer;
    }
    .debt-period-range {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      padding: 10px 12px;
      border: 1px solid #e2e8f0;
      border-radius: 8px;
      background: #f8fafc;
    }
    .debt-period-field { display: grid; gap: 4px; font-size: 13px; }
    .debt-period-field input[type="date"] {
      border: 1px solid #cbd5e1;
      border-radius: 6px;
      padding: 6px 8px;
      font: inherit;
    }
    .debt-period-modal__footer {
      display: flex;
      justify-content: flex-end;
      gap: 8px;
      padding: 12px 16px;
      border-top: 1px solid #e2e8f0;
    }

    #addCustomerModalOverlay .modal-content.customer-create-modal {
      width: min(900px, calc(100vw - 96px)) !important;
      max-width: calc(100vw - 96px) !important;
    }
    #addCustomerModalOverlay .customer-form-main {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    #addCustomerModalOverlay .customer-form-field.form-row-full {
      grid-column: 1 / -1;
    }

    /* Mobile — Khách hàng (desktop giữ nguyên) */
    @media (max-width: 900px) {
      main.customer-page.admin-shell {
        width: 100% !important;
        max-width: 100% !important;
        padding: 8px !important;
      }
      main.customer-page .customer-shell {
        display: flex !important;
        flex-direction: column !important;
        min-height: 0 !important;
        grid-template-columns: none !important;
      }
      main.customer-page .customer-filter {
        width: 100%;
        padding: 12px;
        border-right: 0;
        border-bottom: 1px solid #e2e8f0;
      }
      main.customer-page .customer-filter h2 {
        font-size: 18px;
        margin-bottom: 12px;
      }
      main.customer-page .customer-filter-section {
        padding-bottom: 10px;
        margin-bottom: 10px;
        gap: 6px;
      }
      main.customer-page .customer-filter form {
        gap: 6px;
      }
      main.customer-page .custom-date-range {
        grid-template-columns: 1fr;
      }
      main.customer-page .customer-filter h4 {
        margin: 10px 0 6px;
        font-size: 12px;
      }
      main.customer-page .customer-filter .pill-row {
        flex-wrap: wrap;
        gap: 6px;
      }
      main.customer-page .customer-filter .pill-btn {
        flex: 1 1 calc(33.333% - 4px);
        min-width: 0;
        padding: 0 6px;
        font-size: 11px;
        height: 32px;
      }
      main.customer-page .range-stack {
        grid-template-columns: 1fr 1fr;
        gap: 8px;
      }
      main.customer-page .customer-filter .filter-control,
      main.customer-page .customer-filter select,
      main.customer-page .customer-filter input[type="text"],
      main.customer-page .customer-filter input[type="number"],
      main.customer-page .customer-filter input[type="date"] {
        width: 100%;
        max-width: 100%;
      }
      main.customer-page .customer-filter .btn {
        display: flex;
        width: 100%;
        min-height: 38px;
        align-items: center;
        justify-content: center;
        margin-top: 8px;
      }
      main.customer-page .customer-filter .btn-primary {
        color: #fff;
      }
      main.customer-page .customer-content {
        width: 100%;
        min-width: 0;
        padding: 10px 0 24px;
      }
      main.customer-page .customer-toolbar {
        flex-direction: column;
        align-items: stretch;
        gap: 10px;
      }
      main.customer-page .customer-search {
        width: 100% !important;
        max-width: none;
      }
      main.customer-page .customer-toolbar-actions {
        width: 100%;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px;
        align-items: stretch;
      }
      main.customer-page .customer-toolbar-actions > .btn-primary,
      main.customer-page .customer-toolbar-actions > #openAddCustomerModal {
        grid-column: 1 / -1;
      }
      main.customer-page .customer-import-wrap {
        display: block;
        width: 100%;
      }
      main.customer-page .customer-import-wrap > .btn {
        width: 100%;
        justify-content: center;
      }
      main.customer-page .customer-import-menu {
        left: 0;
        right: 0;
        min-width: 0;
        width: 100%;
      }
      main.customer-page .customer-toolbar-actions > a.btn {
        display: flex;
        align-items: center;
        justify-content: center;
      }
      main.customer-page .customer-table-wrap {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        max-width: 100%;
      }
      main.customer-page .customer-table {
        min-width: 980px;
      }
      .debt-period-range {
        grid-template-columns: 1fr;
      }
      .customer-create-modal {
        width: min(640px, calc(100vw - 16px)) !important;
        max-width: calc(100vw - 16px) !important;
      }
      #addCustomerModalOverlay .customer-form-main {
        grid-template-columns: 1fr;
      }
    }
    @media (max-width: 520px) {
      main.customer-page .customer-filter .pill-btn {
        flex: 1 1 calc(50% - 4px);
      }
    }
  </style>
</head>
<body class="admin-body">
  <%- include('../partials/header', { activeMenu: activeMenu, user: user }) %>

  <main class="admin-shell customer-page">
    <%- include('../partials/flash-message', { flash: flash }) %>

    <div id="addCustomerModalOverlay" class="modal-overlay" data-auto-open="<%= formMode === 'create' ? '1' : '0' %>">
      <div class="modal-content customer-create-modal">
        <div class="modal-header">
          <h3 id="addCustomerModalTitle">Tạo khách hàng</h3>
          <button type="button" class="modal-close" id="addCustomerModalClose">×</button>
        </div>
      
        <form class="modal-body" method="post" action="/khach-hang/add" id="customerCreateForm">
          <div class="customer-form-grid">
      
            <!-- THONG TIN CHUNG -->
            <div class="form-row-full collapsible-section is-active">
              <div class="collapsible-header">
                <strong>Thông tin khách hàng</strong>
                <span class="chevron">▲</span>
              </div>
      
              <div class="collapsible-content customer-form-main">
                <div class="customer-form-field">
                  <label>Loại khách hàng</label>
                  <div class="radio-inline">
                    <label>
                      <input type="radio" name="loai_khach_hang" value="ca_nhan" checked>
                      Cá nhân
                    </label>
                    <label>
                      <input type="radio" name="loai_khach_hang" value="cong_ty">
                      Công ty
                    </label>
                  </div>
                </div>
      
                <div class="customer-form-field">
                  <label>Mã khách hàng</label>
                  <div class="auto-code-preview">Tự động</div>
                </div>
      
                <div class="customer-form-field form-row-full">
                  <label>Tên khách hàng *</label>
                  <input name="ten_khach_hang" placeholder="Nhập tên khách hàng" required>
                </div>
      
                <div class="customer-form-field company-field" style="display:none;">
                  <label>Tên công ty</label>
                  <input name="ten_cong_ty" placeholder="Nhập tên công ty">
                </div>
      
                <div class="customer-form-field company-field" style="display:none;">
                  <label>Mã số thuế</label>
                  <input name="ma_so_thue" placeholder="Nhập mã số thuế">
                </div>
      
                <div class="customer-form-field">
                  <label>Số điện thoại *</label>
                  <input name="sdt" type="tel" inputmode="tel" pattern="[0-9.]+" maxlength="14" placeholder="Nhập số điện thoại" required data-phone-input>
                </div>
      
                <div class="customer-form-field">
                  <label>Email</label>
                  <input type="email" name="email" placeholder="email@gmail.com">
                </div>
      
                <div class="customer-form-field">
                  <label>Facebook</label>
                  <input name="facebook" placeholder="facebook.com/username">
                </div>
      
                <div class="customer-form-field individual-field">
                  <label>Ngày sinh</label>
                  <input type="date" name="ngay_sinh">
                </div>
      
                <div class="customer-form-field individual-field">
                  <label>Giới tính</label>
                  <select name="gioi_tinh">
                    <option value="">Chọn giới tính</option>
                    <option value="nam">Nam</option>
                    <option value="nu">Nữ</option>
                    <option value="khac">Khác</option>
                  </select>
                </div>
      
                <div class="customer-form-field individual-field">
                  <label>MST *</label>
                  <input name="mst" type="text" inputmode="numeric" pattern="[0-9]{10,13}" maxlength="13" placeholder="Nhập MST" required data-digits-only data-mst-input>
                </div>
      
              </div>
            </div>
      
      
            <!-- DIA CHI -->
            <div class="form-row-full collapsible-section is-active">
              <div class="collapsible-header">
                <strong>Địa chỉ khách hàng</strong>
                <span class="chevron">▲</span>
              </div>
      
              <div class="collapsible-content customer-form-main">
                <div class="customer-form-field">
                  <label>Mã địa chỉ</label>
                  <div class="auto-code-preview">Tự động</div>
                </div>
      
                <div class="customer-form-field">
                  <label>Loại địa chỉ</label>
                  <% var initialAddressType = (addressTypes && addressTypes[0]) ? addressTypes[0] : null; %>
                  <div class="address-type-wrapper">
                    <div class="address-type-header">
                      <button class="address-type-trigger" type="button" id="addressTypeTrigger">
                        <span id="addressTypeSelectedLabel"><%= initialAddressType ? initialAddressType.ten_loai : 'Chọn loại địa chỉ' %></span>
                        <span>▾</span>
                      </button>
                      <button class="btn btn-primary btn-sm" type="button" id="addressTypeAddBtn">Thêm</button>
                    </div>
                    <input type="hidden" name="loai_dia_chi" id="addressTypeValue" value="<%= initialAddressType ? initialAddressType.ma_loai : '' %>">
                    <div class="address-type-dropdown" id="addressTypeDropdown">
                      <% (addressTypes || []).forEach(function(type) { %>
                        <div
                          class="address-type-item <%= initialAddressType && String(initialAddressType._id) === String(type._id) ? 'is-active' : '' %>"
                          data-id="<%= type._id %>"
                          data-value="<%= type.ma_loai %>"
                          data-name="<%= type.ten_loai %>"
                        >
                          <button class="address-type-option" type="button"><%= type.ten_loai %></button>
                          <div class="address-type-actions">
                            <button class="address-type-action-edit" type="button">Sửa</button>
                            <button class="address-type-action-delete" type="button">Xóa</button>
                          </div>
                        </div>
                      <% }) %>
                    </div>
                  </div>
                </div>
      
                <div class="customer-form-field">
                  <label>Tên người nhận</label>
                  <input name="ten_nguoi_nhan" placeholder="Nhập tên người nhận">
                </div>
      
                <div class="customer-form-field">
                  <label>SĐT người nhận</label>
                  <input name="sdt_nguoi_nhan" placeholder="Nhập SĐT người nhận">
                </div>
      
                <div class="customer-form-field">
                  <label>Tỉnh/Thành</label>
                  <select class="js-ghn-province" name="tinh_thanh" data-selected-name="">
                    <option value="">Chọn Tỉnh/Thành phố</option>
                  </select>
                  <input type="hidden" name="tinh_thanh_id" class="js-ghn-province-id">
                </div>
      
                <div class="customer-form-field">
                  <label>Phường/Xã</label>
                  <select class="js-ghn-ward" name="phuong_xa" data-selected-name="">
                    <option value="">Chọn Phường/Xã</option>
                  </select>
                  <input type="hidden" name="phuong_xa_code" class="js-ghn-ward-code">
                  <input type="hidden" name="quan_huyen" class="js-ghn-district-name">
                  <input type="hidden" name="quan_huyen_id" class="js-ghn-district-id">
                </div>

                <div class="customer-form-field">
                  <label>Địa chỉ chi tiết</label>
                  <input name="dia_chi_chi_tiet" placeholder="Số nhà, đường, thôn/xóm">
                </div>
      
                <div class="customer-form-field form-row-full">
                  <label>
                    <input type="checkbox" name="mac_dinh" value="true" checked>
                    Đặt làm địa chỉ mặc định
                  </label>
                </div>
      
                <div class="customer-form-field form-row-full">
                  <label>Ghi chú địa chỉ</label>
                  <textarea name="ghi_chu_dia_chi" placeholder="Ví dụ: địa chỉ công ty, nơi nhận hàng, nhà riêng..."></textarea>
                </div>
              </div>
            </div>
      
            <div class="form-row-full collapsible-section is-active">
              <div class="collapsible-header">
                <strong>Nhóm khách hàng, ghi chú</strong>
                <span class="chevron">▲</span>
              </div>
      
              <div class="collapsible-content customer-form-main">
                <div class="customer-form-field form-row-full">
                  <label>Nhóm khách hàng</label>
                  <div class="group-manage-wrapper" id="groupManageModal">
                    <div class="group-manage-header">
                      <button class="group-manage-trigger" type="button" id="groupModalTrigger">
                        <span id="groupModalSelectedLabel">Không chọn nhóm</span>
                        <span>▾</span>
                      </button>
                      <button class="btn btn-primary btn-sm" type="button" id="groupModalAddBtn">Thêm</button>
                    </div>
                    <input type="hidden" name="nhom_khach_hang_id" id="groupModalValue" value="">
                    <div class="group-manage-dropdown" id="groupModalDropdown">
                      <div class="group-manage-item is-active" data-id="" data-value="" data-name="Không chọn nhóm" data-desc="">
                        <button class="group-manage-option" type="button">Không chọn nhóm</button>
                      </div>
                      <% customerGroups.forEach(function(group) { %>
                        <div class="group-manage-item" data-id="<%= group._id %>" data-value="<%= group._id %>" data-name="<%= group.ten_nhom %>" data-desc="<%= group.mo_ta || '' %>">
                          <button class="group-manage-option" type="button"><%= group.ten_nhom %></button>
                          <div class="group-manage-actions">
                            <button class="group-manage-action-edit" type="button">Sửa</button>
                            <button class="group-manage-action-delete" type="button">Xóa</button>
                          </div>
                        </div>
                      <% }) %>
                    </div>
                  </div>
                </div>
      
                <div class="customer-form-field">
                  <label>Ngân hàng</label>
                  <input name="ngan_hang" placeholder="Nhập tên ngân hàng">
                </div>
      
                <div class="customer-form-field">
                  <label>Số tài khoản ngân hàng</label>
                  <input name="stk_ngan_hang" placeholder="Nhập số tài khoản">
                </div>

                <div class="customer-form-field">
                  <label>Chủ tài khoản</label>
                  <input name="chu_tai_khoan" placeholder="Nhập tên chủ tài khoản">
                </div>
      
                <div class="customer-form-field form-row-full">
                  <label>Ghi chú</label>
                  <textarea name="ghi_chu" placeholder="Nhập ghi chú"></textarea>
                </div>
              </div>
            </div>
      
          </div>
        </form>
      
        <div class="page-actions modal-footer">
          <button class="btn btn-light" type="button" id="addCustomerModalCancel">Bỏ qua</button>
          <button class="btn btn-primary" type="submit" form="customerCreateForm">Lưu</button>
        </div>
      </div>
      
      <script>
        document.addEventListener('DOMContentLoaded', function () {

          const radios = document.querySelectorAll('input[name="loai_khach_hang"]');
          const companyFields = document.querySelectorAll('.company-field');
          const individualFields = document.querySelectorAll('.individual-field');
      
          function toggleCustomerType() {
            const selected = document.querySelector('input[name="loai_khach_hang"]:checked')?.value;
            const mstInput = document.querySelector('[data-mst-input]');
      
            companyFields.forEach(el => {
              el.style.display = selected === 'cong_ty' ? '' : 'none';
            });
      
            individualFields.forEach(el => {
              el.style.display = selected === 'ca_nhan' ? '' : 'none';
            });

            if (mstInput) {
              mstInput.required = selected === 'ca_nhan';
              if (selected !== 'ca_nhan') mstInput.value = '';
            }
          }
          window.toggleCustomerType = toggleCustomerType;
      
          radios.forEach(radio => {
            radio.addEventListener('change', toggleCustomerType);
          });
      
          toggleCustomerType();
        });
      </script>
    </div>

    <div class="customer-shell">
      <aside class="customer-filter">
        <h2>Khách hàng</h2>
        <form method="get" action="/khach-hang" id="customerFilterForm">
          <section class="customer-filter-section">
            <div class="customer-filter-title-row">
              <h4>Nhóm khách hàng</h4>
              <button class="filter-link-btn" type="button" id="groupAddBtn">Tạo mới</button>
            </div>
            <% var selectedSidebarGroup = customerGroups.find(function(group) { return filter.groupId === String(group._id); }); %>
            <div class="group-manage-wrapper" id="groupManageSidebar">
              <div class="group-manage-header">
                <button class="group-manage-trigger" type="button" id="groupFilterTrigger">
                  <span id="groupFilterSelectedLabel"><%= selectedSidebarGroup ? selectedSidebarGroup.ten_nhom : 'Tất cả các nhóm' %></span>
                  <span>▾</span>
                </button>
              </div>
              <input type="hidden" name="groupId" id="groupFilterValue" value="<%= filter.groupId || 'all' %>">
              <div class="group-manage-dropdown" id="groupFilterDropdown">
                <div class="group-manage-item <%= (!filter.groupId || filter.groupId === 'all') ? 'is-active' : '' %>" data-id="" data-value="all" data-name="Tất cả các nhóm" data-desc="">
                  <button class="group-manage-option" type="button">Tất cả các nhóm</button>
                </div>
                <% customerGroups.forEach(function(group) { %>
                  <div class="group-manage-item <%= filter.groupId === String(group._id) ? 'is-active' : '' %>" data-id="<%= group._id %>" data-value="<%= group._id %>" data-name="<%= group.ten_nhom %>" data-desc="<%= group.mo_ta || '' %>">
                    <button class="group-manage-option" type="button"><%= group.ten_nhom %></button>
                    <div class="group-manage-actions">
                      <button class="group-manage-action-edit" type="button">Sửa</button>
                      <button class="group-manage-action-delete" type="button">Xóa</button>
                    </div>
                  </div>
                <% }) %>
              </div>
            </div>
            <h4>Ngày tạo</h4>
            <select name="created" id="createdFilterSelect">
              <option value="all" <%= filter.created === 'all' ? 'selected' : '' %>>Toàn thời gian</option>
              <option value="today" <%= filter.created === 'today' ? 'selected' : '' %>>Hôm nay</option>
              <option value="7days" <%= filter.created === '7days' ? 'selected' : '' %>>7 ngày qua</option>
              <option value="30days" <%= filter.created === '30days' ? 'selected' : '' %>>30 ngày qua</option>
              <option value="custom" <%= filter.created === 'custom' ? 'selected' : '' %>>Tùy chỉnh</option>
            </select>
            <div class="custom-date-range <%= filter.created === 'custom' ? 'is-visible' : '' %>" id="customDateRange">
              <input type="date" name="createdFrom" value="<%= filter.createdFrom || '' %>">
              <input type="date" name="createdTo" value="<%= filter.createdTo || '' %>">
            </div>
            <h4>Người tạo</h4>
            <input type="text" name="creatorKeyword" value="<%= filter.creatorKeyword || '' %>" placeholder="Chọn người tạo">
            <h4>Loại khách hàng</h4>
            <div class="pill-row">
              <button class="pill-btn <%= filter.customerType === 'all' ? 'is-active' : '' %>" type="button" data-target-input="customerTypeInput" data-value="all">Tất cả</button>
              <button class="pill-btn <%= filter.customerType === 'ca_nhan' ? 'is-active' : '' %>" type="button" data-target-input="customerTypeInput" data-value="ca_nhan">Cá nhân</button>
              <button class="pill-btn <%= filter.customerType === 'cong_ty' ? 'is-active' : '' %>" type="button" data-target-input="customerTypeInput" data-value="cong_ty">Công ty</button>
            </div>
            <input type="hidden" id="customerTypeInput" name="customerType" value="<%= filter.customerType || 'all' %>">
            <h4>Giới tính</h4>
            <div class="pill-row">
              <button class="pill-btn <%= filter.gender === 'all' ? 'is-active' : '' %>" type="button" data-target-input="genderInput" data-value="all">Tất cả</button>
              <button class="pill-btn <%= filter.gender === 'nam' ? 'is-active' : '' %>" type="button" data-target-input="genderInput" data-value="nam">Nam</button>
              <button class="pill-btn <%= filter.gender === 'nu' ? 'is-active' : '' %>" type="button" data-target-input="genderInput" data-value="nu">Nữ</button>
            </div>
            <input type="hidden" id="genderInput" name="gender" value="<%= filter.gender || 'all' %>">
            <h4>Tổng bán</h4>
            <div class="range-stack">
              <div class="range-row"><span>Từ</span><input type="number" min="0" name="totalSalesFrom" value="<%= filter.totalSalesFrom || '' %>" placeholder="Nhập giá trị"></div>
              <div class="range-row"><span>Tới</span><input type="number" min="0" name="totalSalesTo" value="<%= filter.totalSalesTo || '' %>" placeholder="Nhập giá trị"></div>
            </div>
            <h4>Nợ hiện tại</h4>
            <div class="range-stack">
              <div class="range-row"><span>Từ</span><input type="number" min="0" name="currentDebtFrom" value="<%= filter.currentDebtFrom || '' %>" placeholder="Nhập giá trị"></div>
              <div class="range-row"><span>Tới</span><input type="number" min="0" name="currentDebtTo" value="<%= filter.currentDebtTo || '' %>" placeholder="Nhập giá trị"></div>
            </div>
            <h4>Khu vực giao hàng</h4>
            <input type="text" name="shippingArea" value="<%= filter.shippingArea || '' %>" placeholder="Chọn Tỉnh/Thành phố">
            <button class="btn btn-primary" type="submit">Áp dụng lọc</button>
            <a class="btn btn-light" href="/khach-hang">Xóa lọc</a>
          </section>
        </form>
      </aside>

      <section class="customer-content">
        <div class="customer-toolbar">
          <div class="customer-search">
            <span>⌕</span>
            <input type="search" name="keyword" form="customerFilterForm" value="<%= filter.keyword || '' %>" placeholder="Theo mã, tên, số điện thoại">
          </div>
          <div class="customer-toolbar-actions">
            <button class="btn btn-primary" type="button" id="openAddCustomerModal">+ Khách hàng</button>
            <div class="customer-import-wrap">
              <button class="btn btn-light" type="button" id="customerImportToggle" aria-haspopup="true" aria-expanded="false">Thêm bằng file ▾</button>
              <div class="customer-import-menu" id="customerImportMenu" role="menu" aria-label="Thêm bằng file">
                <a href="/khach-hang/import/template.xlsx" role="menuitem">Lấy file mẫu</a>
                <button type="button" id="customerImportPickBtn" role="menuitem">Thêm</button>
              </div>
            </div>
            <form id="customerImportForm" method="post" action="/khach-hang/import" enctype="multipart/form-data" hidden>
              <input type="file" name="file" id="customerImportFile" accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet">
            </form>
            <a class="btn btn-light" href="/khach-hang/export.xlsx<%= filterQueryString ? '?' + filterQueryString : '' %>">Xuất file</a>
          </div>


        </div>

        <div class="customer-table-wrap">
          <form id="bulkDeleteCustomersForm" method="post" action="/khach-hang/delete-selected"></form>
            <table class="admin-table customer-table" data-kv-master="khach-hang">
              <thead>
                <tr>
                  <th class="check-cell"><input id="selectAllCustomers" type="checkbox" aria-label="Chọn tất cả"></th>
                  <th>Mã khách hàng</th>
                  <th>Tên khách hàng</th>
                  <th>Điện thoại</th>
                  <th>Nợ hiện tại</th>
                  <th>Tổng bán</th>
                  <th>Tổng bán trừ trả hàng</th>

                </tr>
              </thead>
              <tbody>
                <tr class="customer-summary-row" style="background-color: #f1f5f9;">
                  <td class="check-cell"></td>
                  <td colspan="3" style="text-align: right; font-weight: bold; color: #1e293b;">Tổng cộng:</td>
                  <td><strong><%= Number(summaryTotals.totalDebt || 0).toLocaleString('vi-VN') %></strong></td>
                  <td><strong><%= Number(summaryTotals.totalSales || 0).toLocaleString('vi-VN') %></strong></td>
                  <td><strong><%= Number(summaryTotals.totalNetSales || 0).toLocaleString('vi-VN') %></strong></td>
                </tr>
                <% if (customers.length === 0) { %>
                  <tr>
                    <td colspan="7" class="empty-cell">Không có khách hàng phù hợp với bộ lọc.</td>
                  </tr>

                <% } %>
                <% customers.forEach(function(customer) { %>
                  <% var listBase = '/khach-hang' + (filterQueryString ? ('?' + filterQueryString) : ''); %>
                  <tr data-kv-detail-id="<%= customer._id %>">
                    <td class="check-cell" onclick="event.stopPropagation()"><input class="customer-checkbox" type="checkbox" name="ids" value="<%= customer._id %>" form="bulkDeleteCustomersForm" aria-label="Chọn khách hàng"></td>
                    <td><a class="table-code-link kv-detail-code-link" href="<%= listBase %>"><%= customer.ma_khach_hang || '---' %></a></td>
                    <td><strong><%= customer.ten_khach_hang || '---' %></strong></td>
                    <td><%= customer.sdt || '---' %></td>
                    <td><%= Number(customer.tong_no || 0).toLocaleString('vi-VN') %></td>
                    <td><%= Number(customer.tong_ban || 0).toLocaleString('vi-VN') %></td>
                    <td><%= Number(customer.tong_ban_tru_tra_hang || 0).toLocaleString('vi-VN') %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          <% customers.forEach(function(customer) { %>
            <form id="deleteCustomerForm_<%= customer._id %>" method="post" action="/khach-hang/<%= customer._id %>/delete"></form>
          <% }) %>
        </div>
      </section>
    </div>
  </main>
  <div id="groupModalOverlay" class="group-modal-overlay">
    <div class="group-modal">
      <div class="group-modal-header">
        <h3 id="groupModalTitle">Sửa nhóm khách hàng</h3>
        <button type="button" class="group-modal-close" id="groupModalClose">×</button>
      </div>
      <div class="group-modal-body">
        <label>
          <span>Tên nhóm</span>
          <input id="groupNameInput" type="text" placeholder="Nhập tên nhóm">
        </label>
        <label>
          <span>Ghi chú</span>
          <input id="groupDescInput" type="text" placeholder="Nhập ghi chú">
        </label>
      </div>
      <div class="page-actions group-modal-footer">
        <button class="btn btn-light btn-sm" type="button" id="groupModalCancel">Bỏ qua</button>
        <button class="btn btn-primary btn-sm" type="button" id="groupModalSubmit">Lưu</button>
      </div>
