    var createSubmit = document.getElementById('customerAdvanceCreateSubmit');
    var offsetOverlay = document.getElementById('customerAdvanceOffsetOverlay');
    var offsetForm = document.getElementById('customerAdvanceOffsetForm');
    var offsetDesc = document.getElementById('customerAdvanceOffsetDesc');
    var offsetCode = document.getElementById('customerAdvanceOffsetCode');
    var offsetRemain = document.getElementById('customerAdvanceOffsetRemain');
    var offsetAmount = document.getElementById('customerAdvanceOffsetAmount');
    var offsetCash = document.getElementById('customerAdvanceOffsetCash');
    var offsetTransfer = document.getElementById('customerAdvanceOffsetTransfer');
    var offsetCashBook = document.getElementById('customerAdvanceOffsetCashBook');
