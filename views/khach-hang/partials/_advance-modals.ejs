    height: 72px;
    padding: 8px 10px;
    resize: vertical;
  }
  .customer-advance-create-modal__footer {
    display: flex;
    justify-content: flex-end;
    gap: 8px;
    padding: 12px 16px;
    border-top: 1px solid #e2e8f0;
    background: #f8fafc;
  }
  .customer-advance-action-overlay {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 1450;
