    function localParseCustomerMoney(value) {
      var raw = String(value == null ? '' : value).replace(/[^\d]/g, '');
      if (!raw) return '';
      return Number(raw);
    }

    function localFormatCustomerMoney(value) {
      var amount = Number(value || 0);
      if (!isFinite(amount)) amount = 0;
      return Math.floor(amount).toLocaleString('vi-VN');
    }

    var parseMoney = (typeof window !== 'undefined' && typeof window.parseCustomerMoney === 'function')
      ? window.parseCustomerMoney
      : (typeof parseCustomerMoney === 'function' ? parseCustomerMoney : localParseCustomerMoney);
    var formatMoney = (typeof window !== 'undefined' && typeof window.formatCustomerMoney === 'function')
      ? window.formatCustomerMoney
      : (typeof formatCustomerMoney === 'function' ? formatCustomerMoney : localFormatCustomerMoney);

    function escapeAdvanceHtml(value) {
      return String(value == null ? '' : value)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    function parseAdvanceJson(response) {
      return response.text().then(function(text) {
        var json = null;
        try { json = text ? JSON.parse(text) : null; } catch (err) { json = null; }
        return { response: response, json: json };
      });
    }

    function formatAdvanceDateTime(value) {
      if (!value) return '---';
      var date = new Date(value);
      if (isNaN(date.getTime())) return '---';
      return date.toLocaleString('vi-VN');
    }

    function toAdvanceDateTimeLocal(value) {
      var date = value ? new Date(value) : new Date();
      if (isNaN(date.getTime())) date = new Date();
      var local = new Date(date.getTime() - date.getTimezoneOffset() * 60000);
      return local.toISOString().slice(0, 16);
    }

    function closeAdvanceActionMenus(exceptMenu) {
      document.querySelectorAll('.customer-advance-action-menu.is-open').forEach(function(menu) {
        if (exceptMenu && menu === exceptMenu) return;
        menu.classList.remove('is-open');
        var toggle = menu.querySelector('[data-customer-advance-menu-toggle]');
        if (toggle) toggle.setAttribute('aria-expanded', 'false');
      });
    }

    function positionAdvanceActionMenu(menu) {
      if (!menu) return;
      var toggle = menu.querySelector('[data-customer-advance-menu-toggle]');
      var dropdown = menu.querySelector('.customer-advance-action-dropdown');
      if (!toggle || !dropdown) return;
      var rect = toggle.getBoundingClientRect();
      var width = dropdown.offsetWidth || 168;
      var height = dropdown.offsetHeight || 90;
      var left = Math.min(window.innerWidth - width - 8, Math.max(8, rect.right - width));
      var top = rect.bottom + 4;
      if (top + height > window.innerHeight - 8) top = Math.max(8, rect.top - height - 4);
      dropdown.style.left = left + 'px';
      dropdown.style.top = top + 'px';
    }

    function setCustomerMoneyTone(element, value) {
      if (!element) return;
      var number = Number(value || 0);
      element.classList.remove('customer-money-positive', 'customer-money-negative');
      if (number > 0) element.classList.add('customer-money-positive');
      if (number < 0) element.classList.add('customer-money-negative');
    }

    function updateCustomerAdvanceSummaryTotals() {
      var rows = Array.prototype.slice.call(document.querySelectorAll('.customer-row[data-customer-id]'));
      var totalDebt = 0;
      var totalAdvance = 0;
      var totalFinal = 0;
      rows.forEach(function(row) {
        totalDebt += Number(row.dataset.metricTongNo || 0);
        totalAdvance += Number(row.dataset.metricTamUng || 0);
        totalFinal += Number(row.dataset.metricTongNoCuoi || 0);
      });
      var debtStrong = document.querySelector('.customer-summary-row [data-summary-field="tong-no"] strong');
      var advanceStrong = document.querySelector('.customer-summary-row [data-summary-field="tam-ung"] strong');
      var finalStrong = document.querySelector('.customer-summary-row [data-summary-field="tong-no-cuoi"] strong');
      if (debtStrong) debtStrong.textContent = formatMoney(totalDebt);
      if (advanceStrong) advanceStrong.textContent = formatMoney(totalAdvance);
      if (finalStrong) {
        finalStrong.textContent = formatMoney(totalFinal);
        setCustomerMoneyTone(finalStrong, totalFinal);
      }
    }

    function refreshCustomerAdvanceCell(customerId, advanceDelta, debtDelta) {
      var row = document.querySelector('.customer-row[data-customer-id="' + customerId + '"]');
      if (!row) return;
      var nextAdvance = Math.max(0, Number(row.dataset.metricTamUng || 0) + Number(advanceDelta || 0));
      var nextTongNo = Math.max(0, Number(row.dataset.metricTongNo || 0) + Number(debtDelta || 0));
      var tongNoCuoi = nextTongNo - nextAdvance;
      row.dataset.metricTamUng = String(nextAdvance);
      row.dataset.metricTongNo = String(nextTongNo);
      row.dataset.metricTongNoCuoi = String(tongNoCuoi);

      var advanceCell = row.querySelector('[data-field="tam-ung"]');
      if (advanceCell) {
        var advanceLink = advanceCell.querySelector('.js-customer-advance-link');
        if (advanceLink) advanceLink.textContent = formatMoney(nextAdvance);
        else advanceCell.textContent = formatMoney(nextAdvance);
      }

      var debtCell = row.querySelector('[data-field="tong-no"]');
      if (debtCell) debtCell.textContent = formatMoney(nextTongNo);

      var finalCell = row.querySelector('[data-field="tong-no-cuoi"]');
      if (finalCell) {
        finalCell.textContent = formatMoney(tongNoCuoi);
        setCustomerMoneyTone(finalCell, tongNoCuoi);
      }

      updateCustomerAdvanceSummaryTotals();
    }

    function renderAdvanceRows(rows) {
      if (!rows || !rows.length) {
        rowsEl.innerHTML = '<tr><td colspan="10" class="customer-advance-modal__empty">Chưa có phiếu tạm ứng.</td></tr>';
        return;
      }
      rowsEl.innerHTML = rows.map(function(row) {
        var note = String(row.ghi_chu || '').trim() || '---';
        var remain = Number(row.con_lai || 0);
        var canAct = remain > 0 && row.trang_thai !== 'huy';
        var actions = canAct
          ? ('<div class="customer-advance-action-menu">' +
              '<button type="button" class="customer-advance-more-btn" data-customer-advance-menu-toggle aria-label="Thao tác" aria-expanded="false">⋯</button>' +
              '<div class="customer-advance-action-dropdown" role="menu">' +
                '<button type="button" class="customer-advance-menu-item js-customer-advance-offset" role="menuitem"' +
                  ' data-advance-id="' + escapeAdvanceHtml(row.id) + '"' +
                  ' data-advance-code="' + escapeAdvanceHtml(row.ma_phieu || '') + '"' +
                  ' data-advance-remain="' + escapeAdvanceHtml(remain) + '">Cấn trừ</button>' +
                '<button type="button" class="customer-advance-menu-item js-customer-advance-refund" role="menuitem"' +
                  ' data-advance-id="' + escapeAdvanceHtml(row.id) + '"' +
                  ' data-advance-code="' + escapeAdvanceHtml(row.ma_phieu || '') + '"' +
                  ' data-advance-remain="' + escapeAdvanceHtml(remain) + '">Hoàn tiền</button>' +
              '</div>' +
            '</div>')
          : '—';
        return '<tr>' +
          '<td>' + escapeAdvanceHtml(row.ma_phieu || '---') + '</td>' +
          '<td>' + escapeAdvanceHtml(formatAdvanceDateTime(row.ngay_lap)) + '</td>' +
          '<td class="num">' + formatMoney(row.so_tien) + '</td>' +
          '<td class="num">' + formatMoney(row.da_can_tru) + '</td>' +
          '<td class="num">' + formatMoney(row.da_hoan) + '</td>' +
          '<td class="num">' + formatMoney(row.con_lai) + '</td>' +
          '<td>' + escapeAdvanceHtml(row.phuong_thuc_text || '---') + '</td>' +
          '<td>' + escapeAdvanceHtml(row.trang_thai_text || '---') + '</td>' +
          '<td class="note" title="' + escapeAdvanceHtml(note) + '">' + escapeAdvanceHtml(note) + '</td>' +
          '<td class="actions">' + actions + '</td>' +
        '</tr>';
      }).join('');
    }

    function fillCashBookSelect(selectEl, options, emptyLabel) {
      if (!selectEl) return;
      selectEl.innerHTML = '<option value="">' + escapeAdvanceHtml(emptyLabel) + '</option>' + options.map(function(item) {
        var label = item.loai_so_quy === 'chuyen_khoan'
          ? ((item.ten_ngan_hang || item.ten_so_quy || 'Tài khoản') + (item.so_tai_khoan ? (' - ' + item.so_tai_khoan) : ''))
          : (item.ten_so_quy || 'Sổ tiền mặt');
        return '<option value="' + escapeAdvanceHtml(item.id) + '"' + (item.mac_dinh ? ' selected' : '') + '>' +
          escapeAdvanceHtml(label) + '</option>';
      }).join('');
    }

    function fillCashBookSelects(books) {
      cashBooksCache = Array.isArray(books) ? books : [];
      var cashOptions = cashBooksCache.filter(function(item) {
        return (item.loai_so_quy || 'tien_mat') === 'tien_mat';
      });
      var bankOptions = cashBooksCache.filter(function(item) {
        return item.loai_so_quy === 'chuyen_khoan';
      });
      fillCashBookSelect(createCashBook, cashOptions, 'Chọn sổ tiền mặt');
      fillCashBookSelect(createBankBook, bankOptions, 'Chọn sổ chuyển khoản');
      fillCashBookSelect(offsetCashBook, cashOptions, 'Chọn sổ tiền mặt');
      fillCashBookSelect(offsetBankBook, bankOptions, 'Chọn sổ chuyển khoản');
      fillCashBookSelect(refundCashBook, cashOptions, 'Chọn sổ tiền mặt');
      fillCashBookSelect(refundBankBook, bankOptions, 'Chọn sổ chuyển khoản');
    }

    function closeOffsetModal() {
      if (!offsetOverlay) return;
      offsetOverlay.classList.remove('is-open');
      offsetOverlay.setAttribute('aria-hidden', 'true');
      currentAdvance = null;
      offsetInvoices = [];
    }

    function closeRefundModal() {
      if (!refundOverlay) return;
      refundOverlay.classList.remove('is-open');
      refundOverlay.setAttribute('aria-hidden', 'true');
      currentAdvance = null;
    }

    function closeCreateAdvanceModal() {
      if (!createOverlay) return;
      createOverlay.classList.remove('is-open');
      createOverlay.setAttribute('aria-hidden', 'true');
    }

    function closeAdvanceModal() {
      closeCreateAdvanceModal();
      closeOffsetModal();
      closeRefundModal();
      closeAdvanceActionMenus();
      overlay.classList.remove('is-open');
      overlay.setAttribute('aria-hidden', 'true');
      currentCustomer = { id: '', code: '', name: '' };
    }

    function loadAdvanceList() {
      if (!currentCustomer.id) return Promise.resolve();
      rowsEl.innerHTML = '<tr><td colspan="10" class="customer-advance-modal__empty">Đang tải...</td></tr>';
      return fetch('/khach-hang/api/' + encodeURIComponent(currentCustomer.id) + '/tam-ung', {
        headers: { Accept: 'application/json' },
        credentials: 'same-origin'
      })
        .then(parseAdvanceJson)
        .then(function(result) {
          if (!result.response.ok || !result.json || result.json.success === false) {
            throw new Error((result.json && result.json.message) || 'Không tải được phiếu tạm ứng.');
          }
          return result.json;
        })
        .then(function(payload) {
          fillCashBookSelects(payload.cash_books || []);
          renderAdvanceRows(payload.rows || []);
        })
        .catch(function(error) {
          rowsEl.innerHTML = '<tr><td colspan="10" class="customer-advance-modal__empty">' +
            escapeAdvanceHtml(error.message || 'Không tải được phiếu tạm ứng.') +
            '</td></tr>';
        });
    }

    function openAdvanceModal(customerId, customerCode, customerName) {
      if (!customerId) return;
      currentCustomer = {
        id: customerId,
        code: customerCode || '',
        name: customerName || ''
      };
      var label = [currentCustomer.code, currentCustomer.name].filter(Boolean).join(' - ') || 'khách hàng';
      if (titleEl) titleEl.textContent = 'Phiếu tạm ứng';
      if (descEl) descEl.textContent = 'Danh sách phiếu tạm ứng của ' + label + '.';
      overlay.classList.add('is-open');
      overlay.setAttribute('aria-hidden', 'false');
      loadAdvanceList();
    }

    function openCreateAdvanceModal() {
      if (!currentCustomer.id) return alert('Vui lòng chọn khách hàng.');
      var label = [currentCustomer.code, currentCustomer.name].filter(Boolean).join(' - ') || 'khách hàng';
      if (createDesc) createDesc.textContent = 'Tạm ứng từ ' + label + '.';
      if (createForm) createForm.reset();
      if (createDate) createDate.value = toAdvanceDateTimeLocal(new Date());
      if (createAmount) createAmount.value = '';
      if (createCash) createCash.value = '';
      if (createTransfer) createTransfer.value = '';
      if (createNote) createNote.value = '';
      fillCashBookSelects(cashBooksCache);
      if (createOverlay) {
        createOverlay.classList.add('is-open');
        createOverlay.setAttribute('aria-hidden', 'false');
      }
      if (createCash) createCash.focus();
    }

    function setOffsetRowInputValue(input, value) {
      if (!input) return;
      var amount = Math.max(0, Number(value || 0));
      input.value = amount ? formatMoney(amount) : '0';
    }

    function getOffsetRowAllocations() {
      var rows = [];
      if (!offsetRowsEl) return rows;
      Array.prototype.slice.call(offsetRowsEl.querySelectorAll('.js-customer-advance-offset-row-paid')).forEach(function(input) {
        var paid = Number(parseMoney(input.value) || 0);
        if (paid <= 0) return;
        rows.push({
          hoa_don_id: input.getAttribute('data-invoice-id') || '',
          ma_hoa_don: input.getAttribute('data-invoice-code') || '',
          so_tien: paid
        });
      });
      return rows;
    }

    function syncOffsetAllocationJson() {
      if (offsetAllocationsJson) {
        offsetAllocationsJson.value = JSON.stringify(getOffsetRowAllocations());
      }
    }

    function updateOffsetAllocation(source) {
      if (!offsetForm) return;
      var remainLimit = Math.max(0, Number((currentAdvance && currentAdvance.remain) || offsetForm.getAttribute('data-advance-remain') || 0));
      var totalDebt = 0;
      Array.prototype.slice.call(offsetRowsEl ? offsetRowsEl.querySelectorAll('.js-customer-advance-offset-row') : []).forEach(function(row) {
        totalDebt += Math.max(0, Number(row.getAttribute('data-debt') || 0));
      });
      var cap = Math.min(remainLimit, totalDebt);
      var amount = Number(parseMoney(offsetAmount && offsetAmount.value) || 0);
      amount = Math.min(Math.max(0, amount), cap);

      if (source === 'amount') {
        if (offsetAmount) offsetAmount.value = amount ? formatMoney(amount) : '';
        var rest = amount;
        Array.prototype.slice.call(offsetRowsEl ? offsetRowsEl.querySelectorAll('.js-customer-advance-offset-row') : []).forEach(function(row) {
          var rowDebt = Math.max(0, Number(row.getAttribute('data-debt') || 0));
          var paid = Math.min(rest, rowDebt);
          rest -= paid;
          setOffsetRowInputValue(row.querySelector('.js-customer-advance-offset-row-paid'), paid);
        });
      } else {
        var used = 0;
        Array.prototype.slice.call(offsetRowsEl ? offsetRowsEl.querySelectorAll('.js-customer-advance-offset-row-paid') : []).forEach(function(input) {
          var rowDebt = Math.max(0, Number(input.getAttribute('data-debt') || 0));
          var paid = Math.min(Number(parseMoney(input.value) || 0), rowDebt, Math.max(0, amount - used));
          used += paid;
          setOffsetRowInputValue(input, paid);
        });
      }

      var totalPaid = 0;
      var totalLeft = 0;
      Array.prototype.slice.call(offsetRowsEl ? offsetRowsEl.querySelectorAll('.js-customer-advance-offset-row') : []).forEach(function(row) {
        var rowDebt = Math.max(0, Number(row.getAttribute('data-debt') || 0));
        var input = row.querySelector('.js-customer-advance-offset-row-paid');
        var paid = Math.min(Number(parseMoney(input && input.value) || 0), rowDebt);
        totalPaid += paid;
        totalLeft += Math.max(0, rowDebt - paid);
        var leftCell = row.querySelector('.js-customer-advance-offset-row-left');
        if (leftCell) leftCell.textContent = formatMoney(rowDebt - paid);
      });
      if (offsetTotalDebt) offsetTotalDebt.textContent = formatMoney(totalDebt);
      if (offsetTotalPaid) offsetTotalPaid.textContent = formatMoney(totalPaid);
      if (offsetTotalLeft) offsetTotalLeft.textContent = formatMoney(totalLeft);
      if (offsetUnallocated) offsetUnallocated.textContent = formatMoney(Math.max(0, amount - totalPaid));
      syncOffsetAllocationJson();
    }

    function syncOffsetAmountFromParts() {
      var cash = Number(parseMoney(offsetCash && offsetCash.value) || 0);
      var transfer = Number(parseMoney(offsetTransfer && offsetTransfer.value) || 0);
      var total = cash + transfer;
      if (offsetAmount) offsetAmount.value = total ? formatMoney(total) : '';
      if (offsetCashBook) offsetCashBook.disabled = cash <= 0;
      if (offsetBankBook) offsetBankBook.disabled = transfer <= 0;
      updateOffsetAllocation('amount');
    }

    function formatOffsetDateTime(value) {
      if (!value) return '---';
      var date = new Date(value);
      if (isNaN(date.getTime())) return '---';
      var dd = String(date.getDate());
      var mm = String(date.getMonth() + 1);
      if (dd.length < 2) dd = '0' + dd;
      if (mm.length < 2) mm = '0' + mm;
      var yyyy = date.getFullYear();
      var hh = String(date.getHours());
      var mi = String(date.getMinutes());
      if (hh.length < 2) hh = '0' + hh;
      if (mi.length < 2) mi = '0' + mi;
      return dd + '/' + mm + '/' + yyyy + ' ' + hh + ':' + mi;
    }

    function renderOffsetInvoiceRows(rows) {
      if (!offsetRowsEl) return;
      if (!rows || !rows.length) {
        offsetRowsEl.innerHTML = '<tr><td colspan="7"><div class="customer-pay-empty"><span>Không có hóa đơn còn nợ</span></div></td></tr>';
        if (offsetFootEl) offsetFootEl.style.display = 'none';
        return;
      }
      offsetRowsEl.innerHTML = rows.map(function(item) {
        var debt = Math.max(0, Number(item.con_no || 0));
        return '<tr class="js-customer-advance-offset-row" data-debt="' + escapeAdvanceHtml(debt) + '">' +
          '<td class="customer-advance-offset-code-cell">' +
            '<span class="customer-advance-offset-code">' + escapeAdvanceHtml(item.ma_hoa_don || '---') + '</span>' +
            '<span class="customer-advance-offset-type">Hóa đơn</span>' +
          '</td>' +
          '<td>' + escapeAdvanceHtml(formatOffsetDateTime(item.ngay_ban)) + '</td>' +
          '<td class="text-right">' + formatMoney(item.can_tra) + '</td>' +
          '<td class="text-right">' + formatMoney(item.da_tra) + '</td>' +
          '<td class="text-right">' + formatMoney(debt) + '</td>' +
          '<td class="text-right">' +
            '<input class="customer-pay-row-input js-customer-advance-offset-row-paid" inputmode="numeric" autocomplete="off" value="0"' +
              ' data-invoice-id="' + escapeAdvanceHtml(item.id) + '"' +
              ' data-invoice-code="' + escapeAdvanceHtml(item.ma_hoa_don || '') + '"' +
              ' data-debt="' + escapeAdvanceHtml(debt) + '">' +
          '</td>' +
          '<td class="text-right js-customer-advance-offset-row-left">' + formatMoney(debt) + '</td>' +
        '</tr>';
      }).join('');
      if (offsetFootEl) offsetFootEl.style.display = '';
    }

    function openOffsetModal(advanceId, advanceCode, remain) {
      if (!currentCustomer.id || !advanceId) return;
      currentAdvance = {
        id: advanceId,
        code: advanceCode || '',
        remain: Number(remain || 0)
      };
      if (offsetForm) offsetForm.setAttribute('data-advance-remain', String(currentAdvance.remain));
      if (offsetDesc) {
        offsetDesc.textContent = 'Cấn trừ ' + (currentAdvance.code || 'phiếu tạm ứng') +
          ' vào hóa đơn của ' + ([currentCustomer.code, currentCustomer.name].filter(Boolean).join(' - ') || 'KH') + '.';
      }
      if (offsetCode) offsetCode.value = currentAdvance.code || '';
      if (offsetRemain) offsetRemain.value = formatMoney(currentAdvance.remain);
      if (offsetAmount) offsetAmount.value = '';
      if (offsetCash) offsetCash.value = '';
      if (offsetTransfer) offsetTransfer.value = '';
      if (offsetDate) offsetDate.value = toAdvanceDateTimeLocal(new Date());
      if (offsetNote) offsetNote.value = '';
      fillCashBookSelects(cashBooksCache);
      if (offsetCashBook) offsetCashBook.disabled = true;
      if (offsetBankBook) offsetBankBook.disabled = true;
      if (offsetRowsEl) {
        offsetRowsEl.innerHTML = '<tr><td colspan="7"><div class="customer-pay-empty"><span>Đang tải hóa đơn...</span></div></td></tr>';
      }
      if (offsetFootEl) offsetFootEl.style.display = 'none';
      if (offsetOverlay) {
        offsetOverlay.classList.add('is-open');
        offsetOverlay.setAttribute('aria-hidden', 'false');
      }

      fetch('/khach-hang/api/' + encodeURIComponent(currentCustomer.id) +
        '/tam-ung/' + encodeURIComponent(advanceId) + '/hoa-don', {
        headers: { Accept: 'application/json' },
        credentials: 'same-origin'
      })
        .then(parseAdvanceJson)
        .then(function(result) {
          if (!result.response.ok || !result.json || result.json.success === false) {
            throw new Error((result.json && result.json.message) || 'Không tải được hóa đơn.');
          }
          return result.json;
        })
        .then(function(payload) {
          if (payload.advance) {
            currentAdvance.remain = Number(payload.advance.con_lai || currentAdvance.remain || 0);
            currentAdvance.code = payload.advance.ma_phieu || currentAdvance.code || '';
            if (offsetForm) offsetForm.setAttribute('data-advance-remain', String(currentAdvance.remain));
            if (offsetRemain) offsetRemain.value = formatMoney(currentAdvance.remain);
            if (offsetCode) offsetCode.value = currentAdvance.code || '';
          }
          offsetInvoices = payload.rows || [];
          renderOffsetInvoiceRows(offsetInvoices);
          var totalDebt = offsetInvoices.reduce(function(sum, item) {
            return sum + Math.max(0, Number(item.con_no || 0));
          }, 0);
          var defaultAmount = Math.min(currentAdvance.remain, totalDebt);
          if (offsetCash) offsetCash.value = defaultAmount ? formatMoney(defaultAmount) : '';
          if (offsetTransfer) offsetTransfer.value = '';
          syncOffsetAmountFromParts();
          if (offsetCash) offsetCash.focus();
        })
        .catch(function(error) {
          if (offsetRowsEl) {
            offsetRowsEl.innerHTML = '<tr><td colspan="7"><div class="customer-pay-empty"><span>' +
              escapeAdvanceHtml(error.message || 'Không tải được hóa đơn') +
              '</span></div></td></tr>';
          }
        });
    }

    function openRefundModal(advanceId, advanceCode, remain) {
      if (!currentCustomer.id || !advanceId) return;
      currentAdvance = {
        id: advanceId,
        code: advanceCode || '',
        remain: Number(remain || 0)
      };
      var label = [currentCustomer.code, currentCustomer.name].filter(Boolean).join(' - ') || 'khách hàng';
      if (refundDesc) refundDesc.textContent = 'Hoàn tiền tạm ứng ' + (currentAdvance.code || '') + ' của ' + label + '.';
      if (refundCode) refundCode.value = currentAdvance.code || '';
      if (refundRemain) refundRemain.value = formatMoney(currentAdvance.remain);
      if (refundDate) refundDate.value = toAdvanceDateTimeLocal(new Date());
      if (refundAmount) refundAmount.value = '';
      if (refundCash) refundCash.value = '';
      if (refundTransfer) refundTransfer.value = '';
      if (refundNote) refundNote.value = '';
      fillCashBookSelects(cashBooksCache);
      if (refundOverlay) {
        refundOverlay.classList.add('is-open');
        refundOverlay.setAttribute('aria-hidden', 'false');
      }
      if (refundCash) refundCash.focus();
    }

    function formatAdvanceMoneyInput(input) {
      if (!input) return;
      var digits = String(input.value || '').replace(/\D/g, '');
      input.value = digits === '' ? '' : formatMoney(digits);
    }

    function syncAdvanceAmountFromParts() {
      if (!createAmount) return;
      var cash = Number(parseMoney(createCash && createCash.value) || 0);
      var transfer = Number(parseMoney(createTransfer && createTransfer.value) || 0);
      var total = cash + transfer;
      createAmount.value = total ? formatMoney(total) : '';
    }

    function syncRefundAmountFromParts() {
      if (!refundAmount) return;
      var cash = Number(parseMoney(refundCash && refundCash.value) || 0);
      var transfer = Number(parseMoney(refundTransfer && refundTransfer.value) || 0);
      var total = cash + transfer;
      refundAmount.value = total ? formatMoney(total) : '';
    }

    function submitCreateAdvance() {
      if (!currentCustomer.id) return;
      var cash = Number(parseMoney(createCash && createCash.value) || 0);
      var transfer = Number(parseMoney(createTransfer && createTransfer.value) || 0);
      var amount = cash + transfer;
      if (amount <= 0) return alert('Vui lòng nhập tiền mặt hoặc chuyển khoản.');
      if (cash > 0 && !(createCashBook && createCashBook.value)) return alert('Vui lòng chọn sổ tiền mặt.');
      if (transfer > 0 && !(createBankBook && createBankBook.value)) return alert('Vui lòng chọn sổ chuyển khoản.');

      if (createSubmit) createSubmit.disabled = true;
      fetch('/khach-hang/' + encodeURIComponent(currentCustomer.id) + '/tam-ung', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify({
          payment_v2: true,
          ngay_lap: createDate ? createDate.value : '',
          gia_tri: amount,
          ghi_chu: createNote ? createNote.value : '',
          chi_tiet_thanh_toan: {
            tien_mat: cash,
            chuyen_khoan: transfer,
            so_quy_tien_mat_id: createCashBook ? createCashBook.value : '',
            so_quy_chuyen_khoan_id: createBankBook ? createBankBook.value : ''
          }
        })
      })
        .then(parseAdvanceJson)
        .then(function(result) {
          if (!result.response.ok || !result.json || result.json.success === false) {
            throw new Error((result.json && result.json.message) || 'Không tạo được phiếu tạm ứng.');
          }
          return result.json;
        })
        .then(function(json) {
          closeCreateAdvanceModal();
          refreshCustomerAdvanceCell(currentCustomer.id, amount, 0);
          return loadAdvanceList().then(function() {
            alert(json.message || 'Đã tạo phiếu tạm ứng.');
          });
        })
        .catch(function(error) {
          alert(error.message || 'Không tạo được phiếu tạm ứng.');
        })
        .finally(function() {
          if (createSubmit) createSubmit.disabled = false;
        });
    }

    function submitOffsetAdvance() {
      if (!currentCustomer.id || !currentAdvance || !currentAdvance.id) return;
      var cash = Number(parseMoney(offsetCash && offsetCash.value) || 0);
      var transfer = Number(parseMoney(offsetTransfer && offsetTransfer.value) || 0);
      var paymentAmount = cash + transfer;
      if (paymentAmount <= 0) return alert('Vui lòng nhập tiền mặt hoặc chuyển khoản.');
      if (cash > 0 && !(offsetCashBook && offsetCashBook.value)) return alert('Vui lòng chọn sổ tiền mặt.');
      if (transfer > 0 && !(offsetBankBook && offsetBankBook.value)) return alert('Vui lòng chọn sổ chuyển khoản.');
      if (paymentAmount > Number(currentAdvance.remain || 0)) return alert('Số tiền vượt quá còn lại của phiếu tạm ứng.');

      syncOffsetAmountFromParts();
      var allocations = getOffsetRowAllocations();
      var amount = allocations.reduce(function(sum, row) { return sum + Number(row.so_tien || 0); }, 0);
      if (amount <= 0) return alert('Vui lòng phân bổ số tiền cấn trừ vào hóa đơn.');
      if (Math.abs(amount - paymentAmount) > 0.0001) return alert('Tổng tiền mặt/chuyển khoản phải bằng số tiền đã phân bổ.');

      if (offsetSubmit) offsetSubmit.disabled = true;
      fetch('/khach-hang/' + encodeURIComponent(currentCustomer.id) +
        '/tam-ung/' + encodeURIComponent(currentAdvance.id) + '/can-tru', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify({
          payment_v2: true,
          so_tien: amount,
          gia_tri: amount,
          ngay_lap: offsetDate ? offsetDate.value : '',
          ghi_chu: offsetNote ? offsetNote.value : '',
          allocations_json: JSON.stringify(allocations),
          chi_tiet_thanh_toan: {
            tien_mat: cash,
            chuyen_khoan: transfer,
            so_quy_tien_mat_id: offsetCashBook ? offsetCashBook.value : '',
            so_quy_chuyen_khoan_id: offsetBankBook ? offsetBankBook.value : ''
          }
        })
      })
        .then(parseAdvanceJson)
        .then(function(result) {
          if (!result.response.ok || !result.json || result.json.success === false) {
            throw new Error((result.json && result.json.message) || 'Không cấn trừ được tạm ứng.');
          }
          return result.json;
        })
        .then(function(json) {
          closeOffsetModal();
          refreshCustomerAdvanceCell(currentCustomer.id, -amount, -amount);
          return loadAdvanceList().then(function() {
            alert(json.message || 'Đã cấn trừ tạm ứng.');
          });
        })
        .catch(function(error) {
          alert(error.message || 'Không cấn trừ được tạm ứng.');
        })
        .finally(function() {
          if (offsetSubmit) offsetSubmit.disabled = false;
        });
    }

    function submitRefundAdvance() {
      if (!currentCustomer.id || !currentAdvance || !currentAdvance.id) return;
      var cash = Number(parseMoney(refundCash && refundCash.value) || 0);
      var transfer = Number(parseMoney(refundTransfer && refundTransfer.value) || 0);
      var amount = cash + transfer;
      if (amount <= 0) return alert('Vui lòng nhập tiền mặt hoặc chuyển khoản.');
      if (amount > Number(currentAdvance.remain || 0)) return alert('Số tiền hoàn vượt quá còn lại của phiếu tạm ứng.');
      if (cash > 0 && !(refundCashBook && refundCashBook.value)) return alert('Vui lòng chọn sổ tiền mặt.');
      if (transfer > 0 && !(refundBankBook && refundBankBook.value)) return alert('Vui lòng chọn sổ chuyển khoản.');

      if (refundSubmit) refundSubmit.disabled = true;
      fetch('/khach-hang/' + encodeURIComponent(currentCustomer.id) +
        '/tam-ung/' + encodeURIComponent(currentAdvance.id) + '/hoan-tien', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify({
          payment_v2: true,
          ngay_lap: refundDate ? refundDate.value : '',
          gia_tri: amount,
          ghi_chu: refundNote ? refundNote.value : '',
          chi_tiet_thanh_toan: {
            tien_mat: cash,
            chuyen_khoan: transfer,
            so_quy_tien_mat_id: refundCashBook ? refundCashBook.value : '',
            so_quy_chuyen_khoan_id: refundBankBook ? refundBankBook.value : ''
          }
        })
      })
        .then(parseAdvanceJson)
        .then(function(result) {
          if (!result.response.ok || !result.json || result.json.success === false) {
            throw new Error((result.json && result.json.message) || 'Không hoàn được tạm ứng.');
          }
          return result.json;
        })
        .then(function(json) {
          closeRefundModal();
          refreshCustomerAdvanceCell(currentCustomer.id, -amount, 0);
          return loadAdvanceList().then(function() {
            alert(json.message || 'Đã hoàn tiền tạm ứng.');
          });
        })
        .catch(function(error) {
          alert(error.message || 'Không hoàn được tạm ứng.');
        })
        .finally(function() {
          if (refundSubmit) refundSubmit.disabled = false;
        });
    }

    document.addEventListener('click', function(event) {
      var advanceLink = event.target.closest('.js-customer-advance-link');
      if (advanceLink) {
        event.preventDefault();
        event.stopPropagation();
        openAdvanceModal(
          advanceLink.getAttribute('data-customer-id') || '',
          advanceLink.getAttribute('data-customer-code') || '',
          advanceLink.getAttribute('data-customer-name') || ''
        );
        return;
      }

      var menuToggle = event.target.closest('[data-customer-advance-menu-toggle]');
      if (menuToggle) {
        event.preventDefault();
        event.stopPropagation();
        var menu = menuToggle.closest('.customer-advance-action-menu');
        var willOpen = menu && !menu.classList.contains('is-open');
        closeAdvanceActionMenus();
        if (willOpen && menu) {
          menu.classList.add('is-open');
          menuToggle.setAttribute('aria-expanded', 'true');
          positionAdvanceActionMenu(menu);
        }
        return;
      }

      var offsetBtn = event.target.closest('.js-customer-advance-offset');
      if (offsetBtn) {
        event.preventDefault();
        event.stopPropagation();
        closeAdvanceActionMenus();
        openOffsetModal(
          offsetBtn.getAttribute('data-advance-id') || '',
          offsetBtn.getAttribute('data-advance-code') || '',
          offsetBtn.getAttribute('data-advance-remain') || 0
        );
        return;
      }

      var refundBtn = event.target.closest('.js-customer-advance-refund');
      if (refundBtn) {
        event.preventDefault();
        event.stopPropagation();
        closeAdvanceActionMenus();
        openRefundModal(
          refundBtn.getAttribute('data-advance-id') || '',
          refundBtn.getAttribute('data-advance-code') || '',
          refundBtn.getAttribute('data-advance-remain') || 0
        );
        return;
      }

      if (!event.target.closest('.customer-advance-action-menu')) {
        closeAdvanceActionMenus();
      }
    });

    if (createBtn) createBtn.addEventListener('click', function(event) {
      event.preventDefault();
      event.stopPropagation();
      openCreateAdvanceModal();
    });
    [createCash, createTransfer].forEach(function(input) {
      if (!input) return;
      input.addEventListener('input', function() {
        formatAdvanceMoneyInput(input);
        syncAdvanceAmountFromParts();
      });
      input.addEventListener('blur', function() {
        formatAdvanceMoneyInput(input);
        syncAdvanceAmountFromParts();
      });
    });
    [refundCash, refundTransfer].forEach(function(input) {
      if (!input) return;
      input.addEventListener('input', function() {
        formatAdvanceMoneyInput(input);
        syncRefundAmountFromParts();
      });
      input.addEventListener('blur', function() {
        formatAdvanceMoneyInput(input);
        syncRefundAmountFromParts();
      });
    });
    [offsetCash, offsetTransfer].forEach(function(input) {
      if (!input) return;
      input.addEventListener('input', function() {
        formatAdvanceMoneyInput(input);
        syncOffsetAmountFromParts();
      });
      input.addEventListener('blur', function() {
        formatAdvanceMoneyInput(input);
        syncOffsetAmountFromParts();
      });
    });
    if (offsetRowsEl) {
      offsetRowsEl.addEventListener('input', function(event) {
        var input = event.target.closest('.js-customer-advance-offset-row-paid');
        if (!input) return;
        formatAdvanceMoneyInput(input);
        updateOffsetAllocation('row');
      });
      offsetRowsEl.addEventListener('blur', function(event) {
        var input = event.target.closest('.js-customer-advance-offset-row-paid');
        if (!input) return;
        formatAdvanceMoneyInput(input);
        updateOffsetAllocation('row');
      }, true);
    }
    if (createSubmit) createSubmit.addEventListener('click', submitCreateAdvance);
    if (createClose) createClose.addEventListener('click', closeCreateAdvanceModal);
    if (createCancel) createCancel.addEventListener('click', closeCreateAdvanceModal);
    if (offsetSubmit) offsetSubmit.addEventListener('click', submitOffsetAdvance);
    if (offsetClose) offsetClose.addEventListener('click', closeOffsetModal);
    if (offsetCancel) offsetCancel.addEventListener('click', closeOffsetModal);
    if (refundSubmit) refundSubmit.addEventListener('click', submitRefundAdvance);
    if (refundClose) refundClose.addEventListener('click', closeRefundModal);
    if (refundCancel) refundCancel.addEventListener('click', closeRefundModal);
    if (closeBtn) closeBtn.addEventListener('click', closeAdvanceModal);
    if (cancelBtn) cancelBtn.addEventListener('click', closeAdvanceModal);
    window.addEventListener('resize', function() {
      document.querySelectorAll('.customer-advance-action-menu.is-open').forEach(positionAdvanceActionMenu);
    });
    document.addEventListener('keydown', function(event) {
      if (event.key !== 'Escape') return;
      if (offsetOverlay && offsetOverlay.classList.contains('is-open')) {
        closeOffsetModal();
        return;
      }
      if (refundOverlay && refundOverlay.classList.contains('is-open')) {
        closeRefundModal();
        return;
      }
      if (createOverlay && createOverlay.classList.contains('is-open')) {
        closeCreateAdvanceModal();
        return;
      }
      if (overlay.classList.contains('is-open')) closeAdvanceModal();
    });
  })();
</script>
