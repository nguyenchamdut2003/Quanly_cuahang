    margin-bottom: 12px;
  }
  .customer-advance-modal__desc {
    margin: 0;
    color: #64748b;
    font-size: 13px;
    flex: 1 1 auto;
    min-width: 0;
  }
  .customer-advance-modal__actions {
    display: flex;
    align-items: center;
    gap: 8px;
    flex: 0 0 auto;
  }
  .customer-advance-modal__table-wrap {
    overflow: auto;
    max-height: min(520px, calc(100vh - 220px));
    border: 1px solid #e2e8f0;
    border-radius: 8px;
  }
  .customer-advance-modal__table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
  }
  .customer-advance-modal__table th,
