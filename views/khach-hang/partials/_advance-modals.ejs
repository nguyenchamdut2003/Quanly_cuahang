    color: #475569;
    font-weight: 700;
    position: sticky;
    top: 0;
    z-index: 1;
  }
  .customer-advance-modal__table td.num,
  .customer-advance-modal__table th.num { text-align: right; }
  .customer-advance-modal__table th.note,
  .customer-advance-modal__table td.note {
    width: 180px;
    max-width: 180px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .customer-advance-modal__table th.actions,
  .customer-advance-modal__table td.actions {
    width: 64px;
    text-align: center;
    overflow: visible;
    white-space: normal;
  }
  .customer-advance-action-menu {
    position: relative;
    display: inline-flex;
    justify-content: center;
    width: 100%;
  }
  .customer-advance-more-btn {
    width: 32px;
    height: 32px;
    border: 1px solid #cfd8e3;
    background: #fff;
    color: #344054;
    border-radius: 6px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 18px;
    line-height: 1;
    padding: 0;
  }
  .customer-advance-more-btn:hover,
  .customer-advance-action-menu.is-open .customer-advance-more-btn {
    border-color: #0070f4;
    color: #006dff;
    background: #eff6ff;
  }
  .customer-advance-more-btn:disabled {
    opacity: .45;
    cursor: not-allowed;
  }
  .customer-advance-action-dropdown {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 1500;
    display: none;
    min-width: 168px;
    padding: 6px;
    border: 1px solid #d9e2ec;
    border-radius: 7px;
    background: #fff;
    box-shadow: 0 12px 24px rgba(15, 23, 42, .16);
  }
  .customer-advance-action-menu.is-open .customer-advance-action-dropdown { display: block; }
  .customer-advance-menu-item {
    width: 100%;
    min-height: 34px;
    border: 0;
    border-radius: 5px;
    background: transparent;
    color: #1f2937;
    padding: 0 9px;
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 700;
    text-align: left;
    cursor: pointer;
    white-space: nowrap;
  }
  .customer-advance-menu-item:hover { background: #f1f5f9; color: #006dff; }
  .customer-advance-modal__empty {
    padding: 28px 16px;
    text-align: center;
    color: #94a3b8;
  }
  .customer-advance-modal__footer {
    display: flex;
    justify-content: flex-end;
    padding: 12px 16px;
    border-top: 1px solid #e2e8f0;
    background: #f8fafc;
  }
  .customer-advance-create-overlay {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 1400;
    background: rgba(15, 23, 42, 0.45);
    align-items: flex-start;
    justify-content: center;
    padding: 24px 16px;
    overflow: auto;
  }
  .customer-advance-create-overlay.is-open { display: flex; }
  .customer-advance-create-modal {
    width: min(560px, 100%);
    background: #fff;
    border-radius: 10px;
    box-shadow: 0 20px 50px rgba(15, 23, 42, 0.2);
