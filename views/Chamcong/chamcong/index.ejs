<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Chấm công mới</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/stylesheets/style.css">
  <link rel="stylesheet" href="/stylesheets/responsive.css">
  <%- include('../partials/_catalog-styles') %>
  <style>
    .cc-page{background:#f3f6f9;min-height:calc(100vh - 98px);padding:24px}
    .cc-shell{background:#fff;border:1px solid #d7dde5;border-radius:8px;min-height:calc(100vh - 150px);display:flex;flex-direction:column}
    .cc-head{display:flex;align-items:center;gap:12px;padding:14px 18px;border-bottom:1px solid #e5e9ee}
    .cc-head h1{margin:0;font-size:20px;font-weight:800;color:#111827;flex:1}
    .cc-pane{display:none;flex:1;min-height:0}
    .cc-pane.is-active{display:flex;flex-direction:column}
    .cc-toolbar{display:flex;align-items:end;gap:10px;padding:14px 18px;border-bottom:1px solid #e5e9ee;flex-wrap:wrap}
    .cc-field{display:grid;gap:5px}
    .cc-field label{font-size:12px;color:#475467;font-weight:700}
    .cc-select,.cc-input,.cc-textarea{border:1px solid #cfd8e3;border-radius:7px;background:#fff;padding:0 10px;font-size:13px;color:#111827}
    .cc-select,.cc-input{height:34px}
    .cc-textarea{height:68px;padding:8px 10px;resize:vertical}
    .cc-select{min-width:260px}
    .cc-btn{height:34px;border:1px solid #cfd8e3;background:#fff;border-radius:7px;padding:0 12px;font-size:13px;font-weight:700;color:#344054;cursor:pointer}
    .cc-btn-primary{border-color:#0070f4;background:#0070f4;color:#fff}
    .cc-btn-danger{border-color:#fca5a5;background:#fff;color:#b42318}
    .cc-btn-icon{width:34px;padding:0}
    .cc-week-label{font-size:13px;color:#475467;font-weight:700;margin-left:auto}
    .cc-toolbar-status{min-width:120px;max-width:320px;font-size:12px;color:#475467;text-align:right;line-height:1.35}
    .cc-toolbar-status.is-error{color:#b42318}
    .cc-toolbar-status.is-ok{color:#047857}
    .cc-btn-primary:disabled{opacity:.65;cursor:not-allowed}
    .cc-board-wrap{padding:18px;overflow:auto;flex:1}
    .cc-board{display:grid;grid-template-columns:repeat(7,minmax(136px,1fr));border:1px solid #d7dde5;border-radius:8px;overflow:hidden;min-width:980px}
    .cc-day{border-right:1px solid #d7dde5;background:#fff;min-height:290px;display:flex;flex-direction:column}
    .cc-day:last-child{border-right:0}
    .cc-day-head{background:#e8f3ff;border-bottom:1px solid #c9ddf6;padding:10px 12px}
    .cc-day-title{display:flex;justify-content:space-between;gap:8px;font-size:13px;font-weight:800;color:#111827}
    .cc-day-top-actions{display:inline-flex;align-items:center;justify-content:flex-end;gap:6px;min-width:0}
    .cc-overtime-day-toggle{display:inline-flex!important;grid-template-columns:none!important;align-items:center;justify-content:center;width:38px;height:22px;padding:0;border:0;background:transparent;cursor:pointer}
    .cc-overtime-day-toggle:hover{background:#f1f5f9}
    .cc-overtime-day-toggle input{position:absolute;opacity:0;pointer-events:none}
    .cc-overtime-day-switch{position:relative;width:34px;height:18px;border-radius:999px;background:#cbd5e1;transition:background .15s ease}
    .cc-overtime-day-switch::after{content:"";position:absolute;top:3px;left:3px;width:12px;height:12px;border-radius:50%;background:#fff;box-shadow:0 1px 2px rgba(15,23,42,.25);transition:transform .15s ease}
    .cc-overtime-day-toggle input:checked + .cc-overtime-day-switch{background:#0070c9}
    .cc-overtime-day-toggle input:checked + .cc-overtime-day-switch::after{transform:translateX(16px)}
    .cc-day-date{font-size:12px;color:#475467;margin-top:4px}
    .cc-today{display:inline-flex;align-items:center;height:18px;border-radius:9px;background:#0070f4;color:#fff;padding:0 7px;font-size:10px;font-weight:800}
    .cc-payroll-warning{border:0;background:#fff7ed;color:#b45309;border-radius:999px;width:22px;height:22px;display:inline-flex;align-items:center;justify-content:center;cursor:pointer}
    .cc-payroll-warning:hover{background:#ffedd5}
    .cc-row-highlight{background:#fff7ed!important}
    .cc-ref-link{color:#0070f4;text-decoration:none;font-weight:700}
    .cc-ref-link:hover{text-decoration:underline}
    .cc-day-body{display:grid;gap:10px;padding:12px;align-content:start;flex:1}
    .cc-day-body label{display:grid;gap:5px;font-size:12px;color:#475467;font-weight:700}
    .cc-check{display:flex!important;grid-template-columns:none!important;align-items:center;gap:8px;color:#111827}
    .cc-check input{width:16px;height:16px;accent-color:#0070f4}
    .cc-shift-list{display:grid;gap:8px}
    .cc-overtime-input{height:32px;border:1px solid #cfd8e3;border-radius:7px;padding:0 8px;font-size:13px;text-align:right;font-variant-numeric:tabular-nums}
    .cc-work-unit{font-size:12px;color:#047857;font-weight:800}
    .cc-month .cc-day-body{min-height:120px}
    .cc-time{height:32px;border:1px solid #cfd8e3;border-radius:7px;padding:0 8px;font-size:13px}
    .cc-note{height:58px;border:1px solid #cfd8e3;border-radius:7px;padding:8px;font-size:13px;resize:none}
    .cc-empty{padding:44px 20px;text-align:center;color:#64748b;font-size:14px}
    .cc-status{min-height:20px;font-size:13px;color:#475467;padding:0 18px 16px}
    .cc-status.is-error{color:#b42318}
    .cc-status.is-ok{color:#047857}
    .cc-table-wrap{padding:18px;overflow:auto;flex:1}
    .cc-table{width:100%;min-width:1280px;border-collapse:collapse;table-layout:fixed}
    .cc-table th{height:36px;background:#e8f3ff;border-bottom:1px solid #c9ddf6;text-align:left;font-size:12px;color:#111827;padding:0 8px}
    .cc-table td{border-bottom:1px solid #e5e9ee;padding:8px;font-size:12px;color:#111827;vertical-align:middle;overflow-wrap:anywhere}
    .cc-table tbody tr:hover{background:#f8fbff}
    .cc-loading-cell{height:96px;text-align:center!important;color:#667085!important;background:#fff!important}
    .cc-list-loading{display:inline-flex;align-items:center;justify-content:center;gap:10px;font-size:13px;font-weight:700;color:#475467}
    .cc-list-spinner{width:18px;height:18px;border:2px solid #dbe7f5;border-top-color:#0070f4;border-radius:50%;animation:cc-spin .8s linear infinite}
    @keyframes cc-spin{to{transform:rotate(360deg)}}
    .cc-table th:nth-child(1),.cc-table td:nth-child(1){width:90px}
    .cc-table th:nth-child(2),.cc-table td:nth-child(2){width:180px}
    .cc-table th:nth-child(10),.cc-table td:nth-child(10),
    .cc-table th:nth-child(11),.cc-table td:nth-child(11){text-align:right}
    .cc-table th:nth-child(12),.cc-table td:nth-child(12){width:86px}
    .cc-table th:nth-child(13),.cc-table td:nth-child(13){width:92px}
    .cc-pill{display:inline-flex;align-items:center;height:22px;border-radius:5px;padding:0 8px;font-size:11px;font-weight:800}
    .cc-pill.is-active{background:#dcfce7;color:#166534}
    .cc-pill.is-inactive{background:#fee2e2;color:#991b1b}
    .cc-actions{display:flex;gap:6px}
    .cc-modal{position:fixed;inset:0;background:rgba(15,23,42,.45);display:none;align-items:center;justify-content:center;z-index:1300;padding:16px;overflow:hidden}
    .cc-modal.is-open{display:flex}
    .cc-dialog{width:min(900px,100%);background:#fff;border-radius:8px;box-shadow:0 20px 50px rgba(0,0,0,.2);max-height:calc(100vh - 32px);display:flex;flex-direction:column;overflow:hidden}
    .cc-dialog-head{padding:15px 18px;border-bottom:1px solid #e5e9ee;font-size:17px;font-weight:800;flex:0 0 auto;background:#fff}
    .cc-dialog-body{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;padding:16px 18px;overflow:auto}
    .cc-dialog-body .span-2{grid-column:span 2}
    .cc-dialog-actions{display:flex;justify-content:flex-end;gap:8px;padding:14px 18px;border-top:1px solid #e5e9ee;flex:0 0 auto;background:#fff}
    .cc-salary-label{display:flex!important;grid-template-columns:none!important;align-items:center;gap:8px}
    .cc-salary-label input{width:16px;height:16px;accent-color:#0070f4}
    .cc-money-input{text-align:right;font-variant-numeric:tabular-nums}
    .cc-form-section{grid-column:span 2;border-top:1px solid #e5e9ee;padding-top:14px;margin-top:2px;display:grid;gap:12px}
    .cc-form-section h3{margin:0;font-size:14px;font-weight:800;color:#111827;text-transform:uppercase}
    .cc-form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
    .cc-radio-stack{display:grid;gap:8px}
    .cc-radio-line{display:flex;align-items:center;gap:8px;font-size:13px;color:#111827}
    .cc-radio-line input,.cc-allowance-check input{width:15px;height:15px;accent-color:#0070f4}
    .cc-nested-config{display:none;gap:10px;padding:10px 12px;background:#f8fafc;border:1px solid #e5e9ee;border-radius:7px}
    .cc-nested-config.is-open{display:grid}
    .cc-help-text{font-size:12px;color:#667085;line-height:1.45}
    .cc-allowance-list{display:grid;gap:10px}
    .cc-allowance-item{border:1px solid #e5e9ee;border-radius:8px;padding:10px 12px;display:grid;gap:10px;background:#fff}
    .cc-allowance-check{display:flex;align-items:center;gap:8px;font-size:13px;font-weight:800;color:#111827}
    .cc-allowance-config{display:none;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:10px}
    .cc-allowance-item.is-checked .cc-allowance-config{display:grid}
    .cc-allowance-preview{grid-column:span 2;font-size:12px;color:#047857;font-weight:700}
    .cc-field:has(#ccFormRole),
    .cc-field:has(#ccFormHasDaySalary),
    .cc-field:has(#ccFormHasMonthSalary){display:none}
    .cc-employee-toolbar{align-items:end}
    .cc-employee-search{min-width:226px}
    .cc-employee-filter-spacer{flex:1;min-width:16px}
    .cc-filter-picker{display:grid;gap:6px;min-width:210px}
    .cc-filter-picker-head{display:flex;align-items:center;justify-content:space-between;gap:10px}
    .cc-filter-picker-head label{font-size:12px;color:#344054;font-weight:800}
    .cc-filter-picker-head button{border:0;background:transparent;color:#0070f4;font-size:12px;font-weight:800;padding:0;cursor:pointer}
    .cc-filter-picker-head button:hover{text-decoration:underline}
    .cc-filter-picker .cc-select{min-width:0;width:100%}
    .cc-employee-inline-filters{display:flex;align-items:end;gap:10px;flex-wrap:wrap;margin-left:auto}
    .cc-contribution-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}
    .cc-contribution-item{display:flex;align-items:center;justify-content:space-between;gap:10px;border:1px solid #e5e9ee;border-radius:7px;padding:9px 10px;font-size:13px;color:#111827}
    .cc-contribution-item input{width:15px;height:15px;accent-color:#0070f4}
    .cc-contribution-rate{font-weight:800;color:#047857;white-space:nowrap}
    .cc-payroll-note{font-size:12px;color:#667085;max-width:420px;line-height:1.45}
    .cc-payroll-detail{min-width:220px;vertical-align:top}
    .cc-payroll-day-lines{display:grid;gap:6px}
    .cc-payroll-day-line{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:6px 8px;border:1px solid #e4eaf2;border-radius:6px;background:#f8fafc;font-size:12px;color:#344054}
    .cc-payroll-day-line strong{font-weight:700;color:#111827;white-space:nowrap}
    .cc-payroll-day-line span{color:#475467;white-space:nowrap;font-variant-numeric:tabular-nums}
    .cc-payroll-day-note{display:block;margin-top:2px;font-size:11px;color:#667085}
    .cc-payroll-day-summary{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:7px 8px;border:1px solid #facc15;border-radius:6px;background:#fffbeb;color:#854d0e;font-size:12px}
    .cc-payroll-day-summary strong{font-size:14px;color:#ca8a04}
    .cc-payroll-day-range{color:#475467;font-weight:700}
    .cc-payroll-toggle{width:28px;height:28px;border:1px solid #facc15;background:#fff;color:#854d0e;border-radius:6px;cursor:pointer;font-weight:800;line-height:1}
    .cc-payroll-toggle.is-open{background:#fef3c7}
    .cc-payroll-day-details[hidden]{display:none}
    .cc-payroll-lines{display:grid;gap:0;margin-top:8px;border:1px solid #e5e9ee;border-radius:8px;background:#f8fafc;overflow:hidden}
    .cc-payroll-line{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:center;gap:14px;font-size:12px;padding:8px 10px;border-bottom:1px solid #e5e9ee;color:#344054}
    .cc-payroll-line:last-child{border-bottom:0}
    .cc-payroll-line b{white-space:nowrap;font-variant-numeric:tabular-nums;color:#111827}
    .cc-payroll-line.is-plus b{color:#047857}
    .cc-payroll-line.is-minus b{color:#b42318}
    .cc-payroll-line.is-subtotal,.cc-payroll-line.is-total{background:#fff;font-weight:800}
    .cc-payroll-line.is-total b{color:#0070f4;font-size:15px}
    .cc-payroll-line small{display:block;margin-top:3px;color:#667085;font-weight:500;line-height:1.35}
    .cc-payroll-warn{display:block;font-size:11px;color:#b45309;margin-top:6px}
    .cc-payroll-table td{vertical-align:top}
    .cc-payroll-table{min-width:1320px}
    .cc-payroll-table th:nth-child(1),.cc-payroll-table td:nth-child(1){width:96px}
    .cc-payroll-table th:nth-child(2),.cc-payroll-table td:nth-child(2){width:88px}
    .cc-payroll-table th:nth-child(3),.cc-payroll-table td:nth-child(3){width:140px}
    .cc-payroll-table th:nth-child(4),.cc-payroll-table td:nth-child(4){width:72px;white-space:nowrap}
    .cc-payroll-table th:nth-child(5),.cc-payroll-table td:nth-child(5){width:auto}
    .cc-payroll-table th:nth-child(6),.cc-payroll-table td:nth-child(6),
    .cc-payroll-table th:nth-child(7),.cc-payroll-table td:nth-child(7),
    .cc-payroll-table th:nth-child(8),.cc-payroll-table td:nth-child(8),
    .cc-payroll-table th:nth-child(9),.cc-payroll-table td:nth-child(9){width:110px;text-align:right}
    .cc-payroll-table th:nth-child(10),.cc-payroll-table td:nth-child(10){width:132px}
    .cc-payroll-table th:nth-child(11),.cc-payroll-table td:nth-child(11){width:142px;text-align:center}
    .cc-th-select{height:30px;min-width:128px;width:100%;padding:0 8px;font-size:12px;font-weight:800;background:#fff}
    .cc-payroll-pay{display:grid;gap:8px;justify-items:start}
    .cc-pill-pay-wait{background:#eff6ff;color:#1d4ed8}
    .cc-pill-pay-done{background:#dcfce7;color:#166534}
    .cc-payroll-pay-note{font-size:11px;color:#667085}
    .cc-payroll-action-buttons{display:flex;align-items:center;justify-content:center;gap:6px}
    .cc-payroll-action-buttons .cc-btn{text-decoration:none}
    .cc-payroll-view-btn,.cc-payroll-export-btn{width:34px;height:34px;display:inline-flex;align-items:center;justify-content:center}
    .cc-payroll-delete-btn{width:34px;height:34px;display:inline-flex;align-items:center;justify-content:center;color:#b42318;border-color:#fecaca;background:#fff}
    .cc-payroll-delete-btn:hover{background:#fef2f2}
    .cc-payroll-detail-head{display:grid;gap:6px}
    .cc-payroll-detail-head h3{margin:0;font-size:18px;font-weight:800;color:#111827}
    .cc-payroll-detail-meta{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
    .cc-payroll-detail-meta div{border:1px solid #e5e9ee;border-radius:7px;background:#f8fafc;padding:9px 10px}
    .cc-payroll-detail-meta span{display:block;font-size:11px;color:#667085;margin-bottom:4px}
    .cc-payroll-detail-meta strong{font-size:13px;color:#111827;overflow-wrap:anywhere}
    .cc-payroll-detail-section{display:grid;gap:8px}
    .cc-payroll-detail-section h4{margin:0;font-size:14px;font-weight:800;color:#111827}
    .cc-pay-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;padding:16px 18px;overflow:auto;min-height:0;flex:1 1 auto}
    .cc-pay-grid .span-2{grid-column:span 2}
    .cc-advance-grid{grid-template-columns:minmax(220px,.9fr) minmax(180px,1fr)}
    .cc-bulk-grid{display:grid;grid-template-columns:1fr;gap:10px}
    .cc-bulk-option{display:grid;grid-template-columns:auto minmax(0,1fr);gap:12px;align-items:start;border:1px solid #e5e9ee;border-left:4px solid #0070f4;border-radius:8px;background:#f8fbff;padding:11px 12px;cursor:pointer}
    .cc-bulk-option:hover{background:#eef6ff}
    .cc-bulk-option input{width:18px;height:18px;margin-top:2px;accent-color:#0070f4}
    .cc-bulk-option-title{display:block;font-size:14px;font-weight:800;color:#111827;line-height:1.3}
    .cc-bulk-option-note{display:block;margin-top:3px;font-size:12px;color:#667085;line-height:1.35}
    .cc-bulk-option.is-clear{border-left-color:#dc2626;background:#fff7f7}
    .cc-bulk-option.is-clear:hover{background:#fff1f1}
    .cc-bulk-option.is-clear input{accent-color:#dc2626}
    .cc-bulk-option.is-overtime{border-left-color:#d97706;background:#fffbeb}
    .cc-bulk-option.is-overtime:hover{background:#fef3c7}
    .cc-bulk-option.is-overtime input{accent-color:#d97706}
    .cc-attendance-warning-list{display:grid;gap:10px}
    .cc-attendance-warning-item{border:1px solid #fed7aa;border-left:4px solid #f59e0b;border-radius:8px;background:#fffbeb;padding:11px 12px;display:grid;gap:8px}
    .cc-attendance-warning-main{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}
    .cc-attendance-warning-date{font-size:14px;font-weight:800;color:#92400e}
    .cc-attendance-warning-links{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
    .cc-attendance-warning-links a{font-size:12px;font-weight:800;color:#0070f4;text-decoration:none}
    .cc-attendance-warning-links a:hover{text-decoration:underline}
    .cc-attendance-warning-note{font-size:12px;color:#667085;line-height:1.4}
    .cc-pay-total{font-size:22px;font-weight:800;color:#0070f4}
    .cc-pay-summary{font-size:15px;font-weight:800;color:#111827}
    .cc-pay-error{font-size:12px;color:#b42318;line-height:1.45}
    .cc-employee-detail{margin:0 18px 18px;border:1px solid #d7dde5;border-radius:8px;background:#fff;display:none}
    .cc-employee-detail.is-open{display:block}
    .cc-detail-head{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:12px 14px;border-bottom:1px solid #e5e9ee}
    .cc-detail-head h3{margin:0;font-size:15px;font-weight:800;color:#111827}
    .cc-detail-tabs{display:flex;gap:6px;padding:10px 14px 0;border-bottom:1px solid #e5e9ee}
    .cc-detail-tab{border:0;background:transparent;padding:9px 10px;font-size:13px;font-weight:800;color:#475467;cursor:pointer;border-bottom:2px solid transparent}
    .cc-detail-tab.is-active{color:#0070f4;border-bottom-color:#0070f4}
    .cc-detail-pane{display:none;padding:14px}
    .cc-detail-pane.is-active{display:block}
    .cc-info-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}
    .cc-info-grid div{border:1px solid #e5e9ee;border-radius:7px;padding:9px 10px;background:#f8fafc}
    .cc-info-grid span{display:block;font-size:11px;color:#667085;margin-bottom:4px}
    .cc-info-grid strong{font-size:13px;color:#111827;overflow-wrap:anywhere}
    .cc-small-table{width:100%;border-collapse:collapse}
    .cc-small-table th{height:32px;background:#e8f3ff;border-bottom:1px solid #c9ddf6;text-align:left;font-size:12px;padding:0 8px}
    .cc-small-table td{border-bottom:1px solid #e5e9ee;padding:8px;font-size:12px}
    .cc-detail-toolbar{display:flex;align-items:end;justify-content:space-between;gap:12px;margin-bottom:12px;flex-wrap:wrap}
    .cc-detail-toolbar .cc-field{min-width:220px}
    .cc-nav-group{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
    .cc-nav-label{font-size:12px;color:#667085;font-weight:700;white-space:nowrap}
    .cc-nav-switch{border:0;background:transparent;font-size:12px;color:#667085;font-weight:700;white-space:nowrap;cursor:pointer;padding:0 4px;border-radius:6px;height:28px}
    .cc-nav-switch.is-active{color:#0070f4;background:#e8f3ff}
    .cc-board-view[hidden]{display:none!important}
    .cc-board-section{display:grid;gap:10px;margin-bottom:22px}
    .cc-board-section:last-child{margin-bottom:0}
    .cc-board-title{margin:0;font-size:14px;font-weight:800;color:#111827}
    .cc-board-section .cc-board{min-width:980px}
    .cc-board-section.cc-month-section .cc-board{min-width:700px}
    @media (max-width: 760px){
      .cc-page{padding:12px}
      .cc-toolbar{align-items:stretch}
      .cc-field,.cc-select{width:100%;min-width:0}
      .cc-week-label{margin-left:0;width:100%}
      .cc-dialog-body{grid-template-columns:1fr}
      .cc-dialog-body .span-2{grid-column:auto}
      .cc-pay-grid{grid-template-columns:1fr}
      .cc-pay-grid .span-2{grid-column:auto}
    }
  </style>
</head>
<body>
