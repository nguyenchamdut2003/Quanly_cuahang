            <td>${escapeHtml(formatPayrollMonth(item.thang_bang_luong) || item.thang_text || '')}</td>
            <td class="cc-payroll-detail">${renderPayrollDayDetails(item)}${warnHtml}</td>
            <td>${escapeHtml(moneyText(item.luong_theo_thang))}</td>
            <td>${escapeHtml(moneyText(item.tong_luong || 0))}</td>
            <td>${escapeHtml(moneyText(item.con_can_tra != null ? item.con_can_tra : item.tong_tien))}</td>
            <td>${escapeHtml(moneyText(item.da_tra || 0))}</td>
