      }

      function buildMonthBoardHtml(months) {
        if (!Array.isArray(months) || !months.length) {
          return '<div class="cc-empty">Chưa có dữ liệu tháng.</div>';
        }
        return '<div class="cc-board">' + months.map(function(month) {
          return `
            <div class="cc-day cc-month" data-month="${escapeHtml(month.key)}">
              <div class="cc-day-head">
                <div class="cc-day-title">
                  <span>${escapeHtml(month.label)}</span>
                  <span>${payrollWarningButton(month.payroll)}${month.is_current ? '<span class="cc-today">Tháng này</span>' : ''}</span>
                </div>
                <div class="cc-day-date">${escapeHtml(month.key)}</div>
              </div>
              <div class="cc-day-body">
                <label class="cc-check">
                  <input class="cc-dong-y-thang" type="checkbox" ${month.dong_y ? 'checked' : ''}>
                  <span>Đồng ý tháng này</span>
                </label>
                <label>Ghi chú
                  <textarea class="cc-note cc-ghi-chu-thang">${escapeHtml(month.ghi_chu || '')}</textarea>
                </label>
              </div>
            </div>
          `;
        }).join('') + '</div>';
      }

      function buildDayBoardHtml(days) {
        if (!Array.isArray(days) || !days.length) {
          return '<div class="cc-empty">Chưa có dữ liệu ngày.</div>';
        }
        const groups = {};
        days.forEach(function(day, index) {
          const weekIndex = Number(day.week_index || Math.floor(index / 7) + 1);
          if (!groups[weekIndex]) groups[weekIndex] = [];
          groups[weekIndex].push(day);
        });
        return Object.keys(groups).sort(function(a, b) { return Number(a) - Number(b); }).map(function(weekIndex) {
          return '<section class="cc-board-section"><h3 class="cc-board-title">Tuần ' + escapeHtml(weekIndex) + '</h3><div class="cc-board">' + groups[weekIndex].map(function(day) {
            const totalCong = Number(day.so_cong != null ? day.so_cong : dayWorkUnits(day));
            return `
              <div class="cc-day" data-date="${escapeHtml(day.key)}">
                <div class="cc-day-head">
                  <div class="cc-day-title">
                    <span>${escapeHtml(day.label)}</span>
                    <span class="cc-day-top-actions">
                      <label class="cc-overtime-day-toggle" title="tick ngày này làm tăng ca sẽ tính công theo công tăng ca">
                        <input class="cc-tick-tang-ca" type="checkbox" aria-label="Tick ngày này làm tăng ca" ${day.tick_tang_ca ? 'checked' : ''}>
                        <span class="cc-overtime-day-switch" aria-hidden="true"></span>
                      </label>
                      ${payrollWarningButton(day.payroll)}${day.is_today ? '<span class="cc-today">Hôm nay</span>' : ''}
                    </span>
                  </div>
                  <div class="cc-day-date">${escapeHtml(day.day)}</div>
                </div>
                <div class="cc-day-body">
                  <div class="cc-shift-list">
                    <label class="cc-check">
                      <input class="cc-ca-sang" type="checkbox" ${day.ca_sang ? 'checked' : ''}>
                      <span>Ca sáng (0.5 công)</span>
                    </label>
                    <label class="cc-check">
                      <input class="cc-ca-chieu" type="checkbox" ${day.ca_chieu ? 'checked' : ''}>
                      <span>Ca chiều (0.5 công)</span>
                    </label>
                  </div>
                  <label>Tăng ca
                    <input class="cc-overtime-input cc-tang-ca-cong" type="text" inputmode="decimal" value="${escapeHtml(workUnitText(day.tang_ca_cong || 0))}" placeholder="0">
                  </label>
                  <div class="cc-work-unit">Tổng: ${escapeHtml(workUnitText(totalCong))} công</div>
                  <label>Ghi chú
                    <textarea class="cc-note">${escapeHtml(day.ghi_chu || '')}</textarea>
                  </label>
                </div>
              </div>
            `;
          }).join('') + '</div></section>';
        }).join('');
      }

      function renderDayBoard(days) {
        currentDays = days || [];
        currentMonths = [];
        if (!employeeSelect.value) {
          boardWrap.innerHTML = '<div class="cc-empty">Chọn nhân viên để chấm công tháng hiện tại.</div>';
          return;
        }
        boardWrap.innerHTML = buildDayBoardHtml(currentDays);
      }

      function renderMonthBoard(months) {
        currentMonths = months || [];
        currentDays = [];
        if (!employeeSelect.value) {
          boardWrap.innerHTML = '<div class="cc-empty">Chọn nhân viên để chấm công.</div>';
          return;
        }
        boardWrap.innerHTML = buildMonthBoardHtml(currentMonths);
      }

      function renderDualBoard(days, months) {
        renderDualBoardView(days, months, dualBoardView);
      }

      function renderAttendanceMonth() {
        monthStart = monthStart || formatMonth(new Date());
        weekStart = firstDayOfMonth(monthStart);
        currentMode = 'ngay';
        dualBoardView = 'thang';
        hasDualSalary = false;
        currentMonths = [];
        currentDays = applyAutoSundayOvertime(buildMonthDayRows(monthStart));
        if (weekNav) weekNav.hidden = true;
        if (monthNav) monthNav.hidden = false;
        if (viewWeekBtn) viewWeekBtn.classList.remove('is-active');
        if (viewMonthBtn) viewMonthBtn.classList.add('is-active');
        if (thisWeekBtn) thisWeekBtn.textContent = formatPayrollMonth(monthStart);
        if (thisMonthBtn) thisMonthBtn.textContent = formatPayrollMonth(monthStart);
        weekLabel.textContent = '';
        renderDayBoard(currentDays);
      }

      async function loadWeek(options) {
        options = options || {};
        const employeeId = employeeSelect.value;
        if (!options.keepStatus) setStatus('');
        if (!employeeId) {
          monthStart = monthStart || formatMonth(new Date());
          if (weekNav) weekNav.hidden = true;
          if (monthNav) monthNav.hidden = false;
          if (viewWeekBtn) viewWeekBtn.classList.remove('is-active');
          if (viewMonthBtn) viewMonthBtn.classList.add('is-active');
          weekLabel.textContent = '';
          if (thisMonthBtn) thisMonthBtn.textContent = formatPayrollMonth(monthStart);
          boardWrap.innerHTML = '<div class="cc-empty">Chọn nhân viên để chấm công tháng hiện tại.</div>';
          dualBoardView = 'thang';
          hasDualSalary = false;
          return false;
        }
        renderAttendanceMonth();
        try {
          const params = new URLSearchParams({
            nhan_vien_id: employeeId,
            thang: monthStart || formatMonth(new Date())
          });
          const json = await fetchJson('/chamcongmoi/api/tuan?' + params.toString(), {
            headers: { 'Accept': 'application/json' },
            credentials: 'same-origin'
          });
          if (!json.success) {
            if (!options.silent) setStatus(json.message || 'Không tải được chấm công', 'error');
            return false;
          }
          const savedMap = {};
          (json.days || []).forEach(function(row) {
            if (row && row.ngay_cham_cong) savedMap[row.ngay_cham_cong] = row;
          });
          currentDays = (currentDays || []).map(function(day) {
            const row = savedMap[day.key];
            if (!row) return day;
            return Object.assign({}, day, {
              ca_sang: !!row.ca_sang,
              ca_chieu: !!row.ca_chieu,
              tick_tang_ca: !!row.tick_tang_ca,
              tang_ca_cong: parseWorkUnitInput(row.tang_ca_cong || row.cong_tang_ca || 0),
              ghi_chu: row.ghi_chu || '',
              so_cong: row.so_cong,
              payroll: row.payroll || null
            });
          });
          currentDays = applyAutoSundayOvertime(currentDays);
          renderDayBoard(currentDays);
          return true;
        } catch (error) {
          if (!options.silent) setStatus('Không tải được chấm công: ' + (error && error.message ? error.message : error), 'error');
          return false;
        }
      }

      async function saveWeek() {
        const employeeId = employeeSelect.value;
        if (!employeeId) {
          setStatus('Chọn nhân viên trước khi lưu.', 'error');
          return;
        }
        setSaveLoading(true);
        setStatus('Đang lưu chấm công...', '');
        try {
          let payload;
          if (currentMode === 'thang') {
            payload = {
              nhan_vien_id: employeeId,
              mode: 'thang',
              months: collectMonthRows()
            };
          } else if (isDualAttendanceMode()) {
            const dualPayload = collectDualSavePayload();
            const invalidDay = dualPayload.days.find(function(row) {
              return false;
            });
            if (invalidDay) {
              setStatus('Ngày ' + invalidDay.ngay_cham_cong + ' thiếu giờ vào/ra hợp lệ.', 'error');
              return;
            }
            payload = {
              nhan_vien_id: employeeId,
              mode: 'ca_hai',
              days: dualPayload.days,
              months: dualPayload.months
            };
          } else {
            const days = collectDayRows();
            const invalidDay = days.find(function(row) {
              return false;
            });
            if (invalidDay) {
              setStatus('Ngày ' + invalidDay.ngay_cham_cong + ' thiếu giờ vào/ra hợp lệ.', 'error');
              return;
            }
            payload = { nhan_vien_id: employeeId, days: days };
          }

          const json = await fetchJson('/chamcongmoi/api/tuan', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            credentials: 'same-origin',
            body: JSON.stringify(payload)
          });
          if (!json.success) {
            setStatus(json.message || 'Lưu chấm công thất bại', 'error');
            return;
          }
          const savedCount = Number(json.saved != null ? json.saved : 0);
          const statusType = 'ok';
          let countLabel = '';
          if (isDualAttendanceMode()) {
            const parts = [];
            const savedDays = Number(json.saved_days != null ? json.saved_days : 0);
            const savedMonths = Number(json.saved_months != null ? json.saved_months : 0);
            if (savedDays) parts.push(savedDays + ' ngày');
            if (savedMonths) parts.push(savedMonths + ' tháng');
            countLabel = parts.length ? (' (' + parts.join(', ') + ').') : (savedCount ? (' (' + savedCount + ' mục).') : '');
          } else {
            const unitLabel = currentMode === 'thang' ? 'tháng' : 'ngày';
            countLabel = savedCount ? (' (' + savedCount + ' ' + unitLabel + ').') : '';
          }
          const statusMessage = saveStatusText(json.warnings) + countLabel;
          setStatus(statusMessage, statusType);
          await Promise.all([
            loadWeek({ keepStatus: true, silent: true }),
            loadPayrollTable(null, { silent: true })
          ]);
        } catch (error) {
          setStatus('Lưu chấm công thất bại: ' + (error && error.message ? error.message : error), 'error');
        } finally {
          setSaveLoading(false);
        }
      }

