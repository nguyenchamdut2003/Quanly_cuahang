      async function openPayrollDetailModal(payrollId) {
        if (!payrollId) return;
        const item = payrollItemsById[String(payrollId)] || {};
        if (payrollDetailBody) {
          payrollDetailBody.innerHTML = '<div class="span-2 cc-empty">Đang tải thông tin...</div>';
        }
        payrollDetailModal?.classList.add('is-open');
        try {
          const preview = await fetchJson('/chamcongmoi/api/bang-luong/' + encodeURIComponent(payrollId) + '/thanh-toan', {
            headers: { 'Accept': 'application/json' },
            credentials: 'same-origin'
          });
          if (!preview.success) {
            if (payrollDetailBody) payrollDetailBody.innerHTML = '<div class="span-2 cc-pay-error">' + escapeHtml(preview.message || 'Không tải được chi tiết bảng lương.') + '</div>';
            return;
          }
          if (payrollDetailBody) payrollDetailBody.innerHTML = renderPayrollDetailModal(item, preview);
        } catch (error) {
          if (payrollDetailBody) payrollDetailBody.innerHTML = '<div class="span-2 cc-pay-error">Không tải được chi tiết bảng lương.</div>';
        }
      }

      function renderPayrollPaymentLines(lines) {
        const wrap = document.getElementById('ccPayLines');
        if (!wrap) return;
        wrap.innerHTML = renderPayrollLines({ payroll_lines: lines || [] });
      }

      function renderPayrollTransferBooks(books) {
        const select = document.getElementById('ccPayTransferBook');
        if (!select) return;
        select.innerHTML = '<option value="">— Chọn tài khoản chuyển khoản —</option>' + (books || []).map(function(item) {
          return '<option value="' + escapeHtml(item._id || '') + '">' + escapeHtml(item.ten_so_quy || item.ma_so_quy || 'Sổ quỹ') + '</option>';
        }).join('');
        if (select.options[0]) select.options[0].textContent = '\u2014 Ch\u1ecdn s\u1ed5 chuy\u1ec3n kho\u1ea3n \u2014';
      }

      function splitPayrollAmountEvenly(due) {
        const amount = Math.max(0, Math.floor(Number(due || 0)));
        if (!amount) return { tien_mat: 0, chuyen_khoan: 0 };
        const tien_mat = Math.floor(amount / 2);
        const chuyen_khoan = amount - tien_mat;
        return { tien_mat: tien_mat, chuyen_khoan: chuyen_khoan };
      }

      async function openPayrollPayModal(payrollId) {
        const preview = await fetchJson('/chamcongmoi/api/bang-luong/' + encodeURIComponent(payrollId) + '/thanh-toan', {
          headers: { 'Accept': 'application/json' },
          credentials: 'same-origin'
        });
        if (!preview.success) {
          setStatus(preview.message || 'Không tải được thông tin thanh toán', 'error');
          return;
        }
        if (preview.da_thanh_toan) {
          setStatus('Bảng lương đã được thanh toán.', 'ok');
          await loadPayrollTable();
          return;
        }
        pendingPayrollPayId = payrollId;
        pendingPayrollPayDue = Math.max(0, Number(preview.con_thanh_toan || 0));
        payrollPayCashBookId = '';
        const dueEl = document.getElementById('ccPayDue');
        const cashEl = document.getElementById('ccPayCash');
        const transferEl = document.getElementById('ccPayTransfer');
        const splitAmount = splitPayrollAmountEvenly(pendingPayrollPayDue);
        if (dueEl) dueEl.textContent = moneyTextVnd(pendingPayrollPayDue);
        renderPayrollPaymentLines(preview.payroll_lines || []);
        if (cashEl) {
          cashEl.value = splitAmount.tien_mat > 0 ? formatMoneyInput(splitAmount.tien_mat) : '';
          bindMoneyInput(cashEl);
        }
        if (transferEl) {
          transferEl.value = splitAmount.chuyen_khoan > 0 ? formatMoneyInput(splitAmount.chuyen_khoan) : '';
          bindMoneyInput(transferEl);
        }
        refreshPayrollPaymentSummary();
        payrollPayModal.classList.add('is-open');
        const cashBooks = await loadPayrollPayBooks('tien_mat');
        payrollPayCashBookId = renderPayrollCashBooks(cashBooks);
        const transferBooks = await loadPayrollPayBooks('chuyen_khoan');
        renderPayrollTransferBooks(transferBooks);
        if (splitAmount.chuyen_khoan > 0) {
          const transferSelect = document.getElementById('ccPayTransferBook');
          if (transferSelect && transferBooks.length) {
            const defaultBook = transferBooks.find(function(item) { return !!item.mac_dinh; }) || transferBooks[0];
            if (defaultBook && defaultBook._id) transferSelect.value = String(defaultBook._id);
          }
        }
        refreshPayrollPaymentSummary();
      }

      function closePayrollPayModal() {
        pendingPayrollPayId = '';
        pendingPayrollPayDue = 0;
        payrollPayCashBookId = '';
        renderPayrollPaymentLines([]);
        payrollPayModal.classList.remove('is-open');
      }

      async function submitPayrollPayModal() {
        const payment = readPayrollPaymentInput();
        if (!pendingPayrollPayId) return;
        if (payment.tong_chi <= 0) {
          setStatus('Vui lòng nhập số tiền thanh toán.', 'error');
          return;
        }
        if (payment.tong_chi > pendingPayrollPayDue) {
          setStatus('Số tiền thanh toán không được vượt ' + moneyText(pendingPayrollPayDue) + ' đ.', 'error');
          return;
        }
        const cashBookId = payment.tien_mat > 0
          ? String(document.getElementById('ccPayCashBook')?.value || '').trim()
          : '';
        if (payment.tien_mat > 0 && !cashBookId) {
          setStatus('Chưa có sổ tiền mặt active để chi lương.', 'error');
          return;
        }
        const bankBookId = payment.chuyen_khoan > 0
          ? String(document.getElementById('ccPayTransferBook')?.value || '').trim()
          : '';
        if (payment.chuyen_khoan > 0 && !bankBookId) {
          setStatus('Vui lòng chọn sổ quỹ cho tiền chuyển khoản.', 'error');
          return;
        }
        const submitBtn = document.getElementById('ccPaySubmit');
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.textContent = 'Đang thanh toán...';
        }
        try {
          const json = await fetchJson('/chamcongmoi/api/bang-luong/' + encodeURIComponent(pendingPayrollPayId) + '/phieu-chi', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            credentials: 'same-origin',
            body: JSON.stringify({
              tien_mat: payment.tien_mat,
              chuyen_khoan: payment.chuyen_khoan,
              so_quy_tien_mat_id: cashBookId,
              so_quy_chuyen_khoan_id: bankBookId
            })
          });
          if (!json.success) {
            setStatus(json.message || 'Không tạo được phiếu chi', 'error');
            return;
          }
          closePayrollPayModal();
          setStatus((json.message || 'Đã thanh toán') + (json.receipt && json.receipt.ma_phieu ? (' (' + json.receipt.ma_phieu + ').') : '.'), 'ok');
          await Promise.all([
            loadPayrollTable(),
            loadPaidPayrollTable({ silent: true })
          ]);
        } catch (error) {
          setStatus('Không tạo được phiếu chi: ' + (error && error.message ? error.message : error), 'error');
        } finally {
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = 'Thanh toán';
          }
        }
      }

      async function deletePayroll(payrollId, payrollCode, mode) {
        payrollId = String(payrollId || '').trim();
        if (!payrollId) return;
        const label = payrollCode ? (' ' + payrollCode) : '';
        if (!window.confirm('Xóa bảng lương' + label + '?')) return;
        try {
          const json = await fetchJson('/chamcongmoi/api/bang-luong/' + encodeURIComponent(payrollId), {
            method: 'DELETE',
            headers: { 'Accept': 'application/json' },
            credentials: 'same-origin'
          });
          if (!json.success) {
            setStatus(json.message || 'Không xóa được bảng lương', 'error');
            return;
          }
          setStatus(json.message || 'Đã xóa bảng lương.', 'ok');
          if (mode === 'paid') {
            await loadPaidPayrollTable({ silent: true });
          } else {
            await loadPayrollTable(null, { silent: true });
          }
          await loadWeek({ keepStatus: true, silent: true });
          setStatus('');
        } catch (error) {
          setStatus('Không xóa được bảng lương: ' + (error && error.message ? error.message : error), 'error');
        }
      }

      function renderPayrollDayDetails(item) {
        const days = Array.isArray(item.chi_tiet_ngay_cong) ? item.chi_tiet_ngay_cong : [];
        if (!days.length) {
          if (item.loai_luong === 'thang' && Number(item.so_thang_cong || 0) > 0) {
            return '<div class="cc-payroll-day-lines"><div class="cc-payroll-day-summary"><div><strong>Ngày công: ' + escapeHtml(item.so_thang_cong || 0) + '</strong><div class="cc-payroll-day-range">Cả tháng</div></div></div></div>';
          }
          return '---';
        }
        const firstDay = days[0] || {};
        const lastDay = days[days.length - 1] || {};
        const rangeText = days.length === 1
          ? (firstDay.ngay_hien_thi || firstDay.ngay || '---')
          : ((firstDay.ngay_hien_thi || firstDay.ngay || '---') + ' - ' + (lastDay.ngay_hien_thi || lastDay.ngay || '---'));
        const detailHtml = days.map(function(day) {
          const shifts = [];
          if (day.ca_sang) shifts.push('Ca sáng');
          if (day.ca_chieu) shifts.push('Ca chiều');
          if (day.tick_tang_ca) shifts.push('Tinh tang ca');
          if (Number(day.tang_ca_cong || 0) > 0) shifts.push('Tăng ca ' + workUnitText(day.tang_ca_cong));
          const soCong = day.so_cong != null ? workUnitText(day.so_cong) : workUnitText(dayWorkUnits(day));
          const timeText = (shifts.length ? shifts.join(', ') : '---') + ' | ' + soCong + ' công';
          const noteHtml = day.ghi_chu
            ? ('<span class="cc-payroll-day-note">' + escapeHtml(day.ghi_chu) + '</span>')
            : '';
          return '<div class="cc-payroll-day-line"><div><strong>' + escapeHtml(day.ngay_hien_thi || day.ngay || '---') + '</strong>' + noteHtml + '</div><span>' + escapeHtml(timeText) + '</span></div>';
        }).join('');
        return '<div class="cc-payroll-day-lines">'
          + '<div class="cc-payroll-day-summary"><div><strong>Ngày công: ' + escapeHtml(workUnitText(item.so_ngay_cong || 0)) + '</strong><div class="cc-payroll-day-range">' + escapeHtml(rangeText) + '</div></div><button type="button" class="cc-payroll-toggle" aria-label="Xem chi tiết ngày công">v</button></div>'
          + '<div class="cc-payroll-day-details" hidden>' + detailHtml + '</div>'
          + '</div>';
      }

      async function loadPayrollTable(highlightPayrollId, options) {
        options = options || {};
        const params = new URLSearchParams();
        const payrollEmployeeId = document.getElementById('ccPayrollEmployee').value;
        const payrollStatus = document.getElementById('ccPayrollStatusHeader')?.value || 'all';
        if (payrollEmployeeId) params.set('nhan_vien_id', payrollEmployeeId);
        if (payrollStatus) params.set('trang_thai', payrollStatus);
        if (!options.silent) setTableLoading(payrollRows, 11, 'Đang tải bảng lương...');
        const json = await fetchJson('/chamcongmoi/api/bang-luong?' + params.toString(), {
          headers: { 'Accept': 'application/json' },
          credentials: 'same-origin'
        });
        if (!json.success) {
          if (!options.silent) setStatus(json.message || 'Không tải được bảng lương', 'error');
          return false;
        }
        if (!json.items.length) {
          const emptyMessage = 'Chưa có bảng lương.';
          payrollRows.innerHTML = '<tr><td colspan="11" class="cc-empty">' + escapeHtml(emptyMessage) + '</td></tr>';
          return true;
        }
        payrollRows.innerHTML = json.items.map(function(item) {
          return renderPayrollTableRow(item, item.da_thanh_toan ? 'paid' : 'pending');
        }).join('');
        if (highlightPayrollId) {
          const row = payrollRows.querySelector('[data-payroll-id="' + cssEscape(highlightPayrollId) + '"]');
          if (row) {
            row.classList.add('cc-row-highlight');
            row.scrollIntoView({ behavior: 'smooth', block: 'center' });
          }
        }
        return true;
      }

      function highlightPayrollRow(payrollId, tableBody) {
        if (!payrollId || !tableBody) return;
        const safeId = cssEscape(payrollId);
        const row = tableBody.querySelector('[data-payroll-id="' + safeId + '"]')
          || tableBody.querySelector('[data-payroll-code="' + safeId + '"]');
        if (!row) return;
        row.classList.add('cc-row-highlight');
        row.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }

      async function loadPaidPayrollTable(options) {
        options = options || {};
