      function fillEmployeeForm(item) {
        item = item || {};
        employeeEditId = item._id ? String(item._id) : '';
        document.getElementById('ccEmployeeModalTitle').textContent = employeeEditId ? 'Sửa nhân viên' : 'Thêm nhân viên';
        document.getElementById('ccFormName').value = item.ten_nhan_vien || '';
        document.getElementById('ccFormPhone').value = item.sdt || '';
        document.getElementById('ccFormEmail').value = item.email || '';
        document.getElementById('ccFormCccd').value = item.cccd || '';
        document.getElementById('ccFormBirth').value = item.ngay_sinh_input || '';
        document.getElementById('ccFormGender').value = item.gioi_tinh || '';
        document.getElementById('ccFormRole').value = item.chuc_vu || '';
        document.getElementById('ccFormDepartment').value = item.phong_ban_id || '';
        document.getElementById('ccFormPosition').value = item.chuc_danh_id || '';
        document.getElementById('ccFormStart').value = item.ngay_bat_dau_lam_viec_input || '';
        const salaryType = item.loai_luong || (item.co_luong_theo_thang === true || Number(item.luong_theo_thang || 0) > 0 ? 'thang' : 'ngay');
        document.getElementById('ccFormHasDaySalary').checked = salaryType !== 'thang';
        document.getElementById('ccFormDaySalary').value = formatMoneyInput(item.luong_theo_ngay || 0);
        document.getElementById('ccFormHasMonthSalary').checked = salaryType === 'thang';
        document.getElementById('ccFormMonthSalary').value = formatMoneyInput(item.luong_theo_thang || 0);
        const salary = item.luong || {};
        document.getElementById('ccSalaryMonth').value = formatMoneyInput(salary.luong_thang || item.luong_theo_thang || 0);
        document.getElementById('ccWorkDaysInMonth').value = salary.so_ngay_cong_trong_thang || 26;
        document.querySelectorAll('.cc-contribution-enabled').forEach(function(input) {
          input.checked = (salary.khoan_nop_ids || []).map(String).includes(String(input.value));
        });
        document.querySelectorAll('.cc-allowance-item').forEach(function(row) {
          row.querySelector('.cc-allowance-enabled').checked = false;
          row.querySelector('.cc-allowance-type').value = 'co_dinh_thang';
          row.querySelector('.cc-allowance-amount').value = '0';
        });
        (item.phu_caps || []).forEach(function(row) {
          const allowanceRow = document.querySelector('.cc-allowance-item[data-allowance-id="' + cssEscape(row.danh_muc_phu_cap_id) + '"]');
          if (!allowanceRow) return;
          allowanceRow.querySelector('.cc-allowance-enabled').checked = true;
          allowanceRow.querySelector('.cc-allowance-type').value = row.kieu_tinh || 'co_dinh_thang';
          allowanceRow.querySelector('.cc-allowance-amount').value = formatMoneyInput(row.muc_phu_cap || 0);
        });
        document.getElementById('ccFormStatus').value = item.trang_thai || 'active';
        document.getElementById('ccFormNote').value = item.ghi_chu || '';
        syncSalaryInputs();
      }

      function collectEmployeePayload() {
        const hasDaySalary = document.getElementById('ccFormHasDaySalary').checked;
        const hasMonthSalary = document.getElementById('ccFormHasMonthSalary').checked;
        return {
          ten_nhan_vien: document.getElementById('ccFormName').value.trim(),
          sdt: document.getElementById('ccFormPhone').value.trim(),
          email: document.getElementById('ccFormEmail').value.trim(),
          cccd: document.getElementById('ccFormCccd').value.trim(),
          ngay_sinh: document.getElementById('ccFormBirth').value,
          gioi_tinh: document.getElementById('ccFormGender').value,
          chuc_vu: document.getElementById('ccFormRole').value.trim(),
          phong_ban_id: document.getElementById('ccFormDepartment').value,
          chuc_danh_id: document.getElementById('ccFormPosition').value,
          ngay_bat_dau_lam_viec: document.getElementById('ccFormStart').value,
          loai_luong: hasMonthSalary ? 'thang' : 'ngay',
          co_luong_theo_ngay: hasDaySalary,
          luong_theo_ngay: hasDaySalary ? parseMoneyInput(document.getElementById('ccFormDaySalary').value) : 0,
          co_luong_theo_thang: hasMonthSalary,
          luong_theo_thang: hasMonthSalary ? parseMoneyInput(document.getElementById('ccFormMonthSalary').value) : 0,
          luong: {
            luong_thang: parseMoneyInput(document.getElementById('ccSalaryMonth').value),
            so_ngay_cong_trong_thang: Number(document.getElementById('ccWorkDaysInMonth').value || 0),
            khoan_nop_ids: Array.prototype.slice.call(document.querySelectorAll('.cc-contribution-enabled:checked')).map(function(input) { return input.value; }),
            tu_ngay: document.getElementById('ccFormStart').value
          },
          phu_caps: Array.prototype.slice.call(document.querySelectorAll('.cc-allowance-item')).filter(function(row) {
            return row.querySelector('.cc-allowance-enabled')?.checked;
          }).map(function(row) {
            return {
              danh_muc_phu_cap_id: row.dataset.allowanceId || '',
              kieu_tinh: row.querySelector('.cc-allowance-type')?.value || 'co_dinh_thang',
              muc_phu_cap: parseMoneyInput(row.querySelector('.cc-allowance-amount')?.value || 0)
            };
          }),
          trang_thai: document.getElementById('ccFormStatus').value,
          ghi_chu: document.getElementById('ccFormNote').value.trim()
        };
      }

      async function openEmployeeModal(id) {
        setStatus('');
        if (!id) {
          fillEmployeeForm({});
          modal.classList.add('is-open');
          document.getElementById('ccFormName').focus();
          return;
        }
        const json = await fetchJson('/chamcongmoi/api/nhan-vien/' + encodeURIComponent(id), {
          headers: { 'Accept': 'application/json' },
          credentials: 'same-origin'
        });
        if (!json.success) {
          setStatus(json.message || 'Không tải được nhân viên', 'error');
          return;
        }
        fillEmployeeForm(json.item);
        modal.classList.add('is-open');
      }

      async function saveEmployee() {
        const payload = collectEmployeePayload();
        if (!payload.ten_nhan_vien) {
          setStatus('Tên nhân viên là bắt buộc.', 'error');
          return;
        }
        const url = employeeEditId
          ? '/chamcongmoi/api/nhan-vien/' + encodeURIComponent(employeeEditId)
          : '/chamcongmoi/api/nhan-vien';
        const json = await fetchJson(url, {
          method: employeeEditId ? 'PUT' : 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify(payload)
        });
        if (!json.success) {
          setStatus(json.message || 'Lưu nhân viên thất bại', 'error');
          return;
        }
        modal.classList.remove('is-open');
        await refreshEmployees(json.item._id);
        await loadEmployeeTable();
        await loadWeek();
        setStatus('Đã lưu nhân viên.', 'ok');
      }

      async function deleteEmployee(id) {
        if (!confirm('Chuyển nhân viên sang trạng thái đã nghỉ?')) return;
        const json = await fetchJson('/chamcongmoi/api/nhan-vien/' + encodeURIComponent(id) + '/trang-thai', {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify({ trang_thai: 'inactive' })
        });
        if (!json.success) {
          setStatus(json.message || 'Không cập nhật được nhân viên', 'error');
          return;
        }
        await refreshEmployees();
        await loadEmployeeTable();
        if (employeeSelect.value === String(id)) {
          employeeSelect.value = '';
        }
        setStatus('Đã chuyển nhân viên sang trạng thái đã nghỉ.', 'ok');
      }

      document.querySelectorAll('.detail-tab[data-tab]').forEach(btn => btn.addEventListener('click', () => switchTab(btn.dataset.tab)));
      employeeSelect.addEventListener('change', loadWeek);
      boardWrap.addEventListener('click', function(event) {
        const warningBtn = event.target.closest('.cc-payroll-warning');
        if (!warningBtn) return;
        document.getElementById('ccPayrollEmployee').value = employeeSelect.value;
        switchTab('payroll', true);
        loadPayrollTable(warningBtn.dataset.payrollId || '');
      });
      function refreshDayWorkUnit(dayEl) {
        if (!dayEl) return;
        const caSang = !!(dayEl.querySelector('.cc-ca-sang') && dayEl.querySelector('.cc-ca-sang').checked);
        const caChieu = !!(dayEl.querySelector('.cc-ca-chieu') && dayEl.querySelector('.cc-ca-chieu').checked);
        const tangCaInput = dayEl.querySelector('.cc-tang-ca-cong');
        const total = (caSang ? 0.5 : 0) + (caChieu ? 0.5 : 0) + parseWorkUnitInput(tangCaInput ? tangCaInput.value : '');
        const totalEl = dayEl.querySelector('.cc-work-unit');
        if (totalEl) totalEl.textContent = 'Tổng: ' + workUnitText(total) + ' công';
      }
      boardWrap.addEventListener('change', function(event) {
        if (!event.target.closest('.cc-ca-sang,.cc-ca-chieu,.cc-tang-ca-cong,.cc-tick-tang-ca')) return;
        refreshDayWorkUnit(event.target.closest('.cc-day[data-date]'));
      });
      boardWrap.addEventListener('input', function(event) {
        if (!event.target.closest('.cc-tang-ca-cong')) return;
        refreshDayWorkUnit(event.target.closest('.cc-day[data-date]'));
      });
      boardWrap.addEventListener('focusin', function(event) {
        if (!event.target.closest('.cc-tang-ca-cong')) return;
        if (parseWorkUnitInput(event.target.value) === 0) event.target.value = '';
      });
      boardWrap.addEventListener('focusout', function(event) {
        if (!event.target.closest('.cc-tang-ca-cong')) return;
        event.target.value = workUnitText(event.target.value);
        refreshDayWorkUnit(event.target.closest('.cc-day[data-date]'));
      });
      document.getElementById('ccSave').addEventListener('click', saveWeek);
      document.getElementById('ccBulkAttendanceOpen')?.addEventListener('click', function() {
        document.querySelectorAll('.cc-bulk-attendance-option').forEach(function(input) {
          input.checked = false;
        });
        if (bulkAttendanceStatus) bulkAttendanceStatus.textContent = '';
        bulkAttendanceModal?.classList.add('is-open');
      });
      document.getElementById('ccBulkAttendanceClose')?.addEventListener('click', function() {
        bulkAttendanceModal?.classList.remove('is-open');
      });
      bulkAttendanceModal?.addEventListener('click', function(event) {
        if (event.target === bulkAttendanceModal) bulkAttendanceModal.classList.remove('is-open');
      });
      document.querySelectorAll('.cc-bulk-attendance-option').forEach(function(input) {
        input.addEventListener('change', function() {
          if (!input.checked) return;
          applyBulkAttendanceAction(input.value || '');
        });
      });
      if (viewWeekBtn) {
        viewWeekBtn.addEventListener('click', function(event) {
          event.preventDefault();
          dualBoardView = 'thang';
          loadWeek();
        });
      }
      if (viewMonthBtn) {
        viewMonthBtn.addEventListener('click', function(event) {
          event.preventDefault();
          dualBoardView = 'thang';
          loadWeek();
        });
      }
      document.getElementById('ccPrevWeek')?.addEventListener('click', function() {
        if (isDualAttendanceMode() && dualBoardView !== 'ngay') switchDualBoardView('ngay');
        monthStart = addMonths(monthStart || monthKeyFromDate(weekStart), -1);
        weekStart = firstDayOfMonth(monthStart);
        loadWeek();
      });
      document.getElementById('ccNextWeek')?.addEventListener('click', function() {
        if (isDualAttendanceMode() && dualBoardView !== 'ngay') switchDualBoardView('ngay');
        monthStart = addMonths(monthStart || monthKeyFromDate(weekStart), 1);
        weekStart = firstDayOfMonth(monthStart);
        loadWeek();
      });
      thisWeekBtn?.addEventListener('click', function() {
        if (isDualAttendanceMode() && dualBoardView !== 'ngay') switchDualBoardView('ngay');
        monthStart = formatMonth(new Date());
        weekStart = firstDayOfMonth(monthStart);
        loadWeek();
      });
      document.getElementById('ccPrevMonth').addEventListener('click', function() {
        monthStart = addMonths(monthStart || formatMonth(new Date()), -1);
        loadWeek();
      });
      document.getElementById('ccNextMonth').addEventListener('click', function() {
        monthStart = addMonths(monthStart || formatMonth(new Date()), 1);
        loadWeek();
      });
      thisMonthBtn.addEventListener('click', function() {
        monthStart = formatMonth(new Date());
        loadWeek();
      });
      document.getElementById('ccQuickAddEmployee').addEventListener('click', function() {
        openEmployeeModal('');
      });
      document.getElementById('ccAddEmployee').addEventListener('click', function() {
        openEmployeeModal('');
      });
      document.getElementById('ccEmployeeSearch').addEventListener('click', loadEmployeeTable);
      document.getElementById('ccEmployeeDepartmentFilter')?.addEventListener('change', loadEmployeeTable);
      document.getElementById('ccEmployeePositionFilter')?.addEventListener('change', loadEmployeeTable);
      document.getElementById('ccPayrollRefresh').addEventListener('click', loadPayrollTable);
      document.getElementById('ccPayrollEmployee').addEventListener('change', loadPayrollTable);
      document.getElementById('ccPayrollStatusHeader')?.addEventListener('change', loadPayrollTable);
      document.getElementById('ccPayrollPaidRefresh').addEventListener('click', loadPaidPayrollTable);
      document.getElementById('ccPayrollPaidEmployee').addEventListener('change', loadPaidPayrollTable);
      payrollRows.addEventListener('click', function(event) {
        const deleteBtn = event.target.closest('.cc-payroll-delete-btn');
        if (deleteBtn) {
          deletePayroll(deleteBtn.dataset.payrollId || '', deleteBtn.dataset.payrollCode || '', 'pending');
          return;
        }
        const viewBtn = event.target.closest('.cc-payroll-view-btn');
        if (viewBtn) {
          openPayrollDetailModal(viewBtn.dataset.payrollId || '');
          return;
        }
        const toggleBtn = event.target.closest('.cc-payroll-toggle');
        if (toggleBtn) {
          const wrap = toggleBtn.closest('.cc-payroll-day-lines');
          const detail = wrap ? wrap.querySelector('.cc-payroll-day-details') : null;
          if (detail) {
            const willOpen = detail.hidden;
            detail.hidden = !willOpen;
            toggleBtn.classList.toggle('is-open', willOpen);
            toggleBtn.textContent = willOpen ? '^' : 'v';
          }
          return;
        }
        const payBtn = event.target.closest('.cc-payroll-pay-btn');
        if (!payBtn) return;
        openPayrollPayModal(payBtn.dataset.payrollId || '');
      });
      payrollPaidRows.addEventListener('click', function(event) {
        const deleteBtn = event.target.closest('.cc-payroll-delete-btn');
        if (deleteBtn) {
          deletePayroll(deleteBtn.dataset.payrollId || '', deleteBtn.dataset.payrollCode || '', 'paid');
          return;
        }
        const viewBtn = event.target.closest('.cc-payroll-view-btn');
        if (viewBtn) {
          openPayrollDetailModal(viewBtn.dataset.payrollId || '');
          return;
        }
        const toggleBtn = event.target.closest('.cc-payroll-toggle');
        if (!toggleBtn) return;
        const wrap = toggleBtn.closest('.cc-payroll-day-lines');
        const detail = wrap ? wrap.querySelector('.cc-payroll-day-details') : null;
        if (!detail) return;
        const willOpen = detail.hidden;
        detail.hidden = !willOpen;
        toggleBtn.classList.toggle('is-open', willOpen);
        toggleBtn.textContent = willOpen ? '^' : 'v';
      });
      document.getElementById('ccPaySubmit').addEventListener('click', submitPayrollPayModal);
      document.getElementById('ccPayClose').addEventListener('click', closePayrollPayModal);
      payrollPayModal.addEventListener('click', function(event) {
        if (event.target === payrollPayModal) closePayrollPayModal();
      });
      document.getElementById('ccPayrollDetailClose')?.addEventListener('click', function() {
        payrollDetailModal?.classList.remove('is-open');
      });
      payrollDetailModal?.addEventListener('click', function(event) {
        if (event.target === payrollDetailModal) {
          payrollDetailModal.classList.remove('is-open');
          return;
        }
        const toggleBtn = event.target.closest('.cc-payroll-toggle');
        if (!toggleBtn) return;
        const wrap = toggleBtn.closest('.cc-payroll-day-lines');
        const detail = wrap ? wrap.querySelector('.cc-payroll-day-details') : null;
        if (!detail) return;
        const willOpen = detail.hidden;
        detail.hidden = !willOpen;
        toggleBtn.classList.toggle('is-open', willOpen);
        toggleBtn.textContent = willOpen ? '^' : 'v';
      });
      document.getElementById('ccAttendanceWarningClose')?.addEventListener('click', function() {
        attendanceWarningModal?.classList.remove('is-open');
      });
      attendanceWarningModal?.addEventListener('click', function(event) {
        if (event.target === attendanceWarningModal) attendanceWarningModal.classList.remove('is-open');
      });
      document.getElementById('ccAdvanceSubmit').addEventListener('click', submitAdvance);
      document.getElementById('ccAdvanceClose').addEventListener('click', function() {
        advanceModal.classList.remove('is-open');
      });
      advanceModal.addEventListener('click', function(event) {
        if (event.target === advanceModal) advanceModal.classList.remove('is-open');
      });
      bindMoneyInput(document.getElementById('ccAdvanceCashAmount'));
      bindMoneyInput(document.getElementById('ccAdvanceTransferAmount'));
      document.getElementById('ccEmployeeDetailClose')?.addEventListener('click', function() {
        employeeDetail?.classList.remove('is-open');
      });
      document.querySelectorAll('.cc-detail-tab[data-employee-detail-tab]').forEach(function(btn) {
        btn.addEventListener('click', function() {
          switchEmployeeDetailTab(btn.dataset.employeeDetailTab || 'info');
        });
      });
      ['ccPayCash', 'ccPayTransfer'].forEach(function(id) {
        const input = document.getElementById(id);
        if (!input) return;
        input.addEventListener('input', refreshPayrollPaymentSummary);
      });
      document.getElementById('ccFormHasDaySalary').addEventListener('change', syncSalaryInputs);
      document.getElementById('ccFormHasMonthSalary').addEventListener('change', syncSalaryInputs);
      bindMoneyInput(document.getElementById('ccFormDaySalary'));
      bindMoneyInput(document.getElementById('ccFormMonthSalary'));
      bindMoneyInput(document.getElementById('ccSalaryMonth'));
      document.querySelectorAll('.cc-allowance-amount').forEach(bindMoneyInput);
      document.getElementById('ccAllowanceList')?.addEventListener('change', function(event) {
        if (event.target.closest('.cc-allowance-enabled,.cc-allowance-type')) syncSalaryInputs();
      });
      document.getElementById('ccAllowanceList')?.addEventListener('input', function(event) {
        if (event.target.closest('.cc-allowance-amount')) refreshAllowancePreviews();
      });
      syncSalaryInputs();
      document.getElementById('ccEmployeeKeyword').addEventListener('keydown', function(event) {
        if (event.key === 'Enter') loadEmployeeTable();
      });
      employeeRows.addEventListener('click', function(event) {
        const row = event.target.closest('tr[data-id]');
        if (!row) return;
        if (event.target.closest('.cc-advance-employee')) {
          openAdvanceModal(row.dataset.id, row.dataset.label || '');
          return;
        }
        if (event.target.closest('.cc-edit-employee')) {
          openEmployeeModal(row.dataset.id);
          return;
        }
        if (event.target.closest('.cc-delete-employee')) {
          deleteEmployee(row.dataset.id);
          return;
        }
      });
      document.getElementById('ccCancelEmployee').addEventListener('click', function() {
        modal.classList.remove('is-open');
      });
      document.getElementById('ccSaveEmployee').addEventListener('click', saveEmployee);
      (async function initFromUrl() {
        const params = new URLSearchParams(location.search);
        const tab = params.get('tab');
        const bangLuong = params.get('bang_luong');
        const payrollStatus = params.get('trang_thai') || (tab === 'payroll-paid' ? 'da_thanh_toan' : '');
        if (payrollStatus && document.getElementById('ccPayrollStatusHeader')) {
          document.getElementById('ccPayrollStatusHeader').value = payrollStatus;
        }
        if (tab === 'payroll-paid') {
          switchTab('payroll', true);
          await loadPayrollTable(bangLuong || '');
          return;
        }
        if (tab === 'payroll') {
          switchTab('payroll', true);
          await loadPayrollTable(bangLuong || '');
          return;
        }
        if (tab === 'employees' || tab === 'departments' || tab === 'positions') {
          switchTab('employees', true);
          await loadEmployeeTable();
          return;
        }
        if (tab === 'contributions' || tab === 'allowances') {
          switchTab(tab, true);
          return;
        }
        loadWeek();
      })();
    })();
  </script>
</body>
</html>
