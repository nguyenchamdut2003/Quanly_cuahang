      function readPayrollPaymentInput() {
        const tien_mat = parseMoneyInput(document.getElementById('ccPayCash')?.value);
        const chuyen_khoan = parseMoneyInput(document.getElementById('ccPayTransfer')?.value);
        return {
          tien_mat: tien_mat,
          chuyen_khoan: chuyen_khoan,
          tong_chi: tien_mat + chuyen_khoan
        };
      }

      function refreshPayrollPaymentSummary() {
        const payment = readPayrollPaymentInput();
        const errors = [];
        if (payment.tong_chi <= 0) errors.push('Vui lòng nhập số tiền thanh toán');
        if (payment.tong_chi > pendingPayrollPayDue) errors.push('Tổng chi không được vượt số cần thanh toán');
        const totalEl = document.getElementById('ccPayTotal');
        const actualEl = document.getElementById('ccPayActual');
        const errWrap = document.getElementById('ccPayErrorWrap');
        const errEl = document.getElementById('ccPayErrors');
        if (totalEl) totalEl.textContent = moneyTextVnd(payment.tong_chi);
        if (actualEl) actualEl.textContent = moneyTextVnd(payment.tong_chi);
        if (errWrap && errEl) {
          if (errors.length) {
            errWrap.hidden = false;
            errEl.textContent = errors.join('. ');
          } else {
            errWrap.hidden = true;
            errEl.textContent = '';
          }
        }
      }

      async function loadPayrollPayBooks(type) {
        const json = await fetchJson('/api/so-quy/active?loai_so_quy=' + encodeURIComponent(type), {
          headers: { Accept: 'application/json' },
          credentials: 'same-origin'
        });
        if (!json.success) return [];
        return Array.isArray(json.items) ? json.items : (Array.isArray(json.data) ? json.data : []);
      }

      async function preparePayrollCashBook() {
        const books = await loadPayrollPayBooks('tien_mat');
        if (!books.length) return '';
        const defaults = books.filter(function(item) { return !!item.mac_dinh; });
        if (defaults.length) return String(defaults[0]._id || '');
        if (books.length === 1) return String(books[0]._id || '');
        return String(books[0]._id || '');
      }

      function renderPayrollCashBooks(books) {
        const select = document.getElementById('ccPayCashBook');
        if (!select) return '';
        select.innerHTML = '<option value="">— Chọn sổ tiền mặt —</option>' + (books || []).map(function(item) {
          return '<option value="' + escapeHtml(item._id || '') + '">' + escapeHtml(item.ten_so_quy || item.ma_so_quy || 'Sổ quỹ') + '</option>';
        }).join('');
        if (select.options[0]) select.options[0].textContent = '\u2014 Ch\u1ecdn s\u1ed5 ti\u1ec1n m\u1eb7t \u2014';
        const defaultBook = (books || []).find(function(item) { return !!item.mac_dinh; }) || (books || [])[0];
        if (defaultBook && defaultBook._id) select.value = String(defaultBook._id);
        return select.value || '';
      }

      function renderPayrollLines(item) {
        const lines = Array.isArray(item.payroll_lines) ? item.payroll_lines : [];
        if (!lines.length) return '';
        return '<div class="cc-payroll-lines">' + lines.filter(function(line) {
          return Number(line.amount || 0) !== 0 || line.type === 'subtotal' || line.type === 'total';
        }).map(function(line) {
          const type = line.type || 'plus';
          const cls = type === 'minus' ? 'is-minus' : (type === 'subtotal' ? 'is-subtotal' : (type === 'total' ? 'is-total' : 'is-plus'));
          const sign = type === 'minus' ? '- ' : (type === 'plus' ? '+ ' : '');
          const formula = line.formula || line.note || '';
          const note = formula ? '<small>' + escapeHtml(formula) + '</small>' : '';
          return '<div class="cc-payroll-line ' + cls + '"><span>' + escapeHtml(line.label || '') + note + '</span><b>' + sign + escapeHtml(moneyText(line.amount)) + '</b></div>';
        }).join('') + '</div>';
      }

      function renderPayrollReceiptDetail(item) {
        const receipt = item && item.phieu_chi ? item.phieu_chi : {};
        if (!receipt.ma_phieu) return '<div class="cc-payroll-pay-note">Chưa có phiếu chi.</div>';
        const receiptHref = receipt._id ? receiptDocHref(receipt._id) : '';
        const code = receiptHref
          ? '<a class="cc-ref-link" href="' + receiptHref + '">' + escapeHtml(receipt.ma_phieu) + '</a>'
          : escapeHtml(receipt.ma_phieu);
        return '<div class="cc-payroll-lines">'
          + '<div class="cc-payroll-line"><span>Mã phiếu chi</span><b>' + code + '</b></div>'
          + '<div class="cc-payroll-line"><span>Ngày lập</span><b>' + escapeHtml(receipt.ngay_lap_text || '---') + '</b></div>'
          + '<div class="cc-payroll-line is-minus"><span>Giá trị</span><b>- ' + escapeHtml(moneyText(receipt.gia_tri || 0)) + '</b></div>'
          + '</div>';
      }

      function renderPayrollDetailModal(item, preview) {
        item = item || {};
        preview = preview || {};
        const statusText = preview.da_thanh_toan || item.da_thanh_toan ? 'Đã thanh toán' : 'Chưa thanh toán';
        const monthText = formatPayrollMonth(item.thang_bang_luong) || item.thang_text || '';
        const due = preview.con_thanh_toan != null
          ? preview.con_thanh_toan
          : (item.con_can_tra != null ? item.con_can_tra : item.tong_tien);
        return '<div class="span-2 cc-payroll-detail-head">'
          + '<h3>' + escapeHtml(item.ma_bang_luong || preview.ma_bang_luong || 'Bảng lương') + '</h3>'
          + '<span class="cc-pill ' + (statusText === 'Đã thanh toán' ? 'cc-pill-pay-done' : 'cc-pill-pay-wait') + '">' + statusText + '</span>'
          + '</div>'
          + '<div class="span-2 cc-payroll-detail-meta">'
          + '<div><span>Nhân viên</span><strong>' + escapeHtml((item.ma_nhan_vien ? item.ma_nhan_vien + ' - ' : '') + (item.ten_nhan_vien || '---')) + '</strong></div>'
          + '<div><span>Tháng</span><strong>' + escapeHtml(monthText || '---') + '</strong></div>'
          + '<div><span>Ngày công</span><strong>' + escapeHtml(workUnitText(item.so_ngay_cong || item.ngay_cong_thuc_te || 0)) + '</strong></div>'
          + '<div><span>Lương/tháng</span><strong>' + escapeHtml(moneyText(item.luong_theo_thang || item.luong_thang || 0)) + '</strong></div>'
          + '<div><span>Cần thanh toán</span><strong>' + escapeHtml(moneyText(preview.tong_luong || item.tong_tien || item.thuc_nhan || 0)) + '</strong></div>'
          + '<div><span>Còn phải trả</span><strong>' + escapeHtml(moneyText(due || 0)) + '</strong></div>'
          + '</div>'
          + '<div class="span-2 cc-payroll-detail-section">'
          + '<h4>Chi tiết ngày công</h4>'
          + renderPayrollDayDetails(item)
          + '</div>'
          + '<div class="span-2 cc-payroll-detail-section">'
          + '<h4>Các khoản lương, phụ cấp và khấu trừ</h4>'
          + (renderPayrollLines({ payroll_lines: preview.payroll_lines || item.payroll_lines || [] }) || '<div class="cc-payroll-pay-note">Chưa có chi tiết khoản.</div>')
          + '</div>'
          + '<div class="span-2 cc-payroll-detail-section">'
          + '<h4>Phiếu chi</h4>'
          + renderPayrollReceiptDetail(item)
          + '</div>';
