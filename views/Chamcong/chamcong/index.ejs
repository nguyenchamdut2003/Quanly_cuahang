                  <i class="fa-solid fa-file-export"></i>
                </a>
                <button type="button" class="cc-btn cc-btn-icon cc-payroll-delete-btn" data-payroll-id="${escapeHtml(item._id || '')}" data-payroll-code="${escapeHtml(item.ma_bang_luong || '')}" title="Xóa" aria-label="Xóa">
                  <i class="fa-regular fa-trash-can"></i>
                </button>
              </div>
