      async function submitAdvance() {
        const advanceEmployeeId = document.getElementById('ccAdvanceEmployeeId').value;
        const cashAmount = parseMoneyInput(document.getElementById('ccAdvanceCashAmount').value);
        const transferAmount = parseMoneyInput(document.getElementById('ccAdvanceTransferAmount').value);
        const amount = cashAmount + transferAmount;
        const err = document.getElementById('ccAdvanceErrors');
        if (!advanceEmployeeId) return;
        if (!(amount > 0)) {
          err.textContent = 'Số tiền tạm ứng phải lớn hơn 0.';
          return;
        }
        if (cashAmount > 0 && !document.getElementById('ccAdvanceCashBook').value) {
          err.textContent = 'Vui lòng chọn sổ quỹ tiền mặt.';
          return;
        }
        if (transferAmount > 0 && !document.getElementById('ccAdvanceTransferBook').value) {
          err.textContent = 'Vui lòng chọn sổ quỹ chuyển khoản.';
          return;
        }
        const submitBtn = document.getElementById('ccAdvanceSubmit');
        submitBtn.disabled = true;
        submitBtn.textContent = 'Đang tạo...';
        try {
          const json = await fetchJson('/chamcongmoi/api/nhan-vien/' + encodeURIComponent(advanceEmployeeId) + '/tam-ung', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            credentials: 'same-origin',
            body: JSON.stringify({
              ngay_tam_ung: document.getElementById('ccAdvanceDate').value,
              tien_mat: cashAmount,
              chuyen_khoan: transferAmount,
              so_quy_tien_mat_id: document.getElementById('ccAdvanceCashBook').value,
              so_quy_chuyen_khoan_id: document.getElementById('ccAdvanceTransferBook').value,
              ghi_chu: document.getElementById('ccAdvanceNote').value.trim()
            })
          });
          if (!json.success) {
            err.textContent = json.message || 'Không tạo được tạm ứng.';
            return;
          }
          advanceModal.classList.remove('is-open');
          const receiptCode = json.item && json.item.phieu_chi && json.item.phieu_chi.ma_phieu;
          setStatus('Đã tạo tạm ứng' + (receiptCode ? (' và phiếu chi ' + receiptCode) : '') + '.', 'ok');
        } catch (error) {
          err.textContent = error && error.message ? error.message : 'Không tạo được tạm ứng.';
        } finally {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Tạo tạm ứng';
        }
      }

