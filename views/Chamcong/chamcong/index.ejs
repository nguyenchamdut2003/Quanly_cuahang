        <div class="span-2">
          <div class="cc-pay-error" id="ccAdvanceErrors"></div>
        </div>
      </div>
      <div class="cc-dialog-actions">
        <button type="button" id="ccAdvanceSubmit" class="cc-btn cc-btn-primary">Tạo tạm ứng</button>
        <button type="button" id="ccAdvanceClose" class="cc-btn">Đóng</button>
      </div>
    </div>
  </div>

  <div id="ccEmployeeModal" class="cc-modal">
    <div class="cc-dialog">
      <div id="ccEmployeeModalTitle" class="cc-dialog-head">Thêm nhân viên</div>
      <div class="cc-dialog-body">
        <div class="cc-field">
          <label for="ccFormName">Tên nhân viên</label>
          <input id="ccFormName" class="cc-input" type="text">
        </div>
        <div class="cc-field">
          <label for="ccFormPhone">Số điện thoại</label>
          <input id="ccFormPhone" class="cc-input" type="text">
        </div>
        <div class="cc-field">
          <label for="ccFormEmail">Email</label>
          <input id="ccFormEmail" class="cc-input" type="email">
        </div>
        <div class="cc-field">
          <label for="ccFormCccd">CCCD</label>
          <input id="ccFormCccd" class="cc-input" type="text">
        </div>
        <div class="cc-field">
          <label for="ccFormBirth">Ngày sinh</label>
          <input id="ccFormBirth" class="cc-input" type="date">
        </div>
        <div class="cc-field">
          <label for="ccFormGender">Giới tính</label>
          <select id="ccFormGender" class="cc-select">
            <option value="">Chọn giới tính</option>
            <option value="nam">Nam</option>
            <option value="nu">Nữ</option>
            <option value="khac">Khác</option>
          </select>
        </div>
        <div class="cc-field">
          <label for="ccFormRole">Chức vụ</label>
          <input id="ccFormRole" class="cc-input" type="text">
        </div>
        <div class="cc-field">
          <label for="ccFormStart">Ngày bắt đầu</label>
          <input id="ccFormStart" class="cc-input" type="date">
        </div>
        <div class="cc-field">
          <label class="cc-salary-label" for="ccFormHasDaySalary">
            <input id="ccFormHasDaySalary" name="ccSalaryType" type="radio" value="ngay" checked>
            <span>Lương theo ngày</span>
          </label>
          <input id="ccFormDaySalary" class="cc-input cc-money-input" type="text" inputmode="numeric" autocomplete="off" value="0">
        </div>
        <div class="cc-field">
          <label class="cc-salary-label" for="ccFormHasMonthSalary">
            <input id="ccFormHasMonthSalary" name="ccSalaryType" type="radio" value="thang">
            <span>Lương theo tháng</span>
          </label>
          <input id="ccFormMonthSalary" class="cc-input cc-money-input" type="text" inputmode="numeric" autocomplete="off" value="0">
        </div>
        <div class="cc-field">
          <label for="ccFormDepartment">Phòng ban</label>
          <select id="ccFormDepartment" class="cc-select">
            <option value="">Chọn phòng ban</option>
            <% (phongBans || []).filter(function(item) { return item.trang_thai !== 'inactive'; }).forEach(function(item) { %>
              <option value="<%= item._id %>"><%= item.ten_phong_ban || '' %></option>
            <% }) %>
          </select>
        </div>
        <div class="cc-field">
          <label for="ccFormPosition">Chức danh</label>
          <select id="ccFormPosition" class="cc-select">
            <option value="">Chọn chức danh</option>
            <% (chucDanhs || []).filter(function(item) { return item.trang_thai !== 'inactive'; }).forEach(function(item) { %>
              <option value="<%= item._id %>"><%= item.ten_chuc_danh || '' %></option>
            <% }) %>
          </select>
        </div>
        <section class="cc-form-section">
          <h3>Cấu hình lương</h3>
          <div class="cc-form-grid">
            <div class="cc-field">
              <label for="ccSalaryMonth">Lương tháng</label>
              <input id="ccSalaryMonth" class="cc-input cc-money-input" type="text" inputmode="numeric" autocomplete="off" value="0">
            </div>
            <div class="cc-field">
              <label for="ccWorkDaysInMonth">Số ngày công trong tháng</label>
              <input id="ccWorkDaysInMonth" class="cc-input" type="number" min="0" step="0.5" value="26">
            </div>
            <div class="cc-field span-2">
              <label>Khoản nộp áp dụng</label>
              <div class="cc-contribution-list" id="ccContributionList">
                <% var activeKhoanNops = (danhMucKhoanNops || []).filter(function(item) { return item.trang_thai !== 'inactive'; }); %>
                <% if (!activeKhoanNops.length) { %>
                  <div class="cc-help-text">Chưa có danh mục khoản nộp đang sử dụng.</div>
                <% } %>
                <% activeKhoanNops.forEach(function(item) { %>
                  <label class="cc-contribution-item">
                    <span><input type="checkbox" class="cc-contribution-enabled" value="<%= item._id %>"> <%= item.ten_khoan || '' %></span>
                    <span class="cc-contribution-rate"><%= Number(item.ti_le_nld != null ? item.ti_le_nld : (item.ti_le || 0)).toLocaleString('vi-VN') %>% Người lao động</span>
                  </label>
                <% }) %>
              </div>
            </div>
          </div>
        </section>
        <section class="cc-form-section">
          <h3>Phụ cấp</h3>
          <div class="cc-allowance-list" id="ccAllowanceList">
            <% var activePhuCaps = (danhMucPhuCaps || []).filter(function(item) { return item.trang_thai !== 'inactive'; }); %>
            <% if (!activePhuCaps.length) { %>
              <div class="cc-help-text">Chưa có danh mục phụ cấp đang sử dụng.</div>
            <% } %>
            <% activePhuCaps.forEach(function(item) { %>
              <div class="cc-allowance-item" data-allowance-id="<%= item._id %>">
                <label class="cc-allowance-check">
                  <input type="checkbox" class="cc-allowance-enabled">
                  <span><%= item.ten_phu_cap || '' %></span>
                </label>
                <div class="cc-allowance-config">
                  <div class="cc-field">
                    <label>Cách tính</label>
                    <select class="cc-select cc-allowance-type">
                      <option value="co_dinh_thang">Cố định theo tháng</option>
                      <option value="theo_ngay_di_lam">Theo ngày đi làm</option>
                      <option value="theo_cong">Theo công</option>
                    </select>
                  </div>
                  <div class="cc-field">
                    <label>Mức phụ cấp</label>
                    <input class="cc-input cc-money-input cc-allowance-amount" type="text" inputmode="numeric" value="0">
                  </div>
                  <div class="cc-allowance-preview">0 / tháng</div>
                </div>
              </div>
            <% }) %>
          </div>
        </section>
        <div class="cc-field">
          <label for="ccFormStatus">Trạng thái</label>
          <select id="ccFormStatus" class="cc-select">
            <option value="active">Đang làm</option>
            <option value="inactive">Đã nghỉ</option>
          </select>
        </div>
        <div class="cc-field span-2">
          <label for="ccFormNote">Ghi chú</label>
          <textarea id="ccFormNote" class="cc-textarea"></textarea>
        </div>
      </div>
      <div class="cc-dialog-actions">
        <button type="button" id="ccCancelEmployee" class="cc-btn">Hủy</button>
        <button type="button" id="ccSaveEmployee" class="cc-btn cc-btn-primary">Lưu</button>
      </div>
    </div>
  </div>

  <%- include('../phong-ban/_modal') %>
  <%- include('../chuc-danh/_modal') %>
  <%- include('../khoan-nop/danh-muc/_modal', { noiNops: noiNops }) %>
  <%- include('../phu-cap/_modal') %>
  <%- include('../phong-ban/_script') %>
  <%- include('../chuc-danh/_script') %>
  <%- include('../khoan-nop/danh-muc/_script') %>
  <%- include('../phu-cap/_script') %>
  <script src="/js/kv-inline-detail.js"></script>

  <script>
    (function() {
      const employeeSelect = document.getElementById('ccEmployee');
      const boardWrap = document.getElementById('ccBoardWrap');
      const weekLabel = document.getElementById('ccWeekLabel');
      const thisWeekBtn = document.getElementById('ccThisWeek');
      const thisMonthBtn = document.getElementById('ccThisMonth');
      const weekNav = document.getElementById('ccWeekNav');
      const monthNav = document.getElementById('ccMonthNav');
      const viewWeekBtn = document.getElementById('ccViewWeek');
      const viewMonthBtn = document.getElementById('ccViewMonth');
      const saveBtn = document.getElementById('ccSave');
      const statusEl = document.getElementById('ccStatus');
      const toolbarStatusEl = document.getElementById('ccToolbarStatus');
      const modal = document.getElementById('ccEmployeeModal');
      const employeeRows = document.getElementById('ccEmployeeRows');
      const payrollRows = document.getElementById('ccPayrollRows');
      const payrollPaidRows = document.getElementById('ccPayrollPaidRows');
      const employeeDetail = document.getElementById('ccEmployeeDetail');
      const employeeDetailTitle = document.getElementById('ccEmployeeDetailTitle');
      const employeeDetailInfo = document.getElementById('ccEmployeeDetailInfo');
      const employeeDetailAttendance = document.getElementById('ccEmployeeDetailAttendance');
      const employeeDetailPayroll = document.getElementById('ccEmployeeDetailPayroll');
      const advanceModal = document.getElementById('ccAdvanceModal');
      const employeeMasterTable = document.querySelector('table[data-kv-master="cham-cong-nhan-vien"]');
      let weekStart = '<%= weekStart %>';
      let monthStart = '';
      let currentMode = 'ngay';
      let dualBoardView = 'thang';
      let hasDualSalary = false;
      let currentDays = [];
      let currentMonths = [];
      let employeeEditId = '';
      let employeeDetailId = '';
      let pendingPayrollPayId = '';
      let pendingPayrollPayDue = 0;
      let payrollPayCashBookId = '';
      const payrollPayModal = document.getElementById('ccPayrollPayModal');
      const payrollDetailModal = document.getElementById('ccPayrollDetailModal');
      const payrollDetailBody = document.getElementById('ccPayrollDetailBody');
      const bulkAttendanceModal = document.getElementById('ccBulkAttendanceModal');
      const bulkAttendanceStatus = document.getElementById('ccBulkAttendanceStatus');
      const attendanceWarningModal = document.getElementById('ccAttendanceWarningModal');
      const attendanceWarningBody = document.getElementById('ccAttendanceWarningBody');
      const payrollItemsById = {};
      const employeeInlineFilters = document.querySelector('.cc-employee-inline-filters');
      const employeeToolbar = document.querySelector('#ccEmployeesPane .cc-toolbar');
      if (employeeInlineFilters && employeeToolbar) employeeToolbar.appendChild(employeeInlineFilters);
      const departmentFilterLabel = document.querySelector('label[for="ccEmployeeDepartmentFilter"]');
      const positionFilterLabel = document.querySelector('label[for="ccEmployeePositionFilter"]');
      if (departmentFilterLabel) departmentFilterLabel.textContent = 'Ph\u00f2ng ban';
      if (positionFilterLabel) positionFilterLabel.textContent = 'Ch\u1ee9c danh';
      const departmentCreateBtn = document.getElementById('pbAddBtn');
      const positionCreateBtn = document.getElementById('cdAddBtn');
      if (departmentCreateBtn) departmentCreateBtn.textContent = 'T\u1ea1o m\u1edbi';
      if (positionCreateBtn) positionCreateBtn.textContent = 'T\u1ea1o m\u1edbi';
      const departmentPlaceholder = document.querySelector('#ccEmployeeDepartmentFilter option[value=""]');
      const positionPlaceholder = document.querySelector('#ccEmployeePositionFilter option[value=""]');
      if (departmentPlaceholder) departmentPlaceholder.textContent = 'Ch\u1ecdn ph\u00f2ng ban';
      if (positionPlaceholder) positionPlaceholder.textContent = 'Ch\u1ecdn ch\u1ee9c danh';

      function bindInlineEmployeePayrollFilter(root) {
        if (!root) return;
        const select = root.querySelector('.cc-inline-payroll-status');
        const rows = Array.prototype.slice.call(root.querySelectorAll('[data-payroll-status]'));
        const empty = root.querySelector('[data-inline-payroll-empty-filter]');
        function applyFilter() {
          const value = select ? select.value : 'all';
          let visible = 0;
          rows.forEach(function(row) {
            const matched = value === 'all' || row.dataset.payrollStatus === value;
            row.hidden = !matched;
            if (matched) visible += 1;
          });
          if (empty) empty.hidden = visible > 0;
        }
        if (select && !select._ccPayrollFilterBound) {
          select._ccPayrollFilterBound = true;
          select.addEventListener('change', applyFilter);
        }
        applyFilter();
      }

      if (employeeMasterTable && typeof KvInlineDetail !== 'undefined') {
        new KvInlineDetail({
          table: employeeMasterTable,
          colspan: 12,
          buildUrl: function(id) {
            return '/chamcongmoi/api/nhan-vien/' + encodeURIComponent(id) + '/detail';
          },
          onOpen: function(id, root) {
            bindInlineEmployeePayrollFilter(root);
          }
        });
      }

      function parseMoneyInput(value) {
        const digits = String(value == null ? '' : value).replace(/[^\d]/g, '');
        if (!digits) return 0;
        return Number(digits);
      }

      function formatMoneyInput(value) {
        return parseMoneyInput(value).toLocaleString('vi-VN');
      }

      function formatMoneyInputLive(input) {
        if (!input) return;
        const start = input.selectionStart == null ? String(input.value || '').length : input.selectionStart;
        const raw = String(input.value || '');
        const digitsBefore = raw.slice(0, start).replace(/[^\d]/g, '').length;
        const formatted = formatMoneyInput(raw);
        input.value = formatted;
        let pos = 0;
        let seen = 0;
        while (pos < formatted.length && seen < digitsBefore) {
          if (/\d/.test(formatted.charAt(pos))) seen += 1;
          pos += 1;
        }
        input.setSelectionRange(pos, pos);
      }

      function bindMoneyInput(input) {
        if (!input || input.dataset.moneyBound === '1') return;
        input.dataset.moneyBound = '1';
        input.addEventListener('input', function() {
          formatMoneyInputLive(input);
        });
        input.addEventListener('focus', function() {
          if (parseMoneyInput(input.value) === 0) input.value = '';
        });
        input.addEventListener('blur', function() {
          input.value = formatMoneyInput(input.value);
        });
      }

      function parseWorkUnitInput(value) {
        const normalized = String(value == null ? '' : value).replace(',', '.').replace(/[^0-9.]/g, '');
        const num = Number(normalized);
        if (!Number.isFinite(num)) return 0;
        return Math.max(0, num);
      }

      function workUnitText(value) {
        const num = parseWorkUnitInput(value);
        return num.toLocaleString('vi-VN', { maximumFractionDigits: 2 });
      }

      function dayWorkUnits(day) {
        const morning = day && day.ca_sang ? 0.5 : 0;
        const afternoon = day && day.ca_chieu ? 0.5 : 0;
        return morning + afternoon + parseWorkUnitInput(day ? day.tang_ca_cong : 0);
      }

      function firstDayOfMonth(value) {
        const date = value && String(value).length === 7 ? parseMonth(value) : parseDate(value || formatDate(new Date()));
        return formatDate(new Date(Date.UTC(date.getUTCFullYear(), date.getUTCMonth(), 1)));
      }

      function monthKeyFromDate(value) {
        return formatMonth(parseDate(value || formatDate(new Date())));
      }

      function syncSalaryInput(checkboxId, inputId) {
        const checkbox = document.getElementById(checkboxId);
        const input = document.getElementById(inputId);
        input.disabled = !checkbox.checked;
        if (!checkbox.checked) {
          input.value = '0';
          return;
        }
        if (!parseMoneyInput(input.value)) input.value = '0';
        else input.value = formatMoneyInput(input.value);
      }

      function syncSalaryInputs() {
        refreshAllowancePreviews();
      }

      function allowanceUnitLabel(type) {
        if (type === 'theo_ngay_di_lam') return '/ ngày đi làm';
        if (type === 'theo_cong') return '/ công';
        return '/ tháng';
      }

      function refreshAllowancePreviews() {
        document.querySelectorAll('.cc-allowance-item').forEach(function(item) {
          const checked = !!item.querySelector('.cc-allowance-enabled')?.checked;
          item.classList.toggle('is-checked', checked);
          const amount = parseMoneyInput(item.querySelector('.cc-allowance-amount')?.value || 0);
          const type = item.querySelector('.cc-allowance-type')?.value || 'co_dinh_thang';
          const preview = item.querySelector('.cc-allowance-preview');
          if (preview) preview.textContent = amount.toLocaleString('vi-VN') + ' ' + allowanceUnitLabel(type);
        });
      }

      function setStatus(message, type) {
        const text = message || '';
        statusEl.textContent = text;
        statusEl.className = 'cc-status' + (type ? ' is-' + type : '');
        if (toolbarStatusEl) {
          toolbarStatusEl.textContent = text;
          toolbarStatusEl.className = 'cc-toolbar-status' + (type ? ' is-' + type : '');
        }
      }

      function normalizeTimeInput(value) {
        const raw = String(value == null ? '' : value).trim();
        if (!raw) return '';
        const match24 = raw.match(/^([01]?\d|2[0-3]):([0-5]\d)(?::[0-5]\d)?$/);
        if (match24) {
          return String(Number(match24[1])).padStart(2, '0') + ':' + match24[2];
        }
        const match12 = raw.match(/^(\d{1,2}):([0-5]\d)\s*(AM|PM)$/i);
        if (match12) {
          let hour = Number(match12[1]) % 12;
          if (/pm/i.test(match12[3])) hour += 12;
          return String(hour).padStart(2, '0') + ':' + match12[2];
        }
        return raw;
      }

      function collectDayRows() {
        return Array.from(document.querySelectorAll('.cc-day[data-date]')).map(function(dayEl) {
          const caSangInput = dayEl.querySelector('.cc-ca-sang');
          const caChieuInput = dayEl.querySelector('.cc-ca-chieu');
          const tickTangCaInput = dayEl.querySelector('.cc-tick-tang-ca');
          const tangCaInput = dayEl.querySelector('.cc-tang-ca-cong');
          const noteInput = dayEl.querySelector('textarea.cc-note');
          const caSang = !!(caSangInput && caSangInput.checked);
          const caChieu = !!(caChieuInput && caChieuInput.checked);
          const tickTangCa = !!(tickTangCaInput && tickTangCaInput.checked);
          const tangCaCong = parseWorkUnitInput(tangCaInput ? tangCaInput.value : '');
          return {
            ngay_cham_cong: dayEl.dataset.date || '',
            dong_y: caSang || caChieu || tickTangCa || tangCaCong > 0,
            ca_sang: caSang,
            ca_chieu: caChieu,
            tick_tang_ca: tickTangCa,
            tang_ca_cong: tangCaCong,
            ghi_chu: noteInput ? noteInput.value.trim() : ''
          };
        }).filter(function(row) { return !!row.ngay_cham_cong; });
      }

      function collectMonthRows() {
        return Array.from(document.querySelectorAll('.cc-month[data-month]')).map(function(monthEl) {
          const dongYInput = monthEl.querySelector('.cc-dong-y-thang');
          const noteInput = monthEl.querySelector('.cc-ghi-chu-thang');
          return {
            thang_cham_cong: monthEl.dataset.month || '',
            dong_y: !!(dongYInput && dongYInput.checked),
            ghi_chu: noteInput ? noteInput.value.trim() : ''
          };
        }).filter(function(row) { return !!row.thang_cham_cong; });
      }

      function syncCurrentDaysFromDom() {
        const dayRows = collectDayRows();
        if (!dayRows.length) return;
        const dayMap = {};
        dayRows.forEach(function(row) {
          dayMap[row.ngay_cham_cong] = row;
        });
        currentDays = (currentDays || []).map(function(day) {
          const row = dayMap[day.key];
          if (!row) return day;
          return Object.assign({}, day, {
            ca_sang: row.ca_sang,
            ca_chieu: row.ca_chieu,
            tick_tang_ca: row.tick_tang_ca,
            tang_ca_cong: row.tang_ca_cong,
            ghi_chu: row.ghi_chu,
            so_cong: dayWorkUnits(row)
          });
        });
      }

      function isSundayAttendanceDay(day) {
        if (!day || !day.key) return false;
        const date = parseDate(day.key);
        return date.getUTCDay() === 0;
      }

      function selectedEmployeeWorkDays() {
        const option = employeeSelect.options[employeeSelect.selectedIndex];
        return Number(option && option.dataset ? option.dataset.workDays : 0) || 0;
      }

      function shouldAutoTickSundayOvertime() {
        return selectedEmployeeWorkDays() === 26;
      }

      function applyAutoSundayOvertime(days) {
        if (!shouldAutoTickSundayOvertime()) return days || [];
        return (days || []).map(function(day) {
          if (!isSundayAttendanceDay(day)) return day;
          const next = Object.assign({}, day, { tick_tang_ca: true });
          next.so_cong = dayWorkUnits(next);
          return next;
        });
      }

      function applyBulkAttendanceAction(action) {
        if (!employeeSelect.value) {
          if (bulkAttendanceStatus) bulkAttendanceStatus.textContent = 'Chọn nhân viên trước khi thao tác.';
          return;
        }
        if (currentMode === 'thang') {
          if (bulkAttendanceStatus) bulkAttendanceStatus.textContent = 'Thao tác nhanh chỉ áp dụng cho chấm công theo ngày.';
          return;
        }
        syncCurrentDaysFromDom();
        const workdaysOnly = action === 'full_workdays'
          || action === 'overtime_1_workdays'
          || action === 'overtime_05_workdays';
        let touched = 0;
        currentDays = (currentDays || []).map(function(day) {
          if (action === 'full_workdays' && isSundayAttendanceDay(day)) {
            const nextSunday = Object.assign({}, day, {
              ca_sang: false,
              ca_chieu: false,
              tick_tang_ca: true
            });
            nextSunday.so_cong = dayWorkUnits(nextSunday);
            touched += 1;
            return nextSunday;
          }
          if (workdaysOnly && isSundayAttendanceDay(day)) return day;
          const next = Object.assign({}, day);
          if (action === 'full_all' || action === 'full_workdays') {
            next.ca_sang = true;
            next.ca_chieu = true;
          }
          if (action === 'clear_shifts_all') {
            next.ca_sang = false;
            next.ca_chieu = false;
          }
          if (action === 'overtime_0_all') next.tang_ca_cong = 0;
          if (action === 'overtime_05_all' || action === 'overtime_05_workdays') next.tang_ca_cong = 0.5;
          if (action === 'overtime_1_all' || action === 'overtime_1_workdays') next.tang_ca_cong = 1;
          next.so_cong = dayWorkUnits(next);
          touched += 1;
          return next;
        });
        renderDayBoard(currentDays);
        if (bulkAttendanceStatus) bulkAttendanceStatus.textContent = 'Đã áp dụng cho ' + touched + ' ngày. Bấm Lưu chấm công để lưu dữ liệu.';
      }

      function setSaveLoading(isLoading) {
        if (!saveBtn) return;
        saveBtn.disabled = !!isLoading;
        saveBtn.textContent = isLoading ? 'Đang lưu...' : 'Lưu chấm công';
      }

      function setTableLoading(tbody, colspan, message) {
        if (!tbody) return;
        tbody.innerHTML = '<tr><td colspan="' + Number(colspan || 1) + '" class="cc-loading-cell">'
          + '<span class="cc-list-loading"><span class="cc-list-spinner" aria-hidden="true"></span>'
          + '<span>' + escapeHtml(message || 'Đang tải danh sách...') + '</span></span>'
          + '</td></tr>';
      }

      function escapeHtml(value) {
        return String(value == null ? '' : value).replace(/[&<>"']/g, function(char) {
          return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[char];
        });
      }

      async function fetchJson(url, options) {
        const res = await fetch(url, options);
        const text = await res.text();
        let json;
        try {
          json = text ? JSON.parse(text) : {};
        } catch (error) {
          json = { success: false, message: text || 'Máy chủ trả về dữ liệu không hợp lệ' };
        }
        if (!res.ok && json.success !== false) {
          json.success = false;
          json.message = json.message || ('Lỗi máy chủ ' + res.status);
        }
        return json;
      }

      function parseDate(value) {
        const parts = String(value || '').split('-').map(Number);
        return new Date(Date.UTC(parts[0], parts[1] - 1, parts[2]));
      }

      function formatDate(date) {
        return date.getUTCFullYear() + '-' + String(date.getUTCMonth() + 1).padStart(2, '0') + '-' + String(date.getUTCDate()).padStart(2, '0');
      }

      function addDays(value, days) {
        const date = parseDate(value);
        date.setUTCDate(date.getUTCDate() + days);
        return formatDate(date);
      }

      function parseMonth(value) {
        const parts = String(value || '').split('-').map(Number);
        return new Date(Date.UTC(parts[0], parts[1] - 1, 1));
      }

      function formatMonth(date) {
        return date.getUTCFullYear() + '-' + String(date.getUTCMonth() + 1).padStart(2, '0');
      }

      function addMonths(value, months) {
        const date = parseMonth(value || formatMonth(new Date()));
        date.setUTCMonth(date.getUTCMonth() + months);
        return formatMonth(date);
      }

      function daysInMonth(monthKey) {
        const date = parseMonth(monthKey || formatMonth(new Date()));
        return new Date(Date.UTC(date.getUTCFullYear(), date.getUTCMonth() + 1, 0)).getUTCDate();
      }

      function buildMonthDayRows(monthKey) {
        const startDate = parseMonth(monthKey || formatMonth(new Date()));
        const todayKey = formatDate(new Date());
        const weekNames = ['Chủ nhật', 'Thứ 2', 'Thứ 3', 'Thứ 4', 'Thứ 5', 'Thứ 6', 'Thứ 7'];
        const totalDays = daysInMonth(monthKey);
        const rows = [];
        for (let day = 1; day <= totalDays; day += 1) {
          const date = new Date(Date.UTC(startDate.getUTCFullYear(), startDate.getUTCMonth(), day));
          const key = formatDate(date);
          rows.push({
            key: key,
            day: String(day).padStart(2, '0'),
            label: weekNames[date.getUTCDay()],
            week_index: Math.floor((day - 1) / 7) + 1,
            is_today: key === todayKey,
            ca_sang: false,
            ca_chieu: false,
            tick_tang_ca: false,
            tang_ca_cong: 0,
            ghi_chu: ''
          });
        }
        return rows;
      }

      function startOfWeek(date) {
        const day = date.getUTCDay() || 7;
        date.setUTCDate(date.getUTCDate() + 1 - day);
        return formatDate(date);
      }

      function genderText(value) {
        if (value === 'nam') return 'Nam';
        if (value === 'nu') return 'Nữ';
        if (value === 'khac') return 'Khác';
        return '';
      }

      function moneyText(value) {
        return Number(value || 0).toLocaleString('vi-VN');
      }

      function saveStatusText(warnings) {
        warnings = Array.isArray(warnings) ? warnings : [];
        return 'Đã lưu chấm công.';
      }

      function payrollPageHrefFromWarning(item) {
        const params = new URLSearchParams({ tab: 'payroll' });
        if (item && item.trang_thai_thanh_toan === 'da_thanh_toan') params.set('trang_thai', 'da_thanh_toan');
        if (item && item.bang_luong_id) params.set('bang_luong', item.bang_luong_id);
        return '/cham-cong?' + params.toString();
      }

      function renderAttendancePayrollWarnings(warnings) {
        warnings = Array.isArray(warnings) ? warnings : [];
        if (!warnings.length) return '<div class="cc-empty">Không có cảnh báo.</div>';
        const rows = warnings.map(function(item) {
          const receipts = Array.isArray(item.phieu_chis) ? item.phieu_chis : [];
          const receiptLinks = receipts.length
            ? receipts.map(function(receipt) {
              const href = receipt._id ? receiptDocHref(receipt._id) : '';
              const label = receipt.ma_phieu || 'Phiếu chi';
              return href
                ? '<a href="' + escapeHtml(href) + '">' + escapeHtml(label) + '</a>'
                : '<span>' + escapeHtml(label) + '</span>';
            }).join('')
            : '<span class="cc-attendance-warning-note">Chưa có phiếu chi.</span>';
          return '<div class="cc-attendance-warning-item">'
            + '<div class="cc-attendance-warning-main">'
            + '<div class="cc-attendance-warning-date">' + escapeHtml(item.ngay_text || item.ngay || '---') + '</div>'
            + '<div class="cc-attendance-warning-links">'
            + '<a href="' + escapeHtml(payrollPageHrefFromWarning(item)) + '">' + escapeHtml(item.ma_bang_luong || 'Bảng lương') + '</a>'
            + receiptLinks
            + '</div>'
            + '</div>'
            + '<div class="cc-attendance-warning-note">Ngày công này đã nằm trong bảng lương. Nếu sửa lại chấm công, cần kiểm tra lại bảng lương và phiếu liên quan.</div>'
            + '</div>';
        }).join('');
        return '<div class="cc-attendance-warning-list">' + rows + '</div>';
      }

      function openAttendanceWarningModal(warnings) {
        warnings = Array.isArray(warnings) ? warnings : [];
        if (!warnings.length) return;
        if (attendanceWarningBody) attendanceWarningBody.innerHTML = renderAttendancePayrollWarnings(warnings);
        attendanceWarningModal?.classList.add('is-open');
      }

      function formatWeekButton(start, end) {
        if (!start || !end) return 'Tuần này';
        const startDate = parseDate(start);
        const endDate = parseDate(end);
        const startText = String(startDate.getUTCDate()).padStart(2, '0') + '/' + String(startDate.getUTCMonth() + 1).padStart(2, '0');
        const endText = String(endDate.getUTCDate()).padStart(2, '0') + '/' + String(endDate.getUTCMonth() + 1).padStart(2, '0');
        return startText + ' - ' + endText;
      }

      function formatMonthButton(start, end) {
        if (!start || !end) return '7 tháng gần nhất';
        const startDate = parseMonth(start);
        const endDate = parseMonth(end);
        const startText = String(startDate.getUTCMonth() + 1).padStart(2, '0') + '/' + startDate.getUTCFullYear();
        const endText = String(endDate.getUTCMonth() + 1).padStart(2, '0') + '/' + endDate.getUTCFullYear();
        return startText + ' - ' + endText;
      }

      function formatPayrollMonth(value) {
        const parts = String(value || '').split('-');
        if (parts.length !== 2) return String(value || '');
        return parts[1] + '/' + parts[0];
      }

      function payrollWarningButton(payroll) {
        if (!payroll) return '';
        return `<button type="button" class="cc-payroll-warning" title="${escapeHtml(payroll.message || 'Đã có bảng chấm công')}" data-payroll-id="${escapeHtml(payroll.id || '')}" data-payroll-code="${escapeHtml(payroll.ma_bang_luong || '')}">
          <i class="fa-solid fa-triangle-exclamation"></i>
        </button>`;
      }

      function cssEscape(value) {
        if (window.CSS && typeof window.CSS.escape === 'function') return window.CSS.escape(String(value || ''));
        return String(value || '').replace(/["\\]/g, '\\$&');
      }

      function switchTab(tab, skipLoad) {
        if (tab === 'payroll-paid') tab = 'payroll';
        if (tab === 'departments' || tab === 'positions') tab = 'employees';
        document.querySelectorAll('.detail-tab[data-tab]').forEach(btn => btn.classList.toggle('is-active', btn.dataset.tab === tab));
        document.getElementById('ccAttendancePane').classList.toggle('is-active', tab === 'attendance');
        document.getElementById('ccEmployeesPane').classList.toggle('is-active', tab === 'employees');
        document.getElementById('ccPayrollPane').classList.toggle('is-active', tab === 'payroll');
        document.getElementById('ccPayrollPaidPane').classList.toggle('is-active', tab === 'payroll-paid');
        document.getElementById('ccDepartmentsPane').classList.toggle('is-active', tab === 'departments');
        document.getElementById('ccPositionsPane').classList.toggle('is-active', tab === 'positions');
        document.getElementById('ccContributionsPane').classList.toggle('is-active', tab === 'contributions');
        document.getElementById('ccAllowancesPane').classList.toggle('is-active', tab === 'allowances');
        if (skipLoad) return;
        if (window.history && window.history.replaceState) {
          const url = new URL(window.location.href);
          if (tab && tab !== 'attendance') url.searchParams.set('tab', tab);
          else url.searchParams.delete('tab');
          window.history.replaceState({}, '', url.pathname + url.search + url.hash);
        }
        if (tab === 'employees') loadEmployeeTable();
        if (tab === 'payroll') loadPayrollTable();
        if (tab === 'payroll-paid') loadPaidPayrollTable();
        if (tab === 'attendance') loadWeek();
      }

      function isDualAttendanceMode() {
        return hasDualSalary || currentMode === 'ca_hai';
      }

      function updateToolbarNav(mode) {
        const showWeek = mode === 'ngay' || mode === 'ca_hai';
        const showMonth = mode === 'thang' || mode === 'ca_hai';
        if (weekNav) weekNav.hidden = !showWeek;
        if (monthNav) monthNav.hidden = !showMonth;
        updateDualNavState();
      }

      function updateDualNavState() {
        const dual = isDualAttendanceMode();
        if (viewWeekBtn) {
          viewWeekBtn.classList.toggle('is-active', dual ? dualBoardView === 'ngay' : currentMode === 'ngay');
        }
        if (viewMonthBtn) {
          viewMonthBtn.classList.toggle('is-active', dual ? dualBoardView === 'thang' : currentMode === 'thang');
        }
      }

      function syncDualBoardStateFromDom() {
        if (!isDualAttendanceMode()) return;
        if (dualBoardView === 'thang') {
          const monthRows = collectMonthRows();
          if (!monthRows.length) return;
          const monthMap = {};
          monthRows.forEach(function(row) {
            monthMap[row.thang_cham_cong] = row;
          });
          currentMonths = (currentMonths || []).map(function(month) {
            const row = monthMap[month.key];
            if (!row) return month;
            return Object.assign({}, month, {
              dong_y: row.dong_y,
              ghi_chu: row.ghi_chu
            });
          });
          return;
        }
        const dayRows = collectDayRows();
        if (!dayRows.length) return;
        const dayMap = {};
        dayRows.forEach(function(row) {
          dayMap[row.ngay_cham_cong] = row;
        });
        currentDays = (currentDays || []).map(function(day) {
          const row = dayMap[day.key];
          if (!row) return day;
          return Object.assign({}, day, {
            dong_y: row.dong_y,
            ca_sang: row.ca_sang,
            ca_chieu: row.ca_chieu,
            tick_tang_ca: row.tick_tang_ca,
            tang_ca_cong: row.tang_ca_cong,
            ghi_chu: row.ghi_chu
          });
        });
      }

      function showDualAttendanceView(view) {
        dualBoardView = view === 'thang' ? 'thang' : 'ngay';
        if (!employeeSelect.value) {
          boardWrap.innerHTML = '<div class="cc-empty">Chọn nhân viên để chấm công.</div>';
          updateDualNavState();
          return;
        }
        if (dualBoardView === 'thang') {
          boardWrap.innerHTML = buildMonthBoardHtml(currentMonths);
        } else {
          boardWrap.innerHTML = buildDayBoardHtml(currentDays);
        }
        updateDualNavState();
      }

      function switchDualBoardView(view) {
        if (!isDualAttendanceMode()) return;
        syncDualBoardStateFromDom();
        showDualAttendanceView(view);
      }

      function collectDualSavePayload() {
        syncDualBoardStateFromDom();
        return {
          days: (currentDays || []).map(function(day) {
            return {
              ngay_cham_cong: day.key || '',
              dong_y: !!day.dong_y,
              ca_sang: !!day.ca_sang,
              ca_chieu: !!day.ca_chieu,
              tick_tang_ca: !!day.tick_tang_ca,
              tang_ca_cong: parseWorkUnitInput(day.tang_ca_cong),
              ghi_chu: day.ghi_chu || ''
            };
          }).filter(function(row) { return !!row.ngay_cham_cong; }),
          months: (currentMonths || []).map(function(month) {
            return {
              thang_cham_cong: month.key || '',
              dong_y: !!month.dong_y,
              ghi_chu: month.ghi_chu || ''
            };
          }).filter(function(row) { return !!row.thang_cham_cong; })
        };
      }

      function renderDualBoardView(days, months, view) {
        currentDays = days || [];
        currentMonths = months || [];
        showDualAttendanceView(view);
      }

      function buildDayBoardHtmlLegacy(days) {
        if (!Array.isArray(days) || !days.length) {
          return '<div class="cc-empty">Chưa có dữ liệu ngày.</div>';
        }
        return '<div class="cc-board">' + days.map(function(day) {
          return `
            <div class="cc-day" data-date="${escapeHtml(day.key)}">
              <div class="cc-day-head">
                <div class="cc-day-title">
                  <span>${escapeHtml(day.label)}</span>
                  <span class="cc-day-top-actions">
                    <label class="cc-overtime-day-toggle" title="tick ngày này làm tăng ca sẽ tính công theo công tăng ca">
                      <input class="cc-tick-tang-ca" type="checkbox" aria-label="Tick ngày này làm tăng ca" ${day.tick_tang_ca ? 'checked' : ''}>
                      <span class="cc-overtime-day-switch" aria-hidden="true"></span>
                    </label>
                    ${payrollWarningButton(day.payroll)}${day.is_today ? '<span class="cc-today">Hôm nay</span>' : ''}
                  </span>
                </div>
                <div class="cc-day-date">${escapeHtml(day.day)}</div>
              </div>
              <div class="cc-day-body">
                <label class="cc-check">
                  <input class="cc-dong-y" type="checkbox" ${day.dong_y ? 'checked' : ''}>
                  <span>Đồng ý ngày này</span>
                </label>
                <label>Giờ vào
                  <input class="cc-time cc-gio-vao" type="time" value="${escapeHtml(day.gio_vao || '')}">
                </label>
                <label>Giờ ra
                  <input class="cc-time cc-gio-ra" type="time" value="${escapeHtml(day.gio_ra || '')}">
                </label>
                <label>Ghi chú
                  <textarea class="cc-note">${escapeHtml(day.ghi_chu || '')}</textarea>
                </label>
              </div>
            </div>
          `;
