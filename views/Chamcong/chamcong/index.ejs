        const departmentId = document.getElementById('ccEmployeeDepartmentFilter')?.value || '';
        const positionId = document.getElementById('ccEmployeePositionFilter')?.value || '';
        if (keyword) params.set('keyword', keyword);
        if (departmentId) params.set('phong_ban_id', departmentId);
        if (positionId) params.set('chuc_danh_id', positionId);
        setTableLoading(employeeRows, 12, 'Đang tải danh sách nhân viên...');
        const json = await fetchJson('/chamcongmoi/api/nhan-vien?' + params.toString(), {
          headers: { 'Accept': 'application/json' },
          credentials: 'same-origin'
        });
        if (!json.success) {
          setStatus(json.message || 'Không tải được danh sách nhân viên', 'error');
          return;
        }
        if (!json.items.length) {
          employeeRows.innerHTML = '<tr><td colspan="12" class="cc-empty">Chưa có nhân viên.</td></tr>';
          return;
        }
        employeeRows.innerHTML = json.items.map(function(item) {
