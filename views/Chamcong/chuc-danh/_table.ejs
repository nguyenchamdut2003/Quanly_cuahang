<section class="hr-table-panel">
  <table class="hr-table">
    <thead>
      <tr>
        <th>Tên chức danh</th>
        <th>Mô tả</th>
        <th>Trạng thái</th>
        <th style="width:100px">Thao tác</th>
      </tr>
    </thead>
    <tbody id="cdTableBody">
      <% if (!(chucDanhs || []).length) { %>
        <tr><td colspan="4" class="hr-empty">Chưa có chức danh. <a id="cdEmptyAdd">Nhấn vào đây để thêm chức danh</a>.</td></tr>
      <% } %>
      <% (chucDanhs || []).forEach(function(cd) { %>
        <tr data-id="<%= cd._id %>">
          <td><strong><%= cd.ten_chuc_danh || '---' %></strong></td>
          <td><%= cd.mo_ta || '---' %></td>
          <td>
            <span class="status-pill <%= cd.trang_thai === 'active' ? 'is-active' : 'is-inactive' %>">
              <%= cd.trang_thai === 'active' ? 'Đang sử dụng' : 'Ngừng sử dụng' %>
            </span>
          </td>
          <td>
            <div class="hr-actions">
              <button type="button" class="hr-btn-icon cd-edit" title="Sửa"><i class="fa-regular fa-pen-to-square"></i></button>
              <button type="button" class="hr-btn-icon cd-inactive" title="Ngừng sử dụng" <%= cd.trang_thai === 'inactive' ? 'disabled' : '' %>><i class="fa-solid fa-ban"></i></button>
            </div>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</section>
