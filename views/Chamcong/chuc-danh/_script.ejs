<script>
  const cdModal = document.getElementById('cdModal');
  const cdForm = document.getElementById('cdForm');
  const cdKeyword = document.getElementById('cdKeyword');
  let cdEditId = '';

  function isEmployeeFormHostOpen() {
    const el = document.getElementById('ccEmployeeModal');
    return !!(el && el.classList.contains('is-open'));
  }

  function syncBodyModalOpen() {
    const hasCatalogModal = document.querySelector('.modal-overlay.is-open');
    const hasEmployeeModal = isEmployeeFormHostOpen();
    if (hasCatalogModal || hasEmployeeModal) {
      document.body.classList.add('modal-open');
      return;
    }
    document.body.classList.remove('modal-open');
  }

  function applyChucDanhToEmployeeSelect(data) {
    if (!data || !data._id) return;
    const id = String(data._id);
    const name = data.ten_chuc_danh || '';
    ['ccFormPosition', 'ccEmployeePositionFilter'].forEach(function(selectId) {
      const el = document.getElementById(selectId);
      if (!el) return;
      let opt = Array.from(el.options).find(function(option) { return option.value === id; });
      if (!opt) {
        opt = document.createElement('option');
        opt.value = id;
        opt.textContent = name;
        el.appendChild(opt);
      } else if (name) {
        opt.textContent = name;
      }
    });
    const formSelect = document.getElementById('ccFormPosition');
    if (formSelect) formSelect.value = id;
  }

  function openCdModal(item, options) {
    options = options || {};
    cdEditId = item && item._id ? String(item._id) : '';
    if (!cdEditId && cdForm) cdForm.reset();
    document.getElementById('cdModalTitle').textContent = cdEditId ? 'Sửa chức danh' : 'Thêm chức danh';
    document.getElementById('cdId').value = cdEditId;
    document.getElementById('cdTen').value = item && item.ten_chuc_danh ? item.ten_chuc_danh : '';
    document.getElementById('cdMoTa').value = item && item.mo_ta ? item.mo_ta : '';
    document.getElementById('cdTrangThai').value = item && item.trang_thai === 'inactive' ? 'inactive' : 'active';
    const nested = options.nested === true;
    cdModal.classList.toggle('is-nested', nested);
    cdModal.classList.add('is-open');
    cdModal.setAttribute('aria-hidden', 'false');
    syncBodyModalOpen();
    setTimeout(function() { document.getElementById('cdTen')?.focus(); }, 0);
  }

  function closeCdModal() {
    cdModal.classList.remove('is-open', 'is-nested');
    cdModal.setAttribute('aria-hidden', 'true');
    syncBodyModalOpen();
  }

  function reloadCdPage() {
    if (window.location.pathname === '/cham-cong') {
      window.location.href = '/cham-cong?tab=employees';
      return;
    }
    location.reload();
  }

  function reloadCdWithKeyword() {
    const params = new URLSearchParams();
    const kw = cdKeyword ? cdKeyword.value.trim() : '';
    if (kw) params.set('keyword', kw);
    if (window.location.pathname === '/cham-cong') {
      params.set('tab', 'employees');
      window.location.href = '/cham-cong?' + params.toString();
      return;
    }
    window.location.href = '/chuc-danh' + (params.toString() ? '?' + params.toString() : '');
  }

  document.getElementById('cdAddBtn')?.addEventListener('click', function() { openCdModal(null); });
  document.getElementById('ccFormPositionAdd')?.addEventListener('click', function() { openCdModal(null, { nested: true }); });
  document.getElementById('cdEmptyAdd')?.addEventListener('click', function(e) {
    e.preventDefault();
    openCdModal(null);
  });
  document.getElementById('cdCancelBtn').addEventListener('click', closeCdModal);
  document.getElementById('cdCloseBtn')?.addEventListener('click', closeCdModal);
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && cdModal.classList.contains('is-open')) {
      e.stopPropagation();
      closeCdModal();
    }
  });
  cdKeyword?.addEventListener('keydown', function(e) {
    if (e.key === 'Enter') reloadCdWithKeyword();
  });

  document.querySelectorAll('.cd-edit').forEach(function(btn) {
    btn.addEventListener('click', function() {
      const row = this.closest('tr');
      openCdModal({
        _id: row.dataset.id,
        ten_chuc_danh: row.querySelector('strong')?.textContent.trim() || '',
        mo_ta: row.children[1].textContent.trim() === '---' ? '' : row.children[1].textContent.trim(),
        trang_thai: row.querySelector('.status-pill')?.classList.contains('is-inactive') ? 'inactive' : 'active'
      });
    });
  });

  document.querySelectorAll('.cd-inactive').forEach(function(btn) {
    btn.addEventListener('click', async function() {
      const id = this.closest('tr').dataset.id;
      if (!confirm('Ngừng sử dụng chức danh này?')) return;
      const res = await fetch('/api/chuc-danh/' + id + '/inactive', {
        method: 'PATCH',
        headers: { 'Accept': 'application/json' }
      });
      const json = await res.json();
      if (!json.success) return alert(json.message || 'Lỗi');
      reloadCdPage();
    });
  });

  cdForm.addEventListener('submit', async function(e) {
    e.preventDefault();
    const payload = {
      ten_chuc_danh: document.getElementById('cdTen').value.trim(),
      mo_ta: document.getElementById('cdMoTa').value.trim(),
      trang_thai: document.getElementById('cdTrangThai').value
    };
    if (!payload.ten_chuc_danh) return alert('Vui lòng nhập tên chức danh');
    const url = cdEditId ? ('/api/chuc-danh/' + cdEditId) : '/api/chuc-danh';
    const method = cdEditId ? 'PUT' : 'POST';
    const res = await fetch(url, {
      method,
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify(payload)
    });
    const json = await res.json();
    if (!json.success) return alert(json.message || 'Lỗi lưu chức danh');
    if (cdModal.classList.contains('is-nested') && !cdEditId) {
      applyChucDanhToEmployeeSelect(json.data);
      closeCdModal();
      return;
    }
    reloadCdPage();
  });
</script>
