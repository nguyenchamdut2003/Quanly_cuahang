<section class="hr-table-panel">
  <table class="hr-table">
    <thead>
      <tr>
        <th>Tên phòng ban</th>
        <th>Mô tả</th>
        <th>Trạng thái</th>
        <th style="width:100px">Thao tác</th>
      </tr>
    </thead>
    <tbody id="pbTableBody">
      <% if (!(phongBans || []).length) { %>
        <tr><td colspan="4" class="hr-empty">Chưa có phòng ban. <a id="pbEmptyAdd">Nhấn vào đây để thêm phòng ban</a>.</td></tr>
      <% } %>
      <% (phongBans || []).forEach(function(pb) { %>
        <tr data-id="<%= pb._id %>">
          <td><strong><%= pb.ten_phong_ban || '---' %></strong></td>
          <td><%= pb.mo_ta || '---' %></td>
          <td>
            <span class="status-pill <%= pb.trang_thai === 'active' ? 'is-active' : 'is-inactive' %>">
              <%= pb.trang_thai === 'active' ? 'Đang sử dụng' : 'Ngừng sử dụng' %>
            </span>
          </td>
          <td>
            <div class="hr-actions">
              <button type="button" class="hr-btn-icon pb-edit" title="Sửa"><i class="fa-regular fa-pen-to-square"></i></button>
              <button type="button" class="hr-btn-icon pb-inactive" title="Ngừng sử dụng" <%= pb.trang_thai === 'inactive' ? 'disabled' : '' %>><i class="fa-solid fa-ban"></i></button>
            </div>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</section>
