<div class="modal-overlay" id="pbModal">
  <div class="modal-card">
    <div class="modal-head">
      <span id="pbModalTitle">Thêm phòng ban</span>
      <button type="button" class="modal-close-btn" id="pbCloseBtn" aria-label="Đóng">&times;</button>
    </div>
    <form id="pbForm" class="modal-body">
      <input type="hidden" id="pbId">
      <label>Tên phòng ban *<input id="pbTen" required></label>
      <label>Mô tả<textarea id="pbMoTa"></textarea></label>
      <label>Trạng thái
        <select id="pbTrangThai">
          <option value="active">Đang sử dụng</option>
          <option value="inactive">Ngừng sử dụng</option>
        </select>
      </label>
    </form>
    <div class="modal-foot">
      <button type="button" class="btn btn-light" id="pbCancelBtn">Bỏ qua</button>
      <button type="submit" class="btn btn-primary" form="pbForm" id="pbSaveBtn">Lưu</button>
    </div>
  </div>
</div>
