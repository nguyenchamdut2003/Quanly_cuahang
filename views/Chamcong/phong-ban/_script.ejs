<script>
  const pbModal = document.getElementById('pbModal');
  const pbForm = document.getElementById('pbForm');
  const pbKeyword = document.getElementById('pbKeyword');
  let pbEditId = '';

  function isEmployeeFormHostOpen() {
    const el = document.getElementById('ccEmployeeModal');
    return !!(el && el.classList.contains('is-open'));
  }

  function syncBodyModalOpen() {
    const hasCatalogModal = document.querySelector('.modal-overlay.is-open');
    const hasEmployeeModal = isEmployeeFormHostOpen();
    if (hasCatalogModal || hasEmployeeModal) {
      document.body.classList.add('modal-open');
      return;
    }
    document.body.classList.remove('modal-open');
  }

  function applyPhongBanToEmployeeSelect(data) {
    if (!data || !data._id) return;
    const id = String(data._id);
    const name = data.ten_phong_ban || '';
    ['ccFormDepartment', 'ccEmployeeDepartmentFilter'].forEach(function(selectId) {
      const el = document.getElementById(selectId);
      if (!el) return;
      let opt = Array.from(el.options).find(function(option) { return option.value === id; });
      if (!opt) {
        opt = document.createElement('option');
        opt.value = id;
        opt.textContent = name;
        el.appendChild(opt);
      } else if (name) {
        opt.textContent = name;
      }
    });
    const formSelect = document.getElementById('ccFormDepartment');
    if (formSelect) formSelect.value = id;
  }

  function openPbModal(item, options) {
    options = options || {};
    pbEditId = item && item._id ? String(item._id) : '';
    if (!pbEditId && pbForm) pbForm.reset();
    document.getElementById('pbModalTitle').textContent = pbEditId ? 'Sửa phòng ban' : 'Thêm phòng ban';
    document.getElementById('pbId').value = pbEditId;
    document.getElementById('pbTen').value = item && item.ten_phong_ban ? item.ten_phong_ban : '';
    document.getElementById('pbMoTa').value = item && item.mo_ta ? item.mo_ta : '';
    document.getElementById('pbTrangThai').value = item && item.trang_thai === 'inactive' ? 'inactive' : 'active';
    const nested = options.nested === true;
    pbModal.classList.toggle('is-nested', nested);
    pbModal.classList.add('is-open');
    pbModal.setAttribute('aria-hidden', 'false');
    syncBodyModalOpen();
    setTimeout(function() { document.getElementById('pbTen')?.focus(); }, 0);
  }

  function closePbModal() {
    pbModal.classList.remove('is-open', 'is-nested');
    pbModal.setAttribute('aria-hidden', 'true');
    syncBodyModalOpen();
  }

  function reloadPbPage() {
    if (window.location.pathname === '/cham-cong') {
      window.location.href = '/cham-cong?tab=employees';
      return;
    }
    location.reload();
  }

  function reloadPbWithKeyword() {
    const params = new URLSearchParams();
    const kw = pbKeyword ? pbKeyword.value.trim() : '';
    if (kw) params.set('keyword', kw);
    if (window.location.pathname === '/cham-cong') {
      params.set('tab', 'employees');
      window.location.href = '/cham-cong?' + params.toString();
      return;
    }
    window.location.href = '/phong-ban' + (params.toString() ? '?' + params.toString() : '');
  }

  document.getElementById('pbAddBtn')?.addEventListener('click', function() { openPbModal(null); });
  document.getElementById('ccFormDepartmentAdd')?.addEventListener('click', function() { openPbModal(null, { nested: true }); });
  document.getElementById('pbEmptyAdd')?.addEventListener('click', function(e) {
    e.preventDefault();
    openPbModal(null);
  });
  document.getElementById('pbCancelBtn').addEventListener('click', closePbModal);
  document.getElementById('pbCloseBtn')?.addEventListener('click', closePbModal);
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && pbModal.classList.contains('is-open')) {
      e.stopPropagation();
      closePbModal();
    }
  });
  pbKeyword?.addEventListener('keydown', function(e) {
    if (e.key === 'Enter') reloadPbWithKeyword();
  });

  document.querySelectorAll('.pb-edit').forEach(function(btn) {
    btn.addEventListener('click', function() {
      const row = this.closest('tr');
      openPbModal({
        _id: row.dataset.id,
        ten_phong_ban: row.querySelector('strong')?.textContent.trim() || '',
        mo_ta: row.children[1].textContent.trim() === '---' ? '' : row.children[1].textContent.trim(),
        trang_thai: row.querySelector('.status-pill')?.classList.contains('is-inactive') ? 'inactive' : 'active'
      });
    });
  });

  document.querySelectorAll('.pb-inactive').forEach(function(btn) {
    btn.addEventListener('click', async function() {
      const id = this.closest('tr').dataset.id;
      if (!confirm('Ngừng sử dụng phòng ban này?')) return;
      const res = await fetch('/api/phong-ban/' + id + '/inactive', {
        method: 'PATCH',
        headers: { 'Accept': 'application/json' }
      });
      const json = await res.json();
      if (!json.success) return alert(json.message || 'Lỗi');
      reloadPbPage();
    });
  });

  pbForm.addEventListener('submit', async function(e) {
    e.preventDefault();
    const payload = {
      ten_phong_ban: document.getElementById('pbTen').value.trim(),
      mo_ta: document.getElementById('pbMoTa').value.trim(),
      trang_thai: document.getElementById('pbTrangThai').value
    };
    if (!payload.ten_phong_ban) return alert('Vui lòng nhập tên phòng ban');
    const url = pbEditId ? ('/api/phong-ban/' + pbEditId) : '/api/phong-ban';
    const method = pbEditId ? 'PUT' : 'POST';
    const res = await fetch(url, {
      method,
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify(payload)
    });
    const json = await res.json();
    if (!json.success) return alert(json.message || 'Lỗi lưu phòng ban');
    if (pbModal.classList.contains('is-nested') && !pbEditId) {
      applyPhongBanToEmployeeSelect(json.data);
      closePbModal();
      return;
    }
    reloadPbPage();
  });
</script>
