<script>
  const knModal = document.getElementById('knModal');
  const knForm = document.getElementById('knForm');
  const knKeyword = document.getElementById('knKeyword');
  let knEditId = '';
  let knCurrentSubtab = 'khoan-nop';

  function isEmployeeFormHostOpen() {
    const el = document.getElementById('ccEmployeeModal');
    return !!(el && el.classList.contains('is-open'));
  }

  function syncBodyModalOpen() {
    const hasCatalogModal = document.querySelector('.modal-overlay.is-open');
    const hasEmployeeModal = isEmployeeFormHostOpen();
    if (hasCatalogModal || hasEmployeeModal) {
      document.body.classList.add('modal-open');
      return;
    }
    document.body.classList.remove('modal-open');
  }

  function formatRateLabel(value) {
    const num = Number(value != null ? value : 0);
    return (Number.isFinite(num) ? num : 0).toLocaleString('vi-VN') + '% Người lao động';
  }

  function applyKhoanNopToEmployeeForm(data) {
    if (!data || !data._id) return;
    if (data.trang_thai === 'inactive') return;
    const list = document.getElementById('ccContributionList');
    if (!list) return;
    const id = String(data._id);
    const existing = list.querySelector('.cc-contribution-enabled[value="' + id + '"]');
    if (existing) {
      existing.checked = true;
      return;
    }
    const help = list.querySelector('.cc-help-text');
    if (help) help.remove();
    const label = document.createElement('label');
    label.className = 'cc-contribution-item';
    const left = document.createElement('span');
    const checkbox = document.createElement('input');
    checkbox.type = 'checkbox';
    checkbox.className = 'cc-contribution-enabled';
    checkbox.value = id;
    checkbox.checked = true;
    left.appendChild(checkbox);
    left.appendChild(document.createTextNode(' ' + (data.ten_khoan || '')));
    const rate = document.createElement('span');
    rate.className = 'cc-contribution-rate';
    rate.textContent = formatRateLabel(data.ti_le_nld != null ? data.ti_le_nld : data.ti_le);
    label.appendChild(left);
    label.appendChild(rate);
    list.appendChild(label);
  }

  function getRowItem(row) {
    return {
      _id: row.dataset.id || '',
      ma_khoan: row.dataset.maKhoan || '',
      ten_khoan: row.dataset.tenKhoan || '',
      noi_nop_id: row.dataset.noiNopId || '',
      ti_le_nld: row.dataset.tiLeNld || '0',
      ti_le_nsdld: row.dataset.tiLeNsdld || '0',
      trang_thai: row.dataset.trangThai || 'active'
    };
  }

  function openKnModal(item, options) {
    options = options || {};
    knEditId = item && item._id ? String(item._id) : '';
    if (!knEditId && knForm) knForm.reset();
    document.getElementById('knModalTitle').textContent = knEditId ? 'Sửa khoản nộp' : 'Thêm khoản nộp';
    document.getElementById('knId').value = knEditId;
    document.getElementById('knTenKhoan').value = item && item.ten_khoan ? item.ten_khoan : '';
    document.getElementById('knNoiNop').value = item && item.noi_nop_id ? item.noi_nop_id : '';
    document.getElementById('knTiLeNld').value = item && item.ti_le_nld ? item.ti_le_nld : '0';
    document.getElementById('knTiLeNsdld').value = item && item.ti_le_nsdld ? item.ti_le_nsdld : '0';
    document.getElementById('knTrangThai').value = item && item.trang_thai === 'inactive' ? 'inactive' : 'active';
    const nested = options.nested === true;
    knModal.classList.toggle('is-nested', nested);
    knModal.classList.add('is-open');
    knModal.setAttribute('aria-hidden', 'false');
    syncBodyModalOpen();
    setTimeout(function() { document.getElementById('knTenKhoan')?.focus(); }, 0);
  }

  function closeKnModal() {
    knModal.classList.remove('is-open', 'is-nested');
    knModal.setAttribute('aria-hidden', 'true');
    syncBodyModalOpen();
  }

  function switchKnSubtab(tab) {
    knCurrentSubtab = tab === 'noi-nop' ? 'noi-nop' : 'khoan-nop';
    document.querySelectorAll('[data-kn-subtab]').forEach(function(btn) {
      btn.classList.toggle('is-active', btn.dataset.knSubtab === knCurrentSubtab);
      btn.setAttribute('aria-selected', btn.dataset.knSubtab === knCurrentSubtab ? 'true' : 'false');
    });
    document.querySelectorAll('[data-kn-subpane]').forEach(function(pane) {
      pane.classList.toggle('is-active', pane.dataset.knSubpane === knCurrentSubtab);
    });
  }

  function reloadKnPage(subtab) {
    const activeSubtab = subtab || knCurrentSubtab || 'khoan-nop';
    if (window.location.pathname === '/cham-cong') {
      window.location.href = '/cham-cong?tab=contributions&subtab=' + encodeURIComponent(activeSubtab);
      return;
    }
    window.location.href = '/chamcongmoi/khoan-nop/danh-muc?subtab=' + encodeURIComponent(activeSubtab);
  }

  function reloadKnWithKeyword() {
    const params = new URLSearchParams();
    const kw = knKeyword ? knKeyword.value.trim() : '';
    if (kw) params.set('keyword', kw);
    params.set('subtab', 'khoan-nop');
    if (window.location.pathname === '/cham-cong') {
      params.set('tab', 'contributions');
      window.location.href = '/cham-cong?' + params.toString();
      return;
    }
    window.location.href = '/chamcongmoi/khoan-nop/danh-muc' + (params.toString() ? '?' + params.toString() : '');
  }

  document.getElementById('knAddBtn')?.addEventListener('click', function() { openKnModal(null); });
  document.getElementById('ccFormContributionAdd')?.addEventListener('click', function() { openKnModal(null, { nested: true }); });
  document.getElementById('knEmptyAdd')?.addEventListener('click', function(e) {
    e.preventDefault();
    openKnModal(null);
  });
  document.getElementById('knCancelBtn')?.addEventListener('click', closeKnModal);
  document.getElementById('knCloseBtn')?.addEventListener('click', closeKnModal);
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && knModal.classList.contains('is-open')) {
      e.stopPropagation();
      closeKnModal();
    }
  });
  knKeyword?.addEventListener('keydown', function(e) {
    if (e.key === 'Enter') reloadKnWithKeyword();
  });
  document.querySelectorAll('[data-kn-subtab]').forEach(function(btn) {
    btn.addEventListener('click', function() { switchKnSubtab(btn.dataset.knSubtab); });
  });
  switchKnSubtab(new URLSearchParams(window.location.search).get('subtab'));

  document.getElementById('nnAddBtn')?.addEventListener('click', async function() {
    const payload = {
      ma_noi_nop: (document.getElementById('nnMaNoiNop')?.value || '').trim(),
      ten_noi_nop: (document.getElementById('nnTenNoiNop')?.value || '').trim()
    };
    if (!payload.ten_noi_nop) return alert('Vui lòng nhập tên nơi nộp');

    const res = await fetch('/chamcongmoi/khoan-nop/noi-nop', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify(payload)
    });
    const json = await res.json();
    if (!json.success) return alert(json.message || 'Lỗi thêm nơi nộp');
    reloadKnPage('noi-nop');
  });

  document.querySelectorAll('.kn-edit').forEach(function(btn) {
    btn.addEventListener('click', function() {
      openKnModal(getRowItem(this.closest('tr')));
    });
  });

  document.querySelectorAll('.kn-status').forEach(function(btn) {
    btn.addEventListener('click', async function() {
      const item = getRowItem(this.closest('tr'));
      const nextStatus = item.trang_thai === 'active' ? 'inactive' : 'active';
      const message = nextStatus === 'active'
        ? 'Kích hoạt lại khoản nộp này?'
        : 'Ngừng sử dụng khoản nộp này?';
      if (!confirm(message)) return;

      const res = await fetch('/chamcongmoi/khoan-nop/danh-muc/' + encodeURIComponent(item._id) + '/trang-thai', {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ trang_thai: nextStatus })
      });
      const json = await res.json();
      if (!json.success) return alert(json.message || 'Lỗi cập nhật trạng thái');
      reloadKnPage('khoan-nop');
    });
  });

  knForm.addEventListener('submit', async function(e) {
    e.preventDefault();
    const payload = {
      ten_khoan: document.getElementById('knTenKhoan').value.trim(),
      noi_nop_id: document.getElementById('knNoiNop').value,
      ti_le_nld: document.getElementById('knTiLeNld').value,
      ti_le_nsdld: document.getElementById('knTiLeNsdld').value,
      trang_thai: document.getElementById('knTrangThai').value
    };

    if (!payload.ten_khoan) return alert('Vui lòng nhập tên khoản');
    if (!payload.noi_nop_id) return alert('Vui lòng chọn nơi nộp');

    const url = knEditId
      ? '/chamcongmoi/khoan-nop/danh-muc/' + encodeURIComponent(knEditId)
      : '/chamcongmoi/khoan-nop/danh-muc';
    const method = knEditId ? 'PUT' : 'POST';

    const res = await fetch(url, {
      method,
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify(payload)
    });
    const json = await res.json();
    if (!json.success) return alert(json.message || 'Lỗi lưu khoản nộp');
    if (knModal.classList.contains('is-nested') && !knEditId) {
      applyKhoanNopToEmployeeForm(json.data);
      closeKnModal();
      return;
    }
    reloadKnPage('khoan-nop');
  });
</script>
