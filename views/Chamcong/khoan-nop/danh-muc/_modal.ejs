<div class="modal-overlay" id="knModal" aria-hidden="true">
  <div class="modal-card">
    <div class="modal-head">
      <span id="knModalTitle">Thêm khoản nộp</span>
      <button type="button" class="modal-close-btn" id="knCloseBtn" aria-label="Đóng">&times;</button>
    </div>
    <form id="knForm" class="modal-body">
      <input type="hidden" id="knId">
      <label>Tên khoản *<input id="knTenKhoan" required></label>
      <label>Nơi nộp *
        <select id="knNoiNop" required>
          <option value="">Chọn nơi nộp</option>
          <% (noiNops || []).filter(function(item) { return item.trang_thai !== 'inactive'; }).forEach(function(item) { %>
            <option value="<%= item._id %>"><%= item.ma_noi_nop || '' %> - <%= item.ten_noi_nop || '' %></option>
          <% }) %>
        </select>
      </label>
      <label>Người lao động (%)<input id="knTiLeNld" type="number" min="0" step="0.01" value="0"></label>
      <label>Người sử dụng lao động (%)<input id="knTiLeNsdld" type="number" min="0" step="0.01" value="0"></label>
      <label>Trạng thái
        <select id="knTrangThai">
          <option value="active">Đang sử dụng</option>
          <option value="inactive">Ngừng sử dụng</option>
        </select>
      </label>
    </form>
    <div class="modal-foot">
      <button type="button" class="btn btn-light" id="knCancelBtn">Bỏ qua</button>
      <button type="submit" class="btn btn-primary" form="knForm" id="knSaveBtn">Lưu</button>
    </div>
  </div>
</div>
