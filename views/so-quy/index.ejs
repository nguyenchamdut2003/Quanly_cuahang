      }
      const nvc=relDocObject(receipt.nhap_vat_chua_id);
      if(nvc){
        const docVal=Number(nvc.tong_tien||0)||null;
        pushRow({type:'nhap_vat_chua',typeLabel:'Nhập vật chứa',code:nvc.ma_nhap_vat_chua,docId:receiptDocId(nvc),docDate:nvc.created_at,partner:relTextCell(nvc.doi_tuong_ten||receipt.doi_tuong),docValue:docVal,paidBefore:null,receiptValue:defaultReceiptValue,remainAfter:null,status:getRelatedDocumentStatus('nhap_vat_chua',nvc)});
      }
