      const type=documentType.value;
      toggleOtherDocumentInput();
      if(!type){relatedDocRows=[];documentSelect.innerHTML='<option value="">Không cần chọn</option>';updateSelectedRelatedDocHint();return}
      if(type==='khac'){relatedDocRows=[];documentSelect.innerHTML='<option value="">Nhập chứng từ khác</option>';updateSelectedRelatedDocHint();return}
      const group=subjectGroup.value;
