  <div id="receiptDetailModal" class="modal-backdrop">
    <div class="modal">
      <div class="modal-head"><h2 id="receiptDetailTitle">Chi tiết phiếu</h2><button type="button" class="modal-close" onclick="closeReceiptDetailModal()">&times;</button></div>
      <div class="modal-body" id="receiptDetailBody"></div>
      <div class="page-actions modal-foot"><button type="button" class="modal-btn" onclick="closeReceiptDetailModal()">Đóng</button></div>
    </div>
  </div>
  </div>
  <%- include('../partials/global-loading') %>

  <script src="/javascripts/global-loading.js"></script>
  <script>
    const receipts = <%- JSON.stringify(safeList.map(item => ({_id:String(item._id),ma_phieu:item.ma_phieu,loai_phieu:item.loai_phieu,loai_thu_chi:item.loai_thu_chi||'',gia_tri:item.gia_tri||0,chi_tiet_thanh_toan:item.chi_tiet_thanh_toan||{},phuong_thuc_thanh_toan:item.phuong_thuc_thanh_toan||'',nhom_doi_tuong:item.nhom_doi_tuong||'',trang_thai:item.trang_thai||'',hach_toan:!!item.hach_toan,doi_tuong:item.doi_tuong||'',ghi_chu:item.ghi_chu||'',ngay_lap:item.ngay_lap,so_quy:item.so_quy_id?.ten_so_quy||'Chưa phân sổ',chung_tu_khac:item.chung_tu_khac||'',chung_tu:item.chung_tu_khac?'Khác':codeOf(item)}))) %>;
    const customers = <%- JSON.stringify(safeCustomers.map(item => ({_id:String(item._id),name:item.ten_khach_hang,code:item.ma_khach_hang,phone:item.sdt||''}))) %>;
    const suppliers = <%- JSON.stringify(safeSuppliers.map(item => ({_id:String(item._id),name:item.ten_ncc,code:item.ma_ncc,phone:item.sdt||''}))) %>;
    const employees = <%- JSON.stringify(safeEmployees.map(item => ({_id:String(item._id),name:item.ten_nhan_vien,code:item.ma_nhan_vien,phone:item.sdt||''}))) %>;
    const carriers = <%- JSON.stringify(safeCarriers.map(item => ({_id:String(item._id),name:item.ten_doi_tac,code:item.ma_doi_tac,phone:item.sdt||''}))) %>;
    const partnerLists = { khach_hang: customers, nha_cung_cap: suppliers, nhan_vien: employees, doi_tac_giao_hang: carriers };
    const thuDocOptions = [{value:'',label:'Không chọn'},{value:'don_hang',label:'Đơn hàng'},{value:'hoa_don',label:'Hóa đơn bán hàng'},{value:'phieu_tra_hang_nhap',label:'Phiếu trả hàng nhập'},{value:'van_don',label:'Vận đơn/COD'},{value:'khac',label:'Khác'}];
    const chiDocOptions = [{value:'',label:'Không chọn'},{value:'phieu_nhap',label:'Phiếu nhập'},{value:'phieu_tra_hang',label:'Phiếu trả hàng bán'},{value:'bang_luong',label:'Bảng lương'},{value:'ct_bang_luong',label:'Chi tiết bảng lương'},{value:'van_don',label:'Vận đơn/phí giao hàng'},{value:'don_hang',label:'Đơn hàng (hoàn tiền)'},{value:'hoa_don',label:'Hóa đơn (hoàn tiền)'},{value:'khac',label:'Khác'}];
    let relatedDocRows=[];
    let selectedRelatedDoc=null;
    const DOC_HIDDEN_IDS = ['donHangId','hoaDonId','phieuNhapId','phieuTraHangNhapId','phieuTraHangId','vanDonId','bangLuongId','ctBangLuongId','maChungTuGoc'];
    const fmt = n => Number(n || 0).toLocaleString('vi-VN');
    const fmtMoney = n => fmt(n) + ' VNĐ';
    let cashBookState=[];
    let cashBookTrashIds=[];
    function cashEscape(value){return String(value ?? '').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]))}
    async function parseApiResponse(res,fallbackMessage){
      const contentType=String(res.headers.get('content-type')||'');
      if(contentType.includes('application/json')){
        const json=await res.json();
        if(!res.ok&&!json.message)json.message=fallbackMessage||'Không xử lý được yêu cầu.';
        return json;
      }
      if(res.status===401||res.status===403){
        throw new Error('Phiên đăng nhập đã hết hạn hoặc bạn không có quyền. Vui lòng tải lại trang và đăng nhập lại.');
      }
      throw new Error(fallbackMessage||('Máy chủ trả về phản hồi không hợp lệ (HTTP '+res.status+').'));
    }
    function cashBookFetchOptions(method,payload){
      const options={method,headers:{'Accept':'application/json'},credentials:'same-origin'};
      if(payload!==undefined){
        if(payload instanceof FormData){
          options.body=payload;
        }else{
          options.headers['Content-Type']='application/json';
          options.body=JSON.stringify(payload);
        }
      }
      return options;
    }
    function showCashBookMessage(message,type='success'){const el=document.getElementById('cashBookMessage');if(!el)return;el.textContent=message;el.className='cashbook-message show '+type;setTimeout(()=>{el.className='cashbook-message'},3000)}
    function cashBookTypeLabel(value){return value==='chuyen_khoan'?'Chuyển khoản':'Tiền mặt'}
    function cashBookStatusLabel(value){return value==='inactive'?'Ngừng sử dụng':'Đang sử dụng'}
    function cashBookFormEls(){return{
      form:document.getElementById('cashBookForm'),
      type:document.getElementById('cashBookTypeInput'),
      status:document.getElementById('cashBookStatusInput'),
      def:document.getElementById('cashBookDefaultInput'),
      mode:document.getElementById('cashBookFormMode'),
      bankWrap:document.getElementById('cashBookBankFields'),
      bankName:document.getElementById('cashBookBankNameInput'),
      accountNo:document.getElementById('cashBookAccountNumberInput'),
      accountOwner:document.getElementById('cashBookAccountOwnerInput'),
      bankBranch:document.getElementById('cashBookBankBranchInput'),
      image:document.getElementById('cashBookImageInput'),
      imagePreview:document.getElementById('cashBookImagePreview'),
      saveBtn:document.getElementById('cashBookSaveBtn'),
      cancelBtn:document.getElementById('cashBookCancelEditBtn')
    }}
    let editingCashBookId='';
    function toggleCashBookBankFields(){
      const el=cashBookFormEls();
      const isBank=el.type&&el.type.value==='chuyen_khoan';
      if(el.bankWrap)el.bankWrap.classList.toggle('is-hidden',!isBank);
      [el.bankName,el.accountNo,el.accountOwner,el.bankBranch].forEach(input=>{if(input)input.disabled=!isBank});
      if(!isBank)[el.bankName,el.accountNo,el.accountOwner,el.bankBranch].forEach(input=>{if(input)input.value=''});
    }
    function resetCashBookForm(){
      const el=cashBookFormEls();
      editingCashBookId='';
      if(el.form)el.form.reset();
      updateCashBookImagePreview(null);
      if(el.type)el.type.value='tien_mat';
      if(el.status)el.status.value='active';
      if(el.def)el.def.checked=false;
      if(el.mode)el.mode.value='Thêm mới';
      if(el.saveBtn)el.saveBtn.textContent='Thêm sổ';
      if(el.cancelBtn)el.cancelBtn.style.display='none';
      toggleCashBookBankFields();
    }
    function fillCashBookForm(id){
      const row=cashBookState.find(item=>String(item._id)===String(id));
      if(!row)return showCashBookMessage('Không tìm thấy sổ quỹ cần sửa.','error');
      const el=cashBookFormEls();
      const bank=row.thong_tin_ngan_hang||{};
      editingCashBookId=String(row._id||'');
      if(el.type)el.type.value=row.loai_so_quy==='chuyen_khoan'?'chuyen_khoan':'tien_mat';
      if(el.status)el.status.value=row.trang_thai==='inactive'?'inactive':'active';
      if(el.def)el.def.checked=!!row.mac_dinh;
      if(el.bankName)el.bankName.value=bank.ten_ngan_hang||'';
      if(el.accountNo)el.accountNo.value=bank.so_tai_khoan||'';
      if(el.accountOwner)el.accountOwner.value=bank.chu_tai_khoan||'';
      if(el.bankBranch)el.bankBranch.value=bank.chi_nhanh_ngan_hang||'';
      if(el.image)el.image.value='';
      updateCashBookImagePreview(row.anh_so_quy);
      if(el.mode)el.mode.value='Sửa: '+(row.ten_so_quy||'');
      if(el.saveBtn)el.saveBtn.textContent='Lưu thay đổi';
      if(el.cancelBtn)el.cancelBtn.style.display='';
      toggleCashBookBankFields();
      if(el.type)el.type.focus();
    }
    function readCashBookPayload(){
      const el=cashBookFormEls();
      const payload={
        loai_so_quy:el.type&&el.type.value==='chuyen_khoan'?'chuyen_khoan':'tien_mat',
        trang_thai:el.status&&el.status.value==='inactive'?'inactive':'active',
        mac_dinh:!!(el.def&&el.def.checked)
      };
      if(payload.loai_so_quy==='chuyen_khoan'){
        payload.thong_tin_ngan_hang={
          ten_ngan_hang:(el.bankName&&el.bankName.value||'').trim(),
          so_tai_khoan:(el.accountNo&&el.accountNo.value||'').trim(),
          chu_tai_khoan:(el.accountOwner&&el.accountOwner.value||'').trim(),
          chi_nhanh_ngan_hang:(el.bankBranch&&el.bankBranch.value||'').trim()
        };
      }
      return payload;
    }
    function updateCashBookImagePreview(image){
      const el=cashBookFormEls();
      if(!el.imagePreview)return;
      const url=image&&image.url?String(image.url):'';
      el.imagePreview.innerHTML=url?`<img src="${cashEscape(url)}" alt=""><span>Đã có ảnh</span>`:'<span>Chưa có ảnh</span>';
    }
    function cashBookImageCell(row){
      const image=row.anh_so_quy||{};
      const url=image.url?String(image.url):'';
      return url?`<img class="cashbook-thumb" src="${cashEscape(url)}" alt="">`:'<span class="cashbook-thumb-empty">--</span>';
    }
    function buildCashBookSubmitBody(payload){
      const el=cashBookFormEls();
      const file=el.image&&el.image.files&&el.image.files[0]?el.image.files[0]:null;
      if(!file)return payload;
      const form=new FormData();
      Object.keys(payload).forEach(key=>{
        if(key==='thong_tin_ngan_hang')form.append(key,JSON.stringify(payload[key]||{}));
        else form.append(key,String(payload[key]));
      });
      form.append('anh_so_quy',file);
      return form;
    }
    function validateCashBookPayload(payload){
      if(payload.loai_so_quy!=='chuyen_khoan')return true;
      const el=cashBookFormEls();
      const bank=payload.thong_tin_ngan_hang||{};
      const required=[
        {value:bank.ten_ngan_hang,input:el.bankName,message:'Vui lòng nhập tên ngân hàng.'},
        {value:bank.so_tai_khoan,input:el.accountNo,message:'Vui lòng nhập số tài khoản.'},
        {value:bank.chu_tai_khoan,input:el.accountOwner,message:'Vui lòng nhập chủ tài khoản.'}
      ];
      const missing=required.find(item=>!item.value);
      if(missing){showCashBookMessage(missing.message,'error');if(missing.input)missing.input.focus();return false}
      return true;
    }
    function cashBookBankCell(row){
      const bank=row.thong_tin_ngan_hang||{};
      if(row.loai_so_quy!=='chuyen_khoan')return '<span class="cashbook-bank-cell">--</span>';
      const name=cashEscape(bank.ten_ngan_hang||'');
      const account=cashEscape(bank.so_tai_khoan||'');
      return `<span class="cashbook-bank-cell"><strong>${name||'--'}</strong><span>${account||'--'}</span></span>`;
    }
    function renderCashBookDataRow(row){
      const id=String(row._id||'');
      const type=row.loai_so_quy==='chuyen_khoan'?'chuyen_khoan':'tien_mat';
      const status=row.trang_thai==='inactive'?'inactive':'active';
      const bank=row.thong_tin_ngan_hang||{};
      return `<tr data-cashbook-id="${cashEscape(id)}"><td><strong>${cashEscape(row.ten_so_quy||'')}</strong></td><td><span class="cashbook-badge cashbook-type ${type==='chuyen_khoan'?'bank':'cash'}">${cashBookTypeLabel(type)}</span></td><td>${cashBookBankCell(row)}</td><td>${cashEscape(type==='chuyen_khoan'?(bank.chu_tai_khoan||'--'):'--')}</td><td>${row.mac_dinh?'<span class="cashbook-badge cashbook-default">Mặc định</span>':'--'}</td><td><span class="cashbook-badge cashbook-status ${status}">${cashBookStatusLabel(status)}</span></td><td class="cashbook-actions"><button type="button" class="mini-btn primary js-cashbook-edit" data-id="${cashEscape(id)}">Sửa</button><button type="button" class="mini-btn danger js-cashbook-delete" data-id="${cashEscape(id)}">Xóa</button></td></tr>`;
    }
    renderCashBookDataRow=function(row){
      const id=String(row._id||'');
      const type=row.loai_so_quy==='chuyen_khoan'?'chuyen_khoan':'tien_mat';
      const status=row.trang_thai==='inactive'?'inactive':'active';
      const bank=row.thong_tin_ngan_hang||{};
      return `<tr data-cashbook-id="${cashEscape(id)}"><td><strong>${cashEscape(row.ten_so_quy||'')}</strong></td><td>${cashBookImageCell(row)}</td><td><span class="cashbook-badge cashbook-type ${type==='chuyen_khoan'?'bank':'cash'}">${cashBookTypeLabel(type)}</span></td><td>${cashBookBankCell(row)}</td><td>${cashEscape(type==='chuyen_khoan'?(bank.chu_tai_khoan||'--'):'--')}</td><td>${row.mac_dinh?'<span class="cashbook-badge cashbook-default">Mặc định</span>':'--'}</td><td><span class="cashbook-badge cashbook-status ${status}">${cashBookStatusLabel(status)}</span></td><td class="cashbook-actions"><button type="button" class="mini-btn primary js-cashbook-edit" data-id="${cashEscape(id)}">Sửa</button><button type="button" class="mini-btn danger js-cashbook-delete" data-id="${cashEscape(id)}">Xóa</button></td></tr>`;
    }
    function renderCashBooks(rows){
      const body=document.getElementById('cashBookRows');
      if(!body)return;
      if(!rows.length){
        body.innerHTML=`<tr><td colspan="8" class="cashbook-empty"><strong>Chưa có sổ quỹ nào.</strong>Tạo sổ bằng form phía trên.</td></tr>`;
        return;
      }
      body.innerHTML=(rows||[]).map(renderCashBookDataRow).join('');
    }
    function cashBookFilterQuery(){
      const params=new URLSearchParams();
      const type=document.getElementById('cashBookTypeFilter')?.value||'all';
      const status=document.getElementById('cashBookStatusFilter')?.value||'all';
      if(type!=='all')params.set('loai_so_quy',type);
      if(status!=='all')params.set('trang_thai',status);
      const query=params.toString();
      return query?'?'+query:'';
    }
    async function submitCashBookForm(event){
      if(event)event.preventDefault();
      const payload=readCashBookPayload();
      if(!validateCashBookPayload(payload))return;
      const currentRow=editingCashBookId?cashBookState.find(item=>String(item._id)===String(editingCashBookId)):null;
      if(payload.trang_thai==='inactive'&&(payload.mac_dinh||currentRow?.mac_dinh)&&!confirm('Sổ mặc định đang được chuyển sang ngừng sử dụng. Bạn có muốn tiếp tục?'))return;
      const el=cashBookFormEls();
      if(el.saveBtn)el.saveBtn.disabled=true;
      try{
        const url=editingCashBookId?'/api/so-quy/'+encodeURIComponent(editingCashBookId):'/api/so-quy';
        const method=editingCashBookId?'PUT':'POST';
        const res=await fetch(url,cashBookFetchOptions(method,buildCashBookSubmitBody(payload)));
        const result=await parseApiResponse(res,'Không lưu được sổ quỹ');
        if(!result.success)throw new Error(result.message||'Không lưu được sổ quỹ');
        showCashBookMessage(result.message||(editingCashBookId?'Sửa thành công':'Thêm sổ quỹ thành công'),'success');
        resetCashBookForm();
        await loadCashBooks();
        await reloadActiveCashBookDropdown();
      }catch(error){
        showCashBookMessage(error.message||'Không lưu được sổ quỹ','error');
      }finally{
        if(el.saveBtn)el.saveBtn.disabled=false;
      }
    }
    async function loadCashBooks(){
      const body=document.getElementById('cashBookRows');
      if(body)body.innerHTML='<tr><td colspan="8" class="cashbook-empty">Đang tải danh sách sổ quỹ...</td></tr>';
      try{
        const res=await fetch('/api/so-quy'+cashBookFilterQuery(),cashBookFetchOptions('GET'));
