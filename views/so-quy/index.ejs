    function formatReceiptDate(value){if(!value)return'';const d=new Date(value);return Number.isNaN(d.getTime())?'':d.toLocaleDateString('vi-VN')}
    function applyCashTimeFilter(clear){
      const form=document.querySelector('form.page');
      if(!form)return;
      let timeTypeInput=form.querySelector('input[name="time_type"]');
      if(!timeTypeInput){timeTypeInput=document.createElement('input');timeTypeInput.type='hidden';timeTypeInput.name='time_type';form.appendChild(timeTypeInput)}
      const dateFrom=form.querySelector('input[name="date_from"]');
      const dateTo=form.querySelector('input[name="date_to"]');
      if(clear){
        timeTypeInput.value='';
        if(dateFrom)dateFrom.value='';
        if(dateTo)dateTo.value='';
        form.submit();
        return;
      }
      const mode=form.querySelector('input[name="time_mode"]:checked')?.value||'all';
      if(mode==='this_month'){
        timeTypeInput.value='this_month';
        if(dateFrom)dateFrom.value='';
        if(dateTo)dateTo.value='';
      }else if(mode==='custom'){
        timeTypeInput.value='';
      }else{
        timeTypeInput.value='';
        if(dateFrom)dateFrom.value='';
        if(dateTo)dateTo.value='';
      }
      form.submit();
    }
    (function initCashTimeFilter(){
      const btn=document.getElementById('cashTimeFilterBtn');
      const panel=document.getElementById('cashTimeFilterPanel');
      const applyBtn=document.getElementById('cashTimeFilterApply');
      const clearBtn=document.getElementById('cashTimeFilterClear');
      if(!btn||!panel)return;
      btn.addEventListener('click',function(event){
        event.stopPropagation();
        panel.classList.toggle('is-open');
        const bookPanel=document.getElementById('cashBookFilterPanel');
        if(bookPanel)bookPanel.classList.remove('is-open');
      });
      if(applyBtn)applyBtn.addEventListener('click',function(){applyCashTimeFilter(false)});
      if(clearBtn)clearBtn.addEventListener('click',function(){applyCashTimeFilter(true)});
      document.addEventListener('click',function(event){
        if(panel.contains(event.target)||btn.contains(event.target))return;
        panel.classList.remove('is-open');
      });
