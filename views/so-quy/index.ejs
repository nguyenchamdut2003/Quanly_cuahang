    if (item.so_quy_id?.ten_so_quy) return item.so_quy_id.ten_so_quy;
    const detail = item.chi_tiet_thanh_toan || {};
    return [paymentBookLabel(detail.so_quy_tien_mat_id), paymentBookLabel(detail.so_quy_chuyen_khoan_id)].filter(Boolean).join(' + ') || 'Chưa phân sổ';
