    function showReceiptPaymentMessage(message,type){const el=receiptPaymentEls().message;if(!el)return;el.textContent=message||'';el.className=message?'receipt-payment-message show '+(type||'error'):'receipt-payment-message'}
    function resetReceiptPaymentForm(){
      const el=receiptPaymentEls();
      [el.cash,el.bank,el.refund].forEach(input=>{if(input)input.value=''});
      if(el.amount)el.amount.value='0';
