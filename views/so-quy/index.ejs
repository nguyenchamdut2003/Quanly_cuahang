      }else if(!rows.length&&String(receipt.ma_chung_tu_goc||'').trim()){
        pushRow({type:'',typeLabel:'Chứng từ gốc',code:receipt.ma_chung_tu_goc,docId:'',docDate:receipt.ngay_lap,partner:relTextCell(receipt.doi_tuong),docValue:null,paidBefore:null,receiptValue:defaultReceiptValue,remainAfter:null,status:'Mã chứng từ gốc'});
      }
      return rows;
    }
    function buildRelatedDocumentTable(receipt){
      const rows=buildRelatedDocumentRows(receipt);
      if(!rows.length)return '<div class="receipt-related-docs-empty">Phiếu này chưa gắn chứng từ liên quan.</div>';
      const head='<thead><tr><th>Loại chứng từ</th><th>Mã chứng từ</th><th>Ngày chứng từ</th><th>Đối tượng</th><th class="num">Giá trị phiếu này</th><th class="num">Còn lại sau phiếu</th><th>Trạng thái</th><th>Thao tác</th></tr></thead>';
      const body=rows.map(row=>{
        const codeCell=row.docId?receiptDocLink(row.type,row.docId,row.code||'—'):relTextCell(row.code||'—');
        const href=getRelatedDocumentLink(row.type,row.docId);
        const action=href?`<a class="receipt-inline-link ref-link" href="${href}">Xem</a>`:'—';
        return `<tr><td>${relTextCell(row.typeLabel)}</td><td>${codeCell}</td><td>${row.docDate?relTextCell(formatReceiptDate(row.docDate)):'—'}</td><td>${relTextCell(row.partner)}</td><td class="num">${relMoneyCell(row.receiptValue)}</td><td class="num">${relMoneyCell(row.remainAfter)}</td><td>${relTextCell(row.status)}</td><td>${action}</td></tr>`;
      }).join('');
      return `<div class="receipt-inline-allocation"><div class="receipt-inline-allocation-title">Chứng từ liên quan</div><div class="receipt-related-docs-scroll"><table class="receipt-related-docs-table">${head}<tbody>${body}</tbody></table></div></div>`;
    }
    function buildReceiptRelatedDocumentsSection(receipt){if(String(receipt.chung_tu_khac||'').trim())return'';return buildRelatedDocumentTable(receipt)}
    function buildReceiptOtherDocumentField(receipt){const otherDoc=String(receipt.chung_tu_khac||'').trim();return otherDoc?`<div class="receipt-other-doc"><span>Mã chứng từ</span><b>${escapeHtml(otherDoc)}</b></div>`:''}
    function buildReceiptOverpayment(receipt){const amount=Number(receipt.overpayment_amount||0);if(amount<=0)return'';return `<div class="receipt-inline-note"><strong>Trả dư / ứng trước NCC:</strong> ${fmt(amount)}</div>`}
    function toNumber(value){return Math.max(0,Number(value)||0)}
    function receiptPaymentBookName(book){if(!book||typeof book!=='object')return'';const bank=book.thong_tin_ngan_hang||{};return [bank.ten_ngan_hang,bank.so_tai_khoan].filter(Boolean).join(' - ')||book.ten_so_quy||''}
    function resolveReceiptPaymentDetail(receipt,item){
      const source=receipt||item||{};
      const detail=source.chi_tiet_thanh_toan||{};
      let tienMat=toNumber(detail.tien_mat);
      let chuyenKhoan=toNumber(detail.chuyen_khoan);
      let tienTraKhach=toNumber(detail.tien_tra_khach);
      const giaTri=toNumber(source.gia_tri!=null?source.gia_tri:item?.gia_tri);
      const phuongThuc=source.phuong_thuc_thanh_toan||item?.phuong_thuc_thanh_toan||'';
      if(tienMat+chuyenKhoan<=0&&giaTri>0){
        if(phuongThuc==='chuyen_khoan')chuyenKhoan=giaTri;
        else if(phuongThuc==='tien_mat')tienMat=giaTri;
      }
      const tongChiTiet=tienMat+chuyenKhoan;
      const giaTriRong=tongChiTiet-tienTraKhach;
      const lechGiaTri=tongChiTiet>0&&Math.abs(giaTriRong-giaTri)>0.5;
      return{tienMat,chuyenKhoan,tienTraKhach,giaTri,tongChiTiet,giaTriRong,lechGiaTri,hasDetail:tongChiTiet>0||tienTraKhach>0,cashBook:receiptPaymentBookName(detail.so_quy_tien_mat_id),bankBook:receiptPaymentBookName(detail.so_quy_chuyen_khoan_id)};
    }
    function receiptPaymentBookImage(book){return book&&book.anh_so_quy&&book.anh_so_quy.url?String(book.anh_so_quy.url):''}
    function buildReceiptPaymentBreakdown(receipt,item){
      const loaiPhieu=(receipt&&receipt.loai_phieu)||item.loai_phieu||'thu';
      const p=resolveReceiptPaymentDetail(receipt,item);
      if(!p.hasDetail)return'';
      const isThu=loaiPhieu==='thu';
      const tongLabel=isThu?'Tổng khách đưa':'Tổng thanh toán';
      const rongLabel=isThu?'Thực thu':'Giá trị phiếu';
      const warn=p.lechGiaTri?'<div class="receipt-payment-detail-warn">⚠ Tổng chi tiết sau trả khách đang lệch với giá trị phiếu.</div>':'';
      const refundRow=isThu?`<div class="receipt-payment-detail-row"><span>Tiền trả khách</span><b>${fmtMoney(p.tienTraKhach)}</b></div>`:'';
      return`<div class="receipt-payment-detail"><div class="receipt-payment-detail-title">Chi tiết thanh toán</div><div class="receipt-payment-detail-row"><span>Tiền mặt</span><b>${fmtMoney(p.tienMat)}</b></div><div class="receipt-payment-detail-row"><span>Sổ tiền mặt</span><b>${escapeHtml(p.cashBook||'')}</b></div><div class="receipt-payment-detail-row"><span>Chuyển khoản</span><b>${fmtMoney(p.chuyenKhoan)}</b></div><div class="receipt-payment-detail-row"><span>Tài khoản</span><b>${escapeHtml(p.bankBook||'')}</b></div>${refundRow}<div class="receipt-payment-detail-row"><span>${tongLabel}</span><b>${fmtMoney(p.tongChiTiet)}</b></div><div class="receipt-payment-detail-row"><span>${rongLabel}</span><b>${fmtMoney(p.giaTriRong)}</b></div>${warn}</div>`;
    }
    showReceipt=async function(id){const item=receipts.find(x=>x._id===id);if(!item)return;const mainRow=document.querySelector(`tr.receipt-main-row[data-receipt-id="${id}"]`);if(mainRow&&mainRow.classList.contains('is-open')){closeInlineReceiptDetail();return}try{const res=await fetch('/so-quy/'+id+'/detail');const json=await res.json();if(!json.success)throw new Error(json.message||'Không tải được phiếu');const receipt=json.data.receipt||{};closeInlineReceiptDetail();if(!mainRow)return;mainRow.classList.add('receipt-inline-main-row','is-open');const detailRow=document.createElement('tr');detailRow.className='receipt-inline-row';detailRow.innerHTML=`<td colspan="9"><div class="receipt-inline-panel"><span class="receipt-inline-tab">Thông tin</span><div class="receipt-inline-head"><div><div class="receipt-inline-title">${item.loai_phieu==='chi'?'Phiếu chi':'Phiếu thu'} <span>${escapeHtml(item.ma_phieu||'')}</span><span class="receipt-inline-badge">${receipt.trang_thai==='cancelled'?'Đã hủy':'Đã thanh toán'}</span><span class="receipt-inline-badge ${receipt.hach_toan?'':'no-account'}">${receipt.hach_toan?'Hạch toán':'Không hạch toán'}</span></div><div class="receipt-inline-meta"><span>Người tạo: ${escapeHtml((receipt.nguoi_tao_id&&(receipt.nguoi_tao_id.ho_ten||receipt.nguoi_tao_id.email))||'')}</span><span>Người chi: ${escapeHtml((receipt.nguoi_tao_id&&(receipt.nguoi_tao_id.ho_ten||receipt.nguoi_tao_id.email))||'')}</span><span>Thời gian: ${formatReceiptDate(receipt.ngay_lap)}</span></div></div><div>${escapeHtml((receipt.cua_hang_id&&receipt.cua_hang_id.ten_cua_hang)||'Cửa hàng trung tâm')}</div></div><div class="receipt-inline-fields"><div class="receipt-inline-field"><span>Số tiền</span><b class="${item.loai_phieu==='chi'?'red':'blue'}">${fmtMoney(receipt.gia_tri!=null?receipt.gia_tri:item.gia_tri)}</b></div><div class="receipt-inline-field"><span>Loại phiếu</span><b>${escapeHtml((item.loai_phieu==='chi'?'Phiếu chi':'Phiếu thu')+(item.loai_thu_chi?(' — '+categoryText(item.loai_thu_chi)):''))}</b></div><div class="receipt-inline-field"><span>Đối tượng nhận</span><b>${cashGroupLabel(receipt.nhom_doi_tuong)}</b></div><div class="receipt-inline-field"><span>Phương thức thanh toán</span><b>${cashPayLabel(receipt.phuong_thuc_thanh_toan)}</b></div></div>${buildReceiptPaymentBreakdown(receipt,item)}<div class="receipt-inline-field"><span>Người nhận</span><b>${escapeHtml((receipt.nha_cung_cap_id&&(receipt.nha_cung_cap_id.ten_ncc||receipt.nha_cung_cap_id.ma_ncc))||item.doi_tuong||'')}</b></div>${buildReceiptRelatedDocumentsSection(receipt)}<div class="receipt-inline-actions"><span><i class="fa-regular fa-pen-to-square"></i> ${escapeHtml(receipt.ghi_chu||'Chưa có ghi chú')}</span><div><button class="btn btn-light" type="button" onclick="event.stopPropagation();openReceiptPrint('${escapeHtml(String(id))}')">In</button></div></div></div></td>`;mainRow.insertAdjacentElement('afterend',detailRow)}catch(error){alert(error.message||'Không tải được phiếu')}}
    buildReceiptPaymentBreakdown=function(receipt,item){
      const loaiPhieu=(receipt&&receipt.loai_phieu)||item.loai_phieu||'thu';
      const p=resolveReceiptPaymentDetail(receipt,item);
      if(!p.hasDetail)return'';
      const detail=(receipt&&receipt.chi_tiet_thanh_toan)||{};
      const isThu=loaiPhieu==='thu';
      const tongLabel=isThu?'Tổng khách đưa':'Tổng thanh toán';
      const rongLabel=isThu?'Thực thu':'Giá trị phiếu';
      const warn=p.lechGiaTri?'<div class="receipt-payment-detail-warn">Tổng chi tiết sau trả khách đang lệch với giá trị phiếu.</div>':'';
      const refundRow=isThu?`<div class="receipt-payment-detail-row"><span>Tiền trả khách</span><b>${fmtMoney(p.tienTraKhach)}</b></div>`:'';
      const qrUrl=p.chuyenKhoan>0?receiptPaymentBookImage(detail.so_quy_chuyen_khoan_id):'';
      const qr=qrUrl?`<div class="receipt-payment-qr"><img src="${escapeHtml(qrUrl)}" alt=""></div>`:'';
      return`<div class="receipt-payment-detail-wrap"><div class="receipt-payment-detail"><div class="receipt-payment-detail-title">Chi tiết thanh toán</div><div class="receipt-payment-detail-row"><span>Tiền mặt</span><b>${fmtMoney(p.tienMat)}</b></div><div class="receipt-payment-detail-row"><span>Sổ tiền mặt</span><b>${escapeHtml(p.cashBook||'')}</b></div><div class="receipt-payment-detail-row"><span>Chuyển khoản</span><b>${fmtMoney(p.chuyenKhoan)}</b></div><div class="receipt-payment-detail-row"><span>Tài khoản</span><b>${escapeHtml(p.bankBook||'')}</b></div>${refundRow}<div class="receipt-payment-detail-row"><span>${tongLabel}</span><b>${fmtMoney(p.tongChiTiet)}</b></div><div class="receipt-payment-detail-row"><span>${rongLabel}</span><b>${fmtMoney(p.giaTriRong)}</b></div>${warn}</div>${qr}</div>`;
    }
    const receiptOtherDocObserver=new MutationObserver(mutations=>{mutations.forEach(mutation=>{mutation.addedNodes.forEach(node=>{if(!(node instanceof HTMLElement)||!node.classList.contains('receipt-inline-row'))return;const mainRow=node.previousElementSibling;const id=mainRow&&mainRow.getAttribute('data-receipt-id');const item=receipts.find(row=>row._id===id);if(!item||!item.chung_tu_khac)return;const amountField=node.querySelector('.receipt-inline-fields .receipt-inline-field');if(amountField&&!amountField.querySelector('.receipt-other-doc'))amountField.insertAdjacentHTML('beforeend',buildReceiptOtherDocumentField(item));});});});
    document.addEventListener('DOMContentLoaded',()=>{const tbody=document.querySelector('.table tbody');if(tbody)receiptOtherDocObserver.observe(tbody,{childList:true})});
    document.addEventListener('click',function(event){const row=event.target.closest('tr.receipt-main-row[data-receipt-id]');if(!row)return;if(event.target.closest('input,select,textarea,button,a.ref-link'))return;event.preventDefault();showReceipt(row.getAttribute('data-receipt-id'))})
    async function saveReceipt(e){
      e.preventDefault();
      const data=Object.fromEntries(new FormData(e.target).entries());
      const payEl=receiptPaymentEls();
      const paymentError=validateReceiptPayment();
      if(paymentError){showReceiptPaymentMessage(paymentError,'error');focusReceiptPaymentError(paymentError);return}
      const pay=updateReceiptPaymentSummary();
      data.tien_mat=String(pay.tienMat);
      data.chuyen_khoan=String(pay.chuyenKhoan);
      data.tien_tra_khach=String(pay.isThu?pay.tienTraKhach:0);
      data.so_quy_tien_mat_id=pay.needCash&&payEl.cashSelect?payEl.cashSelect.value:'';
      data.so_quy_chuyen_khoan_id=pay.needBank&&payEl.bankSelect?payEl.bankSelect.value:'';
      data.gia_tri=String(Math.max(0,pay.giaTri));
      data.payment_v2=true;
      delete data.so_quy_id;
      const group=data.nhom_doi_tuong;
      data.doi_tuong_entity_id=partnerEntityId.value||'';
      data.doi_tuong=String(data.doi_tuong||'').trim();
      if(group==='khac'){data.doi_tuong_entity_id='';if(!data.doi_tuong)return alert('Vui lòng nhập tên người nộp/nhận.')}
      else if(data.doi_tuong_entity_id){if(!data.doi_tuong){const opt=partnerSelect.options[partnerSelect.selectedIndex];data.doi_tuong=(opt&&opt.getAttribute('data-name'))||''}}
      else if(!data.doi_tuong){return alert('Chọn từ danh sách hoặc nhập tên người nộp/nhận.')}
      data.hach_toan=accountingCheck.checked&&!accountingCheck.disabled;
      const docType=documentType.value;
      if(docType==='khac'){
        const otherDoc=String((document.getElementById('otherDocumentInput')||{}).value||'').trim();
        if(!otherDoc)return alert('Vui lòng nhập chứng từ khác.');
        data.chung_tu_khac=otherDoc;
        delete data.ma_chung_tu_goc;
      }
      if(docType&&docType!=='khac'){
        if(selectedRelatedDoc&&Number(data.gia_tri)>Number(selectedRelatedDoc.amount||0))return alert('Số tiền không được vượt số còn lại của chứng từ ('+fmtMoney(selectedRelatedDoc.amount)+').');
      }
      DOC_HIDDEN_IDS.forEach(id=>{const field=document.getElementById(id);if(!field||!field.name)return;if(field.value)data[field.name]=field.value;else delete data[field.name]});
      const saveBtn=document.getElementById('receiptSaveBtn');
      const loadingMessage=data.loai_phieu==='chi'?'Đang tạo phiếu chi...':'Đang tạo phiếu thu...';
      const loadingShown=window.showGlobalLoading&&window.showGlobalLoading(loadingMessage);
      if(loadingShown===false)return;
      if(saveBtn)saveBtn.disabled=true;
      let shouldReload=false;
      try{
        const res=await fetch('/so-quy/add',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)});
        const result=await res.json();
        if(!result.success){showReceiptPaymentMessage(result.message||'Không tạo được phiếu','error');focusReceiptPaymentError(result.message);return}
        shouldReload=true;
        location.reload();
      }catch(error){
        showReceiptPaymentMessage((error&&error.message)||'Lỗi kết nối khi tạo phiếu','error');
      }finally{
        if(!shouldReload){
          if(window.hideGlobalLoading)window.hideGlobalLoading();
          if(saveBtn)saveBtn.disabled=false;
        }
      }
    }
    document.addEventListener('DOMContentLoaded',()=>{
      ['receiptCashAmount','receiptTransferAmount','receiptRefundAmount'].forEach(id=>{
        const input=document.getElementById(id);
        if(input){input.addEventListener('input',onReceiptMoneyInput);input.addEventListener('blur',onReceiptMoneyBlur)}
      });
      ['receiptCashBookSelect','receiptBankBookSelect'].forEach(id=>{
        const select=document.getElementById(id);
        if(select)select.addEventListener('change',updateReceiptPaymentSummary);
      });
      reloadActiveCashBookDropdown();
      const id=new URLSearchParams(location.search).get('receipt');
      if(id)showReceipt(id);
    })
  </script>
</body>
</html>
