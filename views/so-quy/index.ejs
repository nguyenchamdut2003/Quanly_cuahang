      }
      const ptn=relDocObject(receipt.phieu_tra_hang_nhap_id);
      if(ptn){
        const docVal=Number(ptn.tong_tien_tra||ptn.ncc_can_tra||0)||null;
        pushRow({type:'supplier_return',typeLabel:'Phiếu trả hàng nhập',code:ptn.ma_phieu_tra_nhap,docId:receiptDocId(ptn),docDate:ptn.ngay_tra,partner:relPartnerLabel(ptn.nha_cung_cap_id),docValue:docVal,paidBefore:Number(ptn.ncc_da_tra||0)>0?Number(ptn.ncc_da_tra):null,receiptValue:defaultReceiptValue,remainAfter:null,status:getRelatedDocumentStatus('supplier_return',ptn)});
