    function relPartnerLabel(entity){if(!entity)return '';const name=String(entity.ten_khach_hang||entity.ten_ncc||entity.ten_doi_tac||entity.ten_nhan_vien||'').trim();const code=String(entity.ma_khach_hang||entity.ma_ncc||entity.ma_doi_tac||entity.ma_nhan_vien||'').trim();if(name&&code)return name+' ('+code+')';return name||code}
    function receiptPayAmount(receipt,override){const v=override!=null?override:receipt.gia_tri;return Math.abs(Number(v)||0)}
    function paidBeforeFromTotal(docTotal,paidTotal,receiptAmount){const total=Number(docTotal||0);const paid=Number(paidTotal||0);const pay=receiptPayAmount({gia_tri:receiptAmount},receiptAmount);if(total<=0&&paid<=0)return null;if(paid>pay)return paid-pay;if(paid>0&&pay>=paid)return 0;return paid>0?paid:null}
    function getRelatedDocumentLink(type,docId){return receiptDocHref(type,docId)}
    function formatDocStatusLabel(value){const key=String(value||'').trim();if(!key)return '—';const map={partial:'Thanh toán một phần',paid:'Đã thanh toán',unpaid:'Chưa thanh toán',draft:'Phiếu tạm',completed:'Hoàn thành',cancelled:'Đã hủy',processing:'Đang xử lý',shipping:'Đang giao hàng',failed:'Không giao được',done:'Hoàn thành',merged:'Đã gộp',calculated:'Đã tính lương',locked:'Đã khóa',khong_cod:'Không COD',chua_thu:'Chưa thu COD',da_thu:'Đã thu COD',da_doi_soat:'Đã đối soát COD',active:'Đang hoạt động',inactive:'Ngừng hoạt động'};return map[key]||key}
    function getRelatedDocumentStatus(type,doc,remainAfter,docTotal){const remain=remainAfter!=null&&!Number.isNaN(Number(remainAfter))?Number(remainAfter):null;if(remain!=null){if(remain<=0)return 'Đã thanh toán';const total=Number(docTotal||0);if(total>0&&remain>0&&remain<total)return 'Thanh toán một phần';if(remain>0)return 'Còn nợ'}const d=relDocObject(doc);if(!d)return '—';if(type==='shipment'&&d.trang_thai_cod)return formatDocStatusLabel(d.trang_thai_cod);if(d.trang_thai)return formatDocStatusLabel(d.trang_thai);return '—'}
    function buildRelatedDocumentRows(receipt){
      const rows=[];
      const defaultReceiptValue=receiptPayAmount(receipt);
      const allocations=Array.isArray(receipt.allocations)?receipt.allocations:[];
      const pushRow=(row)=>rows.push(row);
      if(allocations.length){
        allocations.forEach(alloc=>{
          const pn=relDocObject(alloc.phieu_nhap_id)||{};
          const pnId=receiptDocId(pn)||receiptDocId(alloc.phieu_nhap_id);
          const code=String(alloc.ma_phieu_nhap||pn.ma_phieu_nhap||'').trim();
          const docVal=Number(pn.can_tra_ncc||pn.tong_tien||0)||(Number(alloc.con_no_truoc||0)+Number(alloc.so_tien||0))||null;
          let paidBefore=null;
          if(alloc.con_no_truoc!=null&&docVal>0)paidBefore=Math.max(0,docVal-Number(alloc.con_no_truoc||0));
          else if(pn.da_tra_ncc!=null)paidBefore=paidBeforeFromTotal(docVal,pn.da_tra_ncc,Number(alloc.so_tien||0));
          pushRow({type:'purchase',typeLabel:'Phiếu nhập',code,docId:pnId,docDate:pn.ngay_nhap||pn.created_at,partner:relPartnerLabel(pn.nha_cung_cap_id),docValue:docVal,paidBefore,receiptValue:Number(alloc.so_tien||0),remainAfter:alloc.con_no_sau!=null?Number(alloc.con_no_sau):null,status:getRelatedDocumentStatus('purchase',pn,alloc.con_no_sau,docVal)});
        });
        return rows;
      }
      const hd=relDocObject(receipt.hoa_don_id);
      if(hd){
        const docVal=Number(hd.thanh_toan||hd.tong_tien||0)||null;
        pushRow({type:'invoice',typeLabel:'Hóa đơn',code:hd.ma_hoa_don,docId:receiptDocId(hd),docDate:hd.ngay_ban,partner:relPartnerLabel(hd.khach_hang_id),docValue:docVal,paidBefore:null,receiptValue:defaultReceiptValue,remainAfter:null,status:getRelatedDocumentStatus('invoice',hd)});
      }
      const dh=relDocObject(receipt.don_hang_id);
      if(dh){
        const docVal=Number(dh.tong_thanh_toan||dh.tong_tien||dh.khach_can_tra||0)||null;
        const paid=Number(dh.khach_thanh_toan||0);
        pushRow({type:'order',typeLabel:'Đơn hàng',code:dh.ma_don_hang,docId:receiptDocId(dh),docDate:dh.ngay_dat,partner:relPartnerLabel(dh.khach_hang_id),docValue:docVal,paidBefore:paid>0?paid:null,receiptValue:defaultReceiptValue,remainAfter:dh.khach_can_tra!=null?Math.max(0,Number(dh.khach_can_tra||0)-defaultReceiptValue):null,status:getRelatedDocumentStatus('order',dh)});
      }
