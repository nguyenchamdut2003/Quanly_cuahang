    if (item.phieu_tra_hang_id) return refLink('customer_return', item.phieu_tra_hang_id, code);
    if (item.phieu_nhap_id) return refLink('purchase', item.phieu_nhap_id, code);
    if (item.nhap_vat_chua_id) return refLink('nhap_vat_chua', item.nhap_vat_chua_id, code);
    if (item.don_hang_id) return refLink('order', item.don_hang_id, code);
    if (item.hoa_don_id) return refLink('invoice', item.hoa_don_id, code);
    if (item.van_don_id) return refLink('shipment', item.van_don_id, code);
    if (item.chamcongmoi_bang_luong_id) return refLink('chamcong_payroll', item.chamcongmoi_bang_luong_id, code);
    if (item.bang_luong_id) return refLink('payroll', item.bang_luong_id, code);
    if (item.ct_bang_luong_id) {
      const parent = item.ct_bang_luong_id.bang_luong_id || item.ct_bang_luong_id;
      return refLink('payroll', parent, code);
    }
    const allocs = item.allocations || [];
    if (allocs.length) {
      const first = allocs[0];
      if (first.phieu_nhap_id) return refLink('purchase', first.phieu_nhap_id, code || first.ma_phieu_nhap);
    }
    if (item._docLinkType && item._docLinkId) return refLink(item._docLinkType, item._docLinkId, code);
