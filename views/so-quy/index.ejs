  </style>
  <style>
    .payment-breakdown{margin-top:4px;color:#64748b;font-size:12px;line-height:1.35}.receipt-payment-detail-wrap{display:flex;align-items:flex-start;gap:18px;flex-wrap:wrap;margin:12px 0 18px}.receipt-payment-detail{max-width:360px;width:100%;padding:12px 14px;border:1px solid #e5e7eb;border-radius:8px;background:#f8fafc;box-sizing:border-box}.receipt-payment-detail-title{font-weight:800;font-size:14px;margin-bottom:8px;color:#111827}.receipt-payment-detail-row{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:16px;align-items:center;padding:6px 0;font-size:13px;border-bottom:1px solid #eef2f6}.receipt-payment-detail-row:last-child{border-bottom:0}.receipt-payment-detail-row span{color:#64748b}.receipt-payment-detail-row b{font-weight:700;color:#111827;text-align:right;white-space:nowrap}.receipt-payment-detail-warn{margin-top:8px;font-size:12px;color:#b45309;font-weight:600;line-height:1.35}.receipt-payment-qr{width:min(360px,100%);aspect-ratio:1;border:1px solid #e5e7eb;border-radius:8px;background:#fff;padding:10px;box-sizing:border-box}.receipt-payment-qr img{width:100%;height:100%;object-fit:contain;display:block}
    .receipt-bankbook-image-preview{display:none;margin-top:8px;width:4cm;height:4cm;border:1px solid #d9e4f2;border-radius:8px;background:#fff;align-items:center;justify-content:center;padding:4px;box-sizing:border-box}.receipt-bankbook-image-preview.show{display:flex}.receipt-bankbook-image-preview img{width:100%;height:100%;object-fit:contain;display:block}
