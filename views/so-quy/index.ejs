    function updateReceiptPaymentSummary(){
      const el=receiptPaymentEls();
      const isThu=receiptType.value!=='chi';
      const tienMat=parseMoneyInput(el.cash&&el.cash.value);
      const chuyenKhoan=parseMoneyInput(el.bank&&el.bank.value);
      let tienTraKhach=isThu?parseMoneyInput(el.refund&&el.refund.value):0;
      if(!isThu&&el.refund)el.refund.value='';
      if(el.refundField)el.refundField.classList.toggle('receipt-payment-hidden',!isThu);
      if(el.refund)el.refund.disabled=!isThu;
      const needCash=tienMat>0||tienTraKhach>0;
      const needBank=chuyenKhoan>0;
      if(el.cashSelect)el.cashSelect.disabled=!needCash||receiptPaymentState.cashBooks.length===0;
      if(el.bankSelect)el.bankSelect.disabled=!needBank||receiptPaymentState.bankBooks.length===0;
      updateReceiptBankBookImage();
      if(el.totalLabel)el.totalLabel.textContent=isThu?'Tổng khách đưa':'Tổng thanh toán';
      if(el.netLabel)el.netLabel.textContent=isThu?'Thực thu':'Giá trị phiếu';
      const tong=tienMat+chuyenKhoan;
      const giaTri=isThu?tong-tienTraKhach:tong;
      if(el.totalDisplay)el.totalDisplay.textContent=fmtMoney(tong);
      if(el.netDisplay)el.netDisplay.textContent=fmtMoney(Math.max(0,giaTri));
      if(el.amount)el.amount.value=String(Math.max(0,giaTri));
      if(isThu&&tienTraKhach>tong)showReceiptPaymentMessage('Tiền trả khách không được lớn hơn tổng số tiền nhận.','error');
      else if(needCash&&receiptPaymentState.cashBooks.length===0)showReceiptPaymentMessage('Chưa có sổ tiền mặt đang hoạt động. Hãy tạo sổ tiền mặt trong phần Quản lý sổ quỹ.','warn');
      else if(needBank&&receiptPaymentState.bankBooks.length===0)showReceiptPaymentMessage('Chưa có tài khoản ngân hàng đang hoạt động.','warn');
      else showReceiptPaymentMessage('');
      return{isThu,tienMat,chuyenKhoan,tienTraKhach,tong,giaTri,needCash,needBank};
    }
    function validateReceiptPayment(){
      const el=receiptPaymentEls();
      const p=updateReceiptPaymentSummary();
      if(p.isThu){
        if(p.tong<=0)return 'Tổng khách đưa phải lớn hơn 0.';
        if(p.tienTraKhach>p.tong)return 'Tiền trả khách không được lớn hơn tổng số tiền nhận.';
        if(p.giaTri<=0)return 'Thực thu phải lớn hơn 0.';
      }else{
        if(p.giaTri<=0)return 'Tổng tiền chi phải lớn hơn 0.';
      }
      if(p.needCash&&(!el.cashSelect||!el.cashSelect.value))return 'Vui lòng chọn sổ tiền mặt.';
      if(p.needBank&&(!el.bankSelect||!el.bankSelect.value))return 'Vui lòng chọn tài khoản chuyển khoản.';
      return '';
    }
