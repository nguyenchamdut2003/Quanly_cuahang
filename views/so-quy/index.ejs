  const safeSuppliers = Array.isArray(locals.suppliers) ? locals.suppliers : [];
  const safeFilters = locals.filters || {};
  const safeSummary = locals.summary || {};
  const safeCashBookScope = locals.cashBookScope || { mode: 'all' };
  const receiptDisplayAmount = item => {
    if (safeCashBookScope.mode !== 'all' && safeCashBookScope.mode !== 'unassigned') {
      if (item && item._scoped_gia_tri != null) return Number(item._scoped_gia_tri) || 0;
    }
    return Number(item && item.gia_tri || 0);
  };
  const docs = locals.relatedDocuments || {};
  const fmt = value => Number(value || 0).toLocaleString('vi-VN');
  const fmtMoney = value => fmt(value) + ' VNĐ';
  const fmtDate = value => {
    if (!value) return '';
    const d = new Date(value);
    if (Number.isNaN(d.getTime())) return '';
    return d.toLocaleDateString('vi-VN');
  };
  const timeFilterActive = safeFilters.time_type === 'this_month' || !!(safeFilters.date_from || safeFilters.date_to);
  const soQuyFilterValue = String(safeFilters.so_quy_id || 'all').trim() || 'all';
  const cashBookFilterActive = soQuyFilterValue !== 'all';
  const cashBookModeAll = soQuyFilterValue === 'all';
  const cashBookModeCash = soQuyFilterValue === 'tien_mat';
  const cashBookModeBank = soQuyFilterValue === 'chuyen_khoan';
  const cashBookModeSpecific = !cashBookModeAll && !cashBookModeCash && !cashBookModeBank && soQuyFilterValue !== 'unassigned';
  const cashBookOptionLabel = book => {
    if (!book) return '';
    const bank = book.thong_tin_ngan_hang || {};
    if ((book.loai_so_quy || '') === 'chuyen_khoan') {
      return [bank.ten_ngan_hang, bank.so_tai_khoan].filter(Boolean).join(' - ') || book.ten_so_quy || 'Tài khoản';
    }
    return book.ten_so_quy || 'Tiền mặt';
  };
  const exportQuery = Object.entries(safeFilters)
    .filter(([key, value]) => value != null && String(value).trim() !== '')
    .map(([key, value]) => encodeURIComponent(key) + '=' + encodeURIComponent(String(value)))
    .join('&');
  const selectedBookId = safeFilters.so_quy_id && safeFilters.so_quy_id !== 'all' && safeFilters.so_quy_id !== 'unassigned'
    ? String(safeFilters.so_quy_id)
    : '';
  const codeOf = locals.relatedCode || function(item) {
    const firstAlloc = Array.isArray(item.allocations) ? item.allocations[0] : null;
    const allocPn = firstAlloc?.phieu_nhap_id;
    return item.don_hang_id?.ma_don_hang || item.hoa_don_id?.ma_hoa_don || item.phieu_nhap_id?.ma_phieu_nhap || firstAlloc?.ma_phieu_nhap || (allocPn && typeof allocPn === 'object' ? allocPn.ma_phieu_nhap : '') || item.phieu_tra_hang_nhap_id?.ma_phieu_tra_nhap || item.phieu_tra_hang_id?.ma_phieu_tra || item.van_don_id?.ma_van_don || item.chamcongmoi_bang_luong_id?.ma_bang_luong || item.bang_luong_id?.ma_bang_luong || item.ct_bang_luong_id?.ma_nhan_vien || item.nhap_vat_chua_id?.ma_nhap_vat_chua || item.chung_tu_khac || item.ma_chung_tu_goc || '';
  };
  const relatedDocLink = function(item) {
