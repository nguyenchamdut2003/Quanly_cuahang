    function receiptDocId(doc){if(!doc)return'';if(typeof doc==='string')return String(doc);return doc._id?String(doc._id):''}
    function receiptDocHref(type,id){const safeId=String(id||'').trim();if(!safeId)return'';const map={order:'/don-hang?order=',invoice:'/don-hang/hoa-don?invoice=',purchase:'/nhap-hang?purchase=',nhap_vat_chua:'/vat-chua?nhap_vat_chua=',supplier_return:'/tra-hang-nhap/',phieu_tra_hang_nhap:'/tra-hang-nhap/',customer_return:'/don-hang/tra-hang/',phieu_tra_hang:'/don-hang/tra-hang/',shipment:'/don-hang/van-don/',van_don:'/don-hang/van-don/',chamcong_payroll:'/chamcongmoi?tab=payroll-paid&bang_luong=',chamcongmoi_bang_luong:'/chamcongmoi?tab=payroll-paid&bang_luong='};const base=map[type];return base?base+encodeURIComponent(safeId):''}
