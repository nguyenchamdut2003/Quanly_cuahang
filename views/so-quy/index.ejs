<body class="so-quy-page">
  <div id="appRoot">
  <%- include('../partials/header') %>
  <form class="page" method="GET" action="/so-quy">
    <% if (soQuyFilterValue !== 'all') { %>
      <input type="hidden" name="so_quy_id" value="<%= soQuyFilterValue %>">
    <% } %>
    <% if (safeFilters.time_type === 'this_month') { %>
      <input type="hidden" name="time_type" value="this_month">
    <% } %>
    <main class="main">
      <div class="toolbar">
        <div class="toolbar-left">
          <div class="search"><i class="fa-solid fa-magnifying-glass"></i><input name="q" value="<%= safeFilters.q || '' %>" placeholder="Theo mã phiếu"></div>
        </div>
        <div class="actions"><button type="button" class="btn primary" onclick="openReceiptModal('thu')"><i class="fa-solid fa-plus"></i> Phiếu thu</button><button type="button" class="btn primary" onclick="openReceiptModal('chi')"><i class="fa-solid fa-plus"></i> Phiếu chi</button><button type="button" class="btn" onclick="openCashBookManageModal()"><i class="fa-solid fa-book"></i> Xem sổ quỹ</button><a class="btn" href="/so-quy/export.csv<%= exportQuery ? '?' + exportQuery : '' %>"><i class="fa-solid fa-file-export"></i> Xuất file</a></div>
      </div>
      <div class="summary"><div><label>Đầu kỳ</label><strong><%= fmtMoney(safeSummary.opening) %></strong></div><div><label>Tổng thu</label><strong class="blue"><%= fmtMoney(safeSummary.totalThu) %></strong></div><div><label>Tổng chi</label><strong class="red"><%= fmtMoney(safeSummary.totalChi) %></strong></div><div><label>Tồn quỹ</label><strong class="green"><%= fmtMoney(safeSummary.balance) %></strong></div></div>
      <div class="cash-list-panel">
        <div class="table-wrap"><table class="table"><thead><tr><th>Mã phiếu</th><th class="th-time-col"><div class="cash-time-filter"><button type="button" class="th-filter-toggle cash-time-filter-trigger <%= timeFilterActive ? 'is-active' : '' %>" id="cashTimeFilterBtn">Thời gian ▼</button><div class="cash-time-filter-panel" id="cashTimeFilterPanel"><label><input type="radio" name="time_mode" value="all" <%= safeFilters.time_type !== 'this_month' && !safeFilters.date_from && !safeFilters.date_to ? 'checked' : '' %>> Toàn thời gian</label><label><input type="radio" name="time_mode" value="this_month" <%= safeFilters.time_type === 'this_month' ? 'checked' : '' %>> Tháng này</label><label><input type="radio" name="time_mode" value="custom" <%= safeFilters.time_type !== 'this_month' && (safeFilters.date_from || safeFilters.date_to) ? 'checked' : '' %>> Khoảng ngày</label><div class="cash-time-range"><input type="date" name="date_from" value="<%= safeFilters.date_from || '' %>" aria-label="Từ ngày"><input type="date" name="date_to" value="<%= safeFilters.date_to || '' %>" aria-label="Đến ngày"></div><div class="cash-time-filter-actions"><button type="button" class="btn" id="cashTimeFilterClear">Xóa lọc</button><button type="button" class="btn primary" id="cashTimeFilterApply">Áp dụng</button></div></div></div></th><th>Loại thu chi</th><th>Người nộp/nhận</th><th>Nhóm</th><th>Chứng từ liên quan</th><th class="th-cashbook-col"><div class="cash-time-filter"><button type="button" class="th-filter-toggle cash-time-filter-trigger <%= cashBookFilterActive ? 'is-active' : '' %>" id="cashBookFilterBtn">Sổ quỹ ▼</button><div class="cash-time-filter-panel" id="cashBookFilterPanel"><label><input type="radio" name="cashbook_mode" value="all" <%= cashBookModeAll ? 'checked' : '' %>> Tất cả quỹ</label><label><input type="radio" name="cashbook_mode" value="tien_mat" <%= cashBookModeCash ? 'checked' : '' %>> Tiền mặt</label><label><input type="radio" name="cashbook_mode" value="chuyen_khoan" <%= cashBookModeBank ? 'checked' : '' %>> Tài khoản</label><label><input type="radio" name="cashbook_mode" value="specific" <%= cashBookModeSpecific ? 'checked' : '' %>> Sổ cụ thể</label><select id="cashBookSpecificSelect" class="cashbook-specific-select" <%= cashBookModeSpecific ? '' : 'disabled' %>><option value="">Chọn sổ quỹ</option><optgroup label="Tiền mặt"><% safeCashBooks.filter(function(book) { return (book.loai_so_quy || 'tien_mat') !== 'chuyen_khoan'; }).forEach(function(book) { %><option value="<%= book._id %>" <%= cashBookModeSpecific && String(book._id) === soQuyFilterValue ? 'selected' : '' %>><%= cashBookOptionLabel(book) %></option><% }) %></optgroup><optgroup label="Tài khoản"><% safeCashBooks.filter(function(book) { return (book.loai_so_quy || '') === 'chuyen_khoan'; }).forEach(function(book) { %><option value="<%= book._id %>" <%= cashBookModeSpecific && String(book._id) === soQuyFilterValue ? 'selected' : '' %>><%= cashBookOptionLabel(book) %></option><% }) %></optgroup></select><div class="cash-time-filter-actions"><button type="button" class="btn" id="cashBookFilterClear">Xóa lọc</button><button type="button" class="btn primary" id="cashBookFilterApply">Áp dụng</button></div></div></div></th><th>Phương thức</th><th class="num">Giá trị</th></tr></thead><tbody>
        <% if (safeList.length) { %>
          <% safeList.forEach(item => { const payDetail = item.chi_tiet_thanh_toan || {}; const payCash = Number(payDetail.tien_mat || 0); const payTransfer = Number(payDetail.chuyen_khoan || 0); const payRefund = Number(payDetail.tien_tra_khach || 0); const payCashBook = paymentBookLabel(payDetail.so_quy_tien_mat_id); const payBankBook = paymentBookLabel(payDetail.so_quy_chuyen_khoan_id); const hasPaySubline = payCash > 0 || payTransfer > 0 || payRefund > 0; %><tr class="receipt-main-row" data-receipt-id="<%= item._id %>"><td><a href="/so-quy/phieu-thu-chi/<%= item._id %>" class="receipt ref-link" onclick="showReceipt('<%= item._id %>');return false"><%= item.ma_phieu %></a></td><td><%= fmtDate(item.ngay_lap) %></td><td><span class="type <%= item.loai_phieu %>"><%= categoryLabel(item.loai_thu_chi) || (item.loai_phieu === 'thu' ? 'Phiếu thu' : 'Phiếu chi') %></span><% if (item.trang_thai === 'cancelled') { %><span class="cancel-badge">Đã hủy</span><% } %></td><td><%= item.doi_tuong || item.khach_hang_id?.ten_khach_hang || item.nha_cung_cap_id?.ten_ncc || '' %></td><td><%= groupLabel(item.nhom_doi_tuong) %></td><td><%- relatedDocLink(item) %></td><td><%= receiptBookSummary(item) %></td><td><%= payLabel(item.phuong_thuc_thanh_toan) %><% if (hasPaySubline) { %><div class="payment-breakdown"><% if (payCash > 0 || payRefund > 0) { %>TM: <%= fmtMoney(payCash) %><%= payCashBook ? ' — ' + payCashBook : '' %><br><% } %><% if (payTransfer > 0) { %>CK: <%= fmtMoney(payTransfer) %><%= payBankBook ? ' — ' + payBankBook : '' %><% } %><% if (payRefund > 0) { %><br>Trả khách: <%= fmtMoney(payRefund) %><% } %></div><% } %></td><td class="num <%= item.loai_phieu === 'thu' ? 'blue' : 'red' %>"><%= item.loai_phieu === 'thu' ? '+' : '-' %><%= fmtMoney(receiptDisplayAmount(item)) %></td></tr><% }) %>
        <% } else { %>
          <tr><td colspan="9" class="empty"><div class="empty-box"><div class="empty-icon"><i class="fa-regular fa-inbox"></i></div><strong>Không tìm thấy giao dịch nào phù hợp</strong></div></td></tr>
        <% } %>
      </tbody></table></div>
      </div>
    </main>
  </form>

  <div id="cashBookManageModal" class="modal-backdrop">
    <div class="modal cashbook-manage-modal">
      <div class="modal-head">
        <h2>Quản lý sổ quỹ</h2>
        <button type="button" class="modal-close" onclick="closeCashBookManageModal()">&times;</button>
      </div>
      <div class="modal-body cashbook-manage-body">
        <p class="cashbook-note">Tên sổ được tự sinh theo loại và thông tin ngân hàng. Thay đổi danh mục không cập nhật lại số dư cũ.</p>
        <span id="cashBookMessage" class="cashbook-message"></span>
        <form id="cashBookForm" class="cashbook-form">
          <div class="cashbook-form-grid">
            <div class="field">
              <label>Loại sổ</label>
              <select id="cashBookTypeInput" name="loai_so_quy">
                <option value="tien_mat">Tiền mặt</option>
                <option value="chuyen_khoan">Chuyển khoản</option>
              </select>
            </div>
            <div class="field">
              <label>Trạng thái</label>
              <select id="cashBookStatusInput" name="trang_thai">
                <option value="active">Đang sử dụng</option>
                <option value="inactive">Ngừng sử dụng</option>
              </select>
            </div>
            <div class="field">
              <label>Mặc định</label>
              <label class="cashbook-default-row"><input type="checkbox" id="cashBookDefaultInput" name="mac_dinh"> Sử dụng mặc định</label>
            </div>
            <div class="field">
              <label>Chế độ</label>
              <input id="cashBookFormMode" value="Thêm mới" readonly>
            </div>
            <div class="field">
              <label>Ảnh sổ quỹ</label>
              <input id="cashBookImageInput" name="anh_so_quy" type="file" accept="image/*">
              <div id="cashBookImagePreview" class="cashbook-image-preview"><span>Chưa có ảnh</span></div>
            </div>
            <div id="cashBookBankFields" class="cashbook-bank-fields is-hidden">
              <div class="field"><label>Tên ngân hàng</label><input id="cashBookBankNameInput" name="ten_ngan_hang" autocomplete="off"></div>
              <div class="field"><label>Số tài khoản</label><input id="cashBookAccountNumberInput" name="so_tai_khoan" inputmode="numeric" autocomplete="off"></div>
              <div class="field"><label>Chủ tài khoản</label><input id="cashBookAccountOwnerInput" name="chu_tai_khoan" autocomplete="off"></div>
              <div class="field"><label>Chi nhánh ngân hàng</label><input id="cashBookBankBranchInput" name="chi_nhanh_ngan_hang" autocomplete="off"></div>
            </div>
          </div>
          <div class="cashbook-form-actions">
            <button type="button" class="mini-btn" id="cashBookCancelEditBtn">Hủy sửa</button>
            <button type="submit" class="mini-btn primary" id="cashBookSaveBtn">Thêm sổ</button>
          </div>
        </form>
        <div class="cashbook-toolbar">
          <div class="cashbook-filters">
            <select id="cashBookTypeFilter" aria-label="Lọc loại sổ">
              <option value="all">Tất cả loại sổ</option>
              <option value="tien_mat">Tiền mặt</option>
              <option value="chuyen_khoan">Chuyển khoản</option>
            </select>
            <select id="cashBookStatusFilter" aria-label="Lọc trạng thái">
              <option value="all">Tất cả trạng thái</option>
              <option value="active">Đang sử dụng</option>
              <option value="inactive">Ngừng sử dụng</option>
            </select>
          </div>
          <button type="button" class="mini-btn" id="cashBookReloadBtn">Tải lại</button>
        </div>
        <div class="cashbook-table-wrap">
          <table class="cashbook-table">
            <thead class="cashbook-image-head"><tr><th>Tên sổ</th><th>Ảnh</th><th>Loại sổ</th><th>Ngân hàng/Tài khoản</th><th>Chủ tài khoản</th><th>Mặc định</th><th>Trạng thái</th><th class="num">Thao tác</th></tr></thead>
            <thead><tr><th>Tên sổ</th><th>Loại sổ</th><th>Ngân hàng/Tài khoản</th><th>Chủ tài khoản</th><th>Mặc định</th><th>Trạng thái</th><th class="num">Thao tác</th></tr></thead>
            <tbody id="cashBookRows"><tr><td colspan="8" class="cashbook-empty">Đang tải danh sách sổ quỹ...</td></tr></tbody>
          </table>
        </div>
      </div>
      <div class="page-actions modal-foot"><button type="button" class="modal-btn" onclick="closeCashBookManageModal()">Đóng</button></div>
    </div>
  </div>

  <div id="cashBookTrashModal" class="modal-backdrop">
    <div class="modal cashbook-trash-modal">
      <div class="modal-head">
        <h2>Xóa sổ quỹ</h2>
        <button type="button" class="modal-close" onclick="closeCashBookTrashModal()">&times;</button>
      </div>
      <div class="modal-body">
