              <div class="field"><label>Sổ tiền mặt</label><select name="so_quy_tien_mat_id" id="receiptCashBookSelect"><option value="">Chọn sổ tiền mặt</option></select><div class="partner-hint" id="receiptCashBookHint"></div></div>
              <div class="field"><label>Chuyển khoản</label><div class="money-wrap"><input name="chuyen_khoan" id="receiptTransferAmount" value="" placeholder="0" inputmode="numeric" autocomplete="off"><span>đ</span></div></div>
              <div class="field"><label>Tài khoản ngân hàng</label><select name="so_quy_chuyen_khoan_id" id="receiptBankBookSelect"><option value="">Chọn tài khoản</option></select><div class="partner-hint" id="receiptBankBookHint"></div><div class="receipt-bankbook-image-preview" id="receiptBankBookImagePreview"></div></div>
              <div class="field" id="receiptRefundField"><label>Tiền trả khách</label><div class="money-wrap"><input name="tien_tra_khach" id="receiptRefundAmount" value="" placeholder="0" inputmode="numeric" autocomplete="off"><span>đ</span></div></div>
              <div class="receipt-payment-summary">
                <div class="receipt-payment-summary-row"><span id="receiptTotalLabel">Tổng khách đưa</span><b id="receiptTotalDisplay">0 VNĐ</b></div>
                <div class="receipt-payment-summary-row"><span id="receiptNetLabel">Thực thu</span><b id="receiptNetDisplay">0 VNĐ</b></div>
