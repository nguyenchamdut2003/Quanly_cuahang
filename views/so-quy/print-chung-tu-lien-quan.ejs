<%
  const panelLines = String(relatedPanelTitle || '').split('\n');
  const panelMain = panelLines[0] || 'BẢNG CHỨNG TỪ LIÊN QUAN';
  const panelSub = panelLines[1] || '';
  const moneyCell = function(v) {
    if (v == null || v === '') return '—';
    return embeddedPrint
      ? Number(v || 0).toLocaleString('vi-VN')
      : formatMoney(v);
  };
%>
<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Bảng chứng từ liên quan</title>
  <style>
    @page{size:A4 landscape;margin:10mm}
    html,body{max-width:100%;overflow-x:hidden}
    body{font-family:Arial,sans-serif;color:#111;margin:0;background:#f3f4f6}
    .page{width:277mm;max-width:100%;min-height:190mm;margin:0 auto;background:#fff;padding:12mm 10mm;box-sizing:border-box;overflow-x:hidden}
    h1{text-align:center;font-size:17px;margin:8px 0 2px;text-transform:uppercase;line-height:1.2}
    .sub-title{text-align:center;font-size:13px;margin-bottom:12px;line-height:1.3}
    .meta{display:grid;grid-template-columns:repeat(4,1fr);gap:6px 10px;font-size:12px;margin-bottom:12px}
    .meta div{min-width:0;overflow-wrap:anywhere}
    table{width:100%;max-width:100%;border-collapse:collapse;table-layout:fixed}
    th,td{border:1px solid #333;padding:4px 3px;font-size:10px;vertical-align:middle;overflow-wrap:anywhere;word-break:break-word;line-height:1.25}
    th{text-align:center;background:#f1f5f9;font-weight:700}
    .num{text-align:right;font-size:9px}
    .center{text-align:center}
    .empty-msg{padding:24px;text-align:center;font-size:13px;color:#475467}
    .footer-summary{margin-top:12px;font-size:12px;display:grid;grid-template-columns:1fr 1fr;gap:8px;max-width:100%;margin-left:auto}
    .footer-summary div{display:flex;justify-content:space-between;gap:6px;border-bottom:1px solid #ddd;padding:4px 0}
    .sign{display:grid;grid-template-columns:1fr 1fr;gap:24px;margin-top:20px;text-align:center;font-size:12px}
    .sign b{display:block;margin-bottom:32px}
    .print-actions{position:fixed;right:18px;top:18px;display:flex;gap:8px;z-index:10}
    .print-actions button,.print-actions a{border:1px solid #1f2937;background:#fff;color:#111;padding:7px 12px;border-radius:3px;font-size:13px;cursor:pointer;text-decoration:none}
    body.embed-preview{background:#fff}
    body.embed-preview .page{width:100%;min-height:0;padding:8px 6px}
    body.embed-preview h1{font-size:11px;margin:4px 0}
    body.embed-preview .sub-title{font-size:10px;margin-bottom:6px}
    body.embed-preview .meta{grid-template-columns:1fr 1fr;font-size:9px;gap:4px 8px;margin-bottom:6px}
    body.embed-preview .doc-table th,body.embed-preview .doc-table td{font-size:7.5px;padding:2px 1px;line-height:1.2}
    body.embed-preview .doc-table .num{font-size:7px}
    body.embed-preview .doc-table th:nth-child(1){width:5%}
    body.embed-preview .doc-table th:nth-child(2){width:9%}
    body.embed-preview .doc-table th:nth-child(3){width:9%}
    body.embed-preview .doc-table th:nth-child(4){width:8%}
    body.embed-preview .doc-table th:nth-child(5){width:14%}
    body.embed-preview .doc-table th:nth-child(6),
    body.embed-preview .doc-table th:nth-child(7),
    body.embed-preview .doc-table th:nth-child(8),
    body.embed-preview .doc-table th:nth-child(9){width:9%}
    body.embed-preview .doc-table th:nth-child(10){width:19%}
    body.embed-preview .footer-summary{font-size:9px}
    body.embed-preview .sign{font-size:9px;margin-top:12px}
    body.embed-preview .sign b{margin-bottom:16px}
    @media print{body{background:#fff}.page{margin:0;width:auto;min-height:auto;padding:8mm}.no-print{display:none!important}}
  </style>
</head>
<body class="<%= embeddedPrint ? 'embed-preview' : '' %>">
  <% if (!embeddedPrint) { %>
    <div class="print-actions no-print">
      <button type="button" onclick="window.print()">In</button>
      <a href="/so-quy/<%= receiptId %>/in-chung-tu-lien-quan/pdf" target="_blank">Tải PDF</a>
      <a href="/so-quy/<%= receiptId %>/in-tong-hop" target="_blank">Mở tổng hợp</a>
    </div>
  <% } %>
  <main class="page">
    <h1><%= panelMain %></h1>
    <% if (panelSub) { %><div class="sub-title"><%= panelSub %></div><% } %>

    <section class="meta">
      <div>Mã phiếu: <strong><%= receipt.ma_phieu || '' %></strong></div>
      <div>Ngày lập: <strong><%= formatDate(receipt.ngay_lap) %></strong></div>
      <div>Đối tượng: <strong><%= subjectName || '—' %></strong></div>
      <div>Loại phiếu: <strong><%= receiptTypeLabel %></strong></div>
    </section>

    <% if (!relatedRows || !relatedRows.length) { %>
      <p class="empty-msg">Phiếu này chưa gắn chứng từ liên quan.</p>
    <% } else { %>
      <table class="doc-table">
        <thead>
          <tr>
            <th>STT</th>
            <th><%= embeddedPrint ? 'Loại CT' : 'Loại chứng từ' %></th>
            <th><%= embeddedPrint ? 'Mã CT' : 'Mã chứng từ' %></th>
            <th><%= embeddedPrint ? 'Ngày' : 'Ngày chứng từ' %></th>
            <th>Đối tượng</th>
            <th class="num"><%= embeddedPrint ? 'GT CT' : 'Giá trị chứng từ' %></th>
            <th class="num"><%= embeddedPrint ? 'Đã TT' : 'Đã thu/đã trả trước' %></th>
            <th class="num"><%= embeddedPrint ? 'GT phiếu' : 'Giá trị phiếu này' %></th>
            <th class="num"><%= embeddedPrint ? 'Còn lại' : 'Còn lại sau phiếu' %></th>
            <th>Trạng thái</th>
            <% if (!embeddedPrint) { %><th class="col-note">Ghi chú</th><% } %>
          </tr>
        </thead>
        <tbody>
          <% relatedRows.forEach(function(row, index) { %>
            <tr>
              <td class="center"><%= index + 1 %></td>
              <td><%= row.typeLabel %></td>
              <td><%= row.code || '—' %></td>
              <td class="center"><%= formatDate(row.docDate) || '—' %></td>
              <td><%= row.partner || '—' %></td>
              <td class="num"><%= moneyCell(row.docValue) %></td>
              <td class="num"><%= moneyCell(row.paidBefore) %></td>
              <td class="num"><%= moneyCell(row.receiptValue) %></td>
              <td class="num"><%= moneyCell(row.remainAfter) %></td>
              <td><%= row.status || '—' %></td>
              <% if (!embeddedPrint) { %><td class="col-note"><%= row.note || '—' %></td><% } %>
            </tr>
          <% }); %>
        </tbody>
      </table>
      <section class="footer-summary">
        <div><span><%= embeddedPrint ? 'Tổng GT phiếu' : 'Tổng giá trị phiếu này' %></span><strong><%= moneyCell(relatedSummary.totalReceiptValue) %></strong></div>
        <div><span><%= embeddedPrint ? 'Tổng còn lại' : 'Tổng còn lại sau phiếu' %></span><strong><%= relatedSummary.totalRemainAfter != null ? moneyCell(relatedSummary.totalRemainAfter) : '—' %></strong></div>
      </section>
    <% } %>

    <section class="sign">
      <div><b>Người lập bảng</b>(Ký, ghi rõ họ tên)</div>
      <div><b>Kế toán/Quản lý</b>(Ký, ghi rõ họ tên)</div>
    </section>
  </main>
</body>
</html>
