<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/stylesheets/style.css">
  <style>
    .admin-body .admin-shell{width:auto;max-width:none;margin:0;padding:30px}
    .hr-setup-shell{display:grid;grid-template-columns:260px minmax(0,1fr);gap:12px;padding:0}
    .hr-setup-main{background:#fff;border:1px solid #d7dde5;border-radius:8px;padding:14px 16px 16px;min-height:calc(100vh - 140px)}
    .hr-page-title{margin:0 0 16px;font-size:22px;font-weight:700;color:#111827}
    .hr-card{border:1px solid #e5e9ee;border-radius:8px;padding:14px 16px;margin-bottom:16px;background:#fff}
    .hr-card h2{margin:0 0 12px;font-size:16px;font-weight:700;color:#111827}
    .hr-weekdays{display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:8px 12px;margin-bottom:14px}
    .hr-weekday{display:flex;align-items:center;gap:8px;font-size:13px;color:#344054}
    .hr-weekday input{width:16px;height:16px}
    .hr-form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,220px));gap:12px;margin-bottom:14px}
    .hr-form-grid label{display:grid;gap:4px;font-size:12px;color:#475467}
    .hr-form-grid input{height:34px;border:1px solid #cfd8e3;border-radius:7px;padding:0 10px;font-size:13px}
    .hr-card-foot{display:flex;justify-content:flex-end}
    .hr-toolbar{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:12px}
    .hr-search{flex:1;min-width:220px;max-width:420px;display:flex;align-items:center;gap:8px;background:#fff;border:1px solid #cfd8e3;border-radius:8px;padding:0 12px;height:36px}
    .hr-search input{border:0;outline:0;flex:1;font-size:13px}
    .hr-table-panel{border:1px solid #e5e9ee;border-radius:8px;overflow:auto}
    .hr-table{width:100%;border-collapse:collapse;min-width:900px}
    .hr-table thead th{background:#e8f3ff;color:#111827;font-size:13px;font-weight:700;height:38px;padding:0 12px;text-align:left;border-bottom:1px solid #bcd9ff;white-space:nowrap}
    .hr-table tbody td{padding:10px 12px;border-bottom:1px solid #e5e9ee;font-size:13px;color:#111827}
    .hr-table tbody tr:hover{background:#f8fbff}
    .hr-empty{padding:32px 20px;text-align:center;color:#475467}
    .status-pill{display:inline-flex;align-items:center;height:24px;padding:0 10px;border-radius:5px;font-size:11px;font-weight:700}
    .status-pill.is-active{background:#dcfce7;color:#166534}
    .status-pill.is-inactive{background:#fee2e2;color:#991b1b}
    .hr-actions{display:flex;gap:6px}
    .hr-btn-icon{border:1px solid #cfd8e3;background:#fff;border-radius:6px;width:30px;height:28px;cursor:pointer;color:#344054}
    .modal-overlay{position:fixed;inset:0;background:rgba(15,23,42,.45);display:none;align-items:center;justify-content:center;z-index:3000;padding:20px;opacity:0;visibility:hidden}
    .modal-overlay.is-open{display:flex;opacity:1;visibility:visible}
    .modal-card{background:#fff;border-radius:10px;width:min(668px,100%);max-height:92vh;display:flex;flex-direction:column;box-shadow:0 20px 50px rgba(0,0,0,.18)}
    .modal-head{padding:16px 20px 12px;font-size:16px;font-weight:800;display:flex;align-items:center;justify-content:space-between}
    .modal-close{border:0;background:transparent;font-size:18px;line-height:1;color:#111827;cursor:pointer;width:28px;height:28px}
    .modal-body{padding:14px 20px 16px;display:grid;gap:12px;overflow:auto}
    .modal-body label{display:grid;gap:4px;font-size:12px;color:#475467}
    .modal-body input,.modal-body textarea{height:34px;border:1px solid #cfd8e3;border-radius:7px;padding:0 10px;font-size:13px}
    .modal-body textarea{height:72px;padding:8px 10px;resize:vertical}
    .modal-grid-2{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
    .modal-foot{padding:12px 20px 16px;display:flex;justify-content:flex-end;gap:8px;border-top:1px solid #e5e9ee}
    .hr-save-status{font-size:12px;color:#475467;margin-right:auto}
    .holiday-form-row{display:grid;grid-template-columns:120px minmax(0,1fr);align-items:center;gap:12px}
    .holiday-form-row>label{font-size:12px;font-weight:700;color:#111827}
    .holiday-suggestions{grid-column:2;display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-top:-4px}
    .holiday-chip{height:28px;border:1px solid #cfd8e3;background:#fff;border-radius:999px;padding:0 12px;color:#667085;font-size:12px;cursor:pointer}
    .holiday-date-line{grid-column:2;display:flex;align-items:center;gap:12px;flex-wrap:wrap}
    .holiday-date-line input{width:126px}
    .holiday-day-count{font-size:13px;color:#667085}
    .holiday-reward-row{grid-column:2;display:flex;align-items:center;gap:10px}
    .holiday-reward-check{display:inline-flex;align-items:center;gap:8px;font-size:13px;font-weight:700;color:#111827}
    .holiday-reward-check input{width:14px;height:14px;accent-color:#0070f4}
    .holiday-info{display:inline-flex;align-items:center;justify-content:center;width:15px;height:15px;border:1px solid #98a2b3;border-radius:50%;font-size:10px;color:#667085}
    .holiday-reward-row input[type="number"]{width:125px}
  </style>
</head>
<body class="admin-body">
  <%- include('../partials/header', { activeMenu: activeMenu, user: user }) %>
  <main class="admin-shell">
    <%- include('../partials/flash-message', { flash: flash }) %>
    <div class="hr-setup-shell">
      <%- include('../partials/hr-setup-nav', { activeHrPage: activeHrPage }) %>
      <section class="hr-setup-main">
        <h1 class="hr-page-title">Ngày làm & Nghỉ</h1>

        <div class="hr-card" id="workDaysCard">
          <h2>Ngày làm việc</h2>
          <div class="hr-weekdays" id="workDaysWeekdays">
            <label class="hr-weekday"><input type="checkbox" value="2" data-weekday> Thứ hai</label>
            <label class="hr-weekday"><input type="checkbox" value="3" data-weekday> Thứ ba</label>
            <label class="hr-weekday"><input type="checkbox" value="4" data-weekday> Thứ tư</label>
            <label class="hr-weekday"><input type="checkbox" value="5" data-weekday> Thứ năm</label>
            <label class="hr-weekday"><input type="checkbox" value="6" data-weekday> Thứ sáu</label>
            <label class="hr-weekday"><input type="checkbox" value="7" data-weekday> Thứ bảy</label>
            <label class="hr-weekday"><input type="checkbox" value="8" data-weekday> Chủ nhật</label>
          </div>
          <div class="hr-form-grid">
            <label>Số giờ ngày công chuẩn
              <input type="number" id="wdHoursFull" min="0" step="1" value="8">
            </label>
            <label>Số giờ nửa công
              <input type="number" id="wdHoursHalf" min="0" step="1" value="4">
            </label>
          </div>
          <div class="hr-card-foot">
            <span class="hr-save-status" id="wdSaveStatus"></span>
            <button type="button" class="btn btn-primary" id="wdSaveBtn">Lưu thiết lập</button>
          </div>
        </div>

        <div class="hr-card">
          <h2>Ngày lễ tết</h2>
          <div class="hr-toolbar">
            <div class="hr-search">
              <i class="fa-solid fa-magnifying-glass"></i>
              <input type="search" id="holidayKeyword" placeholder="Tìm theo tên ngày lễ, ghi chú">
            </div>
            <button type="button" class="btn btn-primary" id="holidayAddBtn" data-open-holiday-modal onclick="window.openHolidayCreateModal ? window.openHolidayCreateModal() : document.getElementById('holidayModal').classList.add('is-open')">+ Ngày lễ</button>
          </div>
          <div class="hr-table-panel">
            <table class="hr-table">
              <thead>
                <tr>
                  <th>Tên ngày lễ</th>
                  <th>Từ ngày</th>
                  <th>Đến ngày</th>
                  <th>Số ngày</th>
                  <th>Hệ số lương</th>
                  <th>Ghi chú</th>
                  <th>Trạng thái</th>
                  <th style="width:100px">Hành động</th>
                </tr>
              </thead>
              <tbody id="holidayTableBody">
                <tr><td colspan="8" class="hr-empty">Đang tải...</td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </section>
    </div>
  </main>

  <div class="modal-overlay" id="holidayModal">
    <div class="modal-card">
      <div class="modal-head">
        <span id="holidayModalTitle">Thêm kỳ lễ tết</span>
        <button type="button" class="modal-close" id="holidayCloseBtn">×</button>
      </div>
      <form id="holidayForm" class="modal-body">
        <input type="hidden" id="holidayId">
        <div class="holiday-form-row">
          <label for="holidayTen">Tên kỳ lễ tết</label>
          <input id="holidayTen" required>
          <div class="holiday-suggestions">
            <button type="button" class="holiday-chip" data-name="Tết Dương lịch">Tết Dương lịch</button>
            <button type="button" class="holiday-chip" data-name="Tết Nguyên Đán">Tết Nguyên Đán</button>
            <button type="button" class="holiday-chip" data-name="Giỗ tổ Hùng Vương">Giỗ tổ Hùng Vương</button>
            <button type="button" class="holiday-chip" data-name="Ngày Giải phóng miền Nam">Ngày Giải phóng miền Nam</button>
            <button type="button" class="holiday-chip" data-name="Ngày Quốc tế Lao động">Ngày Quốc tế Lao động</button>
            <button type="button" class="holiday-chip" data-name="Ngày Quốc khánh">Ngày Quốc khánh</button>
          </div>
        </div>
        <div class="holiday-form-row">
          <label>Từ ngày</label>
          <div class="holiday-date-line">
            <input id="holidayTuNgay" type="date" required>
            <span>Đến hết ngày</span>
            <input id="holidayDenNgay" type="date" required>
            <span class="holiday-day-count" id="holidayDayCount">(1 ngày)</span>
          </div>
        </div>
        <div class="holiday-form-row">
          <label></label>
          <div class="holiday-reward-row">
            <label class="holiday-reward-check"><input type="checkbox" id="holidayRewardEnabled" checked> Thưởng lễ, tết</label>
            <span class="holiday-info" title="Hệ số lương áp dụng cho ngày lễ">i</span>
            <input id="holidayHeSo" type="number" min="0" step="1" value="300">
          </div>
        </div>
        <input type="hidden" id="holidayGhiChu">
      </form>
      <div class="modal-foot">
        <button type="button" class="btn btn-light" id="holidayCancelBtn">Bỏ qua</button>
        <button type="submit" class="btn btn-primary" form="holidayForm" id="holidaySaveBtn">Lưu</button>
      </div>
    </div>
  </div>

  <script>
    const WEEKDAY_DEFAULT = [2, 3, 4, 5, 6, 7];
    const holidayModal = document.getElementById('holidayModal');
    const holidayKeyword = document.getElementById('holidayKeyword');
    const holidayTableBody = document.getElementById('holidayTableBody');
    let holidayEditId = '';

    function formatDateDisplay(value) {
      if (!value) return '---';
      const d = new Date(value);
      if (Number.isNaN(d.getTime())) return '---';
      const day = String(d.getDate()).padStart(2, '0');
      const month = String(d.getMonth() + 1).padStart(2, '0');
      return day + '/' + month + '/' + d.getFullYear();
    }

    function toDateInputValue(value) {
      if (!value) return '';
      const d = new Date(value);
      if (Number.isNaN(d.getTime())) return '';
      const y = d.getFullYear();
      const m = String(d.getMonth() + 1).padStart(2, '0');
      const day = String(d.getDate()).padStart(2, '0');
      return y + '-' + m + '-' + day;
    }

    function escapeHtml(text) {
      return String(text || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    function collectWeekdays() {
      return Array.prototype.slice.call(document.querySelectorAll('[data-weekday]:checked'))
        .map(input => Number(input.value))
        .filter(n => Number.isFinite(n));
    }

    function fillWorkDays(item) {
      item = item || {};
      const selected = Array.isArray(item.thu_trong_tuan) ? item.thu_trong_tuan.map(Number) : WEEKDAY_DEFAULT;
      document.querySelectorAll('[data-weekday]').forEach(input => {
        input.checked = selected.indexOf(Number(input.value)) >= 0;
      });
      document.getElementById('wdHoursFull').value = Number(item.so_gio_ngay_cong_chuan ?? 8);
      document.getElementById('wdHoursHalf').value = Number(item.so_gio_nua_cong ?? 4);
    }

    async function loadWorkDays() {
      const res = await fetch('/api/ngay-lam-viec-cua-hang', { headers: { Accept: 'application/json' } });
      const json = await res.json();
      if (!json.success) return alert(json.message || 'Không tải được thiết lập ngày làm việc');
      fillWorkDays(json.item || {});
    }

    function collectWorkDaysPayload() {
      return {
        thu_trong_tuan: collectWeekdays(),
        so_gio_ngay_cong_chuan: Number(document.getElementById('wdHoursFull').value || 0),
        so_gio_nua_cong: Number(document.getElementById('wdHoursHalf').value || 0)
      };
    }

    async function saveWorkDays() {
      const statusEl = document.getElementById('wdSaveStatus');
      const payload = collectWorkDaysPayload();
      if (!payload.thu_trong_tuan.length) return alert('Chọn ít nhất một ngày làm việc trong tuần');
      statusEl.textContent = 'Đang lưu...';
      const res = await fetch('/api/ngay-lam-viec-cua-hang', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(payload)
      });
      const json = await res.json();
      if (!json.success) {
        statusEl.textContent = '';
        return alert(json.message || 'Lỗi lưu thiết lập');
      }
      fillWorkDays(json.item || payload);
      statusEl.textContent = 'Đã lưu lúc ' + new Date().toLocaleTimeString('vi-VN');
    }

    function renderHolidayRows(items) {
      if (!items.length) {
        holidayTableBody.innerHTML = '<tr><td colspan="8" class="hr-empty">Chưa có ngày lễ. <a href="#" id="holidayEmptyAdd">Nhấn vào đây để thêm</a>.</td></tr>';
        document.getElementById('holidayEmptyAdd')?.addEventListener('click', (e) => {
          e.preventDefault();
          openHolidayModal(null);
        });
        return;
      }
      holidayTableBody.innerHTML = items.map(item => {
        const active = item.trang_thai === 'active';
        return (
          '<tr data-id="' + escapeHtml(String(item._id || '')) + '"' +
            ' data-ten="' + escapeHtml(item.ten_ngay_le || '') + '"' +
            ' data-tu="' + escapeHtml(toDateInputValue(item.tu_ngay)) + '"' +
            ' data-den="' + escapeHtml(toDateInputValue(item.den_ngay)) + '"' +
            ' data-he-so="' + Number(item.he_so_luong || 0) + '"' +
            ' data-ghi-chu="' + escapeHtml(item.ghi_chu || '') + '"' +
            ' data-trang-thai="' + escapeHtml(item.trang_thai || 'active') + '">' +
            '<td><strong>' + escapeHtml(item.ten_ngay_le || '---') + '</strong></td>' +
            '<td>' + formatDateDisplay(item.tu_ngay) + '</td>' +
            '<td>' + formatDateDisplay(item.den_ngay) + '</td>' +
            '<td>' + Number(item.so_ngay || 1) + '</td>' +
            '<td>' + Number(item.he_so_luong || 0) + '%</td>' +
            '<td>' + escapeHtml(item.ghi_chu || '') + '</td>' +
            '<td><span class="status-pill ' + (active ? 'is-active' : 'is-inactive') + '">' +
              (active ? 'Đang hoạt động' : 'Ngừng hoạt động') + '</span></td>' +
            '<td><div class="hr-actions">' +
              '<button type="button" class="hr-btn-icon holiday-edit" title="Sửa"><i class="fa-regular fa-pen-to-square"></i></button>' +
              '<button type="button" class="hr-btn-icon holiday-delete" title="Ngừng hoạt động"><i class="fa-regular fa-trash-can"></i></button>' +
            '</div></td>' +
          '</tr>'
        );
      }).join('');
      bindHolidayRowActions();
    }

    async function loadHolidays() {
      const params = new URLSearchParams();
      const kw = holidayKeyword.value.trim();
      if (kw) params.set('keyword', kw);
      const res = await fetch('/api/ngay-le-tet' + (params.toString() ? '?' + params.toString() : ''), {
        headers: { Accept: 'application/json' }
      });
      const json = await res.json();
      if (!json.success) return alert(json.message || 'Không tải được ngày lễ');
      renderHolidayRows(json.items || []);
    }

    function rowToHoliday(row) {
      if (!row) return null;
      return {
        _id: row.dataset.id,
        ten_ngay_le: row.dataset.ten || '',
        tu_ngay: row.dataset.tu || '',
        den_ngay: row.dataset.den || '',
        he_so_luong: Number(row.dataset.heSo || 0),
        ghi_chu: row.dataset.ghiChu || '',
        trang_thai: row.dataset.trangThai || 'active'
      };
    }

    function openHolidayModal(item) {
      item = item || {};
      const today = new Date().toISOString().slice(0, 10);
      const fromDate = item.tu_ngay || today;
      const toDate = item.den_ngay || fromDate;
      const heSo = Number(item.he_so_luong ?? 0);
      holidayEditId = item._id ? String(item._id) : '';
      document.getElementById('holidayModalTitle').textContent = holidayEditId ? 'Sửa kỳ lễ tết' : 'Thêm kỳ lễ tết';
      document.getElementById('holidayId').value = holidayEditId;
      document.getElementById('holidayTen').value = item.ten_ngay_le || '';
      document.getElementById('holidayTuNgay').value = fromDate;
      document.getElementById('holidayDenNgay').value = toDate;
      document.getElementById('holidayRewardEnabled').checked = !holidayEditId || heSo > 0;
      document.getElementById('holidayHeSo').value = heSo;
      document.getElementById('holidayHeSo').disabled = !document.getElementById('holidayRewardEnabled').checked;
      document.getElementById('holidayGhiChu').value = item.ghi_chu || '';
      updateHolidayDayCount();
      holidayModal.classList.add('is-open');
    }

    function closeHolidayModal() {
      holidayModal.classList.remove('is-open');
    }

    window.openHolidayCreateModal = function() {
      openHolidayModal(null);
    };

    function updateHolidayDayCount() {
      const fromValue = document.getElementById('holidayTuNgay').value;
      const toValue = document.getElementById('holidayDenNgay').value;
      const dayCountEl = document.getElementById('holidayDayCount');
      if (!fromValue || !toValue) {
        dayCountEl.textContent = '';
        return;
      }
      const fromTime = new Date(fromValue + 'T00:00:00').getTime();
      const toTime = new Date(toValue + 'T00:00:00').getTime();
      const days = Math.max(0, Math.floor((toTime - fromTime) / 86400000) + 1);
      dayCountEl.textContent = '(' + days + ' ngày)';
    }

    function collectHolidayPayload() {
      const rewardEnabled = document.getElementById('holidayRewardEnabled').checked;
      return {
        ten_ngay_le: document.getElementById('holidayTen').value.trim(),
        tu_ngay: document.getElementById('holidayTuNgay').value,
        den_ngay: document.getElementById('holidayDenNgay').value,
        he_so_luong: rewardEnabled ? Number(document.getElementById('holidayHeSo').value || 0) : 0,
        ghi_chu: document.getElementById('holidayGhiChu').value.trim()
      };
    }

    function bindHolidayRowActions() {
      document.querySelectorAll('.holiday-edit').forEach(btn => {
        btn.addEventListener('click', function() {
          openHolidayModal(rowToHoliday(this.closest('tr')));
        });
      });
      document.querySelectorAll('.holiday-delete').forEach(btn => {
        btn.addEventListener('click', async function() {
          const id = this.closest('tr').dataset.id;
          if (!confirm('Ngừng hoạt động ngày lễ này?')) return;
          const res = await fetch('/api/ngay-le-tet/' + id, { method: 'DELETE' });
          const json = await res.json();
          if (!json.success) return alert(json.message || 'Lỗi');
          await loadHolidays();
        });
      });
    }

    document.getElementById('wdSaveBtn').addEventListener('click', saveWorkDays);
    document.addEventListener('click', function(e) {
      const trigger = e.target.closest('[data-open-holiday-modal]');
      if (!trigger) return;
      e.preventDefault();
      openHolidayModal(null);
    });
    document.getElementById('holidayCancelBtn').addEventListener('click', closeHolidayModal);
    document.getElementById('holidayCloseBtn').addEventListener('click', closeHolidayModal);
    document.getElementById('holidayTuNgay').addEventListener('change', updateHolidayDayCount);
    document.getElementById('holidayDenNgay').addEventListener('change', updateHolidayDayCount);
    document.getElementById('holidayRewardEnabled').addEventListener('change', function() {
      document.getElementById('holidayHeSo').disabled = !this.checked;
    });
    document.querySelectorAll('.holiday-chip').forEach(btn => {
      btn.addEventListener('click', () => {
        document.getElementById('holidayTen').value = btn.dataset.name || btn.textContent.trim();
      });
    });
    holidayKeyword.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') loadHolidays();
    });

    document.getElementById('holidayForm').addEventListener('submit', async function(e) {
      e.preventDefault();
      const payload = collectHolidayPayload();
      if (!payload.ten_ngay_le) return alert('Vui lòng nhập tên ngày lễ');
      if (!payload.tu_ngay || !payload.den_ngay) return alert('Vui lòng chọn từ ngày và đến ngày');
      const url = holidayEditId ? ('/api/ngay-le-tet/' + holidayEditId) : '/api/ngay-le-tet';
      const method = holidayEditId ? 'PUT' : 'POST';
      const res = await fetch(url, {
        method,
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(payload)
      });
      const json = await res.json();
      if (!json.success) return alert(json.message || 'Lỗi lưu ngày lễ');
      closeHolidayModal();
      await loadHolidays();
    });

    loadWorkDays();
    loadHolidays();
  </script>
</body>
</html>
