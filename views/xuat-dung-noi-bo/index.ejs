<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title><%= title %></title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/stylesheets/style.css">
  <style>
    .xnb-page{height:calc(100vh - 98px);background:#f3f6f9;display:grid;grid-template-columns:245px minmax(0,1fr);gap:14px;padding:14px 18px}
    .xnb-sidebar{background:#fff;border-radius:4px;padding:12px;box-shadow:0 1px 3px rgba(0,0,0,.06);overflow:auto}
    .xnb-title{font-size:18px;font-weight:700;color:#111827;margin:0 0 16px}
    .filter-block{margin-bottom:18px}.filter-title{font-size:13px;font-weight:700;color:#374151;margin-bottom:9px}
    .check-filter{display:flex;align-items:center;gap:8px;margin:10px 0;color:#4b5563;font-size:13px;font-weight:600}
    .check-filter input,.radio-filter input{width:15px;height:15px;accent-color:#1684f8}
    .radio-filter{display:flex;align-items:center;gap:8px;margin:8px 0}
    .radio-filter span{flex:1;height:32px;display:flex;align-items:center;justify-content:space-between;border:1px solid #dde3ea;border-radius:6px;background:#fff;padding:0 10px;color:#374151;font-size:13px}
    .filter-control{width:100%;height:34px;border:1px solid #dde3ea;border-radius:6px;background:#fff;color:#374151;padding:0 10px;font-size:13px;outline:none}
    .xnb-main{min-width:0;display:flex;flex-direction:column;gap:10px}
    .xnb-toolbar{display:flex;align-items:center;justify-content:space-between;gap:12px}
    .xnb-search{position:relative;max-width:520px;flex:1}
    .xnb-search i{position:absolute;left:12px;top:50%;transform:translateY(-50%);color:#9ca3af}
    .xnb-search input{width:100%;height:36px;border:1px solid #dde3ea;border-radius:6px;background:#fff;padding:0 40px 0 36px;font-size:14px;outline:none}
    .xnb-search button{position:absolute;right:5px;top:5px;width:26px;height:26px;border:none;background:#fff;color:#6b7280;border-radius:4px;cursor:pointer}
    .toolbar-actions{display:flex;align-items:center;gap:8px}
    .kv-btn{height:36px;border:1px solid #cfd8e3;background:#fff;border-radius:6px;padding:0 12px;color:#374151;font-size:13px;font-weight:600;display:inline-flex;align-items:center;gap:7px;cursor:pointer;text-decoration:none}
    .kv-btn.small{height:30px;padding:0 10px;font-size:12px}
    .kv-btn.primary{border-color:#86bfff;color:#0070f4}.kv-btn:hover{background:#f8fbff;border-color:#8fc2ff;color:#0070f4}
    .xnb-table-wrap{flex:1;min-height:0;background:#fff;border-radius:4px;box-shadow:0 1px 3px rgba(0,0,0,.06);overflow:auto}
    .xnb-summary{height:46px;background:#fff;border-radius:4px;box-shadow:0 1px 3px rgba(0,0,0,.06);display:flex;align-items:center;justify-content:space-between;padding:0 16px;color:#374151;font-size:13px}
    .xnb-summary strong{font-size:18px;color:#111827}
    .xnb-table{width:100%;min-width:1050px;border-collapse:collapse}
    .xnb-table th{position:sticky;top:0;background:#eaf3ff;color:#374151;font-size:13px;font-weight:700;text-align:left;padding:10px 12px;border-bottom:1px solid #d8e8fb}
    .xnb-table td{height:46px;padding:0 12px;border-bottom:1px solid #edf0f3;color:#374151;font-size:13px}
    .xnb-row{cursor:pointer}.xnb-row:hover td{background:#f8fbff}
    .check-col,.star-col{width:36px;text-align:center}.row-check{width:16px;height:16px;accent-color:#0070f4}
    .num{text-align:right;font-weight:600;color:#4b5563}.badge-status{display:inline-flex;align-items:center;height:24px;border-radius:5px;background:#eef2f7;color:#374151;padding:0 8px;font-size:12px;font-weight:700}
    .empty-state{height:100%;min-height:460px;display:flex;align-items:center;justify-content:center;text-align:center;color:#374151}
    .empty-box i{width:72px;height:72px;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;background:#e9f5ff;color:#4d9fe8;font-size:34px;box-shadow:0 0 0 12px rgba(233,245,255,.55);margin-bottom:22px}
    .empty-box strong{display:block;margin-bottom:8px;font-size:15px}
    .xnb-detail-row td{height:auto;padding:0;background:#fff}
    .xnb-detail{border-top:1px solid #dbe4ee;background:#fff;padding:12px}
    .xnb-detail-head{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:10px}
    .xnb-detail-title{font-size:15px;font-weight:800;color:#111827}
    .xnb-detail-total{display:flex;gap:18px;font-size:13px;color:#475467}.xnb-detail-total b{color:#111827;font-size:15px}
    .detail-table{width:100%;border-collapse:collapse}.detail-table th{background:#eaf3ff;color:#374151;text-align:left;font-size:13px;padding:9px 10px;border-bottom:1px solid #d8e8fb}.detail-table td{height:auto;padding:9px 10px;border-bottom:1px solid #edf0f3;font-size:13px;color:#374151}.detail-table .num{text-align:left}
    .xnb-detail-actions{display:flex;justify-content:flex-end;gap:8px;margin-top:10px}
    .summary-actions{display:flex;align-items:center;gap:12px}
    .summary-modal{position:fixed;inset:0;background:rgba(15,23,42,.42);display:none;align-items:center;justify-content:center;z-index:1200;padding:24px}
    .summary-modal.is-open{display:flex}
    .summary-card{width:min(820px,100%);max-height:calc(100vh - 48px);background:#fff;border-radius:8px;box-shadow:0 18px 44px rgba(15,23,42,.25);display:flex;flex-direction:column;overflow:hidden}
    .summary-head{height:58px;display:flex;align-items:center;justify-content:space-between;padding:0 18px;border-bottom:1px solid #e5e7eb}
    .summary-title{font-size:16px;font-weight:800;color:#111827}.summary-sub{font-size:12px;color:#667085;margin-top:3px}
    .summary-close{width:32px;height:32px;border:1px solid #d1d5db;border-radius:6px;background:#fff;cursor:pointer;color:#374151}
    .summary-body{padding:16px;overflow:auto}
    .summary-total{display:flex;justify-content:flex-end;gap:22px;background:#f8fafc;border:1px solid #e5e7eb;border-radius:6px;padding:12px 14px;margin-bottom:12px;font-size:13px;color:#475467}
    .summary-total b{color:#111827;font-size:16px}
  </style>
</head>
<body>
  <%- include('../partials/header') %>
  <%
    const exportParams = new URLSearchParams();
    Object.keys(filters || {}).forEach(key => {
      const value = filters[key];
      if (Array.isArray(value)) {
        value.forEach(item => exportParams.append(key, item));
      } else if (value !== undefined && value !== null && value !== '') {
        exportParams.append(key, value);
      }
    });
    const exportQuery = exportParams.toString();
    const tongGiaTriXuat = (tickets || []).reduce((sum, t) => sum + Number(t.tong_gia_tri || 0), 0);
    const formatVnd = value => `${Number(value || 0).toLocaleString('vi-VN')} VNĐ`;
  %>

  <form class="xnb-page" method="GET" action="/xuat-dung-noi-bo" id="filterForm">
    <aside class="xnb-sidebar">
      <h1 class="xnb-title">Xuất dùng nội bộ</h1>
      <div class="filter-block">
        <div class="filter-title">Trạng thái</div>
        <label class="check-filter"><input type="checkbox" name="trang_thai" value="draft" <%= selectedStatuses.includes('draft') ? 'checked' : '' %> onchange="submitFilters()"> Phiếu tạm</label>
        <label class="check-filter"><input type="checkbox" name="trang_thai" value="completed" <%= selectedStatuses.includes('completed') ? 'checked' : '' %> onchange="submitFilters()"> Hoàn thành</label>
        <label class="check-filter"><input type="checkbox" name="trang_thai" value="cancelled" <%= selectedStatuses.includes('cancelled') ? 'checked' : '' %> onchange="submitFilters()"> Đã hủy</label>
      </div>
      <div class="filter-block">
        <div class="filter-title">Thời gian</div>
        <label class="radio-filter"><input type="radio" checked><span>Tháng này <i class="fa-solid fa-chevron-right"></i></span></label>
        <label class="radio-filter"><input type="radio"><span>Tùy chỉnh <i class="fa-regular fa-calendar"></i></span></label>
      </div>
      <div class="filter-block"><div class="filter-title">Người tạo</div><select class="filter-control" name="nguoi_tao_id" onchange="submitFilters()"><option value="">Chọn người tạo</option><% users.forEach(u=>{ %><option value="<%= u._id %>" <%= filters.nguoi_tao_id == u._id ? 'selected' : '' %>><%= u.ho_ten || u.email %></option><% }) %></select></div>
      <div class="filter-block"><div class="filter-title">Người xuất dùng nội bộ</div><input class="filter-control" name="nguoi_nhan" value="<%= filters.nguoi_nhan || '' %>" placeholder="Chọn người xuất"></div>
      <div class="filter-block"><div class="filter-title">Loại xuất</div><select class="filter-control" name="loai_xuat" onchange="submitFilters()"><option value="">Chọn loại xuất</option><% (loaiXuatList || []).forEach(function(loai) { %><option value="<%= loai.ten_loai %>" <%= filters.loai_xuat === loai.ten_loai ? 'selected' : '' %>><%= loai.ten_loai %></option><% }) %></select></div>
      <div class="filter-block"><div class="filter-title">Người nhận</div><input class="filter-control" name="nguoi_nhan" value="<%= filters.nguoi_nhan || '' %>" placeholder="Chọn người nhận"></div>
    </aside>

    <main class="xnb-main">
      <div class="xnb-toolbar">
        <div class="xnb-search">
          <i class="fa-solid fa-magnifying-glass"></i>
          <input name="q" value="<%= filters.q || '' %>" placeholder="Theo mã xuất dùng nội bộ">
          <button type="submit"><i class="fa-solid fa-sliders"></i></button>
        </div>
        <div class="toolbar-actions">
          <a class="kv-btn primary" href="/xuat-dung-noi-bo/create"><i class="fa-solid fa-plus"></i> Xuất dùng nội bộ</a>
          <a class="kv-btn" href="/xuat-dung-noi-bo/export.xlsx<%= exportQuery ? '?' + exportQuery : '' %>"><i class="fa-solid fa-file-export"></i> Xuất file <i class="fa-solid fa-chevron-down" style="font-size:10px"></i></a>
        </div>
      </div>
      <div class="xnb-summary">
        <span>Tổng giá trị xuất dùng nội bộ</span>
        <span class="summary-actions">
          <strong><%= formatVnd(tongGiaTriXuat) %></strong>
          <button class="kv-btn small" type="button" id="summaryDetailBtn"><i class="fa-regular fa-eye"></i> Chi tiết</button>
        </span>
      </div>
      <div class="xnb-table-wrap">
        <table class="xnb-table">
          <thead><tr><th class="check-col"><input class="row-check" type="checkbox"></th><th class="star-col"><i class="fa-regular fa-star"></i></th><th>Mã xuất dùng nội bộ</th><th>Loại xuất</th><th class="num">Tổng giá trị</th><th>Thời gian</th><th>Cửa hàng</th><th>Ghi chú</th><th>Trạng thái</th></tr></thead>
          <tbody>
            <% if (tickets.length) { %>
              <% tickets.forEach(t => { %>
                <tr class="xnb-row" data-detail-id="<%= t._id %>"><td class="check-col"><input class="row-check" type="checkbox"></td><td class="star-col"><i class="fa-regular fa-star"></i></td><td><strong><%= t.ma_xuat_noi_bo %></strong></td><td><%= t.loai_xuat || '' %></td><td class="num"><%= formatVnd(t.tong_gia_tri || 0) %></td><td><%= t.ngay_xuat ? t.ngay_xuat.toLocaleString('vi-VN') : '' %></td><td><%= t.cua_hang_id ? t.cua_hang_id.ten_cua_hang : '' %></td><td><%= t.ghi_chu || '' %></td><td><span class="badge-status"><%= statusMap[t.trang_thai] || t.trang_thai %></span></td></tr>
              <% }) %>
            <% } else { %>
              <tr><td colspan="9"><div class="empty-state"><div class="empty-box"><i class="fa-solid fa-inbox"></i><strong>Không tìm thấy kết quả</strong><div>Không tìm thấy giao dịch nào phù hợp trong tháng này.<br>Nhấn vào đây để tiếp tục tìm kiếm.</div></div></div></td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </main>
  </form>
  <div class="summary-modal" id="summaryModal">
    <div class="summary-card">
      <div class="summary-head">
        <div>
          <div class="summary-title">Chi tiết tổng xuất dùng nội bộ</div>
          <div class="summary-sub">Tổng hợp theo các phiếu xuất dùng nội bộ trong danh sách hiện tại</div>
        </div>
        <button class="summary-close" type="button" id="summaryClose"><i class="fa-solid fa-xmark"></i></button>
      </div>
      <div class="summary-body">
        <div class="summary-total">
          <span>Tổng số lượng <b id="summaryQty">0</b></span>
          <span>Tổng giá trị <b id="summaryValue">0 VNĐ</b></span>
        </div>
        <table class="detail-table">
          <thead><tr><th>Mã hàng</th><th>Tên hàng hóa</th><th>Đơn vị</th><th>Thuộc tính</th><th class="num">Số lượng</th><th class="num">Tổng giá trị</th></tr></thead>
          <tbody id="summaryBody"></tbody>
        </table>
      </div>
    </div>
  </div>
  <script>
    function submitFilters(){document.getElementById('filterForm').submit();}
  </script>
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const table = document.querySelector('.xnb-table');
      if (!table) return;

      const formatNumber = value => Number(value || 0).toLocaleString('vi-VN');
      const formatMoney = value => formatNumber(value) + ' VNĐ';
      const escapeHtml = value => String(value || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

      function renderDetailContent(result) {
        const ticket = result.ticket || {};
        const rows = result.items || [];
        const ticketId = encodeURIComponent(ticket.id || '');
        const detailActions = ticketId
          ? '<div class="xnb-detail-actions">' +
              '<a class="kv-btn" href="/xuat-dung-noi-bo/' + ticketId + '/export.xlsx"><i class="fa-solid fa-file-excel"></i> Xuất Excel</a>' +
              '<a class="kv-btn" target="_blank" href="/chung-tu-kho/xuat-noi-bo/' + ticketId + '">Chứng từ</a>' +
            '</div>'
          : '';
        return '<div class="xnb-detail">' +
          '<div class="xnb-detail-head">' +
            '<div><div class="xnb-detail-title">Chi tiết ' + escapeHtml(ticket.ma_xuat_noi_bo || '') + '</div>' +
            '<div style="font-size:12px;color:#667085;margin-top:3px">' + escapeHtml([ticket.loai_xuat, ticket.kho, ticket.chi_nhanh].filter(Boolean).join(' - ')) + '</div></div>' +
            '<div class="xnb-detail-total"><span>Tổng số lượng <b>' + formatNumber(result.totalQuantity || ticket.tong_so_luong || 0) + '</b></span><span>Tổng giá trị xuất <b>' + formatMoney(result.totalValue || ticket.tong_gia_tri || 0) + '</b></span></div>' +
          '</div>' +
          '<table class="detail-table">' +
            '<thead><tr><th>Mã hàng</th><th>Tên hàng hóa</th><th>Đơn vị</th><th>Thuộc tính</th><th class="num">Số lượng</th><th class="num">Giá trị xuất</th></tr></thead>' +
            '<tbody>' + (rows.length ? rows.map(function(item) {
              const thuocTinh = item.thuoc_tinh || item.ten_quy_cach || 'Không có';
              return '<tr>' +
                '<td>' + escapeHtml(item.ma_hang) + '</td>' +
                '<td>' + escapeHtml(item.ten_hang) + '</td>' +
                '<td>' + escapeHtml(item.don_vi_tinh) + '</td>' +
                '<td>' + escapeHtml(thuocTinh) + '</td>' +
                '<td class="num">' + formatNumber(item.so_luong) + '</td>' +
                '<td class="num">' + formatMoney(item.thanh_tien) + '</td>' +
              '</tr>';
            }).join('') : '<tr><td colspan="6">Phiếu chưa có hàng hóa.</td></tr>') + '</tbody>' +
          '</table>' +
          detailActions +
        '</div>';
      }

      function ensureDetailRow(row) {
        const id = row.getAttribute('data-detail-id');
        let detailRow = document.getElementById('detail-' + id);
        if (!detailRow) {
          detailRow = document.createElement('tr');
          detailRow.className = 'xnb-detail-row';
          detailRow.id = 'detail-' + id;
          detailRow.style.display = 'none';
          detailRow.innerHTML = '<td colspan="9"></td>';
          row.parentNode.insertBefore(detailRow, row.nextSibling);
        }
        return detailRow;
      }

      async function toggleDetail(row) {
        const id = row.getAttribute('data-detail-id');
        const detailRow = ensureDetailRow(row);
        if (detailRow.style.display !== 'none') {
          detailRow.style.display = 'none';
          return;
        }

        detailRow.style.display = 'table-row';
        if (detailRow.getAttribute('data-loaded') === '1') return;
        detailRow.querySelector('td').innerHTML = '<div class="xnb-detail">Đang tải dữ liệu...</div>';

        try {
          const res = await fetch('/xuat-dung-noi-bo/' + encodeURIComponent(id) + '/details');
          const result = await res.json();
          if (!result.success) throw new Error(result.message || 'Không tải được chi tiết.');
          detailRow.querySelector('td').innerHTML = renderDetailContent(result);
          detailRow.setAttribute('data-loaded', '1');
        } catch (error) {
          detailRow.querySelector('td').innerHTML = '<div class="xnb-detail">' + escapeHtml(error.message || 'Có lỗi xảy ra.') + '</div>';
        }
      }

      Array.prototype.slice.call(table.querySelectorAll('.xnb-row')).forEach(function(row) {
        row.addEventListener('click', function(event) {
          if (event.target.closest('a,button,input,label')) return;
          toggleDetail(row);
        });
      });

      const summaryModal = document.getElementById('summaryModal');
      const summaryDetailBtn = document.getElementById('summaryDetailBtn');
      const summaryClose = document.getElementById('summaryClose');
      const summaryQty = document.getElementById('summaryQty');
      const summaryValue = document.getElementById('summaryValue');
      const summaryBody = document.getElementById('summaryBody');
      const summaryDetailUrl = '/xuat-dung-noi-bo/details<%= exportQuery ? '?' + exportQuery : '' %>';

      function closeSummaryModal() {
        if (summaryModal) summaryModal.classList.remove('is-open');
      }

      async function openSummaryModal() {
        if (!summaryModal || !summaryBody) return;
        summaryQty.textContent = '0';
        summaryValue.textContent = '0 VNĐ';
        summaryBody.innerHTML = '<tr><td colspan="6">Đang tải dữ liệu...</td></tr>';
        summaryModal.classList.add('is-open');

        try {
          const res = await fetch(summaryDetailUrl);
          const result = await res.json();
          if (!result.success) throw new Error(result.message || 'Không tải được chi tiết tổng.');
          const rows = result.items || [];
          summaryQty.textContent = formatNumber(result.totalQuantity || 0);
          summaryValue.textContent = formatMoney(result.totalValue || 0);
          summaryBody.innerHTML = rows.length ? rows.map(function(item) {
            const thuocTinh = item.thuoc_tinh || item.ten_quy_cach || 'Không có';
            return '<tr>' +
              '<td>' + escapeHtml(item.ma_hang) + '</td>' +
              '<td>' + escapeHtml(item.ten_hang) + '</td>' +
              '<td>' + escapeHtml(item.don_vi_tinh) + '</td>' +
              '<td>' + escapeHtml(thuocTinh) + '</td>' +
              '<td class="num">' + formatNumber(item.so_luong) + '</td>' +
              '<td class="num">' + formatMoney(item.thanh_tien) + '</td>' +
            '</tr>';
          }).join('') : '<tr><td colspan="6">Chưa có hàng hóa xuất dùng nội bộ.</td></tr>';
        } catch (error) {
          summaryBody.innerHTML = '<tr><td colspan="6">' + escapeHtml(error.message || 'Có lỗi xảy ra.') + '</td></tr>';
        }
      }

      if (summaryDetailBtn) summaryDetailBtn.addEventListener('click', openSummaryModal);
      if (summaryClose) summaryClose.addEventListener('click', closeSummaryModal);
      if (summaryModal) summaryModal.addEventListener('click', function(event) {
        if (event.target === summaryModal) closeSummaryModal();
      });
    });
  </script>
</body>
</html>
