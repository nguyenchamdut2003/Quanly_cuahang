        <label class="full"><span>Thực thu</span><div class="pay-total-readonly" id="invoiceReceiptPayThucThu">0 VNĐ</div></label>
        <label class="full"><span>Còn phải thu sau thu</span><div class="pay-total-summary" id="invoiceReceiptPayConLai">0 VNĐ</div></label>
