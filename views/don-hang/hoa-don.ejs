tify-content:center;padding:20px}.receipt-pay-modal{width:min(520px,calc(100vw - 32px));background:#fff;border-radius:10px;box-shadow:0 18px 44px rgba(15,23,42,.3);overflow:hidden}.receipt-pay-head,.receipt-pay-foot{display:flex;align-items:center;justify-content:space-between;padding:16px 20px;border-bottom:1px solid #e5e9ee}.receipt-pay-foot{border-top:1px solid #e5e9ee;border-bottom:0;justify-content:flex-end;gap:8px}.receipt-pay-body{padding:18px 20px}.receipt-pay-due{padding:10px 12px;border:1px solid #bfdbfe;background:#eff6ff;border-radius:6px;font-weight:800;margin-bottom:14px}.order-export-close{border:0;background:none;font-size:24px;line-height:1;cursor:pointer;color:#667085}.po-modal{position:fixed;inset:0;background:rgba(15,23,42,.45);display:none;align-items:center;justify-content:center;z-index:1350;padding:16px}.po-modal.open{display:flex}.po-modal-card{width:min(640px,calc(100vw - 32px));max-height:calc(100vh - 64px);overflow:auto;background:#fff;border-radius:8px;padding:18px;box-shadow:0 18px 44px rgba(15,23,42,.28)}.po-modal-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:12px}.po-modal-head h3{margin:0;font-size:18px}.po-modal-close{border:0;background:#fff;font-size:24px;cursor:pointer;color:#667085}.quick-pay-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.quick-pay-grid label{display:flex;flex-direction:column;gap:5px;font-size:13px;color:#475467}.quick-pay-grid label.full{grid-column:1/-1}.quick-pay-grid input,.quick-pay-grid select{width:100%;height:36px;border:1px solid #cfd8e3;border-radius:6px;padding:7px 8px;font-size:14px}.pay-total-readonly{font-size:15px;font-weight:700;color:#006dff;padding:4px 0}.pay-total-summary{font-size:13px;font-weight:600;color:#111827;padding:4px 0}.pay-summary-error{font-size:12px;color:#b45309;font-weight:600;padding:4px 0}.invoice-receipt-pay-foot{display:flex;justify-content:flex-end;gap:8px;margin-top:14px;padding-top:14px;border-top:1px solid #