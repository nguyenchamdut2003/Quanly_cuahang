  <script id="vatChuaData" type="application/json"><%- JSON.stringify(locals.vatChuaList || []).replace(/</g, '\\u003c') %></script>
  <script id="customerData" type="application/json"><%- JSON.stringify(locals.customers || []).replace(/</g, '\\u003c') %></script>
  <script id="cashBookData" type="application/json"><%- JSON.stringify(locals.cashBooks || []).replace(/</g, '\\u003c') %></script>
  <script>
    const vatChuaList = JSON.parse(document.getElementById('vatChuaData')?.textContent || '[]');
    const customers = JSON.parse(document.getElementById('customerData')?.textContent || '[]');
    const cashBooks = JSON.parse(document.getElementById('cashBookData')?.textContent || '[]');
    const invoiceReceiptBookCache = { tien_mat: null, chuyen_khoan: null };
    let invoiceReceiptCashBookId = '';
    let currentInvoiceEditId = '';
    const money = value => Number(value || 0).toLocaleString('vi-VN');
    const moneyText = value => money(value) + ' VNĐ';
    const num = value => Number(String(value || '').replace(/\./g, '').replace(/,/g, '').replace(/[^\d]/g, '')) || 0;
    const numberValue = value => num(value);
    function applyLiveVNFormat(el) {
      if (!el) return;
      const start = el.selectionStart == null ? el.value.length : el.selectionStart;
      const digitsBefore = String(el.value).slice(0, start).replace(/\D/g, '').length;
      const raw = String(el.value).replace(/\./g, '').replace(/,/g, '').replace(/[^\d]/g, '');
      if (!raw) { el.value = ''; return; }
      const formatted = Number(raw).toLocaleString('vi-VN');
      el.value = formatted;
      let pos = formatted.length;
      if (digitsBefore > 0) {
        let digits = 0;
        for (let i = 0; i < formatted.length; i++) {
          if (/\d/.test(formatted[i])) {
            digits++;
            if (digits === digitsBefore) { pos = i + 1; break; }
          }
        }
      } else pos = 0;
      try { el.setSelectionRange(pos, pos); } catch (_) {}
    }
    function bindReceiptPayInput(el) {
      if (!el || el.dataset.vnBound === '1') return;
      el.dataset.vnBound = '1';
      el.addEventListener('input', function() {
        applyLiveVNFormat(el);
        balanceInvoiceReceiptPayment(el);
        syncInvoiceReceiptTransferBookVisibility();
        refreshInvoiceReceiptPaySummary();
      });
    }
    function paymentBookLabel(book) {
      const bank = book && book.thong_tin_ngan_hang ? book.thong_tin_ngan_hang : {};
      if (String(book?.loai_so_quy || '') === 'chuyen_khoan') {
        const parts = [
          bank.ten_ngan_hang || book.ten_so_quy || 'Tài khoản ngân hàng',
          bank.so_tai_khoan || ''
        ].filter(Boolean);
        return parts.join(' - ');
      }
      return book?.ten_so_quy || 'Sổ tiền mặt';
    }
    async function loadInvoiceReceiptBooks(type) {
      if (invoiceReceiptBookCache[type]) return invoiceReceiptBookCache[type];
      const fallback = (cashBooks || [])
        .filter(book => String(book.loai_so_quy || 'tien_mat') === type && String(book.trang_thai || 'active') === 'active');
      try {
        const response = await fetch('/api/so-quy/active?loai_so_quy=' + encodeURIComponent(type), {
          headers: { 'Accept': 'application/json' }
        });
        const json = await response.json();
        const items = json && Array.isArray(json.items) ? json.items : [];
        invoiceReceiptBookCache[type] = items
          .filter(book => String(book.loai_so_quy || '') === type && String(book.trang_thai || 'active') === 'active');
      } catch (_) {
        invoiceReceiptBookCache[type] = fallback;
      }
      return invoiceReceiptBookCache[type];
    }
    function autoSelectedPayBookId(books) {
      books = Array.isArray(books) ? books : [];
      const defaults = books.filter(book => book.mac_dinh);
      if (defaults.length) return String(defaults[0]._id || '');
      if (books.length === 1) return String(books[0]._id || '');
      return '';
    }
    function renderInvoiceReceiptTransferBooks(books) {
      const select = document.getElementById('invoiceReceiptPayTransferBook');
      if (!select) return;
      const selectedId = autoSelectedPayBookId(books);
      const options = [`<option value="">— Chọn tài khoản chuyển khoản —</option>`]
        .concat((books || []).map(book => {
          const id = String(book._id || '');
          const selected = selectedId && id === selectedId ? 'selected' : '';
          return `<option value="${escapeHtml(id)}" ${selected}>${escapeHtml(paymentBookLabel(book))}</option>`;
        }));
      select.innerHTML = options.join('');
      select.dataset.hasBooks = books && books.length ? '1' : '0';
    }
    function syncInvoiceReceiptTransferBookVisibility() {
      const transfer = Math.max(0, numberValue(document.getElementById('invoiceReceiptPayTransfer')?.value || 0));
      const wrap = document.getElementById('invoiceReceiptPayTransferBookWrap');
      const select = document.getElementById('invoiceReceiptPayTransferBook');
      if (wrap) wrap.style.display = transfer > 0 ? '' : 'none';
      if (select) {
        select.disabled = transfer <= 0 || select.dataset.hasBooks !== '1';
        if (transfer <= 0) select.value = '';
      }
    }
    async function prepareInvoiceReceiptCashBook() {
      const books = await loadInvoiceReceiptBooks('tien_mat');
      invoiceReceiptCashBookId = autoSelectedPayBookId(books);
      return invoiceReceiptCashBookId;
    }
    function balanceInvoiceReceiptPayment(activeEl) {
      const cashEl = document.getElementById('invoiceReceiptPayCash');
      const transferEl = document.getElementById('invoiceReceiptPayTransfer');
      if (!cashEl || !transferEl) return;
      let cash = Math.max(0, numberValue(cashEl.value));
      let transfer = Math.max(0, numberValue(transferEl.value));
      const change = Math.max(0, numberValue(document.getElementById('invoiceReceiptPayChange')?.value));
      const limit = Math.max(0, Number(pendingInvoiceReceiptDue || 0) + change);
      if (activeEl === transferEl) {
        transfer = Math.min(transfer, limit);
        if (cash + transfer > limit) cash = Math.max(0, limit - transfer);
      } else if (activeEl === cashEl) {
        cash = Math.min(cash, limit);
        if (cash + transfer > limit) transfer = Math.max(0, limit - cash);
      } else if (activeEl !== document.getElementById('invoiceReceiptPayChange') && cash + transfer > limit) {
        cash = limit;
        transfer = 0;
      }
      cashEl.value = cash > 0 ? money(cash) : '';
      transferEl.value = transfer > 0 ? money(transfer) : '';
    }
    let pendingInvoiceReceiptId = '';
    let pendingInvoiceReceiptDue = 0;
    const escapeHtml = value => String(value ?? '').replace(/[&<>"']/g, char => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[char]));
    const refAnchor = (href, text) => href ? `<a class="ref-link" href="${escapeHtml(href)}" onclick="event.stopPropagation()">${escapeHtml(text || '--')}</a>` : escapeHtml(text || '--');
    const invoiceStatusText = value => ({
      processing: 'Đang xử lý',
      completed: 'Hoàn thành',
      failed: 'Không giao được',
      cancelled: 'Đã hủy',
      merged: 'Đã gộp',
      paid: 'Đã thanh toán',
      partial: 'Thanh toán một phần',
      unpaid: 'Chưa thanh toán',
      draft: 'Đang xử lý',
      shipping: 'Đang xử lý',
      done: 'Hoàn thành'
    }[value] || 'Đang xử lý');
    const invoiceStatusClass = value => {
      if (['completed', 'paid', 'done'].includes(value)) return 'completed';
      if (value === 'partial') return 'partial';
      if (value === 'unpaid') return 'unpaid';
      if (value === 'failed') return 'failed';
      if (value === 'cancelled') return 'cancelled';
      if (value === 'merged') return 'merged';
      return 'processing';
    };
    const shipmentStatusText = value => ({ draft:'Phiếu tạm', shipping:'Đang giao', completed:'Hoàn thành', cancelled:'Đã hủy' }[value] || value || '');

    function formatInvoiceLotCell(item, product) {
      const allocs = Array.isArray(item.lot_allocations)
        ? item.lot_allocations.filter(row => Number(row.so_luong) > 0)
        : [];
      if (allocs.length) {
        return allocs.map(row => {
          const name = row.ten_lo || row.ma_lo || '';
          const hsd = row.han_su_dung ? ' HSD ' + new Date(row.han_su_dung).toLocaleDateString('vi-VN') : '';
          return `${name}${hsd} - SL ${Number(row.so_luong || 0)}`;
        }).join(', ');
      }
      const lot = item.lo_hang_id || {};
      if (lot.ten_lo || lot.ma_lo) {
        const hsd = lot.han_su_dung ? 'HSD ' + new Date(lot.han_su_dung).toLocaleDateString('vi-VN') : '';
        return [lot.ten_lo || lot.ma_lo, hsd].filter(Boolean).join(' - ');
      }
      if (product && product.quan_ly_theo_lo === false) return 'Không có';
      return 'Không có';
    }

    function toggleCreateMenu(event) {
      event.stopPropagation();
      document.getElementById('createDropdown').classList.toggle('open');
    }
    document.addEventListener('click', () => document.getElementById('createDropdown')?.classList.remove('open'));

    async function toggleInvoiceDetail(id) {
      const row = document.querySelector('[data-invoice-row="' + id + '"]');
      const detailRow = document.querySelector('[data-invoice-detail="' + id + '"]');
      if (!detailRow) return;
      const shouldOpen = !detailRow.classList.contains('open');
      document.querySelectorAll('.detail-row').forEach(item => item.classList.remove('open'));
      document.querySelectorAll('.invoice-row').forEach(item => item.classList.remove('active'));
      if (!shouldOpen) return;
      detailRow.classList.add('open');
      row?.classList.add('active');
      if (detailRow.dataset.loaded === 'true') return;
      const res = await fetch('/don-hang/hoa-don/' + id + '/detail');
      const data = await res.json();
      if (!data.success) return alert(data.message || 'Không tải được hóa đơn');
      detailRow.querySelector('.invoice-detail').innerHTML = renderInvoiceDetail(data.data);
      detailRow.dataset.loaded = 'true';
    }

    function showInvoiceTab(event, id, tab) {
      event.stopPropagation();
      const detail = document.querySelector('[data-invoice-detail="' + id + '"]');
      detail.querySelectorAll('.tab').forEach(btn => btn.classList.toggle('active', btn.dataset.tab === tab));
      detail.querySelectorAll('.panel').forEach(panel => panel.classList.toggle('active', panel.dataset.panel === tab));
    }

    const CHANGE_RECEIPT_TYPE = 'tra_tien_thua_khach';
    function receiptPaymentParts(receipt) {
      const detail = receipt?.chi_tiet_thanh_toan || {};
      return {
        cash: Number(detail.tien_mat || 0),
        transfer: Number(detail.chuyen_khoan || 0)
      };
    }
    function paymentSummaryFromReceipts(rows) {
      return (rows || []).reduce((sum, receipt) => {
        const amount = Math.abs(Number(receipt.gia_tri || 0));
        if (receipt.loai_phieu === 'thu') {
          const parts = receiptPaymentParts(receipt);
          sum.gross += amount;
          sum.cash += parts.cash;
          sum.transfer += parts.transfer;
        } else if (receipt.loai_phieu === 'chi' && receipt.loai_thu_chi === CHANGE_RECEIPT_TYPE) {
          sum.change += amount;
        }
        sum.net = Math.max(0, sum.gross - sum.change);
        return sum;
      }, { gross: 0, cash: 0, transfer: 0, change: 0, net: 0 });
    }
    function paymentSummaryHtml(summary, paid) {
      if (!summary.gross && !summary.change) return '';
      const net = Number(paid ?? summary.net);
      return `<div class="ship-grid" style="margin-bottom:10px">
        <div class="mini-field"><label>Tổng khách đưa</label><span>${moneyText(summary.gross)}</span></div>
        <div class="mini-field"><label>Tiền mặt</label><span>${moneyText(summary.cash)}</span></div>
        <div class="mini-field"><label>Chuyển khoản</label><span>${moneyText(summary.transfer)}</span></div>
        <div class="mini-field"><label>Tiền thừa trả khách</label><span>${moneyText(summary.change)}</span></div>
        <div class="mini-field"><label>Thực thu</label><span>${moneyText(net)}</span></div>
      </div>`;
    }

    function renderInvoiceVatChuaBox(vatChuaLines) {
      const lines = Array.isArray(vatChuaLines) ? vatChuaLines : [];
      if (!lines.length) return '';
      const rows = lines.map(line => {
        const maCell = line.doc_href
          ? refAnchor(line.doc_href, line.ma_chung_tu)
          : escapeHtml(line.ma_chung_tu || '---');
        const sourceCell = line.source_href && line.source_code
          ? refAnchor(line.source_href, line.source_code)
          : escapeHtml(line.source_code || '---');
        const timeText = line.created_at ? new Date(line.created_at).toLocaleString('vi-VN') : '';
        return `<tr>
          <td>${maCell}</td>
          <td>${escapeHtml(line.doc_kind_label || line.loai_label || '')}</td>
          <td>${escapeHtml(line.ma_vat_chua || '---')}</td>
          <td>${escapeHtml(line.ten_vat_chua || '---')}</td>
          <td class="num">${money(line.so_luong || 0)}</td>
          <td>${sourceCell}</td>
          <td>${escapeHtml(timeText)}</td>
        </tr>`;
      }).join('');
      return `
        <div class="invoice-vat-chua-box">
          <div class="invoice-vat-chua-title"><i class="fa-solid fa-box"></i> Vật chứa đã giao</div>
          <table class="items-table">
            <thead><tr>
              <th>Mã chứng từ</th>
              <th>Loại</th>
              <th>Mã vật chứa</th>
              <th>Tên vật chứa</th>
              <th class="num">Số lượng</th>
              <th>Chứng từ liên kết</th>
              <th>Thời gian</th>
            </tr></thead>
            <tbody>${rows}</tbody>
          </table>
        </div>`;
    }

    function renderInvoiceDetail(data) {
      const invoice = data.invoice || {};
      const customer = invoice.khach_hang_id || {};
      const shipment = data.shipment || {};
      const items = data.items || [];
      const histories = [...(data.debtHistory || []), ...(data.receipts || [])];
      const paymentSummary = paymentSummaryFromReceipts(data.receipts || []);
      const paid = Number(data.paid || 0);
      const payable = Number(invoice.thanh_toan || 0);
      const debt = Number(data.debt || Math.max(payable - paid, 0));
      const receiptAction = debt > 0
        ? `<div class="totals-receipt-action"><button type="button" class="btn solid" onclick="openInvoiceReceiptPayModal('${invoice._id}', ${debt})"><i class="fa-solid fa-money-bill-wave"></i> Tạo phiếu thu</button></div>`
        : '';
      const status = invoice.trang_thai_chuan || invoice.trang_thai || 'processing';
      const mergedTarget = status === 'merged'
        ? (invoice.merged_to_hoa_don_id
          ? refAnchor('/don-hang/hoa-don?invoice=' + encodeURIComponent(invoice.merged_to_hoa_don_id), invoice.merged_to_ma_hoa_don || 'hóa đơn nhận')
          : escapeHtml(invoice.merged_to_ma_hoa_don || 'hóa đơn khác'))
        : '';
      const mergedNotice = status === 'merged'
        ? `<div style="margin:12px 0;padding:12px 14px;border:1px solid #e9d5ff;background:#faf5ff;border-radius:8px">
            <strong>Hóa đơn này đã được gộp vào ${mergedTarget}</strong>
            <div style="margin-top:8px;color:#667085">Hóa đơn nguồn đã gộp không còn xử lý riêng. Vui lòng thao tác trên hóa đơn nhận.</div>
          </div>`
        : '';
      const mergedFromIds = Array.isArray(invoice.merged_from_hoa_don_ids) ? invoice.merged_from_hoa_don_ids : [];
      const mergedFromCodes = Array.isArray(invoice.merged_from_ma_hoa_dons) ? invoice.merged_from_ma_hoa_dons : [];
      const mergedFromLine = invoice.is_merged_invoice && mergedFromCodes.length
        ? `<div style="margin-top:8px;color:#667085;font-size:13px">Được gộp từ: ${mergedFromCodes.map((code, index) => {
            const sourceId = mergedFromIds[index];
            return sourceId
              ? refAnchor('/don-hang/hoa-don?invoice=' + encodeURIComponent(sourceId), code)
              : escapeHtml(code);
          }).join(', ')}</div>`
        : '';
      const itemRows = items.map(item => {
        const product = item.hang_hoa_id || {};
        const attributeName = item.ten_thuoc_tinh || item.ten_quy_cach || '';
        const lotName = formatInvoiceLotCell(item, product);
        return `<tr><td>${refAnchor(product._id ? '/hang-hoa/' + product._id : '', product.ma_hang || '')}</td><td>${escapeHtml(product.ten_hang || '')}</td><td>${escapeHtml(lotName)}</td><td>${escapeHtml(attributeName || 'Không có')}</td><td>${money(item.so_luong)}</td><td>${moneyText(item.don_gia)}</td><td>${moneyText(item.chiet_khau)}</td><td><strong>${moneyText(item.thanh_tien)}</strong></td></tr>`;
      }).join('') || '<tr><td colspan="8" class="loading-detail">Hóa đơn chưa có hàng hóa</td></tr>';
      const historyRows = histories.map(item => {
        const receipt = item.phieu_thu_chi_id || item;
        const code = receipt.ma_phieu || 'Công nợ';
        const receiptHref = receipt._id ? '/so-quy/phieu-thu-chi/' + receipt._id : '';
        const date = new Date(item.ngay || receipt.ngay_lap || receipt.created_at || invoice.ngay_ban).toLocaleString('vi-VN');
        const amount = Math.abs(Number(item.so_tien || receipt.gia_tri || 0));
        const type = receipt.loai_phieu ? (receipt.loai_phieu === 'chi' ? 'Chi' : 'Thu') : (item.loai || '');
        const parts = receiptPaymentParts(receipt);
        const isChange = receipt.loai_phieu === 'chi' && receipt.loai_thu_chi === CHANGE_RECEIPT_TYPE;
        const grossText = receipt.loai_phieu === 'thu' ? moneyText(amount) : '';
        const cashText = receipt.loai_phieu === 'thu' && (parts.cash || parts.transfer) ? moneyText(parts.cash) : '';
        const transferText = receipt.loai_phieu === 'thu' && (parts.cash || parts.transfer) ? moneyText(parts.transfer) : '';
        const changeText = isChange ? moneyText(amount) : '';
        const signedText = receipt.loai_phieu === 'chi' ? '-' + moneyText(amount) : moneyText(amount);
        return `<tr><td>${refAnchor(receiptHref, code)}</td><td>${escapeHtml(date)}</td><td>${escapeHtml(receipt.nguoi_tao_id?.ho_ten || '')}</td><td>${grossText || moneyText(amount)}</td><td>${cashText}</td><td>${transferText}</td><td>${changeText}</td><td><span class="status completed">${escapeHtml(type)}</span></td><td>${signedText}</td></tr>`;
      }).join('') || '<tr><td colspan="9" class="loading-detail">Chưa có lịch sử thanh toán hoặc công nợ</td></tr>';
      const shipmentPanel = shipment._id ? `
        <div class="panel" data-panel="shipping">
          <div class="ship-grid">
            <div class="mini-field"><label>Đối tác giao hàng</label><span>${escapeHtml(shipment.doi_tac_giao_hang_id?.ten_doi_tac || 'Tự giao hàng')}</span></div>
            <div class="mini-field"><label>Phí giao hàng</label><span>${moneyText(shipment.phi_giao_hang)}</span></div>
            <div class="mini-field"><label>Trạng thái giao hàng</label><span>${escapeHtml(shipmentStatusText(shipment.trang_thai))}</span></div>
            <div class="mini-field"><label>Ngày giao</label><span>${shipment.updated_at ? escapeHtml(new Date(shipment.updated_at).toLocaleString('vi-VN')) : ''}</span></div>
          </div>
        </div>` : '<div class="panel" data-panel="shipping"><div class="loading-detail">Hóa đơn không có vận đơn</div></div>';

      return `
        <div class="tabs">
          <button type="button" class="tab active" data-tab="info" onclick="showInvoiceTab(event,'${invoice._id}','info')">Thông tin</button>
          <button type="button" class="tab" data-tab="payment" onclick="showInvoiceTab(event,'${invoice._id}','payment')">Thanh toán</button>
          <button type="button" class="tab" data-tab="shipping" onclick="showInvoiceTab(event,'${invoice._id}','shipping')">Giao hàng</button>
        </div>
        <div class="panel active" data-panel="info">
          <div class="detail-head">
            <div>
              <div><span class="detail-title">${escapeHtml(customer.ten_khach_hang || 'Khách lẻ')}</span> <span>${refAnchor(invoice._id ? '/hoa-don/' + invoice._id : '', invoice.ma_hoa_don || '')}</span> <span class="status ${escapeHtml(invoiceStatusClass(status))}">${escapeHtml(invoiceStatusText(status))}</span></div>
              ${mergedFromLine}
              <div class="detail-meta">
                <div class="mini-field"><label>Người tạo</label><span>${escapeHtml(invoice.nguoi_ban_id?.ho_ten || invoice.nguoi_ban_id?.username || '')}</span></div>
                <div class="mini-field"><label>Người bán</label><span>${escapeHtml(invoice.nguoi_ban_id?.ho_ten || invoice.nguoi_ban_id?.username || '')}</span></div>
                <div class="mini-field"><label>Ngày bán</label><span>${escapeHtml(new Date(invoice.ngay_ban || invoice.created_at).toLocaleString('vi-VN'))}</span></div>
                <div class="mini-field"><label>Kho</label><span>${escapeHtml(invoice.kho_id?.ten_kho || invoice.kho_id?.ma_kho || '')}</span></div>
                <div class="mini-field"><label>Đơn hàng</label><span>${refAnchor(invoice.don_hang_id?._id ? '/don-hang/' + invoice.don_hang_id._id : '', invoice.don_hang_id?.ma_don_hang || '')}</span></div>
                <div class="mini-field"><label>Kênh bán</label><span>Bán trực tiếp</span></div>
              </div>
            </div>
            <div>${escapeHtml(invoice.cua_hang_id?.ten_cua_hang || 'Cửa hàng trung tâm')}</div>
          </div>
          ${mergedNotice}
          ${renderInvoiceVatChuaBox(data.vat_chua_lines || [])}
          <table class="items-table"><thead><tr><th>Mã hàng</th><th>Tên hàng</th><th>Lô</th><th>Thuộc tính</th><th>Số lượng</th><th>Đơn giá</th><th>Giảm giá</th><th>Thành tiền</th></tr></thead><tbody>${itemRows}</tbody></table>
          <div class="detail-bottom">
            <div class="note">${escapeHtml(invoice.ghi_chu || 'Ghi chú')}</div>
            <div>
              <div class="total-line"><span>Tổng tiền hàng (${items.length})</span><strong>${moneyText(invoice.tong_tien)}</strong></div>
              <div class="total-line"><span>Giảm giá hóa đơn</span><span>${moneyText(invoice.giam_gia)}</span></div>
              <div class="total-line"><span>Khách cần trả</span><strong>${moneyText(payable)}</strong></div>
              <div class="total-line"><span>Khách đã trả</span><strong>${moneyText(paid)}</strong></div>
              <div class="total-line"><span>Còn nợ</span><strong>${moneyText(debt)}</strong></div>
              ${receiptAction}
            </div>
          </div>
          <div class="page-actions page-actions--split page-actions--bordered detail-actions">
            <div class="page-actions__left detail-action-group">${status !== 'cancelled' && status !== 'merged' ? `<button type="button" class="btn" onclick="event.stopPropagation(); openInvoiceEditModal('${invoice._id}')"><i class="fa-regular fa-pen-to-square"></i> Chỉnh sửa</button>` : ''}<button type="button" class="btn" onclick="cancelInvoice('${invoice._id}')" ${status === 'merged' ? 'disabled' : ''}><i class="fa-regular fa-trash-can"></i> Hủy</button><a class="btn" href="/don-hang/hoa-don/create?copy_from=${invoice._id}"><i class="fa-regular fa-copy"></i> Sao chép</a><a class="btn" href="/don-hang/hoa-don/${invoice._id}/export.xlsx"><i class="fa-solid fa-file-export"></i> Xuất file</a></div>
            <div class="page-actions__right detail-action-group"><a class="btn" href="/don-hang/tra-hang/create?hoa_don_id=${invoice._id}"><i class="fa-solid fa-right-left"></i> Trả hàng</a><a class="btn" href="/chung-tu-kho/hoa-don-ban/${invoice._id}" target="_blank"><i class="fa-solid fa-print"></i> In</a></div>
          </div>
        </div>
        <div class="panel" data-panel="payment">${paymentSummaryHtml(paymentSummary, paid)}<table class="items-table"><thead><tr><th>Mã phiếu</th><th>Thời gian</th><th>Người tạo</th><th>Tổng khách đưa / Giá trị</th><th>Tiền mặt</th><th>Chuyển khoản</th><th>Tiền thừa</th><th>Loại</th><th>Tiền thu/chi</th></tr></thead><tbody>${historyRows}</tbody></table></div>
        ${shipmentPanel}`;
    }

    function readInvoiceReceiptPayment() {
      const tien_mat = Math.max(0, numberValue(document.getElementById('invoiceReceiptPayCash')?.value));
      const chuyen_khoan = Math.max(0, numberValue(document.getElementById('invoiceReceiptPayTransfer')?.value));
      const tien_thua = Math.max(0, numberValue(document.getElementById('invoiceReceiptPayChange')?.value));
      const tong_khach_dua = tien_mat + chuyen_khoan;
      const thuc_thu = Math.max(0, tong_khach_dua - tien_thua);
      return { tien_mat, chuyen_khoan, tien_thua, tong_khach_dua, thuc_thu };
    }

    function refreshInvoiceReceiptPaySummary() {
      const payment = readInvoiceReceiptPayment();
      const errors = [];
      if (payment.tien_thua > payment.tong_khach_dua) errors.push('Tiền trả khách không được vượt tổng khách đưa');
      if (payment.tong_khach_dua > 0 && payment.thuc_thu <= 0) errors.push('Thực thu phải lớn hơn 0');
      if (payment.thuc_thu > pendingInvoiceReceiptDue) errors.push('Thực thu không được vượt số còn phải thu');
      const tongEl = document.getElementById('invoiceReceiptPayTongKhach');
      const thucEl = document.getElementById('invoiceReceiptPayThucThu');
      const conEl = document.getElementById('invoiceReceiptPayConLai');
      const errWrap = document.getElementById('invoiceReceiptPayErrorWrap');
      const errEl = document.getElementById('invoiceReceiptPayErrors');
      if (tongEl) tongEl.textContent = moneyText(payment.tong_khach_dua);
      if (thucEl) thucEl.textContent = moneyText(payment.thuc_thu);
      if (conEl) conEl.textContent = moneyText(Math.max(pendingInvoiceReceiptDue - payment.thuc_thu, 0));
      if (errWrap && errEl) {
        if (errors.length) {
          errWrap.style.display = '';
          errEl.textContent = errors.join('. ');
        } else {
          errWrap.style.display = 'none';
          errEl.textContent = '';
        }
      }
    }

    function openInvoiceReceiptPayModal(invoiceId, dueAmount) {
      pendingInvoiceReceiptId = invoiceId;
      pendingInvoiceReceiptDue = Math.max(0, Number(dueAmount || 0));
      invoiceReceiptCashBookId = '';
      document.getElementById('invoiceReceiptPayDue').textContent = moneyText(pendingInvoiceReceiptDue);
      const cashEl = document.getElementById('invoiceReceiptPayCash');
      const transferEl = document.getElementById('invoiceReceiptPayTransfer');
      const changeEl = document.getElementById('invoiceReceiptPayChange');
      const transferSelect = document.getElementById('invoiceReceiptPayTransferBook');
      if (cashEl) { cashEl.value = pendingInvoiceReceiptDue > 0 ? money(pendingInvoiceReceiptDue) : ''; delete cashEl.dataset.vnBound; }
      if (transferEl) { transferEl.value = ''; delete transferEl.dataset.vnBound; }
      if (changeEl) { changeEl.value = ''; delete changeEl.dataset.vnBound; }
      if (transferSelect) transferSelect.innerHTML = '<option value="">— Chọn tài khoản chuyển khoản —</option>';
      bindReceiptPayInput(cashEl);
      bindReceiptPayInput(transferEl);
      bindReceiptPayInput(changeEl);
      balanceInvoiceReceiptPayment();
      syncInvoiceReceiptTransferBookVisibility();
      refreshInvoiceReceiptPaySummary();
      document.getElementById('invoiceReceiptPayModal').classList.add('open');
      Promise.all([
        prepareInvoiceReceiptCashBook(),
        loadInvoiceReceiptBooks('chuyen_khoan')
      ]).then(function(results) {
        if (String(pendingInvoiceReceiptId) !== String(invoiceId)) return;
        invoiceReceiptCashBookId = results[0] || '';
        renderInvoiceReceiptTransferBooks(results[1] || []);
        syncInvoiceReceiptTransferBookVisibility();
      }).catch(function() {});
    }

    function closeInvoiceReceiptPayModal() {
      pendingInvoiceReceiptId = '';
      pendingInvoiceReceiptDue = 0;
      invoiceReceiptCashBookId = '';
      document.getElementById('invoiceReceiptPayModal').classList.remove('open');
    }

    async function submitInvoiceReceiptPayModal() {
      const payment = readInvoiceReceiptPayment();
      if (!pendingInvoiceReceiptId || payment.tong_khach_dua <= 0) return alert('Vui lòng nhập số tiền khách đưa.');
      if (payment.tien_thua > payment.tong_khach_dua) return alert('Tiền trả khách không được vượt tổng khách đưa.');
      if (payment.thuc_thu <= 0) return alert('Thực thu phải lớn hơn 0.');
      if (payment.thuc_thu > pendingInvoiceReceiptDue) return alert('Thực thu không được vượt số còn phải thu.');
      if ((payment.tien_mat > 0 || payment.tien_thua > 0) && !invoiceReceiptCashBookId) {
        invoiceReceiptCashBookId = await prepareInvoiceReceiptCashBook();
      }
      if ((payment.tien_mat > 0 || payment.tien_thua > 0) && !invoiceReceiptCashBookId) {
        return alert('Chưa có sổ tiền mặt active để thu tiền.');
      }
      const bankBookId = payment.chuyen_khoan > 0
        ? String(document.getElementById('invoiceReceiptPayTransferBook')?.value || '').trim()
        : '';
      if (payment.chuyen_khoan > 0 && !bankBookId) {
        return alert('Vui lòng chọn sổ quỹ cho tiền chuyển khoản.');
      }
      const res = await fetch('/don-hang/hoa-don/' + pendingInvoiceReceiptId + '/phieu-thu', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          tien_mat_khach_dua: payment.tien_mat,
          chuyen_khoan_khach_dua: payment.chuyen_khoan,
          tien_thua_tra_khach: payment.tien_thua,
          payment_v2: true,
          so_quy_tien_mat_id: (payment.tien_mat > 0 || payment.tien_thua > 0) ? invoiceReceiptCashBookId : '',
          so_quy_chuyen_khoan_id: bankBookId
        })
      });
      const data = await res.json();
      if (!data.success) return alert(data.message || 'Không tạo được phiếu thu');
      location.reload();
    }

    async function cancelInvoice(id) {
      if (!confirm('Hủy hóa đơn này? Hệ thống sẽ hoàn kho, hủy phiếu thu, đảo công nợ và hủy vận đơn liên quan.')) return;
      const res = await fetch('/don-hang/hoa-don/' + id + '/cancel', { method: 'POST', headers: { 'Content-Type': 'application/json' } });
      const data = await res.json();
      if (!data.success) return alert(data.message || 'Không hủy được hóa đơn');
      location.reload();
    }

    function closeInvoiceEditModal() {
      document.getElementById('invoiceEditModal')?.classList.remove('open');
      currentInvoiceEditId = '';
    }

    function calcInvoiceEditLineTotal(rowEl) {
      const qty = Math.max(0, Math.floor(numberValue(rowEl.querySelector('[data-edit-field="so_luong"]')?.value || 0)));
      const price = numberValue(rowEl.querySelector('[data-edit-field="don_gia"]')?.value || 0);
      const discount = numberValue(rowEl.querySelector('[data-edit-field="chiet_khau"]')?.value || 0);
      return Math.max(0, Math.floor(qty * price - discount));
    }

    function calculateInvoiceEditTotals() {
      let goodsTotal = 0;
      document.querySelectorAll('#invoiceEditModal [data-edit-row]').forEach(rowEl => {
        const line = calcInvoiceEditLineTotal(rowEl);
        goodsTotal += line;
        const totalCell = rowEl.querySelector('[data-edit-total]');
        if (totalCell) totalCell.textContent = moneyText(line);
      });
      const goodsEl = document.getElementById('editInvoiceGoodsTotal');
      const totalEl = document.getElementById('editInvoiceTotal');
      if (goodsEl) goodsEl.textContent = moneyText(goodsTotal);
      if (totalEl) totalEl.textContent = moneyText(goodsTotal);
    }

    function validateInvoiceVatChuaEdit() {
      const id = String(document.getElementById('editInvoiceVatChuaId')?.value || '').trim();
      const rawQty = String(document.getElementById('editInvoiceVatChuaQty')?.value || '').replace(/\./g, '').replace(/,/g, '').trim();
      if (!id && !rawQty) return true;
      const qty = Math.floor(Number(rawQty || 0));
      if (id && qty <= 0) {
        alert('Số lượng vật chứa phải lớn hơn 0');
        document.getElementById('editInvoiceVatChuaQty')?.focus();
        return false;
      }
      if (!id && rawQty && qty > 0) {
        alert('Vui lòng chọn vật chứa');
        document.getElementById('editInvoiceVatChuaId')?.focus();
        return false;
      }
      return true;
    }

    function toDateTimeLocalValue(value) {
      const date = value ? new Date(value) : new Date();
      if (Number.isNaN(date.getTime())) return '';
      const local = new Date(date.getTime() - date.getTimezoneOffset() * 60000);
      return local.toISOString().slice(0, 16);
    }

    async function openInvoiceEditModal(id) {
      currentInvoiceEditId = id;
      const modal = document.getElementById('invoiceEditModal');
      const title = document.getElementById('invoiceEditModalTitle');
      const body = document.getElementById('invoiceEditModalBody');
      body.innerHTML = 'Đang tải hóa đơn...';
      modal.classList.add('open');
      try {
        const res = await fetch('/don-hang/hoa-don/' + id + '/detail');
        const data = await res.json();
        if (!data.success) throw new Error(data.message || 'Không tải được hóa đơn');
        const ticket = data.data.invoice || {};
        const readonly = (ticket.trang_thai_chuan || ticket.trang_thai) === 'cancelled';
        if (readonly) throw new Error('Hóa đơn đã hủy, không thể chỉnh sửa');
        const items = data.data.items || [];
        const vcEdit = data.data.vat_chua_edit || {};
        const vcLines = data.data.vat_chua_lines || [];
        title.textContent = `Chỉnh sửa ${ticket.ma_hoa_don || 'hóa đơn'}`;
        const canEditVatChua = vatChuaList.length > 0 || vcLines.length > 0;
        let vatChuaSection = '';
        if (canEditVatChua) {
          const vcIds = new Set(vatChuaList.map(vc => String(vc._id || '')));
          const currentVcId = String(vcEdit.vat_chua_id || '');
          let extraVcOption = '';
          if (currentVcId && !vcIds.has(currentVcId)) {
            const fromLine = vcLines[0] || {};
            const label = (fromLine.ma_vat_chua ? fromLine.ma_vat_chua + ' - ' : '') + (fromLine.ten_vat_chua || 'Vật chứa hiện tại');
            extraVcOption = `<option value="${escapeHtml(currentVcId)}" selected>${escapeHtml(label)}</option>`;
          }
          const vatChuaOptions = ['<option value="">— Chọn —</option>']
            .concat(extraVcOption ? [extraVcOption] : [])
            .concat(vatChuaList.map(vc => {
              const vcId = String(vc._id || '');
              const selected = currentVcId && vcId === currentVcId ? 'selected' : '';
              const label = (vc.ma_vat_chua ? vc.ma_vat_chua + ' - ' : '') + (vc.ten_vat_chua || '---');
              return `<option value="${escapeHtml(vcId)}" ${selected}>${escapeHtml(label)}</option>`;
            }))
            .join('');
          const vcQty = Number(vcEdit.so_luong || 0) > 0 ? String(Math.floor(Number(vcEdit.so_luong || 0))) : '';
          vatChuaSection = `
          <div class="invoice-vat-chua-box edit-vat-chua-box">
            <div class="invoice-vat-chua-title"><i class="fa-solid fa-box"></i> Vật chứa</div>
            <div class="edit-vat-chua-row">
              <label for="editInvoiceVatChuaId">Vật chứa</label>
              <div class="vat-chua-combo">
                <select id="editInvoiceVatChuaId" title="Chọn vật chứa">${vatChuaOptions}</select>
                <input id="editInvoiceVatChuaQty" class="vat-chua-qty" inputmode="numeric" placeholder="SL" title="Số lượng vật chứa" value="${escapeHtml(vcQty)}">
              </div>
            </div>
            <p class="lot-note">Để trống nếu không xuất vật chứa. Khi lưu, tồn vật chứa được điều chỉnh theo thay đổi.</p>
          </div>`;
        }
        const itemRows = items.map((row, index) => {
          const product = row.hang_hoa_id || {};
          return `
            <tr data-edit-row="${row._id}">
              <td>${index + 1}</td>
              <td>${escapeHtml(product.ma_hang || '')}</td>
              <td>${escapeHtml(product.ten_hang || '')}</td>
              <td><input data-edit-field="so_luong" type="number" min="1" step="1" value="${Number(row.so_luong || 1)}" oninput="calculateInvoiceEditTotals()"></td>
              <td><input data-edit-field="don_gia" inputmode="numeric" value="${money(row.don_gia || 0)}" oninput="calculateInvoiceEditTotals()"></td>
              <td><input data-edit-field="chiet_khau" inputmode="numeric" value="${money(row.chiet_khau || 0)}" oninput="calculateInvoiceEditTotals()"></td>
              <td class="num" data-edit-total>${moneyText(row.thanh_tien || 0)}</td>
            </tr>`;
        }).join('');
        const currentCustomerId = String(ticket.khach_hang_id?._id || ticket.khach_hang_id || '');
        const customerIds = new Set(customers.map(customer => String(customer._id || '')));
        let customerOptions = '<option value="">Khách lẻ</option>';
        if (currentCustomerId && !customerIds.has(currentCustomerId)) {
          const fallbackLabel = [ticket.khach_hang_id?.ma_khach_hang, ticket.khach_hang_id?.ten_khach_hang].filter(Boolean).join(' - ') || 'Khách hiện tại';
          customerOptions += `<option value="${escapeHtml(currentCustomerId)}" selected>${escapeHtml(fallbackLabel)}</option>`;
        }
        customerOptions += customers.map(customer => {
          const customerId = String(customer._id || '');
          const selected = currentCustomerId && customerId === currentCustomerId ? 'selected' : '';
          const label = [customer.ma_khach_hang, customer.ten_khach_hang].filter(Boolean).join(' - ') || '---';
          return `<option value="${escapeHtml(customerId)}" ${selected}>${escapeHtml(label)}</option>`;
        }).join('');
        body.innerHTML = `
          <div class="invoice-edit-meta">
            <div class="item">Khách hàng<select id="editInvoiceCustomer">${customerOptions}</select></div>
            <div class="item">Ngày hóa đơn<input id="editInvoiceDate" type="datetime-local" value="${escapeHtml(toDateTimeLocalValue(ticket.ngay_ban || ticket.created_at))}"></div>
            <div class="item">Kho<b>${escapeHtml(ticket.kho_id?.ten_kho || ticket.kho_id?.ma_kho || '--')}</b></div>
            <div class="item">Trạng thái<b>${escapeHtml(invoiceStatusText(ticket.trang_thai_chuan || ticket.trang_thai || 'processing'))}</b></div>
            <div class="item">Khách cần trả<b>${moneyText(ticket.thanh_toan || ticket.tong_tien || 0)}</b></div>
          </div>
          ${vatChuaSection}
          <div class="edit-table-wrap">
            <table class="edit-table">
              <thead><tr><th>STT</th><th>Mã hàng</th><th>Tên hàng</th><th>Số lượng</th><th>Đơn giá</th><th>Giảm dòng</th><th class="num">Thành tiền</th></tr></thead>
              <tbody>${itemRows || '<tr><td colspan="7">Hóa đơn chưa có hàng hóa</td></tr>'}</tbody>
            </table>
          </div>
          <div class="edit-total-box">
            <span>Tổng tiền hàng</span><b id="editInvoiceGoodsTotal">0 VNĐ</b>
            <span>Tổng cộng</span><b id="editInvoiceTotal">0 VNĐ</b>
          </div>
          <p class="lot-note">Khi đổi số lượng, hệ thống sẽ điều chỉnh tồn kho theo chênh lệch (nếu hóa đơn đã trừ tồn).</p>
        `;
        calculateInvoiceEditTotals();
      } catch (error) {
        body.innerHTML = `<span style="color:#d92d20">${escapeHtml(error.message || 'Không tải được hóa đơn')}</span>`;
      }
    }

    async function saveInvoiceEdit() {
      if (!currentInvoiceEditId) return;
      if (!validateInvoiceVatChuaEdit()) return;
      try {
        const items = Array.from(document.querySelectorAll('#invoiceEditModal [data-edit-row]')).map(rowEl => ({
          _id: rowEl.dataset.editRow,
          so_luong: rowEl.querySelector('[data-edit-field="so_luong"]')?.value || 0,
          don_gia: rowEl.querySelector('[data-edit-field="don_gia"]')?.value || 0,
          chiet_khau: rowEl.querySelector('[data-edit-field="chiet_khau"]')?.value || 0
        }));
        const payload = {
          items,
          khach_hang_id: document.getElementById('editInvoiceCustomer')?.value || '',
          ngay_ban: document.getElementById('editInvoiceDate')?.value || ''
        };
        const editVatChuaEl = document.getElementById('editInvoiceVatChuaId');
        if (editVatChuaEl) {
          payload.vat_chua_id = editVatChuaEl.value || '';
          payload.vat_chua_so_luong = document.getElementById('editInvoiceVatChuaQty')?.value || '';
        }
        const res = await fetch('/don-hang/hoa-don/' + currentInvoiceEditId + '/save', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify(payload)
        });
        const data = await res.json();
        if (!data.success) throw new Error(data.message || 'Không lưu được hóa đơn');
        alert(data.message || 'Đã lưu');
        location.reload();
      } catch (error) {
        alert(error.message || 'Không lưu được hóa đơn');
      }
    }

    document.addEventListener('DOMContentLoaded', () => {
      const invoiceFilterForm = document.getElementById('invoiceFilterForm');
      function parseFilterMoney(value) {
        const normalized = String(value || '').replace(/\./g, '').replace(/,/g, '').trim();
        if (normalized === '') return '';
        const number = Number(normalized);
        return Number.isFinite(number) && number >= 0 ? Math.floor(number) : '';
      }
      function formatFilterMoney(value) {
        if (value === '' || value == null) return '';
        const number = Math.max(0, Math.floor(Number(value || 0)));
        return number.toLocaleString('vi-VN');
      }
      function bindVnMoneyFilterInputs(root) {
        const scope = root || document;
        scope.querySelectorAll('.js-vn-money-filter').forEach(input => {
          if (input.getAttribute('data-vn-money-bound') === '1') return;
          input.setAttribute('data-vn-money-bound', '1');
          input.addEventListener('input', () => {
            const digits = String(input.value || '').replace(/\D/g, '');
            input.value = digits === '' ? '' : formatFilterMoney(digits);
          });
        });
      }
      function positionPurchaseDebtWarnTip(btn, tip) {
        if (!btn || !tip) return;
        const rect = btn.getBoundingClientRect();
        const tipWidth = Math.min(300, window.innerWidth - 24);
        let left = Math.max(12, rect.right - tipWidth);
        let top = rect.bottom + 8;
        if (top + tip.offsetHeight > window.innerHeight - 12) {
          top = Math.max(12, rect.top - tip.offsetHeight - 8);
        }
        tip.style.width = tipWidth + 'px';
        tip.style.left = left + 'px';
        tip.style.top = top + 'px';
      }
      function bindPurchaseDebtWarnTips(root) {
        const scope = root || document;
        scope.querySelectorAll('.js-purchase-debt-warn').forEach(btn => {
          if (btn.dataset.warnTipBound === '1') return;
          btn.dataset.warnTipBound = '1';
          const tip = btn.querySelector('.purchase-debt-warn-tip');
          if (!tip) return;
          const showTip = () => {
            tip.classList.add('is-visible');
            positionPurchaseDebtWarnTip(btn, tip);
          };
          const hideTip = () => tip.classList.remove('is-visible');
          btn.addEventListener('mouseenter', showTip);
          btn.addEventListener('mouseleave', hideTip);
          btn.addEventListener('focus', showTip);
          btn.addEventListener('blur', hideTip);
          window.addEventListener('scroll', hideTip, true);
          window.addEventListener('resize', () => {
            if (tip.classList.contains('is-visible')) positionPurchaseDebtWarnTip(btn, tip);
          });
        });
      }
      if (invoiceFilterForm) {
        bindVnMoneyFilterInputs(invoiceFilterForm);
        invoiceFilterForm.addEventListener('submit', () => {
          invoiceFilterForm.querySelectorAll('.js-vn-money-filter').forEach(input => {
            const parsed = parseFilterMoney(input.value);
            input.value = parsed === '' ? '' : String(parsed);
          });
        });
        const warnOnlyCheckbox = document.getElementById('warnOnlyCheckbox');
        if (warnOnlyCheckbox) warnOnlyCheckbox.addEventListener('change', () => invoiceFilterForm.submit());
        const warnMinDaysInput = invoiceFilterForm.querySelector('input[name="warnMinDays"]');
        if (warnMinDaysInput) warnMinDaysInput.addEventListener('change', () => invoiceFilterForm.submit());
        const warnMinAmountInput = invoiceFilterForm.querySelector('input[name="warnMinAmount"]');
        if (warnMinAmountInput) warnMinAmountInput.addEventListener('change', () => invoiceFilterForm.submit());
      }
      bindPurchaseDebtWarnTips(document);

      (function initInvoiceMergeModal() {
        const overlay = document.getElementById('invoiceMergeModalOverlay');
        const openBtn = document.getElementById('openInvoiceMergeModal');
        const closeBtn = document.getElementById('invoiceMergeModalClose');
        const cancelBtn = document.getElementById('invoiceMergeCancel');
        const rowsEl = document.getElementById('invoiceMergeRows');
        const emptyEl = document.getElementById('invoiceMergeEmpty');
        const emptyTitleEl = document.getElementById('invoiceMergeEmptyTitle');
        const emptyDescEl = document.getElementById('invoiceMergeEmptyDesc');
        const footEl = document.getElementById('invoiceMergeFoot');
        const customerSelect = document.getElementById('invoiceMergeCustomerSelect');
        const modalCheckAll = document.getElementById('invoiceMergeCheckAll');
        const submitBtn = document.getElementById('invoiceMergeSubmit');
        let modalInvoices = [];

        function readInvoice(row) {
          return {
            id: row.dataset.invoiceId || '',
            code: row.dataset.invoiceCode || '',
            date: new Date(row.dataset.invoiceDate || ''),
            status: row.dataset.invoiceStatus || '',
            deliveryStatus: row.dataset.deliveryStatus || 'none',
            hasReturn: row.dataset.hasReturn === '1',
            customerId: row.dataset.customerId || '',
            customerCode: row.dataset.customerCode || '',
            customerName: row.dataset.customerName || 'Khách lẻ',
            customerKey: row.dataset.customerId || row.dataset.customerCode || '',
            payable: Number(row.dataset.payable || 0),
            paid: Number(row.dataset.paid || 0)
          };
        }

        function isMergeableInvoice(invoice) {
          if (!invoice || !invoice.id) return false;
          if (['cancelled', 'merged'].includes(invoice.status)) return false;
          if (invoice.hasReturn) return false;
          return Boolean(invoice.customerKey);
        }

        function getModalCustomers(invoices) {
          const map = new Map();
          invoices.forEach(invoice => {
            if (!invoice.customerKey) return;
            if (!map.has(invoice.customerKey)) {
              map.set(invoice.customerKey, {
                key: invoice.customerKey,
                code: invoice.customerCode,
                name: invoice.customerName || 'Khách lẻ'
              });
            }
          });
          return Array.from(map.values()).sort((a, b) => a.name.localeCompare(b.name, 'vi'));
        }

        function renderCustomerOptions(invoices) {
          if (!customerSelect) return;
          const customers = getModalCustomers(invoices);
          customerSelect.innerHTML = '<option value="">— Chọn khách hàng —</option>' + customers.map(customer => {
            const label = [customer.code, customer.name].filter(Boolean).join(' - ');
            return `<option value="${escapeHtml(customer.key)}">${escapeHtml(label)}</option>`;
          }).join('');
        }

        function getFilteredModalInvoices() {
          const customerKey = customerSelect?.value || '';
          if (!customerKey) return [];
          return modalInvoices.filter(invoice => invoice.customerKey === customerKey);
        }

        function updateModalCheckAll() {
          if (!modalCheckAll) return;
          const rowChecks = Array.from(document.querySelectorAll('.invoice-merge-row-check'));
          modalCheckAll.checked = rowChecks.length > 0 && rowChecks.every(cb => cb.checked);
          modalCheckAll.indeterminate = rowChecks.some(cb => cb.checked) && !modalCheckAll.checked;
        }

        function renderRows(invoices, emptyTitle, emptyDesc) {
          if (!rowsEl || !emptyEl || !footEl) return;
          const hasRows = invoices.length > 0;
          rowsEl.innerHTML = hasRows ? invoices.map(invoice => `
            <tr>
              <td class="invoice-merge-check"><input class="invoice-merge-row-check" type="checkbox" value="${escapeHtml(invoice.id)}" data-customer-key="${escapeHtml(invoice.customerKey)}"></td>
              <td>${escapeHtml(invoice.code)}</td>
              <td>${escapeHtml(Number.isFinite(invoice.date.getTime()) ? invoice.date.toLocaleString('vi-VN') : '')}</td>
              <td class="num">${moneyText(invoice.payable)}</td>
              <td class="num">${moneyText(invoice.paid)}</td>
              <td>${escapeHtml(invoice.customerCode)}</td>
              <td>${escapeHtml(invoice.customerName)}</td>
            </tr>
          `).join('') : '';
          if (emptyTitleEl) emptyTitleEl.textContent = emptyTitle || 'Chưa chọn khách hàng';
          if (emptyDescEl) emptyDescEl.textContent = emptyDesc || '';
          emptyEl.style.display = hasRows ? 'none' : 'flex';
          footEl.style.display = hasRows ? 'flex' : 'none';
          updateModalCheckAll();
          document.querySelectorAll('.invoice-merge-row-check').forEach(cb => cb.addEventListener('change', updateModalCheckAll));
        }

        function refreshModalRows() {
          const customerKey = customerSelect?.value || '';
          if (!customerKey) {
            renderRows([], 'Chưa chọn khách hàng', 'Vui lòng chọn khách hàng để xem danh sách hóa đơn có thể gộp.');
            return;
          }
          const filteredInvoices = getFilteredModalInvoices();
          renderRows(
            filteredInvoices,
            'Không có hóa đơn để gộp',
            'Khách hàng này chưa có hóa đơn hợp lệ trong danh sách hiện tại (đã loại hóa đơn hủy, đã gộp hoặc đã trả hàng).'
          );
        }

        async function submitMergeInvoices() {
          const customerKey = customerSelect?.value || '';
          if (!customerKey) {
            return alert('Vui lòng chọn khách hàng trước khi gộp hóa đơn.');
          }
          const selectedIds = Array.from(document.querySelectorAll('.invoice-merge-row-check:checked')).map(cb => cb.value).filter(Boolean);
          if (selectedIds.length < 2) {
            return alert('Vui lòng chọn ít nhất 2 hóa đơn để gộp.');
          }
          const selectedCustomerKeys = new Set(
            Array.from(document.querySelectorAll('.invoice-merge-row-check:checked'))
              .map(cb => cb.dataset.customerKey || '')
              .filter(Boolean)
          );
          if (selectedCustomerKeys.size > 1) {
            return alert('Chỉ được gộp các hóa đơn thuộc cùng một khách hàng.');
          }
          if (submitBtn) submitBtn.disabled = true;
          try {
            const res = await fetch('/api/don-hang/gop-hoa-don', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ hoa_don_ids: selectedIds })
            });
            const data = await res.json();
            if (!data.success) return alert(data.message || 'Không gộp được hóa đơn.');
            window.location.href = '/don-hang/hoa-don?invoice=' + encodeURIComponent(data.data?.hoa_don_nhan_id || selectedIds[0]);
          } catch (error) {
            alert('Không gộp được hóa đơn.');
          } finally {
            if (submitBtn) submitBtn.disabled = false;
          }
        }

        function openModal() {
          if (!overlay) return;
          const allRows = Array.from(document.querySelectorAll('.invoice-row'));
          modalInvoices = allRows.map(readInvoice).filter(isMergeableInvoice);
          renderCustomerOptions(modalInvoices);
          if (customerSelect) customerSelect.value = '';
          refreshModalRows();
          overlay.style.display = 'flex';
        }

        function closeModal() {
          if (overlay) overlay.style.display = 'none';
        }

        if (openBtn) openBtn.addEventListener('click', openModal);
        if (closeBtn) closeBtn.addEventListener('click', closeModal);
        if (cancelBtn) cancelBtn.addEventListener('click', closeModal);
        if (submitBtn) submitBtn.addEventListener('click', submitMergeInvoices);
        if (customerSelect) customerSelect.addEventListener('change', refreshModalRows);
        if (modalCheckAll) {
          modalCheckAll.addEventListener('change', () => {
            document.querySelectorAll('.invoice-merge-row-check').forEach(cb => { cb.checked = modalCheckAll.checked; });
            updateModalCheckAll();
          });
        }
        document.addEventListener('keydown', e => {
          if (e.key === 'Escape' && overlay?.style.display === 'flex') closeModal();
        });
      })();

      (function initInvoiceTrashModal() {
        var openBtn = document.getElementById('openInvoiceTrashModal');
        var overlay = document.getElementById('invoiceTrashModalOverlay');
        var closeBtn = document.getElementById('invoiceTrashModalClose');
        var cancelBtn = document.getElementById('invoiceTrashCancel');
        var confirmBtn = document.getElementById('invoiceTrashConfirm');
        var alertBox = document.getElementById('invoiceTrashAlert');
        var selectedList = document.getElementById('invoiceTrashSelectedList');
        var impactBody = document.getElementById('invoiceTrashImpactRows');
        var invoiceChecks = Array.prototype.slice.call(document.querySelectorAll('.invoice-select-check'));
        var pendingIds = [];
        var previewData = null;

        function escapeHtml(value) {
          return String(value == null ? '' : value).replace(/[&<>"']/g, function(char) {
            return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[char];
          });
        }

        function getSelectedInvoiceIds() {
          return invoiceChecks.filter(function(cb) { return cb.checked; }).map(function(cb) {
            return String(cb.value || '').trim();
          }).filter(Boolean);
        }

        function updateDeleteButtonState() {
          if (!openBtn) return;
          openBtn.disabled = getSelectedInvoiceIds().length === 0;
        }

        function closeTrashModal() {
          if (!overlay) return;
          overlay.classList.remove('is-open');
          overlay.setAttribute('aria-hidden', 'true');
          pendingIds = [];
          previewData = null;
          if (confirmBtn) confirmBtn.disabled = true;
        }

        function renderAlert(preview) {
          if (!alertBox) return;
          var html = '';
          (preview.items || []).forEach(function(item) {
            if (!item.can_trash && item.block_reason) {
              html += '<div class="invoice-trash-alert is-error">' + escapeHtml(item.ma_hoa_don || item.hoa_don_id) + ': ' + escapeHtml(item.block_reason) + '</div>';
            }
            (item.warnings || []).forEach(function(warn) {
              html += '<div class="invoice-trash-alert is-warn">' + escapeHtml(item.ma_hoa_don || '') + (item.ma_hoa_don ? ' — ' : '') + escapeHtml(warn) + '</div>';
            });
          });
          alertBox.innerHTML = html;
        }

        function renderSelectedList(preview) {
          if (!selectedList) return;
          selectedList.innerHTML = (preview.items || []).map(function(item) {
            var label = [item.ma_hoa_don, item.ten_khach].filter(Boolean).join(' — ');
            return '<li>' + escapeHtml(label || item.hoa_don_id) + '</li>';
          }).join('');
        }

        function renderImpactRows(preview) {
          if (!impactBody) return;
          var groups = preview.aggregate_groups || [];
          if (!groups.length) {
            impactBody.innerHTML = '<tr><td colspan="3">Không có dữ liệu liên quan đáng kể.</td></tr>';
            return;
          }
          impactBody.innerHTML = groups.map(function(group) {
            var samples = (group.samples || []).join(', ');
            return '<tr>'
              + '<td>' + escapeHtml(group.label || group.entity_type) + '</td>'
              + '<td class="num">' + escapeHtml(String(group.count || 0)) + '</td>'
              + '<td>' + escapeHtml(samples || '—') + '</td>'
              + '</tr>';
          }).join('');
        }

        function openTrashModal() {
          var ids = getSelectedInvoiceIds();
          if (!ids.length) {
            alert('Vui lòng chọn ít nhất một hóa đơn.');
            return;
          }
          pendingIds = ids.slice();
          if (overlay) {
            overlay.classList.add('is-open');
            overlay.setAttribute('aria-hidden', 'false');
          }
          if (impactBody) impactBody.innerHTML = '<tr><td colspan="3" class="invoice-trash-loading">Đang kiểm tra dữ liệu liên quan...</td></tr>';
          if (alertBox) alertBox.innerHTML = '';
          if (selectedList) selectedList.innerHTML = '';
          if (confirmBtn) confirmBtn.disabled = true;

          fetch('/don-hang/hoa-don/trash/preview', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ hoa_don_ids: pendingIds })
          })
            .then(function(res) { return res.json(); })
            .then(function(data) {
              if (!data.success) throw new Error(data.message || 'Không tải được thông tin xóa');
              previewData = data.data;
              renderSelectedList(previewData);
              renderAlert(previewData);
              renderImpactRows(previewData);
              if (confirmBtn) confirmBtn.disabled = !previewData.can_proceed;
            })
            .catch(function(err) {
              if (impactBody) impactBody.innerHTML = '<tr><td colspan="3">' + escapeHtml(err.message || 'Lỗi') + '</td></tr>';
              alert(err.message || 'Không tải được thông tin xóa');
            });
        }

        function confirmTrash() {
          if (!previewData || !previewData.can_proceed || !pendingIds.length) return;
          if (confirmBtn) confirmBtn.disabled = true;
          fetch('/don-hang/hoa-don/trash/move', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ hoa_don_ids: pendingIds })
          })
            .then(function(res) { return res.json(); })
            .then(function(data) {
              if (!data.success) throw new Error(data.message || 'Không đưa vào thùng rác được');
              alert(data.message || 'Đã đưa vào thùng rác');
              window.location.reload();
            })
            .catch(function(err) {
              alert(err.message || 'Không đưa vào thùng rác được');
              if (confirmBtn) confirmBtn.disabled = false;
            });
        }

        invoiceChecks.forEach(function(cb) {
          cb.addEventListener('change', updateDeleteButtonState);
        });
        var headerCheck = document.querySelector('.table thead .row-check');
        if (headerCheck) {
          headerCheck.addEventListener('click', function() {
            window.setTimeout(updateDeleteButtonState, 0);
          });
        }
        if (openBtn) openBtn.addEventListener('click', openTrashModal);
        if (closeBtn) closeBtn.addEventListener('click', closeTrashModal);
        if (cancelBtn) cancelBtn.addEventListener('click', closeTrashModal);
        if (confirmBtn) confirmBtn.addEventListener('click', confirmTrash);
        if (overlay) {
          overlay.addEventListener('click', function(e) {
            if (e.target === overlay) closeTrashModal();
          });
        }
        document.addEventListener('keydown', function(e) {
          if (e.key === 'Escape' && overlay && overlay.classList.contains('is-open')) closeTrashModal();
        });
        updateDeleteButtonState();
      })();

      const invoiceId = new URLSearchParams(window.location.search).get('invoice');
      if (!invoiceId) return;
      const row = document.querySelector('[data-invoice-row="' + invoiceId + '"]');
      if (!row) return;
      toggleInvoiceDetail(invoiceId);
      row.scrollIntoView({ block: 'center' });
    });
  </script>
</body>
</html>
