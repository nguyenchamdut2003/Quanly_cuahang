<body>
  <%- include('../partials/header') %>
  <form class="page" id="invoiceFilterForm" method="GET" action="/don-hang/hoa-don">
    <div class="shell">
      <aside class="sidebar">
        <h1 class="title">Hóa đơn</h1>
        <div class="filter">
          <div class="filter-title">Thời gian</div>
          <select class="control" name="time_period" onchange="this.form.submit()">
            <option value="1m" <%= selectedTimePeriod === '1m' ? 'selected' : '' %>>1 tháng</option>
            <option value="2m" <%= selectedTimePeriod === '2m' ? 'selected' : '' %>>2 tháng</option>
            <option value="3m" <%= selectedTimePeriod === '3m' ? 'selected' : '' %>>3 tháng</option>
            <option value="6m" <%= selectedTimePeriod === '6m' ? 'selected' : '' %>>6 tháng</option>
            <option value="1y" <%= selectedTimePeriod === '1y' ? 'selected' : '' %>>1 năm</option>
          </select>
        </div>
        <div class="filter">
          <div class="filter-title">Trạng thái hóa đơn</div>
          <select class="control" name="trang_thai" onchange="this.form.submit()">
            <option value="all" <%= selectedInvoiceStatus === 'all' ? 'selected' : '' %>>Tất cả trạng thái</option>
            <option value="processing" <%= selectedInvoiceStatus === 'processing' ? 'selected' : '' %>>Đang xử lý</option>
            <option value="completed" <%= selectedInvoiceStatus === 'completed' ? 'selected' : '' %>>Hoàn thành</option>
            <option value="failed" <%= selectedInvoiceStatus === 'failed' ? 'selected' : '' %>>Không giao được</option>
            <option value="cancelled" <%= selectedInvoiceStatus === 'cancelled' ? 'selected' : '' %>>Đã hủy</option>
            <option value="merged" <%= selectedInvoiceStatus === 'merged' ? 'selected' : '' %>>Đã gộp</option>
          </select>
        </div>
        <div class="filter">
          <div class="filter-title">Lọc cảnh báo nợ</div>
          <label class="filter-check-row">
            <input type="checkbox" name="warnOnly" value="1" id="warnOnlyCheckbox" <%= safeFilters.warnOnly === '1' ? 'checked' : '' %>>
            <span>Chỉ hiện phiếu có cảnh báo</span>
          </label>
          <div class="filter-range-stack">
            <label>
              <span>Quá số ngày</span>
              <input type="number" min="0" step="1" name="warnMinDays" value="<%= safeFilters.warnMinDays || debtWarnDefaultDays || 10 %>">
            </label>
            <label>
              <span>Quá số tiền (VNĐ)</span>
              <input type="text" inputmode="numeric" class="js-vn-money-filter" name="warnMinAmount" value="<%= typeof formatFilterMoney === 'function' ? formatFilterMoney(safeFilters.warnMinAmount) : (safeFilters.warnMinAmount || '') %>" placeholder="Không giới hạn" autocomplete="off">
            </label>
          </div>
        </div>
      </aside>
      <main class="main">
        <div class="toolbar">
          <div class="search"><i class="fa-solid fa-magnifying-glass"></i><input name="q" value="<%= safeFilters.q || '' %>" placeholder="Theo mã hóa đơn"><button type="submit"><i class="fa-solid fa-sliders"></i></button></div>
          <div class="actions">
            <div class="dropdown" id="createDropdown"><button class="btn primary" type="button" onclick="toggleCreateMenu(event)"><i class="fa-solid fa-plus"></i> Tạo mới <i class="fa-solid fa-chevron-down"></i></button><div class="dropdown-menu"><span class="dropdown-item disabled">Vận đơn KShip</span><a class="dropdown-item" href="/don-hang/hoa-don/create">Hóa đơn</a></div></div>
            <button type="button" class="btn danger" id="openInvoiceTrashModal" disabled>Xóa</button>
            <button type="button" class="btn" id="openInvoiceMergeModal"><i class="fa-regular fa-copy"></i> Gộp đơn</button>
            <a href="/don-hang/hoa-don/export.xlsx<%= exportQuery ? '?' + exportQuery : '' %>" class="btn"><i class="fa-solid fa-file-export"></i> Xuất file <i class="fa-solid fa-chevron-down"></i></a>
          </div>
        </div>
        <div class="table-wrap">
          <table class="table">
            <thead><tr><th class="check-col"><input class="row-check" type="checkbox"></th><th class="star-col"><i class="fa-regular fa-star"></i></th><th>Mã hóa đơn</th><th>Thời gian</th><th>Mã trả hàng</th><th>Mã KH</th><th>Khách hàng</th><th>Tổng tiền hàng</th><th>Đã trả</th><th>Còn nợ</th><th>Trạng thái</th></tr></thead>
            <tbody>
              <tr class="customer-summary-row">
                <td class="check-col"></td>
                <td class="star-col"></td>
                <td colspan="5" style="text-align: right; font-weight: bold; color: #1e293b;">Tổng cộng:</td>
                <td><strong><%= fmtMoney(totalRow.goods) %></strong></td>
                <td><strong><%= fmtMoney(totalRow.paid) %></strong></td>
                <td><strong><%= fmtMoney(totalRow.debt) %></strong></td>
                <td></td>
              </tr>
              <% if (safeInvoices.length) { %>
                <% safeInvoices.forEach(i => { const st = invoiceStatus(i); const debtAmount = invoiceRemainDue(i); const shipStatus = i.van_don?.trang_thai || 'none'; %>
                  <tr class="invoice-row" data-invoice-row="<%= i._id %>" data-invoice-id="<%= i._id %>" data-invoice-code="<%= i.ma_hoa_don || '' %>" data-invoice-date="<%= new Date(i.ngay_ban || i.created_at).toISOString() %>" data-invoice-status="<%= st %>" data-delivery-status="<%= shipStatus %>" data-has-return="<%= i.phieu_tra_hang ? '1' : '0' %>" data-customer-id="<%= i.khach_hang_id ? i.khach_hang_id._id : '' %>" data-customer-code="<%= i.khach_hang_id ? (i.khach_hang_id.ma_khach_hang || '') : '' %>" data-customer-name="<%= i.khach_hang_id ? (i.khach_hang_id.ten_khach_hang || '') : 'Khách lẻ' %>" data-payable="<%= Number(i.thanh_toan || 0) %>" data-paid="<%= Number(i.khach_da_tra || 0) %>" onclick="toggleInvoiceDetail('<%= i._id %>')"><td class="check-col"><input class="row-check invoice-select-check" type="checkbox" value="<%= i._id %>" onclick="event.stopPropagation()"></td><td class="star-col"><i class="fa-regular fa-star"></i></td><td><%- refLink('invoice', i, i.ma_hoa_don || '', 'onclick="event.stopPropagation()"') %></td><td><%= i.ngay_ban ? new Date(i.ngay_ban).toLocaleString('vi-VN') : '' %></td><td><%= i.phieu_tra_hang?.ma_phieu_tra || '' %></td><td><%- i.khach_hang_id ? refLink('customer', i.khach_hang_id, i.khach_hang_id.ma_khach_hang || '', 'onclick="event.stopPropagation()"') : '' %></td><td><%= i.khach_hang_id ? i.khach_hang_id.ten_khach_hang : 'Khách lẻ' %></td><td><%= fmtMoney(i.tong_tien) %></td><td><%= fmtMoney(i.khach_da_tra) %></td><td class="num"><div class="purchase-debt-cell"><span><%= fmtMoney(debtAmount) %></span><% if (i.debt_warning) { %><button type="button" class="purchase-debt-warn-btn js-purchase-debt-warn" onclick="event.stopPropagation()" aria-label="Cảnh báo nợ quá hạn">⚠️<span class="purchase-debt-warn-tip">Hóa đơn có khoản nợ quá hạn <strong><%= Number(i.so_ngay_no || 0).toLocaleString('vi-VN') %></strong> ngày.<br>Còn nợ: <strong><%= fmt(debtAmount) %> VNĐ</strong>.<br>Mã hóa đơn: <strong><%= i.ma_hoa_don || '--' %></strong>.</span></button><% } %></div></td><td><span class="status <%= statusClass(st) %>"><%= statusText(st) %></span></td></tr>
                  <tr class="detail-row" data-invoice-detail="<%= i._id %>"><td class="detail-cell" colspan="11"><div class="invoice-detail"><div class="loading-detail">Đang tải thông tin hóa đơn...</div></div></td></tr>
                <% }) %>
              <% } else { %>
                <tr><td colspan="11" class="empty">Chưa có hóa đơn</td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
        <div class="pager"><span>Hiển thị</span><select><option>15 dòng</option><option>30 dòng</option><option>50 dòng</option></select></div>
      </main>
    </div>
  </form>

