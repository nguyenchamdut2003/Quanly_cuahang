<body>
  <%- include('../partials/header') %>
  <form class="page" id="returnFilterForm" method="GET" action="/don-hang/tra-hang">
    <input type="hidden" name="page" id="returnPageInput" value="<%= safePagination.page %>">
    <div class="shell">
      <aside class="sidebar">
        <h1 class="title">Trả hàng</h1>
        <div class="filter">
          <div class="filter-title">Loại trả hàng</div>
          <label class="check"><input type="checkbox" name="loai_tra_hang" value="theo_hoa_don" <%= !selectedTypes.length || selectedTypes.includes('theo_hoa_don') ? 'checked' : '' %> onchange="submitReturnFilters()"> Theo hóa đơn</label>
          <label class="check"><input type="checkbox" name="loai_tra_hang" value="tra_nhanh" <%= !selectedTypes.length || selectedTypes.includes('tra_nhanh') ? 'checked' : '' %> onchange="submitReturnFilters()"> Trả nhanh</label>
          <label class="check"><input type="checkbox" name="loai_tra_hang" value="chuyen_hoan" <%= !selectedTypes.length || selectedTypes.includes('chuyen_hoan') ? 'checked' : '' %> onchange="submitReturnFilters()"> Chuyển hoàn</label>
        </div>
        <div class="filter">
          <div class="filter-title">Trạng thái</div>
          <label class="check"><input type="checkbox" name="trang_thai" value="completed" <%= !selectedStatuses.length || selectedStatuses.includes('completed') ? 'checked' : '' %> onchange="submitReturnFilters()"> Đã trả</label>
          <label class="check"><input type="checkbox" name="trang_thai" value="cancelled" <%= selectedStatuses.includes('cancelled') ? 'checked' : '' %> onchange="submitReturnFilters()"> Đã hủy</label>
        </div>
        <div class="filter">
          <div class="filter-title">Thời gian</div>
          <label class="radio"><input type="radio" name="time_type" value="this_month" <%= safeFilters.time_type === 'this_month' ? 'checked' : '' %> onchange="submitReturnFilters()"><span class="pill">Tháng này <i class="fa-solid fa-chevron-right"></i></span></label>
          <input class="control" type="date" name="date_from" value="<%= safeFilters.date_from || '' %>" onchange="submitReturnFilters()">
          <input class="control" type="date" name="date_to" value="<%= safeFilters.date_to || '' %>" onchange="submitReturnFilters()">
        </div>
        <div class="filter"><div class="filter-title">Người tạo</div><input class="control" name="nguoi_tao" value="<%= safeFilters.nguoi_tao || '' %>" placeholder="Chọn người tạo"></div>
        <div class="filter"><div class="filter-title">Người nhận trả</div><input class="control" name="nguoi_nhan_tra" value="<%= safeFilters.nguoi_nhan_tra || '' %>" placeholder="Chọn người nhận trả"></div>
        <div class="filter"><div class="filter-title">Kênh bán <a style="float:right;color:#0070f4;text-decoration:none" href="#">Tạo mới</a></div><input class="control" name="kenh_ban" value="<%= safeFilters.kenh_ban || '' %>" placeholder="Chọn kênh bán"></div>
        <div class="filter"><div class="filter-title">Loại thu khác</div><input class="control" name="loai_thu_khac" value="<%= safeFilters.loai_thu_khac || '' %>" placeholder="Chọn loại thu khác"></div>
      </aside>
      <main class="main">
        <div class="toolbar">
          <div class="search"><i class="fa-solid fa-magnifying-glass"></i><input name="q" value="<%= safeFilters.q || '' %>" placeholder="Theo mã phiếu trả"><button><i class="fa-solid fa-sliders"></i></button></div>
          <div class="actions">
            <button type="button" class="btn primary" onclick="openInvoiceModal()"><i class="fa-solid fa-plus"></i> Trả hàng</button>
            <a href="/don-hang/tra-hang/export.xlsx<%= exportQuery ? '?' + exportQuery : '' %>" class="btn"><i class="fa-solid fa-file-export"></i> Xuất file <i class="fa-solid fa-chevron-down"></i></a>
            <button type="button" class="btn return-delete-btn" id="returnTrashBtn" onclick="trashSelectedReturns()"><i class="fa-regular fa-trash-can"></i> Xóa</button>
          </div>
        </div>
        <div class="table-wrap">
          <table class="table">
            <thead><tr>
              <th class="check-col">
                <input type="checkbox" id="returnSelectAll" onclick="event.stopPropagation()">
              </th><th>Loại</th>
              <th>Mã trả hàng</th>
              <th>Người bán</th>
              <th>Thời gian</th>
              <th>Mã KH</th>
              <th>Khách hàng</th>
              <th class="num">Hàng trả</th>
              <th class="num">Hàng đổi</th>
              <th class="num">Cần trả</th>
              <th>Trạng thái</th>
            </tr>
          </thead>
            <tbody>
              <tr><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td class="num"><strong>0</strong></td><td class="num"><strong>0</strong></td><td class="num"><strong>0</strong></td><td></td></tr>
              <% if (safeReturns.length) { %>
                <% safeReturns.forEach(item => { %>
                  <tr class="return-row" data-return-row="<%= item._id %>" onclick="toggleReturnDetail('<%= item._id %>')">
                    <td class="check-col"><input type="checkbox" class="return-select-check" value="<%= item._id %>" onclick="event.stopPropagation()"></td>
                    <td><span class="type-badge <%= exchangeGoodsTotal(item) > 0 ? 'exchange' : '' %>"><%= returnType(item) %></span></td>
                    <td><%= item.ma_phieu_tra %></td>
                    <td><%= userName(item.nguoi_tao_id) %></td>
                    <td><%= item.ngay_tra ? new Date(item.ngay_tra).toLocaleString('vi-VN') : '' %></td>
                    <td><%- item.khach_hang_id ? refLink('customer', item.khach_hang_id, item.khach_hang_id.ma_khach_hang || '') : '' %></td>
                    <td><%= item.khach_hang_id?.ten_khach_hang || '' %></td>
                    <td class="num"><%= fmtMoney(returnGoodsTotal(item)) %></td>
                    <td class="num"><%= fmtMoney(exchangeGoodsTotal(item)) %></td>
                    <td class="num"><%= customerPayMore(item) > 0 ? '+' + fmtMoney(customerPayMore(item)) : (customerRefund(item) > 0 ? '-' + fmtMoney(customerRefund(item)) : '0 VNĐ') %></td>
                    <td><span class="status <%= item.trang_thai === 'cancelled' ? 'cancel' : '' %>"><%= item.trang_thai === 'cancelled' ? 'Đã hủy' : 'Đã trả' %></span></td>
                  </tr>
                  <tr class="detail-row" data-return-detail="<%= item._id %>"><td class="detail-cell" colspan="11"><div class="return-detail"><div class="loading-detail">Đang tải thông tin phiếu trả...</div></div></td></tr>
                <% }) %>
              <% } else { %>
                <tr><td colspan="11" class="empty"><div class="empty-box"><div class="empty-icon"><i class="fa-regular fa-inbox"></i></div><strong>Không tìm thấy kết quả</strong><div class="empty-sub">Không tìm thấy giao dịch nào phù hợp trong tháng này.<br>Nhấn vào <a href="/don-hang/tra-hang/create">đây</a> để tiếp tục tìm kiếm.</div></div></td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
        <div class="return-pagination">
          <span class="return-page-size">Hiển thị 10 dòng/trang</span>
          <nav class="return-pagination-actions" aria-label="Phân trang trả hàng">
            <% if (safePagination.page > 1) { %>
              <a class="return-page-link" href="<%= pageHref(1) %>">Đầu</a>
              <a class="return-page-link" href="<%= pageHref(safePagination.page - 1) %>">Trước</a>
            <% } else { %>
              <span class="return-page-link is-disabled">Đầu</span>
              <span class="return-page-link is-disabled">Trước</span>
            <% } %>
            <span class="return-page-current"><%= safePagination.page %> / <%= safePagination.totalPages %></span>
            <% if (safePagination.page < safePagination.totalPages) { %>
              <a class="return-page-link" href="<%= pageHref(safePagination.page + 1) %>">Sau</a>
              <a class="return-page-link" href="<%= pageHref(safePagination.totalPages) %>">Cuối</a>
            <% } else { %>
              <span class="return-page-link is-disabled">Sau</span>
              <span class="return-page-link is-disabled">Cuối</span>
            <% } %>
          </nav>
          <span><%= safePagination.from %> - <%= safePagination.to %> trong <%= safePagination.total %> phiếu trả</span>
        </div>
      </main>
    </div>
  </form>
  <div id="returnTrashModalOverlay" class="return-trash-overlay" aria-hidden="true">
    <div class="return-trash-modal" role="dialog" aria-labelledby="returnTrashModalTitle" aria-modal="true">
      <div class="return-trash-head">
        <h3 id="returnTrashModalTitle">Xóa phiếu trả hàng</h3>
        <button type="button" class="return-trash-close" id="returnTrashModalClose" aria-label="Đóng">&times;</button>
      </div>
      <div class="return-trash-body">
        <p class="return-trash-desc">Bạn có chắc chắn muốn xóa các phiếu trả hàng đã chọn không?</p>
      </div>
      <div class="return-trash-foot">
        <button type="button" class="btn" id="returnTrashCancel">Không</button>
        <button type="button" class="btn danger" id="returnTrashConfirm">Xóa</button>
      </div>
    </div>
  </div>
  <div id="invoiceModal" class="invoice-modal-backdrop">
    <div class="invoice-modal">
      <button type="button" class="invoice-close" onclick="closeInvoiceModal()">&times;</button>
      <h2>Chọn hóa đơn trả hàng</h2>
      <div class="invoice-modal-grid">
        <aside>
          <div class="invoice-filter-card">
            <h3>Tìm kiếm</h3>
            <input class="invoice-filter-input" id="invoiceSearch" oninput="scheduleInvoiceSearch()" placeholder="Theo mã hóa đơn">
            <input class="invoice-filter-input" id="shipmentSearch" oninput="scheduleInvoiceSearch()" placeholder="Theo mã vận đơn bán">
            <input class="invoice-filter-input" id="customerSearch" oninput="scheduleInvoiceSearch()" placeholder="Theo khách hàng hoặc ĐT">
            <input class="invoice-filter-input" id="itemCodeSearch" oninput="scheduleInvoiceSearch()" placeholder="Theo mã hàng">
            <input class="invoice-filter-input" id="itemNameSearch" oninput="scheduleInvoiceSearch()" placeholder="Theo tên hàng">
          </div>
          <div class="invoice-filter-card">
            <h3>Thời gian</h3>
            <input class="invoice-filter-input" id="fromDateSearch" type="date" onchange="loadInvoices(1)">
            <input class="invoice-filter-input" id="toDateSearch" type="date" onchange="loadInvoices(1)" placeholder="Đến ngày">
          </div>
        </aside>
        <section>
          <div class="invoice-pick-table">
            <table>
              <thead>
                <tr><th style="width:190px">Mã hóa đơn</th><th style="width:180px">Thời gian <i class="fa-solid fa-caret-down"></i></th><th>Nhân viên</th><th>Khách hàng</th><th class="num" style="width:150px">Tổng cộng</th><th style="width:130px"></th></tr>
              </thead>
              <tbody id="invoiceRows"></tbody>
            </table>
            <div class="invoice-pager" id="invoicePager"></div>
          </div>
        </section>
      </div>
      <button class="quick-return" type="button" onclick="window.location.href='/don-hang/tra-hang/create'">Trả nhanh</button>
    </div>
  </div>
  <script>
    const money = value => Number(value || 0).toLocaleString('vi-VN');
    const moneyText = value => money(value) + ' VNĐ';
    const formatSignedQty = value => {
      const qty = Math.floor(Number(value || 0));
      if (!qty) return '0';
      const abs = money(Math.abs(qty));
      return qty < 0 ? '-' + abs : abs;
    };
    const escapeHtml = value => String(value ?? '').replace(/[&<>"']/g, char => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[char]));
    let invoiceSearchTimer = null;
    let invoicePage = 1;

    function submitReturnFilters() {
      const pageInput = document.getElementById('returnPageInput');
      const form = document.getElementById('returnFilterForm');
      if (pageInput) pageInput.value = '1';
      if (!form) return;
      if (typeof form.requestSubmit === 'function') form.requestSubmit();
      else form.submit();
    }

    function openInvoiceModal() {
      const modal = document.getElementById('invoiceModal');
      if (!modal) return;
      modal.classList.add('open');
      loadInvoices(1);
    }

    function closeInvoiceModal() {
      const modal = document.getElementById('invoiceModal');
      if (modal) modal.classList.remove('open');
    }

    function scheduleInvoiceSearch() {
      clearTimeout(invoiceSearchTimer);
      invoiceSearchTimer = setTimeout(() => loadInvoices(1), 250);
    }

    async function loadInvoices(page = invoicePage) {
      invoicePage = page;
      const params = new URLSearchParams({
        page: String(page),
        limit: '7',
        invoice_code: invoiceSearch.value.trim(),
        shipment_code: shipmentSearch.value.trim(),
        customer: customerSearch.value.trim(),
        item_code: itemCodeSearch.value.trim(),
        item_name: itemNameSearch.value.trim(),
        from_date: fromDateSearch.value,
        to_date: toDateSearch.value
      });
      invoiceRows.innerHTML = '<tr><td colspan="6" style="text-align:center;color:#667085">Đang tải dữ liệu...</td></tr>';
      try {
        const res = await fetch('/don-hang/tra-hang/invoices/search?' + params.toString());
        const result = await res.json();
        if (!result.success) throw new Error(result.message || 'Không tải được danh sách hóa đơn');
        renderInvoices(result.data || [], result.pagination || { page: 1, limit: 7, total: 0, pages: 1 });
      } catch (error) {
        invoiceRows.innerHTML = '<tr><td colspan="6" style="text-align:center;color:#d92d20">Không tải được danh sách hóa đơn</td></tr>';
        invoicePager.innerHTML = '';
      }
    }

    function renderInvoices(rows, pagination) {
      invoiceRows.innerHTML = rows.length ? rows.map(i => `<tr><td><a href="#" onclick="chooseInvoice('${i._id}');return false">${escapeHtml(i.ma_hoa_don)}</a></td><td>${new Date(i.ngay_ban).toLocaleString('vi-VN', { hour:'2-digit', minute:'2-digit', day:'2-digit', month:'2-digit', year:'numeric' })}</td><td>${escapeHtml(i.nguoi_ban)}</td><td>${escapeHtml(i.khach_hang)}</td><td class="num">${moneyText(i.thanh_toan || i.tong_tien)}</td><td><button class="invoice-choose" onclick="chooseInvoice('${i._id}')" type="button">Chọn</button></td></tr>`).join('') : '<tr><td colspan="6" style="text-align:center;color:#667085">Không tìm thấy hóa đơn phù hợp</td></tr>';
      renderInvoicePager(pagination);
    }

    function renderInvoicePager(pagination) {
      const total = Number(pagination.total || 0);
      const limit = Number(pagination.limit || 7);
      const page = Number(pagination.page || 1);
      const pages = Math.max(Number(pagination.pages || 1), 1);
      const start = total ? (page - 1) * limit + 1 : 0;
      const end = Math.min(page * limit, total);
      const pageNumbers = [];
      const first = Math.max(1, Math.min(page - 2, pages - 4));
      const last = Math.min(pages, first + 4);
      for (let p = first; p <= last; p++) pageNumbers.push(p);
      invoicePager.innerHTML = `
        <button class="invoice-page-btn" type="button" onclick="loadInvoices(1)" ${page <= 1 ? 'disabled' : ''}><i class="fa-solid fa-angles-left"></i></button>
        <button class="invoice-page-btn" type="button" onclick="loadInvoices(${page - 1})" ${page <= 1 ? 'disabled' : ''}><i class="fa-solid fa-chevron-left"></i></button>
        ${pageNumbers.map(p => `<button class="invoice-page-btn ${p === page ? 'active' : ''}" type="button" onclick="loadInvoices(${p})">${p}</button>`).join('')}
        <button class="invoice-page-btn" type="button" onclick="loadInvoices(${page + 1})" ${page >= pages ? 'disabled' : ''}><i class="fa-solid fa-chevron-right"></i></button>
        <button class="invoice-page-btn" type="button" onclick="loadInvoices(${pages})" ${page >= pages ? 'disabled' : ''}><i class="fa-solid fa-angles-right"></i></button>
        <span>Hiển thị ${start} - ${end} trên tổng số ${total} hóa đơn</span>`;
    }

    function chooseInvoice(id) {
      window.location.href = '/don-hang/tra-hang/create?invoice_id=' + encodeURIComponent(id);
    }

    async function toggleReturnDetail(id) {
      const row = document.querySelector('[data-return-row="' + id + '"]');
      const detailRow = document.querySelector('[data-return-detail="' + id + '"]');
      if (!detailRow) return;
      const shouldOpen = !detailRow.classList.contains('open');
      document.querySelectorAll('.detail-row').forEach(item => item.classList.remove('open'));
      document.querySelectorAll('.return-row').forEach(item => item.classList.remove('active'));
      if (!shouldOpen) return;
      detailRow.classList.add('open');
      row?.classList.add('active');
      if (detailRow.dataset.loaded === 'true') return;
      const res = await fetch('/don-hang/tra-hang/' + id + '/detail');
      const data = await res.json();
      if (!data.success) return alert(data.message || 'Không tải được phiếu trả hàng');
      detailRow.querySelector('.return-detail').innerHTML = renderReturnDetail(data.data);
      detailRow.dataset.loaded = 'true';
    }

    function renderReturnVatChuaBox(vatChuaLines) {
      const lines = Array.isArray(vatChuaLines) ? vatChuaLines : [];
      if (!lines.length) return '';
      const rows = lines.map(line => {
        const docCell = line.doc_href
          ? `<a class="detail-link" href="${escapeHtml(line.doc_href)}">${escapeHtml(line.ma_chung_tu || '---')}</a>`
          : escapeHtml(line.ma_chung_tu || '---');
        return `<tr>
          <td>${escapeHtml(line.doc_kind_label || (Number(line.so_luong || 0) < 0 ? 'Xuất' : 'Nhập'))}</td>
          <td>${escapeHtml(line.ma_vat_chua || '---')}</td>
          <td>${escapeHtml(line.ten_vat_chua || '---')}</td>
          <td class="num">${formatSignedQty(line.so_luong || 0)}</td>
          <td>${docCell}</td>
        </tr>`;
      }).join('');
      return `
        <div class="detail-section-title">Vật chứa</div>
        <table class="items-table vat-chua-table">
          <thead><tr>
            <th>Loại</th>
            <th>Mã vật chứa</th>
            <th>Tên vật chứa</th>
            <th class="num">Số lượng</th>
            <th>Chứng từ</th>
          </tr></thead>
          <tbody>${rows}</tbody>
        </table>`;
    }

    function renderReturnDetail(data) {
      const slip = data.returnSlip;
      const invoice = data.invoice || slip.hoa_don_id || {};
      const customer = slip.khach_hang_id || {};
      const receiveMethodText = {
        tai_quay: 'Trả tại quầy',
        lay_tai_nha: 'Lấy hàng tại nhà',
        khach_gui_ve: 'Khách gửi về'
      }[slip.hinh_thuc_nhan_hang_tra || 'tai_quay'] || 'Trả tại quầy';
      const feePayerText = slip.nguoi_tra_phi_lay_hang === 'khach' ? 'Khách trả' : 'Cửa hàng trả';
      const partner = slip.doi_tac_giao_hang_id || {};
      const partnerName = partner.ten_doi_tac || partner.ten || partner.name || '';
      const items = data.items || [];
      const returnItems = items.filter(item => (item.loai_dong || 'hang_tra') !== 'hang_doi');
      const exchangeItems = items.filter(item => item.loai_dong === 'hang_doi');
      const returnTotal = Number(slip.tong_tien_hang_tra ?? returnItems.reduce((sum, item) => sum + Number(item.thanh_tien || 0), 0));
      const exchangeTotal = Number(slip.tong_tien_hang_doi ?? exchangeItems.reduce((sum, item) => sum + Number(item.thanh_tien || 0), 0));
      const difference = Number(slip.chenh_lech ?? (exchangeTotal - returnTotal));
      const needCollect = Math.max(Number(slip.khach_can_tra_them || 0), difference, 0);
      const needRefund = Math.max(Number(slip.can_tra_khach || 0), -difference, 0);
      const fee = Number(slip.phi_tra_hang || 0);
      const discount = Number(slip.giam_gia || 0);
      const pickupFeeAffectsCustomer = slip.nguoi_tra_phi_lay_hang === 'khach' ? Number(slip.phi_lay_hang_tra || 0) : 0;
      const rowHtml = (rows, emptyText) => rows.map(item => {
        const product = item.hang_hoa_id || {};
        const price = Number(item.don_gia || 0);
        const attributeName = item.ten_thuoc_tinh || item.ten_quy_cach || '';
        return `<tr><td><a href="#" class="detail-link">${escapeHtml(product.ma_hang || '')}</a></td><td>${escapeHtml(product.ten_hang || '')}</td><td>${escapeHtml(attributeName || 'Không có')}</td><td class="num">${money(item.so_luong)}</td><td class="num">${moneyText(price)}</td><td class="num"><strong>${moneyText(item.thanh_tien)}</strong></td></tr>`;
      }).join('') || `<tr><td colspan="6" class="muted-empty">${emptyText}</td></tr>`;
      const returnRows = rowHtml(returnItems, 'Không có hàng khách trả');
      const exchangeRows = rowHtml(exchangeItems, 'Không có hàng khách đổi/lấy mới');
      const vatChuaLines = Array.isArray(data.vat_chua_lines) ? data.vat_chua_lines : [];
      const vatChuaHtml = renderReturnVatChuaBox(vatChuaLines);
      const settlementLabel = needCollect > 0 ? 'Khách cần trả thêm' : (needRefund > 0 ? 'Cần trả khách' : 'Không cần thu/chi thêm');
      const settlementValue = needCollect > 0 ? needCollect : needRefund;
      const settlementClass = needCollect > 0 ? 'settlement-collect' : (needRefund > 0 ? 'settlement-refund' : 'settlement-none');
      const itemRows = '';
      const total = returnTotal;
      const transportFields = [
        ['Hình thức nhận hàng', receiveMethodText],
        ['Đối tác vận chuyển', partnerName],
        ['Người gửi trả', slip.ten_nguoi_gui_tra],
        ['SĐT người gửi', slip.sdt_nguoi_gui_tra],
        ['Địa chỉ lấy hàng', slip.dia_chi_lay_hang],
        ['Mã vận đơn trả hàng', slip.ma_van_don_tra_hang],
        ['Phí lấy hàng trả', Number(slip.phi_lay_hang_tra || 0) ? moneyText(slip.phi_lay_hang_tra) : ''],
        ['Người trả phí', Number(slip.phi_lay_hang_tra || 0) ? feePayerText : ''],
        ['Ghi chú vận chuyển', slip.ghi_chu_van_chuyen_tra]
      ].filter(([label, value], index) => index === 0 || value);
      const transportHtml = `<div class="detail-section-title">Nhận hàng trả</div><div class="detail-meta">${transportFields.map(([label, value]) => `<div class="mini-field"><label>${escapeHtml(label)}</label><span>${escapeHtml(value)}</span></div>`).join('')}</div>`;

      return `
        <div class="detail-tabs"><button type="button" class="detail-tab">Thông tin</button></div>
        <div class="detail-head">
          <div>
            <div><span class="detail-title">${escapeHtml(customer.ten_khach_hang || 'Khách lẻ')}</span> <a href="#" class="detail-link"><i class="fa-regular fa-pen-to-square"></i></a> <span>${escapeHtml(slip.ma_phieu_tra || '')}</span> <span class="status ${slip.trang_thai === 'cancelled' ? 'cancel' : ''}">${slip.trang_thai === 'cancelled' ? 'Đã hủy' : 'Đã trả'}</span></div>
            <div class="detail-meta">
              <div class="mini-field"><label>Người tạo</label><span>${escapeHtml(slip.nguoi_tao_id?.ho_ten || slip.nguoi_tao_id?.username || '')}</span></div>
              <div class="mini-field"><label>Người nhận trả</label><input class="mini-input" value="${escapeHtml(slip.nguoi_tao_id?.ho_ten || slip.nguoi_tao_id?.username || '')}"></div>
              <div class="mini-field"><label>Ngày trả</label><input class="mini-input" value="${escapeHtml(new Date(slip.ngay_tra || slip.created_at).toLocaleString('vi-VN'))}"></div>
              <div class="mini-field"><label>Mã hóa đơn</label><a class="detail-link" href="${invoice._id ? '/don-hang/hoa-don?invoice=' + invoice._id : '/don-hang/hoa-don'}">${escapeHtml(slip.hoa_don_id?.ma_hoa_don || invoice.ma_hoa_don || '')}</a></div>
              <div class="mini-field"><label>Kênh bán</label><input class="mini-input" value="Bán trực tiếp"></div>
              <div class="mini-field"><label>Bảng giá</label><input class="mini-input" value="Bảng giá chung"></div>
            </div>
          </div>
          <div>${escapeHtml(invoice.cua_hang_id?.ten_cua_hang || 'Cửa hàng trung tâm')}</div>
        </div>
        <table class="items-table"><thead><tr><th>Mã hàng</th><th>Tên hàng</th><th class="num">Số lượng</th><th class="num">Giá trả hàng</th><th class="num">Giảm giá</th><th class="num">Giá nhập lại</th><th class="num">Thành tiền</th></tr></thead><tbody>${itemRows}</tbody></table>
        ${transportHtml}
        ${vatChuaHtml}
        <div class="detail-section-title">Hàng khách trả</div>
        <table class="items-table return-table"><thead><tr><th>Mã hàng</th><th>Tên hàng</th><th>Thuộc tính</th><th class="num">Số lượng</th><th class="num">Giá trả hàng</th><th class="num">Thành tiền trả</th></tr></thead><tbody>${returnRows}</tbody></table>
        <div class="detail-section-title">Hàng khách đổi/lấy mới</div>
        <table class="items-table exchange-table"><thead><tr><th>Mã hàng</th><th>Tên hàng</th><th>Thuộc tính</th><th class="num">Số lượng</th><th class="num">Giá bán/giá đổi</th><th class="num">Thành tiền đổi</th></tr></thead><tbody>${exchangeRows}</tbody></table>
        <div class="detail-bottom">
          <textarea class="note js-return-note" data-slip-id="${slip._id}" placeholder="Ghi chú...">${escapeHtml(slip.ghi_chu || '')}</textarea>
          <div>
            <div class="total-line"><span>Tổng tiền hàng trả (${returnItems.length})</span><strong>${moneyText(returnTotal)}</strong></div>
            <div class="total-line"><span>Tổng tiền hàng đổi (${exchangeItems.length})</span><strong>${moneyText(exchangeTotal)}</strong></div>
            <div class="total-line"><span>Chênh lệch</span><strong>${moneyText(difference)}</strong></div>
            <div class="total-line"><span>Giảm giá</span><span>${moneyText(discount)}</span></div>
            <div class="total-line"><span>Phí trả hàng</span><span>${moneyText(fee)}</span></div>
            <div class="total-line"><span>Phí lấy hàng khách trả</span><span>${moneyText(pickupFeeAffectsCustomer)}</span></div>
            <div class="total-line settlement-line ${settlementClass}"><span>${settlementLabel}</span><strong>${settlementValue ? moneyText(settlementValue) : '0 VNĐ'}</strong></div>
          </div>
        </div>
        <div class="page-actions page-actions--split page-actions--bordered detail-actions">
          <div class="page-actions__left detail-action-group"><button type="button" class="btn" onclick="cancelReturnSlip('${slip._id}')" ${slip.trang_thai === 'cancelled' ? 'disabled' : ''}><i class="fa-regular fa-trash-can"></i> Hủy</button><button type="button" class="btn" onclick="trashReturnSlips(['${slip._id}'])"><i class="fa-regular fa-trash-can"></i> Xóa</button><a class="btn" href="/don-hang/tra-hang/create?copy_from=${slip._id}"><i class="fa-regular fa-copy"></i> Sao chép</a><a class="btn" href="/don-hang/tra-hang/${slip._id}/export.xlsx"><i class="fa-solid fa-file-export"></i> Xuất file</a></div>
          <div class="page-actions__right detail-action-group"><button type="button" class="btn solid" onclick="saveReturnSlip('${slip._id}')"><i class="fa-regular fa-floppy-disk"></i> Lưu</button><a class="btn" href="/chung-tu-kho/tra-hang-ban/${slip._id}" target="_blank"><i class="fa-solid fa-print"></i> Mở riêng</a></div>
        </div>`;
    }

    function getSelectedReturnIds() {
      return Array.from(document.querySelectorAll('.return-select-check:checked')).map(item => item.value).filter(Boolean);
    }

    function updateReturnTrashButton() {
      const selected = getSelectedReturnIds();
      const trashBtn = document.getElementById('returnTrashBtn');
      const selectAll = document.getElementById('returnSelectAll');
      const checks = Array.from(document.querySelectorAll('.return-select-check'));
      if (selectAll) {
        selectAll.checked = checks.length > 0 && selected.length === checks.length;
        selectAll.indeterminate = selected.length > 0 && selected.length < checks.length;
      }
    }

    function trashSelectedReturns() {
      trashReturnSlips(getSelectedReturnIds());
    }

    let pendingReturnTrashIds = [];

    function closeReturnTrashModal() {
      const overlay = document.getElementById('returnTrashModalOverlay');
      if (overlay) {
        overlay.classList.remove('open');
        overlay.setAttribute('aria-hidden', 'true');
      }
      pendingReturnTrashIds = [];
      const confirmBtn = document.getElementById('returnTrashConfirm');
      if (confirmBtn) confirmBtn.disabled = false;
    }

    function renderReturnTrashPreview(preview) {
      const overlay = document.getElementById('returnTrashModalOverlay');
      const selectedList = document.getElementById('returnTrashSelectedList');
      const impactRows = document.getElementById('returnTrashImpactRows');
      const alertBox = document.getElementById('returnTrashAlert');
      const confirmBtn = document.getElementById('returnTrashConfirm');
      const items = Array.isArray(preview.items) ? preview.items : [];
      const groups = Array.isArray(preview.aggregate_groups) ? preview.aggregate_groups : [];
      if (selectedList) {
        selectedList.innerHTML = items.map(item => {
          const name = item.ma_phieu_tra || item.phieu_tra_hang_id || '';
          const customer = item.ten_khach ? ' - ' + item.ten_khach : '';
          const blocked = item.can_trash ? '' : ' (' + (item.block_reason || 'Không thể xóa') + ')';
          return '<li><strong>' + escapeHtml(name) + '</strong>' + escapeHtml(customer + blocked) + '</li>';
        }).join('');
      }
      if (impactRows) {
        impactRows.innerHTML = groups.length ? groups.map(group => {
          const samples = Array.isArray(group.samples) && group.samples.length ? group.samples.join(', ') : '';
          return '<tr><td>' + escapeHtml(group.label || group.entity_type || '') + '</td><td class="num">' + money(group.count || 0) + '</td><td>' + escapeHtml(samples) + '</td></tr>';
        }).join('') : '<tr><td colspan="3">Không có dữ liệu con liên quan.</td></tr>';
      }
      const warnings = items.reduce((list, item) => list.concat(Array.isArray(item.warnings) ? item.warnings : []), []);
      if (alertBox) {
        alertBox.innerHTML = warnings.length
          ? '<div class="return-trash-alert">' + warnings.map(escapeHtml).join('<br>') + '</div>'
          : '';
      }
      if (confirmBtn) confirmBtn.disabled = !preview.can_proceed;
      if (overlay) {
        overlay.classList.add('open');
        overlay.setAttribute('aria-hidden', 'false');
      }
    }

    async function confirmReturnTrashMove() {
      const selectedIds = pendingReturnTrashIds.filter(Boolean);
      if (!selectedIds.length) return closeReturnTrashModal();
      const confirmBtn = document.getElementById('returnTrashConfirm');
      if (confirmBtn) confirmBtn.disabled = true;
      const res = await fetch('/don-hang/tra-hang/deactivate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ phieu_tra_hang_ids: selectedIds })
      });
      const data = await res.json();
      if (!data.success) {
        if (confirmBtn) confirmBtn.disabled = false;
        return alert(data.message || 'Không xóa được phiếu trả hàng');
      }
      location.reload();
    }

    async function trashReturnSlips(ids) {
      const selectedIds = Array.isArray(ids) ? ids.filter(Boolean) : [];
      if (!selectedIds.length) return alert('Vui lòng chọn ít nhất một phiếu trả hàng.');
      pendingReturnTrashIds = selectedIds;
      const overlay = document.getElementById('returnTrashModalOverlay');
      const confirmBtn = document.getElementById('returnTrashConfirm');
      if (confirmBtn) confirmBtn.disabled = false;
      if (overlay) {
        overlay.classList.add('open');
        overlay.setAttribute('aria-hidden', 'false');
      }
    }

    document.addEventListener('DOMContentLoaded', () => {
      const returnFilterForm = document.getElementById('returnFilterForm');
      if (returnFilterForm) {
        returnFilterForm.addEventListener('submit', () => {
          const pageInput = document.getElementById('returnPageInput');
          if (pageInput) pageInput.value = '1';
        });
      }
      const selectAll = document.getElementById('returnSelectAll');
      if (selectAll) {
        selectAll.addEventListener('change', () => {
          document.querySelectorAll('.return-select-check').forEach(item => {
            item.checked = selectAll.checked;
          });
          updateReturnTrashButton();
        });
      }
      document.querySelectorAll('.return-select-check').forEach(item => {
        item.addEventListener('change', updateReturnTrashButton);
      });
      const trashClose = document.getElementById('returnTrashModalClose');
      const trashCancel = document.getElementById('returnTrashCancel');
      const trashConfirm = document.getElementById('returnTrashConfirm');
      if (trashClose) trashClose.addEventListener('click', closeReturnTrashModal);
      if (trashCancel) trashCancel.addEventListener('click', closeReturnTrashModal);
      if (trashConfirm) trashConfirm.addEventListener('click', confirmReturnTrashMove);
      updateReturnTrashButton();
      const openReturnId = new URLSearchParams(window.location.search).get('return');
      if (openReturnId && document.querySelector('[data-return-row="' + openReturnId + '"]')) {
        toggleReturnDetail(openReturnId);
      }
    });

    async function cancelReturnSlip(id) {
      if (!confirm('Hủy phiếu trả hàng này? Hệ thống sẽ hoàn tồn kho và đảo các phiếu thu/chi liên quan.')) return;
      const res = await fetch('/don-hang/tra-hang/' + id + '/cancel', { method: 'POST', headers: { 'Content-Type': 'application/json' } });
      const data = await res.json();
      if (!data.success) return alert(data.message || 'Không hủy được phiếu trả hàng');
      location.reload();
    }

    async function saveReturnSlip(id) {
      const noteEl = document.querySelector('.js-return-note[data-slip-id="' + id + '"]');
      const res = await fetch('/don-hang/tra-hang/' + id, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ ghi_chu: noteEl ? noteEl.value : '' })
      });
      const data = await res.json();
      if (!data.success) return alert(data.message || 'Không lưu được phiếu trả hàng');
      alert(data.message || 'Đã lưu');
    }
  </script>
</body>
</html>
