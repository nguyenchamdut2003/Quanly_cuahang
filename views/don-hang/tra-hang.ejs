<%
  const safeReturns = Array.isArray(locals.returns) ? locals.returns : [];
  const safeFilters = locals.filters || {};
  const safePagination = locals.pagination || { page: 1, totalPages: 1, total: 0, from: 0, to: 0, limit: 10 };
  const pageHref = page => {
    const query = typeof qs === 'function' ? qs({ page }) : '';
    return '/don-hang/tra-hang' + (query ? '?' + query : '');
  };
  const selectedStatuses = Array.isArray(safeFilters.trang_thai) ? safeFilters.trang_thai : (safeFilters.trang_thai ? [safeFilters.trang_thai] : []);
  const selectedTypes = Array.isArray(safeFilters.loai_tra_hang) ? safeFilters.loai_tra_hang : (safeFilters.loai_tra_hang ? [safeFilters.loai_tra_hang] : []);
  const exportParams = new URLSearchParams();
  Object.keys(safeFilters).forEach(key => {
    if (key === 'page' || key === 'page_size') return;
    const value = safeFilters[key];
    if (Array.isArray(value)) {
      value.forEach(item => exportParams.append(key, item));
    } else if (value !== undefined && value !== null && value !== '') {
      exportParams.append(key, value);
    }
  });
  const exportQuery = exportParams.toString();
  const fmt = value => Number(value || 0).toLocaleString('vi-VN');
  const fmtMoney = value => fmt(value) + ' VNĐ';
  const userName = user => user?.ho_ten || user?.username || user?.ten_dang_nhap || '';
  const returnType = item => Number(item?.tong_tien_hang_doi || 0) > 0 ? 'Đổi hàng' : 'Trả hàng';
  const returnGoodsTotal = item => Number(item?.tong_tien_hang_tra ?? item?.tong_tien_tra ?? 0);
  const exchangeGoodsTotal = item => Number(item?.tong_tien_hang_doi || 0);
  const customerPayMore = item => Math.max(Number(item?.khach_can_tra_them || 0), Number(item?.chenh_lech || 0), 0);
  const customerRefund = item => Math.max(Number(item?.can_tra_khach || 0), -Number(item?.chenh_lech || 0), 0);
%>
