    async function loadInvoices(page = invoicePage){
      invoicePage = page;
      const invoiceSearchEl = $('invoiceSearch');
      const shipmentSearchEl = $('shipmentSearch');
      const customerSearchEl = $('customerSearch');
      const itemCodeSearchEl = $('itemCodeSearch');
      const itemNameSearchEl = $('itemNameSearch');
      const fromDateSearchEl = $('fromDateSearch');
      const toDateSearchEl = $('toDateSearch');
      const invoiceRowsEl = $('invoiceRows');
      const invoicePagerEl = $('invoicePager');
      const params = new URLSearchParams({
        page: String(page),
        limit: '7',
        invoice_code: invoiceSearchEl ? invoiceSearchEl.value.trim() : '',
        shipment_code: shipmentSearchEl ? shipmentSearchEl.value.trim() : '',
        customer: customerSearchEl ? customerSearchEl.value.trim() : '',
        item_code: itemCodeSearchEl ? itemCodeSearchEl.value.trim() : '',
        item_name: itemNameSearchEl ? itemNameSearchEl.value.trim() : '',
        from_date: fromDateSearchEl ? fromDateSearchEl.value : '',
        to_date: toDateSearchEl ? toDateSearchEl.value : ''
      });
      if (invoiceRowsEl) invoiceRowsEl.innerHTML = '<tr><td colspan="6" style="text-align:center;color:#667085">Đang tải dữ liệu...</td></tr>';
      try {
        const res = await fetch('/don-hang/tra-hang/invoices/search?' + params.toString());
        const result = await res.json();
        if(!result.success) throw new Error(result.message || 'Không tải được danh sách hóa đơn');
        renderInvoices(result.data || [], result.pagination || { page: 1, limit: 7, total: 0, pages: 1 });
      } catch (error) {
        if (invoiceRowsEl) invoiceRowsEl.innerHTML = '<tr><td colspan="6" style="text-align:center;color:#d92d20">Không tải được danh sách hóa đơn</td></tr>';
        if (invoicePagerEl) invoicePagerEl.innerHTML = '';
      }
    }
    function renderInvoices(rows, pagination){
      const invoiceRowsEl = $('invoiceRows');
      if (!invoiceRowsEl) return;
      invoiceRowsEl.innerHTML = rows.length ? rows.map(i => `<tr><td><a href="#" onclick="selectInvoice('${i._id}');return false">${i.ma_hoa_don}</a></td><td>${new Date(i.ngay_ban).toLocaleString('vi-VN')}</td><td>${i.nguoi_ban}</td><td>${i.khach_hang}</td><td class="num">${fmtMoney(i.thanh_toan || i.tong_tien)}</td><td><button class="choose" onclick="selectInvoice('${i._id}')" type="button">Chọn</button></td></tr>`).join('') : '<tr><td colspan="6" style="text-align:center;color:#667085">Không tìm thấy hóa đơn phù hợp</td></tr>';
      renderInvoicePager(pagination);
    }
    function renderInvoicePager(pagination){
      const invoicePagerEl = $('invoicePager');
      if (!invoicePagerEl) return;
      const total = Number(pagination.total || 0);
      const limit = Number(pagination.limit || 7);
      const page = Number(pagination.page || 1);
      const pages = Math.max(Number(pagination.pages || 1), 1);
      const start = total ? (page - 1) * limit + 1 : 0;
      const end = Math.min(page * limit, total);
      const pageNumbers = [];
      const first = Math.max(1, Math.min(page - 2, pages - 4));
      const last = Math.min(pages, first + 4);
      for(let p = first; p <= last; p++) pageNumbers.push(p);
      invoicePagerEl.innerHTML = `
        <button class="page-btn" type="button" onclick="loadInvoices(1)" ${page <= 1 ? 'disabled' : ''}><i class="fa-solid fa-angles-left"></i></button>
        <button class="page-btn" type="button" onclick="loadInvoices(${page - 1})" ${page <= 1 ? 'disabled' : ''}><i class="fa-solid fa-chevron-left"></i></button>
        ${pageNumbers.map(p => `<button class="page-btn ${p === page ? 'active' : ''}" type="button" onclick="loadInvoices(${p})">${p}</button>`).join('')}
        <button class="page-btn" type="button" onclick="loadInvoices(${page + 1})" ${page >= pages ? 'disabled' : ''}><i class="fa-solid fa-chevron-right"></i></button>
        <button class="page-btn" type="button" onclick="loadInvoices(${pages})" ${page >= pages ? 'disabled' : ''}><i class="fa-solid fa-angles-right"></i></button>
        <span>Hiển thị ${start} - ${end} trên tổng số ${total} hóa đơn</span>`;
    }
