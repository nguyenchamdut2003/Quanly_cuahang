    function renderSwapItems(){
      const swapCartBody = document.getElementById('swapCartBody');
      if (!swapCartBody) return;
      const maxLots = maxLotColumnsInSwapCart();
      renderSwapCartThead(maxLots);
      if (!swapItems.length) {
        const colSpan = maxLots > 0 ? (5 + maxLots) : 11;
        swapCartBody.innerHTML = `<tr><td colspan="${colSpan}"><div class="swap-cart-empty">Chưa có hàng đổi</div></td></tr>`;
        renderTotals();
        return;
      }
      swapCartBody.innerHTML = swapItems.map((item, idx) => {
        const line = swapComputeLineTotal(item);
        if (swapItemHasLotGrid(item)) {
          return renderSwapLotProductRow(item, idx, maxLots, line);
        }
        return renderSwapNormalProductRow(item, idx, maxLots, line) + renderSwapQuyCachBlock(item, idx);
      }).join('');
      renderTotals();
    }
    function setQty(id, value){
      const item = returnItems.find(i => String(i.line_key || i.hang_hoa_id) === String(id));
      if(!item) return;
      item.so_luong = Math.max(0, Math.min(num(value), item.so_luong_goc));
      renderItems();
    }
    function setPrice(id, value){
      const item = returnItems.find(i => String(i.line_key || i.hang_hoa_id) === String(id));
      if(!item) return;
      item.don_gia = num(value);
      renderItems();
    }
    function removeItem(id){ returnItems = returnItems.filter(i => String(i.line_key || i.hang_hoa_id) !== String(id)); renderItems(); }
    function validateSwapStock() {
      for (const item of swapItems) {
        const detailRows = swapItemDetailRows(item);
        if (detailRows.length) {
          for (const row of detailRows) {
            const qty = Number(row.so_luong_dat || row.so_luong || 0);
            if (qty <= 0) continue;
            const metrics = inventoryMetrics(row);
            if (qty > metrics.soLuongKhaDung) {
              const label = row.ten_quy_cach || row.ten_thuoc_tinh || row.ten_lo || row.ma_lo || item.ten_hang || item.ma_hang || '';
              return `Tồn kho hàng đổi không đủ: ${label}`;
            }
          }
          continue;
        }
        if (Number(item.so_luong || 0) <= 0) continue;
        const product = swapAvailableProducts.find(p => String(p._id) === String(item.hang_hoa_id));
        if (!product) return `Tồn kho hàng đổi không đủ: ${item.ten_hang || item.ma_hang || ''}`;
        const metrics = swapProductMetrics(product);
        if (item.so_luong > metrics.soLuongKhaDung) {
          return `Tồn kho hàng đổi không đủ: ${item.ten_hang || item.ma_hang || ''}`;
        }
      }
      return '';
    }
    function setSwapQty(id, value){
      const item = swapItems.find(i => String(i.hang_hoa_id) === String(id));
      if(!item) return;
      const product = swapAvailableProducts.find(p => String(p._id) === String(id));
      const maxQty = product ? swapProductMetrics(product).soLuongKhaDung : item.so_luong_goc;
      item.so_luong_goc = Math.max(0, maxQty);
      item.so_luong = Math.max(0, Math.min(num(value), item.so_luong_goc));
      renderSwapItems();
    }
    function setSwapPrice(id, value){
      const item = swapItems.find(i => String(i.hang_hoa_id) === String(id));
      if(!item) return;
      if (item.cho_phep_sua_gia === false) return alert('Dòng này không cho phép sửa giá.');
      item.don_gia = num(value);
      renderSwapItems();
    }
    function removeSwapItem(id){
      delete expandedSwapLotKeyByItem[id];
      swapItems = swapItems.filter(i => String(i.hang_hoa_id) !== String(id));
      renderSwapItems();
    }
    function getReturnDifferenceTotals() {
      const total = returnItems.reduce((sum, item) => sum + item.so_luong * item.don_gia, 0);
      const exchange = swapItems.reduce((sum, item) => sum + swapComputeLineTotal(item), 0);
      const discountEl = $('discount');
      const returnFeeEl = $('returnFee');
      const returnFeePayerEl = $('returnFeePayer');
      const returnPickupFeeEl = $('returnPickupFee');
      const discountValue = num(discountEl ? discountEl.value : 0);
      const returnFeeValue = num(returnFeeEl ? returnFeeEl.value : 0);
      const pickupFee = getReceiveMethod() !== 'tai_quay' && returnFeePayerEl && returnFeePayerEl.value === 'khach' ? num(returnPickupFeeEl ? returnPickupFeeEl.value : 0) : 0;
      const difference = exchange + discountValue + returnFeeValue + pickupFee - total;
      return { difference, payableValue: Math.abs(difference), isRefund: difference < 0, isCollect: difference > 0 };
    }
    function cashBookLabel(book) {
      const bank = book && book.thong_tin_ngan_hang ? book.thong_tin_ngan_hang : {};
      const bankLabel = [bank.ten_ngan_hang, bank.so_tai_khoan].filter(Boolean).join(' - ');
      return bankLabel || (book && book.ten_so_quy) || 'Sổ quỹ';
    }
    function autoSelectCashBook(list) {
      const defaults = (list || []).filter(book => book.mac_dinh);
      if (defaults.length === 1) return String(defaults[0]._id);
      if (!defaults.length && list.length === 1) return String(list[0]._id);
      return '';
    }
    function renderCashBookSelect(select, list, placeholder) {
      if (!select) return;
      select.innerHTML = `<option value="">${placeholder || 'Chọn sổ quỹ'}</option>` + (list || []).map(book =>
        `<option value="${String(book._id)}">${cashBookLabel(book)}</option>`
      ).join('');
      select.value = autoSelectCashBook(list);
    }
    async function loadReturnPaymentCashBooks() {
      try {
        const [cashRes, bankRes] = await Promise.all([
          fetch('/api/so-quy/active?loai_so_quy=tien_mat'),
          fetch('/api/so-quy/active?loai_so_quy=chuyen_khoan')
        ]);
        const cashJson = cashRes.ok ? await cashRes.json() : { items: [] };
        const bankJson = bankRes.ok ? await bankRes.json() : { items: [] };
        const pickBooks = json => (json.items || json.data || []).filter(book => String(book.trang_thai || 'active') === 'active');
        cashBookOptions = pickBooks(cashJson).filter(book => String(book.loai_so_quy || '') === 'tien_mat');
        bankBookOptions = pickBooks(bankJson).filter(book => String(book.loai_so_quy || '') === 'chuyen_khoan');
        renderCashBookSelect($('cashBookId'), cashBookOptions, cashBookOptions.length ? 'Chọn sổ tiền mặt' : 'Chưa có sổ tiền mặt active');
        renderCashBookSelect($('bankBookId'), bankBookOptions, bankBookOptions.length ? 'Chọn tài khoản chuyển khoản' : 'Chưa có tài khoản active');
      } catch (_) {
        cashBookOptions = [];
        bankBookOptions = [];
        renderCashBookSelect($('cashBookId'), [], 'Không tải được sổ tiền mặt');
        renderCashBookSelect($('bankBookId'), [], 'Không tải được tài khoản');
      }
      renderReturnPaymentSummary();
    }
    function handleReturnPaymentInput(input, mode) {
      handleNumInput(input);
      if (mode === 'cash') returnPaymentPriority = 'cash';
      else if (mode === 'transfer') returnPaymentPriority = 'transfer';
      returnIsPayAllMode = false;
      returnPaymentTouched = true;
      renderReturnPaymentSummary();
    }
    function fillReturnPaymentAll(mode) {
      const { payableValue } = getReturnDifferenceTotals();
      const due = Math.max(0, payableValue);
      returnIsPayAllMode = due > 0;
      returnPayAllTarget = mode === 'transfer' ? 'transfer' : 'cash';
      returnPaymentPriority = returnPayAllTarget;
      returnPaymentTouched = true;
      const cashEl = $('cashCustomerGiven');
      const transferEl = $('transferCustomerGiven');
      const changeEl = $('changeReturnedToCustomer');
      if (mode === 'cash') {
        if (cashEl) cashEl.value = fmt(due);
        if (transferEl) transferEl.value = '0';
      } else if (mode === 'transfer') {
        if (transferEl) transferEl.value = fmt(due);
        if (cashEl) cashEl.value = '0';
      }
      if (changeEl) changeEl.value = '0';
      renderReturnPaymentSummary();
    }
    function renderReturnPaymentSummary() {
      const cashEl = $('cashCustomerGiven');
      const transferEl = $('transferCustomerGiven');
      const changeEl = $('changeReturnedToCustomer');
      const cashBookEl = $('cashBookId');
      const bankBookEl = $('bankBookId');
      const sectionEl = $('returnPaymentSection');
      const { payableValue, isRefund, isCollect } = getReturnDifferenceTotals();
      const khachCanTra = Math.max(0, payableValue);
      if (sectionEl) sectionEl.style.display = khachCanTra > 0 ? 'block' : 'none';
      if (khachCanTra <= 0) {
        if (cashEl) cashEl.value = '0';
        if (transferEl) transferEl.value = '0';
        if (changeEl) changeEl.value = '0';
        lastReturnPaymentTotals = { khachCanTra: 0, khachThanhToan: 0, tienThuaTraKhach: 0, tongKhachDua: 0, isRefund };
        return;
      }
      if (!returnPaymentTouched && !returnIsPayAllMode) {
        if (cashEl) cashEl.value = fmt(khachCanTra);
        if (transferEl) transferEl.value = '0';
        if (changeEl) changeEl.value = '0';
      }
      let tienMat = Math.max(0, num(cashEl ? cashEl.value : 0));
      let chuyenKhoan = Math.max(0, num(transferEl ? transferEl.value : 0));
      if (returnIsPayAllMode && khachCanTra > 0) {
        if (returnPayAllTarget === 'transfer') {
          tienMat = 0;
          chuyenKhoan = khachCanTra;
        } else {
          tienMat = khachCanTra;
          chuyenKhoan = 0;
        }
      }
      const tongKhachDua = tienMat + chuyenKhoan;
      if (cashEl) cashEl.value = fmt(tienMat);
      if (transferEl) transferEl.value = fmt(chuyenKhoan);
      const tienThuaTraKhach = Math.max(0, num(changeEl ? changeEl.value : 0));
      const khachThanhToan = tongKhachDua - tienThuaTraKhach;
      const tienConLai = khachCanTra - khachThanhToan;
      lastReturnPaymentTotals = { khachCanTra, khachThanhToan, tienThuaTraKhach, tongKhachDua, isRefund };
      const payableLabelEl = $('returnPayableLabel');
      const paidLabelEl = $('returnPaidLabel');
      const remainingLabelEl = $('returnRemainingLabel');
      const payableAmountEl = $('returnPayableAmount');
      const paidAmountEl = $('returnPaidAmount');
      const remainingAmountEl = $('returnRemainingAmount');
      if (payableLabelEl) payableLabelEl.textContent = isCollect ? 'Khách cần trả thêm' : 'Cần trả khách';
      if (paidLabelEl) paidLabelEl.textContent = isCollect ? 'Khách đã trả' : 'Đã trả khách';
      if (remainingLabelEl) remainingLabelEl.textContent = isCollect
        ? (tienConLai < 0 ? 'Nợ khách' : 'Còn phải thu')
        : (tienConLai < 0 ? 'Trả thừa' : 'Còn phải trả');
      if (payableAmountEl) payableAmountEl.textContent = fmtMoney(khachCanTra);
      if (paidAmountEl) paidAmountEl.textContent = fmtMoney(khachThanhToan);
      if (remainingAmountEl) {
        remainingAmountEl.textContent = tienConLai < 0 ? `-${fmt(Math.abs(tienConLai))} VNĐ` : fmtMoney(tienConLai);
      }
      const cashBookRequired = tienMat > 0 || tienThuaTraKhach > 0;
      const bankBookRequired = chuyenKhoan > 0;
      if (cashBookEl) {
        cashBookEl.disabled = !cashBookRequired;
        if (!cashBookRequired) cashBookEl.value = '';
        if (cashBookRequired && !cashBookEl.value) cashBookEl.value = autoSelectCashBook(cashBookOptions);
        cashBookEl.classList.toggle('field-invalid', cashBookRequired && !String(cashBookEl.value || '').trim());
      }
      if (bankBookEl) {
        bankBookEl.disabled = !bankBookRequired;
        if (!bankBookRequired) bankBookEl.value = '';
        if (bankBookRequired && !bankBookEl.value) bankBookEl.value = autoSelectCashBook(bankBookOptions);
        bankBookEl.classList.toggle('field-invalid', bankBookRequired && !String(bankBookEl.value || '').trim());
      }
      const cashBookRequiredMark = $('cashBookRequiredMark');
      if (cashBookRequiredMark) cashBookRequiredMark.style.display = cashBookRequired ? 'inline' : 'none';
      const bankBookRequiredMark = $('bankBookRequiredMark');
      if (bankBookRequiredMark) bankBookRequiredMark.style.display = bankBookRequired ? 'inline' : 'none';
    }
    function validateReturnPayment() {
      renderReturnPaymentSummary();
      const { payableValue } = getReturnDifferenceTotals();
      if (payableValue <= 0) return '';
      const tienMat = num($('cashCustomerGiven')?.value);
      const chuyenKhoan = num($('transferCustomerGiven')?.value);
      const tienThua = num($('changeReturnedToCustomer')?.value);
      if (tienMat < 0 || chuyenKhoan < 0 || tienThua < 0) return 'Số tiền không được âm.';
      if (tienThua > lastReturnPaymentTotals.tongKhachDua) return 'Tiền thừa không được vượt tổng tiền thanh toán.';
      if ((tienMat > 0 || tienThua > 0) && !String($('cashBookId')?.value || '').trim()) {
        return cashBookOptions.length ? 'Vui lòng chọn sổ tiền mặt.' : 'Chưa có sổ tiền mặt đang hoạt động.';
      }
      if (chuyenKhoan > 0 && !String($('bankBookId')?.value || '').trim()) {
        return bankBookOptions.length ? 'Vui lòng chọn tài khoản chuyển khoản.' : 'Chưa có tài khoản chuyển khoản đang hoạt động.';
      }
      return '';
    }
    function buildReturnPaymentSubmitFields() {
      renderReturnPaymentSummary();
      const cashBookEl = $('cashBookId');
      const bankBookEl = $('bankBookId');
      return {
        khach_thanh_toan_them: lastReturnPaymentTotals.khachThanhToan,
        tien_mat_khach_dua: Math.max(0, num($('cashCustomerGiven')?.value)),
        chuyen_khoan_khach_dua: Math.max(0, num($('transferCustomerGiven')?.value)),
        tien_thua_tra_khach: Math.max(0, num($('changeReturnedToCustomer')?.value)),
        payment_v2: true,
        so_quy_tien_mat_id: cashBookEl?.value || '',
        so_quy_chuyen_khoan_id: bankBookEl?.value || '',
        so_quy_id: cashBookEl?.value || bankBookEl?.value || '',
        refund_so_quy_id: cashBookEl?.value || bankBookEl?.value || '',
        vat_chua_id: $('returnVatChuaId')?.value || '',
        vat_chua_so_luong: $('returnVatChuaQty')?.value || ''
      };
    }
    function validateReturnVatChuaInput() {
      const vatChuaId = String($('returnVatChuaId')?.value || '').trim();
      const qtyRaw = String($('returnVatChuaQty')?.value || '').trim();
      if (!vatChuaId && !qtyRaw) return '';
      if (!vatChuaId) return 'Vui lòng chọn vật chứa';
      if (!qtyRaw || qtyRaw === '-') return 'Vui lòng nhập số lượng vật chứa';
      const qty = numSigned(qtyRaw);
      if (!qty) return 'Số lượng vật chứa không được bằng 0';
      return '';
    }
    function renderTotals(){
      const origin = returnItems.reduce((sum, item) => sum + item.thanh_tien_goc, 0);
      const total = returnItems.reduce((sum, item) => sum + item.so_luong * item.don_gia, 0);
      const exchange = swapItems.reduce((sum, item) => sum + swapComputeLineTotal(item), 0);
      const discountEl = $('discount');
      const returnFeeEl = $('returnFee');
      const returnFeePayerEl = $('returnFeePayer');
      const returnPickupFeeEl = $('returnPickupFee');
      const discountValue = num(discountEl ? discountEl.value : 0);
      const returnFeeValue = num(returnFeeEl ? returnFeeEl.value : 0);
      const pickupFee = getReceiveMethod() !== 'tai_quay' && returnFeePayerEl && returnFeePayerEl.value === 'khach' ? num(returnPickupFeeEl ? returnPickupFeeEl.value : 0) : 0;
      const { difference } = getReturnDifferenceTotals();
      const originTotalEl = $('originTotal');
      const returnTotalEl = $('returnTotal');
      const exchangeTotalEl = $('exchangeTotal');
      const differenceTotalEl = $('differenceTotal');
      const pickupFeeNoteEl = $('pickupFeeNote');
      if (originTotalEl) originTotalEl.textContent = fmtMoney(origin);
      if (returnTotalEl) returnTotalEl.textContent = fmtMoney(total);
      if (exchangeTotalEl) exchangeTotalEl.textContent = fmtMoney(exchange);
      if (differenceTotalEl) differenceTotalEl.textContent = fmtMoney(difference);
      if (pickupFeeNoteEl) pickupFeeNoteEl.style.display = getReceiveMethod() !== 'tai_quay' && num(returnPickupFeeEl ? returnPickupFeeEl.value : 0) > 0 && returnFeePayerEl && returnFeePayerEl.value === 'cua_hang' ? 'block' : 'none';
      if (!returnPaymentTouched) {
        returnIsPayAllMode = false;
      }
      renderReturnPaymentSummary();
    }
    async function submitReturn(){
      const button = document.getElementById('submitReturnBtn');
      const status = document.getElementById('returnStatus');
      if (button.disabled) return;
      if(!selectedInvoice){
        openInvoiceModal();
        return;
      }
      const items = returnItems.filter(i => i.so_luong > 0).map(i => ({ ct_hoa_don_id: i.ct_hoa_don_id || '', hang_hoa_id: i.hang_hoa_id, lo_hang_id: i.lo_hang_id || '', so_luong: i.so_luong, don_gia: i.don_gia, chiet_khau: i.chiet_khau || 0 }));
      if(!items.length) return alert('Vui lòng nhập số lượng hàng trả');
      const receiveMethod = getReceiveMethod();
      const senderName = (returnSenderName.value || '').trim() || selectedInvoice?.khach_hang_id?.ten_khach_hang || '';
      const pickupAddress = (returnPickupAddress.value || '').trim();
      if(receiveMethod === 'lay_tai_nha' && !pickupAddress) return alert('Vui lòng nhập địa chỉ lấy hàng trả');
      if(receiveMethod === 'lay_tai_nha' && !senderName) return alert('Vui lòng nhập tên người gửi trả');
      const exchangeItems = buildExchangeSubmitLines();
      const selectedCustomerId = selectedInvoice?.khach_hang_id?._id || selectedInvoice?.khach_hang_id || null;
      if(exchangeItems.length && !selectedCustomerId) return alert('Vui lòng chọn khách hàng trước khi đặt đơn đổi');
      const swapStockError = validateSwapStock();
      if (swapStockError) return alert(swapStockError);
      const paymentError = validateReturnPayment();
      if (paymentError) return alert(paymentError);
      const vatChuaError = validateReturnVatChuaInput();
      if (vatChuaError) return alert(vatChuaError);
      const payload = {
        hoa_don_id: selectedInvoice?._id || null,
        khach_hang_id: selectedCustomerId,
        kho_id: selectedInvoice?.kho_id?._id || selectedInvoice?.kho_id || null,
        items,
        exchangeItems,
        giam_gia: num(discount.value),
        kieu_giam_gia: discountType.value || 'vnd',
        phi_tra_hang: num(returnFee.value),
        hinh_thuc_nhan_hang_tra: receiveMethod,
        doi_tac_giao_hang_id: receiveMethod === 'tai_quay' ? '' : returnPartnerId.value,
        dia_chi_lay_hang: receiveMethod === 'lay_tai_nha' ? pickupAddress : '',
        ten_nguoi_gui_tra: receiveMethod === 'tai_quay' ? '' : senderName,
        sdt_nguoi_gui_tra: receiveMethod === 'tai_quay' ? '' : (returnSenderPhone.value || '').trim(),
        phi_lay_hang_tra: receiveMethod === 'tai_quay' ? 0 : num(returnPickupFee.value),
        nguoi_tra_phi_lay_hang: returnFeePayer.value,
        ma_van_don_tra_hang: receiveMethod === 'tai_quay' ? '' : (returnTrackingCode.value || '').trim(),
        ghi_chu_van_chuyen_tra: receiveMethod === 'tai_quay' ? '' : (returnTransportNote.value || '').trim(),
        ly_do: (returnReason.value || '').trim(),
        ghi_chu: (returnNote.value || '').trim(),
        ...buildReturnPaymentSubmitFields()
      };
      button.disabled = true;
      button.textContent = 'ĐANG XỬ LÝ...';
      status.style.color = '#006dff';
      status.textContent = 'Đang gửi yêu cầu tạo phiếu trả hàng...';
      try {
        const res = await fetch('/don-hang/tra-hang/add', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(payload) });
        const text = await res.text();
        let result = {};
        try {
          result = text ? JSON.parse(text) : {};
        } catch (_) {
          throw new Error(text || 'Backend trả về phản hồi không hợp lệ');
        }
        if(!res.ok || !result.success) throw new Error(result.message || 'Không tạo được phiếu trả hàng');
        status.style.color = '#008a3d';
        status.textContent = result.message || 'Đã tạo phiếu trả hàng';
        setTimeout(() => { window.location.href = '/don-hang/tra-hang'; }, 500);
      } catch (error) {
        status.style.color = '#d92d20';
        status.textContent = error.message || 'Lỗi khi tạo phiếu trả hàng';
        alert(status.textContent);
        button.disabled = false;
        button.textContent = 'TRẢ HÀNG';
      }
    }
    async function applyCopyDraft() {
      if (!copyDraft || !copyDraft.hoa_don_id) return;
      await selectInvoice(copyDraft.hoa_don_id);
      if (copyDraft.return_items && copyDraft.return_items.length) {
        const byKey = {};
        returnItems.forEach(item => { byKey[String(item.line_key || item.hang_hoa_id)] = item; });
        copyDraft.return_items.forEach(row => {
          const key = String(row.hang_hoa_id) + '::' + String(row.lo_hang_id || '');
          const target = returnItems.find(item => String(item.hang_hoa_id) + '::' + String(item.lo_hang_id || '') === key);
          if (target) target.so_luong = Number(row.so_luong || 0);
        });
      }
      if (copyDraft.exchange_items && copyDraft.exchange_items.length) {
        await loadSwapProductsByWarehouse();
        swapItems = copyDraft.exchange_items.map(row => {
          const product = swapAvailableProducts.find(p => String(p._id) === String(row.hang_hoa_id))
            || products.find(p => String(p._id) === String(row.hang_hoa_id))
            || {};
          const metrics = product._id ? swapProductMetrics(product) : { soLuongKhaDung: Number(row.so_luong || 0) };
          const maxQty = Math.max(metrics.soLuongKhaDung || 0, Number(row.so_luong || 0));
          const qty = Math.min(Number(row.so_luong || 0), maxQty);
          return {
            hang_hoa_id: row.hang_hoa_id,
            ma_hang: product.ma_hang || '',
            ten_hang: product.ten_hang || '',
            so_luong_goc: maxQty,
            so_luong: qty,
            don_gia: Number(row.don_gia || product.gia_ban || 0)
          };
        }).filter(item => item.so_luong > 0);
      }
      returnReason.value = copyDraft.ly_do || 'Khách trả hàng';
      returnNote.value = copyDraft.ghi_chu || '';
      discount.value = fmt(copyDraft.giam_gia || 0);
      discountType.value = copyDraft.kieu_giam_gia || 'vnd';
      returnFee.value = fmt(copyDraft.phi_tra_hang || 0);
      setReceiveMethod(copyDraft.hinh_thuc_nhan_hang_tra || 'tai_quay');
      returnPartnerId.value = copyDraft.doi_tac_giao_hang_id || '';
      returnPickupAddress.value = copyDraft.dia_chi_lay_hang || '';
      returnSenderName.value = copyDraft.ten_nguoi_gui_tra || '';
      returnSenderPhone.value = copyDraft.sdt_nguoi_gui_tra || '';
      returnPickupFee.value = fmt(copyDraft.phi_lay_hang_tra || 0);
      returnFeePayer.value = copyDraft.nguoi_tra_phi_lay_hang || 'cua_hang';
      returnTrackingCode.value = copyDraft.ma_van_don_tra_hang || '';
      returnTransportNote.value = copyDraft.ghi_chu_van_chuyen_tra || '';
      renderItems();
      renderSwapItems();
    }
    async function bootstrapReturnCreatePage() {
      try {
        formatNumInputValues();
        renderSwapItems();
        renderReturnTransport();
        await loadReturnPaymentCashBooks();
        if (copyFromError) alert(copyFromError);
        if (prefillInvoiceError) alert(prefillInvoiceError);
        if (prefillInvoicePayload) applyInvoicePayload(prefillInvoicePayload);
        else if (initialInvoiceId) await selectInvoice(initialInvoiceId);
        else if (copyDraft) await applyCopyDraft();
        else loadInvoices(1);
      } catch (error) {
        console.error(error);
        alert(error.message || 'Không tải được dữ liệu trả hàng');
      }
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', bootstrapReturnCreatePage);
    } else {
      bootstrapReturnCreatePage();
    }
    document.addEventListener('click', event => {
      const itemSearchEl = $('itemSearch');
      const productResultsEl = $('productResults');
      const swapSearchEl = $('swapSearch');
      const swapResultsEl = $('swapResults');
      if (itemSearchEl && productResultsEl && !itemSearchEl.contains(event.target) && !productResultsEl.contains(event.target)) productResultsEl.style.display = 'none';
      if (swapSearchEl && swapResultsEl && !swapSearchEl.contains(event.target) && !swapResultsEl.contains(event.target)) swapResultsEl.style.display = 'none';
    });
  </script>
</body>
</html>



