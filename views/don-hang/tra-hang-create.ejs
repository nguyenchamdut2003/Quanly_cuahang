    function updSwapDetailPrice(itemIdx, qcIdx, value) {
      const item = swapItems[itemIdx];
      if (!item) return;
      const rows = swapItemDetailRows(item);
      const row = rows[qcIdx];
      if (!row || row.cho_phep_sua_gia === false) return alert('Dòng này không cho phép sửa giá.');
      row.don_gia = Math.max(0, num(value));
      renderSwapItems();
