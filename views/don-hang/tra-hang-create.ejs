          ten_quy_cach: qc.ten_quy_cach || qc.ten_thuoc_tinh || '',
          ten_thuoc_tinh: qc.ten_thuoc_tinh || qc.ten_quy_cach || '',
          ton_hien_tai: Number(qc.ton_hien_tai || qc.ton_kho || 0),
          ton_thuc_te: qc.ton_thuc_te !== undefined ? Number(qc.ton_thuc_te || 0) : undefined,
          so_luong_khach_dat: qc.so_luong_khach_dat ?? qc.khach_dat ?? qc.da_dat ?? undefined,
