        <div class="middle-payment-row"><span>Tiền thừa</span><span class="money-input-wrap"><input id="changeReturnedToCustomer" class="payment-input" value="0" inputmode="numeric" oninput="handleReturnPaymentInput(this, 'change')"><span class="money-unit">VNĐ</span></span></div>
        <div class="middle-payment-row"><span id="returnPayableLabel">Cần trả khách</span><strong id="returnPayableAmount">0 VNĐ</strong></div>
        <div class="middle-payment-row"><span id="returnPaidLabel">Đã trả khách</span><strong id="returnPaidAmount">0 VNĐ</strong></div>
        <div class="middle-payment-row middle-payment-total"><span id="returnRemainingLabel">Còn phải trả</span><strong id="returnRemainingAmount">0 VNĐ</strong></div>
