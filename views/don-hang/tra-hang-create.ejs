    async function loadSwapProductsByWarehouse() {
      const khoId = getSwapWarehouseId();
      if (!khoId) {
        clearSwapProductState(false);
        return;
      }
      swapProductsLoading = true;
      try {
        const res = await fetch('/api/kho/' + encodeURIComponent(khoId) + '/hang-ban-hang?kho_id=' + encodeURIComponent(khoId));
        const result = await res.json();
        if (!result.success) throw new Error(result.message || 'Không tải được hàng hóa trong kho');
        swapAvailableProducts = (result.data || []).map(mapSwapProductRow);
        swapStockByProduct.clear();
        swapAvailableProducts.forEach(product => {
          swapStockByProduct.set(product._id, Number(product.ton_kho || 0));
        });
        swapItems.forEach(item => {
          const product = swapAvailableProducts.find(p => String(p._id) === String(item.hang_hoa_id));
          if (!product) return;
          const metrics = swapProductMetrics(product);
          item.so_luong_goc = Math.max(0, metrics.soLuongKhaDung);
          item.ton_thuc_te = metrics.tonThucTe;
          item.so_luong_khach_dat = metrics.soLuongKhachDat;
          item.so_luong_kha_dung = metrics.soLuongKhaDung;
          item.ten_ncc = product.ten_ncc || '';
          item.ma_ncc = product.ma_ncc || '';
        });
        renderSwapItems();
      } catch (error) {
        swapAvailableProducts = [];
        swapStockByProduct.clear();
        console.error(error);
      } finally {
        swapProductsLoading = false;
      }
    }
    function getReceiveMethod(){
