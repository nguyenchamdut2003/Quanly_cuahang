    .transport-field input,.transport-field select,.transport-field textarea{width:100%;border:1px solid #cbd5e1;border-radius:6px;min-height:34px;padding:6px 8px;font-size:var(--text-base);background:#fff}
    .transport-field input[type="number"],.transport-field input.num-input,#returnPickupFee{text-align:right}
    .transport-field textarea{min-height:48px;resize:vertical}
    .fee-note{display:none;color:#64748b;font-size:var(--text-xs);margin-top:-4px;margin-bottom:4px}
    .vat-chua-combo{display:grid;grid-template-columns:minmax(0,1fr) 88px;gap:8px}
    .vat-chua-combo select,.vat-chua-combo input{width:100%;min-height:34px;border:1px solid #cbd5e1;border-radius:6px;padding:6px 8px;font-size:var(--text-base);background:#fff}
    .vat-chua-combo input{text-align:right}
    .vat-chua-title{display:flex;align-items:center;gap:8px}
    .vat-chua-help{position:relative;display:inline-flex;align-items:center;justify-content:center;color:#d97706;cursor:help;font-size:var(--text-base);line-height:1}
    .vat-chua-help-tip{display:none;position:absolute;left:0;top:calc(100% + 8px);width:min(280px,calc(100vw - 48px));padding:10px 12px;background:#1f2937;color:#fff;font-size:var(--text-xs);font-weight:400;line-height:1.45;border-radius:8px;z-index:30;box-shadow:0 10px 24px rgba(15,23,42,.22)}
    .vat-chua-help-tip strong{display:block;margin-bottom:4px;color:#fde68a;font-weight:700}
    .vat-chua-help:hover .vat-chua-help-tip,.vat-chua-help:focus-within .vat-chua-help-tip{display:block}
    .search-item{height:42px;padding:0 12px;display:flex;align-items:center;justify-content:space-between;font-size:var(--text-base);cursor:pointer}
    .search-item:hover{background:#f0f7ff}
    .search-item.product-search-item{height:auto;min-height:52px;padding:7px 12px;gap:12px}
    .search-item-info{min-width:0}
    .search-item-main{display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .search-item-meta{display:block;margin-top:3px;color:#667085;font-size:var(--text-xs);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .search-item-price{flex:0 0 auto}
    .swap-cart-table-wrap{flex:1;min-height:120px;overflow:auto;padding:8px 12px 12px}
    .cart-table{width:100%;border-collapse:collapse;background:#fff;border-radius:8px;overflow:hidden}
    .cart-table th{height:36px;background:#e8f3ff;text-align:left;padding:0 10px;border-bottom:1px solid #bcd9ff;font-size:var(--text-base)}
    .cart-table td{height:40px;border-bottom:1px solid #e5e9ee;padding:0 10px;font-size:var(--text-base)}
    .cart-table .num{text-align:right}
    .cart-table .small{width:74px;height:28px;border:1px solid #cfd8e3;border-radius:5px;text-align:right;padding:0 6px}
    .discount-pair{display:inline-flex;gap:6px;align-items:center;justify-content:flex-end}
    .discount-pair select{width:70px;height:28px;border:1px solid #cfd8e3;border-radius:5px;background:#fff}
    .stock-text{display:block;margin-top:3px;color:#667085;font-size:var(--text-xs)}
    .money-input-wrap{display:inline-flex;align-items:center;justify-content:flex-end;gap:6px;white-space:nowrap}
    .lot-cell{min-width:88px;cursor:pointer;vertical-align:middle;transition:background .15s}
    .lot-cell:hover{background:#eef6ff}
    .lot-cell.is-active{background:#dbeafe;box-shadow:inset 0 0 0 2px #3b82f6}
    .lot-cell-empty{cursor:default;background:#fafbfc}
    .lot-cell-main{font-weight:700;font-size:var(--text-base);line-height:1.3}
    .lot-cell-sub{margin-top:2px;color:#667085;font-size:var(--text-xs);line-height:1.25;text-align:right}
    .lot-inline-normal{padding:6px 10px!important;height:auto!important}
    .lot-inline-normal .inline-detail-grid{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:8px;align-items:center;font-size:var(--text-base)}
    .lot-inline-normal .inline-detail-grid .inline-label{color:#667085;font-size:var(--text-xs);margin-bottom:2px}
    .qc-row td{height:auto;padding:0 10px 10px 86px;background:#fbfdff}
    .qc-table{width:100%;border-collapse:collapse;border:1px solid #dbe7f5;background:#fff}
    .qc-table th,.qc-table td{height:32px;padding:0 8px;border-bottom:1px solid #edf2f7;font-size:var(--text-base)}
    .qc-table th{background:#f2f8ff;font-weight:700}
    .qc-input{width:74px;height:26px;border:1px solid #cfd8e3;border-radius:5px;text-align:right;padding:0 6px}
    .qc-table .num{text-align:right}
    .swap-cart-empty{height:120px;display:flex;align-items:center;justify-content:center;color:#667085;font-size:var(--text-base)}
    .note{font-size:var(--text-base);height:auto;min-height:56px;padding:16px 20px}
    .return-status{min-height:24px;margin-top:8px;color:#667085;font-size:var(--text-base)}
    .top-actions{font-size:var(--text-base)}
    .modal h2{font-size:var(--text-lg);font-weight:800}
    .filter-card h3{font-size:var(--text-lg);font-weight:800}
    .filter-input,.invoice-table th,.invoice-table td,.choose,.quick{font-size:var(--text-base)}
    .close{font-size:var(--text-lg)}
  </style>
</head>
<body>
  <div class="topbar">
    <div class="search"><i class="fa-solid fa-magnifying-glass"></i><input id="itemSearch" placeholder="Tìm hàng trả (F3)" onfocus="handleItemSearch(true)" oninput="handleItemSearch()"><div id="productResults" class="product-results"></div></div>
    <button class="btn-pick-invoice" type="button" onclick="openInvoiceModal()"><i class="fa-solid fa-file-invoice"></i> Chọn hóa đơn</button>
  </div>
  <main class="return-app">
    <section class="left">
      <div id="returnItems" class="cart"></div>
      <div class="return-swap"><div class="search"><i class="fa-solid fa-magnifying-glass"></i><input id="swapSearch" placeholder="Tìm hàng đổi (F7)" onfocus="handleSwapSearch(true)" oninput="handleSwapSearch()"><div id="swapResults" class="product-results"></div></div></div>
      <div class="swap-cart-table-wrap">
        <table class="cart-table">
          <thead id="swapCartHead"></thead>
          <tbody id="swapCartBody"></tbody>
        </table>
      </div>
      <div class="note"><i class="fa-solid fa-pen"></i> Ghi chú phiếu trả</div>
    </section>
    <section class="right">
      <div class="right-head"><span id="sellerName">Nguyễn Văn Nguyễn</span><span><%= new Date().toLocaleString('vi-VN', { day:'2-digit', month:'2-digit', year:'numeric', hour:'2-digit', minute:'2-digit' }) %></span></div>
      <div class="customer"><i class="fa-solid fa-user"></i> <span id="customerName">Chưa chọn khách hàng</span></div>
      <div class="link-line"><span id="returnInvoiceTitle">Trả hàng</span> / <a id="invoiceLink" href="#">Chưa chọn hóa đơn</a></div>
      <div class="transport-field full" style="margin-bottom:10px">
        <label for="returnReason">Lý do trả</label>
        <input id="returnReason" value="Khách trả hàng">
      </div>
      <div class="transport-field full" style="margin-bottom:10px">
        <label for="returnNote">Ghi chú</label>
        <input id="returnNote" placeholder="Ghi chú phiếu trả hàng">
      </div>
      <div class="sum-group">
        <div class="sum-line"><span class="sum-label">Tổng giá gốc hàng mua</span><span id="originTotal" class="sum-value">0</span></div>
        <div class="sum-line"><span class="sum-label">Tổng tiền hàng trả</span><span id="returnTotal" class="sum-value">0</span></div>
        <div class="sum-line"><span class="sum-label">Tổng tiền hàng đổi</span><span id="exchangeTotal" class="sum-value">0</span></div>
      </div>
      <div class="return-section">
        <div class="section-title">Hình thức nhận hàng trả</div>
        <div class="receive-options">
          <label class="receive-option"><input type="radio" name="returnReceiveMethod" value="tai_quay" checked onchange="renderReturnTransport()"> Trả tại quầy</label>
          <label class="receive-option"><input type="radio" name="returnReceiveMethod" value="lay_tai_nha" onchange="renderReturnTransport()"> Lấy tại nhà</label>
          <label class="receive-option"><input type="radio" name="returnReceiveMethod" value="khach_gui_ve" onchange="renderReturnTransport()"> Khách gửi về</label>
        </div>
        <div id="returnTransportFields" class="transport-fields">
          <div class="transport-field full">
            <label id="returnPartnerLabel" for="returnPartnerId">Đối tác giao hàng / người lấy hàng</label>
            <select id="returnPartnerId">
              <option value="">Không chọn</option>
              <% partnerPayload.forEach(partner => { %>
                <option value="<%= partner._id %>"><%= partner.ma_doi_tac ? partner.ma_doi_tac + ' - ' : '' %><%= partner.ten_doi_tac %></option>
              <% }) %>
            </select>
          </div>
          <div class="transport-field">
            <label for="returnSenderName">Tên người gửi trả</label>
            <input id="returnSenderName" placeholder="Tên khách/người gửi">
          </div>
          <div class="transport-field">
            <label for="returnSenderPhone">SĐT người gửi trả</label>
            <input id="returnSenderPhone" placeholder="Số điện thoại">
          </div>
          <div id="pickupAddressField" class="transport-field full">
            <label for="returnPickupAddress">Địa chỉ lấy hàng</label>
            <input id="returnPickupAddress" placeholder="Địa chỉ lấy hàng trả">
          </div>
          <div class="transport-field">
            <label for="returnPickupFee">Phí lấy hàng trả</label>
