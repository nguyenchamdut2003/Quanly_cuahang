    function buildExchangeSubmitLines() {
      const lines = [];
      swapItems.forEach(item => {
        const detailRows = swapItemDetailRows(item);
        if (detailRows.length) {
          detailRows.forEach(row => {
            const qty = Number(row.so_luong_dat || row.so_luong || 0);
            if (qty <= 0) return;
            const donGia = Number(row.don_gia ?? item.don_gia ?? 0);
            const base = qty * donGia;
            const net = Math.max(base - discountAmount(row.chiet_khau || 0, row.kieu_chiet_khau || 'vnd', base), 0);
            lines.push({
              hang_hoa_id: item.hang_hoa_id,
              lo_hang_id: row.lo_hang_id || '',
              gia_tri_thuoc_tinh_id: row.gia_tri_thuoc_tinh_id || '',
              ten_quy_cach: row.ten_quy_cach || row.ten_thuoc_tinh || '',
              ten_thuoc_tinh: row.ten_thuoc_tinh || row.ten_quy_cach || '',
              so_luong: qty,
              don_gia: donGia,
              thanh_tien: net
            });
          });
          return;
        }
        if (Number(item.so_luong || 0) <= 0) return;
        const base = item.so_luong * item.don_gia;
        const net = Math.max(base - discountAmount(item.chiet_khau || 0, item.kieu_chiet_khau || 'vnd', base), 0);
        lines.push({
          hang_hoa_id: item.hang_hoa_id,
          so_luong: item.so_luong,
          don_gia: item.don_gia,
          thanh_tien: net
        });
      });
      return lines;
    }
    function getSwapWarehouseId() {
