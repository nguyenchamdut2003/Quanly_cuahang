      <div id="returnPaymentSection" class="middle-payment" style="display:none">
        <div class="payment-title">Chi tiết thanh toán</div>
        <div class="middle-payment-row"><span>Tiền mặt</span><span class="money-input-wrap"><input id="cashCustomerGiven" class="payment-input" value="0" inputmode="numeric" oninput="handleReturnPaymentInput(this, 'cash')"><span class="money-unit">VNĐ</span><button type="button" class="btn-pay-all" onclick="fillReturnPaymentAll('cash')">Tất cả</button></span></div>
        <div class="middle-payment-row"><span>Sổ tiền mặt <span id="cashBookRequiredMark" class="required-mark" style="display:none">*</span></span>
          <select id="cashBookId" class="payment-select" disabled>
            <option value="">Chọn sổ tiền mặt</option>
          </select>
        </div>
        <div class="middle-payment-row"><span>Chuyển khoản</span><span class="money-input-wrap"><input id="transferCustomerGiven" class="payment-input" value="0" inputmode="numeric" oninput="handleReturnPaymentInput(this, 'transfer')"><span class="money-unit">VNĐ</span><button type="button" class="btn-pay-all" onclick="fillReturnPaymentAll('transfer')">Tất cả</button></span></div>
        <div class="middle-payment-row"><span>Tài khoản ngân hàng <span id="bankBookRequiredMark" class="required-mark" style="display:none">*</span></span>
