    async function addSwapItem(id){
      if (!selectedInvoice) return alert('Vui lòng chọn hóa đơn trước khi thêm hàng đổi');
      const product = swapAvailableProducts.find(p => String(p._id) === String(id));
      if(!product) return;
      const metrics = swapProductMetrics(product);
      const existing = swapItems.find(i => String(i.hang_hoa_id) === String(id));
      if (existing) {
        if (existing.has_quy_cach || existing.has_lot_items) {
          return alert('Hàng hóa có lô/thuộc tính, vui lòng nhập số lượng theo bảng bên dưới.');
        }
        existing.so_luong += 1;
        existing.so_luong_goc = Math.max(0, metrics.soLuongKhaDung);
        existing.ton_thuc_te = metrics.tonThucTe;
        existing.so_luong_khach_dat = metrics.soLuongKhachDat;
        existing.so_luong_kha_dung = metrics.soLuongKhaDung;
      } else {
        const hasQuyCach = Boolean(product.has_quy_cach && (product.quy_cach_items || []).length);
        const hasLotItems = Boolean(!hasQuyCach && product.quan_ly_theo_lo && (product.lot_items || []).length);
        const priceMeta = await fetchSwapSalePrice(id, {});
        const newItem = {
          hang_hoa_id: product._id,
          ma_hang: product.ma_hang,
          ten_hang: product.ten_hang,
          ten_ncc: product.ten_ncc || '',
          ma_ncc: product.ma_ncc || '',
          ton_thuc_te: metrics.tonThucTe,
          so_luong_khach_dat: metrics.soLuongKhachDat,
          so_luong_kha_dung: metrics.soLuongKhaDung,
          so_luong_goc: Math.max(0, metrics.soLuongKhaDung),
          so_luong: (hasQuyCach || hasLotItems) ? 0 : 1,
          don_gia: Number(priceMeta.gia_ban || product.gia_ban || 0),
          cho_phep_sua_gia: priceMeta.cho_phep_sua_gia !== false,
          chiet_khau: 0,
          kieu_chiet_khau: 'vnd',
          thanh_tien_goc: Number(priceMeta.gia_ban || product.gia_ban || 0),
          has_quy_cach: hasQuyCach,
          has_lot_items: hasLotItems,
          quy_cach_items: hasQuyCach ? (product.quy_cach_items || []).map(qc => Object.assign({}, qc, { so_luong_dat: '', don_gia: 0, chiet_khau: 0, kieu_chiet_khau: 'vnd' })) : [],
          lot_items: hasLotItems ? (product.lot_items || []).map(lot => Object.assign({}, lot, { so_luong_dat: '', don_gia: 0, chiet_khau: 0, kieu_chiet_khau: 'vnd' })) : []
        };
        if (hasQuyCach) await Promise.all(newItem.quy_cach_items.map(qc => applySwapPriceToDetailRow(id, qc)));
        if (hasLotItems) await Promise.all(newItem.lot_items.map(lot => applySwapPriceToDetailRow(id, lot)));
        swapItems.push(newItem);
        if (swapItemHasLotGrid(newItem)) {
          const lots = groupLotsForSwapItem(newItem);
          if (lots.length) expandedSwapLotKeyByItem[newItem.hang_hoa_id] = lots[0].lotKey;
        }
      }
      swapSearch.value = '';
      swapResults.style.display = 'none';
      renderSwapItems();
    }
    function addQuickItem(id, source = 'return'){
      const product = products.find(p => p._id === id);
      if(!product) return;
      const existing = returnItems.find(i => String(i.hang_hoa_id) === String(id));
      if(existing){
        existing.so_luong += 1;
      } else {
        returnItems.push({
          hang_hoa_id: product._id,
          ma_hang: product.ma_hang,
          ten_hang: product.ten_hang,
          so_luong_goc: Number(product.ton_kho || 999),
          so_luong: 1,
          don_gia: Number(product.gia_ban || 0),
          thanh_tien_goc: Number(product.gia_ban || 0)
        });
      }
      if(source === 'swap'){
        swapSearch.value = '';
        swapResults.style.display = 'none';
      } else {
        itemSearch.value = '';
        productResults.style.display = 'none';
      }
      renderItems();
    }
    function renderItems(){
      const itemSearchEl = $('itemSearch');
      const q = itemSearchEl ? itemSearchEl.value.trim().toLowerCase() : '';
      const rows = returnItems.filter(i => !q || i.ma_hang.toLowerCase().includes(q) || i.ten_hang.toLowerCase().includes(q));
      const returnItemsEl = document.getElementById('returnItems');
      returnItemsEl.innerHTML = rows.length ? rows.map((item, index) => `<div class="return-row"><i class="fa-regular fa-trash-can" onclick="removeItem('${item.line_key || item.hang_hoa_id}')" style="cursor:pointer"></i><div class="code">${item.ma_hang}</div><div class="name">${item.ten_hang}${item.ten_thuoc_tinh ? `<div class="origin">Thuộc tính: ${item.ten_thuoc_tinh}</div>` : ''}${item.lo_hang ? `<div class="origin">Lô: ${item.lo_hang}</div>` : ''}</div><div class="qty-wrap"><input class="line-input" inputmode="numeric" value="${fmt(item.so_luong)}" oninput="handleNumInput(this)" onchange="setQty('${item.line_key || item.hang_hoa_id}',this.value)"><div class="origin">/ ${fmt(item.so_luong_goc)}</div></div><input class="line-input" inputmode="numeric" value="${fmt(item.don_gia)}" oninput="handleNumInput(this)" onchange="setPrice('${item.line_key || item.hang_hoa_id}',this.value)"><div class="num">${fmtMoney(item.so_luong * item.don_gia)}</div><i class="fa-solid fa-ellipsis-vertical"></i></div>`).join('') : '<div style="height:320px;display:flex;align-items:center;justify-content:center;color:#667085">Chọn hóa đơn để lấy hàng trả</div>';
      renderTotals();
