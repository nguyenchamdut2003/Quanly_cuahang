        <div class="vat-chua-combo">
          <select id="returnVatChuaId" title="Chọn vật chứa">
            <option value="">— Chọn vật chứa —</option>
            <% (Array.isArray(locals.vatChuaList) ? locals.vatChuaList : []).forEach(function(vc) { %>
              <option value="<%= vc._id %>"><%= vc.ma_vat_chua ? vc.ma_vat_chua + ' - ' : '' %><%= vc.ten_vat_chua || '---' %></option>
            <% }) %>
          </select>
          <input id="returnVatChuaQty" class="num-input signed-num-input" value="" inputmode="numeric" placeholder="SL" title="Nhập dương để nhập kho, âm để xuất kho" data-allow-empty="1" data-allow-signed="1" oninput="handleSignedNumInput(this)">
        </div>
