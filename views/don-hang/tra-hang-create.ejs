    .submit:hover:not(:disabled){transform:translateY(-1px);box-shadow:0 6px 18px rgba(0,112,244,.42)}
    .submit:active:not(:disabled){transform:translateY(0)}
    .submit:disabled{opacity:.65;cursor:not-allowed;box-shadow:none}
    .return-section{border-top:1px solid #e2e8f0;border-bottom:1px solid #e2e8f0;padding:12px 0;margin:4px 0 10px}
    .section-title{font-weight:800;margin-bottom:8px;font-size:var(--text-lg)}
    .receive-options{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin-bottom:10px}
