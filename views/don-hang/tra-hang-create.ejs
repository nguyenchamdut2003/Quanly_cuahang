  </div>
  <% if (typeof copyDraftJson === 'string' && copyDraftJson) { %>
  <script id="copy-draft-embed" type="application/json"><%- copyDraftJson %></script>
  <% } %>
  <% if (typeof prefillInvoiceJson === 'string' && prefillInvoiceJson) { %>
  <script id="prefill-invoice-embed" type="application/json"><%- prefillInvoiceJson %></script>
  <% } %>
  <script>
    const $ = (id) => document.getElementById(id);
    let copyDraft = null;
    let prefillInvoicePayload = null;
    (function() {
      const copyEl = document.getElementById('copy-draft-embed');
      if (copyEl) {
        try { copyDraft = JSON.parse(copyEl.textContent || 'null'); } catch (e) { copyDraft = null; }
      }
      const prefillEl = document.getElementById('prefill-invoice-embed');
      if (prefillEl && String(prefillEl.textContent || '').trim()) {
        try { prefillInvoicePayload = JSON.parse(prefillEl.textContent || 'null'); } catch (e) { prefillInvoicePayload = null; }
      }
    })();
    const copyFromError = <%- JSON.stringify(copyFromError || '') %>;
    const prefillInvoiceError = <%- JSON.stringify(prefillInvoiceError || '') %>;
    const invoices = <%- JSON.stringify(invoicePayload) %>;
    const products = <%- JSON.stringify(productPayload) %>;
    const partners = <%- JSON.stringify(partnerPayload) %>;
    const queryParams = new URLSearchParams(window.location.search);
    const initialInvoiceId = queryParams.get('hoa_don_id') || queryParams.get('invoice_id') || '';
    let selectedInvoice = null;
    let returnItems = [];
    let swapItems = [];
    let swapAvailableProducts = [];
    let swapStockByProduct = new Map();
    let swapProductsLoading = false;
    let expandedSwapLotKeyByItem = {};
    let returnPaymentTouched = false;
    let returnIsPayAllMode = false;
    let returnPayAllTarget = 'cash';
    let returnPaymentPriority = 'cash';
    let cashBookOptions = [];
    let bankBookOptions = [];
    let lastReturnPaymentTotals = { khachCanTra: 0, khachThanhToan: 0, tienThuaTraKhach: 0, tongKhachDua: 0, isRefund: true };
    const fmt = n => Number(n || 0).toLocaleString('vi-VN');
    const fmtMoney = n => fmt(n) + ' VNĐ';
    const num = v => Number(String(v || '').replace(/\./g, '').replace(/,/g, '')) || 0;
    const numSigned = v => {
      const raw = String(v || '').trim().replace(/\./g, '').replace(/,/g, '');
      if (!raw || raw === '-') return 0;
      const n = Number(raw);
      return Number.isFinite(n) ? n : 0;
    };
    const fmtSigned = n => {
      const qty = Math.floor(Number(n) || 0);
      if (!qty) return '0';
      const abs = fmt(Math.abs(qty));
      return qty < 0 ? '-' + abs : abs;
    };
    function handleNumInput(input, callback) {
      if (!input) return;
      const raw = String(input.value || '').trim();
      if (raw === '' && input.dataset.allowEmpty === '1') {
        if (typeof callback === 'function') callback();
        return;
      }
      input.value = fmt(Math.max(0, num(raw)));
      if (typeof callback === 'function') callback();
    }
    function handleSignedNumInput(input, callback) {
      if (!input) return;
      const raw = String(input.value || '').trim();
      if (raw === '' && input.dataset.allowEmpty === '1') {
        if (typeof callback === 'function') callback();
        return;
      }
      if (raw === '-') {
        if (typeof callback === 'function') callback();
        return;
      }
      input.value = fmtSigned(numSigned(raw));
      if (typeof callback === 'function') callback();
    }
    function formatNumInputValues(root) {
      const scope = root && root.querySelectorAll ? root : document;
      scope.querySelectorAll('input.num-input, input.line-input, input.payment-input, .cart-table input.small, .cart-table input.qc-input').forEach(el => {
        if (el.readOnly || el.type === 'hidden') return;
        const raw = String(el.value || '').trim();
        if (raw === '' && el.dataset.allowEmpty === '1') return;
        if (el.dataset.allowSigned === '1') {
          if (raw === '-') return;
          el.value = fmtSigned(numSigned(raw));
          return;
        }
        el.value = fmt(Math.max(0, num(raw)));
      });
    }
    function escapeHtml(value) {
      return String(value || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }
    function firstNumber(...values) {
      for (const value of values) {
        if (value === undefined || value === null || value === '') continue;
        const number = Number(value);
        if (Number.isFinite(number)) return number;
      }
      return 0;
    }
    function inventoryMetrics(row = {}, fallbackStock = 0) {
      const tonThucTe = firstNumber(row.ton_thuc_te, row.ton_hien_tai, row.ton_kho, row.ton, fallbackStock, 0);
      const soLuongKhachDat = Math.max(0, firstNumber(row.so_luong_khach_dat, row.khach_dat, row.da_dat, 0));
      const soLuongKhaDung = firstNumber(row.so_luong_kha_dung, row.kha_dung, tonThucTe - soLuongKhachDat);
      return { tonThucTe, soLuongKhachDat, soLuongKhaDung };
    }
    function swapStockFor(productId) { return Number(swapStockByProduct.get(String(productId)) || 0); }
    function swapProductMetrics(product = {}) {
      if (product.has_quy_cach && Array.isArray(product.quy_cach_items) && product.quy_cach_items.length) {
        return product.quy_cach_items.reduce((sum, qc) => {
          const metrics = inventoryMetrics(qc);
          sum.tonThucTe += metrics.tonThucTe;
          sum.soLuongKhachDat += metrics.soLuongKhachDat;
          sum.soLuongKhaDung += metrics.soLuongKhaDung;
          return sum;
        }, { tonThucTe: 0, soLuongKhachDat: 0, soLuongKhaDung: 0 });
      }
      if (product.quan_ly_theo_lo && Array.isArray(product.lot_items) && product.lot_items.length) {
        const lotMetrics = product.lot_items.reduce((sum, lot) => {
          const metrics = inventoryMetrics(lot);
          sum.tonThucTe += metrics.tonThucTe;
          sum.soLuongKhachDat += metrics.soLuongKhachDat;
          sum.soLuongKhaDung += metrics.soLuongKhaDung;
          return sum;
        }, { tonThucTe: 0, soLuongKhachDat: 0, soLuongKhaDung: 0 });
        const productReserved = Math.max(0, firstNumber(product.so_luong_khach_dat, 0));
        const reserved = Math.max(lotMetrics.soLuongKhachDat, productReserved);
        return {
          tonThucTe: lotMetrics.tonThucTe,
          soLuongKhachDat: reserved,
          soLuongKhaDung: lotMetrics.tonThucTe - reserved
        };
      }
      return inventoryMetrics(product, swapStockFor(product._id));
    }
    const swapSalePriceCache = new Map();
    const formatDateVi = value => value ? new Date(value).toLocaleDateString('vi-VN') : '';
    async function fetchSwapSalePrice(productId, ctx = {}) {
      const key = [productId, ctx.lo_hang_id || '', ctx.gia_tri_thuoc_tinh_id || '', ctx.ten_quy_cach || ''].join('|');
      if (swapSalePriceCache.has(key)) return swapSalePriceCache.get(key);
      const product = swapAvailableProducts.find(p => String(p._id) === String(productId));
      let data = { gia_ban: Number(product?.gia_ban || 0), cho_phep_sua_gia: true };
      try {
        const params = new URLSearchParams();
        if (ctx.lo_hang_id) params.set('lo_hang_id', String(ctx.lo_hang_id));
        if (ctx.gia_tri_thuoc_tinh_id) params.set('gia_tri_thuoc_tinh_id', String(ctx.gia_tri_thuoc_tinh_id));
        if (ctx.ten_quy_cach) params.set('ten_quy_cach', String(ctx.ten_quy_cach));
        const res = await fetch('/api/hang-hoa/' + encodeURIComponent(productId) + '/gia' + (params.toString() ? '?' + params.toString() : ''));
        const json = await res.json();
        if (json && json.success && json.data) data = json.data;
      } catch (_) { /* fallback gia_co_dinh */ }
      if (!Number(data.gia_ban)) data.gia_ban = Number(product?.gia_ban || 0);
      swapSalePriceCache.set(key, data);
      return data;
    }
    async function applySwapPriceToDetailRow(productId, row) {
      const meta = await fetchSwapSalePrice(productId, {
        lo_hang_id: row.lo_hang_id,
        gia_tri_thuoc_tinh_id: row.gia_tri_thuoc_tinh_id,
        ten_quy_cach: row.ten_quy_cach || row.ten_thuoc_tinh || ''
      });
      row.don_gia = Number(meta.gia_ban || 0);
      row.cho_phep_sua_gia = meta.cho_phep_sua_gia !== false;
      row.loai_ap_dung = meta.loai_ap_dung || null;
      if (!row.loai_gia_ban && meta.loai_ap_dung === 'ca_hai') {
        row.loai_gia_ban = meta.gia_mac_dinh === 'thi_truong' ? 'thi_truong' : 'co_dinh';
      }
      return row;
    }
    function swapItemMetrics(item) {
      const product = swapAvailableProducts.find(p => String(p._id) === String(item.hang_hoa_id));
      if (product) return swapProductMetrics(product);
      return {
        tonThucTe: firstNumber(item.ton_thuc_te, item.ton_kho, item.so_luong_goc, 0),
        soLuongKhachDat: Math.max(0, firstNumber(item.so_luong_khach_dat, 0)),
        soLuongKhaDung: firstNumber(item.so_luong_kha_dung, item.so_luong_goc, 0)
      };
    }
    function swapItemMetaHtml(item) {
      const product = swapAvailableProducts.find(p => String(p._id) === String(item.hang_hoa_id));
      const metrics = swapItemMetrics(item);
      const ncc = product ? swapSupplierName(product) : (item.ten_ncc || '—');
      const qcCount = product?.has_quy_cach ? (product.quy_cach_items || []).length : 0;
      const lotCount = product?.quan_ly_theo_lo ? (product.lot_items || []).length : 0;
      let html = `<div class="origin">NCC: ${escapeHtml(ncc)}</div>`;
      html += `<div class="origin">Tồn: ${fmt(metrics.tonThucTe)} · Khả dụng: ${fmt(metrics.soLuongKhaDung)}</div>`;
      if (metrics.soLuongKhachDat > 0) {
        html += `<div class="origin">Khách khác đã đặt: ${fmt(metrics.soLuongKhachDat)}</div>`;
      }
      if (qcCount) html += `<div class="origin">Thuộc tính: ${qcCount} mức</div>`;
      if (lotCount) html += `<div class="origin">Lô: ${lotCount} lô có tồn</div>`;
      return html;
    }
    function swapSupplierName(product = {}) {
      return product.ten_ncc || product.ma_ncc || '—';
    }
    function swapItemDetailRows(item) {
      if (item.has_quy_cach) return item.quy_cach_items || [];
      if (item.has_lot_items) return item.lot_items || [];
      return [];
    }
    function swapItemHasLotGrid(item) {
      if (!item || (!item.has_lot_items && !item.has_quy_cach)) return false;
      const rows = swapItemDetailRows(item);
      if (!rows.length) return false;
      if (item.has_lot_items) return true;
      return rows.some(row => row.lo_hang_id || row.ma_lo || row.ten_lo);
    }
    function parseLotDate(value) {
      const time = value ? new Date(value).getTime() : 0;
      return Number.isFinite(time) ? time : 0;
    }
    function groupLotsForSwapItem(item) {
      const map = new Map();
      const upsertLotGroup = (row, qcIdx) => {
        const lotKey = String(row.lo_hang_id || row.ma_lo || row.ten_lo || `row-${qcIdx}`);
        if (!map.has(lotKey)) {
          map.set(lotKey, {
            lotKey,
            lo_hang_id: row.lo_hang_id || '',
            ma_lo: row.ma_lo || '',
            ten_lo: row.ten_lo || '',
            ngay_nhap: row.ngay_nhap || '',
            han_su_dung: row.han_su_dung || '',
            items: []
          });
        }
        const group = map.get(lotKey);
        if (!group.items.some(entry => entry.qcIdx === qcIdx)) group.items.push({ row, qcIdx });
      };
      if (item.has_lot_items && !item.has_quy_cach) {
        (item.lot_items || []).forEach((row, qcIdx) => upsertLotGroup(row, qcIdx));
      } else {
        swapItemDetailRows(item).forEach((row, qcIdx) => upsertLotGroup(row, qcIdx));
      }
      return Array.from(map.values()).sort((a, b) => {
        const dateA = parseLotDate(a.ngay_nhap) || parseLotDate(a.han_su_dung);
        const dateB = parseLotDate(b.ngay_nhap) || parseLotDate(b.han_su_dung);
        if (dateA !== dateB) return dateA - dateB;
        return String(a.lotKey).localeCompare(String(b.lotKey), 'vi');
      });
    }
    function swapLotGroupSummary(lot) {
      const ton = lot.items.reduce((sum, entry) => sum + inventoryMetrics(entry.row).tonThucTe, 0);
      const khaDung = lot.items.reduce((sum, entry) => sum + inventoryMetrics(entry.row).soLuongKhaDung, 0);
      const dat = lot.items.reduce((sum, entry) => sum + Number(entry.row.so_luong_dat || entry.row.so_luong || 0), 0);
      const datePart = [lot.ten_lo || lot.ma_lo || '', lot.han_su_dung ? `HSD ${formatDateVi(lot.han_su_dung)}` : ''].filter(Boolean).join(' - ') || '—';
      return { ton, khaDung, dat, datePart };
    }
    function swapLineQty(item) {
      const detailRows = swapItemDetailRows(item);
      if (detailRows.length) {
        return detailRows.reduce((sum, row) => sum + Number(row.so_luong_dat || row.so_luong || 0), 0);
      }
      return Number(item.so_luong || 0);
    }
    function discountAmount(value, type, baseAmount) {
      const base = Math.max(0, Number(baseAmount || 0));
      const raw = Math.max(0, Number(value || 0));
      const amount = type === 'phan_tram' ? base * Math.min(raw, 100) / 100 : raw;
      return Math.min(amount, base);
    }
    function swapComputeLineTotal(item) {
      const detailRows = swapItemDetailRows(item);
      if (detailRows.length) {
        return detailRows.reduce((sum, row) => {
          const qty = Number(row.so_luong_dat || row.so_luong || 0);
          const price = Number(row.don_gia ?? item.don_gia ?? 0);
          const base = qty * price;
          return sum + Math.max(base - discountAmount(row.chiet_khau || 0, row.kieu_chiet_khau || 'vnd', base), 0);
        }, 0);
      }
      const base = Number(item.so_luong || 0) * Number(item.don_gia || 0);
      return Math.max(base - discountAmount(item.chiet_khau || 0, item.kieu_chiet_khau || 'vnd', base), 0);
    }
    function maxLotColumnsInSwapCart() {
      return swapItems.reduce((max, item) => {
        if (!swapItemHasLotGrid(item)) return max;
        return Math.max(max, groupLotsForSwapItem(item).length);
      }, 0);
    }
    function renderSwapCartThead(maxLots) {
      const thead = document.getElementById('swapCartHead');
      if (!thead) return;
      if (maxLots <= 0) {
        thead.innerHTML = `<tr>
          <th>STT</th>
          <th>Mã hàng</th>
          <th>Tên hàng</th>
          <th class="num">SL</th>
          <th class="num">Tồn</th>
          <th class="num" title="Số lượng đang được các đơn đặt hàng khác giữ nhưng chưa giao đủ.">Khách khác đã đặt</th>
          <th class="num" title="Khả dụng = Tồn thực tế - Khách khác đã đặt.">Khả dụng</th>
          <th class="num">Đơn giá</th>
          <th class="num">Giảm giá</th>
          <th class="num">Thành tiền</th>
          <th></th>
        </tr>`;
        return;
      }
      const lotHeaders = Array.from({ length: maxLots }, (_, index) => `<th class="num lot-col">Lô ${index + 1}</th>`).join('');
      thead.innerHTML = `<tr>
        <th>STT</th>
        <th>Mã hàng</th>
        <th>Tên hàng</th>
        ${lotHeaders}
        <th class="num">Thành tiền</th>
        <th></th>
