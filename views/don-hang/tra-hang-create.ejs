ckground:transparent}.origin{font-size:var(--text-base);color:#475569;margin-top:6px}.num{text-align:right;font-weight:800}.return-swap{height:42px;background:#0070f4;display:flex;align-items:center;padding:0 8px;gap:10px}.return-swap .search{width:460px;flex:0 0 460px}.return-swap .search input{height:32px;font-size:var(--text-base)}.return-swap:after{content:'\f02a';font-family:'Font Awesome 6 Free';font-weight:900;color:#9dccff;font-size:var(--text-lg)}.swap-cart{flex:1;min-height:120px;padding-top:8px}.note{height:72px;background:#fff;border-radius:10px;margin:12px 12px 12px;padding:24px 32px;color:#667085;font-size:var(--text-xl)}.right-head{display:grid;grid-template-columns:minmax(0,1fr) auto auto;gap:18px;align-items:center;font-size:var(--text-xl);margin-bottom:16px}.right-head span:first-child{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.customer{height:42px;background:#eef0f3;border-radius:6px;display:flex;align-items:center;gap:10px;padding:0 12px;color:#0070f4;font-weight:800;font-size:var(--text-xl);margin-bottom:22px}.link-line{font-size:var(--text-xl);font-weight:800;color:#00a651;margin-bottom:18px}.link-line a{color:#0070f4;text-decoration:none;font-weight:500}.sum-line{display:grid;grid-template-columns:minmax(0,1fr) 120px 110px;gap:12px;align-items:center;margin:19px 0;font-size:var(--text-xl)}.sum-line input{height:32px;border:0;border-bottom:1px solid #c2cad3;text-align:right;font-size:var(--text-lg);outline:none}.sum-line strong{font-weight:800}.product-results{display:none;position:absolute;top:38px;left:0;width:100%;background:#fff;color:#111827;border:1px solid #cfd8e3;border-radius:6px;box-shadow:0 12px 26px rgba(0,0,0,.18);z-index:80;max-height:320px;overflow:auto}.product-result{height:40px;padding:0 12px;display:flex;align-items:center;justify-content:space-between;cursor:pointer;font-size:var(--text-base)}.product-result:hover{background:#f0f7ff}.modal-backdrop{position:fixed;inset:0;background:rgba(0,0,0,.55);display:none;align-items:flex-start;justify-content:center;padding-top:22px;z-index:100}.modal-backdrop.open{display:flex}.modal{width:1404px;max-width:calc(100vw - 80px);height:618px;background:#fff;border-radius:16px;box-shadow:0 18px 40px rgba(0,0,0,.35);padding:26px 36px;position:relative}.modal h2{margin:0 0 24px;font-size:var(--text-lg)}.close{position:absolute;right:34px;top:28px;border:0;background:#fff;font-size:var(--text-xl);color:#6b7280;cursor:pointer}.modal-grid{display:grid;grid-template-columns:235px minmax(0,1fr);gap:38px}.filter-card{background:#fff;border-radius:6px;box-shadow:0 8px 24px rgba(0,0,0,.12);padding:18px 20px;margin-bottom:28px}.filter-card h3{margin:0 0 20px;font-size:var(--text-lg)}.filter-input{width:100%;height:46px;border:0;border-bottom:1px solid #c2cad3;font-size:var(--text-lg);outline:none}.invoice-table{border:1px solid #d7dde5;border-radius:5px;overflow:hidden}.invoice-table table{width:100%;border-collapse:collapse}.invoice-table th{height:46px;background:#338cf2;color:#fff;text-align:left;padding:0 12px;font-size:var(--text-lg)}.invoice-table td{height:49px;border-bottom:1px solid #dde3ea;padding:0 12px;font-size:var(--text-lg)}.invoice-table a{color:#006dff;text-decoration:none}.choose{height:30px;border:1px solid #c5cdd7;background:#fff;border-radius:5px;padding:0 28px;font-size:var(--text-lg);cursor:pointer}.pager{height:66px;display:flex;align-items:center;justify-content:flex-end;gap:12px}.page-btn{width:38px;height:38px;border-radius:8px;border:0;background:#fff;color:#111827;font-weight:800;cursor:pointer}.page-btn.active{background:#0070f4;color:#fff}.page-btn:disabled{color:#b8c0ca;cursor:not-allowed}.quick{position:absolute;right:36px;bottom:28px;height:44px;border:0;border-radius:7px;background:#0070f4;color:#fff;font-weight:800;font-size:var(--text-lg);padding:0 26px}
    .return-row{height:auto;min-height:76px;grid-template-columns:34px 132px minmax(190px,1fr) 92px 96px 118px 24px;padding:10px 16px;border-radius:8px;align-items:flex-start}
    .code,.name{font-size:var(--text-base)}
