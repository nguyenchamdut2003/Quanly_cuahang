        <section>
          <div class="invoice-table">
            <table>
              <thead><tr><th>Mã hóa đơn</th><th>Thời gian <i class="fa-solid fa-caret-down"></i></th><th>Người bán</th><th>Khách hàng</th><th class="num">Tổng cộng</th><th></th></tr></thead>
