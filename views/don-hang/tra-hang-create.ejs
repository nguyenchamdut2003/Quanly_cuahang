      <div class="sum-line"><span class="sum-label">Phí trả hàng</span><input id="returnFee" class="num-input" value="0" inputmode="numeric" oninput="handleNumInput(this, renderTotals)"></div>
      <div id="pickupFeeNote" class="fee-note">Phí lấy hàng do cửa hàng trả, không trừ vào tiền trả khách.</div>
      <div class="return-section">
