    function applyInvoicePayload(payload) {
      if (!payload || !payload.invoice) throw new Error('Không có dữ liệu hóa đơn');
      selectedInvoice = payload.invoice;
      if (payload.return_multi_lot_note) alert(payload.return_multi_lot_note);
      returnItems = mapReturnItemsFromInvoiceLines(payload.items);
      const sellerNameEl = $('sellerName');
      const customerNameEl = $('customerName');
