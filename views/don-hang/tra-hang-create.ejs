          ten_lo: lot.ten_lo || '',
          ngay_nhap: lot.ngay_nhap || '',
          han_su_dung: lot.han_su_dung || '',
          ton_kho: Number(lot.ton_kho || lot.ton_hien_tai || 0),
          ton_hien_tai: Number(lot.ton_hien_tai || lot.ton_kho || 0),
          ton_thuc_te: lot.ton_thuc_te !== undefined ? Number(lot.ton_thuc_te || 0) : undefined,
          so_luong_khach_dat: lot.so_luong_khach_dat ?? lot.khach_dat ?? lot.da_dat ?? undefined,
          so_luong_kha_dung: lot.so_luong_kha_dung ?? lot.kha_dung ?? undefined
        })),
        ten_ncc: row.ten_ncc || '',
        ma_ncc: row.ma_ncc || ''
      };
    }
    function clearSwapProductState(clearItems = true) {
      swapAvailableProducts = [];
      swapStockByProduct.clear();
      expandedSwapLotKeyByItem = {};
      if (clearItems) swapItems = [];
      const swapSearchEl = $('swapSearch');
      const swapResultsEl = $('swapResults');
      if (swapSearchEl) swapSearchEl.value = '';
      if (swapResultsEl) {
        swapResultsEl.innerHTML = '';
        swapResultsEl.style.display = 'none';
      }
      if (clearItems) renderSwapItems();
