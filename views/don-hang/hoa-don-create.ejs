        const datePart = [lot.ngay_nhap ? `Ngày lô ${formatDateVi(lot.ngay_nhap)}` : '', lot.han_su_dung ? `HSD ${formatDateVi(lot.han_su_dung)}` : ''].filter(Boolean).join(' - ') || '—';
        return { ton, khaDung, dat, datePart };
