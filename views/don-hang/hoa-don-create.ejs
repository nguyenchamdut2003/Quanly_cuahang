              <div class="middle-payment-row"><span>Khách đã trả</span><strong id="customerPaid">0 VNĐ</strong></div>
              <div class="middle-payment-row middle-payment-total"><span id="remainingTotalLabel">Còn phải thu</span><strong id="remainingTotal">0 VNĐ</strong></div>
            </div>
