          items: cart.map(item => ({
            hang_hoa_id: item.hang_hoa_id,
            ct_don_hang_id: item.ct_don_hang_id || '',
            lo_hang_id: item.lo_hang_id || '',
            gia_tri_thuoc_tinh_id: item.gia_tri_thuoc_tinh_id || '',
            ten_quy_cach: item.ten_quy_cach || item.ten_thuoc_tinh || '',
            ten_thuoc_tinh: item.ten_thuoc_tinh || item.ten_quy_cach || '',
            don_vi_tinh_id: item.don_vi_tinh_id || '',
            so_luong: lineQty(item),
            don_gia_ban: item.don_gia_ban,
            chiet_khau: item.chiet_khau || 0,
            kieu_chiet_khau: item.kieu_chiet_khau || 'vnd',
            ma_hang_snapshot: item.ma_hang_snapshot || item.ma_hang || '',
            ten_hang_snapshot: item.ten_hang_snapshot || item.ten_hang || '',
            don_vi_tinh_snapshot: item.don_vi_tinh_snapshot || '',
            ghi_chu: item.ghi_chu || '',
            quy_cach_items: (item.has_quy_cach || item.has_lot_items)
              ? (item.has_quy_cach ? (item.quy_cach_items || []) : (item.lot_items || []))
                  .filter(qc => Number(qc.so_luong_dat || qc.so_luong || 0) > 0)
                  .map(qc => ({
                    lo_hang_id: qc.lo_hang_id || '',
                    gia_tri_thuoc_tinh_id: qc.gia_tri_thuoc_tinh_id || '',
                    ten_quy_cach: qc.ten_quy_cach || qc.ten_thuoc_tinh || '',
                    ten_thuoc_tinh: qc.ten_thuoc_tinh || qc.ten_quy_cach || '',
                    so_luong: Number(qc.so_luong_dat || qc.so_luong || 0),
                    don_gia_ban: Number(qc.don_gia_ban ?? item.don_gia_ban ?? 0),
                    loai_gia_ban: qc.loai_gia_ban || '',
                    chiet_khau: Number(qc.chiet_khau || 0),
                    kieu_chiet_khau: qc.kieu_chiet_khau || 'vnd'
                  }))
              : []
          })),
          chiet_khau: num(discount.value),
          kieu_giam_gia: orderDiscountType.value,
          phi_van_chuyen: num(shippingFee.value),
          diem_di: getShippingStartPoint(),
          diem_den: shippingAddress,
          khoang_cach_km: 0,
          ghi_chu: '',
          doi_tac_giao_hang_id: partnerId.value,
          dia_chi_khach_hang_id: getRecipientAddressId(),
          nguoi_tra_phi_giao_hang: shippingFeePayer.value,
          ten_nguoi_nhan: recipientCustomer ? recipientCustomer.ten_khach_hang : '',
          sdt_nguoi_nhan: recipientPhone.value,
          dia_chi_nhan: shippingAddress,
          ghi_chu_giao_hang: noteInput ? noteInput.value : '',
          thu_ho_cod: false,
          cod_enabled: false,
          cod_amount: 0,
          vat_chua_id: invoiceVatChuaId ? invoiceVatChuaId.value : '',
          vat_chua_so_luong: invoiceVatChuaQty ? invoiceVatChuaQty.value : '',
          ...paymentFields
        };
        try {
          if (payButton) {
            payButton.disabled = true;
            payButton.textContent = 'ĐANG TẠO...';
          }
          const res = await fetch('/don-hang/hoa-don/create', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) });
          const text = await res.text();
          let result = {};
          try {
            result = text ? JSON.parse(text) : {};
          } catch (_) {
            result = { success: false, message: text || 'Máy chủ trả về dữ liệu không hợp lệ' };
          }
          if (!result.success) return alert(result.message || 'Không tạo được hóa đơn');
          window.location.href = '/don-hang/hoa-don';
        } catch (err) {
          alert(err.message || 'Lỗi khi tạo hóa đơn');
        } finally {
          if (payButton) {
            payButton.disabled = false;
            payButton.textContent = 'THANH TOÁN';
          }
        }
      }
      async function prefillFromCopyInvoice() {
        if (!sourceInvoice || sourceOrder) return;
        if (!sourceInvoiceItems.length) return;
        const khoId = String(sourceInvoice.kho_id?._id || sourceInvoice.kho_id || '');
        renderCurrentStore();
        if (khoId && document.querySelector(`#khoId option[value="${khoId}"]`)) {
          document.getElementById('khoId').value = khoId;
          await loadStockByWarehouse();
          previousKhoId = khoId;
        }
        discount.value = sourceInvoice.giam_gia || 0;
        orderDiscountType.value = 'vnd';
        const customerIdValue = String(sourceInvoice.khach_hang_id?._id || sourceInvoice.khach_hang_id || '');
        if (customerIdValue) fillRecipientFromCustomer(customers.find(x => x._id === customerIdValue));
        if (sourceInvoiceShipment) {
          if (sourceInvoiceShipment.dia_chi_khach_hang_id) {
            document.getElementById('recipientAddressId').value = String(sourceInvoiceShipment.dia_chi_khach_hang_id);
          }
          recipientPhone.value = sourceInvoiceShipment.sdt_nguoi_nhan || recipientPhone.value;
          if (sourceInvoiceShipment.dia_chi_nhan) recipientAddress.value = sourceInvoiceShipment.dia_chi_nhan;
          shippingFee.value = fmt(sourceInvoiceShipment.phi_giao_hang || 0);
          if (sourceInvoiceShipment.nguoi_tra_phi_giao_hang) shippingFeePayer.value = sourceInvoiceShipment.nguoi_tra_phi_giao_hang;
          selectPartnerIfExists(String(sourceInvoiceShipment.doi_tac_giao_hang_id || ''));
        }
        const noteInput = document.getElementById('deliveryNote');
        if (noteInput && sourceInvoice.ghi_chu) noteInput.value = sourceInvoice.ghi_chu;
        cart = sourceInvoiceItems.map(item => ({
          ...item,
          so_luong: Number(item.so_luong || 0),
          ton_kho: stockFor(item.hang_hoa_id),
          don_gia_ban: Number(item.don_gia_ban || 0),
          chiet_khau: Number(item.chiet_khau || 0),
          kieu_chiet_khau: item.kieu_chiet_khau || 'vnd'
        }));
        renderCart();
      }
      async function prefillFromSourceOrder() {
        if (!sourceOrder) return;
        alert('Hóa đơn từ đơn hàng được tạo khi xác nhận giao. Vui lòng quay lại đơn hàng và bấm Xác nhận giao.');
        const payButton = document.getElementById('payButton');
        if (payButton) payButton.disabled = true;
        if (existingInvoice) {
          alert('Đơn hàng này đã có hóa đơn ' + (existingInvoice.ma_hoa_don || ''));
          if (payButton) payButton.disabled = true;
        }
        productSearch.disabled = true;
        discount.disabled = true;
        orderDiscountType.disabled = true;
        const khoId = String(sourceOrder.kho_id?._id || sourceOrder.kho_id || '');
        renderCurrentStore();
        if (khoId && document.querySelector(`#khoId option[value="${khoId}"]`)) {
          document.getElementById('khoId').value = khoId;
          await loadStockByWarehouse();
          previousKhoId = khoId;
          document.getElementById('khoId').disabled = true;
        } else if (khoId) {
          alert('Kho của đơn hàng không thuộc cửa hàng đang làm việc. Vui lòng chọn cửa hàng phù hợp ở menu trên.');
        }
        const customerIdValue = String(sourceOrder.khach_hang_id?._id || sourceOrder.khach_hang_id || '');
        if (customerIdValue) fillRecipientFromCustomer(customers.find(x => x._id === customerIdValue));
        if (sourceShipment) {
          if (sourceShipment.dia_chi_khach_hang_id) {
            document.getElementById('recipientAddressId').value = String(sourceShipment.dia_chi_khach_hang_id);
          }
          recipientPhone.value = sourceShipment.sdt_nguoi_nhan || recipientPhone.value;
          if (sourceShipment.dia_chi_nhan) recipientAddress.value = sourceShipment.dia_chi_nhan;
          shippingFee.value = fmt(sourceShipment.phi_giao_hang || 0);
          if (sourceShipment.nguoi_tra_phi_giao_hang) shippingFeePayer.value = sourceShipment.nguoi_tra_phi_giao_hang;
          selectPartnerIfExists(String(sourceShipment.doi_tac_giao_hang_id || ''));
        }
        discount.value = sourceOrder.giam_gia || 0;
        orderDiscountType.value = sourceOrder.kieu_giam_gia || 'vnd';
        if (sourceOrder.khach_thanh_toan !== undefined && sourceOrder.khach_thanh_toan !== null) {
          cashCustomerGiven.value = fmt(sourceOrder.khach_thanh_toan || 0);
          transferCustomerGiven.value = '0';
          changeReturnedToCustomer.value = '0';
        }
        cart = sourceOrderItems.map(item => ({
          ...item,
          so_luong: Number(item.so_luong || 0),
          ton_kho: stockFor(item.hang_hoa_id),
          don_gia_ban: Number(item.don_gia_ban || 0),
          chiet_khau: Number(item.chiet_khau || 0),
          kieu_chiet_khau: item.kieu_chiet_khau || 'vnd'
        }));
        renderCart();
      }
      function selectPartnerIfExists(id) {
        if (!id) return;
        const option = document.querySelector(`.partner-option[data-partner-id="${id}"]`);
        if (option) selectPartner(id, option.textContent.trim());
      }
      document.addEventListener('DOMContentLoaded', async () => {
        if (copyFromError) alert(copyFromError);
        const invoiceDateInput = document.getElementById('invoiceDate');
        if (invoiceDateInput && !invoiceDateInput.value) invoiceDateInput.value = formatDateTimeLocal(new Date());
        renderCurrentStore();
        handleShippingFeePayerChange();
        document.getElementById('khoId').addEventListener('change', handleWarehouseChange);
        if (cashBookId) cashBookId.addEventListener('change', () => cashBookId.classList.remove('field-invalid'));
        if (bankBookId) bankBookId.addEventListener('change', () => bankBookId.classList.remove('field-invalid'));
        if (!sourceOrder) await loadKhoByStore();
        await loadPaymentCashBooks();
        await prefillFromSourceOrder();
        await prefillFromCopyInvoice();
        renderPaymentSummary();
      });
      function hideQtyWarningTooltip() {
        if (!qtyWarningTooltip) return;
        qtyWarningTooltip.classList.remove('is-visible');
        qtyWarningTooltip.setAttribute('aria-hidden', 'true');
      }
      function showQtyWarningTooltip(target) {
        if (!qtyWarningTooltip || !target) return;
        const message = target.getAttribute('data-warning-message') || '';
        if (!message) return;
        if (qtyWarningHideTimer) {
          clearTimeout(qtyWarningHideTimer);
          qtyWarningHideTimer = null;
        }
        qtyWarningTooltip.textContent = message;
        const rect = target.getBoundingClientRect();
        qtyWarningTooltip.style.left = '0px';
        qtyWarningTooltip.style.top = '0px';
        qtyWarningTooltip.classList.add('is-visible');
        qtyWarningTooltip.setAttribute('aria-hidden', 'false');
        const tipRect = qtyWarningTooltip.getBoundingClientRect();
        const left = Math.max(8, Math.min(rect.left + rect.width / 2 - tipRect.width / 2, window.innerWidth - tipRect.width - 8));
        const top = Math.max(8, rect.top - tipRect.height - 8);
        qtyWarningTooltip.style.left = `${left}px`;
        qtyWarningTooltip.style.top = `${top}px`;
      }
      document.addEventListener('mouseover', function(event) {
        const icon = event.target.closest('.js-warning-icon');
        if (!icon) return;
        showQtyWarningTooltip(icon);
      });
      document.addEventListener('mouseout', function(event) {
        const icon = event.target.closest('.js-warning-icon');
        if (!icon) return;
        if (qtyWarningHideTimer) clearTimeout(qtyWarningHideTimer);
        qtyWarningHideTimer = setTimeout(hideQtyWarningTooltip, 2000);
      });
      window.addEventListener('scroll', hideQtyWarningTooltip, true);
      window.addEventListener('resize', hideQtyWarningTooltip);
      document.addEventListener('click', e => { if (!partnerPicker.contains(e.target)) partnerPicker.classList.remove('open'); });
    </script>
</body>

</html>
