<!DOCTYPE html>
<html>

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>
    <%= title %>
  </title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/stylesheets/style.css">
  <link rel="stylesheet" href="/stylesheets/responsive.css">
  <style>
    body {
      overflow: hidden;
      background: #e9edf2
    }

    .order-create {
      height: calc(100vh - 98px);
      display: grid;
      grid-template-columns: minmax(0, 52fr) minmax(330px, 28fr) minmax(230px, 20fr);
      gap: 10px;
      padding: 12px 10px 0
    }

    .left,
    .middle,
    .right {
      background: #fff;
      border-radius: 8px;
      display: flex;
      flex-direction: column;
      overflow: hidden
    }

    .left {
      background: #e9edf2;
      min-height: 0
    }

    .top-search {
      height: 38px;
      position: relative;
      margin-bottom: 10px
    }

    .top-search i {
      position: absolute;
      left: 12px;
      top: 50%;
      transform: translateY(-50%);
      color: #667085
    }

    .top-search input {
      width: 460px;
      max-width: 100%;
      height: 38px;
      border: 1px solid #d0d7de;
      border-radius: 6px;
      padding: 0 12px 0 36px;
      font-size: 14px
    }

    .search-results {
      display: none;
      position: absolute;
      top: 42px;
      left: 0;
      width: 460px;
      background: #fff;
      border: 1px solid #cfd8e3;
      border-radius: 6px;
      box-shadow: 0 8px 22px rgba(0, 0, 0, .14);
      z-index: 50;
      max-height: 300px;
      overflow: auto
    }

    .search-item {
      height: 42px;
      padding: 0 12px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 13px;
      cursor: pointer
    }

    .search-item:hover {
      background: #f0f7ff
    }

    .search-item.product-search-item {
      height: auto;
      min-height: 52px;
      padding: 7px 12px;
      gap: 12px
    }

    .search-item-info {
      min-width: 0
    }

    .search-item-main {
      display: block;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis
    }

    .search-item-meta {
      display: block;
      margin-top: 3px;
      color: #667085;
      font-size: 12px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis
    }

    .search-item-price {
      flex: 0 0 auto
    }

    .cart-area {
      flex: 1;
      min-height: 0;
      overflow-x: auto;
      overflow-y: auto;
      background: #e9edf2
    }

    .summary-card {
      flex: 0 0 auto;
      min-height: 168px;
      background: #fff;
      border-radius: 8px;
      padding: 18px 26px;
      display: grid;
      grid-template-columns: 1fr 430px;
      gap: 20px;
      align-items: start
    }

    .note-line {
      color: #667085;
      font-size: 14px
    }

    .totals {
      font-size: 16px
    }

    .total-line {
      display: flex;
      justify-content: space-between;
      margin-bottom: 14px
    }

    .total-line strong {
      font-weight: 800
    }

    .payment-input,
    .payment-select {
      height: 32px;
      border: 1px solid #cfd8e3;
      border-radius: 6px;
      padding: 0 10px;
      font-size: 14px;
      background: #fff;
      text-align: right;
    }

    .payment-select {
      text-align: left;
    }

    .middle-payment {
      margin-top: 18px;
      padding-top: 16px;
      border-top: 1px solid #d7dde5;
    }

    .middle-payment-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      margin-bottom: 12px;
      color: #667085;
      font-size: 15px;
      font-weight: 700;
    }

    .middle-payment-row .payment-input,
    .middle-payment-row .payment-select {
      width: 180px;
    }

    .middle-payment-total {
      color: #0b172a;
      font-size: 20px;
      font-weight: 800;
    }

    .payment-title {
      font-size: 12px;
      font-weight: 800;
      color: #344054;
      text-transform: uppercase;
      letter-spacing: .02em;
      margin-bottom: 4px;
    }

    .middle-payment-row .payment-select.field-invalid,
    .middle-payment-row .payment-input.field-invalid {
      border-color: #d92d20;
      box-shadow: 0 0 0 1px #fda29b;
    }

    .required-mark {
      color: #d92d20;
    }

    .money-input-wrap {
      display: inline-flex;
      align-items: center;
      justify-content: flex-end;
      gap: 6px;
      white-space: nowrap;
    }

    .money-input-wrap .delivery-input {
      flex: 1;
    }

    .money-unit {
      color: #667085;
      font-weight: 700;
      font-size: 13px;
    }

    .btn-pay-all {
      height: 28px;
      border: 1px solid #0070f4;
      background: #fff;
      color: #0070f4;
      border-radius: 6px;
      padding: 0 8px;
      font-size: 12px;
      font-weight: 700;
      cursor: pointer;
      white-space: nowrap;
    }

    .payable {
      color: #006dff;
      font-size: 22px
    }

    .cart-table {
      width: 100%;
      border-collapse: collapse;
      background: #fff;
      border-radius: 8px;
      overflow: hidden
    }

    .cart-table th {
      height: 36px;
      background: #e8f3ff;
      text-align: left;
      padding: 0 10px;
      border-bottom: 1px solid #bcd9ff;
      position: sticky;
      top: 0;
      z-index: 2
    }

    .cart-table td {
      height: 40px;
      border-bottom: 1px solid #e5e9ee;
      padding: 0 10px
    }

    .num {
      text-align: right
    }

    .small {
      width: 74px;
      height: 28px;
      border: 1px solid #cfd8e3;
      border-radius: 5px;
      text-align: right;
      padding: 0 6px
    }

    .discount-pair {
      display: inline-flex;
      gap: 6px;
      align-items: center;
      justify-content: flex-end;
    }

    .discount-pair select {
      width: 70px;
      height: 28px;
      border: 1px solid #cfd8e3;
      border-radius: 5px;
      background: #fff;
    }

    .stock-text {
      display: block;
      margin-top: 3px;
      color: #667085;
      font-size: 12px;
    }

    .availability-warning {
      margin-top: 6px;
      padding: 6px 8px;
      border-radius: 6px;
      font-size: 12px;
      line-height: 1.35;
      text-align: left;
    }

    .availability-warning.warn {
      background: #fff7d6;
      color: #8a5a00;
      border: 1px solid #f5d46a;
    }

    .availability-warning.danger {
      background: #fff1f0;
      color: #b42318;
      border: 1px solid #fda29b;
    }

    .qty-input-wrap {
      display: inline-flex;
      align-items: center;
      justify-content: flex-end;
      gap: 6px;
      min-height: 28px;
    }

    .qty-warning-input.is-warn {
      border-color: #f5d46a !important;
      box-shadow: inset 0 0 0 1px rgba(245, 212, 106, 0.35);
    }

    .qty-warning-input.is-danger {
      border-color: #fda29b !important;
      box-shadow: inset 0 0 0 1px rgba(253, 162, 155, 0.35);
    }

    .warning-icon-trigger {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 16px;
      height: 16px;
      color: #b54708;
      cursor: help;
      user-select: none;
      font-size: 12px;
      line-height: 1;
      border-radius: 50%;
    }

    .warning-icon-trigger.is-danger {
      color: #b42318;
    }

    .qty-warning-tooltip {
      position: fixed;
      z-index: 1200;
      max-width: 300px;
      padding: 8px 10px;
      border-radius: 6px;
      background: #111827;
      color: #fff;
      font-size: 12px;
      line-height: 1.35;
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.28);
      opacity: 0;
      pointer-events: none;
      transform: translateY(4px);
      transition: opacity 0.16s ease, transform 0.16s ease;
    }

    .qty-warning-tooltip.is-visible {
      opacity: 1;
      transform: translateY(0);
    }

    .qc-row td {
      height: auto;
      padding: 0 10px 10px 86px;
      background: #fbfdff;
    }

    .qc-table {
      width: 100%;
      border-collapse: collapse;
      border: 1px solid #dbe7f5;
      background: #fff;
    }

    .qc-table th,
    .qc-table td {
      height: 32px;
      padding: 0 8px;
      border-bottom: 1px solid #edf2f7;
      font-size: 13px;
    }

    .qc-table th {
      background: #f2f8ff;
      font-weight: 700;
    }

    .qc-input {
      width: 74px;
      height: 26px;
      border: 1px solid #cfd8e3;
      border-radius: 5px;
      text-align: right;
      padding: 0 6px;
    }

    .lot-cell {
      min-width: 88px;
      cursor: pointer;
      vertical-align: middle;
      transition: background .15s;
    }

    .lot-cell:hover {
      background: #eef6ff;
    }

    .lot-cell.is-active {
      background: #dbeafe;
      box-shadow: inset 0 0 0 2px #3b82f6;
    }

    .lot-cell-empty {
      cursor: default;
      background: #fafbfc;
    }

    .lot-cell-main {
      font-weight: 700;
      font-size: 13px;
      line-height: 1.3;
    }

    .lot-cell-sub {
      margin-top: 2px;
      color: #667085;
      font-size: 11px;
      line-height: 1.25;
      text-align: right;
    }

    .lot-inline-normal {
      padding: 6px 10px !important;
      height: auto !important;
    }

    .lot-inline-normal .inline-detail-grid {
      display: grid;
      grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: 8px;
      align-items: center;
      font-size: 13px;
    }

    .lot-inline-normal .inline-detail-grid .inline-label {
      color: #667085;
      font-size: 11px;
      margin-bottom: 2px;
    }

    .middle {
      padding: 12px 18px;
      overflow-x: hidden;
      overflow-y: auto;
      min-height: 0;
    }

    .mid-head {
      height: 32px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 8px
    }

    .invoice-date-row {
      margin: 0 0 12px 32px;
      display: grid;
      grid-template-columns: 92px minmax(0, 1fr);
      gap: 10px;
      align-items: center;
      color: #667085;
      font-size: 13px;
      font-weight: 700;
    }

    .invoice-date-row .line-input {
      width: 100%;
    }

    .customer-search {
      position: relative;
      margin-bottom: 16px
    }

    .customer-search input {
      width: 100%;
      height: 38px;
      border: 0;
      background: #f0f2f5;
      border-radius: 5px;
      padding: 0 42px 0 32px;
      font-size: 16px
    }

    .customer-search i {
      position: absolute;
      left: 10px;
      top: 50%;
      transform: translateY(-50%);
      color: #667085
    }

    .customer-search button {
      position: absolute;
      right: 8px;
      top: 5px;
      border: 0;
      background: transparent;
      font-size: 24px;
      cursor: pointer
    }

    .section-line {
      display: grid;
      grid-template-columns: 22px 1fr;
      gap: 10px;
      margin-bottom: 12px
    }

    .marker {
      display: flex;
      justify-content: center;
      color: #0070f4;
      font-size: 20px
    }

    .marker.green {
      color: #00a651
    }

    .line-input {
      height: 34px;
      border: 1px solid #cfd8e3;
      border-radius: 6px;
      background: #fff;
      padding: 0 10px;
      font-size: 14px;
      outline: none;
      width: 100%;
    }

    .two {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px
    }

    .middle .section-line>div:last-child {
      display: grid;
      gap: 10px;
    }

    .middle .line-input {
      margin-top: 0 !important;
    }

    .middle select.line-input {
      appearance: none;
      background-image: linear-gradient(45deg, transparent 50%, #475467 50%), linear-gradient(135deg, #475467 50%, transparent 50%);
      background-position: calc(100% - 16px) 14px, calc(100% - 10px) 14px;
      background-size: 5px 5px, 5px 5px;
      background-repeat: no-repeat;
      padding-right: 30px;
    }

    .muted-red {
      font-size: 12px;
      color: #344054;
    }

    #pickupInfo {
      min-height: 34px;
      border: 1px solid #cfd8e3;
      border-radius: 6px;
      background: #fff;
      padding: 7px 10px;
      display: flex;
      align-items: center;
      line-height: 1.25;
      font-size: 13px;
    }

    #pickupInfo:empty {
      display: none;
    }

    .package {
      border-top: 1px solid #edf0f3;
      padding-top: 12px;
      margin-top: 12px
    }

    .package-title {
      font-size: 16px;
      margin-bottom: 10px
    }

    .pkg-grid {
      display: grid;
      grid-template-columns: 70px 84px 1fr;
      gap: 12px;
      align-items: center
    }

    .pkg-input {
      height: 30px;
      border: 0;
      border-bottom: 1px solid #c2cad3;
      text-align: center
    }

    .cod {
      margin-top: auto;
      border-top: 1px solid #edf0f3;
      padding-top: 14px
    }

    .cod-row {
      display: flex;
      justify-content: space-between;
      gap: 16px;
      margin-top: 12px;
      color: #667085;
    }

    .cod-row strong {
      color: #111827;
    }

    .toggle {
      display: inline-block;
      width: 42px;
      height: 20px;
      background: #9aa4b2;
      border-radius: 999px;
      vertical-align: middle;
      margin-left: 10px;
      position: relative;
      cursor: pointer;
      transition: .2s
    }

    .toggle:before {
      content: '';
      position: absolute;
      width: 18px;
      height: 18px;
      left: 1px;
      top: 1px;
      background: #fff;
      border-radius: 50%;
      box-shadow: 0 1px 4px rgba(0, 0, 0, .25);
      transition: .2s
    }

    .toggle.on {
      background: #0070f4
    }

    .toggle.on:before {
      transform: translateX(22px)
    }

    .right {
      padding: 0
    }

    .tabs {
      height: 38px;
      display: grid;
      grid-template-columns: 1fr;
      border-bottom: 1px solid #d7dde5
    }

    .tab {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      font-weight: 700;
      color: #0070f4;
      border-bottom: 2px solid #0070f4
    }

    .right-body {
      padding: 16px 14px
    }

    .delivery-row {
      display: flex;
      flex-direction: column;
      gap: 6px;
      margin-bottom: 14px
    }

    .delivery-row label {
      font-size: 12px;
      font-weight: 800;
      color: #344054
    }

    .delivery-input {
      width: 100%;
      height: 34px;
      border: 1px solid #cfd8e3;
      border-radius: 6px;
      padding: 0 10px;
      font-size: 13px;
      background: #fff;
    }

    .delivery-help {
      min-height: 18px;
      color: #667085;
      font-size: 11px;
    }

    .delivery-vat-chua-combo {
      display: flex;
      gap: 8px;
      align-items: center
    }

    .delivery-vat-chua-combo .delivery-input {
      flex: 1;
      min-width: 0
    }

    .delivery-vat-chua-qty {
      width: 88px;
      flex: 0 0 88px;
      text-align: right
    }

    .partner-picker {
      position: relative
    }

    .partner-trigger {
      width: 100%;
      min-height: 34px;
      border: 1px solid #cfd8e3;
      border-radius: 7px;
      background: #fff;
      color: #344054;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      padding: 0 9px;
      font-size: 13px;
      cursor: pointer
    }

    .partner-trigger.empty {
      color: #667085
    }

    .partner-menu {
      display: none;
      position: absolute;
      top: calc(100% + 4px);
      left: 0;
      right: 0;
      max-height: 230px;
      overflow: auto;
      background: #fff;
      border: 1px solid #cfd8e3;
      border-radius: 8px;
      box-shadow: 0 12px 26px rgba(0, 0, 0, .16);
      z-index: 80;
      padding: 6px
    }

    .partner-picker.open .partner-menu {
      display: block
    }

    .partner-option {
      min-height: 34px;
      display: flex;
      align-items: center;
      padding: 0 9px;
      border-radius: 6px;
      font-size: 13px;
      color: #344054;
      cursor: pointer
    }

    .partner-option:hover,
    .partner-option.active {
      background: #eef6ff;
      color: #006dff;
      font-weight: 800
    }

    .place-order {
      margin-top: auto;
      padding: 12px
    }

    .place-order button {
      width: 100%;
      height: 52px;
      border: 0;
      border-radius: 9px;
      background: #0070f4;
      color: #fff;
      font-size: 18px;
      font-weight: 800;
      cursor: pointer
    }
  </style>
</head>

<body>
  <%- include('../partials/header') %>
    <main class="order-create">
      <section class="left">
        <div class="top-search"><i class="fa-solid fa-magnifying-glass"></i><input id="productSearch"
            placeholder="Tìm hàng hóa (F3)">
          <div id="productResults" class="search-results"></div>
        </div>
        <div class="cart-area">
          <table class="cart-table">
            <thead id="cartHead">
              <tr>
                <th>STT</th>
                <th>Mã hàng</th>
                <th>Tên hàng</th>
                <th class="num">SL</th>
                <th class="num">Tồn</th>
                <th class="num" title="Số lượng đang được các đơn đặt hàng khác giữ nhưng chưa giao đủ.">Khách khác đã đặt</th>
                <th class="num" title="Khả dụng = Tồn thực tế - Khách khác đã đặt.">Khả dụng</th>
                <th class="num">Đơn giá</th>
                <th class="num">Giảm giá</th>
                <th class="num">Thành tiền</th>
                <th></th>
              </tr>
            </thead>
            <tbody id="cartBody"></tbody>
          </table>
        </div>
        <div class="summary-card">
          <div class="note-line"><i class="fa-solid fa-pen"></i> Ghi chú hóa đơn</div>
          <div class="totals">
            <div class="total-line"><span>Tổng tiền hàng</span><span id="subtotal">0 VNĐ</span></div>
            <div class="total-line"><span>Giảm giá</span>
              <span class="discount-pair"><input id="discount" class="small" value="0" oninput="renderCart()"><select
                  id="orderDiscountType" onchange="renderCart()">
                  <option value="vnd">VNĐ</option>
                  <option value="phan_tram">%</option>
                </select></span>
            </div>
            <div class="total-line"><strong>Tổng cộng dự kiến</strong><strong class="payable" id="grandTotal">0 VNĐ</strong>
            </div>
          </div>
        </div>
      </section>
      <section class="middle">
        <div class="mid-head"><strong id="storeName"><%= currentStore?.ten_cua_hang || 'Cửa hàng' %></strong><span>
            <%= new Date().toLocaleString('vi-VN', { day:'2-digit', month:'2-digit', year:'numeric', hour:'2-digit',
              minute:'2-digit' }) %>
          </span></div>
        <div class="invoice-date-row">
          <label for="invoiceDate">Ng&#224;y h&#243;a &#273;&#417;n</label>
          <input id="invoiceDate" class="line-input" type="datetime-local">
        </div>
        <input type="hidden" id="customerId">
        <input type="hidden" id="storeId" value="<%= currentStoreId || '' %>">
        <div class="section-line">
          <div class="marker"><i class="fa-solid fa-circle-dot"></i></div>
          <div>
            <div class="muted-red" id="pickupInfo"><% if (!currentStoreId) { %>Chưa chọn cửa hàng. Vui lòng chọn cửa hàng ở menu góc trên phải.<% } %></div>
            <select id="khoId" class="line-input" style="width:100%;margin-top:12px"<%= !currentStoreId ? ' disabled' : '' %>>
              <option value=""><%= (warehouses || []).length ? 'Chọn kho' : (currentStoreId ? 'Chưa có kho cho cửa hàng này' : 'Chưa chọn cửa hàng') %></option>
              <% (warehouses || []).forEach(function(w) { %>
                <option value="<%= w._id %>" data-address="<%= (w.dia_chi_day_du || w.dia_chi || '').replace(/"/g, '&quot;') %>"><%= w.ten_kho %></option>
              <% }) %>
            </select>
          </div>
        </div>
        <div class="section-line">
          <div class="marker green"><i class="fa-solid fa-location-dot"></i></div>
          <div>
            <div class="two"><select id="recipientCustomerId" class="line-input" onchange="selectRecipientCustomer(this.value)">
                <option value="">Chọn khách hàng nhận</option>
                <% customers.forEach(c=> {
                  const defaultAddress = (c.dia_chi_list || []).find(a => a.mac_dinh) || (c.dia_chi_list || [])[0] || {};
                  const optionPhone = c.sdt || c.sdt2 || '';
                  const optionAddress = defaultAddress.dia_chi_day_du || defaultAddress.dia_chi_chi_tiet || c.dia_chi_day_du || c.dia_chi_nhan || '';
                  const optionAddressId = defaultAddress._id || '';
                  const optionArea = defaultAddress.tinh_thanh || c.tinh_thanh || '';
                  const optionWard = defaultAddress.phuong_xa || c.phuong_xa || '';
                %><option value="<%= c._id %>" data-name="<%= c.ten_khach_hang || '' %>" data-phone="<%= optionPhone %>" data-address="<%= optionAddress %>" data-address-id="<%= optionAddressId %>" data-area="<%= optionArea %>" data-ward="<%= optionWard %>">
