              <div class="middle-payment-row"><span>Tiền mặt</span><span class="money-input-wrap"><input id="cashCustomerGiven" class="payment-input" value="0" inputmode="numeric" oninput="handleCustomerPaymentInput(this, 'cash')"><span class="money-unit">VNĐ</span><button type="button" class="btn-pay-all" onclick="fillOrderPaymentAll('cash')">Tất cả</button></span></div>
              <div class="middle-payment-row"><span>Sổ tiền mặt <span id="cashBookRequiredMark" class="required-mark" style="display:none">*</span></span>
                <select id="cashBookId" class="payment-select" disabled>
