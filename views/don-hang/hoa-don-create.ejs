<!DOCTYPE html>
<html lang="vi">

<head>
  <meta charset="UTF-8">
  <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
  <title>
    <%= title %>
  </title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/stylesheets/style.css">
  <style>
    body {
      overflow: hidden;
      background: #e9edf2;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, "Noto Sans", sans-serif;
      -webkit-font-smoothing: antialiased;
    }

    .order-create,
    .order-create input,
    .order-create select,
    .order-create button,
    .order-create table {
      font-family: inherit;
    }

    .order-create {
      height: calc(100vh - 98px);
      display: grid;
      grid-template-columns: minmax(0, 52fr) minmax(330px, 28fr) minmax(230px, 20fr);
      gap: 10px;
      padding: 12px 10px 0
    }

    .left,
    .middle,
    .right {
      background: #fff;
      border-radius: 8px;
      display: flex;
      flex-direction: column;
      overflow: hidden
    }

    .left {
      background: #e9edf2
    }

    .top-search {
      height: 38px;
      position: relative;
      margin-bottom: 10px
    }

    .top-search i {
      position: absolute;
      left: 12px;
      top: 50%;
      transform: translateY(-50%);
      color: #667085
    }

    .top-search input {
      width: 460px;
      max-width: 100%;
      height: 38px;
      border: 1px solid #d0d7de;
      border-radius: 6px;
      padding: 0 12px 0 36px;
      font-size: 14px
    }

    .search-results {
      display: none;
      position: absolute;
      top: 42px;
      left: 0;
      width: 460px;
      background: #fff;
      border: 1px solid #cfd8e3;
      border-radius: 6px;
      box-shadow: 0 8px 22px rgba(0, 0, 0, .14);
      z-index: 50;
      max-height: 300px;
      overflow: auto
    }

    .search-item {
      height: 42px;
      padding: 0 12px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 13px;
      cursor: pointer
    }

    .search-item:hover {
      background: #f0f7ff
    }

    .search-item.product-search-item {
      height: auto;
      min-height: 52px;
      padding: 7px 12px;
      gap: 12px
    }

    .search-item-info {
      min-width: 0
    }

    .search-item-main {
      display: block;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis
    }

    .search-item-meta {
      display: block;
      margin-top: 3px;
      color: #667085;
      font-size: 12px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis
    }

    .search-item-price {
      flex: 0 0 auto
    }

    .cart-area {
      flex: 1;
      background: #e9edf2
    }

    .summary-card {
      min-height: 168px;
      background: #fff;
      border-radius: 8px;
      padding: 18px 26px;
      display: grid;
      grid-template-columns: 1fr 430px;
      gap: 20px;
      align-items: start
    }

    .note-line {
      color: #667085;
      font-size: 14px
    }

    .totals {
      font-size: 16px
    }

    .total-line {
      display: flex;
      justify-content: space-between;
      margin-bottom: 14px
    }

    .total-line strong {
      font-weight: 800
    }

    .payable {
      color: #006dff;
      font-size: 22px
    }

    .cart-table {
      width: 100%;
      border-collapse: collapse;
      background: #fff;
      border-radius: 8px;
      overflow: hidden
    }

    .cart-table th {
      height: 36px;
      background: #e8f3ff;
      text-align: left;
      padding: 0 10px;
      border-bottom: 1px solid #bcd9ff
    }

    .cart-table td {
      height: 40px;
      border-bottom: 1px solid #e5e9ee;
      padding: 0 10px
    }

    .num {
      text-align: right
    }

    .small {
      width: 74px;
      height: 28px;
      border: 1px solid #cfd8e3;
      border-radius: 5px;
      text-align: right;
      padding: 0 6px
    }

    .discount-pair {
      display: inline-flex;
      gap: 6px;
      align-items: center;
      justify-content: flex-end;
    }

    .discount-pair select {
      width: 70px;
      height: 28px;
      border: 1px solid #cfd8e3;
      border-radius: 5px;
      background: #fff;
    }

    .stock-text {
      display: block;
      margin-top: 3px;
      color: #667085;
      font-size: 12px;
    }

    .availability-warning {
      margin-top: 6px;
      padding: 6px 8px;
      border-radius: 6px;
      font-size: 12px;
      line-height: 1.35;
      text-align: left;
    }

    .qty-input-wrap {
      display: inline-flex;
      align-items: center;
      justify-content: flex-end;
      gap: 6px;
      min-height: 28px;
    }

    .qty-warning-input.is-warn {
      border-color: #f5d46a !important;
      box-shadow: inset 0 0 0 1px rgba(245, 212, 106, 0.35);
    }

    .qty-warning-input.is-danger {
      border-color: #fda29b !important;
      box-shadow: inset 0 0 0 1px rgba(253, 162, 155, 0.35);
    }

    .warning-icon-trigger {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 16px;
      height: 16px;
      color: #b54708;
      cursor: help;
      user-select: none;
      font-size: 12px;
      line-height: 1;
      border-radius: 50%;
    }

    .warning-icon-trigger.is-danger {
      color: #b42318;
    }

    .qty-warning-tooltip {
      position: fixed;
      z-index: 1200;
      max-width: 300px;
      padding: 8px 10px;
      border-radius: 6px;
      background: #111827;
      color: #fff;
      font-size: 12px;
      line-height: 1.35;
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.28);
      opacity: 0;
      pointer-events: none;
      transform: translateY(4px);
      transition: opacity 0.16s ease, transform 0.16s ease;
    }

    .qty-warning-tooltip.is-visible {
      opacity: 1;
      transform: translateY(0);
    }

    .qc-row td {
      height: auto;
      padding: 0 10px 10px 86px;
      background: #fbfdff;
    }

    .qc-table {
      width: 100%;
      border-collapse: collapse;
      border: 1px solid #dbe7f5;
      background: #fff;
    }

    .qc-table th,
    .qc-table td {
      height: 32px;
      padding: 0 8px;
      border-bottom: 1px solid #edf2f7;
      font-size: 13px;
    }

    .qc-table th {
      background: #f2f8ff;
      font-weight: 700;
    }

    .qc-input {
      width: 74px;
      height: 26px;
      border: 1px solid #cfd8e3;
      border-radius: 5px;
      text-align: right;
      padding: 0 6px;
    }

    .middle {
      padding: 12px 18px
    }

    .mid-head {
      height: 32px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 8px
    }

    .customer-search {
      position: relative;
      margin-bottom: 16px
    }

    .customer-search input {
      width: 100%;
      height: 38px;
      border: 0;
      background: #f0f2f5;
      border-radius: 5px;
      padding: 0 42px 0 32px;
      font-size: 16px
    }

    .customer-search i {
      position: absolute;
      left: 10px;
      top: 50%;
      transform: translateY(-50%);
      color: #667085
    }

    .customer-search button {
      position: absolute;
      right: 8px;
      top: 5px;
      border: 0;
      background: transparent;
      font-size: 24px;
      cursor: pointer
    }

    .section-line {
      display: grid;
      grid-template-columns: 22px 1fr;
      gap: 10px;
      margin-bottom: 12px
    }

    .marker {
      display: flex;
      justify-content: center;
      color: #0070f4;
      font-size: 20px
    }

    .marker.green {
      color: #00a651
    }

    .line-input {
      height: 34px;
      border: 1px solid #cfd8e3;
      border-radius: 6px;
      background: #fff;
      padding: 0 10px;
      font-size: 14px;
      outline: none;
      width: 100%;
    }

    .two {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px
    }

    .middle .section-line>div:last-child {
      display: grid;
      gap: 10px;
    }

    .middle .line-input {
      margin-top: 0 !important;
    }

    .middle select.line-input {
      appearance: none;
      background-image: linear-gradient(45deg, transparent 50%, #475467 50%), linear-gradient(135deg, #475467 50%, transparent 50%);
      background-position: calc(100% - 18px) 16px, calc(100% - 12px) 16px;
      background-size: 6px 6px, 6px 6px;
      background-repeat: no-repeat;
      padding-right: 34px;
    }

    .muted-red {
      font-size: 12px;
      color: #344054;
    }

    #pickupInfo {
      min-height: 34px;
      border: 1px solid #cfd8e3;
      border-radius: 6px;
      background: #fff;
      padding: 7px 10px;
      display: flex;
      align-items: center;
      line-height: 1.25;
      font-size: 13px;
    }

    #pickupInfo:empty {
      display: none;
    }

    .package {
      border-top: 1px solid #edf0f3;
      padding-top: 12px;
      margin-top: 12px
    }

    .package-title {
      font-size: 16px;
      margin-bottom: 10px
    }

    .pkg-grid {
      display: grid;
      grid-template-columns: 70px 84px 1fr;
      gap: 12px;
      align-items: center
    }

    .pkg-input {
      height: 30px;
      border: 0;
      border-bottom: 1px solid #c2cad3;
      text-align: center
    }

    .payment-input,
    .payment-select {
      height: 32px;
      border: 1px solid #cfd8e3;
      border-radius: 6px;
      padding: 0 10px;
      font-size: 14px;
      background: #fff;
      text-align: right;
    }

    .payment-select {
      text-align: left;
    }

    .middle-payment {
      margin-top: 18px;
      padding-top: 16px;
      border-top: 1px solid #d7dde5;
    }

    .middle-payment-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      margin-bottom: 12px;
      color: #667085;
      font-size: 15px;
      font-weight: 700;
    }

    .middle-payment-row .payment-input,
    .middle-payment-row .payment-select {
      width: 180px;
    }

    .middle-payment-row strong {
      color: #111827;
      font-size: 15px;
    }

    .middle-payment-total {
      color: #0b172a;
      font-size: 20px;
      font-weight: 800;
    }

    .money-input-wrap {
      display: inline-flex;
      align-items: center;
      justify-content: flex-end;
      gap: 6px;
      white-space: nowrap;
    }

    .money-unit {
      color: #667085;
      font-weight: 700;
      font-size: 13px;
    }

    .money-input-wrap .delivery-input {
      flex: 1;
    }

    .right {
      padding: 0
    }

    .tabs {
      height: 38px;
      display: grid;
      grid-template-columns: 1fr;
      border-bottom: 1px solid #d7dde5
    }

    .tab {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      font-weight: 700;
      color: #0070f4;
      border-bottom: 2px solid #0070f4
    }

    .right-body {
      padding: 22px 20px
    }

    .delivery-row {
      display: flex;
      flex-direction: column;
      gap: 8px;
      margin-bottom: 18px
    }

    .delivery-row label {
      font-size: 13px;
      font-weight: 800;
      color: #344054
    }

    .delivery-input {
      width: 100%;
      height: 38px;
      border: 1px solid #cfd8e3;
      border-radius: 6px;
      padding: 0 12px;
      font-size: 14px;
      background: #fff;
    }

    .delivery-help {
      min-height: 18px;
      color: #667085;
      font-size: 12px;
    }

    .partner-picker {
      position: relative
    }

    .partner-trigger {
      width: 100%;
      min-height: 38px;
      border: 1px solid #cfd8e3;
      border-radius: 7px;
      background: #fff;
      color: #344054;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      padding: 0 11px;
      font-size: 14px;
      cursor: pointer
    }

    .partner-trigger.empty {
      color: #667085
    }

    .partner-menu {
      display: none;
      position: absolute;
      top: calc(100% + 4px);
      left: 0;
      right: 0;
      max-height: 230px;
      overflow: auto;
      background: #fff;
      border: 1px solid #cfd8e3;
      border-radius: 8px;
      box-shadow: 0 12px 26px rgba(0, 0, 0, .16);
      z-index: 80;
      padding: 6px
    }

    .partner-picker.open .partner-menu {
      display: block
    }

    .partner-option {
      min-height: 34px;
      display: flex;
      align-items: center;
      padding: 0 9px;
      border-radius: 6px;
      font-size: 13px;
      color: #344054;
      cursor: pointer
    }

    .partner-option:hover,
    .partner-option.active {
      background: #eef6ff;
      color: #006dff;
      font-weight: 800
    }

    .place-order {
      margin-top: auto;
      padding: 12px
    }

    .place-order button {
      width: 100%;
      height: 52px;
      border: 0;
      border-radius: 9px;
      background: #0070f4;
      color: #fff;
      font-size: 18px;
      font-weight: 800;
      cursor: pointer
    }
  </style>
</head>

<body>
  <%- include('../partials/header') %>
    <main class="order-create">
      <section class="left">
        <div class="top-search"><i class="fa-solid fa-magnifying-glass"></i><input id="productSearch"
            placeholder="Tìm hàng hóa (F3)">
          <div id="productResults" class="search-results"></div>
        </div>
        <div class="cart-area">
          <table class="cart-table">
            <thead>
              <tr>
                <th>STT</th>
                <th>Mã hàng</th>
                <th>Tên hàng</th>
                <th class="num">SL</th>
                <th class="num">Tồn</th>
                <th class="num" title="Số lượng đang được các đơn đặt hàng khác giữ nhưng chưa giao đủ.">Khách khác đã đặt</th>
                <th class="num" title="Khả dụng = Tồn thực tế - Khách khác đã đặt.">Khả dụng</th>
                <th class="num">Đơn giá</th>
                <th class="num">Giảm giá</th>
                <th class="num">Thành tiền</th>
                <th></th>
              </tr>
            </thead>
            <tbody id="cartBody"></tbody>
          </table>
        </div>
        <div class="summary-card">
          <div class="note-line"><i class="fa-solid fa-pen"></i> Ghi chú hóa đơn</div>
          <div class="totals">
            <div class="total-line"><span>Tổng tiền hàng</span><span id="subtotal">0 VNĐ</span></div>
            <div class="total-line"><span>Giảm giá</span>
              <span class="discount-pair"><input id="discount" class="small" value="0" oninput="renderCart()"><select
                  id="orderDiscountType" onchange="renderCart()">
                  <option value="vnd">VNĐ</option>
                  <option value="phan_tram">%</option>
                </select></span>
            </div>
            <div class="total-line"><strong>Tổng cộng dự kiến</strong><strong class="payable" id="grandTotal">0 VNĐ</strong>
            </div>
          </div>
        </div>
      </section>
      <section class="middle">
        <div class="mid-head"><strong id="storeName"><%= currentStore?.ten_cua_hang || 'Cửa hàng' %></strong><span>
            <%= new Date().toLocaleString('vi-VN', { day:'2-digit', month:'2-digit', year:'numeric', hour:'2-digit',
              minute:'2-digit' }) %>
          </span></div>
        <input type="hidden" id="customerId">
        <input type="hidden" id="storeId" value="<%= currentStoreId || '' %>">
        <div class="section-line">
          <div class="marker"><i class="fa-solid fa-circle-dot"></i></div>
          <div>
            <div class="muted-red" id="pickupInfo"><% if (!currentStoreId) { %>Chưa chọn cửa hàng. Vui lòng chọn cửa hàng ở menu góc trên phải.<% } %></div>
            <select id="khoId" class="line-input" style="width:100%;margin-top:12px"<%= !currentStoreId ? ' disabled' : '' %>>
              <option value=""><%= (warehouses || []).length ? 'Chọn kho' : (currentStoreId ? 'Chưa có kho cho cửa hàng này' : 'Chưa chọn cửa hàng') %></option>
              <% (warehouses || []).forEach(function(w) { %>
                <option value="<%= w._id %>" data-address="<%= (w.dia_chi_day_du || w.dia_chi || '').replace(/"/g, '&quot;') %>"><%= w.ten_kho %></option>
              <% }) %>
            </select>
            <select id="priceBookId" class="line-input" onchange="handlePriceBookChange()" style="width:100%;margin-top:12px">
              <option value="">Bảng giá chung</option>
              <% priceBooks.forEach(bg => { %>
                <option value="<%= bg._id %>"><%= bg.ten_bang_gia %></option>
              <% }) %>
            </select>
          </div>
        </div>
        <div class="section-line">
          <div class="marker green"><i class="fa-solid fa-location-dot"></i></div>
          <div>
            <div class="two"><select id="recipientCustomerId" class="line-input" onchange="selectRecipientCustomer(this.value)">
                <option value="">Chọn khách hàng</option>
                <% customers.forEach(c=> {
                  const defaultAddress = (c.dia_chi_list || []).find(a => a.mac_dinh) || (c.dia_chi_list || [])[0] || {};
                  const optionPhone = c.sdt || c.sdt2 || '';
                  const optionAddress = defaultAddress.dia_chi || defaultAddress.dia_chi_day_du || c.dia_chi_nhan || '';
                  const optionAddressId = defaultAddress._id || '';
                  const optionArea = defaultAddress.quan_huyen || defaultAddress.tinh_thanh || c.quan_huyen || c.tinh_thanh || '';
                  const optionWard = defaultAddress.phuong_xa || c.phuong_xa || '';
                %><option value="<%= c._id %>" data-name="<%= c.ten_khach_hang || '' %>" data-phone="<%= optionPhone %>" data-address="<%= optionAddress %>" data-address-id="<%= optionAddressId %>" data-area="<%= optionArea %>" data-ward="<%= optionWard %>">
                    <%= c.ten_khach_hang %>
                  </option>
                  <% }) %>
              </select><input id="recipientPhone" class="line-input" placeholder="Số điện thoại"></div>
            <input type="hidden" id="recipientAddressId">
            <input id="recipientAddress" class="line-input" style="width:100%;margin-top:12px"
              placeholder="Địa chỉ nhận hàng"><input id="recipientArea" class="line-input"
              style="width:100%;margin-top:12px" placeholder="Khu vực"><input id="recipientWard" class="line-input"
              style="width:100%;margin-top:12px" placeholder="Phường/Xã">
            <div class="middle-payment">
              <div class="middle-payment-row">
                <span>Tiền mặt khách đưa</span>
                <span class="money-input-wrap">
                  <input id="customerCashInput" class="payment-input" value="0" inputmode="numeric" oninput="handleCustomerPaymentInput()">
                  <span class="money-unit">VNĐ</span>
                </span>
              </div>
              <div class="middle-payment-row">
                <span>Chuyển khoản khách đưa</span>
                <span class="money-input-wrap">
                  <input id="customerTransferInput" class="payment-input" value="0" inputmode="numeric" oninput="handleCustomerPaymentInput()">
                  <span class="money-unit">VNĐ</span>
                </span>
              </div>
              <div class="middle-payment-row">
                <span>Tiền thừa trả khách</span>
                <span class="money-input-wrap">
                  <input id="customerChangeInput" class="payment-input" value="0" inputmode="numeric" oninput="handleCustomerPaymentInput()">
                  <span class="money-unit">VNĐ</span>
                </span>
              </div>
              <div class="middle-payment-row">
                <span>Sổ quỹ</span>
                <select id="cashBookId" class="payment-select">
                  <option value="">Chọn sổ quỹ</option>
                  <% (cashBooks || []).forEach(function(book) { %>
                    <option value="<%= book._id %>"><%= book.ten_so_quy || 'Sổ quỹ' %></option>
                  <% }) %>
                </select>
              </div>
              <div class="middle-payment-row"><span>Tổng khách đưa</span><strong id="paymentTotalGiven">0 VNĐ</strong></div>
              <div class="middle-payment-row"><span>Thực thu</span><strong id="paymentNetReceived">0 VNĐ</strong></div>
              <div class="middle-payment-row middle-payment-total">
                <span>Còn phải thu</span>
                <strong id="remainingTotal">0 VNĐ</strong>
              </div>
              <div id="paymentValidationHint" class="delivery-help" style="color:#d92d20;display:none"></div>
            </div>
          </div>
        </div>
      </section>
      <section class="right">
        <div class="tabs">
          <div class="tab"><i class="fa-solid fa-user-gear"></i> Tự giao hàng</div>
        </div>
        <div class="right-body">
          <div class="delivery-row">
            <label>Đối tác giao hàng</label>
            <input type="hidden" id="partnerId">
            <div class="partner-picker" id="partnerPicker">
              <button class="partner-trigger empty" type="button" onclick="togglePartnerMenu()">
                <span id="partnerLabel">Chọn đối tác</span>
                <i class="fa-solid fa-chevron-down"></i>
              </button>
              <div class="partner-menu">
                <% partners.forEach(p=> { %>
                  <div class="partner-option" data-partner-id="<%= p._id %>" onclick="selectPartner('<%= p._id %>', '<%= String(p.ten_doi_tac || '').replace(/'/g, '&#39;') %>')">
                    <%= p.ten_doi_tac %>
                  </div>
                <% }) %>
              </div>
            </div>
          </div>
          <div class="delivery-row" style="margin-top:16px">
            <label>Người trả phí giao hàng</label>
            <select id="shippingFeePayer" class="delivery-input" onchange="handleShippingFeePayerChange()">
              <option value="khach">Khách trả</option>
              <option value="cua_hang">Cửa hàng trả</option>
            </select>
          </div>
          <div class="delivery-row" style="margin-top:16px">
            <label>Phí giao hàng</label>
            <span class="money-input-wrap"><input id="shippingFee" class="delivery-input" value="0" inputmode="numeric" oninput="handleManualShippingFee()"><span class="money-unit">VNĐ</span></span>
            <div class="delivery-help" id="shippingFeeHelp">Nhập trực tiếp phí giao hàng.</div>
          </div>
        </div>
        <div class="place-order"><button id="payButton" onclick="saveOrder()" type="button">THANH TOÁN</button></div>
      </section>
    </main>
    <div id="qtyWarningTooltip" class="qty-warning-tooltip" aria-hidden="true"></div>
    <script>
      let cart = [];
      let lastTotals = { khachCanTra: 0, tien_mat: 0, chuyen_khoan: 0, tien_thua: 0, tong_khach_dua: 0, thuc_thu: 0 };
      let availableProducts = [];
      let previousKhoId = '';
      const sourceOrder = <%- JSON.stringify(sourceOrder || null) %>;
      const sourceOrderItems = <%- JSON.stringify((sourceOrderItems || []).map(row => ({ ct_don_hang_id: String(row._id || ''), hang_hoa_id: String(row.hang_hoa_id?._id || row.hang_hoa_id || ''), ma_hang: row.ma_hang_snapshot || row.hang_hoa_id?.ma_hang || '', ten_hang: row.ten_hang_snapshot || row.hang_hoa_id?.ten_hang || '', so_luong: Number(row.so_luong_da_giao || row.so_luong_dat || row.so_luong || 0), ton_kho: 0, don_gia_ban: Number(row.don_gia_ban || 0), chiet_khau: Number(row.chiet_khau || 0), kieu_chiet_khau: row.kieu_chiet_khau || 'vnd', lo_hang_id: row.lo_hang_id ? String(row.lo_hang_id) : '', gia_tri_thuoc_tinh_id: row.gia_tri_thuoc_tinh_id ? String(row.gia_tri_thuoc_tinh_id) : '', ten_quy_cach: row.ten_quy_cach || '', ten_thuoc_tinh: row.ten_thuoc_tinh || '', don_vi_tinh_id: row.don_vi_tinh_id ? String(row.don_vi_tinh_id) : '', ma_hang_snapshot: row.ma_hang_snapshot || row.hang_hoa_id?.ma_hang || '', ten_hang_snapshot: row.ten_hang_snapshot || row.hang_hoa_id?.ten_hang || '', don_vi_tinh_snapshot: row.don_vi_tinh_snapshot || '', ghi_chu: row.ghi_chu || '' }))) %>;
      const sourceShipment = <%- JSON.stringify(sourceShipment || null) %>;
      const existingInvoice = <%- JSON.stringify(existingInvoice || null) %>;
      const sourceInvoice = <%- JSON.stringify(sourceInvoice || null) %>;
      const sourceInvoiceItems = <%- JSON.stringify((sourceInvoiceItems || []).map(row => ({ hang_hoa_id: String(row.hang_hoa_id?._id || row.hang_hoa_id || ''), ma_hang: row.ma_hang_snapshot || row.hang_hoa_id?.ma_hang || '', ten_hang: row.ten_hang_snapshot || row.hang_hoa_id?.ten_hang || '', so_luong: Number(row.so_luong || 0), ton_kho: 0, don_gia_ban: Number(row.don_gia || 0), chiet_khau: Number(row.chiet_khau || 0), kieu_chiet_khau: 'vnd', lo_hang_id: row.lo_hang_id ? String(row.lo_hang_id._id || row.lo_hang_id) : '', gia_tri_thuoc_tinh_id: row.gia_tri_thuoc_tinh_id ? String(row.gia_tri_thuoc_tinh_id) : '', ten_quy_cach: row.ten_quy_cach || '', ten_thuoc_tinh: row.ten_thuoc_tinh || '', don_vi_tinh_id: row.don_vi_tinh_id ? String(row.don_vi_tinh_id) : '', ma_hang_snapshot: row.ma_hang_snapshot || row.hang_hoa_id?.ma_hang || '', ten_hang_snapshot: row.ten_hang_snapshot || row.hang_hoa_id?.ten_hang || '', don_vi_tinh_snapshot: row.don_vi_tinh_snapshot || '', ghi_chu: row.ghi_chu || '' }))) %>;
      const sourceInvoiceShipment = <%- JSON.stringify(sourceInvoiceShipment || null) %>;
      const copyFromError = <%- JSON.stringify(copyFromError || '') %>;
      let customerPaidTouched = false;
      const products = <%- JSON.stringify(products.map(p => ({ _id: String(p._id), ma_hang: p.ma_hang || '', ten_hang: p.ten_hang || '', gia_co_dinh: p.gia_co_dinh || 0, nha_cung_cap_id: p.nha_cung_cap_id ? String(p.nha_cung_cap_id._id || p.nha_cung_cap_id) : '', ten_ncc: p.nha_cung_cap_id ? (p.nha_cung_cap_id.ten_ncc || p.nha_cung_cap_id.ten_cong_ty || '') : '', ma_ncc: p.nha_cung_cap_id ? (p.nha_cung_cap_id.ma_ncc || '') : '' }))) %>;
      const priceRows = <%- JSON.stringify((priceRows || []).map(r => ({ bang_gia_id: String(r.bang_gia_id || ''), hang_hoa_id: String(r.hang_hoa_id || ''), gia_ban: Number(r.gia_ban || 0) }))) %>;
      const customers = <%- JSON.stringify(customers.map(c => ({ _id: String(c._id), ma_khach_hang: c.ma_khach_hang || '', ten_khach_hang: c.ten_khach_hang || '', sdt: c.sdt || c.sdt2 || '', sdt2: c.sdt2 || '', email: c.email || '', dia_chi_nhan: c.dia_chi_nhan || '', tinh_thanh: c.tinh_thanh || '', quan_huyen: c.quan_huyen || '', phuong_xa: c.phuong_xa || '', dia_chi_list: (c.dia_chi_list || []).map(a => ({ _id: String(a._id || ''), dia_chi: a.dia_chi || a.dia_chi_day_du || '', tinh_thanh: a.tinh_thanh || '', quan_huyen: a.quan_huyen || '', phuong_xa: a.phuong_xa || '', mac_dinh: !!a.mac_dinh })) }))) %>;
      const stores = <%- JSON.stringify(stores.map(s => ({ _id: String(s._id), ten_cua_hang: s.ten_cua_hang || '', sdt: s.sdt || '', dia_chi: s.dia_chi_day_du || s.dia_chi || '', tinh_thanh: s.tinh_thanh || '', phuong_xa: s.phuong_xa || '' }))) %>;
      const initialWarehouses = <%- JSON.stringify((warehouses || []).map(w => ({ _id: String(w._id), ten_kho: w.ten_kho || '', dia_chi_day_du: w.dia_chi_day_du || w.dia_chi || '' }))) %>;
      const getStoreId = () => String(document.getElementById('storeId')?.value || '').trim();
      const fmt = n => Number(n || 0).toLocaleString('vi-VN');
      const moneyFmt = n => `${fmt(n)} VNĐ`;
      const num = v => Number(String(v || '').replace(/[^\d-]/g, '')) || 0;
      const qtyWarningTooltip = document.getElementById('qtyWarningTooltip');
      let qtyWarningHideTimer = null;
      const formatDateVi = value => value ? new Date(value).toLocaleDateString('vi-VN') : '';
      const stockByProduct = new Map();
      const productSearch = document.getElementById('productSearch'), productResults = document.getElementById('productResults');
      const selectedPriceBookId = () => document.getElementById('priceBookId')?.value || '';
      function escapeHtml(value) {
        return String(value ?? '').replace(/[&<>"']/g, char => ({
          '&': '&amp;',
          '<': '&lt;',
          '>': '&gt;',
          '"': '&quot;',
          "'": '&#39;'
        }[char]));
      }
      function supplierName(product) {
        return product?.ten_ncc || 'Chưa có';
      }
      function priceFor(productId) {
        const row = priceRows.find(r => r.bang_gia_id === selectedPriceBookId() && r.hang_hoa_id === productId);
        if (row && Number(row.gia_ban || 0) > 0) return Number(row.gia_ban || 0);
        const product = products.find(p => p._id === productId);
        return Number(product?.gia_co_dinh || 0) || 0;
      }
      function stockFor(productId) { return Number(stockByProduct.get(productId) || 0); }
      function clearProductState(resetDiscount = true) {
        cart = [];
        availableProducts = [];
        stockByProduct.clear();
        productSearch.value = '';
        productResults.innerHTML = '';
        productResults.style.display = 'none';
        if (resetDiscount) {
          discount.value = 0;
          orderDiscountType.value = 'vnd';
          shippingFee.value = 0;
        }
        renderCart();
      }
      function discountAmount(value, type, baseAmount) {
        const base = Math.max(0, Number(baseAmount || 0));
        const raw = Math.max(0, Number(value || 0));
        const amount = type === 'phan_tram' ? base * Math.min(raw, 100) / 100 : raw;
        return Math.min(amount, base);
      }
      const salePriceCache = new Map();
      function salePriceCacheKey(productId, ctx) {
        return [productId, ctx.lo_hang_id || '', ctx.gia_tri_thuoc_tinh_id || '', ctx.ten_quy_cach || '', ctx.loai_gia_ban || '', selectedPriceBookId()].join('|');
      }
      async function fetchSalePriceMeta(productId, ctx = {}) {
        const key = salePriceCacheKey(productId, ctx);
        if (salePriceCache.has(key)) return salePriceCache.get(key);
        const params = new URLSearchParams();
        const bg = selectedPriceBookId();
        if (bg) params.set('bang_gia_id', bg);
        if (ctx.lo_hang_id) params.set('lo_hang_id', String(ctx.lo_hang_id));
        if (ctx.gia_tri_thuoc_tinh_id) params.set('gia_tri_thuoc_tinh_id', String(ctx.gia_tri_thuoc_tinh_id));
        if (ctx.ten_quy_cach) params.set('ten_quy_cach', String(ctx.ten_quy_cach));
        if (ctx.loai_gia_ban) params.set('loai_gia_ban', String(ctx.loai_gia_ban));
        let data = { gia_ban: priceFor(productId), cho_phep_sua_gia: true, loai_ap_dung: null };
        try {
          const res = await fetch('/api/kho/hang-hoa/' + encodeURIComponent(productId) + '/gia?' + params.toString());
          const json = await res.json();
          if (json && json.success && json.data) data = json.data;
        } catch (err) { /* fallback */ }
        if (data.gia_ban == null || data.gia_ban === '') data.gia_ban = priceFor(productId);
        salePriceCache.set(key, data);
        return data;
      }
      async function applyPriceToDetailRow(productId, row, loaiGiaBan) {
        const meta = await fetchSalePriceMeta(productId, {
          lo_hang_id: row.lo_hang_id,
          gia_tri_thuoc_tinh_id: row.gia_tri_thuoc_tinh_id,
          ten_quy_cach: row.ten_quy_cach || row.ten_thuoc_tinh || '',
          loai_gia_ban: loaiGiaBan || row.loai_gia_ban || ''
        });
        row.don_gia_ban = Number(meta.gia_ban || 0) || priceFor(productId);
        row.cho_phep_sua_gia = meta.cho_phep_sua_gia !== false;
        row.loai_ap_dung = meta.loai_ap_dung || null;
        if (!row.loai_gia_ban && meta.loai_ap_dung === 'ca_hai') {
          row.loai_gia_ban = meta.gia_mac_dinh === 'thi_truong' ? 'thi_truong' : 'co_dinh';
        }
        return row;
      }
      async function handlePriceBookChange() {
        if (sourceOrder) return;
        salePriceCache.clear();
        for (const item of cart) {
          const meta = await fetchSalePriceMeta(item.hang_hoa_id, {});
          item.don_gia_ban = Number(meta.gia_ban || 0) || priceFor(item.hang_hoa_id);
          item.cho_phep_sua_gia = meta.cho_phep_sua_gia !== false;
          if (item.has_quy_cach) await Promise.all((item.quy_cach_items || []).map(qc => applyPriceToDetailRow(item.hang_hoa_id, qc)));
          if (item.has_lot_items) await Promise.all((item.lot_items || []).map(lot => applyPriceToDetailRow(item.hang_hoa_id, lot)));
        }
        if (productResults.style.display === 'block') renderProductSuggestions();
        renderCart();
      }
      function lineQty(item) {
        if (item.has_quy_cach && Array.isArray(item.quy_cach_items)) {
          return item.quy_cach_items.reduce((sum, qc) => sum + Number(qc.so_luong_dat || qc.so_luong || 0), 0);
        }
        if (item.has_lot_items && Array.isArray(item.lot_items)) {
          return item.lot_items.reduce((sum, lot) => sum + Number(lot.so_luong_dat || lot.so_luong || 0), 0);
        }
        return Number(item.so_luong || 0);
      }
      function firstNumber(...values) {
        for (const value of values) {
          if (value === undefined || value === null || value === '') continue;
          const number = Number(value);
          if (Number.isFinite(number)) return number;
        }
        return 0;
      }
      function inventoryMetrics(row = {}, fallbackStock = 0) {
        const tonThucTe = firstNumber(row.ton_thuc_te, row.ton_hien_tai, row.ton_kho, row.ton, fallbackStock, 0);
        const soLuongKhachDat = Math.max(0, firstNumber(row.so_luong_khach_dat, row.khach_dat, row.da_dat, 0));
        const soLuongKhaDung = firstNumber(row.so_luong_kha_dung, row.kha_dung, tonThucTe - soLuongKhachDat);
        return { tonThucTe, soLuongKhachDat, soLuongKhaDung };
      }
      function lineInventoryMetrics(item) {
        if (item.has_quy_cach && Array.isArray(item.quy_cach_items)) {
          return item.quy_cach_items.reduce((sum, qc) => {
            const metrics = inventoryMetrics(qc);
            sum.tonThucTe += metrics.tonThucTe;
            sum.soLuongKhachDat += metrics.soLuongKhachDat;
            sum.soLuongKhaDung += metrics.soLuongKhaDung;
            return sum;
          }, { tonThucTe: 0, soLuongKhachDat: 0, soLuongKhaDung: 0 });
        }
        if (item.has_lot_items && Array.isArray(item.lot_items)) {
          return item.lot_items.reduce((sum, lot) => {
            const metrics = inventoryMetrics(lot);
            sum.tonThucTe += metrics.tonThucTe;
            sum.soLuongKhachDat += metrics.soLuongKhachDat;
            sum.soLuongKhaDung += metrics.soLuongKhaDung;
            return sum;
          }, { tonThucTe: 0, soLuongKhachDat: 0, soLuongKhaDung: 0 });
        }
        return inventoryMetrics(item, stockFor(item.hang_hoa_id));
      }
      function availabilityWarning(qty, metrics) {
        const quantity = Number(qty || 0);
        if (quantity <= 0) return null;
        if (quantity > metrics.tonThucTe) {
          return {
            level: 'danger',
            message: `Số lượng bán đang vượt tồn thực tế trong kho. Tồn thực tế: ${fmt(metrics.tonThucTe)}, Khách khác đã đặt: ${fmt(metrics.soLuongKhachDat)}, Khả dụng: ${fmt(metrics.soLuongKhaDung)}.`
          };
        }
        if (quantity > metrics.soLuongKhaDung) {
          return {
            level: 'warn',
            message: `Số lượng bán đang vượt mức khả dụng. Hiện còn khả dụng ${fmt(metrics.soLuongKhaDung)}, vì đã có khách khác đặt ${fmt(metrics.soLuongKhachDat)}.`
          };
        }
        return null;
      }
      function warningInputClass(warning) {
        if (!warning) return '';
        return warning.level === 'danger' ? ' qty-warning-input is-danger' : ' qty-warning-input is-warn';
      }
      function warningIconHtml(warning) {
        if (!warning) return '';
        const dangerClass = warning.level === 'danger' ? ' is-danger' : '';
        return `<span class="warning-icon-trigger js-warning-icon${dangerClass}" data-warning-message="${escapeHtml(warning.message)}" aria-label="Cảnh báo tồn kho">⚠</span>`;
      }
      function lineStock(item) {
        return lineInventoryMetrics(item).tonThucTe;
      }
      function renderProductSuggestions() {
        if (!document.getElementById('khoId').value) {
          productResults.innerHTML = '<div class="search-item"><span>Vui lòng chọn kho trước</span></div>';
          productResults.style.display = 'block';
          return;
        }
        const q = productSearch.value.trim().toLowerCase();
        const rows = (q ? availableProducts.filter(p => p.ma_hang.toLowerCase().includes(q) || p.ten_hang.toLowerCase().includes(q)) : availableProducts).slice(0, 30);
        productResults.innerHTML = rows.map(p => {
          const stock = inventoryMetrics(p, stockFor(p._id)).tonThucTe;
          const qcText = p.has_quy_cach ? ` - Thuộc tính: ${(p.quy_cach_items || []).length}` : '';
          return `<div class="search-item product-search-item" onclick="addProduct('${p._id}')"><span class="search-item-info"><span class="search-item-main"><b>${escapeHtml(p.ma_hang || '')}</b> - ${escapeHtml(p.ten_hang || '')}</span><span class="search-item-meta">NCC: ${escapeHtml(supplierName(p))} - Tồn: ${fmt(stock)}${qcText}</span></span><b class="search-item-price">${moneyFmt(priceFor(p._id))}</b></div>`;
        }).join('') || '<div class="search-item"><span>Không có hàng hóa phù hợp</span></div>';
        productResults.style.display = 'block';
      }
      productSearch.addEventListener('focus', renderProductSuggestions);
      productSearch.addEventListener('input', renderProductSuggestions);
      async function addProduct(id) {
        if (sourceOrder) return alert('Hóa đơn tạo từ đơn hàng gốc không cho sửa danh sách hàng.');
        if (!document.getElementById('khoId').value) return alert('Vui lòng chọn kho trước khi thêm hàng.');
        const p = availableProducts.find(x => x._id === id);
        if (!p) return;
        const stock = inventoryMetrics(p, stockFor(id)).tonThucTe;
        const ex = cart.find(i => i.hang_hoa_id === id);
        if (ex) {
          if (ex.has_quy_cach || ex.has_lot_items) {
            alert('Hàng hóa có lô/thuộc tính, vui lòng nhập số lượng theo bảng bên dưới.');
          } else {
            ex.so_luong += 1;
            if (ex.so_luong > stock) alert('Hóa đơn này đang bán vượt tồn hiện có.');
          }
        } else {
          const hasQuyCach = Boolean(p.has_quy_cach && (p.quy_cach_items || []).length);
          const hasLotItems = Boolean(!hasQuyCach && p.quan_ly_theo_lo && (p.lot_items || []).length);
          const meta = await fetchSalePriceMeta(id, {});
          const newItem = {
            hang_hoa_id: id,
            ma_hang: p.ma_hang,
            ten_hang: p.ten_hang,
            so_luong: (hasQuyCach || hasLotItems) ? 0 : 1,
            ton_kho: stock,
            ton_thuc_te: p.ton_thuc_te,
            so_luong_khach_dat: p.so_luong_khach_dat,
            so_luong_kha_dung: p.so_luong_kha_dung,
            don_gia_ban: Number(meta.gia_ban || 0) || priceFor(id),
            cho_phep_sua_gia: meta.cho_phep_sua_gia !== false,
            chiet_khau: 0,
            kieu_chiet_khau: 'vnd',
            has_quy_cach: hasQuyCach,
            has_lot_items: hasLotItems,
            quy_cach_items: hasQuyCach ? (p.quy_cach_items || []).map(qc => Object.assign({}, qc, { so_luong_dat: '', chiet_khau: 0, kieu_chiet_khau: 'vnd' })) : [],
            lot_items: hasLotItems ? (p.lot_items || []).map(lot => Object.assign({}, lot, { so_luong_dat: '', chiet_khau: 0, kieu_chiet_khau: 'vnd' })) : []
          };
          if (hasQuyCach) await Promise.all(newItem.quy_cach_items.map(qc => applyPriceToDetailRow(id, qc)));
          if (hasLotItems) await Promise.all(newItem.lot_items.map(lot => applyPriceToDetailRow(id, lot)));
          cart.push(newItem);
          if (!hasQuyCach && !hasLotItems && stock < 1) alert('Hóa đơn này đang bán vượt tồn hiện có.');
        }
        productSearch.value = '';
        productResults.style.display = 'none';
        renderCart();
      }
      function renderQuyCachBlock(item, idx) {
        const detailRows = item.has_quy_cach ? (item.quy_cach_items || []) : (item.has_lot_items ? (item.lot_items || []) : []);
        if (!detailRows.length) return '';
        const rows = detailRows.map((qc, qcIdx) => {
          const qty = Number(qc.so_luong_dat || qc.so_luong || 0);
          const metrics = inventoryMetrics(qc);
          const qcWarning = sourceOrder ? null : availabilityWarning(qty, metrics);
          const unitPrice = Number(qc.don_gia_ban ?? item.don_gia_ban ?? 0);
          const base = qty * unitPrice;
          const discount = discountAmount(qc.chiet_khau || 0, qc.kieu_chiet_khau || 'vnd', base);
          const total = Math.max(base - discount, 0);
          const disabled = sourceOrder ? ' disabled' : '';
          const lotName = [qc.ten_lo || qc.ma_lo || '', qc.han_su_dung ? `HSD ${formatDateVi(qc.han_su_dung)}` : ''].filter(Boolean).join(' - ') || '--';
          return `<tr>
            <th>${escapeHtml(lotName)}</th>
            <th>${escapeHtml(qc.ten_quy_cach || qc.ten_thuoc_tinh || '--')}</th>
            <td class="num">${fmt(metrics.tonThucTe)}</td>
            <td class="num">${fmt(metrics.soLuongKhachDat)}</td>
            <td class="num">${fmt(metrics.soLuongKhaDung)}</td>
            <td class="num"><span class="qty-input-wrap"><input class="qc-input${warningInputClass(qcWarning)}" type="number" min="0" value="${qty || ''}" onchange="updQuyCachQty(${idx}, ${qcIdx}, this.value)"${disabled}>${warningIconHtml(qcWarning)}</span></td>
            <td class="num"><span class="money-input-wrap"><input class="qc-input" inputmode="numeric" value="${fmt(unitPrice)}" onchange="updQuyCachPrice(${idx}, ${qcIdx}, this.value)"${disabled}><span class="money-unit">VNĐ</span></span></td>
            <td class="num"><span class="discount-pair"><input class="qc-input" value="${qc.chiet_khau || 0}" onchange="updQuyCachDiscount(${idx}, ${qcIdx}, this.value)"${disabled}><select onchange="updQuyCachDiscountType(${idx}, ${qcIdx}, this.value)"${disabled}><option value="vnd"${qc.kieu_chiet_khau !== 'phan_tram' ? ' selected' : ''}>VNĐ</option><option value="phan_tram"${qc.kieu_chiet_khau === 'phan_tram' ? ' selected' : ''}>%</option></select></span></td>
            <td class="num"><b>${moneyFmt(total)}</b></td>
          </tr>`;
        }).join('');
        return `<tr class="qc-row"><td colspan="11">
          <table class="qc-table">
            <thead><tr><th>Lô</th><th>Thuộc tính</th><th class="num">Tồn</th><th class="num" title="Số lượng đang được các đơn đặt hàng khác giữ nhưng chưa giao đủ.">Khách khác đã đặt</th><th class="num" title="Khả dụng = Tồn thực tế - Khách khác đã đặt.">Khả dụng</th><th class="num">SL bán</th><th class="num">Đơn giá</th><th class="num">Giảm giá</th><th class="num">Thành tiền</th></tr></thead>
            <tbody>${rows}</tbody>
          </table>
        </td></tr>`;
      }
      function renderCart() {
        let subtotal = 0;
        cartBody.innerHTML = cart.map((i, idx) => {
          i.ton_kho = lineStock(i);
          i.so_luong = lineQty(i);
          const detailRows = i.has_quy_cach ? (i.quy_cach_items || []) : (i.has_lot_items ? (i.lot_items || []) : []);
          const lineBase = detailRows.length
