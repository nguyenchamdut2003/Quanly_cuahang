  <script>
    const money = value => Number(value || 0).toLocaleString('vi-VN');
    const moneyText = value => money(value) + ' VNĐ';
    const num = value => Number(String(value || '').replace(/[^\d-]/g, '')) || 0;
    const statusLabels = { draft: 'Phiếu tạm', shipping: 'Đang giao hàng', completed: 'Hoàn thành', cancelled: 'Đã hủy', merged: 'Đã gộp' };
    const deliveryStatusLabels = { chua_giao: 'Chưa giao', giao_mot_phan: 'Giao một phần', giao_thieu: 'Giao thiếu', giao_du: 'Giao đủ' };
    const deliveryStatusText = status => deliveryStatusLabels[status] || 'Chưa giao';
    const escapeHtml = value => String(value ?? '').replace(/[&<>"']/g, char => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[char]));
    const refAnchor = (href, text) => href ? `<a class="ref-link" href="${escapeHtml(href)}" onclick="event.stopPropagation()">${escapeHtml(text || '--')}</a>` : escapeHtml(text || '--');
    const orderDetailCache = {};
    let pendingDeliveryOrderId = '';
    let pendingDeliveryPaymentDue = 0;
    let pendingReceiptOrderId = '';
    let pendingReceiptDue = 0;

    function handleDeliveryPaidInput(input) {
      const value = Math.min(num(input.value), pendingDeliveryPaymentDue);
      input.value = money(value);
    }

    function handleReceiptPayAmountInput(input) {
      const value = Math.min(num(input.value), pendingReceiptDue);
      input.value = money(value);
    }

    async function toggleOrderDetail(id) {
      const row = document.querySelector('[data-order-row="' + id + '"]');
      const detailRow = document.querySelector('[data-order-detail="' + id + '"]');
      if (!detailRow) return;
      const shouldOpen = !detailRow.classList.contains('open');
      document.querySelectorAll('.detail-row').forEach(item => item.classList.remove('open'));
      document.querySelectorAll('.order-row').forEach(item => item.classList.remove('active'));
      if (!shouldOpen) return;
      detailRow.classList.add('open');
      row?.classList.add('active');
      if (detailRow.dataset.loaded === 'true') return;
      await loadOrderDetail(id, detailRow);
    }

    document.addEventListener('DOMContentLoaded', function() {
      const id = new URLSearchParams(window.location.search).get('order');
      if (id) {
        const row = document.querySelector('[data-order-row="' + id + '"]');
        if (row) {
          toggleOrderDetail(id);
          row.scrollIntoView({ block: 'center' });
        }
      }
    });

    async function loadOrderDetail(id, detailRow) {
      const res = await fetch('/don-hang/' + id + '/detail');
      const data = await res.json();
      if (!data.success) return alert(data.message || 'Không tải được đơn hàng');
      const order = data.data.order;
      const shipment = data.data.shipment;
      const invoice = data.data.invoice;
      const items = data.data.items || [];
      orderDetailCache[id] = data.data;
      const totalGoods = items.reduce((sum, item) => sum + Number(item.thanh_tien || 0), 0);
      const discount = Math.max(totalGoods - Number(order.tong_thanh_toan || order.tong_tien || 0), 0);
      detailRow.querySelector('.order-detail').innerHTML = renderOrderDetail(order, shipment, invoice, items, totalGoods, discount);
      detailRow.dataset.loaded = 'true';
    }

    function renderOrderDetail(order, shipment, invoice, items, totalGoods, discount) {
      const customer = order.khach_hang_id || {};
      if (order.trang_thai === 'merged') {
        const mergedTarget = order.merged_to_don_hang_id
          ? refAnchor('/don-hang?order=' + encodeURIComponent(order.merged_to_don_hang_id), order.merged_to_ma_don_hang || 'đơn nhận')
          : escapeHtml(order.merged_to_ma_don_hang || 'đơn khác');
        return `
          <div class="detail-tabs"><button type="button" class="detail-tab">Thông tin</button></div>
          <div class="delivery-box">
            <strong>Đơn này đã được gộp vào ${mergedTarget}</strong>
            <div style="margin-top:8px;color:#667085">Đơn nguồn đã gộp không còn xử lý riêng. Vui lòng thao tác trên đơn nhận.</div>
          </div>
        `;
      }
      const receiver = shipment?.ten_nguoi_nhan || customer.ten_khach_hang || '';
      const phone = shipment?.sdt_nguoi_nhan || customer.sdt || '';
      const address = shipment?.dia_chi_nhan || customer.dia_chi_day_du || '';
      const itemRows = items.map(item => {
        const product = item.hang_hoa_id || {};
        const deliveryStatus = deliveryStatusLabels[item.trang_thai_giao] || deliveryStatusLabels.chua_giao;
        const attributeLabel = item.ten_thuoc_tinh || item.ten_quy_cach || '';
        return `<tr>
          <td>${refAnchor(product._id ? '/hang-hoa/' + product._id : '', product.ma_hang || '')}</td>
          <td>${escapeHtml(product.ten_hang || '')}</td>
          <td class="num">${money(item.so_luong_dat || item.so_luong || 0)}</td>
          <td class="num">${money(item.so_luong_xac_nhan || 0)}</td>
          <td class="num">${money(item.so_luong_da_giao || 0)}</td>
          <td class="num">${money(item.so_luong_con_thieu || 0)}</td>
          <td>${escapeHtml(deliveryStatus)}</td>
          <td>${escapeHtml(attributeLabel || 'Không có')}</td>
          <td class="num">${moneyText(item.chiet_khau)}</td>
          <td class="num">${moneyText(item.don_gia_ban)}</td>
          <td class="num"><strong>${moneyText(item.thanh_tien)}</strong></td>
        </tr>`;
      }).join('') || '<tr><td colspan="11" class="loading-detail">Đơn chưa có hàng hóa</td></tr>';
      const invoiceAction = invoice
        ? `<a class="btn solid" href="/don-hang/tra-hang/create?invoice_id=${invoice._id}"><i class="fa-solid fa-rotate-left"></i> Trả hàng</a>`
        : `<a class="btn solid" href="/don-hang/hoa-don/create?don_hang_id=${order._id}"><i class="fa-solid fa-file-invoice-dollar"></i> Tạo hóa đơn</a>`;
      const deliveryComplete = order.trang_thai_giao_hang === 'giao_du';
      const paidAmount = Number(order.khach_thanh_toan || 0);
      const payableAmount = Number(order.tong_thanh_toan || order.tong_tien || 0);
      const remainingAmount = Math.max(payableAmount - paidAmount, 0);
      const lockedBlueActions = deliveryComplete
        ? `<button type="button" class="btn disabled-action" onclick="showLockedAction('Xử lý đơn hàng')"><i class="fa-solid fa-truck-fast"></i> Xử lý đơn hàng</button><button type="button" class="btn disabled-action" onclick="showLockedAction('Xác nhận giao')"><i class="fa-solid fa-box-open"></i> Xác nhận giao</button><button type="button" class="btn disabled-action" onclick="showLockedAction('Tạo hóa đơn')"><i class="fa-solid fa-file-invoice-dollar"></i> Tạo hóa đơn</button>`
        : `<button type="button" class="btn solid" onclick="updateOrderStatus('${order._id}','shipping')"><i class="fa-solid fa-truck-fast"></i> Xử lý đơn hàng</button><button type="button" class="btn solid" onclick="confirmDelivery('${order._id}')"><i class="fa-solid fa-box-open"></i> Xác nhận giao</button>${invoiceAction}`;
      const receiptAction = remainingAmount > 0
        ? `<div class="totals-receipt-action"><button type="button" class="btn solid" onclick="openReceiptPayModal('${order._id}', ${remainingAmount})"><i class="fa-solid fa-money-bill-wave"></i> Tạo phiếu thu</button></div>`
        : '';
      const mergedFromIds = Array.isArray(order.merged_from_don_hang_ids) ? order.merged_from_don_hang_ids : [];
      const mergedFromCodes = Array.isArray(order.merged_from_ma_don_hangs) ? order.merged_from_ma_don_hangs : [];
      const mergedFromLine = order.is_merged_order && mergedFromCodes.length
        ? `<div style="margin-top:8px;color:#667085;font-size:13px">Được gộp từ: ${mergedFromCodes.map((code, index) => {
            const sourceId = mergedFromIds[index];
            return sourceId ? refAnchor('/don-hang?order=' + encodeURIComponent(sourceId), code) : escapeHtml(code);
          }).join(', ')}</div>`
        : '';

      return `
        <div class="detail-tabs"><button type="button" class="detail-tab">Thông tin</button></div>
        <div class="detail-head">
          <div>
            <div><span class="detail-title">${escapeHtml(customer.ten_khach_hang || 'Khách lẻ')}</span> <span>${refAnchor(order._id ? '/don-hang/' + order._id : '', order.ma_don_hang || '')}</span></div>
            ${mergedFromLine}
            <div class="detail-meta">
              <div class="mini-field"><label>Người tạo</label><span>${escapeHtml(order.nguoi_tao_id?.ho_ten || order.nguoi_tao_id?.username || '')}</span></div>
              <div class="mini-field"><label>Người nhận đặt</label><input class="mini-input" value="${escapeHtml(order.nguoi_tao_id?.ho_ten || order.nguoi_tao_id?.username || '')}"></div>
              <div class="mini-field"><label>Ngày đặt</label><input class="mini-input" value="${escapeHtml(new Date(order.ngay_dat || order.created_at).toLocaleString('vi-VN'))}"></div>
              <div class="mini-field"><label>Kênh bán</label><input class="mini-input" value="Bán trực tiếp"></div>
              <div class="mini-field"><label>Bảng giá</label><input class="mini-input" value="Bảng giá chung"></div>
              <div class="mini-field"><label>Trạng thái</label><select class="mini-select" onchange="updateOrderStatus('${order._id}',this.value)">${['draft','shipping','completed','cancelled'].map(status => `<option value="${status}" ${order.trang_thai === status ? 'selected' : ''}>${statusLabels[status]}</option>`).join('')}</select></div>
            </div>
          </div>
          <div>${escapeHtml(order.cua_hang_id?.ten_cua_hang || 'Cửa hàng trung tâm')}</div>
        </div>
        <div class="delivery-box">
          <div class="delivery-title"><span><i class="fa-regular fa-hand-point-right"></i> Tự giao đến: <strong>${escapeHtml(address || 'Chưa có địa chỉ giao hàng')}</strong></span><i class="fa-solid fa-chevron-up"></i></div>
          <div class="delivery-grid">
            <div class="mini-field"><label>Người nhận</label><input class="mini-input" value="${escapeHtml(receiver)}"></div>
            <div class="mini-field"><label>Mã vận đơn</label><span>${refAnchor(shipment?._id ? '/don-hang/van-don/' + shipment._id : '', shipment?.ma_van_don || '')}</span></div>
            <div class="mini-field"><label>Người giao</label><input class="mini-input" value="${escapeHtml(shipment?.doi_tac_giao_hang_id?.ten_doi_tac || 'Tự giao hàng')}"></div>
            <div class="mini-field"><label>Điện thoại</label><input class="mini-input" value="${escapeHtml(phone)}"></div>
            <div class="mini-field"><label>Trọng lượng</label><input class="mini-input" value="500 g"></div>
            <div class="mini-field"><label>Thu hộ tiền</label><input type="checkbox" checked></div>
            <div class="mini-field"><label>Địa chỉ</label><input class="mini-input" value="${escapeHtml(address)}"></div>
            <div class="mini-field"><label>Dịch vụ</label><input class="mini-input" value="Giao thường"></div>
            <div class="mini-field"><label>Phí trả ĐTGH</label><input class="mini-input" value="${money(shipment?.phi_giao_hang || 0)}"></div>
          </div>
          <textarea class="note js-shipment-note" data-order-id="${order._id}" placeholder="Ghi chú giao...">${escapeHtml(shipment?.ghi_chu || '')}</textarea>
        </div>
        <table class="items-table"><thead><tr><th>Mã hàng</th><th>Tên hàng</th><th class="num">SL đặt</th><th class="num">SL xác nhận</th><th class="num">SL đã giao</th><th class="num">SL còn thiếu</th><th>Trạng thái giao</th><th>Thuộc tính</th><th class="num">Giảm giá</th><th class="num">Giá bán</th><th class="num">Thành tiền</th></tr></thead><tbody>${itemRows}</tbody></table>
        <div class="detail-bottom">
          <textarea class="note js-order-note" data-order-id="${order._id}" placeholder="Ghi chú...">${escapeHtml(order.ghi_chu || '')}</textarea>
          <div class="totals">
            <div class="total-line"><span>Tổng tiền hàng (${items.length})</span><strong>${moneyText(totalGoods)}</strong></div>
            <div class="total-line"><span>Giảm giá phiếu đặt</span><span>${moneyText(discount)}</span></div>
            <div class="total-line"><span>Tổng cộng</span><strong>${moneyText(order.tong_thanh_toan || order.tong_tien)}</strong></div>
            <div class="total-line"><span>Khách đã trả</span><span>${moneyText(paidAmount)}</span></div>
            <div class="total-line"><span>Còn cần thanh toán</span><strong>${moneyText(remainingAmount)}</strong></div>
            ${receiptAction}
          </div>
        </div>
        <div class="page-actions page-actions--split page-actions--bordered detail-actions">
          <div class="page-actions__left detail-action-group"><button type="button" class="btn" onclick="deleteOrder('${order._id}')"><i class="fa-regular fa-trash-can"></i> Hủy</button><a class="btn" href="/don-hang/create?copy_from=${order._id}"><i class="fa-regular fa-copy"></i> Sao chép</a><a class="btn" href="/don-hang/${order._id}/export.xlsx"><i class="fa-solid fa-file-export"></i> Xuất file</a></div>
          <div class="page-actions__right detail-action-group">${lockedBlueActions}<button type="button" class="btn" onclick="saveOrderDetail('${order._id}')"><i class="fa-regular fa-floppy-disk"></i> Lưu</button><button type="button" class="btn" onclick="finishOrder('${order._id}', '${order.trang_thai_giao_hang || 'chua_giao'}')"><i class="fa-regular fa-circle-check"></i> Kết thúc</button><a class="btn" href="/chung-tu-kho/ban-hang/${order._id}" target="_blank"><i class="fa-solid fa-print"></i> Mở riêng</a></div>
        </div>`;
    }

    async function updateOrderStatus(id, status, forceCompleteShort = false) {
      const res = await fetch('/don-hang/' + id + '/status', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ trang_thai: status, force_complete_short: forceCompleteShort }) });
      const data = await res.json();
      if (!data.success) return alert(data.message || 'Không cập nhật được trạng thái');
      location.reload();
    }

    function showLockedAction(buttonName) {
      document.getElementById('lockedActionMessage').textContent = `Đơn đã hoàn thành, không thể thao tác nút "${buttonName}".`;
      document.getElementById('lockedActionOverlay').style.display = 'flex';
    }

    function closeLockedActionModal() {
      document.getElementById('lockedActionOverlay').style.display = 'none';
    }

    function openReceiptPayModal(orderId, dueAmount) {
      pendingReceiptOrderId = orderId;
      pendingReceiptDue = Math.max(0, Number(dueAmount || 0));
      document.getElementById('receiptPayDue').textContent = 'Khách còn nợ đơn hàng này: ' + moneyText(pendingReceiptDue);
      document.getElementById('receiptPayAmount').value = money(pendingReceiptDue);
      document.getElementById('receiptPayMethod').value = 'tien_mat';
      document.getElementById('receiptPayOverlay').style.display = 'flex';
    }

    function closeReceiptPayModal() {
      pendingReceiptOrderId = '';
      pendingReceiptDue = 0;
      document.getElementById('receiptPayOverlay').style.display = 'none';
    }

    async function submitReceiptPayModal() {
      const amount = num(document.getElementById('receiptPayAmount')?.value);
      if (!pendingReceiptOrderId || amount <= 0) return alert('Vui lòng nhập số tiền thu.');
      if (amount > pendingReceiptDue) return alert('Khách chỉ còn nợ ' + moneyText(pendingReceiptDue));
      const res = await fetch('/don-hang/' + pendingReceiptOrderId + '/phieu-thu', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          gia_tri: amount,
          phuong_thuc_thanh_toan: document.getElementById('receiptPayMethod')?.value || 'tien_mat'
        })
      });
      const data = await res.json();
      if (!data.success) return alert(data.message || 'Không tạo được phiếu thu');
      location.reload();
    }

    async function finishOrder(id, deliveryStatus) {
      if (deliveryStatus !== 'giao_du' && !confirm('Đơn chưa giao đủ. Xác nhận kết thúc thiếu?')) return;
      await updateOrderStatus(id, 'completed', deliveryStatus !== 'giao_du');
    }

    async function confirmDelivery(id) {
      const detail = orderDetailCache[id];
      if (!detail) return alert('Vui lòng mở lại chi tiết đơn trước khi xác nhận giao.');
      const order = detail.order || {};
      const items = detail.items || [];
      const khoId = order.kho_id?._id || order.kho_id;
      if (!khoId) return alert('Đơn chưa có kho giao hàng.');
      const rows = items.map(item => {
        const missing = Number(item.so_luong_con_thieu || item.so_luong_dat || item.so_luong || 0);
        if (missing <= 0) return '';
        const product = item.hang_hoa_id || {};
        const attributeLabel = item.ten_thuoc_tinh || item.ten_quy_cach || 'Không có';
        return `<tr data-delivery-line
          data-ct-id="${escapeHtml(item._id || '')}"
          data-product-id="${escapeHtml(product._id || item.hang_hoa_id || '')}"
          data-lot-id="${escapeHtml(item.lo_hang_id || '')}">
          <td>${escapeHtml(product.ma_hang || '')}</td>
          <td>${escapeHtml(product.ten_hang || '')}</td>
          <td>${escapeHtml(attributeLabel)}</td>
          <td class="num">${money(item.so_luong_dat || item.so_luong || 0)}</td>
          <td class="num">${money(item.so_luong_da_giao || 0)}</td>
          <td class="num" data-missing="${missing}">${money(missing)}</td>
          <td class="num"><input value="${missing}" inputmode="decimal" data-delivery-qty></td>
        </tr>`;
      }).filter(Boolean).join('');
      if (!rows) return alert('Đơn hàng không còn dòng cần giao.');
      pendingDeliveryPaymentDue = Math.max(Number(order.tong_thanh_toan || order.tong_tien || 0) - Number(order.khach_thanh_toan || 0), 0);
      pendingDeliveryOrderId = id;
      document.getElementById('deliveryConfirmBody').innerHTML = rows;
      document.getElementById('deliveryPaymentDue').textContent = `Khách còn cần thanh toán: ${moneyText(pendingDeliveryPaymentDue)}`;
      document.getElementById('deliveryPaidInput').value = '0';
      document.getElementById('deliveryPaymentMethod').value = 'tien_mat';
      document.getElementById('deliveryConfirmError').style.display = 'none';
      document.getElementById('deliveryConfirmOverlay').style.display = 'flex';
    }

    function closeDeliveryConfirmModal() {
      pendingDeliveryOrderId = '';
      pendingDeliveryPaymentDue = 0;
      document.getElementById('deliveryConfirmOverlay').style.display = 'none';
    }

    async function submitDeliveryConfirmModal() {
      const id = pendingDeliveryOrderId;
      const detail = orderDetailCache[id];
      if (!id || !detail) return closeDeliveryConfirmModal();
      const order = detail.order || {};
      const khoId = order.kho_id?._id || order.kho_id;
      const deliveryItems = Array.from(document.querySelectorAll('[data-delivery-line]')).map(row => {
        const quantity = Number(String(row.querySelector('[data-delivery-qty]')?.value || '').replace(',', '.'));
        return {
          ct_don_hang_id: row.dataset.ctId,
          hang_hoa_id: row.dataset.productId,
          lo_hang_id: row.dataset.lotId || '',
          so_luong_giao: quantity
        };
      }).filter(item => Number.isFinite(item.so_luong_giao) && item.so_luong_giao > 0);
      if (!deliveryItems.length) return alert('Chưa có số lượng giao.');
      const extraPaid = num(document.getElementById('deliveryPaidInput')?.value);
      if (extraPaid > pendingDeliveryPaymentDue) {
        return alert('Khách chỉ còn cần thanh toán ' + moneyText(pendingDeliveryPaymentDue));
      }
      const res = await fetch('/don-hang/' + id + '/xac-nhan-giao', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          kho_id: khoId,
          items: deliveryItems,
          khach_thanh_toan: extraPaid,
          phuong_thuc_thanh_toan: document.getElementById('deliveryPaymentMethod')?.value || 'tien_mat'
        })
      });
      const data = await res.json();
      if (!data.success) return alert(data.message || 'Không xác nhận giao được.');
      location.reload();
    }

    async function deleteOrder(id) {
      if (!confirm('Hủy đơn đặt hàng này?')) return;
      await updateOrderStatus(id, 'cancelled');
    }

    async function saveOrderDetail(id) {
      const detailRow = document.querySelector('[data-order-detail="' + id + '"]');
      const panel = detailRow?.querySelector('.order-detail');
      if (!panel) return alert('Vui lòng mở chi tiết đơn trước khi lưu.');
      const deliveryInputs = panel.querySelectorAll('.delivery-grid .mini-input');
      const payload = {
        ghi_chu: panel.querySelector('.js-order-note')?.value || '',
        shipment: {
          ten_nguoi_nhan: deliveryInputs[0]?.value || '',
          sdt_nguoi_nhan: deliveryInputs[3]?.value || '',
          dia_chi_nhan: deliveryInputs[6]?.value || '',
          ghi_chu: panel.querySelector('.js-shipment-note')?.value || ''
        }
      };
      const res = await fetch('/don-hang/' + id + '/detail', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const data = await res.json();
      if (!data.success) return alert(data.message || 'Không lưu được đơn hàng');
      alert(data.message || 'Đã lưu thông tin đơn hàng');
    }

    (function initOrderMergeModal() {
      const overlay = document.getElementById('orderMergeModalOverlay');
      const openBtn = document.getElementById('openOrderMergeModal');
      const closeBtn = document.getElementById('orderMergeModalClose');
      const cancelBtn = document.getElementById('orderMergeCancel');
      const rowsEl = document.getElementById('orderMergeRows');
      const emptyEl = document.getElementById('orderMergeEmpty');
      const emptyTitleEl = document.getElementById('orderMergeEmptyTitle');
      const emptyDescEl = document.getElementById('orderMergeEmptyDesc');
      const footEl = document.getElementById('orderMergeFoot');
      const customerSelect = document.getElementById('orderMergeCustomerSelect');
      const modalCheckAll = document.getElementById('orderMergeCheckAll');
      const submitBtn = document.getElementById('orderMergeSubmit');
      const selectAll = document.querySelector('.table thead .row-check');
      const orderChecks = Array.from(document.querySelectorAll('.order-select-check'));
      let modalOrders = [];

      function readOrder(row) {
        return {
          id: row.dataset.orderId || '',
          code: row.dataset.orderCode || '',
          date: new Date(row.dataset.orderDate || ''),
          status: row.dataset.orderStatus || '',
          deliveryStatus: row.dataset.deliveryStatus || '',
          customerId: row.dataset.customerId || '',
          customerCode: row.dataset.customerCode || '',
          customerName: row.dataset.customerName || 'Khách lẻ',
          customerKey: row.dataset.customerId || row.dataset.customerCode || '',
          payable: Number(row.dataset.payable || 0),
          paid: Number(row.dataset.paid || 0)
        };
      }

      function isUndeliveredOrder(order) {
        return order.deliveryStatus === 'chua_giao';
      }

      function getModalCustomers(orders) {
        const map = new Map();
        orders.forEach(order => {
          if (!order.customerKey) return;
          if (!map.has(order.customerKey)) {
            map.set(order.customerKey, {
              key: order.customerKey,
              code: order.customerCode,
              name: order.customerName || 'Khách lẻ'
            });
          }
        });
        return Array.from(map.values()).sort((a, b) => a.name.localeCompare(b.name, 'vi'));
      }

      function renderCustomerOptions(orders) {
        if (!customerSelect) return;
        const customers = getModalCustomers(orders);
        customerSelect.innerHTML = '<option value="">Tất cả khách hàng</option>' + customers.map(customer => {
          const label = [customer.code, customer.name].filter(Boolean).join(' - ');
          return `<option value="${escapeHtml(customer.key)}">${escapeHtml(label)}</option>`;
        }).join('');
      }

      function getFilteredModalOrders() {
        const customerKey = customerSelect?.value || '';
        return customerKey ? modalOrders.filter(order => order.customerKey === customerKey) : modalOrders;
      }

      function updateModalCheckAll() {
        if (!modalCheckAll) return;
        const rowChecks = Array.from(document.querySelectorAll('.order-merge-row-check'));
        modalCheckAll.checked = rowChecks.length > 0 && rowChecks.every(cb => cb.checked);
        modalCheckAll.indeterminate = rowChecks.some(cb => cb.checked) && !modalCheckAll.checked;
      }

      function renderRows(orders, emptyTitle, emptyDesc) {
        if (!rowsEl || !emptyEl || !footEl) return;
        const hasRows = orders.length > 0;
        rowsEl.innerHTML = hasRows ? orders.map(order => `
          <tr>
            <td class="order-merge-check"><input class="order-merge-row-check" type="checkbox" value="${escapeHtml(order.id)}" data-customer-key="${escapeHtml(order.customerKey)}"></td>
            <td>${escapeHtml(order.code)}</td>
            <td>${escapeHtml(Number.isFinite(order.date.getTime()) ? order.date.toLocaleString('vi-VN') : '')}</td>
            <td class="num">${moneyText(order.payable)}</td>
            <td class="num">${moneyText(order.paid)}</td>
            <td>${escapeHtml(order.customerCode)}</td>
            <td>${escapeHtml(order.customerName)}</td>
          </tr>
        `).join('') : '';
        if (emptyTitleEl) emptyTitleEl.textContent = emptyTitle || 'Không có đơn hàng chưa giao';
        if (emptyDescEl) emptyDescEl.textContent = emptyDesc || '';
        emptyEl.style.display = hasRows ? 'none' : 'flex';
        footEl.style.display = hasRows ? 'flex' : 'none';
        updateModalCheckAll();
        document.querySelectorAll('.order-merge-row-check').forEach(cb => cb.addEventListener('change', updateModalCheckAll));
      }

      function refreshModalRows() {
        const filteredOrders = getFilteredModalOrders();
        renderRows(filteredOrders, 'Không có đơn hàng chưa giao', 'Không có đơn hàng phù hợp với khách hàng đang chọn.');
      }

      async function submitMergeOrders() {
        const selectedIds = Array.from(document.querySelectorAll('.order-merge-row-check:checked')).map(cb => cb.value).filter(Boolean);
        if (selectedIds.length < 2) {
          return alert('Vui lòng chọn ít nhất 2 đơn để gộp.');
        }
        const selectedCustomerKeys = new Set(
          Array.from(document.querySelectorAll('.order-merge-row-check:checked'))
            .map(cb => cb.dataset.customerKey || '')
            .filter(Boolean)
        );
        if (selectedCustomerKeys.size > 1) {
          return alert('Chỉ được gộp các đơn thuộc cùng một khách hàng.');
        }
        if (submitBtn) submitBtn.disabled = true;
        try {
          const res = await fetch('/api/don-hang/gop-don', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ don_hang_ids: selectedIds })
          });
          const data = await res.json();
          if (!data.success) return alert(data.message || 'Không gộp được đơn.');
          window.location.href = '/don-hang?order=' + encodeURIComponent(data.data?.don_nhan_id || selectedIds[0]);
        } catch (error) {
          alert('Không gộp được đơn.');
        } finally {
          if (submitBtn) submitBtn.disabled = false;
        }
      }

      function openModal() {
        if (!overlay) return;
        const allRows = Array.from(document.querySelectorAll('.order-row'));
        modalOrders = allRows.map(readOrder).filter(isUndeliveredOrder);
        renderCustomerOptions(modalOrders);
        if (customerSelect) customerSelect.value = '';
        renderRows(modalOrders, 'Không có đơn hàng chưa giao', 'Danh sách hiện tại không có đơn hàng nào ở trạng thái Chưa giao.');
        overlay.style.display = 'flex';
      }

      function closeModal() {
        if (overlay) overlay.style.display = 'none';
      }

      if (selectAll) {
        selectAll.addEventListener('click', e => {
          e.stopPropagation();
          orderChecks.forEach(cb => { cb.checked = selectAll.checked; });
        });
      }
      orderChecks.forEach(cb => {
        cb.addEventListener('change', () => {
          if (!selectAll) return;
          selectAll.checked = orderChecks.length > 0 && orderChecks.every(item => item.checked);
          selectAll.indeterminate = orderChecks.some(item => item.checked) && !selectAll.checked;
        });
      });
      if (openBtn) openBtn.addEventListener('click', openModal);
      if (closeBtn) closeBtn.addEventListener('click', closeModal);
      if (cancelBtn) cancelBtn.addEventListener('click', closeModal);
      if (submitBtn) submitBtn.addEventListener('click', submitMergeOrders);
      if (customerSelect) customerSelect.addEventListener('change', refreshModalRows);
      if (modalCheckAll) {
        modalCheckAll.addEventListener('change', () => {
          document.querySelectorAll('.order-merge-row-check').forEach(cb => { cb.checked = modalCheckAll.checked; });
          updateModalCheckAll();
        });
      }
      document.addEventListener('keydown', e => {
        if (e.key === 'Escape' && overlay?.style.display === 'flex') closeModal();
      });
    })();

    (function initOrderExportModal() {
      const overlay = document.getElementById('orderExportModalOverlay');
      const openBtn = document.getElementById('openOrderExportModal');
      const closeBtn = document.getElementById('orderExportModalClose');
      const cancelBtn = document.getElementById('orderExportCancel');
      const deselectBtn = document.getElementById('orderExportDeselectAll');
      const submitBtn = document.getElementById('orderExportSubmit');
      const errorEl = document.getElementById('orderExportError');
      const form = document.getElementById('orderExportForm');
      const formInputs = document.getElementById('orderExportFormInputs');

      function updateGroupCounts() {
        document.querySelectorAll('[data-export-group-count]').forEach(counter => {
          const groupId = counter.getAttribute('data-export-group-count');
          const total = document.querySelectorAll('.order-export-col-cb[data-export-group="' + groupId + '"]').length;
          const checked = document.querySelectorAll('.order-export-col-cb[data-export-group="' + groupId + '"]:checked').length;
          counter.textContent = checked + '/' + total;
        });
      }

      function openModal() {
        if (!overlay) return;
        overlay.style.display = 'flex';
        if (errorEl) errorEl.style.display = 'none';
        updateGroupCounts();
      }

      function closeModal() {
        if (overlay) overlay.style.display = 'none';
      }

      if (openBtn) openBtn.addEventListener('click', openModal);
      if (closeBtn) closeBtn.addEventListener('click', closeModal);
      if (cancelBtn) cancelBtn.addEventListener('click', closeModal);
      if (overlay) {
        overlay.addEventListener('click', e => {
          if (e.target === overlay) closeModal();
        });
      }
      if (deselectBtn) {
        deselectBtn.addEventListener('click', () => {
          document.querySelectorAll('.order-export-col-cb').forEach(cb => { cb.checked = false; });
          updateGroupCounts();
        });
      }
      document.querySelectorAll('.order-export-col-cb').forEach(cb => {
        cb.addEventListener('change', updateGroupCounts);
      });
      updateGroupCounts();

      if (submitBtn) {
        submitBtn.addEventListener('click', () => {
          const selected = Array.from(document.querySelectorAll('.order-export-col-cb')).filter(cb => cb.checked);
          if (!selected.length) {
            if (errorEl) errorEl.style.display = 'block';
            return;
          }
          if (errorEl) errorEl.style.display = 'none';
          if (formInputs) {
            formInputs.innerHTML = '';
            selected.forEach(cb => {
              const input = document.createElement('input');
              input.type = 'hidden';
              input.name = 'columns';
              input.value = cb.value;
              formInputs.appendChild(input);
            });
          }
          if (form) form.submit();
        });
      }
    })();
  </script>
</body>
</html>
