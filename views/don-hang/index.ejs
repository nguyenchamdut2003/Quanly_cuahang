    .order-page-link.is-disabled{color:#94a3b8;background:#f8fafc;pointer-events:none}
    .order-page-current{font-weight:800;color:#111827}
    @media(max-width:760px){.actions{flex-wrap:wrap;justify-content:flex-end}.order-merge-overlay{padding:8px}.order-merge-head{padding:18px 18px 12px}.order-merge-body{padding:14px 18px 22px}.order-merge-head h3{font-size:20px}.order-merge-desc{font-size:15px}.order-merge-table{min-width:840px}.order-merge-empty{min-height:260px}.order-merge-empty .empty-icon{width:112px;height:112px;font-size:40px;box-shadow:inset 0 0 0 16px #dcecff}}
  </style>
</head>
<body>
  <%- include('../partials/header') %>
  <form id="filterForm" class="order-page" method="GET" action="/don-hang">
    <input type="hidden" name="page" id="orderPageInput" value="<%= safePagination.page %>">
    <div class="order-shell">
      <aside class="sidebar">
        <h1 class="title">Đặt hàng</h1>
        <div class="filter-block">
          <div class="filter-title">Thời gian</div>
          <label class="radio-line"><input type="radio" name="time_type" value="this_month" <%= safeFilters.time_type !== 'custom' ? 'checked' : '' %> onchange="submitOrderFilters()"><span class="radio-pill">Tháng này <i class="fa-solid fa-chevron-right"></i></span></label>
          <label class="radio-line"><input type="radio" name="time_type" value="custom" <%= safeFilters.time_type === 'custom' ? 'checked' : '' %>><span class="radio-pill">Tùy chỉnh <i class="fa-regular fa-calendar-days"></i></span></label>
          <div class="date-range"><input type="date" name="date_from" value="<%= safeFilters.date_from || '' %>"><input type="date" name="date_to" value="<%= safeFilters.date_to || '' %>"></div>
        </div>
        <div class="filter-block">
          <div class="filter-title">Trạng thái</div>
          <div class="tag-box">
            <% [['draft','Phiếu tạm'],['shipping','Đang giao hàng'],['completed','Hoàn thành'],['cancelled','Đã hủy'],['merged','Đã gộp']].forEach(([value,label]) => { %>
              <label class="tag" style="<%= selectedStatuses.includes(value) ? '' : 'background:#e8f3ff;color:#006dff' %>"><input class="status-check" type="checkbox" name="trang_thai" value="<%= value %>" <%= selectedStatuses.includes(value) ? 'checked' : '' %> onchange="submitOrderFilters()"> <%= label %> <i class="fa-solid fa-xmark"></i></label>
            <% }) %>
          </div>
        </div>
        <div class="filter-block"><div class="filter-title">Đối tác giao hàng</div><select name="doi_tac" class="filter-control" onchange="submitOrderFilters()"><option value="">Chọn đối tác giao hàng</option><% (locals.partners || []).forEach(p => { %><option value="<%= p._id %>" <%= String(safeFilters.doi_tac || '') === String(p._id) ? 'selected' : '' %>><%= p.ten_doi_tac %></option><% }) %></select></div>
        <div class="filter-block"><div class="filter-title">Thời gian giao hàng</div><label class="radio-line"><input type="radio" name="delivery_time_type" value="all" <%= safeFilters.delivery_time_type !== 'custom' ? 'checked' : '' %>><span class="radio-pill">Toàn thời gian <i class="fa-solid fa-chevron-right"></i></span></label><label class="radio-line"><input type="radio" name="delivery_time_type" value="custom" <%= safeFilters.delivery_time_type === 'custom' ? 'checked' : '' %>><span class="radio-pill">Tùy chỉnh <i class="fa-regular fa-calendar-days"></i></span></label><div class="date-range"><input type="date" name="delivery_from" value="<%= safeFilters.delivery_from || '' %>"><input type="date" name="delivery_to" value="<%= safeFilters.delivery_to || '' %>"></div></div>
        <div class="filter-block"><div class="filter-title">Khu vực giao hàng</div><input name="khu_vuc" value="<%= safeFilters.khu_vuc || '' %>" class="filter-control" placeholder="Chọn Tỉnh/Thành phố"></div>
        <div class="filter-block"><div class="filter-title">Phương thức thanh toán</div><select name="phuong_thuc_tt" class="filter-control" onchange="submitOrderFilters()"><option value="">Chọn phương thức thanh toán...</option><option value="COD" <%= safeFilters.phuong_thuc_tt === 'COD' ? 'selected' : '' %>>COD</option></select></div>
        <div class="filter-block"><div class="filter-title">Người tạo</div><input name="nguoi_tao" value="<%= safeFilters.nguoi_tao || '' %>" list="userList" class="filter-control" placeholder="Chọn người tạo"></div>
        <div class="filter-block"><div class="filter-title">Người nhận đặt</div><input name="nguoi_nhan" value="<%= safeFilters.nguoi_nhan || '' %>" class="filter-control" placeholder="Chọn người nhận đặt"></div>
        <datalist id="userList"><% safeUsers.forEach(u => { %><option value="<%= u.ho_ten || u.username %>"></option><% }) %></datalist>
        <button type="submit" class="btn primary" style="width:100%;justify-content:center">Lọc</button>
      </aside>
      <main class="main">
        <div class="toolbar">
          <div class="search"><i class="fa-solid fa-magnifying-glass"></i><input name="q" value="<%= safeFilters.q || '' %>" placeholder="Theo mã phiếu đặt"><button type="submit"><i class="fa-solid fa-sliders"></i></button></div>
          <div class="actions">
            <a class="btn primary" href="/don-hang/create"><i class="fa-solid fa-plus"></i> Đặt hàng</a>
            <button type="button" class="btn" id="openOrderMergeModal"><i class="fa-regular fa-copy"></i> Gộp đơn</button>
            <button type="button" class="btn" id="openOrderExportModal"><i class="fa-solid fa-file-export"></i> Xuất file <i class="fa-solid fa-chevron-down"></i></button>
            <button type="button" class="btn order-delete-btn" id="openOrderTrashModal"><i class="fa-regular fa-trash-can"></i> Xóa</button>
          </div>
        </div>
        <div class="table-wrap">
          <table class="table">
            <thead><tr><th class="check-col"><input class="row-check" type="checkbox"></th><th class="star-col"><i class="fa-regular fa-star"></i></th><th>Mã đặt hàng</th><th>Thời gian</th><th>Mã KH</th><th>Khách hàng</th><th class="num">Khách cần trả</th><th class="num">Khách đã trả</th><th>Trạng thái</th><th>Giao hàng</th></tr></thead>
            <tbody>
              <% if (safeOrders.length) { %>
                <% safeOrders.forEach(o => { %>
                  <tr class="order-row" data-order-row="<%= o._id %>" data-order-id="<%= o._id %>" data-order-code="<%= o.ma_don_hang || '' %>" data-order-date="<%= new Date(o.ngay_dat || o.created_at).toISOString() %>" data-order-status="<%= o.trang_thai || '' %>" data-delivery-status="<%= o.trang_thai_giao_hang || 'chua_giao' %>" data-customer-id="<%= o.khach_hang_id ? o.khach_hang_id._id : '' %>" data-customer-code="<%= o.khach_hang_id ? (o.khach_hang_id.ma_khach_hang || '') : '' %>" data-customer-name="<%= o.khach_hang_id ? (o.khach_hang_id.ten_khach_hang || '') : 'Khách lẻ' %>" data-customer-phone="<%= o.khach_hang_id ? (o.khach_hang_id.sdt || o.khach_hang_id.dien_thoai || '') : '' %>" data-payable="<%= Number(o.tong_thanh_toan || o.tong_tien || 0) %>" data-paid="<%= Number(o.khach_thanh_toan || 0) %>" onclick="toggleOrderDetail('<%= o._id %>')"><td class="check-col"><input class="row-check order-select-check" type="checkbox" value="<%= o._id %>" onclick="event.stopPropagation()"></td><td class="star-col"><i class="fa-regular fa-star"></i></td><td><%- refLink('order', o, o.ma_don_hang, 'onclick="event.stopPropagation()"') %></td><td><%= new Date(o.ngay_dat || o.created_at).toLocaleString('vi-VN') %></td><td><%- o.khach_hang_id ? refLink('customer', o.khach_hang_id, o.khach_hang_id.ma_khach_hang, 'onclick="event.stopPropagation()"') : '' %></td><td><%= o.khach_hang_id ? o.khach_hang_id.ten_khach_hang : 'Khách lẻ' %></td><td class="num"><%= fmtMoney(o.tong_thanh_toan || o.tong_tien) %></td><td class="num"><%= fmtMoney(o.khach_thanh_toan || 0) %></td><td><span class="status-badge <%= o.trang_thai %>"><%= statusText(o.trang_thai) %></span></td><td><span class="status-badge <%= o.trang_thai_giao_hang %>"><%= deliveryStatusText(o.trang_thai_giao_hang) %></span></td></tr>
                  <tr class="detail-row" data-order-detail="<%= o._id %>"><td class="detail-cell" colspan="10"><div class="order-detail"><div class="loading-detail">Đang tải thông tin đơn...</div></div></td></tr>
                <% }) %>
              <% } else { %>
                <tr><td colspan="10" class="empty"><div class="empty-wrap"><div class="empty-icon"><i class="fa-regular fa-inbox"></i></div><h3>Không tìm thấy kết quả</h3><p>Không tìm thấy giao dịch nào phù hợp trong tháng này.<br>Nhấn vào <a href="/don-hang">đây</a> để tiếp tục tìm kiếm.</p></div></td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
        <div class="order-pagination">
          <span class="order-page-size">Hiển thị 10 dòng/trang</span>
          <nav class="order-pagination-actions" aria-label="Phân trang đơn hàng">
            <% if (safePagination.page > 1) { %>
              <a class="order-page-link" href="<%= pageHref(1) %>">Đầu</a>
              <a class="order-page-link" href="<%= pageHref(safePagination.page - 1) %>">Trước</a>
            <% } else { %>
              <span class="order-page-link is-disabled">Đầu</span>
              <span class="order-page-link is-disabled">Trước</span>
            <% } %>
            <span class="order-page-current"><%= safePagination.page %> / <%= safePagination.totalPages %></span>
            <% if (safePagination.page < safePagination.totalPages) { %>
              <a class="order-page-link" href="<%= pageHref(safePagination.page + 1) %>">Sau</a>
              <a class="order-page-link" href="<%= pageHref(safePagination.totalPages) %>">Cuối</a>
            <% } else { %>
              <span class="order-page-link is-disabled">Sau</span>
              <span class="order-page-link is-disabled">Cuối</span>
            <% } %>
          </nav>
          <span><%= safePagination.from %> - <%= safePagination.to %> trong <%= safePagination.total %> đơn</span>
        </div>
      </main>
    </div>
  </form>

  <div id="orderTrashModalOverlay" class="order-trash-overlay" aria-hidden="true">
    <div class="order-trash-modal" role="dialog" aria-labelledby="orderTrashModalTitle" aria-modal="true">
      <div class="order-trash-head">
        <h3 id="orderTrashModalTitle">Xóa đơn hàng</h3>
        <button type="button" class="order-trash-close" id="orderTrashModalClose" aria-label="Đóng">×</button>
      </div>
      <div class="order-trash-body" id="orderTrashModalBody">
        <p class="order-trash-desc">Bạn có chắc chắn muốn xóa các đơn hàng đã chọn không?</p>
      </div>
      <div class="order-trash-foot">
        <button type="button" class="btn" id="orderTrashCancel">Không</button>
        <button type="button" class="btn danger" id="orderTrashConfirm">Có</button>
      </div>
    </div>
  </div>

  <div id="orderMergeModalOverlay" class="order-merge-overlay">
    <div class="order-merge-modal" role="dialog" aria-labelledby="orderMergeModalTitle" aria-modal="true">
      <div class="order-merge-head">
        <h3 id="orderMergeModalTitle">Gộp phiếu đặt hàng</h3>
        <button type="button" class="order-merge-close" id="orderMergeModalClose" aria-label="Đóng">×</button>
      </div>
      <div class="order-merge-body">
        <p class="order-merge-desc">Hệ thống hỗ trợ gộp các đơn đặt hàng đang <strong>chưa giao</strong> theo từng khách hàng thành 1 phiếu đặt hàng</p>
        <div class="order-merge-filter">
          <label for="orderMergeCustomerSelect">Khách hàng</label>
          <select id="orderMergeCustomerSelect"></select>
        </div>
        <div style="overflow:auto">
          <table class="order-merge-table">
            <thead>
              <tr>
                <th class="order-merge-check"><input id="orderMergeCheckAll" type="checkbox"></th>
                <th>Mã đặt hàng</th>
                <th>Thời gian</th>
                <th class="num">Khách cần trả</th>
                <th class="num">Khách đã trả</th>
                <th>Mã khách hàng</th>
                <th>Tên khách hàng</th>
              </tr>
            </thead>
            <tbody id="orderMergeRows"></tbody>
          </table>
        </div>
        <div id="orderMergeEmpty" class="order-merge-empty">
          <div class="empty-icon"><i class="fa-regular fa-inbox"></i></div>
          <strong id="orderMergeEmptyTitle">Không có đơn hàng chưa giao</strong>
          <span id="orderMergeEmptyDesc"></span>
        </div>
      </div>
      <div id="orderMergeFoot" class="order-merge-foot">
        <button type="button" class="btn" id="orderMergeCancel">Bỏ qua</button>
        <button type="button" class="btn primary" id="orderMergeSubmit">Gộp đơn</button>
      </div>
    </div>
  </div>

  <div id="orderExportModalOverlay" class="order-export-overlay">
    <div class="order-export-modal" role="dialog" aria-labelledby="orderExportModalTitle">
      <div class="order-export-head">
        <div>
          <h3 id="orderExportModalTitle">Tùy chọn cột hiển thị</h3>
          <p>Chọn ít nhất 1 cột để xuất file</p>
        </div>
        <button type="button" class="order-export-close" id="orderExportModalClose" aria-label="Đóng">×</button>
      </div>
      <div class="order-export-body">
        <% (exportColumnGroups || []).forEach(function(group) { %>
          <div class="order-export-group" data-export-group="<%= group.id %>">
            <div class="order-export-group-title">
              <span><%= group.title %></span>
              <span class="order-export-group-count" data-export-group-count="<%= group.id %>">0/<%= group.columns.length %></span>
            </div>
            <div class="order-export-grid">
              <% group.columns.forEach(function(col) { %>
                <label>
                  <input type="checkbox" class="order-export-col-cb" value="<%= col.key %>" data-export-group="<%= group.id %>"<%= col.default ? ' checked' : '' %>>
                  <%= col.header %>
                </label>
              <% }) %>
            </div>
          </div>
        <% }) %>
        <p id="orderExportError" class="order-export-error">Vui lòng chọn ít nhất 1 cột.</p>
      </div>
      <div class="order-export-foot">
        <button type="button" class="btn" id="orderExportDeselectAll">Bỏ chọn tất cả</button>
        <div style="display:flex;gap:8px">
          <button type="button" class="btn" id="orderExportCancel">Bỏ qua</button>
          <button type="button" class="btn primary" id="orderExportSubmit">Xuất file</button>
        </div>
      </div>
    </div>
  </div>

  <form id="orderExportForm" method="POST" action="/don-hang/export-excel" style="display:none">
    <div id="orderExportFormInputs"></div>
    <input type="hidden" name="q" value="<%= safeFilters.q || '' %>">
    <input type="hidden" name="time_type" value="<%= safeFilters.time_type || 'this_month' %>">
    <input type="hidden" name="date_from" value="<%= safeFilters.date_from || '' %>">
    <input type="hidden" name="date_to" value="<%= safeFilters.date_to || '' %>">
    <input type="hidden" name="doi_tac" value="<%= safeFilters.doi_tac || '' %>">
    <input type="hidden" name="delivery_time_type" value="<%= safeFilters.delivery_time_type || '' %>">
    <input type="hidden" name="delivery_from" value="<%= safeFilters.delivery_from || '' %>">
    <input type="hidden" name="delivery_to" value="<%= safeFilters.delivery_to || '' %>">
    <input type="hidden" name="khu_vuc" value="<%= safeFilters.khu_vuc || '' %>">
    <input type="hidden" name="phuong_thuc_tt" value="<%= safeFilters.phuong_thuc_tt || '' %>">
    <input type="hidden" name="nguoi_tao" value="<%= safeFilters.nguoi_tao || '' %>">
    <input type="hidden" name="nguoi_nhan" value="<%= safeFilters.nguoi_nhan || '' %>">
    <% selectedStatuses.forEach(function(status) { %>
      <input type="hidden" name="trang_thai" value="<%= status %>">
    <% }) %>
  </form>

  <div id="deliveryConfirmOverlay" class="delivery-confirm-overlay">
    <div class="delivery-confirm-modal" role="dialog" aria-labelledby="deliveryConfirmTitle">
      <div class="delivery-confirm-head">
        <div>
          <h3 id="deliveryConfirmTitle">Xác nhận giao hàng</h3>
          <div class="delivery-confirm-vat-chua">
            <span class="delivery-confirm-vat-label">Vật chứa</span>
            <div class="delivery-confirm-vat-combo">
              <select id="deliveryVatChuaId" title="Chọn vật chứa">
                <option value="">— Chọn —</option>
                <% (vatChuaList || []).forEach(function(vc) { %>
                  <option value="<%= vc._id %>"><%= vc.ten_vat_chua || '---' %></option>
                <% }) %>
              </select>
              <input id="deliveryVatChuaQty" value="" inputmode="numeric" placeholder="SL" title="Số lượng vật chứa">
            </div>
          </div>
        </div>
        <button type="button" class="delivery-confirm-close" onclick="closeDeliveryConfirmModal()">×</button>
      </div>
      <div class="delivery-confirm-body">
        <p id="deliveryConfirmError" class="delivery-confirm-error">Vui lòng nhập ít nhất một số lượng giao hợp lệ.</p>
        <table class="delivery-confirm-table">
          <thead>
            <tr>
              <th>Mã hàng</th>
              <th>Tên hàng</th>
              <th>Thuộc tính</th>
              <th class="num">SL đặt</th>
              <th class="num">Đã giao</th>
              <th class="num">Còn thiếu</th>
              <th class="num">SL giao</th>
              <th class="num">Đơn giá giao</th>
              <th class="num">Thành tiền</th>
            </tr>
          </thead>
          <tbody id="deliveryConfirmBody"></tbody>
        </table>
        <div id="deliveryPaymentDue" class="delivery-payment-due delivery-payment-due-lines"></div>
        <div class="delivery-confirm-payment">
          <label>Tiền mặt</label>
          <div class="delivery-pay-combo">
            <input id="deliveryCashInput" value="0" inputmode="numeric" oninput="refreshDeliveryPaymentSummary()">
            <button type="button" class="btn-pay-all" onclick="fillDeliveryPaymentAll('cash')">Tất cả</button>
          </div>
          <label>Chuyển khoản</label>
          <div class="delivery-pay-combo">
            <input id="deliveryTransferInput" value="0" inputmode="numeric" oninput="refreshDeliveryPaymentSummary()">
            <button type="button" class="btn-pay-all" onclick="fillDeliveryPaymentAll('transfer')">Tất cả</button>
          </div>
          <label>Tiền thừa</label>
          <input id="deliveryChangeInput" value="0" inputmode="numeric" oninput="refreshDeliveryPaymentSummary()">
          <label>Sổ quỹ</label>
          <select id="deliveryCashBookId">
            <option value="">Chọn sổ quỹ</option>
            <% (cashBooks || []).forEach(function(book) { %>
              <option value="<%= book._id %>"><%= book.ten_so_quy || 'Sổ quỹ' %></option>
            <% }) %>
          </select>
          <div id="deliveryPaymentSummary" class="delivery-payment-due"></div>
        </div>
      </div>
      <div class="delivery-confirm-foot">
        <button type="button" class="btn" onclick="closeDeliveryConfirmModal()">Bỏ qua</button>
        <button type="button" class="btn solid" id="deliveryConfirmSubmitBtn" onclick="submitDeliveryConfirmModal()">Xác nhận giao</button>
      </div>
    </div>
  </div>

  <div id="receiptPayModal" class="po-modal" role="dialog" aria-labelledby="receiptPayTitle">
    <div class="po-modal-card">
      <div class="po-modal-head">
        <h3 id="receiptPayTitle">Tạo phiếu thu</h3>
        <button type="button" class="po-modal-close" onclick="closeReceiptPayModal()">&times;</button>
      </div>
      <div class="quick-pay-grid">
        <label class="full"><span>Còn phải thu</span><div class="pay-total-readonly" id="receiptPayDue"></div></label>
        <label><span>Tiền mặt</span><input id="receiptPayCash" class="vn-pay-amount" inputmode="numeric" value="" placeholder="0"></label>
        <label><span>Chuyển khoản</span><input id="receiptPayTransfer" class="vn-pay-amount" inputmode="numeric" value="" placeholder="0"></label>
        <label class="full"><span>Tiền trả khách</span><input id="receiptPayChange" class="vn-pay-amount" inputmode="numeric" value="" placeholder="0"></label>
        <label class="full"><span>Tổng khách đưa</span><div class="pay-total-summary" id="receiptPayTongKhach">0 VNĐ</div></label>
        <label class="full"><span>Thực thu</span><div class="pay-total-readonly" id="receiptPayThucThu">0 VNĐ</div></label>
        <label class="full"><span>Còn phải thu sau thu</span><div class="pay-total-summary" id="receiptPayConLai">0 VNĐ</div></label>
        <label class="full" id="receiptPayErrorWrap" style="display:none"><span>Lưu ý</span><div class="pay-summary-error" id="receiptPayErrors"></div></label>
        <label class="full"><span>Sổ quỹ</span><select id="receiptPayCashBook" required>
          <option value="">— Chọn sổ quỹ —</option>
          <% (cashBooks || []).forEach(function(book) { %>
            <option value="<%= book._id %>"><%= book.ten_so_quy || 'Sổ quỹ' %></option>
          <% }) %>
        </select></label>
      </div>
      <div class="invoice-receipt-pay-foot">
        <button type="button" class="kv-btn primary" onclick="submitReceiptPayModal()">Tạo phiếu thu</button>
        <button type="button" class="kv-btn" onclick="closeReceiptPayModal()">Đóng</button>
      </div>
    </div>
  </div>

  <div id="lockedActionOverlay" class="receipt-pay-overlay">
    <div class="receipt-pay-modal" role="dialog" aria-labelledby="lockedActionTitle">
      <div class="receipt-pay-head">
        <h3 id="lockedActionTitle">Không thể thao tác</h3>
        <button type="button" class="delivery-confirm-close" onclick="closeLockedActionModal()">×</button>
      </div>
      <div class="receipt-pay-body">
        <div id="lockedActionMessage" class="locked-action-message"></div>
      </div>
      <div class="receipt-pay-foot">
        <button type="button" class="btn solid" onclick="closeLockedActionModal()">Đã hiểu</button>
      </div>
    </div>
  </div>

  <script>
    function submitOrderFilters() {
      const pageInput = document.getElementById('orderPageInput');
      const form = document.getElementById('filterForm');
      if (pageInput) pageInput.value = '1';
      if (!form) return;
      if (typeof form.requestSubmit === 'function') {
        form.requestSubmit();
      } else {
        form.submit();
      }
    }
    const money = value => Number(value || 0).toLocaleString('vi-VN');
    const moneyText = value => money(value) + ' VNĐ';
    const num = value => Number(String(value || '').replace(/\./g, '').replace(/,/g, '').replace(/[^\d]/g, '')) || 0;
    const numberValue = value => num(value);
    function applyLiveVNFormat(el) {
      if (!el) return;
      const start = el.selectionStart == null ? el.value.length : el.selectionStart;
      const digitsBefore = String(el.value).slice(0, start).replace(/\D/g, '').length;
      const raw = String(el.value).replace(/\./g, '').replace(/,/g, '').replace(/[^\d]/g, '');
      if (!raw) { el.value = ''; return; }
      const formatted = Number(raw).toLocaleString('vi-VN');
      el.value = formatted;
      let pos = formatted.length;
      if (digitsBefore > 0) {
        let digits = 0;
        for (let i = 0; i < formatted.length; i++) {
          if (/\d/.test(formatted[i])) {
            digits++;
            if (digits === digitsBefore) { pos = i + 1; break; }
          }
        }
      } else pos = 0;
      try { el.setSelectionRange(pos, pos); } catch (_) {}
    }
    function bindReceiptPayInput(el, refreshFn) {
      if (!el || el.dataset.vnBound === '1') return;
      el.dataset.vnBound = '1';
      el.addEventListener('input', function() {
        applyLiveVNFormat(el);
        refreshFn();
      });
    }
    const statusLabels = { draft: 'Phiếu tạm', shipping: 'Đang giao hàng', completed: 'Hoàn thành', cancelled: 'Đã hủy', merged: 'Đã gộp' };
    const deliveryStatusLabels = { chua_giao: 'Chưa giao', giao_mot_phan: 'Giao một phần', giao_thieu: 'Giao thiếu', giao_du: 'Giao đủ' };
    const deliveryStatusText = status => deliveryStatusLabels[status] || 'Chưa giao';
    const escapeHtml = value => String(value ?? '').replace(/[&<>"']/g, char => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[char]));
    const refAnchor = (href, text) => href ? `<a class="ref-link" href="${escapeHtml(href)}" onclick="event.stopPropagation()">${escapeHtml(text || '--')}</a>` : escapeHtml(text || '--');
    function formatOrderLotCell(item, product) {
      const lot = item.lo_hang_id || {};
      if (lot.ten_lo || lot.ma_lo) {
        const hsd = lot.han_su_dung ? ' HSD ' + new Date(lot.han_su_dung).toLocaleDateString('vi-VN') : '';
        return (lot.ten_lo || lot.ma_lo) + hsd;
      }
      if (product && product.quan_ly_theo_lo) return 'Chưa chốt lô';
      return 'Không có';
    }
    const orderDetailCache = {};
    let pendingDeliveryOrderId = '';
    let pendingDeliveryBatchPayable = 0;
    let pendingDeliveryPrepaidCredit = 0;
    let pendingDeliveryPaymentDue = 0;
    let pendingDeliverySubmitting = false;
    let pendingReceiptOrderId = '';
    let pendingReceiptDue = 0;

    function readCustomerPaymentFields(cashId, transferId, changeId) {
      const tien_mat = Math.max(0, numberValue(document.getElementById(cashId)?.value));
      const chuyen_khoan = Math.max(0, numberValue(document.getElementById(transferId)?.value));
      const tien_thua = Math.max(0, numberValue(document.getElementById(changeId)?.value));
      const tong_khach_dua = tien_mat + chuyen_khoan;
      const thuc_thu = Math.max(0, tong_khach_dua - tien_thua);
      return { tien_mat, chuyen_khoan, tien_thua, tong_khach_dua, thuc_thu };
    }

    function validateCustomerPayment(payment, dueAmount) {
      const errors = [];
      if (payment.tien_thua > payment.tong_khach_dua) errors.push('Tiền trả khách không được vượt tổng khách đưa');
      if (payment.tong_khach_dua > 0 && payment.thuc_thu <= 0) errors.push('Thực thu phải lớn hơn 0');
      if (payment.thuc_thu > dueAmount) errors.push('Thực thu không được vượt số còn phải thu');
      return errors;
    }

    function formatCustomerPaymentFields(cashId, transferId, changeId) {
      const cashEl = document.getElementById(cashId);
      const transferEl = document.getElementById(transferId);
      const changeEl = document.getElementById(changeId);
      if (cashEl) cashEl.value = money(numberValue(cashEl.value));
      if (transferEl) transferEl.value = money(numberValue(transferEl.value));
      if (changeEl) changeEl.value = money(numberValue(changeEl.value));
    }

    function renderReceiptPaySummary(payment, dueAmount) {
      const tongEl = document.getElementById('receiptPayTongKhach');
      const thucEl = document.getElementById('receiptPayThucThu');
      const conEl = document.getElementById('receiptPayConLai');
      const errWrap = document.getElementById('receiptPayErrorWrap');
      const errEl = document.getElementById('receiptPayErrors');
      const errors = validateCustomerPayment(payment, dueAmount);
      if (tongEl) tongEl.textContent = moneyText(payment.tong_khach_dua);
      if (thucEl) thucEl.textContent = moneyText(payment.thuc_thu);
      if (conEl) conEl.textContent = moneyText(Math.max(dueAmount - payment.thuc_thu, 0));
      if (errWrap && errEl) {
        if (errors.length) {
          errWrap.style.display = '';
          errEl.textContent = errors.join('. ');
        } else {
          errWrap.style.display = 'none';
          errEl.textContent = '';
        }
      }
      return errors;
    }
    const CHANGE_RECEIPT_TYPE = 'tra_tien_thua_khach';
    function receiptPaymentParts(receipt) {
      const detail = receipt?.chi_tiet_thanh_toan || {};
      return { cash: Number(detail.tien_mat || 0), transfer: Number(detail.chuyen_khoan || 0) };
    }
    function paymentSummaryFromReceipts(rows) {
      return (rows || []).reduce((sum, receipt) => {
        const amount = Math.abs(Number(receipt.gia_tri || 0));
        if (receipt.loai_phieu === 'thu') {
          const parts = receiptPaymentParts(receipt);
          sum.gross += amount;
          sum.cash += parts.cash;
          sum.transfer += parts.transfer;
        } else if (receipt.loai_phieu === 'chi' && receipt.loai_thu_chi === CHANGE_RECEIPT_TYPE) {
          sum.change += amount;
        }
        sum.net = Math.max(0, sum.gross - sum.change);
        return sum;
      }, { gross: 0, cash: 0, transfer: 0, change: 0, net: 0 });
    }
    function buildPaymentHistoryBox(receipts, paidAmount) {
      const summary = paymentSummaryFromReceipts(receipts);
      if (!summary.gross && !summary.change) return '';
      const rows = (receipts || []).map(receipt => {
        const amount = Math.abs(Number(receipt.gia_tri || 0));
        const parts = receiptPaymentParts(receipt);
        const isChange = receipt.loai_phieu === 'chi' && receipt.loai_thu_chi === CHANGE_RECEIPT_TYPE;
        const signedText = receipt.loai_phieu === 'chi' ? '-' + moneyText(amount) : moneyText(amount);
        return `<tr><td>${refAnchor(receipt._id ? '/so-quy/phieu-thu-chi/' + receipt._id : '', receipt.ma_phieu || '')}</td><td>${escapeHtml(receipt.ngay_lap ? new Date(receipt.ngay_lap).toLocaleString('vi-VN') : '')}</td><td>${escapeHtml(receipt.nguoi_tao_id?.ho_ten || '')}</td><td>${receipt.loai_phieu === 'thu' ? moneyText(amount) : ''}</td><td>${receipt.loai_phieu === 'thu' && (parts.cash || parts.transfer) ? moneyText(parts.cash) : ''}</td><td>${receipt.loai_phieu === 'thu' && (parts.cash || parts.transfer) ? moneyText(parts.transfer) : ''}</td><td>${isChange ? moneyText(amount) : ''}</td><td>${receipt.loai_phieu === 'chi' ? 'Chi' : 'Thu'}</td><td class="num">${signedText}</td></tr>`;
      }).join('');
      return `<div class="delivery-box"><div class="delivery-title"><span><i class="fa-solid fa-money-bill-wave"></i> Thanh toán</span></div><div class="delivery-grid" style="margin-bottom:10px"><div class="mini-field"><label>Tổng khách đưa</label><span>${moneyText(summary.gross)}</span></div><div class="mini-field"><label>Tiền mặt</label><span>${moneyText(summary.cash)}</span></div><div class="mini-field"><label>Chuyển khoản</label><span>${moneyText(summary.transfer)}</span></div><div class="mini-field"><label>Tiền thừa trả khách</label><span>${moneyText(summary.change)}</span></div><div class="mini-field"><label>Thực thu</label><span>${moneyText(Number(paidAmount ?? summary.net))}</span></div></div><table class="items-table"><thead><tr><th>Mã phiếu</th><th>Thời gian</th><th>Người tạo</th><th>Tổng khách đưa</th><th>Tiền mặt</th><th>Chuyển khoản</th><th>Tiền thừa</th><th>Loại</th><th class="num">Tiền thu/chi</th></tr></thead><tbody>${rows}</tbody></table></div>`;
    }

    function refreshReceiptPaySummary() {
      const payment = readCustomerPaymentFields('receiptPayCash', 'receiptPayTransfer', 'receiptPayChange');
      renderReceiptPaySummary(payment, pendingReceiptDue);
    }

    function refreshDeliveryPaymentSummary() {
      formatCustomerPaymentFields('deliveryCashInput', 'deliveryTransferInput', 'deliveryChangeInput');
      const payment = readCustomerPaymentFields('deliveryCashInput', 'deliveryTransferInput', 'deliveryChangeInput');
      const errors = validateCustomerPayment(payment, pendingDeliveryPaymentDue);
      document.getElementById('deliveryPaymentSummary').textContent =
        'Tổng khách đưa: ' + moneyText(payment.tong_khach_dua) +
        ' | Thực thu: ' + moneyText(payment.thuc_thu) +
        ' | Còn phải thu: ' + moneyText(Math.max(pendingDeliveryPaymentDue - payment.thuc_thu, 0)) +
        (errors.length ? ' — ' + errors.join('. ') : '');
    }

    function fillDeliveryPaymentAll(mode) {
      const due = Math.max(0, Number(pendingDeliveryPaymentDue || 0));
      const cashEl = document.getElementById('deliveryCashInput');
      const transferEl = document.getElementById('deliveryTransferInput');
      const changeEl = document.getElementById('deliveryChangeInput');
      if (mode === 'cash') {
        if (cashEl) cashEl.value = money(due);
        if (transferEl) transferEl.value = '0';
      } else if (mode === 'transfer') {
        if (transferEl) transferEl.value = money(due);
        if (cashEl) cashEl.value = '0';
      }
      if (changeEl) changeEl.value = '0';
      refreshDeliveryPaymentSummary();
    }

    async function toggleOrderDetail(id) {
      const row = document.querySelector('[data-order-row="' + id + '"]');
      const detailRow = document.querySelector('[data-order-detail="' + id + '"]');
      if (!detailRow) return;
      const shouldOpen = !detailRow.classList.contains('open');
      document.querySelectorAll('.detail-row').forEach(item => item.classList.remove('open'));
      document.querySelectorAll('.order-row').forEach(item => item.classList.remove('active'));
      if (!shouldOpen) return;
      detailRow.classList.add('open');
      row?.classList.add('active');
      if (detailRow.dataset.loaded === 'true') return;
      await loadOrderDetail(id, detailRow);
    }

    document.addEventListener('DOMContentLoaded', function() {
      const filterForm = document.getElementById('filterForm');
      if (filterForm) {
        filterForm.addEventListener('submit', function() {
          const pageInput = document.getElementById('orderPageInput');
          if (pageInput) pageInput.value = '1';
        });
      }
      const id = new URLSearchParams(window.location.search).get('order');
      if (id) {
        const row = document.querySelector('[data-order-row="' + id + '"]');
        if (row) {
          toggleOrderDetail(id);
          row.scrollIntoView({ block: 'center' });
        }
      }
    });

    async function loadOrderDetail(id, detailRow) {
      const panel = detailRow.querySelector('.order-detail');
      try {
        const res = await fetch('/don-hang/' + id + '/detail');
        const data = await res.json();
        if (!data.success) {
          panel.innerHTML = '<div class="loading-detail">' + escapeHtml(data.message || 'Không tải được đơn hàng') + '</div>';
          return;
        }
        const order = data.data.order;
        const shipment = data.data.shipment;
        const invoice = data.data.invoice;
        const items = data.data.items || [];
        orderDetailCache[id] = data.data;
        const totalGoods = items.reduce((sum, item) => sum + Number(item.thanh_tien || 0), 0);
        const discount = Math.max(totalGoods - Number(order.tong_thanh_toan || order.tong_tien || 0), 0);
        panel.innerHTML = renderOrderDetail(order, shipment, data.data.invoices || (invoice ? [invoice] : []), items, totalGoods, discount, data.data.receipts || [], data.data.payment_balance || null, data.data.vat_chua_lines || []);
        detailRow.dataset.loaded = 'true';
      } catch (err) {
        panel.innerHTML = '<div class="loading-detail">Không tải được chi tiết đơn. ' + escapeHtml(err.message || '') + '</div>';
      }
    }

    function renderOrderVatChuaBox(vatChuaLines, order, items) {
      const lines = Array.isArray(vatChuaLines) ? vatChuaLines : [];
      const hasDelivered = (Array.isArray(items) ? items : []).some(item => Number(item.so_luong_da_giao || 0) > 0)
        || ['giao_du', 'giao_mot_phan', 'giao_thieu'].includes(String(order?.trang_thai_giao_hang || ''));
      if (!hasDelivered || !lines.length) return '';
      const rows = lines.map(line => {
        const maCell = line.doc_href
          ? refAnchor(line.doc_href, line.ma_chung_tu)
          : escapeHtml(line.ma_chung_tu || '---');
        const sourceCell = line.source_href && line.source_code
          ? refAnchor(line.source_href, line.source_code)
          : escapeHtml(line.source_code || '---');
        const timeText = line.created_at ? new Date(line.created_at).toLocaleString('vi-VN') : '';
        return `<tr>
          <td>${maCell}</td>
          <td>${escapeHtml(line.doc_kind_label || '')}</td>
          <td>${escapeHtml(line.ma_vat_chua || '---')}</td>
          <td>${escapeHtml(line.ten_vat_chua || '---')}</td>
          <td class="num">${money(line.so_luong || 0)}</td>
          <td>${sourceCell}</td>
          <td>${escapeHtml(timeText)}</td>
        </tr>`;
      }).join('');
      return `
        <div class="delivery-box order-vat-chua-box">
          <div class="delivery-title"><span><i class="fa-solid fa-box"></i> Vật chứa đã giao</span></div>
          <table class="items-table">
            <thead><tr>
              <th>Mã chứng từ</th>
              <th>Loại</th>
              <th>Mã vật chứa</th>
              <th>Tên vật chứa</th>
              <th class="num">Số lượng</th>
              <th>Chứng từ liên kết</th>
              <th>Thời gian</th>
            </tr></thead>
            <tbody>${rows}</tbody>
          </table>
        </div>`;
    }

    function renderOrderDetail(order, shipment, invoices, items, totalGoods, discount, receipts, paymentBalance, vatChuaLines) {
      const invoiceList = Array.isArray(invoices) ? invoices : (invoices ? [invoices] : []);
      const customer = order.khach_hang_id || {};
      if (order.trang_thai === 'merged') {
        const mergedTarget = order.merged_to_don_hang_id
          ? refAnchor('/don-hang?order=' + encodeURIComponent(order.merged_to_don_hang_id), order.merged_to_ma_don_hang || 'đơn nhận')
          : escapeHtml(order.merged_to_ma_don_hang || 'đơn khác');
        return `
          <div class="detail-tabs"><button type="button" class="detail-tab">Thông tin</button></div>
          <div class="delivery-box">
            <strong>Đơn này đã được gộp vào ${mergedTarget}</strong>
            <div style="margin-top:8px;color:#667085">Đơn nguồn đã gộp không còn xử lý riêng. Vui lòng thao tác trên đơn nhận.</div>
          </div>
        `;
      }
      const receiver = shipment?.ten_nguoi_nhan || customer.ten_khach_hang || '';
      const phone = shipment?.sdt_nguoi_nhan || customer.sdt || '';
      const address = shipment?.dia_chi_nhan || customer.dia_chi_day_du || '';
      const itemRows = items.map(item => {
        const product = item.hang_hoa_id || {};
        const deliveryStatus = deliveryStatusLabels[item.trang_thai_giao] || deliveryStatusLabels.chua_giao;
        const attributeLabel = item.ten_thuoc_tinh || item.ten_quy_cach || '';
        const lotName = formatOrderLotCell(item, product);
        return `<tr>
          <td>${refAnchor(product._id ? '/hang-hoa/' + product._id : '', product.ma_hang || '')}</td>
          <td>${escapeHtml(product.ten_hang || '')}</td>
          <td>${escapeHtml(lotName)}</td>
          <td class="num">${money(item.so_luong_dat || item.so_luong || 0)}</td>
          <td class="num">${money(item.so_luong_xac_nhan || 0)}</td>
          <td class="num">${money(item.so_luong_da_giao || 0)}</td>
          <td class="num">${money(item.so_luong_con_thieu || 0)}</td>
          <td>${escapeHtml(deliveryStatus)}</td>
          <td>${escapeHtml(attributeLabel || 'Không có')}</td>
          <td class="num">${moneyText(item.chiet_khau)}</td>
          <td class="num">${moneyText(item.don_gia_ban)}</td>
          <td class="num"><strong>${moneyText(item.thanh_tien)}</strong></td>
        </tr>`;
      }).join('') || '<tr><td colspan="12" class="loading-detail">Đơn chưa có hàng hóa</td></tr>';
      const hasLinesToDeliver = items.some(item => Number(item.so_luong_con_thieu || 0) > 0);
      const invoiceLinks = invoiceList.length
        ? invoiceList.map(inv => {
            const invId = inv._id;
            return `<a class="btn" href="/don-hang/hoa-don?invoice=${encodeURIComponent(invId)}"><i class="fa-solid fa-file-invoice"></i> ${escapeHtml(inv.ma_hoa_don || '')}</a>`;
          }).join('')
        : '';
      const invoiceAction = hasLinesToDeliver
        ? ''
        : (invoiceList.length
          ? invoiceLinks + `<a class="btn solid" href="/don-hang/tra-hang/create?invoice_id=${invoiceList[0]._id}"><i class="fa-solid fa-rotate-left"></i> Trả hàng</a>`
          : '<span class="partner-hint">Chưa có hóa đơn — xác nhận giao để tạo.</span>');
      const paidAmount = Number(
        paymentBalance?.tong_da_thu != null
          ? Math.max(Number(paymentBalance.tong_da_thu), Number(order.khach_thanh_toan || 0))
          : Number(order.khach_thanh_toan || 0)
      );
      const paymentHistoryBox = buildPaymentHistoryBox(receipts || [], paidAmount);
      const hasInvoices = invoiceList.length > 0;
      const payableAmount = Number(paymentBalance?.tong_phai_thu ?? (
        hasInvoices
          ? invoiceList.reduce((sum, inv) => sum + Number(inv.thanh_toan || 0), 0)
          : Number(order.tong_thanh_toan || order.tong_tien || 0)
      ));
      const remainingAmount = paymentBalance != null
        ? Math.max(Number(paymentBalance.khach_can_tra ?? 0), 0)
        : (hasInvoices
          ? Math.max(payableAmount - paidAmount, 0)
          : Math.max(Number(order.khach_can_tra ?? (payableAmount - paidAmount)), 0));
      const deliveryComplete = order.trang_thai_giao_hang === 'giao_du'
        || (items.length > 0 && !hasLinesToDeliver);
      const deliveryProcessActions = deliveryComplete
        ? `<button type="button" class="btn disabled-action" onclick="showLockedAction('Xử lý đơn hàng')"><i class="fa-solid fa-truck-fast"></i> Xử lý đơn hàng</button><button type="button" class="btn disabled-action" onclick="showLockedAction('Xác nhận giao')"><i class="fa-solid fa-box-open"></i> Xác nhận giao</button>`
        : `<button type="button" class="btn solid" onclick="updateOrderStatus('${order._id}','shipping')"><i class="fa-solid fa-truck-fast"></i> Xử lý đơn hàng</button><button type="button" class="btn solid" onclick="confirmDelivery('${order._id}')"><i class="fa-solid fa-box-open"></i> Xác nhận giao</button>`;
      const lockedBlueActions = `${deliveryProcessActions}${invoiceAction}`;
      const receiptAction = remainingAmount > 0
        ? `<div class="totals-receipt-action"><button type="button" class="btn solid" onclick="openReceiptPayModal('${order._id}', ${remainingAmount})"><i class="fa-solid fa-money-bill-wave"></i> Tạo phiếu thu</button></div>`
        : '';
      const mergedFromIds = Array.isArray(order.merged_from_don_hang_ids) ? order.merged_from_don_hang_ids : [];
      const mergedFromCodes = Array.isArray(order.merged_from_ma_don_hangs) ? order.merged_from_ma_don_hangs : [];
      const mergedFromLine = order.is_merged_order && mergedFromCodes.length
        ? `<div style="margin-top:8px;color:#667085;font-size:13px">Được gộp từ: ${mergedFromCodes.map((code, index) => {
            const sourceId = mergedFromIds[index];
            return sourceId ? refAnchor('/don-hang?order=' + encodeURIComponent(sourceId), code) : escapeHtml(code);
          }).join(', ')}</div>`
        : '';

      return `
        <div class="detail-tabs"><button type="button" class="detail-tab">Thông tin</button></div>
        <div class="detail-head">
          <div>
            <div><span class="detail-title">${escapeHtml(customer.ten_khach_hang || 'Khách lẻ')}</span> <span>${refAnchor(order._id ? '/don-hang/' + order._id : '', order.ma_don_hang || '')}</span></div>
            ${mergedFromLine}
            <div class="detail-meta">
              <div class="mini-field"><label>Người tạo</label><span>${escapeHtml(order.nguoi_tao_id?.ho_ten || order.nguoi_tao_id?.username || '')}</span></div>
              <div class="mini-field"><label>Người nhận đặt</label><input class="mini-input" value="${escapeHtml(order.nguoi_tao_id?.ho_ten || order.nguoi_tao_id?.username || '')}"></div>
              <div class="mini-field"><label>Ngày đặt</label><input class="mini-input" value="${escapeHtml(new Date(order.ngay_dat || order.created_at).toLocaleString('vi-VN'))}"></div>
              <div class="mini-field"><label>Trạng thái</label><select class="mini-select" onchange="updateOrderStatus('${order._id}',this.value)">${['draft','shipping','completed','cancelled'].map(status => `<option value="${status}" ${order.trang_thai === status ? 'selected' : ''}>${statusLabels[status]}</option>`).join('')}</select></div>
            </div>
          </div>
          <div>${escapeHtml(order.cua_hang_id?.ten_cua_hang || 'Cửa hàng trung tâm')}</div>
        </div>
        ${invoiceList.length ? `<div class="delivery-box" style="margin-bottom:8px"><div class="delivery-title"><span><i class="fa-solid fa-file-invoice"></i> Hóa đơn (${invoiceList.length}):</span></div><div style="margin-top:6px;display:flex;flex-wrap:wrap;gap:6px">${invoiceList.map(inv => refAnchor('/don-hang/hoa-don?invoice=' + encodeURIComponent(inv._id), inv.ma_hoa_don || '')).join(' ')}</div></div>` : ''}
        <div class="delivery-box">
          <div class="delivery-title"><span><i class="fa-regular fa-hand-point-right"></i> Tự giao đến: <strong>${escapeHtml(address || 'Chưa có địa chỉ giao hàng')}</strong></span><i class="fa-solid fa-chevron-up"></i></div>
          <div class="delivery-grid">
            <div class="mini-field"><label>Người nhận</label><input class="mini-input" value="${escapeHtml(receiver)}"></div>
            <div class="mini-field"><label>Mã vận đơn</label><span>${refAnchor(shipment?._id ? '/don-hang/van-don/' + shipment._id : '', shipment?.ma_van_don || '')}</span></div>
            <div class="mini-field"><label>Người giao</label><input class="mini-input" value="${escapeHtml(shipment?.doi_tac_giao_hang_id?.ten_doi_tac || 'Tự giao hàng')}"></div>
            <div class="mini-field"><label>Điện thoại</label><input class="mini-input" value="${escapeHtml(phone)}"></div>
