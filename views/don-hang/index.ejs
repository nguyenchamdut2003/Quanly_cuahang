    async function updateOrderStatus(id, status, forceCompleteShort = false) {
      const res = await fetch('/don-hang/' + id + '/status', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ trang_thai: status, force_complete_short: forceCompleteShort }) });
      const data = await res.json();
      if (!data.success) return alert(data.message || 'Không cập nhật được trạng thái');
      location.reload();
    }

    function showLockedAction(buttonName) {
      document.getElementById('lockedActionMessage').textContent = `Đơn đã hoàn thành, không thể thao tác nút "${buttonName}".`;
      document.getElementById('lockedActionOverlay').style.display = 'flex';
    }

    function closeLockedActionModal() {
      document.getElementById('lockedActionOverlay').style.display = 'none';
    }

    function openReceiptPayModal(orderId, dueAmount) {
      pendingReceiptOrderId = orderId;
      pendingReceiptDue = Math.max(0, Number(dueAmount || 0));
      document.getElementById('receiptPayDue').textContent = moneyText(pendingReceiptDue);
      const cashEl = document.getElementById('receiptPayCash');
      const transferEl = document.getElementById('receiptPayTransfer');
      const changeEl = document.getElementById('receiptPayChange');
      if (cashEl) { cashEl.value = pendingReceiptDue > 0 ? money(pendingReceiptDue) : ''; delete cashEl.dataset.vnBound; }
      if (transferEl) { transferEl.value = ''; delete transferEl.dataset.vnBound; }
      if (changeEl) { changeEl.value = ''; delete changeEl.dataset.vnBound; }
      document.getElementById('receiptPayCashBook').value = '';
      bindReceiptPayInput(cashEl, refreshReceiptPaySummary);
      bindReceiptPayInput(transferEl, refreshReceiptPaySummary);
      bindReceiptPayInput(changeEl, refreshReceiptPaySummary);
      refreshReceiptPaySummary();
      document.getElementById('receiptPayModal').classList.add('open');
    }

    function closeReceiptPayModal() {
      pendingReceiptOrderId = '';
      pendingReceiptDue = 0;
      document.getElementById('receiptPayModal').classList.remove('open');
    }

    async function submitReceiptPayModal() {
      const payment = readCustomerPaymentFields('receiptPayCash', 'receiptPayTransfer', 'receiptPayChange');
      const cashBookId = document.getElementById('receiptPayCashBook')?.value || '';
      if (!pendingReceiptOrderId || payment.tong_khach_dua <= 0) return alert('Vui lòng nhập số tiền khách đưa.');
      const errors = validateCustomerPayment(payment, pendingReceiptDue);
      if (errors.length) return alert(errors.join('. '));
      if (!cashBookId) return alert('Vui lòng chọn sổ quỹ.');
      const res = await fetch('/don-hang/' + pendingReceiptOrderId + '/phieu-thu', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          tien_mat_khach_dua: payment.tien_mat,
          chuyen_khoan_khach_dua: payment.chuyen_khoan,
          tien_thua_tra_khach: payment.tien_thua,
          so_quy_id: cashBookId
        })
      });
      const data = await res.json();
      if (!data.success) return alert(data.message || 'Không tạo được phiếu thu');
      location.reload();
    }

    async function finishOrder(id, deliveryStatus) {
      if (deliveryStatus !== 'giao_du' && !confirm('Đơn chưa giao đủ. Xác nhận kết thúc thiếu?')) return;
      await updateOrderStatus(id, 'completed', deliveryStatus !== 'giao_du');
    }

    function calcDeliveryLineTotal(row) {
      const qty = Number(String(row.querySelector('[data-delivery-qty]')?.value || '').replace(',', '.')) || 0;
      const price = Number(String(row.querySelector('[data-delivery-price]')?.value || '').replace(/\./g, '').replace(/,/g, '')) || 0;
      const total = Math.max(qty * price, 0);
      const cell = row.querySelector('[data-delivery-line-total]');
      if (cell) cell.textContent = money(total);
      return total;
    }
    function computeDeliveryDueFromDetail(detail, batchPayable) {
      const batchTotal = Math.max(0, Number(batchPayable || 0));
      const balance = detail?.payment_balance || {};
      const invoices = Array.isArray(detail?.invoices) ? detail.invoices : [];
      const invoicedPayable = invoices.reduce((sum, inv) => sum + Number(inv.thanh_toan || 0), 0);
      const tongDaThu = Math.max(
        Number(balance.tong_da_thu ?? 0),
        Number(detail?.order?.khach_thanh_toan || 0)
      );
      const prepaymentCredit = Math.max(tongDaThu - invoicedPayable, 0);
      const amountDue = Math.max(batchTotal - prepaymentCredit, 0);
      return { batchTotal, prepaymentCredit, amountDue, tongDaThu, invoicedPayable };
    }

    function refreshDeliveryModalTotals() {
      const rows = Array.from(document.querySelectorAll('[data-delivery-line]'));
      const batchTotal = rows.reduce((sum, row) => sum + calcDeliveryLineTotal(row), 0);
      const detail = orderDetailCache[pendingDeliveryOrderId] || null;
      const dueInfo = computeDeliveryDueFromDetail(detail, batchTotal);
      pendingDeliveryBatchPayable = dueInfo.batchTotal;
      pendingDeliveryPrepaidCredit = dueInfo.prepaymentCredit;
      pendingDeliveryPaymentDue = dueInfo.amountDue;
      const dueEl = document.getElementById('deliveryPaymentDue');
      if (dueEl) {
        dueEl.innerHTML =
          '<div>Giá trị lần giao: ' + moneyText(dueInfo.batchTotal) + '</div>' +
          '<div>Đã trả trước áp dụng: ' + moneyText(dueInfo.prepaymentCredit) + '</div>' +
          '<div>Khách trả thêm (tối đa): ' + moneyText(dueInfo.amountDue) + '</div>';
      }
      refreshDeliveryPaymentSummary();
    }
    async function confirmDelivery(id) {
      const detail = orderDetailCache[id];
      if (!detail) return alert('Vui lòng mở lại chi tiết đơn trước khi xác nhận giao.');
      const order = detail.order || {};
      const items = detail.items || [];
      const khoId = order.kho_id?._id || order.kho_id;
      if (!khoId) return alert('Đơn chưa có kho giao hàng.');
      const rows = items.map(item => {
        const missing = Number(item.so_luong_con_thieu || item.so_luong_dat || item.so_luong || 0);
        if (missing <= 0) return '';
        const product = item.hang_hoa_id || {};
        const attributeLabel = item.ten_thuoc_tinh || item.ten_quy_cach || 'Không có';
        const unitPrice = Number(item.don_gia_ban || 0);
        return `<tr data-delivery-line
          data-ct-id="${escapeHtml(item._id || '')}"
          data-product-id="${escapeHtml(product._id || item.hang_hoa_id || '')}"
          data-lot-id="${escapeHtml(item.lo_hang_id?._id || item.lo_hang_id || '')}">
          <td>${escapeHtml(product.ma_hang || '')}</td>
          <td>${escapeHtml(product.ten_hang || '')}</td>
          <td>${escapeHtml(attributeLabel)}</td>
          <td class="num">${money(item.so_luong_dat || item.so_luong || 0)}</td>
          <td class="num">${money(item.so_luong_da_giao || 0)}</td>
          <td class="num" data-missing="${missing}">${money(missing)}</td>
          <td class="num"><input value="${missing}" inputmode="decimal" data-delivery-qty oninput="refreshDeliveryModalTotals()"></td>
          <td class="num"><input value="${money(unitPrice)}" inputmode="numeric" data-delivery-price oninput="refreshDeliveryModalTotals()"></td>
          <td class="num" data-delivery-line-total>${money(missing * unitPrice)}</td>
        </tr>`;
      }).filter(Boolean).join('');
      if (!rows) return alert('Đơn hàng không còn dòng cần giao.');
      pendingDeliveryOrderId = id;
      document.getElementById('deliveryConfirmBody').innerHTML = rows;
      refreshDeliveryModalTotals();
      document.getElementById('deliveryCashInput').value = '0';
      document.getElementById('deliveryTransferInput').value = '0';
      document.getElementById('deliveryChangeInput').value = '0';
      document.getElementById('deliveryCashBookId').value = '';
      const vatChuaIdEl = document.getElementById('deliveryVatChuaId');
      const vatChuaQtyEl = document.getElementById('deliveryVatChuaQty');
      if (vatChuaIdEl) vatChuaIdEl.value = '';
      if (vatChuaQtyEl) vatChuaQtyEl.value = '';
      setDeliveryConfirmSubmitting(false);
      refreshDeliveryPaymentSummary();
      document.getElementById('deliveryConfirmError').style.display = 'none';
      document.getElementById('deliveryConfirmOverlay').style.display = 'flex';
    }

    function closeDeliveryConfirmModal() {
      if (pendingDeliverySubmitting) return;
      pendingDeliveryOrderId = '';
      pendingDeliveryBatchPayable = 0;
      pendingDeliveryPrepaidCredit = 0;
      pendingDeliveryPaymentDue = 0;
      document.getElementById('deliveryConfirmOverlay').style.display = 'none';
    }

    function setDeliveryConfirmSubmitting(isSubmitting) {
      pendingDeliverySubmitting = Boolean(isSubmitting);
      const modal = document.querySelector('#deliveryConfirmOverlay .delivery-confirm-modal');
      const submitBtn = document.getElementById('deliveryConfirmSubmitBtn');
      if (modal) {
        modal.classList.toggle('is-submitting', pendingDeliverySubmitting);
        modal.querySelectorAll('input, select, button').forEach(el => {
          el.disabled = pendingDeliverySubmitting;
        });
      }
      if (submitBtn) {
        if (!submitBtn.dataset.defaultText) submitBtn.dataset.defaultText = submitBtn.textContent;
        submitBtn.textContent = pendingDeliverySubmitting ? 'Đang tạo đơn' : submitBtn.dataset.defaultText;
      }
    }

    function collectDeliverySubmitPayload() {
      const id = pendingDeliveryOrderId;
      const detail = orderDetailCache[id];
      if (!id || !detail) return null;
      const order = detail.order || {};
      const khoId = order.kho_id?._id || order.kho_id;
      const deliveryItems = Array.from(document.querySelectorAll('[data-delivery-line]')).map(row => {
        const quantity = Number(String(row.querySelector('[data-delivery-qty]')?.value || '').replace(',', '.'));
        const donGiaGiao = num(row.querySelector('[data-delivery-price]')?.value);
        return {
          ct_don_hang_id: row.dataset.ctId,
          hang_hoa_id: row.dataset.productId,
          lo_hang_id: row.dataset.lotId || '',
          so_luong_giao: quantity,
          don_gia_giao: donGiaGiao
        };
      }).filter(item => Number.isFinite(item.so_luong_giao) && item.so_luong_giao > 0);
      if (!deliveryItems.length) return { error: 'Chưa có số lượng giao.' };
      const payment = readCustomerPaymentFields('deliveryCashInput', 'deliveryTransferInput', 'deliveryChangeInput');
      const errors = validateCustomerPayment(payment, pendingDeliveryPaymentDue);
      if (errors.length) return { error: errors.join('. ') };
      if (payment.tong_khach_dua > 0 && !document.getElementById('deliveryCashBookId')?.value) {
        return { error: 'Vui lòng chọn sổ quỹ để thu tiền khi giao hàng.' };
      }
      return {
        id,
        body: {
          kho_id: khoId,
          items: deliveryItems,
          tien_mat_khach_dua: payment.tien_mat,
          chuyen_khoan_khach_dua: payment.chuyen_khoan,
          tien_thua_tra_khach: payment.tien_thua,
          so_quy_id: document.getElementById('deliveryCashBookId')?.value || ''
        }
      };
    }

    function validateDeliveryVatChuaImport() {
      const id = String(document.getElementById('deliveryVatChuaId')?.value || '').trim();
      const rawQty = String(document.getElementById('deliveryVatChuaQty')?.value || '').replace(/\./g, '').replace(/,/g, '').trim();
      const qty = Math.floor(Number(rawQty || 0));
      if (id && qty <= 0) {
        document.getElementById('deliveryVatChuaQty')?.focus();
        return { error: 'Số lượng vật chứa phải lớn hơn 0.' };
      }
      if (!id && rawQty && qty > 0) {
        document.getElementById('deliveryVatChuaId')?.focus();
        return { error: 'Vui lòng chọn vật chứa.' };
      }
      if (rawQty) {
        const qtyInput = document.getElementById('deliveryVatChuaQty');
        if (qtyInput) qtyInput.value = String(qty);
      }
      return { vat_chua_id: id, vat_chua_so_luong: id ? String(qty) : '' };
    }

    async function submitDeliveryConfirmModal() {
      if (pendingDeliverySubmitting) return;
      const payload = collectDeliverySubmitPayload();
      if (!payload) return closeDeliveryConfirmModal();
      if (payload.error) return alert(payload.error);
      const vatChuaFields = validateDeliveryVatChuaImport();
      if (vatChuaFields.error) return alert(vatChuaFields.error);
      const body = Object.assign({}, payload.body, {
        vat_chua_id: vatChuaFields.vat_chua_id,
        vat_chua_so_luong: vatChuaFields.vat_chua_so_luong
      });
      setDeliveryConfirmSubmitting(true);
      try {
        const res = await fetch('/don-hang/' + payload.id + '/xac-nhan-giao', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body)
        });
        const data = await res.json();
        if (!data.success) {
          setDeliveryConfirmSubmitting(false);
          return alert(data.message || 'Không xác nhận giao được.');
        }
        location.reload();
      } catch (error) {
        setDeliveryConfirmSubmitting(false);
        alert('Không xác nhận giao được.');
      }
    }

    async function deleteOrder(id) {
      if (!confirm('Hủy đơn đặt hàng này?')) return;
      await updateOrderStatus(id, 'cancelled');
    }

    async function saveOrderDetail(id) {
      const detailRow = document.querySelector('[data-order-detail="' + id + '"]');
      const panel = detailRow?.querySelector('.order-detail');
      if (!panel) return alert('Vui lòng mở chi tiết đơn trước khi lưu.');
      const deliveryInputs = panel.querySelectorAll('.delivery-grid .mini-input');
      const payload = {
        ghi_chu: panel.querySelector('.js-order-note')?.value || '',
        shipment: {
          ten_nguoi_nhan: deliveryInputs[0]?.value || '',
          sdt_nguoi_nhan: deliveryInputs[2]?.value || '',
          dia_chi_nhan: deliveryInputs[3]?.value || '',
          ghi_chu: panel.querySelector('.js-shipment-note')?.value || ''
        }
      };
      const res = await fetch('/don-hang/' + id + '/detail', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const data = await res.json();
      if (!data.success) return alert(data.message || 'Không lưu được đơn hàng');
      alert(data.message || 'Đã lưu thông tin đơn hàng');
    }

    (function initOrderMergeModal() {
      const overlay = document.getElementById('orderMergeModalOverlay');
      const openBtn = document.getElementById('openOrderMergeModal');
      const closeBtn = document.getElementById('orderMergeModalClose');
      const cancelBtn = document.getElementById('orderMergeCancel');
      const rowsEl = document.getElementById('orderMergeRows');
      const emptyEl = document.getElementById('orderMergeEmpty');
      const emptyTitleEl = document.getElementById('orderMergeEmptyTitle');
      const emptyDescEl = document.getElementById('orderMergeEmptyDesc');
      const footEl = document.getElementById('orderMergeFoot');
      const customerSelect = document.getElementById('orderMergeCustomerSelect');
      const modalCheckAll = document.getElementById('orderMergeCheckAll');
      const submitBtn = document.getElementById('orderMergeSubmit');
      const selectAll = document.querySelector('.table thead .row-check');
      const orderChecks = Array.from(document.querySelectorAll('.order-select-check'));
      let modalOrders = [];

      function readOrder(row) {
        return {
          id: row.dataset.orderId || '',
          code: row.dataset.orderCode || '',
          date: new Date(row.dataset.orderDate || ''),
          status: row.dataset.orderStatus || '',
          deliveryStatus: row.dataset.deliveryStatus || '',
          customerId: row.dataset.customerId || '',
          customerCode: row.dataset.customerCode || '',
          customerName: row.dataset.customerName || 'Khách lẻ',
          customerKey: row.dataset.customerId || row.dataset.customerCode || '',
          payable: Number(row.dataset.payable || 0),
          paid: Number(row.dataset.paid || 0)
        };
      }

      function isUndeliveredOrder(order) {
        return order.deliveryStatus === 'chua_giao';
      }

      function getModalCustomers(orders) {
        const map = new Map();
        orders.forEach(order => {
          if (!order.customerKey) return;
          if (!map.has(order.customerKey)) {
            map.set(order.customerKey, {
              key: order.customerKey,
              code: order.customerCode,
              name: order.customerName || 'Khách lẻ'
            });
          }
        });
        return Array.from(map.values()).sort((a, b) => a.name.localeCompare(b.name, 'vi'));
      }

      function renderCustomerOptions(orders) {
        if (!customerSelect) return;
        const customers = getModalCustomers(orders);
        customerSelect.innerHTML = '<option value="">Tất cả khách hàng</option>' + customers.map(customer => {
          const label = [customer.code, customer.name].filter(Boolean).join(' - ');
          return `<option value="${escapeHtml(customer.key)}">${escapeHtml(label)}</option>`;
        }).join('');
      }

      function getFilteredModalOrders() {
        const customerKey = customerSelect?.value || '';
        return customerKey ? modalOrders.filter(order => order.customerKey === customerKey) : modalOrders;
      }

      function updateModalCheckAll() {
        if (!modalCheckAll) return;
        const rowChecks = Array.from(document.querySelectorAll('.order-merge-row-check'));
        modalCheckAll.checked = rowChecks.length > 0 && rowChecks.every(cb => cb.checked);
        modalCheckAll.indeterminate = rowChecks.some(cb => cb.checked) && !modalCheckAll.checked;
      }

      function renderRows(orders, emptyTitle, emptyDesc) {
        if (!rowsEl || !emptyEl || !footEl) return;
        const hasRows = orders.length > 0;
        rowsEl.innerHTML = hasRows ? orders.map(order => `
          <tr>
            <td class="order-merge-check"><input class="order-merge-row-check" type="checkbox" value="${escapeHtml(order.id)}" data-customer-key="${escapeHtml(order.customerKey)}"></td>
            <td>${escapeHtml(order.code)}</td>
            <td>${escapeHtml(Number.isFinite(order.date.getTime()) ? order.date.toLocaleString('vi-VN') : '')}</td>
            <td class="num">${moneyText(order.payable)}</td>
            <td class="num">${moneyText(order.paid)}</td>
            <td>${escapeHtml(order.customerCode)}</td>
            <td>${escapeHtml(order.customerName)}</td>
          </tr>
        `).join('') : '';
        if (emptyTitleEl) emptyTitleEl.textContent = emptyTitle || 'Không có đơn hàng chưa giao';
        if (emptyDescEl) emptyDescEl.textContent = emptyDesc || '';
        emptyEl.style.display = hasRows ? 'none' : 'flex';
        footEl.style.display = hasRows ? 'flex' : 'none';
        updateModalCheckAll();
        document.querySelectorAll('.order-merge-row-check').forEach(cb => cb.addEventListener('change', updateModalCheckAll));
      }

      function refreshModalRows() {
        const filteredOrders = getFilteredModalOrders();
        renderRows(filteredOrders, 'Không có đơn hàng chưa giao', 'Không có đơn hàng phù hợp với khách hàng đang chọn.');
      }

      async function submitMergeOrders() {
        const selectedIds = Array.from(document.querySelectorAll('.order-merge-row-check:checked')).map(cb => cb.value).filter(Boolean);
        if (selectedIds.length < 2) {
          return alert('Vui lòng chọn ít nhất 2 đơn để gộp.');
        }
        const selectedCustomerKeys = new Set(
          Array.from(document.querySelectorAll('.order-merge-row-check:checked'))
            .map(cb => cb.dataset.customerKey || '')
            .filter(Boolean)
        );
        if (selectedCustomerKeys.size > 1) {
          return alert('Chỉ được gộp các đơn thuộc cùng một khách hàng.');
        }
        if (submitBtn) submitBtn.disabled = true;
        try {
          const res = await fetch('/api/don-hang/gop-don', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ don_hang_ids: selectedIds })
          });
          const data = await res.json();
          if (!data.success) return alert(data.message || 'Không gộp được đơn.');
          window.location.href = '/don-hang?order=' + encodeURIComponent(data.data?.don_nhan_id || selectedIds[0]);
        } catch (error) {
          alert('Không gộp được đơn.');
        } finally {
          if (submitBtn) submitBtn.disabled = false;
        }
      }

      function openModal() {
        if (!overlay) return;
        const allRows = Array.from(document.querySelectorAll('.order-row'));
        modalOrders = allRows.map(readOrder).filter(isUndeliveredOrder);
        renderCustomerOptions(modalOrders);
        if (customerSelect) customerSelect.value = '';
        renderRows(modalOrders, 'Không có đơn hàng chưa giao', 'Danh sách hiện tại không có đơn hàng nào ở trạng thái Chưa giao.');
        overlay.style.display = 'flex';
      }

      function closeModal() {
        if (overlay) overlay.style.display = 'none';
      }

      if (selectAll) {
        selectAll.addEventListener('click', e => {
          e.stopPropagation();
          orderChecks.forEach(cb => { cb.checked = selectAll.checked; });
        });
      }
      orderChecks.forEach(cb => {
        cb.addEventListener('change', () => {
          if (!selectAll) return;
          selectAll.checked = orderChecks.length > 0 && orderChecks.every(item => item.checked);
          selectAll.indeterminate = orderChecks.some(item => item.checked) && !selectAll.checked;
        });
      });
      if (openBtn) openBtn.addEventListener('click', openModal);
      if (closeBtn) closeBtn.addEventListener('click', closeModal);
      if (cancelBtn) cancelBtn.addEventListener('click', closeModal);
      if (submitBtn) submitBtn.addEventListener('click', submitMergeOrders);
      if (customerSelect) customerSelect.addEventListener('change', refreshModalRows);
      if (modalCheckAll) {
        modalCheckAll.addEventListener('change', () => {
          document.querySelectorAll('.order-merge-row-check').forEach(cb => { cb.checked = modalCheckAll.checked; });
          updateModalCheckAll();
        });
      }
      document.addEventListener('keydown', e => {
        if (e.key === 'Escape' && overlay?.style.display === 'flex') closeModal();
      });
    })();

    (function initOrderExportModal() {
      const overlay = document.getElementById('orderExportModalOverlay');
      const openBtn = document.getElementById('openOrderExportModal');
      const closeBtn = document.getElementById('orderExportModalClose');
      const cancelBtn = document.getElementById('orderExportCancel');
      const deselectBtn = document.getElementById('orderExportDeselectAll');
      const submitBtn = document.getElementById('orderExportSubmit');
      const errorEl = document.getElementById('orderExportError');
      const form = document.getElementById('orderExportForm');
      const formInputs = document.getElementById('orderExportFormInputs');

      function updateGroupCounts() {
        document.querySelectorAll('[data-export-group-count]').forEach(counter => {
          const groupId = counter.getAttribute('data-export-group-count');
          const total = document.querySelectorAll('.order-export-col-cb[data-export-group="' + groupId + '"]').length;
          const checked = document.querySelectorAll('.order-export-col-cb[data-export-group="' + groupId + '"]:checked').length;
          counter.textContent = checked + '/' + total;
        });
      }

      function openModal() {
        if (!overlay) return;
        overlay.style.display = 'flex';
        if (errorEl) errorEl.style.display = 'none';
        updateGroupCounts();
      }

      function closeModal() {
        if (overlay) overlay.style.display = 'none';
      }

      if (openBtn) openBtn.addEventListener('click', openModal);
      if (closeBtn) closeBtn.addEventListener('click', closeModal);
      if (cancelBtn) cancelBtn.addEventListener('click', closeModal);
      if (overlay) {
        overlay.addEventListener('click', e => {
          if (e.target === overlay) closeModal();
        });
      }
      if (deselectBtn) {
        deselectBtn.addEventListener('click', () => {
          document.querySelectorAll('.order-export-col-cb').forEach(cb => { cb.checked = false; });
          updateGroupCounts();
        });
      }
      document.querySelectorAll('.order-export-col-cb').forEach(cb => {
        cb.addEventListener('change', updateGroupCounts);
      });
      updateGroupCounts();

      if (submitBtn) {
        submitBtn.addEventListener('click', () => {
          const selected = Array.from(document.querySelectorAll('.order-export-col-cb')).filter(cb => cb.checked);
          if (!selected.length) {
            if (errorEl) errorEl.style.display = 'block';
            return;
          }
          if (errorEl) errorEl.style.display = 'none';
          if (formInputs) {
            formInputs.innerHTML = '';
            selected.forEach(cb => {
              const input = document.createElement('input');
              input.type = 'hidden';
              input.name = 'columns';
              input.value = cb.value;
              formInputs.appendChild(input);
            });
          }
          if (form) form.submit();
        });
      }
    })();

    (function initOrderTrashModal() {
      var openBtn = document.getElementById('openOrderTrashModal');
      var overlay = document.getElementById('orderTrashModalOverlay');
      var closeBtn = document.getElementById('orderTrashModalClose');
      var cancelBtn = document.getElementById('orderTrashCancel');
      var confirmBtn = document.getElementById('orderTrashConfirm');
      var alertBox = document.getElementById('orderTrashAlert');
      var selectedList = document.getElementById('orderTrashSelectedList');
      var impactBody = document.getElementById('orderTrashImpactRows');
      var orderChecks = Array.prototype.slice.call(document.querySelectorAll('.order-select-check'));
      var pendingIds = [];
      var previewData = null;

      function escapeHtml(value) {
        return String(value == null ? '' : value).replace(/[&<>"']/g, function(char) {
          return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[char];
        });
      }

      function getSelectedOrderIds() {
        return orderChecks.filter(function(cb) { return cb.checked; }).map(function(cb) {
          return String(cb.value || '').trim();
        }).filter(Boolean);
      }

      function updateDeleteButtonState() {
        return;
      }

      function closeTrashModal() {
        if (!overlay) return;
        overlay.classList.remove('is-open');
        overlay.setAttribute('aria-hidden', 'true');
        pendingIds = [];
        previewData = null;
        if (confirmBtn) confirmBtn.disabled = true;
      }

      function renderAlert(preview) {
        if (!alertBox) return;
        var html = '';
        (preview.items || []).forEach(function(item) {
          if (!item.can_trash && item.block_reason) {
            html += '<div class="order-trash-alert is-error">' + escapeHtml(item.ma_don_hang || item.don_hang_id) + ': ' + escapeHtml(item.block_reason) + '</div>';
          }
          (item.warnings || []).forEach(function(warn) {
            html += '<div class="order-trash-alert is-warn">' + escapeHtml(item.ma_don_hang || '') + (item.ma_don_hang ? ' — ' : '') + escapeHtml(warn) + '</div>';
          });
        });
        alertBox.innerHTML = html;
      }

      function renderSelectedList(preview) {
        if (!selectedList) return;
        selectedList.innerHTML = (preview.items || []).map(function(item) {
          var label = [item.ma_don_hang, item.ten_khach].filter(Boolean).join(' — ');
          return '<li>' + escapeHtml(label || item.don_hang_id) + '</li>';
        }).join('');
      }

      function renderImpactRows(preview) {
        if (!impactBody) return;
        var groups = preview.aggregate_groups || [];
        if (!groups.length) {
          impactBody.innerHTML = '<tr><td colspan="3">Không có dữ liệu liên quan đáng kể.</td></tr>';
          return;
        }
        impactBody.innerHTML = groups.map(function(group) {
          var samples = (group.samples || []).join(', ');
          return '<tr>'
            + '<td>' + escapeHtml(group.label || group.entity_type) + '</td>'
            + '<td class="num">' + escapeHtml(String(group.count || 0)) + '</td>'
            + '<td>' + escapeHtml(samples || '—') + '</td>'
            + '</tr>';
        }).join('');
      }

      function openTrashModal() {
        var ids = getSelectedOrderIds();
        if (!ids.length) {
          alert('Vui lòng chọn ít nhất một đơn đặt hàng.');
          return;
        }
        pendingIds = ids.slice();
        if (overlay) {
          overlay.classList.add('is-open');
          overlay.setAttribute('aria-hidden', 'false');
        }
        if (impactBody) impactBody.innerHTML = '<tr><td colspan="3" class="order-trash-loading">Đang kiểm tra dữ liệu liên quan...</td></tr>';
        if (alertBox) alertBox.innerHTML = '';
        if (selectedList) selectedList.innerHTML = '';
        previewData = {
          can_proceed: true,
          items: pendingIds.map(function(id) {
            var row = document.querySelector('[data-order-id="' + id + '"]');
            return {
              don_hang_id: id,
              ma_don_hang: row ? row.getAttribute('data-order-code') : ''
            };
          }),
          aggregate_groups: [
            { label: 'don_hang', count: pendingIds.length, samples: ['trang_thai_du_lieu = inactive'] }
          ]
        };
        renderSelectedList(previewData);
        renderAlert(previewData);
        renderImpactRows(previewData);
        if (confirmBtn) confirmBtn.disabled = false;
      }

      function confirmTrash() {
        if (!previewData || !previewData.can_proceed || !pendingIds.length) return;
        if (confirmBtn) confirmBtn.disabled = true;
        fetch('/don-hang/deactivate', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ don_hang_ids: pendingIds })
        })
          .then(function(res) { return res.json(); })
          .then(function(data) {
            if (!data.success) throw new Error(data.message || 'Không xóa được đơn hàng');
            alert(data.message || 'Đã xóa đơn hàng');
            window.location.reload();
          })
          .catch(function(err) {
            alert(err.message || 'Không xóa được đơn hàng');
            if (confirmBtn) confirmBtn.disabled = false;
          });
      }

      orderChecks.forEach(function(cb) {
        cb.addEventListener('change', updateDeleteButtonState);
      });
      var headerCheck = document.querySelector('.table thead .row-check');
      if (headerCheck) {
        headerCheck.addEventListener('click', function() {
          window.setTimeout(updateDeleteButtonState, 0);
        });
      }
      if (openBtn) openBtn.addEventListener('click', openTrashModal);
      if (closeBtn) closeBtn.addEventListener('click', closeTrashModal);
      if (cancelBtn) cancelBtn.addEventListener('click', closeTrashModal);
      if (confirmBtn) confirmBtn.addEventListener('click', confirmTrash);
      if (overlay) {
        overlay.addEventListener('click', function(e) {
          if (e.target === overlay) closeTrashModal();
        });
      }
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && overlay && overlay.classList.contains('is-open')) closeTrashModal();
      });
      updateDeleteButtonState();
    })();
  </script>
</body>
</html>
