<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/stylesheets/style.css">
  <style>
    .attendance-page{background:#f4f6f8;min-height:100vh}
    .attendance-page .admin-shell{width:auto;max-width:none;margin:0;padding:30px}
    .hr-setup-shell{display:grid;grid-template-columns:260px minmax(0,1fr);gap:12px;padding:0}
    .attendance-app{height:calc(100vh - 124px);display:flex;flex-direction:column;background:#f4f6f8;min-width:0}
    .attendance-topbar{height:42px;display:flex;align-items:center;gap:8px;padding:0 8px 0 0;background:#f4f6f8;border-bottom:1px solid #e0e4ea}
    .attendance-title{font-size:16px;font-weight:800;color:#111827;margin:0;min-width:200px}
    .attendance-search{position:relative;width:204px}
    .attendance-search i{position:absolute;left:10px;top:9px;color:#98a2b3;font-size:13px}
    .attendance-search select{width:100%;height:30px;border:1px solid #cfd8e3;border-radius:6px;background:#fff;padding:0 28px 0 32px;font-size:13px;color:#111827;appearance:none}
    .attendance-search:after{content:"";position:absolute;right:11px;top:13px;border-left:4px solid transparent;border-right:4px solid transparent;border-top:5px solid #344054}
    .attendance-select,.attendance-btn{height:30px;border:1px solid #cfd8e3;border-radius:6px;background:#fff;color:#111827;font-size:13px;padding:0 12px}
    .attendance-week-nav{height:30px;border:1px solid #cfd8e3;border-radius:6px;background:#fff;display:inline-flex;align-items:center;overflow:hidden}
    .attendance-week-nav button{height:100%;width:28px;border:0;background:#fff;color:#475467;cursor:pointer}
    .attendance-week-nav span{min-width:136px;text-align:center;font-size:13px;color:#111827}
    .attendance-spacer{flex:1}
    .attendance-icon-btn{height:30px;border:1px solid #cfd8e3;border-radius:6px;background:#fff;color:#111827;font-size:13px;padding:0 10px;display:inline-flex;align-items:center;gap:6px}
    .attendance-more{width:34px;justify-content:center}
    .attendance-board-wrap{flex:1;overflow:auto;background:#fff}
    .attendance-board{width:100%;border-collapse:separate;border-spacing:0;table-layout:fixed;min-width:980px}
    .attendance-board th,.attendance-board td{border-right:1px solid #e1e5eb;border-bottom:1px solid #e1e5eb}
    .attendance-board thead th{height:44px;background:#fff;color:#344054;font-size:13px;font-weight:500;text-align:center}
    .attendance-board thead th:first-child{width:126px;text-align:left;padding:0 8px;color:#111827;font-weight:800}
    .attendance-board tbody th{width:126px;background:#fff;text-align:left;vertical-align:top;padding:9px 8px;font-size:13px;color:#111827}
    .attendance-board tbody th strong{display:block;font-size:13px;margin-bottom:3px}
    .attendance-board tbody th span{display:block;font-size:11px;color:#475467;font-weight:400}
    .attendance-board tbody td{height:86px;background:#fff;vertical-align:top;padding:5px}
    .attendance-day-today{color:#0070f4!important;font-weight:700!important}
    .attendance-day-badge{display:inline-flex;align-items:center;justify-content:center;width:22px;height:22px;border-radius:50%;background:#0070f4;color:#fff;margin-left:4px}
    .attendance-card{height:62px;border-radius:6px;padding:8px 7px;background:#fff1df;color:#111827;font-size:12px;line-height:1.35;cursor:pointer}
    .attendance-card.is-clickable:hover{outline:2px solid #0070f4;outline-offset:-2px}
    .attendance-card.is-future{background:#eef0f3}
    .attendance-card.is-ok{background:#eaf8ef}
    .attendance-card.is-warn{background:#fff1df}
    .attendance-card.is-bad{background:#fee9e9}
    .attendance-card.is-muted{background:#eef0f3}
    .attendance-card-name{font-weight:500;margin-bottom:2px}
    .attendance-card-time{color:#344054;margin-bottom:2px}
    .attendance-card-status{font-size:11px;color:#e57200}
    .attendance-card.is-ok .attendance-card-status{color:#12805c}
    .attendance-card.is-bad .attendance-card-status{color:#d92d20}
    .attendance-card.is-muted .attendance-card-status{color:#667085}
    .attendance-footer{height:42px;display:flex;align-items:center;justify-content:center;background:#f8fafc;border-top:1px solid #e1e5eb}
    .attendance-legend{display:flex;align-items:center;gap:24px;background:#fff;border:1px solid #e1e5eb;border-radius:999px;padding:7px 12px;box-shadow:0 12px 28px rgba(15,23,42,.08);font-size:12px;color:#475467}
    .legend-dot{display:inline-flex;align-items:center;justify-content:center;width:12px;height:12px;border-radius:50%;color:#fff;font-size:8px;margin-right:4px}
    .dot-ok{background:#0d8bff}.dot-late{background:#8b5cf6}.dot-missing{background:#ef4444}.dot-pending{background:#f79009}.dot-off{background:#98a2b3}
    .attendance-empty{height:180px;display:flex;align-items:center;justify-content:center;color:#667085;font-size:13px}
    .attendance-modal-backdrop{position:fixed;inset:0;background:rgba(15,23,42,.45);display:none;align-items:center;justify-content:center;z-index:1200;padding:20px}
    .attendance-modal-backdrop.is-open{display:flex}
    .attendance-modal{width:min(520px,100%);background:#fff;border-radius:10px;box-shadow:0 20px 50px rgba(0,0,0,.18);overflow:hidden}
    .attendance-modal-head{padding:16px 18px;border-bottom:1px solid #e5e9ee;font-size:18px;font-weight:700}
    .attendance-modal-body{padding:16px 18px;display:grid;gap:12px}
    .attendance-modal-meta{display:grid;gap:6px;font-size:13px;color:#344054}
    .attendance-modal-meta strong{color:#111827}
    .attendance-modal-field label{display:block;font-size:12px;color:#667085;margin-bottom:4px}
    .attendance-modal-field input,.attendance-modal-field select,.attendance-modal-field textarea{width:100%;height:36px;border:1px solid #cfd8e3;border-radius:6px;padding:0 10px;font-size:13px}
    .attendance-modal-field textarea{height:72px;padding:8px 10px;resize:vertical}
    .attendance-modal-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
    .attendance-modal-foot{padding:12px 18px 16px;border-top:1px solid #e5e9ee;display:flex;justify-content:flex-end;gap:8px}
    @media (max-width: 900px){
      .attendance-page .admin-shell{padding:16px}
      .hr-setup-shell{grid-template-columns:1fr}
      .attendance-app{height:auto;min-height:calc(100vh - 64px)}
      .attendance-topbar{height:auto;flex-wrap:wrap;padding:8px}
      .attendance-title{width:100%;min-width:0}
      .attendance-spacer{display:none}
      .attendance-footer{height:auto;padding:8px}
      .attendance-legend{flex-wrap:wrap;border-radius:8px;gap:10px}
    }
  </style>
</head>
<body class="admin-body attendance-page">
  <%- include('../partials/header', { activeMenu: activeMenu, user: user }) %>
  <main class="admin-shell">
    <%- include('../partials/flash-message', { flash: flash }) %>
    <div class="hr-setup-shell">
      <%- include('../partials/hr-setup-nav', { activeHrPage: activeHrPage }) %>
      <section class="attendance-app">
      <div class="attendance-topbar">
        <h1 class="attendance-title">Bảng chấm công</h1>
        <div class="attendance-search">
          <i class="fa-solid fa-magnifying-glass"></i>
          <select id="attendanceEmployee"><option value="">Tìm kiếm nhân viên</option></select>
        </div>
        <select class="attendance-select" id="attendanceViewMode">
          <option value="week">Theo tuần</option>
        </select>
        <div class="attendance-week-nav">
          <button type="button" id="weekPrev" title="Tuần trước"><i class="fa-solid fa-chevron-left"></i></button>
          <span id="weekLabel">---</span>
          <button type="button" id="weekNext" title="Tuần sau"><i class="fa-solid fa-chevron-right"></i></button>
        </div>
        <button type="button" class="attendance-btn" id="weekPick">Chọn</button>
        <input type="date" id="weekDate" style="position:absolute;opacity:0;pointer-events:none">
        <div class="attendance-spacer"></div>
        <button type="button" class="attendance-icon-btn"><i class="fa-regular fa-calendar-days"></i> Xem theo ca <i class="fa-solid fa-chevron-down"></i></button>
        <button type="button" class="attendance-icon-btn" id="approveVisibleBtn"><i class="fa-regular fa-calendar-check"></i> Duyệt chấm công</button>
        <button type="button" class="attendance-icon-btn attendance-more"><i class="fa-solid fa-ellipsis"></i></button>
      </div>

      <div class="attendance-board-wrap">
        <table class="attendance-board">
          <thead id="attendanceBoardHead"></thead>
          <tbody id="attendanceBoardBody">
            <tr><td><div class="attendance-empty">Đang tải...</div></td></tr>
          </tbody>
        </table>
      </div>

      <div class="attendance-footer">
        <div class="attendance-legend">
          <span><span class="legend-dot dot-ok"><i class="fa-solid fa-check"></i></span>Đúng giờ</span>
          <span><span class="legend-dot dot-late"><i class="fa-solid fa-check"></i></span>Đi muộn / Về sớm</span>
          <span><span class="legend-dot dot-missing"><i class="fa-solid fa-check"></i></span>Chấm công thiếu</span>
          <span><span class="legend-dot dot-pending"><i class="fa-solid fa-check"></i></span>Chưa chấm công</span>
          <span><span class="legend-dot dot-off"><i class="fa-solid fa-check"></i></span>Nghỉ làm</span>
        </div>
      </div>
      </section>
    </div>
  </main>

  <div class="attendance-modal-backdrop" id="attendanceModal">
    <div class="attendance-modal" role="dialog" aria-modal="true">
      <div class="attendance-modal-head">Chấm công</div>
      <div class="attendance-modal-body">
        <div class="attendance-modal-meta">
          <div><strong id="modalEmployeeName">---</strong></div>
          <div>Ngày làm việc: <strong id="modalWorkDate">---</strong></div>
          <div>Ca: <strong id="modalShiftName">---</strong> (<span id="modalShiftTime">---</span>)</div>
        </div>
        <div class="attendance-modal-grid">
          <div class="attendance-modal-field">
            <label for="modalGioVao">Giờ vào</label>
            <input type="time" id="modalGioVao">
          </div>
          <div class="attendance-modal-field">
            <label for="modalGioRa">Giờ ra</label>
            <input type="time" id="modalGioRa">
          </div>
        </div>
        <div class="attendance-modal-field">
          <label for="modalTrangThai">Trạng thái</label>
          <select id="modalTrangThai">
            <option value="chua_cham_cong">Chưa chấm công</option>
            <option value="dung_gio">Đúng giờ</option>
            <option value="di_muon">Đi muộn</option>
            <option value="ve_som">Về sớm</option>
            <option value="di_muon_ve_som">Đi muộn &amp; về sớm</option>
            <option value="cham_cong_thieu">Chấm công thiếu</option>
            <option value="nghi_lam">Nghỉ làm</option>
            <option value="nghi_phep">Nghỉ phép</option>
          </select>
        </div>
        <div class="attendance-modal-field">
          <label for="modalGhiChu">Ghi chú</label>
          <textarea id="modalGhiChu"></textarea>
        </div>
      </div>
      <div class="attendance-modal-foot">
        <button type="button" class="attendance-btn" id="modalCancelBtn">Bỏ qua</button>
        <button type="button" class="attendance-btn" id="modalSaveBtn" style="background:#0070f4;color:#fff;border-color:#0070f4">Lưu</button>
      </div>
    </div>
  </div>

  <script>
    const employeeSelect = document.getElementById('attendanceEmployee');
    const boardHead = document.getElementById('attendanceBoardHead');
    const boardBody = document.getElementById('attendanceBoardBody');
    const weekLabel = document.getElementById('weekLabel');
    const weekDate = document.getElementById('weekDate');
    let currentWeekStart = startOfWeek(new Date());
    let currentBoard = null;
    let cellIndex = {};
    let modalContext = null;

    const APPROVABLE_STATUSES = ['dung_gio', 'di_muon', 've_som', 'di_muon_ve_som', 'cham_cong_thieu'];
    const attendanceModal = document.getElementById('attendanceModal');

    function pad(n) { return String(n).padStart(2, '0'); }
    function dateInput(date) { return date.getFullYear() + '-' + pad(date.getMonth() + 1) + '-' + pad(date.getDate()); }
    function parseDate(value) {
      const parts = String(value || '').slice(0, 10).split('-').map(Number);
      if (parts.length === 3 && parts.every(Boolean)) return new Date(parts[0], parts[1] - 1, parts[2]);
      const d = new Date(value);
      return Number.isNaN(d.getTime()) ? new Date() : new Date(d.getFullYear(), d.getMonth(), d.getDate());
    }
    function addDays(date, days) {
      const d = new Date(date.getFullYear(), date.getMonth(), date.getDate());
      d.setDate(d.getDate() + days);
      return d;
    }
    function startOfWeek(date) {
      date = parseDate(date);
      const day = date.getDay() || 7;
      return addDays(date, 1 - day);
    }
    function weekTitle(start) {
      const week = Math.ceil(start.getDate() / 7);
      return 'Tuần ' + week + ' - Th. ' + (start.getMonth() + 1) + ' ' + start.getFullYear();
    }
    function escapeHtml(value) {
      return String(value == null ? '' : value).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }
    function cardClass(code, dayKey) {
      if (dayKey > dateInput(new Date())) return 'is-future';
      if (code === 'dung_gio' || code === 'dang_lam') return 'is-ok';
      if (code === 'cham_cong_thieu') return 'is-bad';
      if (code === 'nghi_lam' || code === 'nghi_phep') return 'is-muted';
      if (code === 'chua_cham_cong') return 'is-warn';
      return 'is-warn';
    }
    function formatWorkDate(value) {
      const d = parseDate(value);
      return pad(d.getDate()) + '/' + pad(d.getMonth() + 1) + '/' + d.getFullYear();
    }
    function cellKey(shiftKey, dayKey) {
      return String(shiftKey) + '::' + String(dayKey);
    }
    function displayTime(value) {
      if (!value || value === '---') return '---';
      return value;
    }
    function openModal() {
      attendanceModal.classList.add('is-open');
    }
    function closeModal() {
      attendanceModal.classList.remove('is-open');
      modalContext = null;
    }
    function fillModal(cell, shift) {
      document.getElementById('modalEmployeeName').textContent = cell.ten_nhan_vien || '---';
      document.getElementById('modalWorkDate').textContent = formatWorkDate(cell.ngay_lam_viec || cell.day_key);
      document.getElementById('modalShiftName').textContent = shift.ten_ca || 'Ca làm việc';
      document.getElementById('modalShiftTime').textContent =
        (cell.gio_bat_dau || shift.gio_bat_dau || '') + ' - ' + (cell.gio_ket_thuc || shift.gio_ket_thuc || '');
      document.getElementById('modalGioVao').value = cell.gio_vao && cell.gio_vao !== '---' ? cell.gio_vao : (shift.gio_bat_dau || '');
      document.getElementById('modalGioRa').value = cell.gio_ra && cell.gio_ra !== '---' ? cell.gio_ra : (shift.gio_ket_thuc || '');
      document.getElementById('modalTrangThai').value = cell.trang_thai || 'chua_cham_cong';
      document.getElementById('modalGhiChu').value = cell.ghi_chu || '';
      const locked = !!cell.da_duyet;
      document.getElementById('modalSaveBtn').disabled = locked;
      document.getElementById('modalGioVao').disabled = locked;
      document.getElementById('modalGioRa').disabled = locked;
      document.getElementById('modalTrangThai').disabled = locked;
      document.getElementById('modalGhiChu').disabled = locked;
    }
    function toVNTimeText(value) {
      if (!value) return '';
      const d = new Date(value);
      if (Number.isNaN(d.getTime())) return '';
      const vn = new Date(d.getTime() + 7 * 60 * 60000);
      return pad(vn.getUTCHours()) + ':' + pad(vn.getUTCMinutes());
    }
    function applyAttendanceItem(cell, item) {
      if (!item) return cell;
      cell.attendance_id = String(item._id || cell.attendance_id || '');
      cell.trang_thai = item.trang_thai || cell.trang_thai;
      cell.trang_thai_label = item.trang_thai || cell.trang_thai_label;
      cell.ghi_chu = item.ghi_chu || '';
      cell.da_duyet = !!item.da_duyet;
      const gioVao = toVNTimeText(item.gio_vao);
      const gioRa = toVNTimeText(item.gio_ra);
      if (gioVao) cell.gio_vao = gioVao;
      if (gioRa) cell.gio_ra = gioRa;
      return cell;
    }
    async function ensureAttendance(cell) {
      if (cell.attendance_id) return cell;
      if (!cell.schedule_id) throw new Error('Ô này chưa có lịch làm việc');
      const res = await fetch('/api/cham-cong/from-lich-lam-viec', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({ lich_lam_viec_id: cell.schedule_id })
      });
      const json = await res.json();
      if (!json.success) throw new Error(json.message || 'Không tạo được chấm công từ lịch');
      return applyAttendanceItem(cell, json.item);
    }
    async function openCellEditor(shift, day, cell) {
      try {
        const working = Object.assign({}, cell, { day_key: day.key });
        const readyCell = await ensureAttendance(working);
        modalContext = { shift: shift, day: day, cell: readyCell };
        fillModal(readyCell, shift);
        openModal();
      } catch (error) {
        alert(error.message || 'Không mở được chấm công');
      }
    }
    async function saveModal() {
      if (!modalContext || !modalContext.cell.attendance_id) {
        return alert('Chưa có bản chấm công để lưu');
      }
      if (modalContext.cell.da_duyet) {
        return alert('Bản chấm công đã duyệt, không thể sửa');
      }
      const payload = {
        gio_vao_time: document.getElementById('modalGioVao').value,
        gio_ra_time: document.getElementById('modalGioRa').value,
        trang_thai: document.getElementById('modalTrangThai').value,
        ghi_chu: document.getElementById('modalGhiChu').value.trim()
      };
      const res = await fetch('/api/cham-cong/' + encodeURIComponent(modalContext.cell.attendance_id), {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(payload)
      });
      const json = await res.json();
      if (!json.success) return alert(json.message || 'Không lưu được chấm công');
      closeModal();
      await loadBoard();
    }

    async function loadLookup() {
      const res = await fetch('/api/cham-cong/lookup-options', { headers: { Accept: 'application/json' } });
      const json = await res.json();
      if (!json.success) throw new Error(json.message || 'Không tải được nhân viên');
      employeeSelect.innerHTML = '<option value="">Tìm kiếm nhân viên</option>';
      (json.employees || []).forEach(function(employee) {
        const option = document.createElement('option');
        option.value = String(employee._id || '');
        option.textContent = (employee.ma_nhan_vien ? employee.ma_nhan_vien + ' - ' : '') + (employee.ten_nhan_vien || '');
        employeeSelect.appendChild(option);
      });
      if (!employeeSelect.value && employeeSelect.options.length > 1) employeeSelect.selectedIndex = 1;
    }

    async function loadBoard() {
      weekLabel.textContent = weekTitle(currentWeekStart);
      weekDate.value = dateInput(currentWeekStart);
      const employeeId = employeeSelect.value;
      if (!employeeId) {
        boardHead.innerHTML = '';
        boardBody.innerHTML = '<tr><td><div class="attendance-empty">Chọn nhân viên để xem ca và chấm công.</div></td></tr>';
        return;
      }
      boardBody.innerHTML = '<tr><td><div class="attendance-empty">Đang tải...</div></td></tr>';
      const params = new URLSearchParams({ nhan_vien_id: employeeId, tu_ngay: dateInput(currentWeekStart) });
      const res = await fetch('/api/cham-cong/weekly-board?' + params.toString(), { headers: { Accept: 'application/json' } });
      const json = await res.json();
      if (!json.success) {
        boardHead.innerHTML = '';
        boardBody.innerHTML = '<tr><td><div class="attendance-empty">' + escapeHtml(json.message || 'Không tải được bảng chấm công') + '</div></td></tr>';
        return;
      }
      currentBoard = json;
      renderBoard(json);
    }

    function renderBoard(data) {
      const days = data.days || [];
      boardHead.innerHTML = '<tr><th>Ca làm việc <button type="button" class="attendance-icon-btn attendance-more" style="float:right;border:0;background:transparent"><i class="fa-solid fa-plus"></i></button></th>' +
        days.map(function(day) {
          return '<th class="' + (day.is_today ? 'attendance-day-today' : '') + '">' +
            escapeHtml(day.weekday) + ' ' + (day.is_today ? '<span class="attendance-day-badge">' + day.day_of_month + '</span>' : day.day_of_month) +
          '</th>';
        }).join('') + '</tr>';

      const shifts = data.shifts || [];
      if (!shifts.length) {
        boardBody.innerHTML = '<tr><td colspan="' + (days.length + 1) + '"><div class="attendance-empty">Nhân viên này chưa có ca trong tuần đã chọn.</div></td></tr>';
        return;
      }
      cellIndex = {};
      boardBody.innerHTML = shifts.map(function(shift) {
        return '<tr><th><strong>' + escapeHtml(shift.ten_ca || 'Ca làm việc') + '</strong><span>' +
          escapeHtml((shift.gio_bat_dau || '') + ' - ' + (shift.gio_ket_thuc || '')) + '</span></th>' +
          days.map(function(day) {
            const cell = shift.cells && shift.cells[day.key];
            if (!cell || !cell.schedule_id) return '<td></td>';
            const idx = cellKey(shift.key, day.key);
            cellIndex[idx] = { shift: shift, day: day, cell: cell };
            const gioVaoText = displayTime(cell.gio_vao) || '---';
            const gioRaText = displayTime(cell.gio_ra) || '---';
            const statusText = cell.attendance_id
              ? (cell.trang_thai_label || cell.trang_thai || '')
              : 'Chưa có chấm công';
            return '<td>' +
              '<div class="attendance-card is-clickable ' + cardClass(cell.trang_thai || 'chua_cham_cong', day.key) + '" data-cell-key="' + escapeHtml(idx) + '">' +
                '<div class="attendance-card-name">' + escapeHtml(cell.ten_nhan_vien || '') + '</div>' +
                '<div class="attendance-card-time">' + escapeHtml(gioVaoText + ' - ' + gioRaText) + '</div>' +
                '<div class="attendance-card-status">' + escapeHtml(statusText) + (cell.da_duyet ? ' · Đã duyệt' : '') + '</div>' +
              '</div>' +
            '</td>';
          }).join('') +
        '</tr>';
      }).join('');

      boardBody.querySelectorAll('.attendance-card[data-cell-key]').forEach(function(card) {
        card.addEventListener('click', function() {
          const ctx = cellIndex[card.dataset.cellKey];
          if (!ctx) return;
          openCellEditor(ctx.shift, ctx.day, ctx.cell);
        });
      });
    }

    async function approveVisible() {
      if (!currentBoard) return;
      const ids = [];
      (currentBoard.shifts || []).forEach(function(shift) {
        Object.keys(shift.cells || {}).forEach(function(key) {
          const cell = shift.cells[key];
          if (
            cell.attendance_id &&
            !cell.da_duyet &&
            APPROVABLE_STATUSES.indexOf(cell.trang_thai) >= 0
          ) ids.push(cell.attendance_id);
        });
      });
      if (!ids.length) return alert('Không có bản chấm công nào cần duyệt trong tuần này.');
      if (!confirm('Duyệt ' + ids.length + ' bản chấm công đang hiển thị?')) return;
      for (const id of ids) {
        const res = await fetch('/api/cham-cong/' + encodeURIComponent(id) + '/duyet', { method: 'POST', headers: { Accept: 'application/json' } });
        const json = await res.json();
        if (!json.success) return alert(json.message || 'Lỗi duyệt chấm công');
      }
      await loadBoard();
    }

    employeeSelect.addEventListener('change', loadBoard);
    document.getElementById('weekPrev').addEventListener('click', function() { currentWeekStart = addDays(currentWeekStart, -7); loadBoard(); });
    document.getElementById('weekNext').addEventListener('click', function() { currentWeekStart = addDays(currentWeekStart, 7); loadBoard(); });
    document.getElementById('weekPick').addEventListener('click', function() { weekDate.showPicker ? weekDate.showPicker() : weekDate.click(); });
    weekDate.addEventListener('change', function() { currentWeekStart = startOfWeek(weekDate.value); loadBoard(); });
    document.getElementById('approveVisibleBtn').addEventListener('click', approveVisible);
    document.getElementById('modalCancelBtn').addEventListener('click', closeModal);
    document.getElementById('modalSaveBtn').addEventListener('click', saveModal);
    attendanceModal.addEventListener('click', function(event) {
      if (event.target === attendanceModal) closeModal();
    });

    (async function init() {
      try {
        await loadLookup();
        await loadBoard();
      } catch (error) {
        boardBody.innerHTML = '<tr><td><div class="attendance-empty">' + escapeHtml(error.message || 'Không tải được dữ liệu') + '</div></td></tr>';
      }
    })();
  </script>
</body>
</html>
