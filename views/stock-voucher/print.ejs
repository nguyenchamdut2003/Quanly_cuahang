<%
  const v = voucher || {};
  const fmt = value => Number(value || 0).toLocaleString('vi-VN');
  const d = value => value ? new Date(value).toLocaleDateString('vi-VN') : '';
  const business = v.business || {};
  const store = v.store || {};
  const warehouse = v.warehouse || {};
  const creator = v.creator || {};
  const creatorName = creator.ho_ten || creator.username || creator.email || '';
  const storeName = business.ten_cua_hang || store.ten_cua_hang || 'Cửa hàng';
  const storeAddress = business.dia_chi_day_du || store.dia_chi_day_du || store.dia_chi || '';
  const storePhone = business.sdt || store.sdt || business.email || store.email || '';
  const printUrl = '/chung-tu-kho/' + v.type + '/' + v.id;
  const pdfQs = v.inventoryPrintVariant ? ('?variant=' + encodeURIComponent(v.inventoryPrintVariant)) : '';
  const invoiceTotals = v.invoiceTotals || {};
  const retailRowsWithNameRowspan = rows => {
    const markSameValueRuns = (groupRows, field, showProp, spanProp) => {
      let start = 0;
      while (start < groupRows.length) {
        const value = String(groupRows[start][field] || '').trim();
        let end = start + 1;
        while (end < groupRows.length && String(groupRows[end][field] || '').trim() === value) end += 1;
        groupRows.forEach((row, index) => {
          if (index >= start && index < end) {
            row[showProp] = index === start;
            row[spanProp] = end - start;
          }
        });
        start = end;
      }
    };
    const groups = [];
    const byName = {};
    (rows || []).forEach(row => {
      const key = String(row.ten_hang || '').trim().toLowerCase() || ('__row_' + groups.length);
      if (!byName[key]) {
        byName[key] = { rows: [] };
        groups.push(byName[key]);
      }
      byName[key].rows.push(row);
    });
    return groups.reduce((list, group) => {
      const groupRows = group.rows.map((row, index) => (
        Object.assign({}, row, {
          _showTenHang: index === 0,
          _tenHangRowspan: group.rows.length
        })
      ));
      markSameValueRuns(groupRows, 'nha_cung_cap', '_showNhaCungCap', '_nhaCungCapRowspan');
      markSameValueRuns(groupRows, 'lo', '_showLo', '_loRowspan');
      groupRows.forEach(row => list.push(row));
      return list;
    }, []);
  };
%>
<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title || v.title || 'Chứng từ kho' %></title>
  <style>
    body{font-family:Arial,sans-serif;color:#111;margin:0;background:#f3f4f6}
    .page{width:210mm;min-height:297mm;margin:0 auto;background:#fff;padding:16mm;box-sizing:border-box}
    h1{text-align:center;font-size:22px;margin:14px 0 6px;text-transform:uppercase}
    .store{text-align:center;font-size:13px}
    .movement{text-align:center;font-size:13px;font-weight:bold;margin-top:4px}
    .meta{display:grid;grid-template-columns:1fr 1fr;gap:6px 24px;font-size:13px;margin:14px 0}
    table{width:100%;border-collapse:collapse;margin-top:12px}
    th,td{border:1px solid #333;padding:5px 6px;font-size:11.5px}
    th{text-align:center;background:#f1f5f9}
    .num{text-align:right}
    .note-cell{word-break:break-word}
    .retail-invoice-table th,.retail-invoice-table td{font-size:10.5px;padding:4px 5px}
    .supplier-cell{word-break:break-word}
    .summary{width:80mm;margin-left:auto;margin-top:12px;font-size:13px}
    .summary div{display:flex;justify-content:space-between;padding:4px 0;gap:16px}
    .sign{display:grid;grid-template-columns:1fr 1fr 1fr;margin-top:32px;text-align:center;font-size:13px}
    .sign b{display:block;margin-bottom:46px}
    .copy-label{text-align:center;font-size:13px;font-weight:bold;margin:2px 0 8px}
    .page + .page{page-break-before:always;margin-top:12mm}
    .bundle-shell{height:100vh;display:flex;flex-direction:column;min-width:1024px}
    .bundle-header{height:54px;background:#fff;border-bottom:1px solid #d7dee8;display:flex;align-items:center;justify-content:space-between;padding:0 16px}
    .bundle-title{font-weight:800;font-size:16px}.bundle-title span{color:#0070f4}
    .bundle-actions{display:flex;gap:8px}.bundle-btn{height:34px;border:1px solid #c6d3e1;background:#fff;border-radius:6px;padding:0 12px;font-weight:700;color:#111827;text-decoration:none;display:inline-flex;align-items:center;cursor:pointer}.bundle-btn.primary{border-color:#0070f4;color:#0070f4}
    .bundle-grid{flex:1;min-height:0;display:grid;grid-template-columns:1fr 1fr;gap:12px;padding:12px}
    .print-pane{min-width:0;background:#fff;border:1px solid #d7dee8;border-radius:8px;display:flex;flex-direction:column;overflow:hidden}
    .pane-head{height:42px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #e5ebf2;padding:0 10px;background:#f8fafc}
    .pane-head strong{font-size:14px}.pane-actions{display:flex;gap:6px}.pane-actions a,.pane-actions button{height:28px;border:1px solid #c6d3e1;background:#fff;border-radius:5px;padding:0 9px;font-size:12px;font-weight:700;text-decoration:none;color:#111827;display:inline-flex;align-items:center;cursor:pointer}
    iframe{width:100%;height:100%;border:0;background:#fff}.frame-wrap{flex:1;min-height:0}
    @media(max-width:1100px){.bundle-shell{min-width:0;height:auto;min-height:100vh}.bundle-grid{grid-template-columns:1fr}.print-pane{height:82vh}}
    .print-actions{position:fixed;right:18px;top:18px;display:flex;gap:8px}
    .print-actions button,.print-actions a{border:1px solid #1f2937;background:#fff;color:#111;padding:7px 12px;border-radius:3px;font-family:Arial,sans-serif;font-size:13px;cursor:pointer;text-decoration:none}
    @media print{body{background:#fff}.page{margin:0;width:auto;min-height:auto;padding:12mm}.no-print{display:none!important}}
  </style>
</head>
<body>
  <% if (v.isRetailInvoice && !v.embeddedPrint && !v.invoicePrintCopy) { %>
    <div class="bundle-shell">
      <header class="bundle-header">
        <div class="bundle-title">In hóa đơn <span><%= v.code || '' %></span></div>
        <div class="bundle-actions">
          <a class="bundle-btn" href="/don-hang/hoa-don">Quay lại</a>
          <button class="bundle-btn primary" type="button" onclick="printBoth()">In cả 2</button>
        </div>
      </header>
      <main class="bundle-grid">
        <section class="print-pane">
          <div class="pane-head">
            <strong>Bản cửa hàng</strong>
            <div class="pane-actions">
              <button type="button" onclick="printFrame('storeFrame')">In</button>
              <a href="<%= printUrl %>/pdf?copy=store" target="_blank">Tải PDF</a>
              <a href="<%= printUrl %>?copy=store" target="_blank">Mở riêng</a>
            </div>
          </div>
          <div class="frame-wrap"><iframe id="storeFrame" src="<%= printUrl %>?embed=1&copy=store"></iframe></div>
        </section>
        <section class="print-pane">
          <div class="pane-head">
            <strong>Bản khách hàng</strong>
            <div class="pane-actions">
              <button type="button" onclick="printFrame('customerFrame')">In</button>
              <a href="<%= printUrl %>/pdf?copy=customer" target="_blank">Tải PDF</a>
              <a href="<%= printUrl %>?copy=customer" target="_blank">Mở riêng</a>
            </div>
          </div>
          <div class="frame-wrap"><iframe id="customerFrame" src="<%= printUrl %>?embed=1&copy=customer"></iframe></div>
        </section>
      </main>
    </div>
    <script>
      function printFrame(id) {
        const frame = document.getElementById(id);
        if (!frame || !frame.contentWindow) return;
        frame.contentWindow.focus();
        frame.contentWindow.print();
      }
      function printBoth() {
        printFrame('storeFrame');
        setTimeout(function() { printFrame('customerFrame'); }, 500);
      }
    </script>
  <% } else { %>
  <% if (!v.embeddedPrint) { %>
    <div class="print-actions no-print">
      <button type="button" onclick="window.print()">In</button>
      <a href="<%= printUrl %>/pdf<%= pdfQs %>">Tải PDF</a>
    </div>
  <% } %>
  <% if (v.isRetailInvoice) { %>
    <%
      const retailCopies = v.invoicePrintCopy === 'store'
        ? ['Cửa hàng']
        : (v.invoicePrintCopy === 'customer' ? ['Khách hàng'] : ['Cửa hàng', 'Khách hàng']);
    %>
    <% retailCopies.forEach(function(copyType) { const isStoreCopy = copyType === 'Cửa hàng'; const retailRows = retailRowsWithNameRowspan(v.items || []); %>
      <main class="page">
        <div class="store">
          <strong><%= storeName %></strong><br>
          <%= storeAddress %><%= storePhone ? (' - ' + storePhone) : '' %>
        </div>
        <h1><%= v.heading || 'HÓA ĐƠN BÁN HÀNG' %></h1>
        <div class="copy-label">Bản <%= copyType %></div>
        <div style="text-align:center;font-size:13px">Mã hóa đơn: <strong><%= v.code || '' %></strong></div>

        <section class="meta">
          <div>Ngày bán: <strong><%= d(v.date) %></strong></div>
          <div>Kho: <strong><%= warehouse.ten_kho || warehouse.ma_kho || '' %></strong></div>
          <div>Người bán: <strong><%= creatorName %></strong></div>
          <div>Khách hàng: <strong><%= v.partnerText || '' %></strong></div>
          <div>Ghi chú: <strong><%= v.note || '' %></strong></div>
        </section>

        <table class="retail-invoice-table">
          <thead>
            <% if (isStoreCopy) { %>
              <tr><th>STT</th><th>Tên hàng</th><th>Nhà cung cấp</th><th>Lô</th><th>Thuộc tính</th><th>Số lượng</th><th>Đơn giá</th><th>Thành tiền</th><th>Ghi chú</th></tr>
            <% } else { %>
              <tr><th>STT</th><th>Tên hàng</th><th>Nhà cung cấp</th><th>Thuộc tính</th><th>Số lượng</th><th>Đơn giá</th><th>Thành tiền</th><th>Ghi chú</th></tr>
            <% } %>
          </thead>
          <tbody>
            <% retailRows.forEach(function(row, index) { %>
              <% if (isStoreCopy) { %>
                <tr>
                  <td class="num"><%= index + 1 %></td>
                  <% if (row._showTenHang) { %><td<%- row._tenHangRowspan > 1 ? (' rowspan="' + row._tenHangRowspan + '"') : '' %>><%= row.ten_hang || '' %></td><% } %>
                  <% if (row._showNhaCungCap) { %><td class="supplier-cell"<%- row._nhaCungCapRowspan > 1 ? (' rowspan="' + row._nhaCungCapRowspan + '"') : '' %>><%= row.nha_cung_cap || '' %></td><% } %>
                  <% if (row._showLo) { %><td<%- row._loRowspan > 1 ? (' rowspan="' + row._loRowspan + '"') : '' %>><%= row.lo || '' %></td><% } %>
                  <td><%= row.thuoc_tinh || '' %></td>
                  <td class="num"><%= fmt(row.so_luong) %></td>
                  <td class="num"><%= fmt(row.don_gia) %></td>
                  <td class="num"><%= fmt(row.thanh_tien) %></td>
                  <td class="note-cell"><%= row.ghi_chu || '' %></td>
                </tr>
              <% } else { %>
                <tr>
                  <td class="num"><%= index + 1 %></td>
                  <% if (row._showTenHang) { %><td<%- row._tenHangRowspan > 1 ? (' rowspan="' + row._tenHangRowspan + '"') : '' %>><%= row.ten_hang || '' %></td><% } %>
                  <% if (row._showNhaCungCap) { %><td class="supplier-cell"<%- row._nhaCungCapRowspan > 1 ? (' rowspan="' + row._nhaCungCapRowspan + '"') : '' %>><%= row.nha_cung_cap || '' %></td><% } %>
                  <td><%= row.thuoc_tinh || '' %></td>
                  <td class="num"><%= fmt(row.so_luong) %></td>
                  <td class="num"><%= fmt(row.don_gia) %></td>
                  <td class="num"><%= fmt(row.thanh_tien) %></td>
                  <td class="note-cell"><%= row.ghi_chu || '' %></td>
                </tr>
              <% } %>
            <% }) %>
          </tbody>
        </table>

        <section class="summary">
          <div><span>Tổng tiền hàng</span><strong><%= fmt(invoiceTotals.goods || 0) %> VND</strong></div>
          <div><span>Chiết khấu</span><strong><%= fmt(invoiceTotals.discount || 0) %> VND</strong></div>
          <div><span>Khách cần trả</span><strong><%= fmt(invoiceTotals.payable || 0) %> VND</strong></div>
          <div><span>Khách đã trả</span><strong><%= fmt(invoiceTotals.paid || 0) %> VND</strong></div>
          <div><span>Còn nợ</span><strong><%= fmt(invoiceTotals.debt || 0) %> VND</strong></div>
        </section>

        <section class="sign">
          <div><b>Người lập phiếu</b>(Ký, ghi rõ họ tên)</div>
          <div><b><%= isStoreCopy ? 'Thủ kho' : 'Người bán' %></b>(Ký, ghi rõ họ tên)</div>
          <div><b><%= isStoreCopy ? 'Cửa hàng' : 'Người mua' %></b>(Ký, ghi rõ họ tên)</div>
        </section>
      </main>
    <% }) %>
  <% } else { %>
  <main class="page">
    <div class="store">
      <strong><%= storeName %></strong><br>
      <%= storeAddress %><%= storePhone ? (' - ' + storePhone) : '' %>
    </div>
    <h1><%= v.isInventoryCheck && v.inventoryPrintVariant === 'thuc-te' ? 'PHIẾU KIỂM KHO — SỐ LƯỢNG THỰC TẾ' : (v.isInventoryCheck && v.inventoryPrintVariant === 'gia-tri-kho' ? 'PHIẾU GIÁ TRỊ KHO' : (v.heading || v.title || 'Chứng từ kho')) %></h1>
    <div class="movement"><%= v.movement || '' %></div>
    <div style="text-align:center;font-size:13px">Mã phiếu: <strong><%= v.code || '' %></strong></div>

    <section class="meta">
      <div>Ngày lập: <strong><%= d(v.date) %></strong></div>
      <div>Kho: <strong><%= warehouse.ten_kho || warehouse.ma_kho || '' %></strong></div>
      <div>Người lập: <strong><%= creatorName %></strong></div>
      <div>Loại chứng từ: <strong><%= v.movement || '' %></strong></div>
      <% if (v.partnerLabel || v.partnerText) { %>
        <div><%= v.partnerLabel || 'Đối tượng' %>: <strong><%= v.partnerText || '' %></strong></div>
      <% } %>
      <% if (v.sourceLabel || v.sourceText) { %>
        <div><%= v.sourceLabel || 'Chứng từ gốc' %>: <strong><%= v.sourceText || '' %></strong></div>
      <% } %>
      <% if (v.reasonLabel || v.reasonText) { %>
        <div><%= v.reasonLabel || 'Lý do' %>: <strong><%= v.reasonText || '' %></strong></div>
      <% } %>
      <div>Ghi chú: <strong><%= v.note || '' %></strong></div>
    </section>

    <% if (v.isInventoryCheck && v.inventoryPrintVariant === 'gia-tri-kho') { %>
      <table>
        <thead>
          <tr>
            <th>STT</th><th>Mã hàng</th><th>Tên hàng</th><th>Tên lô</th><th>Thuộc tính</th>
            <th>Hạn SD</th><th>NCC</th><th>Số lượng tồn</th><th>Đơn giá vốn</th><th>Giá trị kho</th>
          </tr>
        </thead>
        <tbody>
          <% (v.giaTriKhoItems || []).forEach(function(row, index) { %>
            <tr>
              <td class="num"><%= index + 1 %></td>
              <td><%= row.ma_hang || '' %></td>
              <td><%= row.ten_hang || '' %></td>
              <td><%= row.lo || '' %></td>
              <td><%= row.thuoc_tinh || '' %></td>
              <td><%= row.han_su_dung ? new Date(row.han_su_dung).toLocaleDateString('vi-VN') : '' %></td>
              <td><%= row.ten_ncc || '---' %></td>
              <td class="num"><%= fmt(row.so_luong_ton) %></td>
              <td class="num"><%= fmt(row.don_gia_von) %></td>
              <td class="num"><%= fmt(row.gia_tri_kho) %> VND</td>
            </tr>
          <% }) %>
        </tbody>
      </table>
      <section class="summary">
        <div><span>Tổng số lượng tồn</span><strong><%= fmt(v.giaTriKhoTotals && v.giaTriKhoTotals.quantity) %></strong></div>
        <div><span>Tổng giá trị kho</span><strong><%= fmt(v.giaTriKhoTotals && v.giaTriKhoTotals.value) %> VND</strong></div>
      </section>
      <p style="font-size:12px;color:#475467;margin-top:8px">Giá trị kho = Số lượng tồn × Đơn giá vốn (khác với giá trị lệch trên phiếu kiểm chênh lệch).</p>
    <% } else if (v.isInventoryCheck && v.inventoryPrintVariant === 'thuc-te') { %>
      <table>
        <thead>
          <tr><th>STT</th><th>Mã hàng</th><th>Tên hàng</th><th>Thuộc tính</th><th>Tên lô</th><th>Số lượng thực tế</th><th>Ghi chú</th></tr>
        </thead>
        <tbody>
          <% (v.items || []).forEach(function(row, index) { %>
            <tr>
              <td class="num"><%= index + 1 %></td>
              <td><%= row.ma_hang || '' %></td>
              <td><%= row.ten_hang || '' %></td>
              <td><%= row.thuoc_tinh || '' %></td>
              <td><%= row.lo || '' %></td>
              <td class="num"><%= fmt(row.ton_thuc_te) %></td>
              <td class="note-cell"><%= row.ghi_chu || '' %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
      <section class="summary">
        <div><span>Tổng số lượng thực tế</span><strong><%= fmt(v.total_so_luong_thuc_te) %></strong></div>
      </section>
    <% } else if (v.isInventoryCheck) { %>
      <table>
        <thead>
          <tr><th>STT</th><th>Mã hàng</th><th>Tên hàng</th><th>Thuộc tính</th><th>Tên lô</th><th>Tồn hệ thống</th><th>Tồn thực tế</th><th>Chênh lệch</th><th>Giá trị lệch</th><th>Ghi chú</th></tr>
        </thead>
        <tbody>
          <% (v.items || []).forEach(function(row, index) { %>
            <tr>
              <td class="num"><%= index + 1 %></td>
              <td><%= row.ma_hang || '' %></td>
              <td><%= row.ten_hang || '' %></td>
              <td><%= row.thuoc_tinh || '' %></td>
              <td><%= row.lo || '' %></td>
              <td class="num"><%= fmt(row.ton_he_thong) %></td>
              <td class="num"><%= fmt(row.ton_thuc_te) %></td>
              <td class="num"><%= fmt(row.chenh_lech) %></td>
              <td class="num"><%= fmt(row.gia_tri_lech) %> VND</td>
              <td class="note-cell"><%= row.ghi_chu || '' %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
      <section class="summary">
        <div><span>Tổng chênh lệch</span><strong><%= fmt(v.totals && v.totals.quantity) %></strong></div>
        <div><span>Tổng giá trị lệch</span><strong><%= fmt(v.totals && v.totals.value) %> VND</strong></div>
      </section>
    <% } else { %>
      <table>
        <thead>
          <tr><th>STT</th><th>Mã hàng</th><th>Tên hàng</th><th>Thuộc tính/Size</th><th>Lô</th><th>Số lượng</th><th>Đơn giá/Giá vốn</th><th>Thành tiền</th><th>Ghi chú</th></tr>
        </thead>
        <tbody>
          <% (v.items || []).forEach(function(row, index) { %>
            <tr>
              <td class="num"><%= index + 1 %></td>
              <td><%= row.ma_hang || '' %></td>
              <td><%= row.ten_hang || '' %></td>
              <td><%= row.thuoc_tinh || '' %></td>
              <td><%= row.lo || '' %></td>
              <td class="num"><%= fmt(row.so_luong) %></td>
              <td class="num"><%= fmt(row.don_gia) %></td>
              <td class="num"><%= fmt(row.thanh_tien) %></td>
              <td class="note-cell"><%= row.ghi_chu || '' %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
      <section class="summary">
        <div><span>Tổng số lượng</span><strong><%= fmt(v.totals && v.totals.quantity) %></strong></div>
        <div><span>Tổng giá trị</span><strong><%= fmt(v.totals && v.totals.value) %> VND</strong></div>
      </section>
    <% } %>

    <section class="sign">
      <div><b>Người lập phiếu</b>(Ký, ghi rõ họ tên)</div>
      <div><b>Thủ kho</b>(Ký, ghi rõ họ tên)</div>
      <div><b>Người nhận/đối soát</b>(Ký, ghi rõ họ tên)</div>
    </section>
  </main>
  <% } %>
  <% } %>
</body>
</html>
