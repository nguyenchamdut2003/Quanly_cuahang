    .return-pagination{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
    .return-page-link{min-width:46px;height:28px;padding:0 10px;border:1px solid #cbd5e1;border-radius:6px;background:#fff;color:#111827;text-decoration:none;display:inline-flex;align-items:center;justify-content:center;font-weight:700}
    .return-page-link.is-disabled{color:#94a3b8;background:#f8fafc;pointer-events:none}
    .return-page-current{font-weight:800;color:#111827}
    .receipt-pay-action{display:flex;justify-content:flex-end;margin-top:10px}
    .receipt-pay-modal{position:fixed;inset:0;background:rgba(15,23,42,.45);display:none;align-items:center;justify-content:center;z-index:1350;padding:16px}
    .receipt-pay-modal.open{display:flex}
    .receipt-pay-card{width:min(520px,calc(100vw - 32px));max-height:calc(100vh - 64px);overflow:auto;background:#fff;border-radius:8px;padding:18px;box-shadow:0 18px 44px rgba(15,23,42,.28)}
    .receipt-pay-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:12px}
    .receipt-pay-head h3{margin:0;font-size:18px}
    .receipt-pay-close{border:0;background:#fff;font-size:24px;cursor:pointer;color:#667085}
    .quick-pay-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
    .quick-pay-grid label{display:flex;flex-direction:column;gap:5px;font-size:13px;color:#475467}
    .quick-pay-grid label.full{grid-column:1/-1}
    .quick-pay-grid input,.quick-pay-grid select{width:100%;height:36px;border:1px solid #cfd8e3;border-radius:6px;padding:7px 8px;font-size:14px;box-sizing:border-box}
    .pay-total-readonly{font-size:15px;font-weight:700;color:#006dff;padding:4px 0}
    .pay-total-summary{font-size:13px;font-weight:600;color:#111827;padding:4px 0}
    .pay-summary-error{font-size:12px;color:#b45309;font-weight:600;padding:4px 0}
    .receipt-pay-foot{display:flex;justify-content:flex-end;gap:8px;margin-top:14px;padding-top:14px;border-top:1px solid #e5e9ee}
    .return-trash-modal{position:fixed;inset:0;background:rgba(15,23,42,.48);display:none;align-items:center;justify-content:center;z-index:1400;padding:18px}
    .return-trash-modal.is-open{display:flex}
    .return-trash-card{width:min(720px,calc(100vw - 36px));max-height:calc(100vh - 48px);overflow:auto;background:#fff;border-radius:8px;box-shadow:0 20px 50px rgba(15,23,42,.28)}
    .return-trash-head,.return-trash-foot{display:flex;align-items:center;justify-content:space-between;padding:16px 18px;border-bottom:1px solid #e5e9ee}
    .return-trash-foot{border-top:1px solid #e5e9ee;border-bottom:0;justify-content:flex-end;gap:8px}
    .return-trash-head h3{margin:0;font-size:18px;font-weight:800}
    .return-trash-close{border:0;background:#fff;font-size:24px;line-height:1;cursor:pointer;color:#667085}
    .return-trash-body{padding:16px 18px}
    .return-trash-alert{border-radius:6px;padding:9px 10px;margin:7px 0;font-size:13px;line-height:1.4}
    .return-trash-alert.is-warn{background:#fff7ed;color:#9a3412;border:1px solid #fed7aa}
    .return-trash-alert.is-error{background:#fef2f2;color:#991b1b;border:1px solid #fecaca}
    .return-trash-list{margin:8px 0 12px;padding-left:20px;font-size:13px}
    .return-trash-impact{width:100%;border-collapse:collapse;margin-top:10px}
    .return-trash-impact th,.return-trash-impact td{border:1px solid #e4eaf2;padding:8px;font-size:13px;text-align:left}
    .return-trash-impact th{background:#f4f8fc;font-weight:800}
    .return-trash-impact .num{text-align:right}
    @media(max-width:1100px){.return-shell{padding:12px 24px 14px;grid-template-columns:200px minmax(0,1fr)}}
    @media(max-width:1024px){
      .return-detail-split{flex-direction:column;align-items:stretch;gap:20px}
      .return-detail-main{width:100%;min-width:0}
      .return-summary-box{flex:none;width:100%;max-width:100%;min-width:0}
    }
    @media(max-width:640px){.return-shell{padding:10px 16px 12px}}
  </style>
</head>
<body class="admin-body">
  <%- include('../partials/header', { activeMenu: activeMenu, user: user }) %>
  <form method="GET" action="/tra-hang-nhap" class="return-page" id="returnFilterForm">
    <input type="hidden" name="page" id="returnPageInput" value="<%= safePagination.page %>">
    <div class="return-shell">
      <aside class="sidebar">
        <h1 class="title">Trả hàng nhập</h1>
        <div class="filter-block">
          <div class="filter-title">Trạng thái</div>
          <label class="check-line"><input type="checkbox" name="trang_thai" value="draft" <%= !selectedStatuses.length || selectedStatuses.includes('draft') ? 'checked' : '' %> onchange="submitReturnFilters()"> Phiếu tạm</label>
          <label class="check-line"><input type="checkbox" name="trang_thai" value="completed" <%= !selectedStatuses.length || selectedStatuses.includes('completed') ? 'checked' : '' %> onchange="submitReturnFilters()"> Đã trả hàng</label>
          <label class="check-line"><input type="checkbox" name="trang_thai" value="cancelled" <%= selectedStatuses.includes('cancelled') ? 'checked' : '' %> onchange="submitReturnFilters()"> Đã hủy</label>
        </div>
        <div class="filter-block">
          <div class="filter-title">Thời gian</div>
          <label class="radio-line"><input type="radio" name="time_type" value="this_month" <%= safeFilters.time_type === 'this_month' ? 'checked' : '' %> onchange="submitReturnFilters()"><span class="radio-pill">Tháng này <span>›</span></span></label>
          <label class="radio-line"><input type="radio" name="time_type" value="custom" <%= safeFilters.time_type === 'custom' ? 'checked' : '' %> onchange="submitReturnFilters()"><span class="radio-pill">Tùy chỉnh <span>›</span></span></label>
          <input class="filter-control" type="date" name="date_from" value="<%= safeFilters.date_from || '' %>" onchange="submitReturnFilters()">
          <input class="filter-control" type="date" name="date_to" value="<%= safeFilters.date_to || '' %>" onchange="submitReturnFilters()">
        </div>
        <div class="filter-block">
          <div class="filter-title">Người tạo</div>
          <select class="filter-control" name="nguoi_tao" onchange="submitReturnFilters()">
            <option value="">Chọn người tạo</option>
            <% safeUsers.forEach(function(u) { %>
              <option value="<%= u._id %>" <%= String(safeFilters.nguoi_tao || '') === String(u._id) ? 'selected' : '' %>><%= u.ho_ten || u.email %></option>
            <% }) %>
          </select>
        </div>
        <div class="filter-block">
          <div class="filter-title">Người trả</div>
          <select class="filter-control" name="nguoi_tra" onchange="submitReturnFilters()">
            <option value="">Chọn người trả</option>
            <% safeUsers.forEach(function(u) { %>
              <option value="<%= u._id %>" <%= String(safeFilters.nguoi_tra || '') === String(u._id) ? 'selected' : '' %>><%= u.ho_ten || u.email %></option>
            <% }) %>
          </select>
        </div>
      </aside>
      <main class="main">
        <div class="toolbar">
          <div class="search"><input name="q" value="<%= safeFilters.q || '' %>" placeholder="Theo mã phiếu trả"></div>
          <div class="actions">
            <button type="button" class="kv-btn danger return-delete-btn" id="returnTrashOpenBtn"><i class="fa-solid fa-trash-can"></i> Xóa</button>
            <a class="kv-btn primary" href="/tra-hang-nhap/create">+ Trả hàng nhập</a>
            <a class="kv-btn" href="/tra-hang-nhap/export.xlsx<%= exportQuery ? '?' + exportQuery : '' %>">Xuất file ▾</a>
          </div>
        </div>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th class="check-col"><input type="checkbox" id="returnCheckAll"></th>
                <th class="star-col">☆</th>
                <th class="code-col">Mã trả hàng nhập</th>
                <th class="time-col">Thời gian</th>
                <th class="vendor-col">Nhà cung cấp</th>
                <th class="num money-col">Tổng tiền hàng</th>
                <th class="num money-col">Giảm giá</th>
                <th class="num money-col">NCC cần trả</th>
                <th class="num money-col">NCC đã trả</th>
                <th class="status-col">Trạng thái</th>
              </tr>
            </thead>
            <tbody>
              <% if (safeReturns.length) { %>
                <% safeReturns.forEach(function(r) { %>
                  <tr class="return-row" data-detail-id="<%= r._id %>">
                    <td class="check-col"><input type="checkbox" class="return-select-check" value="<%= r._id %>"></td>
                    <td class="star-col">☆</td>
                    <td class="ellipsis"><%= r.ma_phieu_tra_nhap || '' %></td>
                    <td class="ellipsis"><%= formatDate(r.ngay_tra || r.created_at) %></td>
                    <td class="ellipsis"><%= r.nha_cung_cap_id ? (r.nha_cung_cap_id.ten_ncc || '--') : '--' %></td>
                    <td class="num"><%= fmtMoney(r.tong_tien_hang || r.tong_tien_tra || 0) %></td>
                    <td class="num"><%= r.kieu_giam_gia === 'percent' ? ((r.giam_gia || 0) + '%') : fmtMoney(r.giam_gia || 0) %></td>
                    <td class="num"><%= fmtMoney(supplierRemainDue(r)) %></td>
                    <td class="num"><%= fmtMoney(r.ncc_da_tra || 0) %></td>
                    <td><span class="status-badge <%= badgeClass(r.trang_thai) %>"><%= statusLabel(r.trang_thai) %></span></td>
                  </tr>
                  <tr class="detail-row" id="detail-<%= r._id %>" style="display:none">
                    <td colspan="10">
                      <div class="detail-card">
                        <div class="detail-tabs"><span class="detail-tab">Thông tin</span></div>
                        <div class="detail-head">
                          <div>
                            <div class="detail-code"><%= r.ma_phieu_tra_nhap || '--' %> <span class="detail-status"><%= statusLabel(r.trang_thai) %></span></div>
                            <% if (r.phieu_nhap_id) { %>
                              <div class="detail-branch">Phiếu nhập gốc: <%= r.phieu_nhap_id.ma_phieu_nhap || '--' %></div>
                            <% } %>
                          </div>
                          <div class="detail-branch"><%= r.kho_id ? (r.kho_id.ten_kho || r.kho_id.ma_kho || 'Cửa hàng trung tâm') : 'Cửa hàng trung tâm' %></div>
                        </div>
                        <div class="return-detail-split">
                          <div class="return-detail-main">
                            <div class="detail-info">
                              <div>
                                <div class="info-line"><span>Người tạo:</span><b><%= r.nguoi_tao_id ? (r.nguoi_tao_id.ho_ten || r.nguoi_tao_id.email || '--') : '--' %></b></div>
                                <div class="info-line"><span>Tên NCC:</span><span class="info-value"><%= r.nha_cung_cap_id ? ((r.nha_cung_cap_id.ma_ncc || '') + (r.nha_cung_cap_id.ma_ncc ? ' - ' : '') + (r.nha_cung_cap_id.ten_ncc || '')) : '—' %></span></div>
                              </div>
                              <div>
                                <div class="info-line"><span>Người trả:</span><select disabled><option><%= r.nguoi_tra_id ? (r.nguoi_tra_id.ho_ten || r.nguoi_tra_id.email || '--') : '--' %></option></select></div>
                              </div>
                              <div>
                                <div class="info-line"><span>Ngày trả:</span><input readonly value="<%= formatDate(r.ngay_tra || r.created_at) %>"></div>
                              </div>
                            </div>
                            <div class="return-detail-groups-wrap">
                              <% if (!(r.detail_rows || []).length) { %>
                                <table class="mini-table"><tbody><tr><td>Chưa có chi tiết hàng trả.</td></tr></tbody></table>
                              <% } %>
                              <% if (r.trang_thai === 'completed' && (r.vat_chua_lines || []).length) { %>
                                <div class="return-vat-chua-box">
                                  <div class="return-vat-chua-title"><i class="fa-solid fa-box"></i> Vật chứa đã xuất</div>
                                  <table class="return-vat-chua-table">
                                    <thead>
                                      <tr>
                                        <th>Mã chứng từ</th>
                                        <th>Loại</th>
                                        <th>Mã vật chứa</th>
                                        <th>Tên vật chứa</th>
                                        <th class="num">Số lượng</th>
                                        <th>Chứng từ liên kết</th>
                                        <th class="col-time">Thời gian</th>
                                      </tr>
                                    </thead>
                                    <tbody>
                                      <% (r.vat_chua_lines || []).forEach(function(line) { %>
                                        <tr>
                                          <td><%= line.ma_chung_tu || '--' %></td>
                                          <td><%= line.doc_kind_label || line.loai_label || '--' %></td>
                                          <td><%= line.ma_vat_chua || '--' %></td>
                                          <td><%= line.ten_vat_chua || '--' %></td>
                                          <td class="num"><%= fmt(line.so_luong || 0) %></td>
                                          <td>
                                            <% if (line.source_href && line.source_code) { %>
                                              <a class="ref-link" href="<%= line.source_href %>"><%= line.source_code %></a>
                                            <% } else { %>
                                              <%= line.source_code || '--' %>
                                            <% } %>
                                          </td>
                                          <td class="col-time"><%= formatDate(line.created_at) %></td>
                                        </tr>
                                      <% }) %>
                                    </tbody>
                                  </table>
                                </div>
                              <% } %>
                              <% detailGroupsReturn(r.detail_rows || []).forEach(function(group) { %>
                                <div class="lot-group-title">
                                  <%- group.product ? (refLink('product', group.product, group.product.ma_hang || '--') + ' - ' + (group.product.ten_hang || '--')) : '--' %>
                                </div>
                                <table class="grouped-lot-table">
                                  <colgroup>
                                    <col style="width:30%">
                                    <col style="width:11%">
                                    <col style="width:9%">
                                    <col style="width:12%">
                                    <col style="width:12%">
                                    <col style="width:13%">
                                    <col style="width:13%">
                                  </colgroup>
                                  <thead>
                                    <tr>
                                      <th>Ngày / Lô</th>
                                      <th>Thuộc tính</th>
                                      <th class="num">Số lượng</th>
                                      <th class="num">Giá nhập</th>
                                      <th class="num">Giá trả lại</th>
                                      <th class="num">Thành tiền</th>
                                      <th class="num">Tổng theo lô</th>
                                    </tr>
                                  </thead>
                                  <tbody>
                                    <% var displayRows = detailRowsForReturnGroup(group); %>
                                    <% displayRows.forEach(function(rowLine, rowIndex) { %>
                                      <tr>
                                        <% if (rowIndex === 0) { %>
                                          <td class="lot-cell" rowspan="<%= displayRows.length %>"><%- group.lot_label %></td>
                                        <% } %>
                                        <td class="attr-cell"><div><%= rowLine.ten_thuoc_tinh || '--' %></div></td>
                                        <td class="num"><%= fmt(rowLine.so_luong || 0) %></td>
                                        <td class="num"><%= fmtMoney(rowLine.don_gia_nhap || 0) %></td>
                                        <td class="num"><%= fmtMoney(rowLine.don_gia_tra || 0) %></td>
                                        <td class="num"><%= fmtMoney(rowLine.thanh_tien || 0) %></td>
                                        <% if (rowIndex === 0) { %>
                                          <td class="lot-total-cell" rowspan="<%= displayRows.length %>"><%= fmtMoney(group.total || 0) %></td>
                                        <% } %>
                                      </tr>
                                    <% }) %>
                                    <tr class="group-total-row">
                                      <td colspan="5" class="num">TỔNG CỘNG</td>
                                      <td class="num"><%= fmtMoney(group.total || 0) %></td>
                                      <td class="num"><%= fmtMoney(group.total || 0) %></td>
                                    </tr>
                                  </tbody>
                                </table>
                              <% }) %>
                            </div>
                            <div class="detail-note"><%= r.ghi_chu ? String(r.ghi_chu) : '—' %></div>
                          </div>
                          <aside class="return-summary-box" aria-label="Tổng kết">
                            <h3 class="return-summary-title">Tổng kết</h3>
                            <div class="return-summary-row">
                              <span>Số lượng mặt hàng</span>
                              <span class="summary-val"><%= fmt(r.detail_summary ? r.detail_summary.tong_mat_hang : 0) %></span>
                            </div>
                            <div class="return-summary-row">
                              <span>Tổng tiền hàng trả</span>
                              <span class="summary-val"><%= fmtMoney(r.tong_tien_hang || r.tong_tien_tra || 0) %></span>
                            </div>
                            <div class="return-summary-row">
                              <span>Giảm giá</span>
                              <span class="summary-val"><%= r.kieu_giam_gia === 'percent' ? ((r.giam_gia || 0) + '%') : fmtMoney(r.giam_gia || 0) %></span>
                            </div>
                            <div class="return-summary-row">
                              <span>NCC cần trả</span>
                              <span class="summary-val"><%= fmtMoney(r.ncc_can_tra != null ? r.ncc_can_tra : (r.tong_tien_tra || 0)) %></span>
                            </div>
                            <div class="return-summary-row">
                              <span>NCC đã trả</span>
                              <span class="summary-val"><%= fmtMoney(r.ncc_da_tra || 0) %></span>
                            </div>
                            <% var nccRemain = supplierRemainDue(r); %>
                            <% if (r.trang_thai === 'completed' && nccRemain > 0) { %>
                              <div class="receipt-pay-action">
                                <button type="button" class="btn btn-primary js-return-receipt-pay" data-id="<%= r._id %>" data-due="<%= nccRemain %>">Tạo phiếu thu</button>
                              </div>
                            <% } %>
                          </aside>
                        </div>
                        <div class="page-actions page-actions--bordered">
                          <button type="button" class="btn btn-light btn-cancel-outline js-return-cancel" data-id="<%= r._id %>" data-status="<%= r.trang_thai || '' %>" <%= r.trang_thai === 'cancelled' ? 'disabled' : '' %>>Hủy</button>
                          <a class="btn btn-light btn-copy-outline" href="/tra-hang-nhap/create?copy_from=<%= r._id %>">Sao chép</a>
                          <a class="btn btn-primary" href="/tra-hang-nhap/<%= r._id %>/export.xlsx">Xuất file</a>
                          <a class="btn btn-light" href="/tra-hang-nhap/<%= r._id %>/in" target="_blank" rel="noopener">In phiếu</a>
                          <a class="page-actions__link return-open-link" href="/chung-tu-kho/tra-hang-nhap/<%= r._id %>" target="_blank" rel="noopener">Chứng từ kho ↗</a>
                        </div>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="10" class="empty">
                    <div class="empty-box">
                      <div class="empty-icon">▤</div>
                      <div class="empty-title">Không tìm thấy kết quả</div>
                      <div>Không tìm thấy giao dịch nào phù hợp trong tháng này.</div>
                    </div>
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
        <div class="footer">
          <span class="return-page-size">Hiển thị 10 dòng/trang</span>
          <nav class="return-pagination" aria-label="Phân trang trả hàng nhập">
            <% if (safePagination.page > 1) { %>
              <a class="return-page-link" href="<%= pageHref(1) %>">Đầu</a>
              <a class="return-page-link" href="<%= pageHref(safePagination.page - 1) %>">Trước</a>
            <% } else { %>
              <span class="return-page-link is-disabled">Đầu</span>
              <span class="return-page-link is-disabled">Trước</span>
            <% } %>
            <span class="return-page-current"><%= safePagination.page %> / <%= safePagination.totalPages %></span>
            <% if (safePagination.page < safePagination.totalPages) { %>
              <a class="return-page-link" href="<%= pageHref(safePagination.page + 1) %>">Sau</a>
              <a class="return-page-link" href="<%= pageHref(safePagination.totalPages) %>">Cuối</a>
            <% } else { %>
              <span class="return-page-link is-disabled">Sau</span>
              <span class="return-page-link is-disabled">Cuối</span>
            <% } %>
          </nav>
          <span><%= safePagination.from %> - <%= safePagination.to %> trong <%= safePagination.total %> phiếu</span>
        </div>
      </main>
    </div>
  </form>
  <div id="returnReceiptPayModal" class="receipt-pay-modal" role="dialog" aria-labelledby="returnReceiptPayTitle">
    <div class="receipt-pay-card">
      <div class="receipt-pay-head">
        <h3 id="returnReceiptPayTitle">Tạo phiếu thu</h3>
        <button type="button" class="receipt-pay-close" onclick="closeReturnReceiptPayModal()">&times;</button>
      </div>
      <div class="quick-pay-grid">
        <label class="full"><span>NCC còn phải trả</span><div class="pay-total-readonly" id="returnReceiptPayDue"></div></label>
        <label><span>Tiền mặt</span><input id="returnReceiptPayCash" class="vn-pay-amount" inputmode="numeric" value="" placeholder="0"></label>
        <label><span>Chuyển khoản</span><input id="returnReceiptPayTransfer" class="vn-pay-amount" inputmode="numeric" value="" placeholder="0"></label>
        <label class="full"><span>Thực thu</span><div class="pay-total-readonly" id="returnReceiptPayTotal">0 VNĐ</div></label>
        <label class="full"><span>Còn phải trả sau thu</span><div class="pay-total-summary" id="returnReceiptPayRemain">0 VNĐ</div></label>
        <label class="full" id="returnReceiptPayErrorWrap" style="display:none"><span>Lưu ý</span><div class="pay-summary-error" id="returnReceiptPayErrors"></div></label>
        <label class="full"><span>Sổ quỹ</span><select id="returnReceiptPayCashBook" required>
          <option value="">— Chọn sổ quỹ —</option>
          <% safeCashBooks.forEach(function(book) { %>
            <option value="<%= book._id %>"><%= book.ten_so_quy || 'Sổ quỹ' %></option>
          <% }) %>
        </select></label>
      </div>
      <div class="receipt-pay-foot">
        <button type="button" class="kv-btn primary" onclick="submitReturnReceiptPayModal()">Tạo phiếu thu</button>
        <button type="button" class="kv-btn" onclick="closeReturnReceiptPayModal()">Đóng</button>
      </div>
    </div>
  </div>
  <div id="returnTrashModal" class="return-trash-modal" role="dialog" aria-hidden="true" aria-labelledby="returnTrashTitle">
    <div class="return-trash-card">
      <div class="return-trash-head">
        <h3 id="returnTrashTitle">Xóa phiếu trả hàng nhập</h3>
        <button type="button" class="return-trash-close" id="returnTrashCloseBtn">&times;</button>
      </div>
      <div class="return-trash-body">
        <div id="returnTrashAlerts"></div>
        <p class="return-trash-question">Bạn có chắc chắn muốn xóa các phiếu trả hàng nhập đã chọn không?</p>
        <ul class="return-trash-list" id="returnTrashSelectedList" style="display:none"></ul>
        <table class="return-trash-impact" style="display:none">
          <thead>
            <tr>
              <th>Dữ liệu</th>
              <th class="num">Số lượng</th>
              <th>Mã tham chiếu</th>
            </tr>
          </thead>
          <tbody id="returnTrashImpactBody">
            <tr><td colspan="3">Chưa có dữ liệu.</td></tr>
          </tbody>
        </table>
      </div>
      <div class="return-trash-foot">
        <button type="button" class="kv-btn" id="returnTrashCancelBtn">Không</button>
        <button type="button" class="kv-btn danger" id="returnTrashConfirmBtn">Xóa</button>
      </div>
    </div>
  </div>
  <script>
    function submitReturnFilters() {
      var pageInput = document.getElementById('returnPageInput');
      var form = document.getElementById('returnFilterForm');
      if (pageInput) pageInput.value = '1';
      if (!form) return;
      if (typeof form.requestSubmit === 'function') {
        form.requestSubmit();
      } else {
        form.submit();
      }
    }
    document.addEventListener('DOMContentLoaded', function() {
      var returnFilterForm = document.getElementById('returnFilterForm');
      if (returnFilterForm) {
        returnFilterForm.addEventListener('submit', function() {
          var pageInput = document.getElementById('returnPageInput');
          if (pageInput) pageInput.value = '1';
        });
      }
      var pendingReturnReceiptId = '';
      var pendingReturnReceiptDue = 0;
      var returnTrashPendingIds = [];
      var returnTrashPreview = null;
      var returnTrashOpenBtn = document.getElementById('returnTrashOpenBtn');
      var returnTrashModal = document.getElementById('returnTrashModal');
      var returnTrashCloseBtn = document.getElementById('returnTrashCloseBtn');
      var returnTrashCancelBtn = document.getElementById('returnTrashCancelBtn');
      var returnTrashConfirmBtn = document.getElementById('returnTrashConfirmBtn');
      var returnTrashAlerts = document.getElementById('returnTrashAlerts');
      var returnTrashSelectedList = document.getElementById('returnTrashSelectedList');
      var returnTrashImpactBody = document.getElementById('returnTrashImpactBody');
      function escapeHtml(value) {
        return String(value == null ? '' : value)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#39;');
      }
      function getSelectedReturnIds() {
        return Array.prototype.slice.call(document.querySelectorAll('.return-select-check:checked')).map(function(cb) {
          return cb.value;
        }).filter(Boolean);
      }
      function updateReturnTrashButtonState() {
        var ids = getSelectedReturnIds();
        if (returnTrashOpenBtn) returnTrashOpenBtn.disabled = false;
        var all = document.querySelectorAll('.return-select-check');
        var checked = document.querySelectorAll('.return-select-check:checked');
        var header = document.getElementById('returnCheckAll');
        if (header) {
          header.checked = all.length > 0 && checked.length === all.length;
          header.indeterminate = checked.length > 0 && checked.length < all.length;
        }
      }
      function closeReturnTrashModal() {
        if (!returnTrashModal) return;
        returnTrashModal.classList.remove('is-open');
        returnTrashModal.setAttribute('aria-hidden', 'true');
        returnTrashPendingIds = [];
        returnTrashPreview = null;
        if (returnTrashConfirmBtn) returnTrashConfirmBtn.disabled = false;
      }
      function renderReturnTrashAlerts(preview) {
        if (!returnTrashAlerts) return;
        var html = '';
        (preview.items || []).forEach(function(item) {
          if (!item.can_trash && item.block_reason) {
            html += '<div class="return-trash-alert is-error">' + escapeHtml(item.ma_phieu_tra_nhap || item.phieu_tra_hang_nhap_id) + ': ' + escapeHtml(item.block_reason) + '</div>';
          }
          (item.warnings || []).forEach(function(warn) {
            html += '<div class="return-trash-alert is-warn">' + escapeHtml(item.ma_phieu_tra_nhap || '') + (item.ma_phieu_tra_nhap ? ' - ' : '') + escapeHtml(warn) + '</div>';
          });
        });
        returnTrashAlerts.innerHTML = html;
      }
      function renderReturnTrashSelected(preview) {
        if (!returnTrashSelectedList) return;
        returnTrashSelectedList.innerHTML = (preview.items || []).map(function(item) {
          var label = [item.ma_phieu_tra_nhap, item.ten_ncc].filter(Boolean).join(' - ');
          return '<li>' + escapeHtml(label || item.phieu_tra_hang_nhap_id) + '</li>';
        }).join('');
      }
      function renderReturnTrashImpact(preview) {
        if (!returnTrashImpactBody) return;
        var groups = preview.aggregate_groups || [];
        if (!groups.length) {
          returnTrashImpactBody.innerHTML = '<tr><td colspan="3">Không có dữ liệu liên quan đáng kể.</td></tr>';
          return;
        }
        returnTrashImpactBody.innerHTML = groups.map(function(group) {
          return '<tr>'
            + '<td>' + escapeHtml(group.label || group.entity_type) + '</td>'
            + '<td class="num">' + escapeHtml(String(group.count || 0)) + '</td>'
            + '<td>' + escapeHtml((group.samples || []).join(', ') || '-') + '</td>'
            + '</tr>';
        }).join('');
      }
      function openReturnTrashModal() {
        var ids = getSelectedReturnIds();
        if (!ids.length) return alert('Vui lòng chọn ít nhất một phiếu trả hàng nhập.');
        returnTrashPendingIds = ids.slice();
        if (returnTrashModal) {
          returnTrashModal.classList.add('is-open');
          returnTrashModal.setAttribute('aria-hidden', 'false');
        }
        if (returnTrashImpactBody) returnTrashImpactBody.innerHTML = '<tr><td colspan="3">Đang kiểm tra dữ liệu liên quan...</td></tr>';
        if (returnTrashAlerts) returnTrashAlerts.innerHTML = '';
        if (returnTrashSelectedList) returnTrashSelectedList.innerHTML = '';
        if (returnTrashImpactBody) returnTrashImpactBody.innerHTML = '';
        if (returnTrashConfirmBtn) returnTrashConfirmBtn.disabled = false;
        returnTrashPreview = { can_proceed: true };
      }
      function confirmReturnTrash() {
        if (!returnTrashPendingIds.length) return;
        if (returnTrashConfirmBtn) returnTrashConfirmBtn.disabled = true;
        fetch('/tra-hang-nhap/deactivate', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify({ phieu_tra_hang_nhap_ids: returnTrashPendingIds })
        })
          .then(function(res) { return res.json().then(function(data) { return { ok: res.ok, data: data }; }); })
          .then(function(result) {
            if (!result.ok || !result.data.success) throw new Error((result.data && result.data.message) || 'Không xóa được phiếu trả hàng nhập');
            alert(result.data.message || 'Đã xóa phiếu trả hàng nhập');
            window.location.reload();
          })
          .catch(function(err) {
            alert(err.message || 'Không xóa được phiếu trả hàng nhập');
            if (returnTrashConfirmBtn) returnTrashConfirmBtn.disabled = false;
          });
      }
      document.querySelectorAll('.return-select-check').forEach(function(cb) {
        cb.addEventListener('change', updateReturnTrashButtonState);
      });
      var returnCheckAll = document.getElementById('returnCheckAll');
      if (returnCheckAll) {
        returnCheckAll.addEventListener('change', function() {
          document.querySelectorAll('.return-select-check').forEach(function(cb) {
            cb.checked = returnCheckAll.checked;
          });
          updateReturnTrashButtonState();
        });
      }
      if (returnTrashOpenBtn) returnTrashOpenBtn.addEventListener('click', openReturnTrashModal);
      if (returnTrashCloseBtn) returnTrashCloseBtn.addEventListener('click', closeReturnTrashModal);
      if (returnTrashCancelBtn) returnTrashCancelBtn.addEventListener('click', closeReturnTrashModal);
      if (returnTrashConfirmBtn) returnTrashConfirmBtn.addEventListener('click', confirmReturnTrash);
      if (returnTrashModal) {
        returnTrashModal.addEventListener('click', function(e) {
          if (e.target === returnTrashModal) closeReturnTrashModal();
        });
      }
      updateReturnTrashButtonState();
      var legacyReceiptCashBook = document.getElementById('returnReceiptPayCashBook');
      if (legacyReceiptCashBook) {
        legacyReceiptCashBook.insertAdjacentHTML('beforeend', '<option value="v2">v2</option>');
        if (legacyReceiptCashBook.closest('label')) legacyReceiptCashBook.closest('label').style.display = 'none';
      }
      function insertReturnReceiptV2Books() {
        var transferEl = document.getElementById('returnReceiptPayTransfer');
        var grid = transferEl && transferEl.closest('.quick-pay-grid');
        if (!grid || document.getElementById('returnReceiptPayCashBookV2')) return;
        var cashLabel = document.createElement('label');
        cashLabel.innerHTML = '<span>So tien mat</span><select id="returnReceiptPayCashBookV2"><option value="">-- Chon so tien mat --</option></select>';
        var bankLabel = document.createElement('label');
        bankLabel.innerHTML = '<span>Tai khoan ngan hang</span><select id="returnReceiptPayBankBookV2"><option value="">-- Chon tai khoan ngan hang --</option></select>';
        var transferLabel = transferEl.closest('label');
        transferLabel.insertAdjacentElement('afterend', bankLabel);
        transferLabel.insertAdjacentElement('afterend', cashLabel);
      }
      function autoSelectReturnBook(select, rows) {
        if (!select) return;
        rows = Array.isArray(rows) ? rows : [];
        select.innerHTML = '<option value="">-- Chon so --</option>' + rows.map(function(row) {
          var bank = row.thong_tin_ngan_hang || {};
          var label = [row.ten_so_quy || 'So quy', bank.so_tai_khoan || ''].filter(Boolean).join(' - ');
          return '<option value="' + row._id + '">' + label + '</option>';
        }).join('');
        var defaults = rows.filter(function(row) { return row.mac_dinh; });
        if (defaults.length) select.value = defaults[0]._id;
        else if (rows.length === 1) select.value = rows[0]._id;
      }
      function loadReturnReceiptBooks() {
        insertReturnReceiptV2Books();
        return Promise.all([
          fetch('/api/so-quy/active?loai_so_quy=tien_mat').then(function(res) { return res.json(); }),
          fetch('/api/so-quy/active?loai_so_quy=chuyen_khoan').then(function(res) { return res.json(); })
        ]).then(function(rows) {
          autoSelectReturnBook(document.getElementById('returnReceiptPayCashBookV2'), rows[0].items || []);
          autoSelectReturnBook(document.getElementById('returnReceiptPayBankBookV2'), rows[1].items || []);
        }).catch(function() {});
      }
      function numberValue(value) {
        return Number(String(value || '').replace(/[^\d]/g, '')) || 0;
      }
      function moneyText(value) {
        return (Number(value || 0)).toLocaleString('vi-VN') + ' VNĐ';
      }
      function moneyInput(value) {
        return Number(value || 0) ? Number(value || 0).toLocaleString('vi-VN') : '';
      }
      function balanceReturnReceiptPayment(activeInput) {
        var cashEl = document.getElementById('returnReceiptPayCash');
        var transferEl = document.getElementById('returnReceiptPayTransfer');
        if (!cashEl || !transferEl) return;
        var cash = Math.max(0, numberValue(cashEl.value));
        var transfer = Math.max(0, numberValue(transferEl.value));
        var due = Math.max(0, Number(pendingReturnReceiptDue || 0));
        if (activeInput === transferEl) {
          transfer = Math.min(transfer, due);
          if (cash + transfer > due) cash = Math.max(0, due - transfer);
        } else if (activeInput === cashEl) {
          cash = Math.min(cash, due);
          if (cash + transfer > due) transfer = Math.max(0, due - cash);
        } else if (cash + transfer > due) {
          cash = due;
          transfer = 0;
        }
        cashEl.value = moneyInput(cash);
        transferEl.value = moneyInput(transfer);
      }
      function bindReceiptPayInput(input) {
        if (!input || input.dataset.vnBound === '1') return;
        input.dataset.vnBound = '1';
        input.addEventListener('input', function() {
          var raw = numberValue(input.value);
          input.value = moneyInput(raw);
          balanceReturnReceiptPayment(input);
          refreshReturnReceiptPaySummary();
        });
      }
      function readReturnReceiptPayment() {
        var tienMat = Math.max(0, numberValue(document.getElementById('returnReceiptPayCash') && document.getElementById('returnReceiptPayCash').value));
        var chuyenKhoan = Math.max(0, numberValue(document.getElementById('returnReceiptPayTransfer') && document.getElementById('returnReceiptPayTransfer').value));
        return { tien_mat: tienMat, chuyen_khoan: chuyenKhoan, amount: tienMat + chuyenKhoan };
      }
      function refreshReturnReceiptPaySummary() {
        var payment = readReturnReceiptPayment();
        var errors = [];
        if (payment.amount <= 0) errors.push('Vui lòng nhập số tiền nhà cung cấp trả');
        if (payment.amount > pendingReturnReceiptDue) errors.push('Thực thu không được vượt số NCC còn phải trả');
        var totalEl = document.getElementById('returnReceiptPayTotal');
        var remainEl = document.getElementById('returnReceiptPayRemain');
        var errWrap = document.getElementById('returnReceiptPayErrorWrap');
        var errEl = document.getElementById('returnReceiptPayErrors');
        if (totalEl) totalEl.textContent = moneyText(payment.amount);
        if (remainEl) remainEl.textContent = moneyText(Math.max(pendingReturnReceiptDue - payment.amount, 0));
        if (errWrap && errEl) {
          errWrap.style.display = errors.length ? '' : 'none';
          errEl.textContent = errors.join('. ');
        }
      }
      window.openReturnReceiptPayModal = function(returnId, dueAmount) {
        pendingReturnReceiptId = returnId;
        pendingReturnReceiptDue = Math.max(0, Number(dueAmount || 0));
        var dueEl = document.getElementById('returnReceiptPayDue');
        var cashEl = document.getElementById('returnReceiptPayCash');
        var transferEl = document.getElementById('returnReceiptPayTransfer');
        var cashBookEl = document.getElementById('returnReceiptPayCashBook');
        if (dueEl) dueEl.textContent = moneyText(pendingReturnReceiptDue);
        if (cashEl) { cashEl.value = moneyInput(pendingReturnReceiptDue); delete cashEl.dataset.vnBound; }
        if (transferEl) { transferEl.value = ''; delete transferEl.dataset.vnBound; }
        if (cashBookEl) cashBookEl.value = '';
        loadReturnReceiptBooks();
        bindReceiptPayInput(cashEl);
        bindReceiptPayInput(transferEl);
        balanceReturnReceiptPayment();
        refreshReturnReceiptPaySummary();
        document.getElementById('returnReceiptPayModal').classList.add('open');
      };
      window.closeReturnReceiptPayModal = function() {
        pendingReturnReceiptId = '';
        pendingReturnReceiptDue = 0;
        document.getElementById('returnReceiptPayModal').classList.remove('open');
      };
      window.submitReturnReceiptPayModal = function() {
        var payment = readReturnReceiptPayment();
        var cashBookId = document.getElementById('returnReceiptPayCashBookV2') && document.getElementById('returnReceiptPayCashBookV2').value || '';
        var bankBookId = document.getElementById('returnReceiptPayBankBookV2') && document.getElementById('returnReceiptPayBankBookV2').value || '';
        if (!pendingReturnReceiptId) return alert('Không xác định được phiếu trả hàng nhập.');
        if (payment.amount <= 0) return alert('Vui lòng nhập số tiền nhà cung cấp trả.');
        if (payment.amount > pendingReturnReceiptDue) return alert('Thực thu không được vượt số NCC còn phải trả.');
        if (payment.tien_mat > 0 && !cashBookId) return alert('Vui long chon so tien mat.');
        if (payment.chuyen_khoan > 0 && !bankBookId) return alert('Vui long chon tai khoan ngan hang.');
        if (document.getElementById('returnReceiptPayCashBook')) document.getElementById('returnReceiptPayCashBook').value = payment.amount > 0 ? 'v2' : '';
        cashBookId = cashBookId || (payment.amount > 0 ? 'v2' : '');
        if (!cashBookId) return alert('Vui lòng chọn sổ quỹ.');
        fetch('/tra-hang-nhap/' + pendingReturnReceiptId + '/phieu-thu', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify({
            payment_v2: '1',
            chi_tiet_thanh_toan: {
              tien_mat: payment.tien_mat,
              so_quy_tien_mat_id: cashBookId === 'v2' ? '' : cashBookId,
              chuyen_khoan: payment.chuyen_khoan,
              so_quy_chuyen_khoan_id: bankBookId,
              tien_tra_khach: 0
            }
          })
        })
          .then(function(res) {
            return res.json().then(function(data) { return { ok: res.ok, data: data }; });
          })
          .then(function(result) {
            if (!result.ok || !result.data.success) return alert((result.data && result.data.message) || 'Không tạo được phiếu thu');
            location.reload();
          })
          .catch(function() { alert('Không kết nối được máy chủ'); });
      };
      function expandReturnDetail(id, scroll) {
        var row = document.querySelector('.return-row[data-detail-id="' + id + '"]');
        var detail = document.getElementById('detail-' + id);
        if (!row || !detail) return;
        document.querySelectorAll('.detail-row').forEach(function(x) { x.style.display = 'none'; });
        document.querySelectorAll('.return-row').forEach(function(x) { x.classList.remove('is-open'); });
        detail.style.display = 'table-row';
        row.classList.add('is-open');
        if (scroll) row.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
      }

      document.querySelectorAll('.return-row').forEach(function(row) {
        row.addEventListener('click', function(e) {
          if (e.target && e.target.closest('input,button,a,select')) return;
          var id = row.getAttribute('data-detail-id');
          var detail = document.getElementById('detail-' + id);
          if (!detail) return;
          var isOpen = detail.style.display !== 'none';
          document.querySelectorAll('.detail-row').forEach(function(x) { x.style.display = 'none'; });
          document.querySelectorAll('.return-row').forEach(function(x) { x.classList.remove('is-open'); });
          if (!isOpen) {
            detail.style.display = 'table-row';
            row.classList.add('is-open');
          }
        });
      });

      var params = new URLSearchParams(window.location.search);
      var openReturn = params.get('openReturn');
      if (openReturn) {
        expandReturnDetail(openReturn, true);
        params.delete('openReturn');
        var qs = params.toString();
        var path = window.location.pathname + (qs ? '?' + qs : '') + window.location.hash;
        try { window.history.replaceState({}, '', path); } catch (err) {}
      }

      document.body.addEventListener('click', function(e) {
        var receiptBtn = e.target.closest('.js-return-receipt-pay');
        if (receiptBtn) {
          openReturnReceiptPayModal(receiptBtn.getAttribute('data-id'), receiptBtn.getAttribute('data-due'));
          return;
        }
        var cancelBtn = e.target.closest('.js-return-cancel');
        if (cancelBtn) {
          if (cancelBtn.disabled) return;
          var st = cancelBtn.getAttribute('data-status') || '';
          if (st === 'cancelled') return;
          if (!confirm('Bạn có chắc muốn hủy phiếu trả hàng nhập này không?')) return;
          var cid = cancelBtn.getAttribute('data-id');
          cancelBtn.disabled = true;
          fetch('/tra-hang-nhap/' + cid + '/cancel', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            credentials: 'same-origin',
            body: '{}'
          })
            .then(function(res) {
              return res.json().then(function(data) {
                return { ok: res.ok, data: data };
              });
            })
            .then(function(result) {
              if (!result.ok || !result.data.success) {
                alert((result.data && result.data.message) || 'Không hủy được phiếu');
                cancelBtn.disabled = (cancelBtn.getAttribute('data-status') === 'cancelled');
                return;
              }
              location.reload();
            })
            .catch(function() {
              alert('Không kết nối được máy chủ');
              cancelBtn.disabled = false;
            });
          return;
        }
      });
    });
  </script>
</body>
</html>
