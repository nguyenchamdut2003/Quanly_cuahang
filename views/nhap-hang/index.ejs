    .purchase-merge-close{border:0;background:transparent;color:#4b5563;font-size:28px;line-height:1;cursor:pointer}
    .purchase-merge-body{padding:18px 30px 28px;overflow:auto}
    .purchase-merge-desc{font-size:14px;line-height:1.45;color:#2f343b;margin:0 0 14px}
    .purchase-merge-desc strong{color:#0070f4}
    .purchase-merge-filter{display:flex;align-items:center;gap:10px;margin:0 0 14px}
    .purchase-merge-filter label{font-size:13px;font-weight:700;color:#111827}
    .purchase-merge-filter select{height:31px;min-width:260px;border:1px solid #cfd8e3;border-radius:6px;background:#fff;color:#111827;padding:0 9px;font-size:13px;outline:none}
    .purchase-merge-table{width:100%;border-collapse:collapse;table-layout:fixed}
    .purchase-merge-table th{height:37px;background:#f0f1f3;border-bottom:1px solid #cfd4dc;text-align:left;padding:0 10px;color:#202124;font-size:13px;font-weight:800}
    .purchase-merge-table td{height:38px;border-bottom:1px solid #e5e9ee;padding:0 10px;font-size:13px;color:#111827;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .purchase-merge-table .num{text-align:right}
    .purchase-merge-check{width:38px;text-align:center}
    .purchase-merge-empty{min-height:220px;display:flex;align-items:center;justify-content:center;flex-direction:column;text-align:center;color:#202124;padding:16px}
    .purchase-merge-empty .empty-icon{width:112px;height:112px;font-size:40px;margin:0 0 20px;background:#f1f7ff;box-shadow:inset 0 0 0 16px #dcecff;border-radius:50%;display:flex;align-items:center;justify-content:center;color:#0070f4}
    .purchase-merge-empty strong{font-size:15px;line-height:1.45}
    .purchase-merge-empty span{display:block;margin-top:8px;color:#667085;font-size:13px;line-height:1.4}
    .purchase-merge-foot{display:none;align-items:center;justify-content:flex-end;gap:8px;padding:14px 30px 24px;border-top:1px solid #e5e9ee}
    @media(max-width:760px){.purchase-merge-overlay{padding:8px}.purchase-merge-head{padding:18px 18px 12px}.purchase-merge-body{padding:14px 18px 22px}.purchase-merge-table{min-width:840px}}
    .purchase-trash-overlay{display:none;position:fixed;inset:0;background:rgba(15,23,42,.45);z-index:1450;align-items:center;justify-content:center;padding:16px}
    .purchase-trash-overlay.is-open{display:flex}
    .purchase-trash-modal{width:min(760px,calc(100vw - 24px));max-height:calc(100vh - 32px);background:#fff;border-radius:12px;box-shadow:0 20px 60px rgba(15,23,42,.28);display:flex;flex-direction:column;overflow:hidden}
    .purchase-trash-head{display:flex;align-items:center;justify-content:space-between;padding:18px 22px 12px;border-bottom:1px solid #e5e9ee}
    .purchase-trash-head h3{margin:0;font-size:18px;font-weight:800;color:#111827}
    .purchase-trash-close{border:0;background:transparent;color:#667085;font-size:26px;line-height:1;cursor:pointer}
    .purchase-trash-body{padding:14px 22px 18px;overflow:auto}
    .purchase-trash-desc{margin:0 0 12px;font-size:13px;line-height:1.5;color:#475467}
    .purchase-trash-alert{border-radius:8px;padding:10px 12px;font-size:13px;line-height:1.45;margin-bottom:12px}
    .purchase-trash-alert.is-error{border:1px solid #fecdca;background:#fffbfa;color:#b42318}
    .purchase-trash-alert.is-warn{border:1px solid #fedf89;background:#fffaeb;color:#93370d}
    .purchase-trash-selected{margin:0 0 12px;padding:0;list-style:none}
    .purchase-trash-selected li{font-size:13px;color:#111827;padding:4px 0;border-bottom:1px dashed #eef2f6}
    .purchase-trash-table{width:100%;border-collapse:collapse;font-size:13px}
    .purchase-trash-table th{background:#f8fafc;border-bottom:1px solid #e4eaf2;padding:8px 10px;text-align:left;font-size:12px;color:#475467}
    .purchase-trash-table td{border-bottom:1px solid #eef2f6;padding:8px 10px;color:#111827}
    .purchase-trash-table .num{text-align:right;font-weight:700}
    .purchase-trash-foot{display:flex;align-items:center;justify-content:flex-end;gap:8px;padding:12px 22px 18px;border-top:1px solid #e5e9ee}
    .purchase-trash-loading{text-align:center;padding:28px 12px;color:#667085;font-size:13px}
  </style>
</head>
<body class="admin-body">
  <%- include('../partials/header', { activeMenu: activeMenu, user: user }) %>

  <form id="poFilterForm" method="GET" action="/nhap-hang" class="po-page">
    <input type="hidden" name="page" id="poPageInput" value="<%= safePagination.page %>">
    <div class="po-shell">
      <aside class="po-sidebar">
        <h1 class="po-title">Nhập hàng</h1>
        <div class="filter-block">
          <div class="filter-title">Trạng thái</div>
          <label class="check-line"><input type="checkbox" name="trang_thai" value="completed" <%= selectedStatuses.includes('completed') ? 'checked' : '' %> onchange="submitPoFilters()"> Đã nhập hàng</label>
          <label class="check-line"><input type="checkbox" name="trang_thai" value="cancelled" <%= selectedStatuses.includes('cancelled') ? 'checked' : '' %> onchange="submitPoFilters()"> Đã hủy</label>
        </div>
        <div class="filter-block">
          <div class="filter-title">Nhà cung cấp</div>
          <select class="filter-control" name="nha_cung_cap_id" aria-label="Lọc theo nhà cung cấp" onchange="submitPoFilters()">
            <option value="">Tất cả nhà cung cấp</option>
            <% safeSuppliers.forEach(function(s) { %>
              <option value="<%= s._id %>" <%= String(safeFilters.nha_cung_cap_id || '') === String(s._id) ? 'selected' : '' %>><%= (s.ma_ncc ? s.ma_ncc + ' - ' : '') + (s.ten_ncc || 'Không tên') %></option>
            <% }) %>
          </select>
        </div>
        <div class="filter-block">
          <div class="filter-title">Lọc cảnh báo nợ</div>
          <label class="filter-check-row">
            <input type="checkbox" name="warnOnly" value="1" id="warnOnlyCheckbox" <%= safeFilters.warnOnly === '1' ? 'checked' : '' %>>
            <span>Chỉ hiện phiếu có cảnh báo</span>
          </label>
          <div class="filter-range-stack">
            <label>
              <span>Quá số ngày</span>
              <input type="number" min="0" step="1" name="warnMinDays" value="<%= safeFilters.warnMinDays || debtWarnDefaultDays || 10 %>">
            </label>
            <label>
              <span>Quá số tiền (VNĐ)</span>
              <input type="text" inputmode="numeric" class="js-vn-money-filter" name="warnMinAmount" value="<%= typeof formatFilterMoney === 'function' ? formatFilterMoney(safeFilters.warnMinAmount) : (safeFilters.warnMinAmount || '') %>" placeholder="Không giới hạn" autocomplete="off">
            </label>
          </div>
        </div>
      </aside>

      <main class="po-main">
        <div class="po-toolbar">
          <div class="po-search-group">
            <div class="po-search">
              <input name="q" value="<%= safeFilters.q || '' %>" placeholder="Theo mã phiếu nhập">
            </div>
            <span class="po-sort-label">Sắp xếp công nợ</span>
            <select class="po-sort-select" name="sort" aria-label="Sắp xếp công nợ" onchange="submitPoFilters()">
              <option value="newest" <%= safeFilters.sort === 'newest' ? 'selected' : '' %>>Mới nhất</option>
              <option value="oldest" <%= safeFilters.sort === 'oldest' ? 'selected' : '' %>>Cũ nhất</option>
              <option value="debt_high" <%= safeFilters.sort === 'debt_high' ? 'selected' : '' %>>Nợ NCC cao nhất</option>
              <option value="debt_low" <%= safeFilters.sort === 'debt_low' ? 'selected' : '' %>>Nợ NCC thấp nhất</option>
              <option value="oldest_debt" <%= safeFilters.sort === 'oldest_debt' ? 'selected' : '' %>>Nợ xa nhất</option>
            </select>
          </div>
          <div class="toolbar-actions">
            <button type="button" class="kv-btn danger purchase-delete-btn" id="openPurchaseTrashModal"><i class="fa-solid fa-trash-can"></i> Xóa</button>
            <a class="kv-btn primary" href="/nhap-hang/create">+ Nhập hàng</a>
            <button type="button" class="kv-btn" id="openPurchaseMergeModal">Gộp đơn</button>
            <button class="kv-btn" type="button">Xuất file ▾</button>
          </div>
        </div>

        <div class="po-table-wrap">
          <table class="po-table">
            <thead>
              <tr>
                <th class="check-col"><input class="row-check" type="checkbox"></th>
                <th class="star-col">☆</th>
                <th class="col-code">Mã nhập hàng</th>
                <th class="col-time">Thời gian</th>
                <th class="col-ncc-code">Mã NCC</th>
                <th>Nhà cung cấp</th>
                <th class="num col-order-total">Tổng giá trị đơn hàng</th>
                <th class="num col-paid">Đã thanh toán</th>
                <th class="num col-payable">Cần trả NCC</th>
                <th class="col-status">Trạng thái</th>
              </tr>
            </thead>
            <tbody>
              <tr class="customer-summary-row">
                <td class="check-col"></td>
                <td class="star-col"></td>
                <td colspan="4" style="text-align: right; font-weight: bold; color: #1e293b;">Tổng cộng:</td>
                <td class="num"><strong><%= fmtMoney(summaryTotals.orderTotal) %></strong></td>
                <td class="num"><strong><%= fmtMoney(summaryTotals.paid) %></strong></td>
                <td class="num"><strong><%= fmtMoney(summaryTotals.debt) %></strong></td>
                <td></td>
              </tr>
              <% if (safeTickets.length) { %>
                <% safeTickets.forEach(function(t) { %>
                  <tr class="expand-row purchase-row"
                    data-expand-id="<%= t._id %>"
                    data-purchase-id="<%= t._id %>"
                    data-purchase-code="<%= t.ma_phieu_nhap || '' %>"
                    data-purchase-date="<%= new Date(t.ngay_nhap || t.created_at).toISOString() %>"
                    data-purchase-status="<%= t.trang_thai || '' %>"
                    data-has-return="<%= t.has_return ? '1' : '0' %>"
                    data-supplier-id="<%= t.nha_cung_cap_id ? t.nha_cung_cap_id._id : '' %>"
                    data-supplier-code="<%= t.nha_cung_cap_id ? (t.nha_cung_cap_id.ma_ncc || '') : '' %>"
                    data-supplier-name="<%= t.nha_cung_cap_id ? (t.nha_cung_cap_id.ten_ncc || '') : '' %>"
                    data-payable="<%= Number(t.can_tra_ncc ?? t.tong_tien ?? 0) %>"
                    data-paid="<%= Number(t.da_tra_ncc ?? 0) %>"
                  >
                    <td class="check-col"><input class="row-check purchase-select-check" type="checkbox" value="<%= t._id %>" onclick="event.stopPropagation()"></td>
                    <td class="star-col">☆</td>
                    <td class="cell-ellipsis"><%- refLink('purchase', t, t.ma_phieu_nhap || '') %></td>
                    <td class="cell-ellipsis"><%= formatDate(t.ngay_nhap || t.created_at) %></td>
                    <td class="cell-ellipsis">
                      <% if (t.nha_cung_cap_id && t.nha_cung_cap_id._id) { %>
                        <%- refLink('supplier', t.nha_cung_cap_id, t.nha_cung_cap_id.ma_ncc || '--', 'onclick="event.stopPropagation()"') %>
                      <% } else { %>
                        --
                      <% } %>
                    </td>
                    <td class="cell-ellipsis"><%= t.nha_cung_cap_id ? (t.nha_cung_cap_id.ten_ncc || '--') : '--' %></td>
                    <td class="num"><%= fmtMoney((t.tong_tien ?? t.can_tra_ncc ?? 0)) %></td>
                    <td class="num"><%= fmtMoney((t.da_tra_ncc ?? 0)) %></td>
                    <td class="num">
                      <div class="purchase-debt-cell">
                        <span><%= fmtMoney(purchaseRemainDue(t)) %></span>
                        <% if (t.debt_warning) { %>
                          <button
                            type="button"
                            class="purchase-debt-warn-btn js-purchase-debt-warn"
                            onclick="event.stopPropagation()"
                            aria-label="Cảnh báo nợ quá hạn"
                          >⚠️
                            <span class="purchase-debt-warn-tip">
                              Phiếu nhập có khoản nợ quá hạn <strong><%= Number(t.so_ngay_no || 0).toLocaleString('vi-VN') %></strong> ngày.<br>
                              Cần trả NCC: <strong><%= fmt(purchaseRemainDue(t)) %> VNĐ</strong>.<br>
                              Mã phiếu: <strong><%= t.ma_phieu_nhap || '--' %></strong>.
                            </span>
                          </button>
                        <% } %>
                      </div>
                    </td>
                    <td><span class="status-badge <%= statusBadge(t.trang_thai) %>"><%= statusLabel(t.trang_thai) %></span></td>
                  </tr>
                  <tr class="po-detail-row" id="detail-<%= t._id %>" style="display:none">
                    <td colspan="10">
                      <div class="po-detail">
                        <div class="po-detail-tabs">
                          <button class="po-detail-tab is-active" type="button" data-tab-target="info">Thông tin</button>
                          <button class="po-detail-tab" type="button" data-tab-target="payment">Lịch sử thanh toán</button>
                        </div>
                        <div class="po-detail-pane is-active" data-tab-pane="info">
                          <div class="detail-head">
                            <div>
                              <div class="detail-title"><%- refLink('purchase', t, t.ma_phieu_nhap || '--') %></div>
                              <span class="status-badge <%= statusBadge(t.trang_thai) %>"><%= statusLabel(t.trang_thai) %></span>
                            </div>
                            <div><%= t.kho_id ? (t.kho_id.ten_kho || t.kho_id.ma_kho || '--') : '--' %></div>
                          </div>
                          <div class="detail-grid">
                            <div class="item">Người tạo<b><%= t.nguoi_tao_id ? (t.nguoi_tao_id.ho_ten || t.nguoi_tao_id.email || '--') : '--' %></b></div>
                            <div class="item">Người nhập<b><%= t.nguoi_tao_id ? (t.nguoi_tao_id.ho_ten || '--') : '--' %></b></div>
                            <div class="item">Ngày nhập<b><%= formatDate(t.ngay_nhap || t.created_at) %></b></div>
                            <div class="item">Kho nhập<b><%= t.kho_id ? (t.kho_id.ten_kho || t.kho_id.ma_kho || '--') : '--' %></b></div>
                            <div class="item">Tên NCC<b><%= t.nha_cung_cap_id ? (t.nha_cung_cap_id.ten_ncc || '--') : '--' %></b></div>
                            <div class="item">Mã NCC<b>
                              <% if (t.nha_cung_cap_id && t.nha_cung_cap_id._id) { %>
                                <%- refLink('supplier', t.nha_cung_cap_id, t.nha_cung_cap_id.ma_ncc || '--') %>
                              <% } else { %>
                                --
                              <% } %>
                            </b></div>
                            <div class="item" style="grid-column: span 2;">Ghi chú<b><%= t.ghi_chu || '--' %></b></div>
                          </div>
                          <div class="detail-body">
                            <div>
                              <% if (t.trang_thai === 'completed' && (t.vat_chua_lines || []).length) { %>
                                <div class="purchase-vat-chua-box">
                                  <div class="purchase-vat-chua-title"><i class="fa-solid fa-box"></i> Vật chứa đã nhập</div>
                                  <table class="mini-table purchase-vat-chua-table">
                                    <thead>
                                      <tr>
                                        <th>Mã chứng từ</th>
                                        <th>Loại</th>
                                        <th>Mã vật chứa</th>
                                        <th>Tên vật chứa</th>
                                        <th class="num">Số lượng</th>
                                        <th>Chứng từ liên kết</th>
                                        <th>Thời gian</th>
                                      </tr>
                                    </thead>
                                    <tbody>
                                      <% (t.vat_chua_lines || []).forEach(function(line) { %>
                                        <tr>
                                          <td>
                                            <% if (line.doc_href && line.doc_id) { %>
                                              <%- refLink('nhap_vat_chua', { _id: line.doc_id }, line.ma_chung_tu || '--') %>
                                            <% } else { %>
                                              <%= line.ma_chung_tu || '--' %>
                                            <% } %>
                                          </td>
                                          <td><%= line.doc_kind_label || '--' %></td>
                                          <td><%= line.ma_vat_chua || '--' %></td>
                                          <td><%= line.ten_vat_chua || '--' %></td>
                                          <td class="num"><%= fmt(line.so_luong || 0) %></td>
                                          <td>
                                            <% if (line.source_href && line.source_code) { %>
                                              <a class="ref-link" href="<%= line.source_href %>"><%= line.source_code %></a>
                                            <% } else { %>
                                              <%= line.source_code || '--' %>
                                            <% } %>
                                          </td>
                                          <td><%= formatDate(line.created_at) %></td>
                                        </tr>
                                      <% }) %>
                                    </tbody>
                                  </table>
                                </div>
                              <% } %>
                              <% if (!(t.detail_rows || []).length) { %>
                                <table class="mini-table"><tbody><tr><td>Không có chi tiết hàng.</td></tr></tbody></table>
                              <% } %>
                              <% detailGroups(t.detail_rows || []).forEach(function(group) { %>
                                <div class="lot-group-title">
                                  <%- group.product ? (refLink('product', group.product, group.product.ma_hang || '--') + ' - ' + (group.product.ten_hang || '--')) : '--' %>
                                </div>
                                <table class="mini-table grouped-lot-table">
                                  <thead>
                                    <tr>
                                      <th>Ngày / Lô</th>
                                      <th>Thuộc tính</th>
                                      <th class="num">Số Kg</th>
                                      <th class="num">Đơn giá</th>
                                      <th class="num">Thành tiền</th>
                                      <th class="num">Tổng theo lô</th>
                                    </tr>
                                  </thead>
                                  <tbody>
                                    <% var displayRows = detailRowsForGroup(group); %>
                                    <% displayRows.forEach(function(r, rowIndex) { %>
                                      <tr>
                                        <% if (rowIndex === 0) { %>
                                          <td class="lot-cell" rowspan="<%= displayRows.length %>"><%- group.lot_label %></td>
                                        <% } %>
                                        <td class="attr-cell">
                                          <div><%= r.ten_thuoc_tinh || '--' %></div>
                                        </td>
                                        <td class="num"><%= fmt(r.so_luong || 0) %></td>
                                        <td class="num"><%= fmtMoney(r.don_gia_nhap || 0) %></td>
                                        <td class="num"><%= fmtMoney(r.thanh_tien || 0) %></td>
                                        <% if (rowIndex === 0) { %>
                                          <td class="lot-total-cell" rowspan="<%= displayRows.length %>"><%= fmtMoney(group.total || 0) %></td>
                                        <% } %>
                                      </tr>
                                    <% }) %>
                                    <tr class="group-total-row">
                                      <td colspan="4" class="num">TỔNG CỘNG</td>
                                      <td class="num"><%= fmtMoney(group.total || 0) %></td>
                                      <td class="num"><%= fmtMoney(group.total || 0) %></td>
                                    </tr>
                                  </tbody>
                                </table>
                              <% }) %>
                            </div>
                            <div class="summary-card">
                              <div class="summary-line"><span>Số lượng mặt hàng</span><b><%= fmt(t?.detail_summary?.tong_mat_hang || 0) %></b></div>
                              <div class="summary-line"><span>Tổng tiền hàng</span><b><%= fmtMoney(t.tong_tien_hang || 0) %></b></div>
                              <div class="summary-line"><span>Giảm giá</span><b><%= (t.kieu_giam_gia === 'percent' ? ((t.giam_gia || 0) + '%') : fmtMoney(t.giam_gia || 0)) %></b></div>
                              <div class="summary-line"><span>Tổng cộng / Cần trả NCC</span><b><%= fmtMoney(t.can_tra_ncc || t.tong_tien || 0) %></b></div>
                              <div class="summary-line"><span>Tiền đã trả NCC</span><b><%= fmtMoney(t.da_tra_ncc || 0) %></b></div>
                              <div class="summary-line"><span>Nợ NCC</span><b><%= fmtMoney(t.con_no_ncc || 0) %></b></div>
                              <% if (Number(t.con_no_ncc || 0) > 0) { %>
                                <button type="button" class="kv-btn primary" style="width:100%;justify-content:center;margin-top:10px" onclick="openPaySupplierModal('<%= t._id %>')">Trả NCC</button>
                              <% } %>
                            </div>
                          </div>
                          <div class="page-actions page-actions--bordered detail-actions">
                            <button type="button" class="kv-btn primary" onclick="openPurchase('<%= t._id %>')">Chỉnh sửa</button>
                            <button type="button" class="kv-btn" onclick="cancelPurchase('<%= t._id %>')" <%= t.trang_thai === 'cancelled' ? 'disabled' : '' %>>Hủy</button>
                            <button type="button" class="kv-btn" onclick="copyPurchase('<%= t._id %>')">Sao chép</button>
                            <a class="kv-btn" href="/nhap-hang/<%= t._id %>/export.xlsx">Xuất file</a>
                            <a class="kv-btn" href="/phieu-nhap/<%= t._id %>/in-tong-hop" target="_blank">In phiếu + 02/TNDN</a>
                            <button type="button" class="kv-btn" onclick="returnPurchase('<%= t._id %>')">Trả hàng nhập</button>
                            <button type="button" class="kv-btn" onclick="openLabelModal('<%= t._id %>')">In tem mã</button>
                          </div>
                        </div>
                        <div class="po-detail-pane" data-tab-pane="payment">
                          <table class="mini-table">
                            <thead>
                              <tr><th>Ngày</th><th>Mã phiếu chi</th><th>Số tiền</th><th>Sổ quỹ</th><th>Người tạo</th><th>Ghi chú</th></tr>
                            </thead>
                            <tbody>
                              <% if (!(t.payment_rows || []).length) { %>
                                <tr><td colspan="6">Chưa có lịch sử thanh toán.</td></tr>
                              <% } %>
                              <% (t.payment_rows || []).forEach(function(p) { %>
                                <tr>
                                  <td><%= formatDate(p.thoi_gian) %></td>
                                  <td><%- p._id ? refLink('receipt', p._id, p.ma_phieu || '--') : (p.ma_phieu || '--') %></td>
                                  <td><%= fmtMoney(p.tien_chi || 0) %></td>
                                  <td><%= p.so_quy || '--' %></td>
                                  <td><%= p.nguoi_tao || '--' %></td>
                                  <td><%= p.ghi_chu || '--' %></td>
                                </tr>
                              <% }) %>
                            </tbody>
                          </table>
                        </div>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr><td colspan="10" class="po-empty">Chưa có phiếu nhập hàng</td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
        <div class="po-footer">
          <span class="po-page-size">Hiển thị 10 dòng/trang</span>
          <nav class="po-pagination" aria-label="Phân trang nhập hàng">
            <% if (safePagination.page > 1) { %>
              <a class="po-page-link" href="<%= buildPurchasePageUrl(1) %>">Đầu</a>
              <a class="po-page-link" href="<%= buildPurchasePageUrl(safePagination.page - 1) %>">Trước</a>
            <% } else { %>
              <span class="po-page-link is-disabled">Đầu</span>
              <span class="po-page-link is-disabled">Trước</span>
            <% } %>
            <span class="po-page-current"><%= safePagination.page %> / <%= safePagination.totalPages %></span>
            <% if (safePagination.page < safePagination.totalPages) { %>
              <a class="po-page-link" href="<%= buildPurchasePageUrl(safePagination.page + 1) %>">Sau</a>
              <a class="po-page-link" href="<%= buildPurchasePageUrl(safePagination.totalPages) %>">Cuối</a>
            <% } else { %>
              <span class="po-page-link is-disabled">Sau</span>
              <span class="po-page-link is-disabled">Cuối</span>
            <% } %>
          </nav>
          <span><%= safePagination.from %> - <%= safePagination.to %> trong <%= safePagination.total %> phiếu</span>
        </div>
      </main>
    </div>
  </form>
