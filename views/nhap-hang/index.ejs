  <div id="labelPrintArea" style="display:none"></div>
  <script id="purchaseData" type="application/json"><%- JSON.stringify(safeTickets || []).replace(/</g, '\\u003c') %></script>
  <script id="supplierData" type="application/json"><%- JSON.stringify(locals.suppliers || []).replace(/</g, '\\u003c') %></script>
  <script id="warehouseData" type="application/json"><%- JSON.stringify(locals.warehouses || []).replace(/</g, '\\u003c') %></script>
  <script id="cashBookData" type="application/json"><%- JSON.stringify(locals.cashBooks || []).replace(/</g, '\\u003c') %></script>
  <script id="vatChuaData" type="application/json"><%- JSON.stringify(locals.vatChuaList || []).replace(/</g, '\\u003c') %></script>
  <script>
    const purchases = JSON.parse(document.getElementById('purchaseData')?.textContent || '[]');
    const suppliers = JSON.parse(document.getElementById('supplierData')?.textContent || '[]');
    const warehouses = JSON.parse(document.getElementById('warehouseData')?.textContent || '[]');
    const cashBooks = JSON.parse(document.getElementById('cashBookData')?.textContent || '[]');
    const vatChuaList = JSON.parse(document.getElementById('vatChuaData')?.textContent || '[]');
    const paySupplierBookCache = { tien_mat: null, chuyen_khoan: null };
    let currentPurchaseId = '';
    let currentPurchaseEdit = null;
    function money(value){ return Number(value || 0).toLocaleString('vi-VN'); }
    function moneyText(value){ return money(value) + ' VNĐ'; }
    function numberValue(value){ return Number(String(value || '0').replace(/\./g, '').replace(/,/g, '').replace(/[^\d]/g, '')) || 0; }
    function normalizeEditQuyCachItems(items) {
      return (Array.isArray(items) ? items : [])
        .map(row => {
          const name = String((row && (row.ten_quy_cach || row.ten_thuoc_tinh)) || '').trim();
          const qty = Number(row && row.so_luong || 0) || 0;
          const price = Number(row && (row.don_gia_nhap || row.gia_von) || 0) || 0;
          return {
            ten_quy_cach: name,
            ten_thuoc_tinh: name,
            so_luong: qty,
            don_gia_nhap: price,
            gia_von: price,
            thanh_tien: Math.floor(qty * price),
            ghi_chu: String(row && row.ghi_chu || '').trim()
          };
        })
        .filter(row => row.ten_quy_cach || row.so_luong > 0 || row.don_gia_nhap > 0 || row.ghi_chu);
    }
    function editQcParentSelector(rowId) {
      const escapedId = window.CSS && CSS.escape ? CSS.escape(String(rowId)) : String(rowId).replace(/"/g, '\\"');
      return `[data-edit-qc-parent="${escapedId}"]`;
    }
    function collectEditQuyCachItems(rowId) {
      return normalizeEditQuyCachItems(Array.from(document.querySelectorAll(editQcParentSelector(rowId))).map(rowEl => ({
        ten_quy_cach: rowEl.querySelector('[data-edit-qc-field="ten_quy_cach"]')?.value || '',
        so_luong: numberValue(rowEl.querySelector('[data-edit-qc-field="so_luong"]')?.value || 0),
        don_gia_nhap: numberValue(rowEl.querySelector('[data-edit-qc-field="don_gia_nhap"]')?.value || 0),
        ghi_chu: rowEl.querySelector('[data-edit-qc-field="ghi_chu"]')?.value || ''
      })));
    }
    function editQuyCachRowHtml(rowId, qc, disabled) {
      qc = qc || {};
      return `
        <tr data-edit-qc-parent="${escapeHtml(rowId)}">
          <td><input data-edit-qc-field="ten_quy_cach" value="${escapeHtml(qc.ten_quy_cach || qc.ten_thuoc_tinh || '')}" oninput="calculatePurchaseEditTotals()" ${disabled ? 'disabled' : ''}></td>
          <td><input data-edit-qc-field="so_luong" inputmode="numeric" value="${money(qc.so_luong || 0)}" oninput="calculatePurchaseEditTotals()" ${disabled ? 'disabled' : ''}></td>
          <td><input data-edit-qc-field="don_gia_nhap" inputmode="numeric" value="${money(qc.don_gia_nhap || qc.gia_von || 0)}" oninput="calculatePurchaseEditTotals()" ${disabled ? 'disabled' : ''}></td>
          <td class="num" data-edit-qc-total>${moneyText(qc.thanh_tien || ((qc.so_luong || 0) * (qc.don_gia_nhap || qc.gia_von || 0)))}</td>
          <td><input data-edit-qc-field="ghi_chu" value="${escapeHtml(qc.ghi_chu || '')}" ${disabled ? 'disabled' : ''}></td>
          <td><button type="button" class="kv-btn danger" style="height:28px;padding:0 8px" onclick="removeEditQuyCachRow(this)" ${disabled ? 'disabled' : ''}>Xóa</button></td>
        </tr>`;
    }
    function addEditQuyCachRow(rowId) {
      const box = document.querySelector(`[data-edit-qc-box="${editQcDataValue(rowId)}"] tbody`);
      if (!box) return;
      box.insertAdjacentHTML('beforeend', editQuyCachRowHtml(rowId, { so_luong: 1 }, false));
      calculatePurchaseEditTotals();
    }
    function removeEditQuyCachRow(button) {
      const row = button && button.closest('[data-edit-qc-parent]');
      if (!row) return;
      row.remove();
      calculatePurchaseEditTotals();
    }
    function editQcDataValue(rowId) {
      return String(rowId).replace(/"/g, '&quot;');
    }
    function applyLiveVNFormat(el) {
      if (!el) return;
      const start = el.selectionStart == null ? el.value.length : el.selectionStart;
      const digitsBefore = String(el.value).slice(0, start).replace(/\D/g, '').length;
      const raw = String(el.value).replace(/\./g, '').replace(/,/g, '').replace(/[^\d]/g, '');
      if (!raw) {
        el.value = '';
        return;
      }
      const formatted = Number(raw).toLocaleString('vi-VN');
      el.value = formatted;
      let pos = formatted.length;
      if (digitsBefore > 0) {
        let digits = 0;
        for (let i = 0; i < formatted.length; i++) {
          if (/\d/.test(formatted[i])) {
            digits++;
            if (digits === digitsBefore) {
              pos = i + 1;
              break;
            }
          }
        }
      } else {
        pos = 0;
      }
      try { el.setSelectionRange(pos, pos); } catch (_) {}
    }
    function bindPayAmountInput(el) {
      if (!el || el.dataset.vnBound === '1') return;
      el.dataset.vnBound = '1';
      el.addEventListener('input', function() {
        applyLiveVNFormat(el);
        updatePaySupplierTotals();
      });
    }
    function setPaySupplierError(message) {
      const el = document.getElementById('paySupplierError');
      if (!el) return;
      el.textContent = message || '';
      el.classList.toggle('show', Boolean(message));
    }
    function paymentBookLabel(book) {
      const bank = book && book.thong_tin_ngan_hang ? book.thong_tin_ngan_hang : {};
      if (String(book?.loai_so_quy || '') === 'chuyen_khoan') {
        const parts = [
          bank.ten_ngan_hang || book.ten_so_quy || 'Tài khoản ngân hàng',
          bank.so_tai_khoan || ''
        ].filter(Boolean);
        return parts.join(' - ');
      }
      return book?.ten_so_quy || 'Sổ tiền mặt';
    }
    async function loadPaySupplierBooks(type) {
      if (paySupplierBookCache[type]) return paySupplierBookCache[type];
      const fallback = cashBooks
        .filter(book => String(book.loai_so_quy || 'tien_mat') === type && String(book.trang_thai || 'active') === 'active');
      try {
        const response = await fetch('/api/so-quy/active?loai_so_quy=' + encodeURIComponent(type), {
          headers: { 'Accept': 'application/json' }
        });
        const json = await response.json();
        const items = json && Array.isArray(json.items) ? json.items : [];
        paySupplierBookCache[type] = items
          .filter(book => String(book.loai_so_quy || '') === type && String(book.trang_thai || 'active') === 'active');
      } catch (_) {
        paySupplierBookCache[type] = fallback;
      }
      return paySupplierBookCache[type];
    }
    function autoSelectedPayBookId(books) {
      books = Array.isArray(books) ? books : [];
      const defaults = books.filter(book => book.mac_dinh);
      if (defaults.length) return String(defaults[0]._id || '');
      if (books.length === 1) return String(books[0]._id || '');
      return '';
    }
    function renderPayBookSelect(selectId, books, placeholder) {
      const select = document.getElementById(selectId);
      if (!select) return;
      const selectedId = autoSelectedPayBookId(books);
      const options = [`<option value="">${escapeHtml(placeholder)}</option>`]
        .concat((books || []).map(book => {
          const id = String(book._id || '');
          const selected = selectedId && id === selectedId ? 'selected' : '';
          return `<option value="${escapeHtml(id)}" ${selected}>${escapeHtml(paymentBookLabel(book))}</option>`;
        }));
      select.innerHTML = options.join('');
      select.dataset.hasBooks = books && books.length ? '1' : '0';
    }
    function updatePaySupplierTotals() {
      const tienMat = numberValue(document.getElementById('paySupplierTienMat')?.value || 0);
      const chuyenKhoan = numberValue(document.getElementById('paySupplierChuyenKhoan')?.value || 0);
      const debt = numberValue(document.getElementById('paySupplierDebt')?.dataset.debt || 0);
      const total = tienMat + chuyenKhoan;
      const cashSelect = document.getElementById('paySupplierCashBook');
      const bankSelect = document.getElementById('paySupplierBankBook');
      const totalEl = document.getElementById('paySupplierPayTotal');
      const afterEl = document.getElementById('paySupplierDebtAfter');
      if (cashSelect) {
        cashSelect.disabled = tienMat <= 0 || cashSelect.dataset.hasBooks !== '1';
      }
      if (bankSelect) {
        bankSelect.disabled = chuyenKhoan <= 0 || bankSelect.dataset.hasBooks !== '1';
      }
      if (totalEl) totalEl.textContent = moneyText(total);
      if (afterEl) afterEl.textContent = moneyText(Math.max(0, debt - total));
      if (total > debt) {
        setPaySupplierError('Số tiền thanh toán không được vượt công nợ phiếu nhập.');
      } else {
        setPaySupplierError('');
      }
    }
    function toDateInput(value){
      if (!value) return '';
      const d = new Date(value);
      if (Number.isNaN(d.getTime())) return '';
      return d.toISOString().split('T')[0];
    }
    function escapeHtml(value){
      return String(value ?? '').replace(/[&<>"']/g, char => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[char]));
    }
    function findPurchase(id){ return purchases.find(item => String(item._id) === String(id)); }
    async function postJson(url, body){
      const res = await fetch(url, { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(body || {}) });
      const text = await res.text();
      let data = {};
      try { data = text ? JSON.parse(text) : {}; } catch (_) { throw new Error(text || 'Backend trả về phản hồi không hợp lệ'); }
      if (!res.ok || !data.success) throw new Error(data.message || 'Thao tác thất bại');
      return data;
    }
    async function cancelPurchase(id){
      if (!confirm('Hủy phiếu nhập này? Nếu phiếu đã cộng kho, hệ thống sẽ rollback tồn kho.')) return;
      try {
        const data = await postJson('/nhap-hang/' + id + '/cancel');
        alert(data.message || 'Đã hủy phiếu nhập');
        location.reload();
      } catch (error) {
        alert(error.message || 'Không hủy được phiếu nhập');
      }
    }
    async function copyPurchase(id){
      if (!confirm('Sao chép phiếu nhập này thành phiếu tạm mới?')) return;
      try {
        const data = await postJson('/nhap-hang/' + id + '/copy');
        alert((data.message || 'Đã sao chép') + (data.ma_phieu_nhap ? ': ' + data.ma_phieu_nhap : ''));
        location.reload();
      } catch (error) {
        alert(error.message || 'Không sao chép được phiếu nhập');
      }
    }
    async function openPurchase(id){
      currentPurchaseId = id;
      const modal = document.getElementById('purchaseModal');
      const title = document.getElementById('purchaseModalTitle');
      const body = document.getElementById('purchaseModalBody');
      body.innerHTML = 'Đang tải phiếu nhập...';
      modal.classList.add('open');
      try {
        const res = await fetch('/nhap-hang/' + id + '/detail');
        const data = await res.json();
        if (!data.success) throw new Error(data.message || 'Không tải được phiếu nhập');
        const ticket = data.data.ticket;
        const readonly = ticket.trang_thai === 'cancelled';
        currentPurchaseEdit = { ticket, items: data.data.items || [] };
        title.textContent = `Chỉnh sửa ${ticket.ma_phieu_nhap || 'phiếu nhập'}`;
        const supplierOptions = suppliers.map(s => {
          const selected = String(s._id) === String(ticket.nha_cung_cap_id?._id || ticket.nha_cung_cap_id || '');
          return `<option value="${s._id}" ${selected ? 'selected' : ''}>${escapeHtml((s.ma_ncc ? s.ma_ncc + ' - ' : '') + (s.ten_ncc || s.ten_cong_ty || ''))}</option>`;
        }).join('');
        const warehouseOptions = warehouses.map(k => {
          const selected = String(k._id) === String(ticket.kho_id?._id || ticket.kho_id || '');
          return `<option value="${k._id}" ${selected ? 'selected' : ''}>${escapeHtml(k.ten_kho || k.ma_kho || '')}</option>`;
        }).join('');
        const vcEdit = data.data.vat_chua_edit || {};
        const vcLines = data.data.vat_chua_lines || [];
        const canEditVatChua = !readonly && ticket.trang_thai === 'completed' && (vatChuaList.length > 0 || vcLines.length > 0);
        let vatChuaSection = '';
        if (canEditVatChua) {
          const vcIds = new Set(vatChuaList.map(vc => String(vc._id || '')));
          const currentVcId = String(vcEdit.vat_chua_id || '');
          let extraVcOption = '';
          if (currentVcId && !vcIds.has(currentVcId)) {
            const fromLine = vcLines.find(line => String(line.vat_chua_id || '') === currentVcId) || vcLines[0] || {};
            const label = (fromLine.ma_vat_chua ? fromLine.ma_vat_chua + ' - ' : '') + (fromLine.ten_vat_chua || 'Vật chứa hiện tại');
            extraVcOption = `<option value="${escapeHtml(currentVcId)}" selected>${escapeHtml(label)}</option>`;
          }
          const vatChuaOptions = ['<option value="">— Chọn —</option>']
            .concat(extraVcOption ? [extraVcOption] : [])
            .concat(vatChuaList.map(vc => {
              const id = String(vc._id || '');
              const selected = currentVcId && id === currentVcId ? 'selected' : '';
              const label = (vc.ma_vat_chua ? vc.ma_vat_chua + ' - ' : '') + (vc.ten_vat_chua || '---');
              return `<option value="${escapeHtml(id)}" ${selected}>${escapeHtml(label)}</option>`;
            }))
            .join('');
          const vcQty = Number(vcEdit.so_luong || 0) > 0 ? String(Math.floor(Number(vcEdit.so_luong || 0))) : '';
          vatChuaSection = `
          <div class="purchase-vat-chua-box edit-vat-chua-box">
            <div class="purchase-vat-chua-title"><i class="fa-solid fa-box"></i> Vật chứa</div>
            <div class="edit-vat-chua-row">
              <label for="editVatChuaId">Vật chứa</label>
              <div class="vat-chua-combo">
                <select id="editVatChuaId" title="Chọn vật chứa">${vatChuaOptions}</select>
                <input id="editVatChuaQty" class="vat-chua-qty" inputmode="numeric" placeholder="SL" title="Số lượng vật chứa" value="${escapeHtml(vcQty)}">
              </div>
            </div>
            <p class="lot-note">Để trống nếu không nhập vật chứa. Khi lưu, tồn vật chứa được điều chỉnh theo thay đổi.</p>
          </div>`;
        }
        const itemRows = currentPurchaseEdit.items.map((row, index) => {
          const product = row.hang_hoa_id || {};
          const discountType = row.kieu_giam_gia_dong || 'vnd';
          const qcItems = normalizeEditQuyCachItems(row.lot_info && row.lot_info.quy_cach_items);
          const qcHtml = qcItems.length ? `
            <tr>
              <td class="edit-qc-cell" colspan="9">
                <div class="edit-qc-box" data-edit-qc-box="${escapeHtml(row._id)}">
