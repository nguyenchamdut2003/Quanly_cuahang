        };
        const editVatChuaEl = document.getElementById('editVatChuaId');
        if (editVatChuaEl) {
          payload.vat_chua_id = editVatChuaEl.value || '';
          payload.vat_chua_so_luong = document.getElementById('editVatChuaQty')?.value || '';
        }
        const data = await postJson('/nhap-hang/' + currentPurchaseId + '/save', payload);
        alert(data.message || 'Đã lưu');
        location.reload();
      } catch (error) {
        alert(error.message || 'Không lưu được phiếu nhập');
      }
    }
