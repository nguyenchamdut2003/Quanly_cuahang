      .detail-body{grid-template-columns:1fr!important}
      .edit-form-grid{grid-template-columns:1fr!important}
      .edit-total-box{grid-template-columns:1fr!important}
      .quick-pay-grid{grid-template-columns:1fr!important}
    }
    @media(max-width:520px){
      .toolbar-actions .kv-btn{flex:1 1 100%}
      .detail-grid{grid-template-columns:1fr!important}
    }
    .purchase-merge-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.58);z-index:1400;align-items:flex-start;justify-content:center;padding:7px 12px}
