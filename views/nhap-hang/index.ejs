<%
  const safeTickets = Array.isArray(locals.importSlips) ? locals.importSlips : [];
  const safeFilters = locals.filter || {};
  const safeSuppliers = Array.isArray(locals.suppliers) ? locals.suppliers : [];
  const safePagination = locals.pagination || { page: 1, totalPages: 1, total: 0, from: 0, to: 0, limit: 10 };
  const selectedStatuses = Array.isArray(safeFilters.statuses) ? safeFilters.statuses : [];
  const fmt = value => Number(value || 0).toLocaleString('vi-VN');
  const fmtMoney = value => fmt(value) + ' VNĐ';
  const purchaseRemainDue = ticket => {
    if (!ticket) return 0;
    if (ticket.con_no_ncc != null && ticket.con_no_ncc !== '') return Math.max(0, Number(ticket.con_no_ncc) || 0);
    const payable = Number(ticket.can_tra_ncc ?? ticket.tong_tien ?? 0) || 0;
    const paid = Number(ticket.da_tra_ncc ?? 0) || 0;
    return Math.max(0, payable - paid);
  };
  const summaryTotals = safeTickets.reduce((sum, ticket) => {
    sum.orderTotal += Number(ticket.tong_tien ?? ticket.can_tra_ncc ?? 0);
    sum.paid += Number(ticket.da_tra_ncc ?? 0);
    sum.debt += purchaseRemainDue(ticket);
    return sum;
  }, { orderTotal: 0, paid: 0, debt: 0 });
  const statusBadge = status => status === 'draft' ? 'draft' : (status === 'merged' ? 'merged' : '');
  const formatDateOnly = value => {
    if (!value) return '';
    const date = new Date(value);
    if (Number.isNaN(date.getTime())) return '';
    return date.toLocaleDateString('vi-VN');
  };
  const lotLabel = row => {
    const product = row && row.hang_hoa_id ? row.hang_hoa_id : {};
    if (!product.quan_ly_theo_lo) return 'Không theo lô';
    const lot = row && row.lo_hang_id ? row.lo_hang_id : null;
    if (!lot) return '--';
    const lotName = lot.ten_lo || lot.ma_lo || '--';
    const lotText = lot._id ? refLink('lot', lot, lotName) : lotName;
    const lotDate = formatDateOnly(lot.ngay_nhap);
    const expiry = formatDateOnly(lot.han_su_dung);
    const dateText = [lotDate || '--', expiry ? `HSD: ${expiry}` : 'HSD: --'].join(' - ');
    return `${lotText}<br><span class="lot-cell-date">${dateText}</span>`;
  };
  const thuocTinhSummary = row => {
    const info = row && row.lot_info ? row.lot_info : null;
    const items = info && Array.isArray(info.quy_cach_items) ? info.quy_cach_items : [];
    if (!items.length) return '--';
    const unit = row?.don_vi_tinh_id?.ten_don_vi || '';
    return items
      .filter(item => Number(item.so_luong || 0) > 0)
      .map(item => `${item.ten_quy_cach || item.ten_thuoc_tinh || '--'} ${fmt(item.so_luong || 0)}${unit}`)
      .join(', ');
  };
  const detailGroups = rows => {
    const groups = [];
    const index = {};
    (rows || []).forEach(row => {
      const product = row && row.hang_hoa_id ? row.hang_hoa_id : {};
      const lot = row && row.lo_hang_id ? row.lo_hang_id : null;
      const productId = String(product._id || row.hang_hoa_id || '');
      const lotId = product.quan_ly_theo_lo ? String(lot?._id || row.lo_hang_id || 'missing') : 'no-lot';
      const key = productId + '::' + lotId;
      if (!index[key]) {
        index[key] = {
          product,
          lot,
          lot_label: lotLabel(row),
          rows: [],
          total: 0
        };
        groups.push(index[key]);
      }
      index[key].rows.push(row);
      index[key].total += Number(row.thanh_tien || 0);
    });
    return groups;
  };
  const detailRowsForGroup = group => {
    const result = [];
    (group.rows || []).forEach(row => {
      const info = row && row.lot_info ? row.lot_info : null;
      const attrs = info && Array.isArray(info.quy_cach_items)
        ? info.quy_cach_items.filter(item => Number(item.so_luong || 0) > 0 || item.ten_quy_cach || item.ten_thuoc_tinh)
        : [];
      if (!attrs.length) {
        result.push({
          ten_thuoc_tinh: '--',
          so_luong: Number(row.so_luong || 0),
          don_gia_nhap: Number(row.don_gia_nhap || 0),
          thanh_tien: Number(row.thanh_tien || 0)
        });
        return;
      }
      attrs.forEach(item => {
        const qty = Number(item.so_luong || 0);
        const price = Number(item.don_gia_nhap || item.gia_von || row.don_gia_nhap || 0);
        result.push({
          ten_thuoc_tinh: item.ten_quy_cach || item.ten_thuoc_tinh || '--',
          so_luong: qty,
          don_gia_nhap: price,
          thanh_tien: Number(item.thanh_tien || (qty * price))
        });
      });
    });
    return result.length ? result : [{ ten_thuoc_tinh: '--', so_luong: 0, don_gia_nhap: 0, thanh_tien: 0 }];
  };
%>
<!DOCTYPE html>
