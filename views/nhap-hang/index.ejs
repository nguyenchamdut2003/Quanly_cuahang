    function closePurchaseModal(){ document.getElementById('purchaseModal').classList.remove('open'); }
    function calcEditLineTotal(rowEl){
      const rowId = rowEl.dataset.editRow;
      const qcItems = collectEditQuyCachItems(rowId);
      const qcTotal = qcItems.reduce((sum, item) => sum + Number(item.thanh_tien || 0), 0);
      const qcQty = qcItems.reduce((sum, item) => sum + Number(item.so_luong || 0), 0);
      if (qcItems.length) {
        const qtyInput = rowEl.querySelector('[data-edit-field="so_luong"]');
        const priceInput = rowEl.querySelector('[data-edit-field="don_gia_nhap"]');
        if (qtyInput) qtyInput.value = String(Math.floor(qcQty));
        if (priceInput) priceInput.value = qcQty > 0 ? money(Math.round(qcTotal / qcQty)) : '0';
        document.querySelectorAll(editQcParentSelector(rowId)).forEach(qcRow => {
          const qty = numberValue(qcRow.querySelector('[data-edit-qc-field="so_luong"]')?.value || 0);
          const price = numberValue(qcRow.querySelector('[data-edit-qc-field="don_gia_nhap"]')?.value || 0);
          const totalCell = qcRow.querySelector('[data-edit-qc-total]');
          if (totalCell) totalCell.textContent = moneyText(qty * price);
        });
        return Math.max(0, Math.floor(qcTotal));
      }
      const qty = Math.max(0, Math.floor(numberValue(rowEl.querySelector('[data-edit-field="so_luong"]')?.value || 0)));
      const price = numberValue(rowEl.querySelector('[data-edit-field="don_gia_nhap"]')?.value || 0);
      const discount = numberValue(rowEl.querySelector('[data-edit-field="giam_gia_dong"]')?.value || 0);
      const type = rowEl.querySelector('[data-edit-field="kieu_giam_gia_dong"]')?.value || 'vnd';
      const base = qty * price;
      const discountMoney = type === 'percent' ? Math.floor(base * Math.min(discount, 100) / 100) : discount;
      return Math.max(0, Math.floor(base - discountMoney));
    }
    function calculatePurchaseEditTotals(){
      let goodsTotal = 0;
      document.querySelectorAll('[data-edit-row]').forEach(rowEl => {
        const line = calcEditLineTotal(rowEl);
        goodsTotal += line;
        const totalCell = rowEl.querySelector('[data-edit-total]');
        if (totalCell) totalCell.textContent = moneyText(line);
      });
      const discount = numberValue(document.getElementById('editDiscount')?.value || 0);
      const discountType = document.getElementById('editDiscountType')?.value || 'vnd';
      const discountMoney = discountType === 'percent' ? Math.floor(goodsTotal * Math.min(discount, 100) / 100) : discount;
      const total = Math.max(0, goodsTotal - discountMoney);
      const payableInput = document.getElementById('editPayable');
      if (payableInput && !payableInput.dataset.touched) payableInput.value = money(total);
      const payable = Math.min(numberValue(payableInput?.value || total), total);
      const paid = Math.min(numberValue(document.getElementById('editPaid')?.value || 0), payable);
      const goodsEl = document.getElementById('editGoodsTotal');
      const totalEl = document.getElementById('editTotal');
      const debtEl = document.getElementById('editDebt');
      if (goodsEl) goodsEl.textContent = moneyText(goodsTotal);
      if (totalEl) totalEl.textContent = moneyText(total);
      if (debtEl) debtEl.textContent = moneyText(Math.max(0, payable - paid));
    }
    function validateVatChuaEdit(){
      const id = String(document.getElementById('editVatChuaId')?.value || '').trim();
      const rawQty = String(document.getElementById('editVatChuaQty')?.value || '').replace(/\./g, '').replace(/,/g, '').trim();
      if (!id && !rawQty) return true;
      const qty = Math.floor(Number(rawQty || 0));
      if (id && qty <= 0) {
        alert('Số lượng vật chứa phải lớn hơn 0');
        document.getElementById('editVatChuaQty')?.focus();
        return false;
      }
      if (!id && rawQty && qty > 0) {
        alert('Vui lòng chọn vật chứa');
        document.getElementById('editVatChuaId')?.focus();
        return false;
      }
      return true;
    }
    async function savePurchaseNote(){
      if (!currentPurchaseId) return;
      if (!validateVatChuaEdit()) return;
      try {
        const items = Array.from(document.querySelectorAll('[data-edit-row]')).map(rowEl => {
          const rowId = rowEl.dataset.editRow;
          const source = (currentPurchaseEdit && Array.isArray(currentPurchaseEdit.items)
            ? currentPurchaseEdit.items.find(row => String(row._id) === String(rowId))
            : null) || {};
          const qcItems = collectEditQuyCachItems(rowId);
          const item = {
            _id: rowId,
            so_luong: rowEl.querySelector('[data-edit-field="so_luong"]')?.value || 0,
