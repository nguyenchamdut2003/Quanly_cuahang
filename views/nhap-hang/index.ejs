      labelItems.innerHTML = rows.length ? `
        <table class="mini-table"><thead><tr><th>Hàng hóa</th><th>Số lượng nhập</th><th>Số tem</th></tr></thead><tbody>
        ${rows.map(row => `<tr><td>${row.hang_hoa_id?.ma_hang || ''} - ${row.hang_hoa_id?.ten_hang || ''}</td><td>${money(row.so_luong || 0)}</td><td><input data-label-product="${row._id}" type="number" min="0" value="${Number(row.so_luong || 0)}" style="width:90px"></td></tr>`).join('')}
        </tbody></table>` : 'Phiếu chưa có hàng hóa';
      document.getElementById('labelModal').classList.add('open');
    }
    function closeLabelModal(){ document.getElementById('labelModal').classList.remove('open'); }
    function printLabels(){
      const p = findPurchase(currentPurchaseId);
      if (!p) return;
      const qtyByRow = {};
      document.querySelectorAll('[data-label-product]').forEach(input => { qtyByRow[input.dataset.labelProduct] = Math.max(0, Number(input.value || 0)); });
      const labels = [];
      (p.detail_rows || []).forEach(row => {
        const qty = qtyByRow[String(row._id)] || 0;
        for (let i = 0; i < qty; i++) {
          labels.push(`<div class="label-item"><div class="label-code">${row.hang_hoa_id?.ma_hang || ''}</div><div>${row.hang_hoa_id?.ten_hang || ''}</div><div>Giá nhập: ${moneyText(row.don_gia_nhap || 0)}</div><div class="label-bar">|||| ${row.hang_hoa_id?.ma_hang || ''} ||||</div></div>`);
        }
      });
      if (!labels.length) return alert('Chưa chọn số lượng tem');
      labelPrintArea.innerHTML = `<div class="label-sheet">${labels.join('')}</div>`;
      window.print();
    }
    function submitPoFilters() {
      var form = document.getElementById('poFilterForm');
      var pageInput = document.getElementById('poPageInput');
      if (pageInput) pageInput.value = '1';
      if (!form) return;
      if (typeof form.requestSubmit === 'function') {
        form.requestSubmit();
      } else {
        form.submit();
      }
    }
    document.addEventListener('DOMContentLoaded', function() {
      var poFilterForm = document.getElementById('poFilterForm');
      function parseFilterMoney(value) {
        var normalized = String(value || '').replace(/\./g, '').replace(/,/g, '').trim();
        if (normalized === '') return '';
        var number = Number(normalized);
        return Number.isFinite(number) && number >= 0 ? Math.floor(number) : '';
      }
      function formatFilterMoney(value) {
        if (value === '' || value == null) return '';
        var number = Math.max(0, Math.floor(Number(value || 0)));
        return number.toLocaleString('vi-VN');
      }
      function bindVnMoneyFilterInputs(root) {
        var scope = root || document;
        scope.querySelectorAll('.js-vn-money-filter').forEach(function(input) {
          if (input.getAttribute('data-vn-money-bound') === '1') return;
          input.setAttribute('data-vn-money-bound', '1');
          input.addEventListener('input', function() {
            var digits = String(input.value || '').replace(/\D/g, '');
            input.value = digits === '' ? '' : formatFilterMoney(digits);
          });
        });
      }
      if (poFilterForm) {
        bindVnMoneyFilterInputs(poFilterForm);
        poFilterForm.addEventListener('submit', function() {
          var pageInput = document.getElementById('poPageInput');
          if (pageInput) pageInput.value = '1';
          poFilterForm.querySelectorAll('.js-vn-money-filter').forEach(function(input) {
            var parsed = parseFilterMoney(input.value);
            input.value = parsed === '' ? '' : String(parsed);
          });
        });
        var warnOnlyCheckbox = document.getElementById('warnOnlyCheckbox');
        if (warnOnlyCheckbox) {
          warnOnlyCheckbox.addEventListener('change', function() {
            submitPoFilters();
          });
        }
        var warnMinDaysInput = poFilterForm.querySelector('input[name="warnMinDays"]');
        if (warnMinDaysInput) {
          warnMinDaysInput.addEventListener('change', function() {
            submitPoFilters();
          });
        }
        var warnMinAmountInput = poFilterForm.querySelector('input[name="warnMinAmount"]');
        if (warnMinAmountInput) {
          warnMinAmountInput.addEventListener('change', function() {
            submitPoFilters();
          });
        }
      }
      function positionPurchaseDebtWarnTip(btn, tip) {
        if (!btn || !tip) return;
        var rect = btn.getBoundingClientRect();
        var tipWidth = Math.min(300, window.innerWidth - 24);
        var left = Math.max(12, rect.right - tipWidth);
        var top = rect.bottom + 8;
        if (top + tip.offsetHeight > window.innerHeight - 12) {
          top = Math.max(12, rect.top - tip.offsetHeight - 8);
        }
        tip.style.width = tipWidth + 'px';
        tip.style.left = left + 'px';
        tip.style.top = top + 'px';
      }
      function bindPurchaseDebtWarnTips(root) {
        var scope = root || document;
        scope.querySelectorAll('.js-purchase-debt-warn').forEach(function(btn) {
          if (btn.dataset.warnTipBound === '1') return;
          btn.dataset.warnTipBound = '1';
          var tip = btn.querySelector('.purchase-debt-warn-tip');
          if (!tip) return;
          function showTip() {
            tip.classList.add('is-visible');
            positionPurchaseDebtWarnTip(btn, tip);
          }
          function hideTip() {
            tip.classList.remove('is-visible');
          }
          btn.addEventListener('mouseenter', showTip);
          btn.addEventListener('mouseleave', hideTip);
          btn.addEventListener('focus', showTip);
          btn.addEventListener('blur', hideTip);
          window.addEventListener('scroll', hideTip, true);
          window.addEventListener('resize', function() {
            if (tip.classList.contains('is-visible')) positionPurchaseDebtWarnTip(btn, tip);
          });
        });
      }
      bindPurchaseDebtWarnTips(document);

      var rows = Array.prototype.slice.call(document.querySelectorAll('.expand-row'));
      rows.forEach(function(row) {
        row.addEventListener('click', function(e) {
          if (e.target && e.target.closest('input[type="checkbox"]')) return;
          if (e.target && e.target.closest('.js-purchase-debt-warn')) return;
          var id = row.getAttribute('data-expand-id');
          var detail = document.getElementById('detail-' + id);
          if (!detail) return;
          detail.style.display = detail.style.display === 'none' ? 'table-row' : 'none';
        });
      });
      var params = new URLSearchParams(window.location.search);
      var purchaseId = params.get('purchase');
      if (params.get('export') === '1' && purchaseId) {
        var exportFrame = document.createElement('iframe');
        exportFrame.style.display = 'none';
        exportFrame.src = '/nhap-hang/' + encodeURIComponent(purchaseId) + '/export.xlsx';
        document.body.appendChild(exportFrame);
        setTimeout(function() { exportFrame.remove(); }, 120000);
        params.delete('export');
        var cleanQs = params.toString();
        history.replaceState({}, '', '/nhap-hang' + (cleanQs ? '?' + cleanQs : ''));
      }
      if (purchaseId) {
        var purchaseRow = document.querySelector('[data-expand-id="' + purchaseId + '"]');
        var purchaseDetail = document.getElementById('detail-' + purchaseId);
        if (purchaseRow && purchaseDetail) {
          purchaseDetail.style.display = 'table-row';
          purchaseRow.scrollIntoView({ block: 'center' });
        }
      }
      var detailBlocks = Array.prototype.slice.call(document.querySelectorAll('.po-detail'));
      detailBlocks.forEach(function(block) {
        var tabs = Array.prototype.slice.call(block.querySelectorAll('.po-detail-tab'));
        var panes = Array.prototype.slice.call(block.querySelectorAll('.po-detail-pane'));
        tabs.forEach(function(tab) {
          tab.addEventListener('click', function(ev) {
            ev.stopPropagation();
            var target = tab.getAttribute('data-tab-target');
            tabs.forEach(function(t) { t.classList.remove('is-active'); });
            panes.forEach(function(p) { p.classList.remove('is-active'); });
            tab.classList.add('is-active');
            var pane = block.querySelector('.po-detail-pane[data-tab-pane="' + target + '"]');
            if (pane) pane.classList.add('is-active');
          });
        });
      });
    });

    (function initPurchaseMergeModal() {
      var overlay = document.getElementById('purchaseMergeModalOverlay');
      var openBtn = document.getElementById('openPurchaseMergeModal');
      var closeBtn = document.getElementById('purchaseMergeModalClose');
      var cancelBtn = document.getElementById('purchaseMergeCancel');
      var rowsEl = document.getElementById('purchaseMergeRows');
      var emptyEl = document.getElementById('purchaseMergeEmpty');
      var emptyTitleEl = document.getElementById('purchaseMergeEmptyTitle');
      var emptyDescEl = document.getElementById('purchaseMergeEmptyDesc');
      var footEl = document.getElementById('purchaseMergeFoot');
      var supplierSelect = document.getElementById('purchaseMergeSupplierSelect');
      var modalCheckAll = document.getElementById('purchaseMergeCheckAll');
      var submitBtn = document.getElementById('purchaseMergeSubmit');
      var selectAll = document.querySelector('.po-table thead .row-check');
      var purchaseChecks = Array.prototype.slice.call(document.querySelectorAll('.purchase-select-check'));
      var modalPurchases = [];

      function escapeHtml(value) {
        return String(value == null ? '' : value).replace(/[&<>"']/g, function(char) {
          return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[char];
        });
      }
      function moneyText(value) {
        return Number(value || 0).toLocaleString('vi-VN') + ' VNĐ';
      }
      function readPurchase(row) {
        return {
          id: row.dataset.purchaseId || '',
          code: row.dataset.purchaseCode || '',
          date: new Date(row.dataset.purchaseDate || ''),
          status: row.dataset.purchaseStatus || '',
          hasReturn: row.dataset.hasReturn === '1',
          supplierId: row.dataset.supplierId || '',
          supplierCode: row.dataset.supplierCode || '',
          supplierName: row.dataset.supplierName || '--',
          supplierKey: row.dataset.supplierId || row.dataset.supplierCode || '',
          payable: Number(row.dataset.payable || 0),
          paid: Number(row.dataset.paid || 0)
        };
      }
      function isMergeablePurchase(purchase) {
        if (!purchase || !purchase.id) return false;
        if (['cancelled', 'merged'].indexOf(purchase.status) >= 0) return false;
        if (purchase.hasReturn) return false;
        if (!purchase.supplierKey) return false;
        return ['draft', 'completed'].indexOf(purchase.status) >= 0;
      }
      function getModalSuppliers(purchases) {
        var map = {};
        purchases.forEach(function(purchase) {
          if (!purchase.supplierKey) return;
          if (!map[purchase.supplierKey]) {
            map[purchase.supplierKey] = {
              key: purchase.supplierKey,
              code: purchase.supplierCode,
              name: purchase.supplierName || '--'
            };
          }
        });
        return Object.keys(map).map(function(key) { return map[key]; }).sort(function(a, b) {
          return a.name.localeCompare(b.name, 'vi');
        });
      }
      function getPageSupplierFilterKey() {
        var pageSelect = document.querySelector('#poFilterForm select[name="nha_cung_cap_id"]');
        return pageSelect ? String(pageSelect.value || '').trim() : '';
      }
      function resolveInitialSupplierKey(suppliers) {
        var pageKey = getPageSupplierFilterKey();
        if (pageKey && suppliers.some(function(supplier) { return supplier.key === pageKey; })) {
          return pageKey;
        }
        if (suppliers.length === 1) return suppliers[0].key;
        return '';
      }
      function renderSupplierOptions(purchases) {
        if (!supplierSelect) return;
        var suppliers = getModalSuppliers(purchases);
        supplierSelect.innerHTML = '<option value="">— Chọn nhà cung cấp —</option>' + suppliers.map(function(supplier) {
          var label = [supplier.code, supplier.name].filter(Boolean).join(' - ');
          return '<option value="' + escapeHtml(supplier.key) + '">' + escapeHtml(label) + '</option>';
        }).join('');
      }
      function getFilteredModalPurchases() {
        var supplierKey = supplierSelect ? supplierSelect.value : '';
        if (!supplierKey) return [];
        return modalPurchases.filter(function(p) { return p.supplierKey === supplierKey; });
      }
      function updateModalCheckAll() {
        if (!modalCheckAll) return;
        var rowChecks = Array.prototype.slice.call(document.querySelectorAll('.purchase-merge-row-check'));
        modalCheckAll.checked = rowChecks.length > 0 && rowChecks.every(function(cb) { return cb.checked; });
        modalCheckAll.indeterminate = rowChecks.some(function(cb) { return cb.checked; }) && !modalCheckAll.checked;
      }
      function renderRows(purchases, emptyTitle, emptyDesc) {
        if (!rowsEl || !emptyEl || !footEl) return;
        var hasRows = purchases.length > 0;
        rowsEl.innerHTML = hasRows ? purchases.map(function(purchase) {
          return '<tr>' +
            '<td class="purchase-merge-check"><input class="purchase-merge-row-check" type="checkbox" value="' + escapeHtml(purchase.id) + '" data-supplier-key="' + escapeHtml(purchase.supplierKey) + '"></td>' +
            '<td>' + escapeHtml(purchase.code) + '</td>' +
            '<td>' + escapeHtml(Number.isFinite(purchase.date.getTime()) ? purchase.date.toLocaleString('vi-VN') : '') + '</td>' +
            '<td class="num">' + moneyText(purchase.payable) + '</td>' +
            '<td class="num">' + moneyText(purchase.paid) + '</td>' +
            '<td>' + escapeHtml(purchase.supplierCode) + '</td>' +
            '<td>' + escapeHtml(purchase.supplierName) + '</td>' +
          '</tr>';
        }).join('') : '';
        if (emptyTitleEl) emptyTitleEl.textContent = emptyTitle || 'Không có phiếu nhập có thể gộp';
        if (emptyDescEl) emptyDescEl.textContent = emptyDesc || '';
        emptyEl.style.display = hasRows ? 'none' : 'flex';
        footEl.style.display = hasRows ? 'flex' : 'none';
        updateModalCheckAll();
        Array.prototype.slice.call(document.querySelectorAll('.purchase-merge-row-check')).forEach(function(cb) {
          cb.addEventListener('change', updateModalCheckAll);
        });
      }
      function refreshModalRows() {
        var supplierKey = supplierSelect ? supplierSelect.value : '';
        if (!supplierKey) {
          renderRows([], 'Chưa chọn nhà cung cấp', 'Vui lòng chọn nhà cung cấp để xem danh sách phiếu nhập có thể gộp.');
          return;
        }
        var filtered = getFilteredModalPurchases();
        renderRows(filtered, 'Không có phiếu nhập có thể gộp', 'Nhà cung cấp này chưa có phiếu nhập hợp lệ trong danh sách hiện tại (đã loại phiếu hủy, đã gộp hoặc đã trả hàng).');
      }
      async function submitMergePurchases() {
        var supplierKey = supplierSelect ? supplierSelect.value : '';
        if (!supplierKey) {
          return alert('Vui lòng chọn nhà cung cấp trước khi gộp phiếu nhập.');
        }
        var selectedIds = Array.prototype.slice.call(document.querySelectorAll('.purchase-merge-row-check:checked')).map(function(cb) { return cb.value; }).filter(Boolean);
        if (selectedIds.length < 2) {
          return alert('Vui lòng chọn ít nhất 2 phiếu nhập để gộp.');
        }
        var selectedSupplierKeys = {};
        Array.prototype.slice.call(document.querySelectorAll('.purchase-merge-row-check:checked')).forEach(function(cb) {
          var key = cb.dataset.supplierKey || '';
          if (key) selectedSupplierKeys[key] = true;
        });
        if (Object.keys(selectedSupplierKeys).length > 1) {
          return alert('Chỉ được gộp các phiếu thuộc cùng một nhà cung cấp.');
        }
        if (submitBtn) submitBtn.disabled = true;
        try {
          var res = await fetch('/api/nhap-hang/gop-phieu-nhap', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ phieu_nhap_ids: selectedIds })
          });
          var data = await res.json();
          if (!data.success) return alert(data.message || 'Không gộp được phiếu nhập.');
          window.location.href = '/nhap-hang?purchase=' + encodeURIComponent(data.data && data.data.phieu_nhan_id ? data.data.phieu_nhan_id : selectedIds[0]);
        } catch (error) {
          alert('Không gộp được phiếu nhập.');
        } finally {
          if (submitBtn) submitBtn.disabled = false;
        }
      }
      function openModal() {
        if (!overlay) return;
        var allRows = Array.prototype.slice.call(document.querySelectorAll('.purchase-row'));
        modalPurchases = allRows.map(readPurchase).filter(isMergeablePurchase);
        renderSupplierOptions(modalPurchases);
        if (supplierSelect) {
          supplierSelect.value = resolveInitialSupplierKey(getModalSuppliers(modalPurchases));
        }
        refreshModalRows();
        overlay.style.display = 'flex';
      }
      function closeModal() {
        if (overlay) overlay.style.display = 'none';
      }
      if (selectAll) {
        selectAll.addEventListener('click', function(e) {
          e.stopPropagation();
          purchaseChecks.forEach(function(cb) { cb.checked = selectAll.checked; });
        });
      }
      purchaseChecks.forEach(function(cb) {
        cb.addEventListener('change', function() {
          if (!selectAll) return;
          selectAll.checked = purchaseChecks.length > 0 && purchaseChecks.every(function(item) { return item.checked; });
          selectAll.indeterminate = purchaseChecks.some(function(item) { return item.checked; }) && !selectAll.checked;
        });
      });
      if (openBtn) openBtn.addEventListener('click', openModal);
      if (closeBtn) closeBtn.addEventListener('click', closeModal);
      if (cancelBtn) cancelBtn.addEventListener('click', closeModal);
      if (submitBtn) submitBtn.addEventListener('click', submitMergePurchases);
      if (supplierSelect) supplierSelect.addEventListener('change', refreshModalRows);
      if (modalCheckAll) {
        modalCheckAll.addEventListener('change', function() {
          Array.prototype.slice.call(document.querySelectorAll('.purchase-merge-row-check')).forEach(function(cb) {
            cb.checked = modalCheckAll.checked;
          });
          updateModalCheckAll();
        });
      }
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && overlay && overlay.style.display === 'flex') closeModal();
      });
    })();

    (function initPurchaseTrashModal() {
      var openBtn = document.getElementById('openPurchaseTrashModal');
      var overlay = document.getElementById('purchaseTrashModalOverlay');
      var closeBtn = document.getElementById('purchaseTrashModalClose');
      var cancelBtn = document.getElementById('purchaseTrashCancel');
      var confirmBtn = document.getElementById('purchaseTrashConfirm');
      var alertBox = document.getElementById('purchaseTrashAlert');
      var selectedList = document.getElementById('purchaseTrashSelectedList');
      var impactBody = document.getElementById('purchaseTrashImpactRows');
      var purchaseChecks = Array.prototype.slice.call(document.querySelectorAll('.purchase-select-check'));
      var pendingIds = [];
      var previewData = null;

      function escapeHtml(value) {
        return String(value == null ? '' : value).replace(/[&<>"']/g, function(char) {
          return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[char];
        });
      }

      function getSelectedPurchaseIds() {
        return purchaseChecks.filter(function(cb) { return cb.checked; }).map(function(cb) {
          return String(cb.value || '').trim();
        }).filter(Boolean);
      }

      function updateDeleteButtonState() {
        if (!openBtn) return;
        openBtn.disabled = false;
      }

      function closeTrashModal() {
        if (!overlay) return;
        overlay.classList.remove('is-open');
        overlay.setAttribute('aria-hidden', 'true');
        pendingIds = [];
        previewData = null;
        if (confirmBtn) confirmBtn.disabled = false;
      }

      function renderAlert(preview) {
        if (!alertBox) return;
        var html = '';
        (preview.items || []).forEach(function(item) {
          if (!item.can_trash && item.block_reason) {
            html += '<div class="purchase-trash-alert is-error">' + escapeHtml(item.ma_phieu_nhap || item.phieu_nhap_id) + ': ' + escapeHtml(item.block_reason) + '</div>';
          }
          (item.warnings || []).forEach(function(warn) {
            html += '<div class="purchase-trash-alert is-warn">' + escapeHtml(item.ma_phieu_nhap || '') + (item.ma_phieu_nhap ? ' — ' : '') + escapeHtml(warn) + '</div>';
          });
        });
        alertBox.innerHTML = html;
      }

      function renderSelectedList(preview) {
        if (!selectedList) return;
        selectedList.innerHTML = (preview.items || []).map(function(item) {
          var label = [item.ma_phieu_nhap, item.ten_ncc].filter(Boolean).join(' — ');
          return '<li>' + escapeHtml(label || item.phieu_nhap_id) + '</li>';
        }).join('');
      }

      function renderImpactRows(preview) {
        if (!impactBody) return;
        var groups = preview.aggregate_groups || [];
        if (!groups.length) {
          impactBody.innerHTML = '<tr><td colspan="5">Không có dữ liệu liên quan đáng kể.</td></tr>';
          return;
        }
        impactBody.innerHTML = groups.map(function(group) {
          var samples = (group.samples || []).join(', ');
          var qty = Number(group.affected_quantity || 0);
          var amount = Number(group.affected_amount || 0);
          var impact = [];
          if (qty) impact.push(qty.toLocaleString('vi-VN'));
          if (amount) impact.push(amount.toLocaleString('vi-VN') + ' VNĐ');
          return '<tr>'
            + '<td>' + escapeHtml(group.label || group.entity_type) + '</td>'
            + '<td class="num">' + escapeHtml(String(group.count || 0)) + '</td>'
            + '<td>' + escapeHtml(group.action || 'giữ nguyên') + '</td>'
            + '<td class="num">' + escapeHtml(impact.join(' / ') || '—') + '</td>'
            + '<td>' + escapeHtml(samples || '—') + '</td>'
            + '</tr>';
        }).join('');
      }

      function openTrashModal() {
        var ids = getSelectedPurchaseIds();
        if (!ids.length) {
          alert('Vui lòng chọn ít nhất một phiếu nhập.');
          return;
        }
        pendingIds = ids.slice();
        if (overlay) {
          overlay.classList.add('is-open');
          overlay.setAttribute('aria-hidden', 'false');
        }
        if (impactBody) impactBody.innerHTML = '';
        if (alertBox) alertBox.innerHTML = '';
        if (selectedList) selectedList.innerHTML = '';
        if (confirmBtn) confirmBtn.disabled = false;
        previewData = { can_proceed: true };
      }

      function confirmTrash() {
        if (!pendingIds.length) return;
        if (confirmBtn) confirmBtn.disabled = true;
        fetch('/nhap-hang/deactivate', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ phieu_nhap_ids: pendingIds })
        })
          .then(function(res) { return res.json(); })
          .then(function(data) {
            if (!data.success) throw new Error(data.message || 'Không xóa được phiếu nhập');
            alert(data.message || 'Đã xóa phiếu nhập');
            window.location.reload();
          })
          .catch(function(err) {
            alert(err.message || 'Không xóa được phiếu nhập');
            if (confirmBtn) confirmBtn.disabled = false;
          });
      }

      purchaseChecks.forEach(function(cb) {
        cb.addEventListener('change', updateDeleteButtonState);
      });
      var headerCheck = document.querySelector('.po-table thead .row-check');
      if (headerCheck) {
        headerCheck.addEventListener('click', function() {
          window.setTimeout(updateDeleteButtonState, 0);
        });
      }
      if (openBtn) openBtn.addEventListener('click', openTrashModal);
      if (closeBtn) closeBtn.addEventListener('click', closeTrashModal);
      if (cancelBtn) cancelBtn.addEventListener('click', closeTrashModal);
      if (confirmBtn) confirmBtn.addEventListener('click', confirmTrash);
      if (overlay) {
        overlay.addEventListener('click', function(e) {
          if (e.target === overlay) closeTrashModal();
        });
      }
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && overlay && overlay.classList.contains('is-open')) closeTrashModal();
      });
      updateDeleteButtonState();
    })();
  </script>
</body>
</html>
