            kieu_giam_gia_dong: rowEl.querySelector('[data-edit-field="kieu_giam_gia_dong"]')?.value || 'vnd',
            ghi_chu: rowEl.querySelector('[data-edit-field="ghi_chu"]')?.value || ''
          };
          if ((source.lot_info && typeof source.lot_info === 'object') || qcItems.length) {
            item.lot_info = Object.assign({}, source.lot_info || {}, {
              lo_hang_id: source.lo_hang_id?._id || source.lo_hang_id || source.lot_info?.lo_hang_id || '',
              ma_lo: source.lo_hang_id?.ma_lo || source.lot_info?.ma_lo || '',
              ten_lo: source.lo_hang_id?.ten_lo || source.lot_info?.ten_lo || '',
              ngay_nhap: source.lo_hang_id?.ngay_nhap || source.lot_info?.ngay_nhap || '',
              han_su_dung: source.lo_hang_id?.han_su_dung || source.lot_info?.han_su_dung || '',
              quy_cach_items: qcItems
            });
          }
          return item;
        });
        const payload = {
          nha_cung_cap_id: document.getElementById('editSupplier')?.value || '',
          kho_id: document.getElementById('editWarehouse')?.value || '',
          ngay_nhap: document.getElementById('editImportDate')?.value || '',
