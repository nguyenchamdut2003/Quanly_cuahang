<%
  const fmt = value => Number(value || 0).toLocaleString('vi-VN');
  const d = value => value ? new Date(value).toLocaleDateString('vi-VN') : '';
  const supplier = ticket.nha_cung_cap_id || {};
  const warehouse = ticket.kho_id || {};
  const printBundles = (typeof printGroups !== 'undefined' && printGroups && printGroups.length) ? printGroups : [];
%>
<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <title><%= title %></title>
  <style>
    body{font-family:Arial,sans-serif;color:#111;margin:0;background:#f3f4f6}
    .page{width:210mm;min-height:297mm;margin:0 auto;background:#fff;padding:16mm;box-sizing:border-box}
    h1{text-align:center;font-size:22px;margin:14px 0 6px;text-transform:uppercase}
    .meta{display:grid;grid-template-columns:1fr 1fr;gap:6px 24px;font-size:13px;margin:14px 0}
    .store{text-align:center;font-size:13px}
    table{width:100%;border-collapse:collapse;margin-top:12px}
    th,td{border:1px solid #333;padding:5px 6px;font-size:11.5px}
    th{text-align:center;background:#f1f5f9}
    .num{text-align:right}
    .note-cell{word-break:break-word}
    .lot-group-title{font-size:13px;margin:14px 0 6px}
    .lot-group-title:first-of-type{margin-top:4px}
    .grouped-lot-table{width:100%;border-collapse:collapse;margin-top:6px;margin-bottom:12px;table-layout:fixed}
    .grouped-lot-table th,.grouped-lot-table td{border:1px solid #333;padding:6px 7px;font-size:11.5px;vertical-align:middle}
    .grouped-lot-table th{text-align:center;background:#f1f5f9;font-weight:700}
    .grouped-lot-table .lot-cell{width:18%;vertical-align:top}
    .grouped-lot-table .attr-cell{min-width:72px}
    .grouped-lot-table .lot-total-cell{text-align:right;vertical-align:middle}
    .summary{width:72mm;margin-left:auto;margin-top:12px;font-size:13px}
    .summary div{display:flex;justify-content:space-between;padding:4px 0}
    .sign{display:grid;grid-template-columns:1fr 1fr 1fr;margin-top:28px;text-align:center;font-size:13px}
    .sign b{display:block;margin-bottom:46px}
    .print-actions{position:fixed;right:18px;top:18px;display:flex;gap:8px}
    .print-actions button{border:1px solid #1f2937;background:#fff;color:#111;padding:7px 12px;border-radius:3px;font-family:Arial,sans-serif;font-size:13px;cursor:pointer}
    @media print{body{background:#fff}.page{margin:0;width:auto;min-height:auto;padding:12mm}.no-print{display:none!important}}
  </style>
</head>
<body>
  <% if (!embeddedPrint) { %>
    <div class="print-actions no-print">
      <button type="button" onclick="window.print()">In</button>
      <button type="button" onclick="window.location.href = window.location.pathname.replace(/\/$/, '') + '/pdf'">Tải PDF</button>
      <button type="button" onclick="window.open(window.location.href, '_blank')">Mở riêng</button>
    </div>
  <% } %>
  <main class="page">
    <div class="store">
      <strong><%= store ? (store.ten_cua_hang || 'Cửa hàng') : 'Cửa hàng' %></strong><br>
      <%= store ? (store.dia_chi_day_du || '') : '' %> <%= store && store.sdt ? (' - ' + store.sdt) : '' %>
    </div>
    <h1>Phiếu nhập hàng</h1>
    <div style="text-align:center;font-size:13px">Mã phiếu: <strong><%= ticket.ma_phieu_nhap || '' %></strong></div>
    <section class="meta">
      <div>Ngày nhập: <strong><%= d(ticket.ngay_nhap) %></strong></div>
      <div>Kho nhập: <strong><%= warehouse.ten_kho || warehouse.ma_kho || '' %></strong></div>
      <div>Nhà cung cấp: <strong><%= supplier.ten_ncc || '' %></strong></div>
      <div>Mã NCC: <strong><%= supplier.ma_ncc || '' %></strong></div>
      <div>Người lập phiếu: <strong><%= ticket.nguoi_tao_id ? (ticket.nguoi_tao_id.ho_ten || ticket.nguoi_tao_id.email || '') : '' %></strong></div>
      <div>Ghi chú: <strong><%= ticket.ghi_chu || '' %></strong></div>
    </section>
    <% if (!printBundles.length) { %>
      <p style="margin-top:12px;font-size:13px">Không có chi tiết hàng.</p>
    <% } else { %>
      <% var sttCounter = 0; %>
      <% printBundles.forEach(function(block) { %>
        <div class="lot-group-title"><%= block.product_ma %> - <%= block.product_ten %></div>
        <table class="grouped-lot-table print-items-table">
          <thead>
            <tr>
              <th style="width:4%">STT</th>
              <th style="width:18%">Lô</th>
              <th style="width:11%">Thuộc tính</th>
              <th style="width:9%">Số lượng</th>
              <th style="width:10%">Đơn giá</th>
              <th style="width:8%">Giảm giá</th>
              <th style="width:11%">Thành tiền</th>
              <th style="width:11%">Tổng theo lô</th>
              <th style="width:18%">Ghi chú</th>
            </tr>
          </thead>
          <tbody>
            <% var n = block.displayRows.length; %>
            <% block.displayRows.forEach(function(dr, rowIndex) { %>
              <tr>
                <td class="num"><%= ++sttCounter %></td>
                <% if (rowIndex === 0) { %>
                  <td class="lot-cell" rowspan="<%= n %>"><%= block.lot_label %></td>
                <% } %>
                <td class="attr-cell"><%= dr.ten_thuoc_tinh %></td>
                <td class="num"><%= fmt(dr.so_luong) %></td>
                <td class="num"><%= fmt(dr.don_gia_nhap) %></td>
                <td class="num"><%= rowIndex === 0 ? (block.kieu_giam_gia_dong === 'percent' ? ((block.giam_gia_dong || 0) + '%') : fmt(block.giam_gia_dong)) : '' %></td>
                <td class="num"><%= fmt(dr.thanh_tien) %></td>
                <% if (rowIndex === 0) { %>
                  <td class="lot-total-cell num" rowspan="<%= n %>"><%= fmt(block.group_total) %></td>
                  <td class="note-cell" rowspan="<%= n %>"><%= block.ghi_chu_line || '' %></td>
                <% } %>
              </tr>
            <% }); %>
            <tr class="group-total-row">
              <td colspan="6" class="num">TỔNG CỘNG</td>
              <td class="num"><%= fmt(block.group_total) %></td>
              <td class="num"><%= fmt(block.group_total) %></td>
              <td></td>
            </tr>
          </tbody>
        </table>
      <% }); %>
    <% } %>
    <section class="summary">
      <div><span>Tổng tiền hàng</span><strong><%= fmt(ticket.tong_tien_hang) %> VND</strong></div>
      <div><span>Giảm giá</span><strong><%= ticket.kieu_giam_gia === 'percent' ? ((ticket.giam_gia || 0) + '%') : (fmt(ticket.giam_gia) + ' VND') %></strong></div>
      <div><span>Tổng tiền</span><strong><%= fmt(ticket.tong_tien) %> VND</strong></div>
      <div><span>Đã trả</span><strong><%= fmt(ticket.da_tra_ncc) %> VND</strong></div>
      <div><span>Còn nợ</span><strong><%= fmt(ticket.con_no_ncc) %> VND</strong></div>
    </section>
    <section class="sign">
      <div><b>Người lập phiếu</b>(Ký, ghi rõ họ tên)</div>
      <div><b>Nhà cung cấp</b>(Ký, ghi rõ họ tên)</div>
      <div><b>Thủ kho</b>(Ký, ghi rõ họ tên)</div>
    </section>
  </main>
</body>
</html>
