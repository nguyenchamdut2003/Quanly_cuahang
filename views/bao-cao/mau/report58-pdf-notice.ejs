<%
  const storeInfo = locals.storeInfo || {};
  const notes = Array.isArray(locals.notes) ? locals.notes.filter(Boolean) : [];
%>
<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <title><%= locals.mauSo || 'Báo cáo TT58' %></title>
  <style>
    @page{size:A4;margin:14mm 16mm}
    body{font-family:'Times New Roman',Times,serif;color:#000;margin:0;font-size:13pt;line-height:1.4}
    .head-grid{display:grid;grid-template-columns:1fr 230px;gap:12px;margin-bottom:10px}
    .unit-line{margin:2px 0}
    .mau-box{text-align:right;font-size:11pt}
    .mau-box .code{font-weight:700;font-size:12.5pt}
    .title-main{text-align:center;font-weight:700;font-size:15pt;text-transform:uppercase;margin:18px 0 6px}
    .period{text-align:center;font-size:12pt;margin-bottom:18px}
    .notice-box{border:1.5px dashed #555;padding:18px 20px;margin:24px 0;font-size:13pt}
    .notes{margin-top:18px;font-size:11.5pt;font-style:italic}
    .notes div{margin:3px 0}
  </style>
</head>
<body>
  <div class="head-grid">
    <div>
      <div class="unit-line"><strong>ĐƠN VỊ:</strong> <%= storeInfo.ten_cua_hang || '…………' %></div>
      <div class="unit-line"><strong>Địa chỉ:</strong> <%= storeInfo.dia_chi || '…………' %></div>
      <% if (storeInfo.ma_so_thue) { %><div class="unit-line"><strong>Mã số thuế:</strong> <%= storeInfo.ma_so_thue %></div><% } %>
      <% if (storeInfo.sdt) { %><div class="unit-line"><strong>Điện thoại:</strong> <%= storeInfo.sdt %></div><% } %>
    </div>
    <div class="mau-box">
      <div class="code"><%= locals.mauSo || '' %></div>
      <div>(Kèm theo Thông tư số 58/2026/TT-BTC</div>
      <div>ngày 25 tháng 5 năm 2026 của Bộ trưởng Bộ Tài chính)</div>
    </div>
  </div>

  <div class="title-main"><%= locals.title || '' %></div>
  <% if (locals.periodLabel) { %><div class="period"><%= locals.periodLabel %></div><% } %>

  <div class="notice-box"><%= locals.message || 'Không có dữ liệu hiển thị.' %></div>

  <% if (notes.length) { %>
  <div class="notes">
    <% notes.forEach(function(note) { %>
    <div>(*) <%= note %></div>
    <% }) %>
  </div>
  <% } %>
</body>
</html>
