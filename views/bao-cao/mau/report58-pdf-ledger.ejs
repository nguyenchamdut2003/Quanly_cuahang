<%
  const storeInfo = locals.storeInfo || {};
  const columns = Array.isArray(locals.columns) ? locals.columns : [];
  const rows = Array.isArray(locals.rows) ? locals.rows : [];
  const warnings = Array.isArray(locals.warnings) ? locals.warnings.filter(Boolean) : [];
  const notes = Array.isArray(locals.notes) ? locals.notes.filter(Boolean) : [];
  const landscape = locals.landscape === true;
%>
<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= locals.mauSo || 'Báo cáo TT58' %></title>
  <style>
    @page{size:A4 <%= landscape ? 'landscape' : 'portrait' %>;margin:10mm 10mm}
    body{font-family:'Times New Roman',Times,serif;color:#000;margin:0;font-size:<%= landscape ? '10.5pt' : '12pt' %>;line-height:1.35}
    .head-grid{display:grid;grid-template-columns:1fr 230px;gap:12px;margin-bottom:8px}
    .unit-line{margin:2px 0}
    .mau-box{text-align:right;font-size:10.5pt}
    .mau-box .code{font-weight:700;font-size:12pt}
    .title-main{text-align:center;font-weight:700;font-size:<%= landscape ? '13pt' : '14.5pt' %>;text-transform:uppercase;margin:10px 0 4px}
    .period{text-align:center;font-size:11pt;margin-bottom:4px}
    .unit-money{text-align:right;font-size:10.5pt;font-style:italic;margin-bottom:6px}
    table.form-table{width:100%;border-collapse:collapse;table-layout:fixed}
    table.form-table th,table.form-table td{border:1px solid #000;padding:3px 5px;vertical-align:middle;font-size:<%= landscape ? '9.5pt' : '10.5pt' %>;word-wrap:break-word}
    table.form-table th{text-align:center;font-weight:700}
    td.right{text-align:right;white-space:nowrap}
    td.center{text-align:center}
    td.bold{font-weight:700}
    tr.row-total td, tr.row-opening td, tr.row-closing td{font-weight:700}
    tr.row-section td{font-weight:700;background:#f2f2f2;border-left:1px solid #000}
    .warning-box{border:1.5px solid #000;padding:8px 10px;margin:10px 0 0;font-size:10.5pt;font-weight:700}
    .notes{margin-top:10px;font-size:10pt;font-style:italic}
    .notes div{margin:2px 0}
    .sign-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:14px;margin-top:24px;text-align:center;font-size:11pt;page-break-inside:avoid}
    .sign-grid .role{font-weight:700;text-transform:uppercase;margin-bottom:52px}
    .sign-grid .hint{font-style:italic;font-size:10pt}
    .sign-date{grid-column:3;text-align:center;font-style:italic;margin-bottom:4px}
  </style>
</head>
<body>
  <div class="head-grid">
    <div>
      <div class="unit-line"><strong>ĐƠN VỊ:</strong> <%= storeInfo.ten_cua_hang || '…………' %></div>
      <div class="unit-line"><strong>Địa chỉ:</strong> <%= storeInfo.dia_chi || '…………' %></div>
      <% if (storeInfo.ma_so_thue) { %><div class="unit-line"><strong>Mã số thuế:</strong> <%= storeInfo.ma_so_thue %></div><% } %>
      <% if (storeInfo.sdt) { %><div class="unit-line"><strong>Điện thoại:</strong> <%= storeInfo.sdt %></div><% } %>
    </div>
    <div class="mau-box">
      <div class="code"><%= locals.mauSo || '' %></div>
      <div>(Kèm theo Thông tư số 58/2026/TT-BTC</div>
      <div>ngày 25 tháng 5 năm 2026 của Bộ trưởng Bộ Tài chính)</div>
    </div>
  </div>

  <div class="title-main"><%= locals.title || '' %></div>
  <% if (locals.periodLabel) { %><div class="period"><%= locals.periodLabel %></div><% } %>
  <div class="unit-money">Đơn vị tính: <%= locals.donViTinh || 'Đồng' %></div>

  <table class="form-table">
    <% if (columns.length) { %>
    <colgroup>
      <% columns.forEach(function(col) { %><col style="width:<%= col.width || 'auto' %>"><% }) %>
    </colgroup>
    <thead>
      <tr>
        <% columns.forEach(function(col) { %><th><%= col.label %></th><% }) %>
      </tr>
    </thead>
    <% } %>
    <tbody>
      <% rows.forEach(function(row) {
        const kind = row.kind || 'data';
      %>
      <tr class="row-<%= kind %>">
        <% (row.cells || []).forEach(function(cell) {
          const c = (cell && typeof cell === 'object') ? cell : { text: cell };
          const classes = [
            c.align === 'right' ? 'right' : (c.align === 'center' ? 'center' : ''),
            c.bold ? 'bold' : ''
          ].filter(Boolean).join(' ');
        %>
        <td colspan="<%= c.colSpan || 1 %>" class="<%= classes %>"><%= c.text == null ? '' : c.text %></td>
        <% }) %>
      </tr>
      <% }) %>
      <% if (!rows.length) { %>
      <tr><td colspan="<%= columns.length || 1 %>" class="center">Không có dữ liệu trong kỳ báo cáo.</td></tr>
      <% } %>
    </tbody>
  </table>

  <% warnings.forEach(function(message) { %>
  <div class="warning-box">⚠ <%= message %></div>
  <% }) %>

  <% if (notes.length) { %>
  <div class="notes">
    <% notes.forEach(function(note) { %>
    <div>(*) <%= note %></div>
    <% }) %>
  </div>
  <% } %>

  <div class="sign-grid">
    <div>
      <div class="role">Người lập biểu</div>
      <div class="hint">(Ký, ghi rõ họ tên)</div>
    </div>
    <div>
      <div class="role">Kế toán trưởng</div>
      <div class="hint">(Ký, ghi rõ họ tên)</div>
    </div>
    <div>
      <div class="sign-date">Ngày …… tháng …… năm ……</div>
      <div class="role">Người đại diện theo pháp luật</div>
      <div class="hint">(Ký, ghi rõ họ tên, đóng dấu)</div>
    </div>
  </div>
</body>
</html>
