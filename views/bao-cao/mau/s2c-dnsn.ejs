<%
  const store = locals.store || {};
  const range = locals.range || {};
  const donViTinh = locals.donViTinh || 'Đồng';
  const storeName = locals.storeName || store.ten_cua_hang || '';
  const storeAddress = locals.storeAddress || store.dia_chi_day_du || [
    store.dia_chi_chi_tiet,
    store.phuong_xa,
    store.tinh_thanh
  ].filter(Boolean).join(', ');
  const embedded = locals.embedded === true;
  const standalone = locals.standalone === true;
  const storeTaxCode = locals.storeTaxCode || store.ma_so_thue || '';
  const storePhone = locals.storePhone || store.sdt || '';
  const formNotes = Array.isArray(locals.notes) ? locals.notes.filter(Boolean) : [];
  const blank = '…………';
  const tenHang = locals.tenHang || blank;
  const tenKho = locals.tenKho || blank;
  const donViTinhHang = locals.donViTinhLabel || '';
  const detailRows = Array.isArray(locals.detailRows) ? locals.detailRows : [];
  const opening = locals.opening || { qty: 0, value: 0 };
  const periodIn = locals.periodIn || { qty: 0, value: 0 };
  const periodOut = locals.periodOut || { qty: 0, value: 0 };
  const closing = locals.closing || { qty: 0, value: 0 };
  const missingFilters = locals.missingFilters === true;
  const fmtMoney = value => value === '' || value === null || value === undefined
    ? ''
    : Number(value).toLocaleString('vi-VN');
  const fmtQty = value => {
    if (value === '' || value === null || value === undefined) return '';
    const num = Number(value);
    if (!Number.isFinite(num)) return String(value);
    if (Number.isInteger(num)) return String(num);
    return num.toLocaleString('vi-VN', { maximumFractionDigits: 3 });
  };
  const fmtUnitPrice = value => {
    if (value === '' || value === null || value === undefined) return '';
    const num = Number(value);
    if (!Number.isFinite(num)) return '';
    return num.toLocaleString('vi-VN', { maximumFractionDigits: 2 });
  };
  const formatRangeDate = value => {
    if (!value) return '—';
    const text = String(value);
    const date = new Date(text.length === 10 ? `${text}T00:00:00` : text);
    return Number.isNaN(date.getTime()) ? text : date.toLocaleDateString('vi-VN');
  };
%>
<% if (standalone) { %>
<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Mẫu số S2c-DNSN</title>
<% } %>
  <style>
    .s2c-form{font-family:'Times New Roman',Times,serif;font-size:11pt;color:#000;line-height:1.3}
    .s2c-form .head-grid{display:grid;grid-template-columns:1fr 240px;gap:10px;margin-bottom:6px}
    .s2c-form .unit-line{margin:2px 0}
    .s2c-form .mau-box{text-align:right;font-size:10pt}
    .s2c-form .mau-box .code{font-weight:700;font-size:11pt}
    .s2c-form .title-main{text-align:center;font-weight:700;font-size:13pt;text-transform:uppercase;margin:8px 0 6px}
    .s2c-form .meta-line{margin:3px 0;font-size:11pt}
    .s2c-form .meta-line strong{font-weight:700}
    .s2c-form .range-line{text-align:center;font-size:10.5pt;margin-bottom:8px}
    .s2c-form table.form-table{width:100%;border-collapse:collapse;table-layout:fixed}
    .s2c-form table.form-table th,.s2c-form table.form-table td{border:1px solid #000;padding:3px 4px;vertical-align:middle;font-size:9.5pt;word-wrap:break-word}
    .s2c-form table.form-table th{text-align:center;font-weight:700;background:#fff}
    .s2c-form .num{text-align:right;white-space:nowrap}
    .s2c-form .center{text-align:center}
    .s2c-form .mark-x{text-align:center;font-weight:700}
    .s2c-form .summary td{font-weight:700}
    .s2c-form .notice{border:1px dashed #666;padding:12px;margin:12px 0;font-size:11pt;color:#444}
    .s2c-form .sign-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;margin-top:22px;text-align:center;font-size:10.5pt}
    .s2c-form .sign-grid .role{font-weight:700;text-transform:uppercase;margin-bottom:48px}
    .s2c-form .sign-grid .hint{font-style:italic;font-size:10pt}
    .s2c-form .sign-date{text-align:right;margin-top:6px;font-style:italic;grid-column:3}
    <% if (standalone) { %>
    @page{size:A4 landscape;margin:10mm 8mm}
    body{margin:0;background:#fff}
    .page{width:277mm;min-height:190mm;margin:0 auto;padding:0;box-sizing:border-box}
    <% } %>
    <% if (embedded) { %>
    .s2c-form{font-size:10pt}
    <% } %>
  </style>
<% if (standalone) { %>
</head>
<body>
  <div class="page">
<% } %>
<div class="s2c-form">
  <div class="head-grid">
    <div>
      <div class="unit-line"><strong>ĐƠN VỊ:</strong> <%= storeName || blank %></div>
      <div class="unit-line"><strong>Địa chỉ:</strong> <%= storeAddress || blank %></div>
      <% if (storeTaxCode) { %><div class="unit-line"><strong>Mã số thuế:</strong> <%= storeTaxCode %></div><% } %>
      <% if (storePhone) { %><div class="unit-line"><strong>Điện thoại:</strong> <%= storePhone %></div><% } %>
    </div>
    <div class="mau-box">
      <div class="code">Mẫu số S2c-DNSN</div>
      <div>(Kèm theo Thông tư số 58/2026/TT-BTC</div>
      <div>ngày 25 tháng 5 năm 2026 của Bộ trưởng Bộ Tài chính)</div>
    </div>
  </div>

  <div class="title-main">Sổ chi tiết vật liệu, dụng cụ, sản phẩm, hàng hóa</div>
  <div class="meta-line"><strong>Tên vật liệu, dụng cụ, sản phẩm, hàng hóa:</strong> <%= tenHang %></div>
  <div class="meta-line"><strong>Kho:</strong> <%= tenKho %></div>
  <% if (range.from || range.to) { %>
  <div class="range-line">Kỳ báo cáo: <%= formatRangeDate(range.from) %> – <%= formatRangeDate(range.to) %> &nbsp;|&nbsp; <strong>Đơn vị tính tiền:</strong> <%= donViTinh %></div>
  <% } %>

  <% if (missingFilters) { %>
  <div class="notice">Chọn <strong>hàng hóa</strong> và <strong>kho</strong> trên màn hình báo cáo để lập sổ chi tiết theo mẫu S2c-DNSN.</div>
  <% } else { %>
  <table class="form-table">
    <thead>
      <tr>
        <th colspan="2">Hóa đơn, Chứng từ</th>
        <th rowspan="2">Diễn giải</th>
        <th rowspan="2">Đơn vị tính</th>
        <th rowspan="2">Đơn giá</th>
        <th colspan="2">Nhập</th>
        <th colspan="2">Xuất</th>
        <th colspan="2">Tồn</th>
        <th rowspan="2">Ghi chú</th>
      </tr>
      <tr>
        <th>Số hiệu</th>
        <th>Ngày, tháng</th>
        <th>Số lượng</th>
        <th>Thành tiền</th>
        <th>Số lượng</th>
        <th>Thành tiền</th>
        <th>Số lượng</th>
        <th>Thành tiền</th>
      </tr>
      <tr>
        <th class="center">A</th>
        <th class="center">B</th>
        <th class="center">C</th>
        <th class="center">D</th>
        <th class="center">1</th>
        <th class="center">2</th>
        <th class="center">3</th>
        <th class="center">4</th>
        <th class="center">5</th>
        <th class="center">6</th>
        <th class="center">7</th>
        <th class="center">8</th>
      </tr>
    </thead>
    <tbody>
      <tr class="summary">
        <td></td>
        <td></td>
        <td>Số dư đầu kỳ</td>
        <td class="mark-x">X</td>
        <td class="mark-x">X</td>
        <td></td>
        <td></td>
        <td></td>
        <td></td>
        <td class="num"><%= fmtQty(opening.qty) %></td>
        <td class="num"><%= fmtMoney(opening.value) %></td>
        <td class="mark-x">X</td>
      </tr>
      <% detailRows.forEach(function(row) { %>
      <tr>
        <td><%= row.so_hieu || '' %></td>
        <td class="center"><%= row.ngay_thang || '' %></td>
        <td><%= row.dien_giai || '' %></td>
        <td class="center"><%= donViTinhHang %></td>
        <td class="num"><%= fmtUnitPrice(row.don_gia) %></td>
        <td class="num"><%= fmtQty(row.nhap_sl) %></td>
        <td class="num"><%= fmtMoney(row.nhap_tien) %></td>
        <td class="num"><%= fmtQty(row.xuat_sl) %></td>
        <td class="num"><%= fmtMoney(row.xuat_tien) %></td>
        <td class="num"><%= fmtQty(row.ton_sl) %></td>
        <td class="num"><%= fmtMoney(row.ton_tien) %></td>
        <td><%= row.ghi_chu || '' %></td>
      </tr>
      <% }) %>
      <tr class="summary">
        <td></td>
        <td></td>
        <td>Cộng phát sinh trong kỳ</td>
        <td class="mark-x">X</td>
        <td class="mark-x">X</td>
        <td class="num"><%= fmtQty(periodIn.qty) %></td>
        <td class="num"><%= fmtMoney(periodIn.value) %></td>
        <td class="num"><%= fmtQty(periodOut.qty) %></td>
        <td class="num"><%= fmtMoney(periodOut.value) %></td>
        <td></td>
        <td></td>
        <td class="mark-x">X</td>
      </tr>
      <tr class="summary">
        <td></td>
        <td></td>
        <td>Số dư cuối kỳ</td>
        <td class="mark-x">X</td>
        <td class="mark-x">X</td>
        <td></td>
        <td></td>
        <td></td>
        <td></td>
        <td class="num"><%= fmtQty(closing.qty) %></td>
        <td class="num"><%= fmtMoney(closing.value) %></td>
        <td class="mark-x">X</td>
      </tr>
    </tbody>
  </table>
  <% } %>

  <% if (formNotes.length) { %>
  <div style="margin-top:8px;font-size:9.5pt;font-style:italic">
    <% formNotes.forEach(function(note) { %>
    <div style="margin:2px 0">(*) <%= note %></div>
    <% }) %>
  </div>
  <% } %>

  <div class="sign-grid">
    <div>
      <div class="role">Người lập biểu</div>
      <div class="hint">(Ký, ghi rõ họ tên)</div>
    </div>
    <div>
      <div class="role">Kế toán trưởng</div>
      <div class="hint">(Ký, ghi rõ họ tên)</div>
    </div>
    <div>
      <div class="sign-date">Ngày …… tháng …… năm ……</div>
      <div class="role">Người đại diện theo pháp luật</div>
      <div class="hint">(Ký, ghi rõ họ tên, đóng dấu)</div>
    </div>
  </div>
</div>
<% if (standalone) { %>
  </div>
</body>
</html>
<% } %>
