<%
  const model = locals.preview || {};
  const rows = Array.isArray(model.rows) ? model.rows : [];
  const colWidths = Array.isArray(model.colWidths) ? model.colWidths : [];
  const mau = locals.mau || model.sheetName || '';
  const landscape = locals.landscape === true;
%>
<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= mau %> — TT58</title>
  <style>
    *{box-sizing:border-box}
    @page{
      size: A4 <%= landscape ? 'landscape' : 'portrait' %>;
      margin: 10mm 8mm;
    }
    body{
      font-family:'Times New Roman',Times,serif;
      margin:0;
      padding:0;
      color:#000;
      font-size:<%= landscape ? '10pt' : '11pt' %>;
      background:#fff;
    }
    .sheet-wrap{padding:0}
    table.excel-grid{
      border-collapse:collapse;
      table-layout:fixed;
      width:100%;
      background:#fff;
    }
    table.excel-grid td{
      border:1px solid #000;
      padding:3px 6px;
      vertical-align:middle;
      line-height:1.3;
      word-break:break-word;
    }
    table.excel-grid td.bold{font-weight:700}
    table.excel-grid td.italic{font-style:italic}
    table.excel-grid td.center{text-align:center}
    table.excel-grid td.right{text-align:right}
    table.excel-grid td.wrap{white-space:pre-wrap}
    table.excel-grid tr.col-header td{font-weight:700;text-align:center}
    table.excel-grid tr.total-row td{font-weight:700}
    .empty{padding:24px;text-align:center;color:#64748b}
  </style>
</head>
<body>
  <div class="sheet-wrap">
    <% if (!rows.length) { %>
      <div class="empty">Không có dữ liệu hiển thị cho mẫu <%= mau %>.</div>
    <% } else { %>
      <table class="excel-grid">
        <% if (colWidths.length) { %>
          <colgroup>
            <% colWidths.forEach(w => { %><col style="width:<%= w %>px"><% }) %>
          </colgroup>
        <% } %>
        <tbody>
          <% rows.forEach(row => {
            const firstText = String(row.cells[0] && row.cells[0].text || '').toLowerCase();
            const rowClass = row.rowNumber <= 4
              ? 'head-block'
              : (row.rowNumber === 6 || row.rowNumber === 13 ? 'col-header'
                : (firstText.includes('tổng cộng') ? 'total-row' : 'data-row'));
          %>
            <tr class="<%= rowClass %>">
              <% row.cells.forEach(cell => { %>
                <td
                  colspan="<%= cell.colSpan || 1 %>"
                  rowspan="<%= cell.rowSpan || 1 %>"
                  class="<%= [
                    cell.bold ? 'bold' : '',
                    cell.italic ? 'italic' : '',
                    cell.align === 'center' ? 'center' : (cell.align === 'right' ? 'right' : ''),
                    cell.wrap ? 'wrap' : ''
                  ].filter(Boolean).join(' ') %>"
                ><%= cell.text %></td>
              <% }) %>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </div>
</body>
</html>
