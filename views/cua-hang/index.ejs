<!doctype html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Cửa hàng</title>
  <link rel="stylesheet" href="/stylesheets/style.css">
  <link rel="stylesheet" href="/stylesheets/buttons.css">
  <link rel="stylesheet" href="/stylesheets/responsive.css">
  <style>
    .store-import-wrap{position:relative;display:inline-flex}
    .store-import-menu{position:absolute;top:calc(100% + 6px);right:0;min-width:180px;display:none;z-index:20;border:1px solid #d0d5dd;border-radius:8px;background:#fff;box-shadow:0 14px 30px rgba(16,24,40,.15);overflow:hidden}
    .store-import-menu.is-open{display:block}
    .store-import-menu button,.store-import-menu a{display:block;width:100%;border:0;background:#fff;text-align:left;padding:10px 14px;font-size:13px;color:#111827;text-decoration:none;cursor:pointer}
    .store-import-menu button:hover,.store-import-menu a:hover{background:#f8fafc}
    .store-import-menu button + button,.store-import-menu a + button{border-top:1px solid #f2f4f7}
    .store-pagination{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:12px 14px;border-top:1px solid #e5e7eb;background:#fff;color:#475467;font-size:14px}
    .store-pagination__actions{display:flex;align-items:center;gap:6px;flex-wrap:wrap}
    .store-page-link{min-width:34px;height:34px;border:1px solid #d0d5dd;border-radius:6px;background:#fff;color:#344054;text-decoration:none;display:inline-flex;align-items:center;justify-content:center;padding:0 10px;font-weight:700}
    .store-page-link.is-active{background:#0070f4;border-color:#0070f4;color:#fff}
    .store-page-link.is-disabled{pointer-events:none;opacity:.45}
  </style>
</head>
<body class="admin-body">
  <%- include('../partials/header', { activeMenu: activeMenu, user: user }) %>

  <main class="admin-shell store-page">
    <%- include('../partials/flash-message', { flash: flash }) %>

    <div id="addStoreModalOverlay" class="modal-overlay" data-auto-open="<%= formMode === 'create' ? '1' : '0' %>">
      <div class="modal-content store-create-modal">
        <div class="modal-header">
          <h3>Tạo cửa hàng</h3>
          <button type="button" class="modal-close" id="addStoreModalClose">×</button>
        </div>
        <form class="modal-body store-form-grid" method="post" action="/cua-hang/add" id="storeCreateForm">
          <label>
            <span>Mã cửa hàng</span>
            <input name="ma_cua_hang" placeholder="Tự động nếu bỏ trống">
          </label>
          <label>
            <span>Tên cửa hàng *</span>
            <input name="ten_cua_hang" required>
          </label>
          <label>
            <span>Mã số thuế</span>
            <input name="ma_so_thue">
          </label>
          <label>
            <span>Điện thoại</span>
            <input name="sdt">
          </label>
          <label>
            <span>Email</span>
            <input name="email" type="email">
          </label>
          <label class="span-2">
            <span>Địa chỉ chi tiết</span>
            <input name="dia_chi_chi_tiet">
          </label>
          <label>
            <span>Phường/xã</span>
            <select class="js-ghn-ward" name="phuong_xa" data-selected-name="">
              <option value="">Chọn phường/xã</option>
            </select>
            <input type="hidden" name="phuong_xa_code" class="js-ghn-ward-code">
          </label>
          <label>
            <span>Tỉnh/thành</span>
            <select class="js-ghn-province" name="tinh_thanh" data-selected-name="">
              <option value="">Chọn tỉnh/thành</option>
            </select>
            <input type="hidden" name="tinh_thanh_id" class="js-ghn-province-id">
          </label>
          <label>
            <span>Trạng thái</span>
            <select name="trang_thai">
              <option value="active" selected>Đang hoạt động</option>
              <option value="inactive">Ngừng hoạt động</option>
            </select>
          </label>
        </form>
        <div class="page-actions modal-footer">
          <button class="btn btn-light" type="button" id="addStoreModalCancel">Bỏ qua</button>
          <button class="btn btn-primary" type="submit" form="storeCreateForm">Tạo cửa hàng</button>
        </div>
      </div>
    </div>

    <div class="store-toolbar">
      <h1>Cửa hàng</h1>
      <div class="store-search">
        <span>⌕</span>
        <input type="search" id="storeKeywordSearch" name="keyword" form="storeFilterForm" value="<%= filter.keyword || '' %>" placeholder="Theo mã, tên cửa hàng" aria-label="Tìm theo mã, tên cửa hàng">
      </div>
      <div class="page-actions">
        <button class="btn btn-primary" type="button" id="openAddStoreModal">+ Tạo mới</button>
        <div class="store-import-wrap">
          <button class="btn btn-light" type="button" id="storeImportToggle" aria-haspopup="true" aria-expanded="false">Thêm bằng file ▾</button>
          <div class="store-import-menu" id="storeImportMenu" role="menu" aria-label="Thêm bằng file">
            <a href="/cua-hang/import/template.xlsx" role="menuitem">Lấy file mẫu</a>
            <button type="button" id="storeImportPickBtn" role="menuitem">Thêm</button>
          </div>
        </div>
        <form id="storeImportForm" method="post" action="/cua-hang/import" enctype="multipart/form-data" hidden>
          <input type="file" name="file" id="storeImportFile" accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet">
        </form>
        <a class="btn btn-light" href="/cua-hang/export.xlsx<%= filterQueryString ? '?' + filterQueryString : '' %>">Xuất file</a>
      </div>
    </div>

    <% if (formMode === 'edit') { %>
      <section class="store-form-panel">
        <div class="store-form-heading">
          <div>
            <h2><%= formMode === 'edit' ? 'Cập nhật cửa hàng' : 'Tạo cửa hàng' %></h2>
            <p>Nhập thông tin cơ bản của cửa hàng.</p>
          </div>
          <a class="link-button" href="/cua-hang">Hủy</a>
        </div>

        <% var formStore = editingStore || {}; %>
        <form class="store-form-grid" method="post" action="<%= formMode === 'edit' ? '/cua-hang/' + editingStore._id + '/update' : '/cua-hang/add' %>">
          <label>
            <span>Mã cửa hàng</span>
            <input name="ma_cua_hang" value="<%= formStore.ma_cua_hang || '' %>" placeholder="Tự động nếu bỏ trống">
          </label>
          <label>
            <span>Tên cửa hàng *</span>
            <input name="ten_cua_hang" value="<%= formStore.ten_cua_hang || '' %>" required>
          </label>
          <label>
            <span>Mã số thuế</span>
            <input name="ma_so_thue" value="<%= formStore.ma_so_thue || '' %>">
          </label>
          <label>
            <span>Điện thoại</span>
            <input name="sdt" value="<%= formStore.sdt || '' %>">
          </label>
          <label>
            <span>Email</span>
            <input name="email" value="<%= formStore.email || '' %>" type="email">
          </label>
          <label class="span-2">
            <span>Địa chỉ chi tiết</span>
            <input name="dia_chi_chi_tiet" value="<%= formStore.dia_chi_chi_tiet || '' %>">
          </label>
          <label>
            <span>Phường/xã</span>
            <select class="js-ghn-ward" name="phuong_xa" data-selected-id="<%= formStore.phuong_xa_code || '' %>" data-selected-name="<%= formStore.phuong_xa || '' %>">
              <% if (formStore.phuong_xa) { %>
                <option value="<%= formStore.phuong_xa %>" selected><%= formStore.phuong_xa %></option>
              <% } else { %>
                <option value="">Chọn phường/xã</option>
              <% } %>
            </select>
            <input type="hidden" name="phuong_xa_code" class="js-ghn-ward-code" value="<%= formStore.phuong_xa_code || '' %>">
          </label>
          <label>
            <span>Tỉnh/thành</span>
            <select class="js-ghn-province" name="tinh_thanh" data-selected-id="<%= formStore.tinh_thanh_id || '' %>" data-selected-name="<%= formStore.tinh_thanh || '' %>">
              <% if (formStore.tinh_thanh) { %>
                <option value="<%= formStore.tinh_thanh %>" selected><%= formStore.tinh_thanh %></option>
              <% } else { %>
                <option value="">Chọn tỉnh/thành</option>
              <% } %>
            </select>
            <input type="hidden" name="tinh_thanh_id" class="js-ghn-province-id" value="<%= formStore.tinh_thanh_id || '' %>">
          </label>
          <label>
            <span>Trạng thái</span>
            <select name="trang_thai">
              <option value="active" <%= formStore.trang_thai !== 'inactive' ? 'selected' : '' %>>Đang hoạt động</option>
              <option value="inactive" <%= formStore.trang_thai === 'inactive' ? 'selected' : '' %>>Ngừng hoạt động</option>
            </select>
          </label>
          <div class="store-form-actions">
            <button class="btn btn-primary" type="submit"><%= formMode === 'edit' ? 'Lưu thay đổi' : 'Tạo cửa hàng' %></button>
            <a class="btn btn-light" href="/cua-hang">Hủy</a>
          </div>
        </form>
      </section>
    <% } %>

    <%
      var filterQueryPrefix = filterQueryString ? filterQueryString + '&' : '';
      var pageQueryString = filterQueryString || '';
      if (pagination && pagination.page > 1) {
        pageQueryString += (pageQueryString ? '&' : '') + 'page=' + encodeURIComponent(pagination.page);
      }
      function buildStorePageUrl(pageNumber) {
        var parts = [];
        if (filterQueryString) parts.push(filterQueryString);
        if (pageNumber > 1) parts.push('page=' + encodeURIComponent(pageNumber));
        return '/cua-hang' + (parts.length ? '?' + parts.join('&') : '');
      }
    %>
    <div class="store-layout">
      <aside class="store-filter-panel">
        <form method="get" action="/cua-hang" id="storeFilterForm" class="store-filter-form">
          <div class="filter-heading">
            <h3>Bộ lọc</h3>
            <div class="filter-heading-actions">
              <button class="btn btn-primary btn-sm" type="submit">Áp dụng</button>
              <a class="filter-reset" href="/cua-hang">Xóa lọc</a>
            </div>
          </div>

          <section class="filter-group">
            <h4>Trạng thái</h4>
            <select name="status">
              <option value="all" <%= filter.status === 'all' ? 'selected' : '' %>>Tất cả</option>
              <option value="active" <%= filter.status === 'active' ? 'selected' : '' %>>Đang hoạt động</option>
              <option value="inactive" <%= filter.status === 'inactive' ? 'selected' : '' %>>Ngưng hoạt động</option>
            </select>
          </section>

          <section class="filter-group">
            <h4>Tỉnh/thành</h4>
            <% var selectedCityLabel = filter.city && filter.city !== 'all' ? filter.city : 'Tất cả tỉnh/thành'; %>
            <div class="group-manage-wrapper">
              <div class="group-manage-header">
                <button class="group-manage-trigger" type="button" id="storeCityFilterTrigger">
                  <span id="storeCityFilterLabel"><%= selectedCityLabel %></span>
                  <span>▾</span>
                </button>
              </div>
              <input type="hidden" name="city" id="storeCityFilterValue" value="<%= filter.city || 'all' %>">
              <div class="group-manage-dropdown" id="storeCityFilterDropdown">
                <div class="group-manage-item <%= (!filter.city || filter.city === 'all') ? 'is-active' : '' %>" data-value="all" data-name="Tất cả tỉnh/thành">
                  <button class="group-manage-option" type="button">Tất cả tỉnh/thành</button>
                </div>
                <% provinceOptions.forEach(function(city) { %>
                  <div class="group-manage-item <%= filter.city === city ? 'is-active' : '' %>" data-value="<%= city %>" data-name="<%= city %>">
                    <button class="group-manage-option" type="button"><%= city %></button>
                  </div>
                <% }) %>
              </div>
            </div>
          </section>

          <section class="filter-group">
            <h4>Số lượng kho</h4>
            <select name="warehouse">
              <option value="all" <%= filter.warehouse === 'all' ? 'selected' : '' %>>Tất cả</option>
              <option value="none" <%= filter.warehouse === 'none' ? 'selected' : '' %>>Chưa có kho</option>
              <option value="has" <%= filter.warehouse === 'has' ? 'selected' : '' %>>Có kho</option>
              <option value="gte1" <%= filter.warehouse === 'gte1' ? 'selected' : '' %>>Từ 1 kho trở lên</option>
              <option value="gte2" <%= filter.warehouse === 'gte2' ? 'selected' : '' %>>Từ 2 kho trở lên</option>
            </select>
          </section>

          <section class="filter-group">
            <h4>Thời gian tạo</h4>
            <select name="created" id="createdFilterSelect">
              <option value="all" <%= filter.created === 'all' ? 'selected' : '' %>>Toàn thời gian</option>
              <option value="today" <%= filter.created === 'today' ? 'selected' : '' %>>Hôm nay</option>
              <option value="7days" <%= filter.created === '7days' ? 'selected' : '' %>>7 ngày qua</option>
              <option value="30days" <%= filter.created === '30days' ? 'selected' : '' %>>30 ngày qua</option>
              <option value="custom" <%= filter.created === 'custom' ? 'selected' : '' %>>Tùy chỉnh</option>
            </select>
            <div class="custom-date-range <%= filter.created === 'custom' ? 'is-visible' : '' %>" id="customDateRange">
              <label>
                <span>Từ ngày</span>
                <input type="date" name="createdFrom" value="<%= filter.createdFrom || '' %>">
              </label>
              <label>
                <span>Đến ngày</span>
                <input type="date" name="createdTo" value="<%= filter.createdTo || '' %>">
              </label>
            </div>
          </section>

        </form>
      </aside>

      <section class="store-table-panel">
        <div class="table-wrap">
          <table class="admin-table store-table" data-kv-master="cua-hang">
            <thead>
              <tr>
                  <th>Mã cửa hàng</th>
                  <th>Tên cửa hàng</th>
                  <th>Mã số thuế</th>
                  <th>Điện thoại</th>
                <th>Email</th>
                <th>Kho</th>
                <th>Trạng thái</th>
                <th>Thời gian tạo</th>
              </tr>
            </thead>
            <tbody>
              <% if (stores.length === 0) { %>
                <tr>
                  <td colspan="8" class="empty-cell">Không có cửa hàng phù hợp với bộ lọc.</td>
                </tr>
              <% } %>
              <% stores.forEach(function(store) { %>
                <tr class="store-list-row" data-kv-detail-id="<%= store._id %>">
                  <td><a class="table-code-link kv-detail-code-link" href="/cua-hang"><%= store.ma_cua_hang || '---' %></a></td>
                  <td><strong><%= store.ten_cua_hang || '---' %></strong><div class="muted-line"><%= store.dia_chi_day_du || store.dia_chi || 'Chưa có địa chỉ' %></div></td>
                  <td><%= store.ma_so_thue || '---' %></td>
                  <td><%= store.sdt || '---' %></td>
                  <td><%= store.email || '---' %></td>
                  <td><span class="store-warehouse-count" data-store-id="<%= store._id %>">...</span></td>
                  <td>
                    <span class="status-pill <%= store.trang_thai === 'active' ? 'is-active' : '' %>">
                      <%= store.trang_thai === 'active' ? 'Đang hoạt động' : 'Ngừng hoạt động' %>
                    </span>
                  </td>
                  <td><%= formatDate(store.created_at) %></td>
                </tr>

              <% }) %>
            </tbody>
          </table>
          <div id="storeDynamicFormsMount"></div>
          <% if (pagination && pagination.totalPages > 1) { %>
            <div class="store-pagination">
              <div>Hiển thị <strong><%= pagination.from %>-<%= pagination.to %></strong> / <strong><%= pagination.total %></strong> cửa hàng</div>
              <div class="store-pagination__actions" aria-label="Phân trang cửa hàng">
                <a class="store-page-link <%= pagination.page <= 1 ? 'is-disabled' : '' %>" href="<%= buildStorePageUrl(Math.max(1, pagination.page - 1)) %>">‹</a>
                <% for (var pageNumber = 1; pageNumber <= pagination.totalPages; pageNumber++) { %>
                  <a class="store-page-link <%= pageNumber === pagination.page ? 'is-active' : '' %>" href="<%= buildStorePageUrl(pageNumber) %>"><%= pageNumber %></a>
                <% } %>
                <a class="store-page-link <%= pagination.page >= pagination.totalPages ? 'is-disabled' : '' %>" href="<%= buildStorePageUrl(Math.min(pagination.totalPages, pagination.page + 1)) %>">›</a>
              </div>
            </div>
          <% } else if (pagination) { %>
            <div class="store-pagination">
              <div>Hiển thị <strong><%= pagination.from %>-<%= pagination.to %></strong> / <strong><%= pagination.total %></strong> cửa hàng</div>
            </div>
          <% } %>
        </div>
      </section>
    </div>
  </main>
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      var addStoreModalOverlay = document.getElementById('addStoreModalOverlay');
      var openAddStoreModalBtn = document.getElementById('openAddStoreModal');
      var addStoreModalClose = document.getElementById('addStoreModalClose');
      var addStoreModalCancel = document.getElementById('addStoreModalCancel');
      var storeCreateForm = document.getElementById('storeCreateForm');
      var ghnProvinceCache = null;
      var ghnProvincePromise = null;
      var ghnWardCache = {};
      var ghnWardPromiseCache = {};

      function normalizeText(value) {
        return String(value || '')
          .normalize('NFD')
          .replace(/[\u0300-\u036f]/g, '')
          .replace(/đ/g, 'd')
          .replace(/Đ/g, 'd')
          .trim()
          .toLowerCase();
      }

      function getFieldBlock(container, selector) {
        var field = container.querySelector(selector);
        if (!field) return null;
        return field.closest('label') || field.closest('div');
      }

      function orderAddressFields(container) {
        var provinceBlock = getFieldBlock(container, '.js-ghn-province');
        var wardBlock = getFieldBlock(container, '.js-ghn-ward');
        var detailBlock = getFieldBlock(container, '[name="dia_chi_chi_tiet"]');
        var statusBlock = getFieldBlock(container, '[name="trang_thai"]');
        if (!provinceBlock || !wardBlock || !detailBlock) return;
        container.insertBefore(provinceBlock, statusBlock || null);
        container.insertBefore(wardBlock, statusBlock || null);
        container.insertBefore(detailBlock, statusBlock || null);
      }

      function orderStoreAddressFields() {
        document.querySelectorAll('.store-form-grid, .store-fields').forEach(orderAddressFields);
      }

      function escapeHtml(value) {
        return String(value || '').replace(/[&<>"']/g, function(ch) {
          return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[ch];
        });
      }

      function enhanceAddressSelect(select, placeholder) {
        if (!select || select.getAttribute('data-combobox-bound') === '1') return;
        select.setAttribute('data-combobox-bound', '1');
        select.classList.add('address-native-select');

        var wrapper = document.createElement('div');
        wrapper.className = 'address-combobox';
        wrapper.innerHTML =
          '<input class="address-combobox-input" type="text" autocomplete="off">' +
          '<button class="address-combobox-toggle" type="button" aria-label="Mở danh sách">▾</button>' +
          '<div class="address-combobox-menu"></div>';
        select.parentNode.insertBefore(wrapper, select.nextSibling);

        var input = wrapper.querySelector('.address-combobox-input');
        var toggle = wrapper.querySelector('.address-combobox-toggle');
        var menu = wrapper.querySelector('.address-combobox-menu');
        input.placeholder = placeholder || '';

        function options() {
          return Array.prototype.slice.call(select.options).filter(function(option) { return option.value !== ''; });
        }

        function selectedOption() {
          return select.options[select.selectedIndex] || null;
        }

        function syncInput() {
          var option = selectedOption();
          input.value = option && option.value ? option.textContent : '';
        }

        function renderMenu() {
          var term = normalizeText(input.value);
          var rows = options().filter(function(option) {
            return !term || normalizeText(option.textContent).indexOf(term) !== -1 || normalizeText(option.value).indexOf(term) !== -1;
          }).slice(0, 80);
          menu.innerHTML = rows.length
            ? rows.map(function(option) {
              return '<button type="button" class="address-combobox-option" data-value="' + escapeHtml(option.value) + '">' + escapeHtml(option.textContent) + '</button>';
            }).join('')
            : '<div class="address-combobox-empty">Không có dữ liệu phù hợp</div>';
        }

        function openMenu() {
          renderMenu();
          wrapper.classList.add('is-open');
        }

        function closeMenu() {
          wrapper.classList.remove('is-open');
        }

        function choose(value) {
          select.value = value;
          syncInput();
          closeMenu();
          select.dispatchEvent(new Event('change', { bubbles: true }));
        }

        function chooseMatchingOption() {
          var term = normalizeText(input.value);
          if (!term) {
            if (select.value) choose('');
            return;
          }
          var matched = options().find(function(option) {
            return normalizeText(option.textContent) === term || normalizeText(option.value) === term;
          }) || options().find(function(option) {
            return normalizeText(option.textContent).indexOf(term) !== -1 || normalizeText(option.value).indexOf(term) !== -1;
          });
          if (matched && select.value !== matched.value) {
            choose(matched.value);
          }
        }

        input.addEventListener('focus', openMenu);
        input.addEventListener('input', openMenu);
        input.addEventListener('blur', function() {
          window.setTimeout(chooseMatchingOption, 120);
        });
        input.addEventListener('keydown', function(event) {
          if (event.key !== 'Enter') return;
          var firstOption = menu.querySelector('.address-combobox-option');
          event.preventDefault();
          if (firstOption) choose(firstOption.getAttribute('data-value') || '');
          else chooseMatchingOption();
        });
        toggle.addEventListener('click', function() {
          input.focus();
          wrapper.classList.toggle('is-open');
          if (wrapper.classList.contains('is-open')) renderMenu();
        });
        menu.addEventListener('mousedown', function(event) {
          event.preventDefault();
          var option = event.target.closest('.address-combobox-option');
          if (option) choose(option.getAttribute('data-value') || '');
        });
        document.addEventListener('click', function(event) {
          if (!wrapper.contains(event.target)) closeMenu();
        });

        select._addressComboboxRefresh = function() {
          syncInput();
          renderMenu();
        };
        syncInput();
      }

      function refreshAddressSelect(select) {
        if (select && typeof select._addressComboboxRefresh === 'function') {
          select._addressComboboxRefresh();
        }
      }

      function fetchAddressItems(url) {
        return fetch(url, { headers: { Accept: 'application/json' } })
          .then(function(response) { return response.json(); })
          .then(function(data) {
            if (!data || !data.success) throw new Error((data && data.message) || 'Không lấy được danh mục địa chỉ.');
            return Array.isArray(data.items) ? data.items : [];
          });
      }

      function fetchStoreJson(url) {
        return fetch(url, { headers: { Accept: 'application/json' } })
          .then(function(response) { return response.json(); })
          .then(function(data) {
            if (!data || !data.success) throw new Error((data && data.message) || 'Khong tai duoc du lieu cua hang.');
            return data;
          });
      }

      function loadWarehouseCounts() {
        var nodes = Array.prototype.slice.call(document.querySelectorAll('.store-warehouse-count'));
        var ids = nodes.map(function(node) { return node.getAttribute('data-store-id') || ''; }).filter(Boolean);
        if (!ids.length) return;
        fetchStoreJson('/cua-hang/api/warehouse-counts?ids=' + encodeURIComponent(ids.join(','))).then(function(data) {
          var counts = data.counts || {};
          nodes.forEach(function(node) {
            var id = node.getAttribute('data-store-id') || '';
            node.textContent = Number(counts[id] || 0);
          });
          document.querySelectorAll('.store-detail-warehouse-count').forEach(function(node) {
            var id = node.getAttribute('data-store-id') || '';
            node.textContent = Number(counts[id] || 0);
          });
        }).catch(function() {
          nodes.forEach(function(node) { node.textContent = '0'; });
          document.querySelectorAll('.store-detail-warehouse-count').forEach(function(node) { node.textContent = '0'; });
        });
      }

      function loadProvinceFilterOptions() {
        if (!storeCityFilterDropdown) return;
        fetchStoreJson('/cua-hang/api/province-options').then(function(data) {
          var items = Array.isArray(data.items) ? data.items : [];
          var currentValue = storeCityFilterValue ? String(storeCityFilterValue.value || 'all') : 'all';
          var base = storeCityFilterDropdown.querySelector('.group-manage-item[data-value="all"]');
          storeCityFilterDropdown.innerHTML = '';
          if (base) storeCityFilterDropdown.appendChild(base);
          items.forEach(function(city) {
            var row = document.createElement('div');
            row.className = 'group-manage-item' + (currentValue === city ? ' is-active' : '');
            row.setAttribute('data-value', city);
            row.setAttribute('data-name', city);
            row.innerHTML = '<button class="group-manage-option" type="button">' + escapeHtml(city) + '</button>';
            storeCityFilterDropdown.appendChild(row);
          });
          bindStoreCityFilterOptions();
        }).catch(function() {});
      }

      function getGhnProvinces() {
        if (ghnProvinceCache) return Promise.resolve(ghnProvinceCache);
        if (ghnProvincePromise) return ghnProvincePromise;
        ghnProvincePromise = fetchAddressItems('/api/address/provinces').then(function(items) {
          ghnProvinceCache = items;
          ghnProvincePromise = null;
          return items;
        }).catch(function(error) {
          ghnProvincePromise = null;
          throw error;
        });
        return ghnProvincePromise;
      }

      function getGhnWardsByProvince(provinceId) {
        if (!provinceId) return Promise.resolve([]);
        if (ghnWardCache[provinceId]) return Promise.resolve(ghnWardCache[provinceId]);
        if (ghnWardPromiseCache[provinceId]) return ghnWardPromiseCache[provinceId];
        ghnWardPromiseCache[provinceId] = fetchAddressItems('/api/address/wards-by-province?province_id=' + encodeURIComponent(provinceId)).then(function(items) {
          ghnWardCache[provinceId] = items;
          delete ghnWardPromiseCache[provinceId];
          return items;
        }).catch(function(error) {
          delete ghnWardPromiseCache[provinceId];
          throw error;
        });
        return ghnWardPromiseCache[provinceId];
      }

      function findByIdOrName(items, id, name, idKey, nameKey) {
        var selectedId = String(id || '');
        var selectedName = normalizeText(name);
        return items.find(function(item) { return selectedId && String(item[idKey]) === selectedId; })
          || items.find(function(item) { return selectedName && normalizeText(item[nameKey]) === selectedName; })
          || null;
      }

      function syncWardHidden(container, province, ward) {
        var provinceIdInput = container.querySelector('.js-ghn-province-id');
        var wardCodeInput = container.querySelector('.js-ghn-ward-code');
        if (provinceIdInput) provinceIdInput.value = province ? province.province_id : '';
        if (wardCodeInput) wardCodeInput.value = ward ? ward.ward_code : '';
      }

      function renderProvinceSelect(select, items) {
        var selected = findByIdOrName(items, select.getAttribute('data-selected-id'), select.getAttribute('data-selected-name') || select.value, 'province_id', 'province_name');
        var currentName = select.getAttribute('data-selected-name') || select.value || '';
        select.innerHTML = '<option value="">Chọn tỉnh/thành</option>' + items.map(function(item) {
          return '<option value="' + item.province_name.replace(/"/g, '&quot;') + '" data-id="' + item.province_id + '">' + item.province_name + '</option>';
        }).join('');
        if (selected) {
          select.value = selected.province_name;
          select.setAttribute('data-selected-id', selected.province_id);
          select.setAttribute('data-selected-name', selected.province_name);
        } else if (currentName) {
          select.innerHTML = '<option value="' + currentName.replace(/"/g, '&quot;') + '" selected>' + currentName + '</option>' + select.innerHTML;
          select.value = currentName;
        }
        refreshAddressSelect(select);
      }

      function renderWardSelect(select, items) {
        var selected = findByIdOrName(items, select.getAttribute('data-selected-id'), select.getAttribute('data-selected-name') || select.value, 'ward_code', 'ward_name');
        var currentName = select.getAttribute('data-selected-name') || select.value || '';
        select.innerHTML = '<option value="">Chọn phường/xã</option>' + items.map(function(item) {
          return '<option value="' + item.ward_name.replace(/"/g, '&quot;') + '" data-code="' + item.ward_code + '">' + item.ward_name + '</option>';
        }).join('');
        if (selected) {
          select.value = selected.ward_name;
          select.setAttribute('data-selected-id', selected.ward_code);
          select.setAttribute('data-selected-name', selected.ward_name);
        } else if (currentName) {
          select.innerHTML = '<option value="' + currentName.replace(/"/g, '&quot;') + '" selected>' + currentName + '</option>' + select.innerHTML;
          select.value = currentName;
        }
        refreshAddressSelect(select);
      }

      function selectedProvinceFromSelect(select) {
        var option = select.options[select.selectedIndex];
        return option && option.getAttribute('data-id')
          ? { province_id: option.getAttribute('data-id'), province_name: select.value }
          : null;
      }

      function selectedWardFromSelect(select) {
        if (!select) return null;
        var option = select.options[select.selectedIndex];
        return option && option.getAttribute('data-code')
          ? {
            ward_code: option.getAttribute('data-code'),
            ward_name: select.value
          }
          : null;
      }

      function initGhnAddressSelects(root) {
        var scope = root && root.querySelectorAll ? root : document;
        scope.querySelectorAll('.js-ghn-province').forEach(function(provinceSelect) {
          if (provinceSelect.getAttribute('data-ghn-address-bound') === '1') return;
          provinceSelect.setAttribute('data-ghn-address-bound', '1');
          var container = provinceSelect.closest('.warehouse-edit-row') || provinceSelect.closest('form') || provinceSelect.closest('.store-form-grid') || provinceSelect.closest('.store-fields') || document;
          var wardSelect = container.querySelector('.js-ghn-ward');
          if (wardSelect) wardSelect.setAttribute('data-ghn-address-bound', '1');
          enhanceAddressSelect(provinceSelect, 'Tìm hoặc chọn tỉnh/thành');
          enhanceAddressSelect(wardSelect, 'Tìm hoặc chọn phường/xã');

          getGhnProvinces().then(function(provinces) {
            renderProvinceSelect(provinceSelect, provinces);
            var province = selectedProvinceFromSelect(provinceSelect);
            syncWardHidden(container, province, selectedWardFromSelect(wardSelect));
            if (province && wardSelect) {
              return getGhnWardsByProvince(province.province_id).then(function(wards) {
                renderWardSelect(wardSelect, wards);
                syncWardHidden(container, province, selectedWardFromSelect(wardSelect));
              });
            }
          }).catch(function(error) {
            console.warn('[GHN_ADDRESS]', error && error.message ? error.message : error);
          });

          provinceSelect.addEventListener('change', function() {
            var province = selectedProvinceFromSelect(provinceSelect);
            if (wardSelect) {
              wardSelect.innerHTML = '<option value="">Chọn phường/xã</option>';
              wardSelect.value = '';
              wardSelect.setAttribute('data-selected-id', '');
              wardSelect.setAttribute('data-selected-name', '');
              refreshAddressSelect(wardSelect);
            }
            syncWardHidden(container, province, null);
            if (!province || !wardSelect) return;
            getGhnWardsByProvince(province.province_id).then(function(wards) {
              renderWardSelect(wardSelect, wards);
            }).catch(function(error) {
              console.warn('[GHN_ADDRESS]', error && error.message ? error.message : error);
            });
          });

          if (wardSelect) {
            wardSelect.addEventListener('change', function() {
              syncWardHidden(container, selectedProvinceFromSelect(provinceSelect), selectedWardFromSelect(wardSelect));
            });
          }
        });
      }

      function openAddStoreModal() {
        if (!addStoreModalOverlay) return;
        if (storeCreateForm) {
          storeCreateForm.reset();
          var createWardSelect = storeCreateForm.querySelector('.js-ghn-ward');
          if (createWardSelect) {
            createWardSelect.innerHTML = '<option value="">Chọn phường/xã</option>';
            createWardSelect.value = '';
          }
          storeCreateForm.querySelectorAll('.js-ghn-province, .js-ghn-ward').forEach(refreshAddressSelect);
        }
        addStoreModalOverlay.classList.add('is-visible');
        var nameInput = storeCreateForm ? storeCreateForm.querySelector('[name="ten_cua_hang"]') : null;
        if (nameInput) setTimeout(function() { nameInput.focus(); }, 50);
      }

      function closeAddStoreModal() {
        if (!addStoreModalOverlay) return;
        addStoreModalOverlay.classList.remove('is-visible');
      }

      if (openAddStoreModalBtn) openAddStoreModalBtn.addEventListener('click', openAddStoreModal);
      if (addStoreModalClose) addStoreModalClose.addEventListener('click', closeAddStoreModal);
      if (addStoreModalCancel) addStoreModalCancel.addEventListener('click', closeAddStoreModal);
      if (addStoreModalOverlay) {
        if (addStoreModalOverlay.getAttribute('data-auto-open') === '1') openAddStoreModal();
      }
      orderStoreAddressFields();
      initGhnAddressSelects();

      var createdFilterSelect = document.getElementById('createdFilterSelect');
      var customDateRange = document.getElementById('customDateRange');
      var storeCityFilterTrigger = document.getElementById('storeCityFilterTrigger');
      var storeCityFilterLabel = document.getElementById('storeCityFilterLabel');
      var storeCityFilterValue = document.getElementById('storeCityFilterValue');
      var storeCityFilterDropdown = document.getElementById('storeCityFilterDropdown');

      function toggleCustomDateRange() {
        if (!customDateRange) return;
        var isCustom = createdFilterSelect && createdFilterSelect.value === 'custom';
        customDateRange.classList.toggle('is-visible', isCustom);
      }

      if (createdFilterSelect) createdFilterSelect.addEventListener('change', toggleCustomDateRange);

      toggleCustomDateRange();

      var storeFilterForm = document.getElementById('storeFilterForm');
      var storeKeywordSearch = document.getElementById('storeKeywordSearch');
      if (storeFilterForm && storeKeywordSearch) {
        storeKeywordSearch.addEventListener('keydown', function (event) {
          if (event.key === 'Enter') {
            event.preventDefault();
            storeFilterForm.submit();
          }
        });
      }

      function bindStoreCityFilterOptions() {
        if (!storeCityFilterDropdown) return;
        Array.prototype.slice.call(storeCityFilterDropdown.querySelectorAll('.group-manage-item')).forEach(function (item) {
          var optionBtn = item.querySelector('.group-manage-option');
          if (!optionBtn) return;
          if (optionBtn.getAttribute('data-bound') === '1') return;
          optionBtn.setAttribute('data-bound', '1');
          optionBtn.addEventListener('click', function () {
            Array.prototype.slice.call(storeCityFilterDropdown.querySelectorAll('.group-manage-item')).forEach(function (node) {
              node.classList.remove('is-active');
            });
            item.classList.add('is-active');
            if (storeCityFilterValue) storeCityFilterValue.value = item.getAttribute('data-value') || 'all';
            if (storeCityFilterLabel) storeCityFilterLabel.textContent = item.getAttribute('data-name') || 'Tất cả tỉnh/thành';
            storeCityFilterDropdown.classList.remove('is-open');
          });
        });
      }

      if (storeCityFilterTrigger && storeCityFilterDropdown) {
        storeCityFilterTrigger.addEventListener('click', function () {
          storeCityFilterDropdown.classList.toggle('is-open');
        });
        bindStoreCityFilterOptions();
      }

      loadWarehouseCounts();
      loadProvinceFilterOptions();

      function ensureWarehouseDeleteActions(detailBlock) {
        var formsMount = document.getElementById('storeDynamicFormsMount');
        if (!detailBlock || !formsMount) return;

        detailBlock.querySelectorAll('.warehouse-edit-row:not(.warehouse-add-row)').forEach(function(row) {
          var updateInput = row.querySelector('[form^="warehouseForm_"]');
          if (!updateInput) return;

          var updateFormId = updateInput.getAttribute('form') || '';
          var warehouseId = updateFormId.replace(/^warehouseForm_/, '');
          if (!warehouseId) return;

          var buttons = row.querySelector('.warehouse-action-buttons');
          if (!buttons || buttons.querySelector('[data-warehouse-delete-action]')) return;

          var storeId = (detailBlock.getAttribute('data-store-id') || (detailBlock.querySelector('#storeWarehouseRows') || {}).dataset?.storeId || '').trim();
          if (!storeId) return;

          var deleteFormId = 'warehouseDeleteForm_' + warehouseId;
          if (!document.getElementById(deleteFormId)) {
            var form = document.createElement('form');
            form.id = deleteFormId;
            form.method = 'post';
            form.action = '/cua-hang/' + encodeURIComponent(storeId) + '/warehouse/' + encodeURIComponent(warehouseId) + '/delete';
            formsMount.appendChild(form);
          }

          var button = document.createElement('button');
          button.type = 'submit';
          button.className = 'btn btn-danger btn-sm';
          button.setAttribute('form', deleteFormId);
          button.setAttribute('data-warehouse-delete-action', '1');
          button.textContent = 'Xóa';
          button.addEventListener('click', function(event) {
            if (!confirm('Bạn có chắc muốn xóa kho này không?')) event.preventDefault();
          });
          buttons.appendChild(button);
        });
      }

      function bindStoreDetailPanel(detailBlock) {
        if (!detailBlock || detailBlock.getAttribute('data-store-detail-bound') === '1') return;
        detailBlock.setAttribute('data-store-detail-bound', '1');
        ensureWarehouseDeleteActions(detailBlock);
        var collapseBtn = detailBlock.querySelector('.detail-collapse-btn');
        var detailBody = detailBlock.querySelector('.store-detail-body');
        var tabs = Array.prototype.slice.call(detailBlock.querySelectorAll('.detail-tab'));
        var panes = Array.prototype.slice.call(detailBlock.querySelectorAll('.store-detail-pane'));
        var exportAction = detailBlock.querySelector('[data-store-export-action]');
        if (!collapseBtn || !detailBody) return;

        function syncStoreExportAction(target) {
          if (!exportAction || !target) return;
          var key = String(target || '').replace(/^store-/, '');
          var url = exportAction.getAttribute('data-store-' + key + '-url') || '#';
          var label = exportAction.getAttribute('data-store-' + key + '-label') || 'Xuất thông tin';
          var disabled = exportAction.getAttribute('data-store-' + key + '-disabled') === '1';
          exportAction.textContent = label;
          exportAction.href = disabled ? '#' : url;
          exportAction.classList.toggle('is-disabled', disabled);
          exportAction.setAttribute('aria-disabled', disabled ? 'true' : 'false');
        }

        syncStoreExportAction('store-info');

        tabs.forEach(function(tab) {
          tab.addEventListener('click', function(event) {
            event.stopPropagation();
            var target = tab.getAttribute('data-tab-target');
            tabs.forEach(function(node) {
              node.classList.toggle('is-active', node === tab);
            });
            panes.forEach(function(pane) {
              pane.classList.toggle('is-active', pane.getAttribute('data-tab-pane') === target);
            });
            syncStoreExportAction(target);
          });
        });

        if (exportAction) {
          exportAction.addEventListener('click', function(event) {
            if (exportAction.getAttribute('aria-disabled') === 'true') {
              event.preventDefault();
              alert('Không có dữ liệu để xuất');
            }
          });
        }
        collapseBtn.addEventListener('click', function () {
          var isCollapsed = detailBlock.classList.toggle('is-collapsed');
          collapseBtn.textContent = isCollapsed ? 'Mở rộng' : 'Thu gọn';
          collapseBtn.setAttribute('aria-expanded', isCollapsed ? 'false' : 'true');
        });
      }

      function StoreInlineDetail(table) {
        this.table = table;
        this.activeId = null;
        this.activeRow = null;
        this.detailRow = null;
        this.abortController = null;
        this.bind();
      }

      StoreInlineDetail.prototype.bind = function() {
        var self = this;
        if (!self.table) return;
        self.table.addEventListener('click', function(event) {
          var codeLink = event.target.closest('a.kv-detail-code-link');
          if (codeLink && self.table.contains(codeLink)) {
            event.preventDefault();
            var codeRow = codeLink.closest('tr[data-kv-detail-id]');
            if (codeRow) self.toggle(codeRow);
            return;
          }

          var row = event.target.closest('tr[data-kv-detail-id]');
          if (!row || !self.table.contains(row)) return;
          if (event.target.closest('a, button, input, select, textarea, label')) return;
          self.toggle(row);
        });
      };

      StoreInlineDetail.prototype.colspan = function() {
        var headerCells = this.table ? this.table.querySelectorAll('thead th') : [];
        return headerCells.length || 1;
      };

      StoreInlineDetail.prototype.close = function() {
        if (this.abortController) {
          this.abortController.abort();
          this.abortController = null;
        }
        var formsMount = document.getElementById('storeDynamicFormsMount');
        if (formsMount) formsMount.innerHTML = '';
        if (this.detailRow && this.detailRow.parentNode) {
          this.detailRow.parentNode.removeChild(this.detailRow);
        }
        if (this.activeRow) this.activeRow.classList.remove('is-selected');
        this.activeId = null;
        this.activeRow = null;
        this.detailRow = null;
      };

      StoreInlineDetail.prototype.toggle = function(row) {
        var id = row.getAttribute('data-kv-detail-id');
        if (!id) return;
        if (this.activeId === id && this.detailRow) {
          this.close();
          return;
        }
        this.open(row, id);
      };

      StoreInlineDetail.prototype.open = function(row, id) {
        var self = this;
        self.close();
        self.activeId = id;
        self.activeRow = row;
        row.classList.add('is-selected');

        var detailRow = document.createElement('tr');
        detailRow.className = 'store-detail-row kv-inline-detail-tr';
        var detailCell = document.createElement('td');
        detailCell.colSpan = self.colspan();
        detailCell.innerHTML = '<div class="kv-detail-panel product-detail kv-detail-loading"><p class="kv-detail-loading-text">Đang tải thông tin...</p></div>';
        detailRow.appendChild(detailCell);
        row.parentNode.insertBefore(detailRow, row.nextSibling);
        self.detailRow = detailRow;

        self.abortController = window.AbortController ? new AbortController() : null;
        fetch('/cua-hang/api/' + encodeURIComponent(id) + '/detail', {
          headers: {
            Accept: 'application/json',
            'X-Requested-With': 'XMLHttpRequest'
          },
          signal: self.abortController ? self.abortController.signal : undefined
        }).then(function(response) {
          return response.json().then(function(data) {
            if (!response.ok || !data || !data.success) {
              throw new Error((data && data.message) || 'Khong tai duoc thong tin cua hang.');
            }
            return data;
          });
        }).then(function(data) {
          if (self.activeId !== id || self.detailRow !== detailRow) return;
          detailCell.innerHTML = data.html || '<div class="store-detail-content">Khong co du lieu.</div>';
          var formsMount = document.getElementById('storeDynamicFormsMount');
          if (formsMount) formsMount.innerHTML = data.forms_html || '';
          bindStoreDetailPanel(detailCell.querySelector('.store-detail'));
          orderStoreAddressFields();
          initGhnAddressSelects(detailCell);
          var countNode = detailCell.querySelector('.store-detail-warehouse-count[data-store-id="' + id + '"]');
          if (countNode && typeof data.warehouse_count !== 'undefined') {
            countNode.textContent = Number(data.warehouse_count || 0);
          }
          var listCountNode = document.querySelector('.store-warehouse-count[data-store-id="' + id + '"]');
          if (listCountNode && typeof data.warehouse_count !== 'undefined') {
            listCountNode.textContent = Number(data.warehouse_count || 0);
          }
        }).catch(function(error) {
          if (error && error.name === 'AbortError') return;
          if (self.detailRow !== detailRow) return;
          detailCell.innerHTML = '<div class="kv-detail-panel product-detail kv-detail-error"><p>Khong tai duoc thong tin cua hang.</p></div>';
        });
      };

      var storeMasterTable = document.querySelector('table[data-kv-master="cua-hang"]');
      if (storeMasterTable) new StoreInlineDetail(storeMasterTable);

      document.addEventListener('click', function (event) {
        if (!storeCityFilterDropdown || !storeCityFilterTrigger) return;
        if (storeCityFilterDropdown.contains(event.target)) return;
        if (storeCityFilterTrigger.contains(event.target)) return;
        storeCityFilterDropdown.classList.remove('is-open');
      });

      var storeImportToggle = document.getElementById('storeImportToggle');
      var storeImportMenu = document.getElementById('storeImportMenu');
      var storeImportPickBtn = document.getElementById('storeImportPickBtn');
      var storeImportForm = document.getElementById('storeImportForm');
      var storeImportFile = document.getElementById('storeImportFile');

      function closeStoreImportMenu() {
        if (!storeImportMenu || !storeImportToggle) return;
        storeImportMenu.classList.remove('is-open');
        storeImportToggle.setAttribute('aria-expanded', 'false');
      }

      function isExcelFile(file) {
        if (!file) return false;
        var name = String(file.name || '').toLowerCase();
        return /\.xlsx$/i.test(name);
      }

      if (storeImportToggle && storeImportMenu) {
        storeImportToggle.addEventListener('click', function(event) {
          event.stopPropagation();
          var isOpen = storeImportMenu.classList.toggle('is-open');
          storeImportToggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
        });
      }

      if (storeImportPickBtn && storeImportFile) {
        storeImportPickBtn.addEventListener('click', function() {
          closeStoreImportMenu();
          storeImportFile.value = '';
          storeImportFile.click();
        });
      }

      if (storeImportFile && storeImportForm) {
        storeImportFile.addEventListener('change', function() {
          var file = storeImportFile.files && storeImportFile.files[0];
          if (!file) return;

          if (!isExcelFile(file)) {
            alert('Chỉ chấp nhận file Excel (.xlsx). Vui lòng dùng file mẫu.');
            storeImportFile.value = '';
            return;
          }

          storeImportForm.submit();
        });
      }

      document.addEventListener('click', function(event) {
        if (!storeImportMenu || !storeImportToggle) return;
        if (storeImportMenu.contains(event.target)) return;
        if (storeImportToggle.contains(event.target)) return;
        closeStoreImportMenu();
      });
    });
  </script>
</body>
</html>
