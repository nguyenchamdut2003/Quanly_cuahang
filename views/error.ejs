<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Lỗi</title>
  <link rel="stylesheet" href="/stylesheets/style.css">
  <link rel="stylesheet" href="/stylesheets/responsive.css">
  <style>
    body{background:#f3f6f9;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;padding:24px 16px}
    .error-card{max-width:720px;margin:40px auto;background:#fff;border:1px solid #e5e9ee;border-radius:8px;padding:24px}
    .error-card h1{margin:0 0 8px;font-size:22px;color:#b42318}
    .error-card h2{margin:0 0 16px;font-size:16px;color:#475467;font-weight:600}
    .error-card pre{overflow:auto;background:#f8fafc;border:1px solid #e2e8f0;border-radius:6px;padding:12px;font-size:12px;line-height:1.45;white-space:pre-wrap;word-break:break-word}
  </style>
</head>
<body>
  <div class="error-card">
    <h1><%= message %></h1>
    <h2><%= error.status %></h2>
    <pre><%= error.stack %></pre>
  </div>
</body>
</html>
