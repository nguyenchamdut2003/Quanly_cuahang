<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/stylesheets/style.css">
  <link rel="stylesheet" href="/stylesheets/responsive.css">
  <style>
    .admin-body .admin-shell{width:auto;max-width:none;margin:0;padding:30px}
    .hr-setup-shell{display:grid;grid-template-columns:260px minmax(0,1fr);gap:12px;padding:0}
    .hr-setup-main{background:#fff;border:1px solid #d7dde5;border-radius:8px;padding:14px 16px 16px;min-height:calc(100vh - 140px)}
    .hr-page-title{margin:0 0 14px;font-size:22px;font-weight:700;color:#111827}
    .hr-filters{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:10px;margin-bottom:12px;align-items:end}
    .hr-filters label{display:grid;gap:4px;font-size:12px;color:#475467}
    .hr-filters input,.hr-filters select{height:34px;border:1px solid #cfd8e3;border-radius:7px;padding:0 8px;font-size:13px}
    .hr-toolbar{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:12px}
    .hr-table-panel{border:1px solid #e5e9ee;border-radius:8px;overflow:auto}
    .hr-table{width:100%;border-collapse:collapse;min-width:1280px}
    .hr-table thead th{background:#e8f3ff;color:#111827;font-size:12px;font-weight:700;height:38px;padding:0 10px;text-align:left;border-bottom:1px solid #bcd9ff;white-space:nowrap}
    .hr-table tbody td{padding:9px 10px;border-bottom:1px solid #e5e9ee;font-size:12px;color:#111827}
    .hr-table tbody tr:hover{background:#f8fbff}
    .hr-empty{padding:36px 20px;text-align:center;color:#475467}
    .status-pill{display:inline-flex;align-items:center;height:22px;padding:0 8px;border-radius:5px;font-size:11px;font-weight:700}
    .status-pill.is-scheduled{background:#dbeafe;color:#1d4ed8}
    .status-pill.is-completed{background:#dcfce7;color:#166534}
    .status-pill.is-cancelled{background:#fee2e2;color:#991b1b}
    .day-type-pill{display:inline-flex;align-items:center;height:22px;padding:0 8px;border-radius:5px;font-size:11px;font-weight:600;background:#f3f4f6;color:#374151}
    .day-type-pill.is-holiday{background:#fef3c7;color:#92400e}
    .day-type-pill.is-off{background:#fce7f3;color:#9d174d}
    .hr-actions{display:flex;gap:6px}
    .hr-btn-icon{border:1px solid #cfd8e3;background:#fff;border-radius:6px;width:30px;height:28px;cursor:pointer;color:#344054}
    .modal-overlay{position:fixed;inset:0;background:rgba(15,23,42,.45);display:none;align-items:center;justify-content:center;z-index:3000;padding:20px;opacity:0;visibility:hidden}
    .modal-overlay.is-open{display:flex;opacity:1;visibility:visible}
    .modal-card{background:#fff;border-radius:10px;width:min(668px,100%);max-height:92vh;display:flex;flex-direction:column;box-shadow:0 20px 50px rgba(0,0,0,.18)}
    .modal-head{padding:16px 20px 12px;font-size:16px;font-weight:800;display:flex;align-items:center;justify-content:space-between}
    .modal-close{border:0;background:transparent;font-size:18px;line-height:1;color:#111827;cursor:pointer;width:28px;height:28px}
    .modal-body{padding:16px 20px;display:grid;gap:12px;overflow:auto}
    .modal-body label{display:grid;gap:4px;font-size:12px;color:#475467}
    .modal-body input,.modal-body select,.modal-body textarea{height:34px;border:1px solid #cfd8e3;border-radius:7px;padding:0 10px;font-size:13px}
    .modal-body textarea{height:72px;padding:8px 10px;resize:vertical}
    .modal-preview{background:#f8fafc;border:1px solid #e5e9ee;border-radius:8px;padding:10px 12px;font-size:12px;color:#344054;display:grid;gap:6px}
    .modal-foot{padding:12px 20px 16px;display:flex;justify-content:flex-end;gap:8px;border-top:1px solid #e5e9ee}
  </style>
</head>
<body class="admin-body">
  <%- include('../partials/header', { activeMenu: activeMenu, user: user }) %>
  <main class="admin-shell">
    <%- include('../partials/flash-message', { flash: flash }) %>
    <div class="hr-setup-shell">
      <%- include('../partials/hr-setup-nav', { activeHrPage: activeHrPage }) %>
      <section class="hr-setup-main">
        <h1 class="hr-page-title">Lịch làm việc</h1>

        <div class="hr-filters" id="scheduleFilters">
          <label>Từ ngày<input type="date" id="filterTuNgay" value="<%= filterDefaults.tu_ngay %>"></label>
          <label>Đến ngày<input type="date" id="filterDenNgay" value="<%= filterDefaults.den_ngay %>"></label>
          <label>Nhân viên<select id="filterNhanVien"><option value="">Tất cả</option></select></label>
          <label>Phòng ban<select id="filterPhongBan"><option value="">Tất cả</option></select></label>
          <label>Ca làm việc<select id="filterCa"><option value="">Tất cả</option></select></label>
          <label>Trạng thái
            <select id="filterTrangThai">
              <option value="">Đã xếp + Hoàn thành</option>
              <option value="scheduled">Đã xếp ca</option>
              <option value="completed">Hoàn thành</option>
              <option value="cancelled">Đã hủy</option>
              <option value="all">Tất cả trạng thái</option>
            </select>
          </label>
          <div>
            <button type="button" class="btn btn-light" id="filterApplyBtn">Lọc</button>
          </div>
        </div>

        <div class="hr-toolbar">
          <button type="button" class="btn btn-primary" id="scheduleAddBtn" data-open-schedule-modal onclick="window.openScheduleCreateModal ? window.openScheduleCreateModal() : document.getElementById('scheduleModal').classList.add('is-open')">+ Xếp ca</button>
        </div>

        <div class="hr-table-panel">
          <table class="hr-table">
            <thead>
              <tr>
                <th>Ngày làm việc</th>
                <th>Mã NV</th>
                <th>Tên nhân viên</th>
                <th>Phòng ban</th>
                <th>Chức danh</th>
                <th>Mã ca</th>
                <th>Tên ca</th>
                <th>Giờ bắt đầu</th>
                <th>Giờ kết thúc</th>
                <th>Loại ngày</th>
                <th>Trạng thái</th>
                <th>Ghi chú</th>
                <th style="width:90px">Hành động</th>
              </tr>
            </thead>
            <tbody id="scheduleTableBody">
              <tr><td colspan="13" class="hr-empty">Đang tải...</td></tr>
            </tbody>
          </table>
        </div>
      </section>
    </div>
  </main>

  <div class="modal-overlay" id="scheduleModal">
    <div class="modal-card">
      <div class="modal-head">
        <span id="scheduleModalTitle">Xếp ca</span>
        <button type="button" class="modal-close" id="scheduleCloseBtn">×</button>
      </div>
      <form id="scheduleForm" class="modal-body">
        <input type="hidden" id="scheduleId">
        <label>Ngày làm việc *<input type="date" id="scheduleNgay" required></label>
        <div class="modal-preview" id="scheduleLoaiNgayPreview">Loại ngày: —</div>
        <label>Nhân viên *
          <select id="scheduleNhanVien" required><option value="">Chọn nhân viên</option></select>
        </label>
        <label>Ca làm việc *
          <select id="scheduleCa" required><option value="">Chọn ca</option></select>
        </label>
        <div class="modal-preview" id="scheduleCaPreview">Thông tin ca: —</div>
        <label>Ghi chú<textarea id="scheduleGhiChu"></textarea></label>
        <label id="scheduleStatusWrap" style="display:none">Trạng thái
          <select id="scheduleTrangThai">
            <option value="scheduled">Đã xếp ca</option>
            <option value="completed">Hoàn thành</option>
            <option value="cancelled">Đã hủy</option>
          </select>
        </label>
      </form>
      <div class="modal-foot">
        <button type="button" class="btn btn-light" id="scheduleCancelBtn">Bỏ qua</button>
        <button type="submit" class="btn btn-primary" form="scheduleForm" id="scheduleSaveBtn">Lưu</button>
      </div>
    </div>
  </div>

  <script>
    const LOAI_NGAY_LABELS = {
      ngay_thuong: 'Ngày thường',
      thu_7: 'Thứ 7',
      chu_nhat: 'Chủ nhật',
      ngay_nghi: 'Ngày nghỉ',
      ngay_le_tet: 'Ngày lễ tết'
    };
    const TRANG_THAI_LABELS = {
      scheduled: 'Đã xếp ca',
      completed: 'Hoàn thành',
      cancelled: 'Đã hủy'
    };

    const scheduleModal = document.getElementById('scheduleModal');
    const scheduleTableBody = document.getElementById('scheduleTableBody');
    let scheduleEditId = '';
    let lookupCache = { employees: [], shifts: [], departments: [] };

    function escapeHtml(text) {
      return String(text || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    function formatDateDisplay(value) {
      if (!value) return '---';
      const d = new Date(value);
      if (Number.isNaN(d.getTime())) return '---';
      const day = String(d.getDate()).padStart(2, '0');
      const month = String(d.getMonth() + 1).padStart(2, '0');
      return day + '/' + month + '/' + d.getFullYear();
    }

    function toDateInputValue(value) {
      if (!value) return '';
      const d = new Date(value);
      if (Number.isNaN(d.getTime())) return '';
      const y = d.getFullYear();
      const m = String(d.getMonth() + 1).padStart(2, '0');
      const day = String(d.getDate()).padStart(2, '0');
      return y + '-' + m + '-' + day;
    }

    function loaiNgayClass(code) {
      if (code === 'ngay_le_tet') return 'is-holiday';
      if (code === 'ngay_nghi' || code === 'chu_nhat') return 'is-off';
      return '';
    }

    function loaiNgayText(item) {
      const base = LOAI_NGAY_LABELS[item.loai_ngay] || item.loai_ngay || '---';
      if (item.loai_ngay === 'ngay_le_tet' && item.ten_ngay_le) {
        return base + ' (' + item.ten_ngay_le + ', HS ' + Number(item.he_so_luong_ngay || 0) + '%)';
      }
      if (item.loai_ngay === 'ngay_le_tet') {
        return base + ' (HS ' + Number(item.he_so_luong_ngay || 0) + '%)';
      }
      return base;
    }

    function statusClass(status) {
      if (status === 'completed') return 'is-completed';
      if (status === 'cancelled') return 'is-cancelled';
      return 'is-scheduled';
    }

    function refName(ref) {
      if (!ref) return '---';
      if (typeof ref === 'object') return ref.ten_phong_ban || ref.ten_chuc_danh || '---';
      return '---';
    }

    function fillSelectOptions(select, items, valueKey, labelFn, selected) {
      const keep = select.querySelector('option[value=""]');
      select.innerHTML = '';
      if (keep) select.appendChild(keep);
      else select.innerHTML = '<option value="">Tất cả</option>';
      items.forEach(item => {
        const opt = document.createElement('option');
        opt.value = String(item[valueKey] || '');
        opt.textContent = labelFn(item);
        if (selected && String(selected) === opt.value) opt.selected = true;
        select.appendChild(opt);
      });
    }

    async function loadLookupOptions() {
      const res = await fetch('/api/lich-lam-viec/lookup-options', { headers: { Accept: 'application/json' } });
      const json = await res.json();
      if (!json.success) return alert(json.message || 'Không tải được dữ liệu tham chiếu');
      lookupCache = {
        employees: json.employees || [],
        shifts: json.shifts || [],
        departments: json.departments || []
      };

      fillSelectOptions(
        document.getElementById('filterNhanVien'),
        lookupCache.employees,
        '_id',
        e => (e.ma_nhan_vien ? e.ma_nhan_vien + ' - ' : '') + (e.ten_nhan_vien || '')
      );
      fillSelectOptions(
        document.getElementById('filterPhongBan'),
        lookupCache.departments,
        '_id',
        d => d.ten_phong_ban || '---'
      );
      fillSelectOptions(
        document.getElementById('filterCa'),
        lookupCache.shifts,
        '_id',
        c => (c.ma_ca ? c.ma_ca + ' - ' : '') + (c.ten_ca || '') + ' (' + (c.gio_bat_dau || '') + '-' + (c.gio_ket_thuc || '') + ')'
      );

      const nvSelect = document.getElementById('scheduleNhanVien');
      nvSelect.innerHTML = '<option value="">Chọn nhân viên</option>';
      lookupCache.employees.forEach(e => {
        const opt = document.createElement('option');
        opt.value = String(e._id || '');
        opt.textContent = (e.ma_nhan_vien ? e.ma_nhan_vien + ' - ' : '') + (e.ten_nhan_vien || '');
        nvSelect.appendChild(opt);
      });

      const caSelect = document.getElementById('scheduleCa');
      caSelect.innerHTML = '<option value="">Chọn ca</option>';
      lookupCache.shifts.forEach(c => {
        const opt = document.createElement('option');
        opt.value = String(c._id || '');
        opt.textContent = (c.ma_ca ? c.ma_ca + ' - ' : '') + (c.ten_ca || '') + ' (' + (c.gio_bat_dau || '') + '-' + (c.gio_ket_thuc || '') + ')';
        opt.dataset.gioBatDau = c.gio_bat_dau || '';
        opt.dataset.gioKetThuc = c.gio_ket_thuc || '';
        opt.dataset.nghi = String(c.nghi_giua_ca_phut || 0);
        caSelect.appendChild(opt);
      });
    }

    function collectFilterParams() {
      const params = new URLSearchParams();
      const tu = document.getElementById('filterTuNgay').value;
      const den = document.getElementById('filterDenNgay').value;
      const nv = document.getElementById('filterNhanVien').value;
      const pb = document.getElementById('filterPhongBan').value;
      const ca = document.getElementById('filterCa').value;
      const tt = document.getElementById('filterTrangThai').value;
      if (tu) params.set('tu_ngay', tu);
      if (den) params.set('den_ngay', den);
      if (nv) params.set('nhan_vien_id', nv);
      if (pb) params.set('phong_ban_id', pb);
      if (ca) params.set('ca_lam_viec_id', ca);
      if (tt) params.set('trang_thai', tt);
      return params;
    }

    function renderScheduleRows(items) {
      if (!items.length) {
        scheduleTableBody.innerHTML = '<tr><td colspan="13" class="hr-empty">Chưa có lịch làm việc. <a href="#" id="scheduleEmptyAdd">Nhấn vào đây để xếp ca</a>.</td></tr>';
        document.getElementById('scheduleEmptyAdd')?.addEventListener('click', e => {
          e.preventDefault();
          openScheduleModal(null);
        });
        return;
      }

      scheduleTableBody.innerHTML = items.map(item => {
        const st = item.trang_thai || 'scheduled';
        return (
          '<tr data-id="' + escapeHtml(String(item._id || '')) + '"' +
            ' data-ngay="' + escapeHtml(toDateInputValue(item.ngay_lam_viec)) + '"' +
            ' data-nhan-vien="' + escapeHtml(String(item.nhan_vien_id || '')) + '"' +
            ' data-ca="' + escapeHtml(String(item.ca_lam_viec_id || '')) + '"' +
            ' data-ghi-chu="' + escapeHtml(item.ghi_chu || '') + '"' +
            ' data-trang-thai="' + escapeHtml(st) + '">' +
            '<td>' + formatDateDisplay(item.ngay_lam_viec) + '</td>' +
            '<td>' + escapeHtml(item.ma_nhan_vien || '---') + '</td>' +
            '<td><strong>' + escapeHtml(item.ten_nhan_vien || '---') + '</strong></td>' +
            '<td>' + escapeHtml(refName(item.phong_ban_id)) + '</td>' +
            '<td>' + escapeHtml(refName(item.chuc_danh_id)) + '</td>' +
            '<td>' + escapeHtml(item.ma_ca || '---') + '</td>' +
            '<td>' + escapeHtml(item.ten_ca || '---') + '</td>' +
            '<td>' + escapeHtml(item.gio_bat_dau || '---') + '</td>' +
            '<td>' + escapeHtml(item.gio_ket_thuc || '---') + '</td>' +
            '<td><span class="day-type-pill ' + loaiNgayClass(item.loai_ngay) + '">' + escapeHtml(loaiNgayText(item)) + '</span></td>' +
            '<td><span class="status-pill ' + statusClass(st) + '">' + escapeHtml(TRANG_THAI_LABELS[st] || st) + '</span></td>' +
            '<td>' + escapeHtml(item.ghi_chu || '') + '</td>' +
            '<td><div class="hr-actions">' +
              (st !== 'cancelled'
                ? '<button type="button" class="hr-btn-icon schedule-edit" title="Sửa"><i class="fa-regular fa-pen-to-square"></i></button>' +
                  '<button type="button" class="hr-btn-icon schedule-delete" title="Hủy lịch"><i class="fa-regular fa-trash-can"></i></button>'
                : '') +
            '</div></td>' +
          '</tr>'
        );
      }).join('');

      document.querySelectorAll('.schedule-edit').forEach(btn => {
        btn.addEventListener('click', function() {
          const row = this.closest('tr');
          openScheduleModal({
            _id: row.dataset.id,
            ngay_lam_viec: row.dataset.ngay,
            nhan_vien_id: row.dataset.nhanVien,
            ca_lam_viec_id: row.dataset.ca,
            ghi_chu: row.dataset.ghiChu,
            trang_thai: row.dataset.trangThai
          });
        });
      });
      document.querySelectorAll('.schedule-delete').forEach(btn => {
        btn.addEventListener('click', async function() {
          const id = this.closest('tr').dataset.id;
          if (!confirm('Hủy lịch làm việc này?')) return;
          const res = await fetch('/api/lich-lam-viec/' + id, { method: 'DELETE' });
          const json = await res.json();
          if (!json.success) return alert(json.message || 'Lỗi');
          await loadSchedules();
        });
      });
    }

    async function loadSchedules() {
      const params = collectFilterParams();
      const res = await fetch('/api/lich-lam-viec?' + params.toString(), { headers: { Accept: 'application/json' } });
      const json = await res.json();
      if (!json.success) return alert(json.message || 'Không tải được lịch');
      renderScheduleRows(json.items || []);
    }

    function updateCaPreview() {
      const select = document.getElementById('scheduleCa');
      const opt = select.selectedOptions[0];
      const preview = document.getElementById('scheduleCaPreview');
      if (!opt || !opt.value) {
        preview.textContent = 'Thông tin ca: —';
        return;
      }
      preview.textContent = 'Giờ: ' + (opt.dataset.gioBatDau || '---') + ' - ' + (opt.dataset.gioKetThuc || '---')
        + ' | Nghỉ giữa ca: ' + (opt.dataset.nghi || '0') + ' phút';
    }

    async function previewLoaiNgay() {
      const ngay = document.getElementById('scheduleNgay').value;
      const preview = document.getElementById('scheduleLoaiNgayPreview');
      if (!ngay) {
        preview.textContent = 'Loại ngày: —';
        return;
      }
      const res = await fetch('/api/lich-lam-viec/loai-ngay?ngay_lam_viec=' + encodeURIComponent(ngay), {
        headers: { Accept: 'application/json' }
      });
      const json = await res.json();
      if (!json.success) {
        preview.textContent = 'Loại ngày: không xác định';
        return;
      }
      const item = json.item || {};
      let text = 'Loại ngày dự kiến: ' + (item.loai_ngay_label || LOAI_NGAY_LABELS[item.loai_ngay] || item.loai_ngay);
      if (item.loai_ngay === 'ngay_le_tet' && item.ten_ngay_le) {
        text += ' — ' + item.ten_ngay_le + ' (HS ' + Number(item.he_so_luong_ngay || 0) + '%)';
      }
      preview.textContent = text;
    }

    function openScheduleModal(item) {
      item = item || {};
      scheduleEditId = item._id ? String(item._id) : '';
      document.getElementById('scheduleModalTitle').textContent = scheduleEditId ? 'Sửa lịch làm việc' : 'Xếp ca';
      document.getElementById('scheduleId').value = scheduleEditId;
      document.getElementById('scheduleNgay').value = item.ngay_lam_viec || toDateInputValue(new Date());
      document.getElementById('scheduleNhanVien').value = item.nhan_vien_id ? String(item.nhan_vien_id) : '';
      document.getElementById('scheduleCa').value = item.ca_lam_viec_id ? String(item.ca_lam_viec_id) : '';
      document.getElementById('scheduleGhiChu').value = item.ghi_chu || '';
      document.getElementById('scheduleStatusWrap').style.display = scheduleEditId ? 'grid' : 'none';
      document.getElementById('scheduleTrangThai').value = item.trang_thai || 'scheduled';
      updateCaPreview();
      previewLoaiNgay();
      scheduleModal.classList.add('is-open');
    }

    function closeScheduleModal() {
      scheduleModal.classList.remove('is-open');
    }

    window.openScheduleCreateModal = function() {
      openScheduleModal(null);
    };

    function collectSchedulePayload() {
      const payload = {
        ngay_lam_viec: document.getElementById('scheduleNgay').value,
        nhan_vien_id: document.getElementById('scheduleNhanVien').value,
        ca_lam_viec_id: document.getElementById('scheduleCa').value,
        ghi_chu: document.getElementById('scheduleGhiChu').value.trim()
      };
      if (scheduleEditId) {
        payload.trang_thai = document.getElementById('scheduleTrangThai').value;
      }
      return payload;
    }

    document.addEventListener('click', function(e) {
      const trigger = e.target.closest('[data-open-schedule-modal]');
      if (!trigger) return;
      e.preventDefault();
      openScheduleModal(null);
    });
    document.getElementById('scheduleCancelBtn').addEventListener('click', closeScheduleModal);
    document.getElementById('scheduleCloseBtn').addEventListener('click', closeScheduleModal);
    document.getElementById('filterApplyBtn').addEventListener('click', loadSchedules);
    document.getElementById('scheduleNgay').addEventListener('change', previewLoaiNgay);
    document.getElementById('scheduleCa').addEventListener('change', updateCaPreview);

    document.getElementById('scheduleForm').addEventListener('submit', async function(e) {
      e.preventDefault();
      const payload = collectSchedulePayload();
      if (!payload.ngay_lam_viec) return alert('Chọn ngày làm việc');
      if (!payload.nhan_vien_id) return alert('Chọn nhân viên');
      if (!payload.ca_lam_viec_id) return alert('Chọn ca làm việc');
      const url = scheduleEditId ? ('/api/lich-lam-viec/' + scheduleEditId) : '/api/lich-lam-viec';
      const method = scheduleEditId ? 'PUT' : 'POST';
      const res = await fetch(url, {
        method,
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(payload)
      });
      const json = await res.json();
      if (!json.success) return alert(json.message || 'Lỗi lưu lịch');
      closeScheduleModal();
      await loadSchedules();
    });

    (async function init() {
      await loadLookupOptions();
      await loadSchedules();
    })();
  </script>
</body>
</html>
