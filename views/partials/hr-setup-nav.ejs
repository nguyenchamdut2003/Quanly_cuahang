<%
  const hrPage = typeof activeHrPage === 'string' ? activeHrPage : '';
  function hrNavClass(key) {
    return 'hr-setup-link' + (hrPage === key ? ' is-active' : '');
  }
%>
<aside class="customer-filter hr-setup-nav">
  <style>
    .hr-setup-nav{width:260px;box-sizing:border-box}
    .hr-setup-nav .hr-setup-links{display:grid;gap:4px;margin-top:12px}
    .hr-setup-nav .hr-setup-link{display:flex;align-items:center;width:100%;height:36px;box-sizing:border-box;padding:0 12px;border-radius:6px;color:#344054;font-size:13px;font-weight:600;text-decoration:none;line-height:1.2}
    .hr-setup-nav .hr-setup-link:hover{background:#f0f7ff;color:#0070f4}
    .hr-setup-nav .hr-setup-link.is-active{background:#e8f3ff;color:#0070f4}
  </style>
  <h2>Thiết lập nhân viên</h2>
  <nav class="hr-setup-links">
    <a href="/thiet-lap-nhan-vien" class="<%= hrNavClass('thiet-lap-nhan-vien') %>">Thiết lập nhanh</a>
    <a href="/nhan-vien" class="<%= hrNavClass('nhan-vien') %>">Danh sách nhân viên</a>
    <a href="/ca-lam-viec" class="<%= hrNavClass('ca-lam-viec') %>">Ca làm việc</a>
    <a href="/ngay-lam-nghi" class="<%= hrNavClass('ngay-lam-nghi') %>">Ngày làm & Nghỉ</a>
    <a href="/lich-lam-viec" class="<%= hrNavClass('lich-lam-viec') %>">Lịch làm việc</a>
    <a href="/cham-cong" class="<%= hrNavClass('cham-cong') %>">Chấm công</a>
    <a href="/bang-luong" class="<%= hrNavClass('bang-luong') %>">Bảng lương</a>
  </nav>
</aside>
