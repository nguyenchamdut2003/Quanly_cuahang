<header class="kv-header">
  <link rel="stylesheet" href="/stylesheets/responsive.css">
  <meta charset="UTF-8">
  <!-- Top Bar -->
  <div class="kv-topbar">
    <div></div>
    <div class="kv-top-actions">
      <% if (false && locals.user) { %>
        <a href="/thung-rac" class="kv-trash-link" title="Thùng rác" aria-label="Thùng rác">
          <svg class="kv-trash-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M9 3h6l1 2h4v2H4V5h4l1-2Zm1 6h2v9h-2V9Zm4 0h2v9h-2V9ZM6 9h2l1 11h6l1-11h2l-1.2 13H7.2L6 9Z"></path>
          </svg>
          <% if (Number(locals.trashCount || 0) > 0) { %>
            <span class="kv-trash-badge"><%= Number(locals.trashCount) > 99 ? '99+' : locals.trashCount %></span>
          <% } %>
        </a>
      <% } %>
      <div class="kv-action-item user-dropdown-container">
        <% if (locals.user) { %>
          <%
            const store = locals.currentStore || null;
            const stores = Array.isArray(locals.availableStores) ? locals.availableStores : [];
            const storeName = store?.ten_cua_hang || 'Thông tin cửa hàng';
            const storeInitial = (storeName || 'C').trim().charAt(0).toUpperCase();
            const storeAddress = store?.dia_chi_day_du || [
              store?.dia_chi_chi_tiet,
              store?.phuong_xa,
              store?.tinh_thanh
            ].filter(Boolean).join(', ');
            const storeEditUrl = store?._id ? `/cua-hang?open=${store._id}` : '/cua-hang';
          %>
          <div class="kv-user-avatar">
            <span><%= storeInitial %></span>
          </div>
          <div class="user-dropdown-menu">
            <div class="header-store-info">
              <strong><%= storeName %></strong>
              <% if (stores.length > 0) { %>
                <form method="post" action="/auth/current-store" class="header-store-switch">
                  <input type="hidden" name="returnTo" value="<%= locals.originalUrl || '' %>">
                  <div class="header-store-label">Cửa hàng đang làm việc</div>
                  <select name="cua_hang_id" class="header-store-select" aria-label="Chọn cửa hàng làm việc" onchange="this.form.submit()">
                    <% stores.forEach(function(item) {
                      const selected = store && String(store._id) === String(item._id);
                      const label = (item.ten_cua_hang || item.ma_cua_hang || item._id) + (item.ma_cua_hang && item.ten_cua_hang ? (' — ' + item.ma_cua_hang) : '');
                    %>
                      <option value="<%= item._id %>" <%= selected ? 'selected' : '' %>><%= selected ? '✓ ' : '' %><%= label %></option>
                    <% }) %>
                  </select>
                </form>
              <% } %>
              <% if (store?.ma_cua_hang) { %>
                <small>Mã cửa hàng: <%= store.ma_cua_hang %></small>
              <% } %>
              <% if (store?.sdt) { %>
                <small>Điện thoại: <%= store.sdt %></small>
              <% } %>
              <% if (store?.email) { %>
                <small>Email: <%= store.email %></small>
              <% } %>
              <% if (storeAddress) { %>
                <small>Địa chỉ: <%= storeAddress %></small>
              <% } %>
              <% if (store?.trang_thai) { %>
                <small>Trạng thái: <%= store.trang_thai === 'active' ? 'Đang hoạt động' : 'Ngừng hoạt động' %></small>
              <% } %>
              <% if (!store) { %>
                <small>Chưa có cửa hàng. Bấm bên dưới để thêm thông tin.</small>
              <% } %>
            </div>
            <a href="<%= storeEditUrl %>" class="dropdown-item">
              <i class="fa-solid fa-store"></i> Xem và sửa cửa hàng
            </a>
            <% if (locals.user && locals.user.vai_tro === 'super_admin') { %>
              <a href="/phan-quyen-tai-khoan" class="dropdown-item">
                <i class="fa-solid fa-user-shield"></i> Ph&acirc;n quy&#7873;n t&agrave;i kho&#7843;n
              </a>
            <% } %>
            <button type="button" class="dropdown-item" id="changePasswordOpen">
              <i class="fa-solid fa-key"></i> &Dstrok;&#7893;i m&#7853;t kh&#7849;u
            </button>
            <% if (locals.user && locals.user.vai_tro === 'super_admin') { %>
              <button type="button" class="dropdown-item dropdown-reset-data" id="resetDataOpen">
              <i class="fa-solid fa-triangle-exclamation"></i> reset dữ liệu
              </button>
            <% } %>
            <form method="post" action="/logout" class="header-logout-form">
              <button type="submit" class="dropdown-item header-logout-button">
                <i class="fa-solid fa-right-from-bracket"></i> Đăng xuất
              </button>
            </form>
            <div class="reset-data-modal" id="resetDataModal" aria-hidden="true">
              <div class="reset-data-dialog" role="dialog" aria-modal="true" aria-labelledby="resetDataTitle">
                <h3 id="resetDataTitle">Cảnh báo</h3>
                <p>reset sẽ làm sạch hoàn toàn dữ liệu</p>
                <div class="reset-data-actions">
                  <button type="button" class="btn btn-danger" id="resetDataConfirm">Đồng ý</button>
                  <button type="button" class="btn btn-light" id="resetDataCancel">Không</button>
                </div>
              </div>
            </div>
          </div>
            <div class="change-password-modal<%= locals.forcePasswordChange ? ' is-open' : '' %>" id="changePasswordModal" aria-hidden="<%= locals.forcePasswordChange ? 'false' : 'true' %>" data-force="<%= locals.forcePasswordChange ? '1' : '0' %>">
              <div class="change-password-dialog" role="dialog" aria-modal="true" aria-labelledby="changePasswordTitle">
                <button type="button" class="change-password-close" id="changePasswordClose" aria-label="B&#7887; qua &#273;&#7893;i m&#7853;t kh&#7849;u">&times;</button>
                <h3 id="changePasswordTitle">&Dstrok;&#7893;i m&#7853;t kh&#7849;u</h3>
                <% if (locals.forcePasswordChange) { %>
                  <p class="change-password-note">L&#432;u &yacute; &dstrok;&#7893;i m&#7853;t kh&#7849;u lu&ocirc;n &dstrok;&#7875; tr&aacute;nh &dstrok;&#7875; m&#7853;t kh&#7849;u t&#7921; t&#7841;o.</p>
                <% } %>
                <form method="post" action="/profile/change-password" class="change-password-form">
                  <label>
                    <span>M&#7853;t kh&#7849;u hi&#7879;n t&#7841;i</span>
                    <input type="password" name="current_password" autocomplete="current-password" required>
                  </label>
                  <label>
                    <span>M&#7853;t kh&#7849;u m&#7899;i</span>
                    <input type="password" name="password" autocomplete="new-password" minlength="8" pattern="(?=.*[A-Za-z])(?=.*\d).{8,}" required>
                  </label>
                  <label>
                    <span>X&aacute;c nh&#7853;n m&#7853;t kh&#7849;u m&#7899;i</span>
                    <input type="password" name="confirm_password" autocomplete="new-password" minlength="8" pattern="(?=.*[A-Za-z])(?=.*\d).{8,}" required>
                  </label>
                  <div class="change-password-actions">
                    <button type="submit" class="btn btn-primary">L&#432;u m&#7853;t kh&#7849;u</button>
                    <% if (!locals.forcePasswordChange) { %>
                      <button type="button" class="btn btn-light" id="changePasswordCancel">H&#7911;y</button>
                    <% } %>
                  </div>
                </form>
              </div>
            </div>
          <% } else { %>
            <div class="kv-user-avatar">
              <i class="fa-solid fa-user"></i>
            </div>
            <div class="user-dropdown-menu login-modal">
              <h3 class="login-title">Đăng nhập</h3>
              <p class="login-subtitle">Chào mừng bạn quay lại!</p>
              <a href="/login" class="dropdown-item">
                <i class="fa-solid fa-right-to-bracket"></i> Đăng nhập
              </a>
              <a href="/register" class="dropdown-item">
                <i class="fa-solid fa-user-plus"></i> Đăng ký
              </a>
              <a href="/auth/google" class="btn-google-login">
                <i class="fa-brands fa-google"></i> Đăng nhập bằng Google
              </a>
            </div>
            <% } %>
      </div>
    </div>
  </div>

  <!-- Bottom Navigation Bar -->
  <div class="kv-nav-backdrop" id="kvNavBackdrop" aria-hidden="true"></div>
  <div class="kv-navbar">
    <button type="button" class="kv-nav-toggle" id="kvNavToggle" aria-label="Mở menu điều hướng" aria-expanded="false" aria-controls="kvMainNav">
      <i class="fa-solid fa-bars" aria-hidden="true"></i>
    </button>
    <nav class="kv-nav-links" id="kvMainNav">
      <a href="/" class="nav-item">Tổng quan</a>
      <a href="/cua-hang" class="nav-item">Cửa hàng</a>
      <div class="nav-dropdown" id="hangHoaNav">
        <button type="button" class="nav-item nav-dropdown-trigger">Hàng hóa</button>
        <div class="nav-mega-menu">
          <div class="nav-mega-col">
            <a href="/hang-hoa" class="nav-mega-item">Danh sách hàng hóa</a>
            <a href="/vat-chua" class="nav-mega-item">Vật chứa hàng hóa</a>
            <a href="/hang-hoa/thiet-lap-gia" class="nav-mega-item">Thiết lập giá</a>
          </div>
          <div class="nav-mega-col">
            <a href="/kiem-kho" class="nav-mega-item">Kiểm kho</a>
            <a href="/xuat-dung-noi-bo" class="nav-mega-item">
              <span>Xuất dùng nội bộ</span>
            </a>
            <a href="/xuat-huy" class="nav-mega-item">Xuất hủy</a>
          </div>
        </div>
      </div>
      <div class="nav-dropdown" id="muaHangNav">
        <button type="button" class="nav-item nav-dropdown-trigger">Mua hàng</button>
        <div class="nav-mega-menu nav-mega-menu--purchase">
          <div class="nav-mega-col">
            <div class="nav-mega-heading">Nhà cung cấp</div>
            <a href="/nha-cung-cap" class="nav-mega-item">Nhà cung cấp</a>
          </div>
          <div class="nav-mega-col">
            <div class="nav-mega-heading">Mua hàng</div>
            <a href="/nhap-hang" class="nav-mega-item">Nhập hàng</a>
            <a href="/tra-hang-nhap" class="nav-mega-item">Trả hàng nhập</a>
          </div>
        </div>
      </div>
      <div class="nav-dropdown" id="donHangNav">
        <button type="button" class="nav-item nav-dropdown-trigger">Đơn hàng</button>
        <div class="nav-mega-menu nav-mega-menu--single nav-order-menu">
          <div class="nav-mega-col">
            <a href="/don-hang" class="nav-mega-item">Đặt hàng</a>
            <a href="/don-hang/hoa-don" class="nav-mega-item">Hóa đơn</a>
            <a href="/don-hang/tra-hang" class="nav-mega-item">Trả hàng</a>
            <a href="/doi-tac-giao-hang" class="nav-mega-item nav-mega-item--separated">Đối tác giao hàng</a>
            <a href="/don-hang/van-don" class="nav-mega-item">Vận đơn</a>
          </div>
        </div>
      </div>
      <a href="/khach-hang" class="nav-item">Khách hàng</a>
      <a href="/so-quy" class="nav-item">Sổ quỹ</a>
      <a href="/chamcongmoi" class="nav-item">Chấm công mới</a>
      <div class="nav-dropdown" id="baoCaoNav">
        <button type="button" class="nav-item nav-dropdown-trigger">Báo cáo</button>
        <div class="nav-mega-menu nav-mega-menu--single nav-report-menu">
          <div class="nav-mega-col">
            <div class="nav-mega-heading">Báo cáo</div>
            <a href="/bao-cao/cuoi-ngay" class="nav-mega-item">Cuối ngày</a>
            <a href="/bao-cao/ban-hang" class="nav-mega-item">Bán hàng</a>
            <a href="/bao-cao/dat-hang" class="nav-mega-item">Đặt hàng</a>
            <a href="/bao-cao/hang-hoa" class="nav-mega-item">Hàng hóa</a>
            <a href="/bao-cao/ton-kho-lo" class="nav-mega-item">Tồn kho theo lô</a>
            <a href="/bao-cao/loi-nhuan-lo" class="nav-mega-item">Lợi nhuận theo lô</a>
            <a href="/bao-cao/khach-hang" class="nav-mega-item">Khách hàng</a>
            <a href="/bao-cao/khach-hang?focus=loi-nhuan" class="nav-mega-item">Lợi nhuận theo KH</a>
            <a href="/bao-cao/nha-cung-cap" class="nav-mega-item">Nhà cung cấp</a>
            <a href="/bao-cao/nha-cung-cap?focus=loi-nhuan" class="nav-mega-item">Lợi nhuận theo NCC</a>
          </div>
        </div>
      </div>
      <a href="/bao-cao/58" class="nav-item">Báo cáo 58</a>
    </nav>

  </div>
  <style>
    .app-delete-disabled-hidden {
      display: none !important;
    }
  </style>
</header>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    function disableDeleteAndTrashUi(root) {
      const scope = root && root.querySelectorAll ? root : document;
      const selector = [
        'a[href*="/thung-rac"]',
        'a[href*="/delete"]',
        'a[href*="/trash"]',
        'form[action*="/delete"]',
        'form[action*="/trash"]',
        'button[id*="Trash"]',
        'button[id*="trash"]',
        'button[id*="Delete"]',
        'button[id*="delete"]',
        'button[form*="Delete"]',
        'button[form*="delete"]',
        '[data-action*="/delete"]',
        '[data-action*="/trash"]',
        '[onclick*="/delete"]',
        '[onclick*="/trash"]',
        '[onclick*="delete"]',
        '[onclick*="Delete"]',
        '[onclick*="trash"]',
        '[onclick*="Trash"]',
        '.btn-trash-product',
        '.js-address-type-delete',
        '.js-cashbook-delete',
        '.group-manage-action-delete',
        '.address-type-action-delete'
      ].join(',');
      scope.querySelectorAll(selector).forEach(function(el) {
        if (el.closest && el.closest('#resetDataModal')) return;
        if (el.tagName === 'FORM') {
          el.querySelectorAll('button,input[type="submit"]').forEach(function(btn) {
            btn.classList.add('app-delete-disabled-hidden');
          });
          return;
        }
        el.classList.add('app-delete-disabled-hidden');
      });

      scope.querySelectorAll('button,a').forEach(function(el) {
        if (el.closest && el.closest('#resetDataModal')) return;
        const text = String(el.textContent || '').replace(/\s+/g, ' ').trim().toLowerCase();
        const destructiveText = [
          'xóa',
          'xóa đã chọn',
          'xóa vĩnh viễn',
          'đưa vào thùng rác',
          'chuyển vào thùng rác',
          'chuyển đã chọn vào thùng rác',
          'khôi phục'
        ];
        if (destructiveText.includes(text)) {
          el.classList.add('app-delete-disabled-hidden');
        }
      });
    }

    disableDeleteAndTrashUi(document);
    new MutationObserver(function(mutations) {
      mutations.forEach(function(mutation) {
        mutation.addedNodes.forEach(function(node) {
          if (node && node.nodeType === 1) disableDeleteAndTrashUi(node);
        });
      });
    }).observe(document.body, { childList: true, subtree: true });

    const headerEl = document.querySelector('.kv-header');
    const navToggle = document.getElementById('kvNavToggle');
    const navBackdrop = document.getElementById('kvNavBackdrop');

    function setNavOpen(open) {
      if (!headerEl || !navToggle) return;
      headerEl.classList.toggle('is-nav-open', open);
      navToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      navToggle.setAttribute('aria-label', open ? 'Đóng menu điều hướng' : 'Mở menu điều hướng');
      if (navBackdrop) navBackdrop.setAttribute('aria-hidden', open ? 'false' : 'true');
      document.body.style.overflow = open ? 'hidden' : '';
    }

    if (navToggle && headerEl) {
      navToggle.addEventListener('click', function (e) {
        e.stopPropagation();
        setNavOpen(!headerEl.classList.contains('is-nav-open'));
      });
    }

    if (navBackdrop) {
      navBackdrop.addEventListener('click', function () {
        setNavOpen(false);
      });
    }

    const dropdownContainer = document.querySelector('.user-dropdown-container');
    const dropdownMenu = document.querySelector('.user-dropdown-menu');
    const resetDataOpen = document.getElementById('resetDataOpen');
    const resetDataModal = document.getElementById('resetDataModal');
    const resetDataConfirm = document.getElementById('resetDataConfirm');
    const resetDataCancel = document.getElementById('resetDataCancel');
    const changePasswordOpen = document.getElementById('changePasswordOpen');
    const changePasswordModal = document.getElementById('changePasswordModal');
    const changePasswordCancel = document.getElementById('changePasswordCancel');
    const changePasswordClose = document.getElementById('changePasswordClose');

    function setChangePasswordModalOpen(open, options) {
      if (!changePasswordModal) return;
      const isForced = changePasswordModal.getAttribute('data-force') === '1';
      const allowForcedClose = options && options.allowForcedClose;
      if (!open && isForced && !allowForcedClose) return;
      changePasswordModal.classList.toggle('is-open', open);
      changePasswordModal.setAttribute('aria-hidden', open ? 'false' : 'true');
    }

    async function skipPasswordChange() {
      if (!changePasswordModal) return;
      const isForced = changePasswordModal.getAttribute('data-force') === '1';
      if (!isForced) {
        setChangePasswordModalOpen(false);
        return;
      }
      if (changePasswordClose) changePasswordClose.disabled = true;
      try {
        const res = await fetch('/profile/skip-password-change', {
          method: 'POST',
          headers: { Accept: 'application/json' }
        });
        const data = await res.json().catch(function() { return {}; });
        if (!res.ok || !data.success) throw new Error(data.message || 'Khong bo qua duoc doi mat khau');
        changePasswordModal.setAttribute('data-force', '0');
        setChangePasswordModalOpen(false, { allowForcedClose: true });
      } catch (error) {
        alert(error.message || 'Khong bo qua duoc doi mat khau');
      } finally {
        if (changePasswordClose) changePasswordClose.disabled = false;
      }
    }

    if (changePasswordOpen) {
      changePasswordOpen.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        setChangePasswordModalOpen(true);
      });
    }

    if (changePasswordCancel) {
      changePasswordCancel.addEventListener('click', function(e) {
        e.preventDefault();
        setChangePasswordModalOpen(false);
      });
    }

    if (changePasswordClose) {
      changePasswordClose.addEventListener('click', function(e) {
        e.preventDefault();
        skipPasswordChange();
      });
    }

    if (changePasswordModal) {
      changePasswordModal.addEventListener('click', function(e) {
        if (e.target === changePasswordModal) setChangePasswordModalOpen(false);
      });
    }

    function setResetDataModalOpen(open) {
      if (!resetDataModal) return;
      resetDataModal.classList.toggle('is-open', open);
      resetDataModal.setAttribute('aria-hidden', open ? 'false' : 'true');
    }

    if (resetDataOpen) {
      resetDataOpen.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        setResetDataModalOpen(true);
      });
    }

    if (resetDataCancel) {
      resetDataCancel.addEventListener('click', function(e) {
        e.preventDefault();
        setResetDataModalOpen(false);
      });
    }

    if (resetDataModal) {
      resetDataModal.addEventListener('click', function(e) {
        if (e.target === resetDataModal) setResetDataModalOpen(false);
      });
    }

    if (resetDataConfirm) {
      resetDataConfirm.addEventListener('click', async function(e) {
        e.preventDefault();
        resetDataConfirm.disabled = true;
        resetDataConfirm.textContent = 'Đang reset...';
        try {
          const res = await fetch('/system/reset-data', {
            method: 'POST',
            headers: { Accept: 'application/json' }
          });
          const data = await res.json().catch(function() { return {}; });
          if (!res.ok || !data.success) {
            throw new Error(data.message || 'Không reset được dữ liệu');
          }
          window.location.href = data.redirect || '/';
        } catch (error) {
          alert(error.message || 'Không reset được dữ liệu');
          resetDataConfirm.disabled = false;
          resetDataConfirm.textContent = 'Đồng ý';
        }
      });
    }

    // Generic nav dropdown handler
    document.querySelectorAll('.nav-dropdown').forEach(function(navDrop) {
      const trigger = navDrop.querySelector('.nav-dropdown-trigger');
      if (trigger) {
        function toggleNavDropdown(e) {
          if (e) {
            e.preventDefault();
            e.stopPropagation();
          }
          const willOpen = !navDrop.classList.contains('open');
          document.querySelectorAll('.nav-dropdown').forEach(function(other) {
            if (other !== navDrop) other.classList.remove('open');
          });
          navDrop.classList.toggle('open');
          trigger.setAttribute('aria-expanded', navDrop.classList.contains('open') ? 'true' : 'false');
          if (willOpen && window.innerWidth <= 1100) {
            requestAnimationFrame(function () {
              navDrop.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
            });
          }
        }
        trigger.setAttribute('aria-expanded', navDrop.classList.contains('open') ? 'true' : 'false');
        trigger.addEventListener('click', toggleNavDropdown);
      }
    });

    if (dropdownContainer && dropdownMenu) {
      dropdownContainer.addEventListener('click', function (e) {
        e.stopPropagation();
        if (dropdownMenu.contains(e.target)) {
          return;
        }
        dropdownMenu.classList.toggle('show');
      });
    }

    if (dropdownMenu) {
      dropdownMenu.addEventListener('click', function (e) {
        e.stopPropagation();
      });
    }

    document.addEventListener('click', function (e) {
      if (dropdownContainer && !dropdownContainer.contains(e.target)) {
        dropdownMenu && dropdownMenu.classList.remove('show');
      }
      document.querySelectorAll('.nav-dropdown').forEach(function(navDrop) {
        if (!navDrop.contains(e.target)) {
          navDrop.classList.remove('open');
          const trigger = navDrop.querySelector('.nav-dropdown-trigger');
          if (trigger) trigger.setAttribute('aria-expanded', 'false');
        }
      });
      if (headerEl && headerEl.classList.contains('is-nav-open')) {
        const nav = document.getElementById('kvMainNav');
        if (nav && !nav.contains(e.target) && !navToggle.contains(e.target)) {
          setNavOpen(false);
        }
      }
    });

    document.querySelectorAll('#kvMainNav a.nav-mega-item, #kvMainNav a.nav-item[href]').forEach(function(link) {
      link.addEventListener('click', function () {
        setNavOpen(false);
      });
    });

    window.addEventListener('resize', function () {
      if (window.innerWidth > 1100) setNavOpen(false);
    });
  });
</script>
