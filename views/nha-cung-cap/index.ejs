      function positionSupplierDebtWarnTip(btn, tip) {
        if (!btn || !tip) return;
        var rect = btn.getBoundingClientRect();
        var tipWidth = Math.min(300, window.innerWidth - 24);
        var left = Math.max(12, rect.right - tipWidth);
        var top = rect.bottom + 8;
        if (top + tip.offsetHeight > window.innerHeight - 12) {
          top = Math.max(12, rect.top - tip.offsetHeight - 8);
        }
        tip.style.width = tipWidth + 'px';
        tip.style.left = left + 'px';
        tip.style.top = top + 'px';
      }
      function bindSupplierDebtWarnTips(root) {
        var scope = root || document;
        scope.querySelectorAll('.js-supplier-debt-warn').forEach(function(btn) {
          if (btn.dataset.warnTipBound === '1') return;
          btn.dataset.warnTipBound = '1';
          var tip = btn.querySelector('.supplier-debt-warn-tip');
          if (!tip) return;
          function showTip() {
            tip.classList.add('is-visible');
            positionSupplierDebtWarnTip(btn, tip);
          }
          function hideTip() {
            tip.classList.remove('is-visible');
          }
          btn.addEventListener('mouseenter', showTip);
          btn.addEventListener('mouseleave', hideTip);
          btn.addEventListener('focus', showTip);
          btn.addEventListener('blur', hideTip);
          window.addEventListener('scroll', hideTip, true);
          window.addEventListener('resize', function() {
            if (tip.classList.contains('is-visible')) positionSupplierDebtWarnTip(btn, tip);
          });
        });
      }
      bindSupplierDebtWarnTips(document);

      function setSupplierMetricsCell(row, field, value) {
        var cell = row.querySelector('[data-field="' + field + '"]');
        if (!cell) return;
        cell.classList.remove('supplier-metrics-loading', 'supplier-metrics-error');
        if (field === 'tong-no') {
          var debtValue = cell.querySelector('[data-debt-value]');
          if (debtValue) {
            debtValue.textContent = formatSupplierSignedMoney(value);
            setSupplierMoneyTone(debtValue, value);
            return;
          }
        }
        if (field === 'tong-no-cuoi') {
          var finalDebtValue = cell.querySelector('[data-final-debt-value]');
          if (finalDebtValue) {
            finalDebtValue.textContent = formatSupplierSignedMoney(value);
            setSupplierMoneyTone(finalDebtValue, value);
            return;
          }
        }
        if (field === 'tam-ung') {
          var advanceLink = cell.querySelector('.js-supplier-advance-link');
          if (advanceLink) {
            advanceLink.textContent = formatSupplierMoney(value);
