        function loadPane(pane, requestedUrl) {
          if (!pane || (!requestedUrl && pane.getAttribute('data-lazy-loaded') === '1') || pane.getAttribute('data-lazy-loading') === '1') return;
          var url = requestedUrl || pane.getAttribute('data-lazy-tab-url') || '';
