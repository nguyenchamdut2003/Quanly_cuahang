<!doctype html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Nhà cung cấp</title>
  <link rel="stylesheet" href="/stylesheets/style.css">
  <link rel="stylesheet" href="/stylesheets/responsive.css">
  <link rel="stylesheet" href="/stylesheets/global-loading.css">
  <style>
    <%- include('partials/_purchase-inline-styles') %>
    .detail-pane{display:none}
    .detail-pane.is-active{display:block}
    .text-right { text-align: right; }
    .status-pill {
      display: inline-flex;
      align-items: center;
      height: 24px;
      padding: 0 10px;
      border-radius: 5px;
      font-size: 11px;
      font-weight: 700;
      white-space: nowrap;
    }
    .status-pill.is-active { background: #dcfce7; color: #166534; }
    .status-pill.is-draft { background: #fef9c3; color: #854d0e; }
    .status-pill.is-cancelled { background: #fee2e2; color: #991b1b; }
    .filter-check-row {
      display: flex;
      align-items: center;
      gap: 8px;
      margin: 8px 0;
      font-size: 13px;
      color: #344054;
      cursor: pointer;
      user-select: none;
    }
    .filter-check-row input { width: 15px; height: 15px; accent-color: #0070f4; cursor: pointer; }
    .supplier-debt-cell { display: inline-flex; align-items: center; justify-content: flex-end; gap: 6px; width: 100%; position: relative; }
    .supplier-debt-warn-btn {
      border: 0;
      background: transparent;
      color: #dc6803;
      font-size: 15px;
      line-height: 1;
      cursor: pointer;
      padding: 0;
      position: relative;
      flex: 0 0 auto;
    }
    .supplier-debt-warn-btn:hover { color: #b54708; }
    .supplier-debt-warn-tip {
      display: none;
      position: fixed;
      z-index: 12000;
      width: min(300px, calc(100vw - 24px));
      padding: 10px 12px;
      border-radius: 8px;
      border: 1px solid #fecdca;
      background: #fff7ed;
      color: #7a2e0e;
      font-size: 12px;
      line-height: 1.45;
      text-align: left;
      box-shadow: 0 10px 28px rgba(15, 23, 42, .18);
      font-weight: 500;
      white-space: normal;
      pointer-events: none;
    }
    .supplier-debt-warn-tip.is-visible { display: block; }
    .supplier-debt-warn-tip strong { color: #b42318; font-weight: 800; }
    .supplier-partner-export-btn {
      max-width: 150px;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      display: inline-block;
      vertical-align: middle;
    }
    .supplier-metrics-loading { color: #64748b; }
    .supplier-metrics-error { color: #b42318; font-weight: 700; }
    .supplier-money-positive { color: #047857; font-weight: 700; }
    .supplier-money-negative { color: #dc2626; font-weight: 700; }
    .supplier-list-panel {
      overflow: visible;
    }
    .supplier-list-panel > .table-wrap {
      overflow-x: auto;
      overflow-y: visible;
    }
    .supplier-list-panel .store-table td,
    .supplier-list-panel .store-table th {
      overflow: visible;
    }
    .supplier-address-table{table-layout:fixed}
    .supplier-address-table th:nth-child(1),
    .supplier-address-table td:nth-child(1){width:150px;max-width:150px}
    .supplier-address-table th:nth-child(2),
    .supplier-address-table td:nth-child(2){width:120px;max-width:120px}
    .supplier-address-table th:nth-child(3),
    .supplier-address-table td:nth-child(3){width:170px;max-width:170px}
    .supplier-address-table th:nth-child(4),
    .supplier-address-table td:nth-child(4){width:180px;max-width:180px}
    .supplier-address-table th:nth-child(6),
    .supplier-address-table td:nth-child(6){width:140px;max-width:140px;white-space:nowrap}
    .supplier-address-table th:nth-child(7),
    .supplier-address-table td:nth-child(7){width:108px;max-width:108px}
    .supplier-address-table th:nth-child(8),
    .supplier-address-table td:nth-child(8){width:180px;max-width:180px;min-width:180px}
    .supplier-address-table td:nth-child(8).warehouse-action-cell{padding-left:6px!important;padding-right:6px!important}
    .supplier-address-table td:nth-child(8) .warehouse-action-buttons{gap:6px;justify-content:center;flex-wrap:nowrap}
    .supplier-address-table .js-ghn-province,
    .supplier-address-table .js-ghn-ward{width:100%;height:36px;border:1px solid #cfd8e3;border-radius:6px;background:#fff;padding:0 8px;font-size:13px}
    .profit-positive{color:#047857}
    .profit-negative{color:#b42318}
    .supplier-address-profit-detail-row td{background:#f8fafc!important;padding:10px 12px!important}
    .supplier-address-profit-detail{display:grid;gap:10px}
    .supplier-address-profit-summary{display:flex;gap:18px;flex-wrap:wrap;font-size:12px;color:#475467}
    .supplier-address-profit-table{margin:0}
    .supplier-address-profit-table th,.supplier-address-profit-table td{font-size:12px}
    .filter-range-stack { display: grid; gap: 8px; margin-top: 8px; }
    .filter-range-stack label span { display: block; font-size: 12px; color: #667085; margin-bottom: 4px; }
    .filter-range-stack input {
      width: 100%;
      height: 31px;
      border: 1px solid #cfd8e3;
      border-radius: 7px;
      padding: 0 10px;
      font-size: 13px;
    }
    .supplier-debt-row-overdue td { background: #fff1f0 !important; color: #b42318; }
    .supplier-debt-row-overdue td strong { color: #b42318; }
    .supplier-debt-row-paid td { color: #667085; }
    .supplier-debt-sort-check {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      margin-right: 8px;
      font-size: 12px;
      color: #344054;
      white-space: nowrap;
      user-select: none;
      cursor: pointer;
    }
    .supplier-debt-sort-check input { accent-color: #0070f4; }
    .supplier-debt-actions { flex-wrap: wrap; }
    .table-code-link {
      color: #0070f4;
      text-decoration: none;
      font-weight: 600;
      display: inline-flex;
      align-items: center;
      gap: 5px;
    }
    .table-code-link:hover { text-decoration: underline; }
    .history-type-icon { font-size: 14px; width: 16px; text-align: center; color: #2563eb; }
    .history-type-icon--return { color: #ef4444; }
    .history-amount { font-weight: 700; font-size: 14px; }
    .history-amount.is-return { color: #ef4444; }
    .history-creator { display: flex; align-items: center; gap: 6px; }
    .history-creator-avatar {
      width: 24px;
      height: 24px;
      border-radius: 50%;
      background: #f1f5f9;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 10px;
      font-weight: 700;
      color: #64748b;
      flex-shrink: 0;
    }
    .supplier-metric-readonly { font-size: 14px; font-weight: 700; color: #111827; }
    .supplier-metric-hint { font-size: 11px; color: #64748b; margin-top: 2px; font-weight: 400; }
    .supplier-create-modal { max-width: 760px; }
    .supplier-create-form.modal-body { max-height: 70vh; overflow: auto; padding: 20px 24px; }
    .supplier-readonly-input { background: transparent !important; border: none !important; cursor: default; }

    .supplier-page .product-detail-row > td {
      padding: 0 !important;
      background: #f8fbff !important;
      border: 1px solid #dbeafe !important;
    }
    .supplier-page tr.is-selected > td { background: #eff6ff; }

    .supplier-detail {
      border: 1px solid #dbeafe;
      border-radius: 8px;
      margin: 10px;
      background: #fff;
      overflow: hidden;
    }
    .supplier-detail-body { padding: 14px 16px 16px; }

    .supplier-detail .detail-tabs {
      padding: 0 14px;
      min-height: 44px;
      height: auto;
      border-bottom: 1px solid #e2e8f0;
      background: #f8fafc;
    }
    .supplier-detail .detail-tab-list { gap: 18px; flex-wrap: wrap; }
    .supplier-detail .detail-tab {
      height: 44px;
      border: 0;
      border-bottom: 2px solid transparent;
      border-radius: 0;
      background: transparent;
      color: #64748b;
      font-size: 13px;
      font-weight: 700;
    }
    .supplier-detail .detail-tab.is-active {
      color: #2563eb;
      border-bottom-color: #2563eb;
      background: transparent;
      box-shadow: none;
    }
    .supplier-detail .detail-tab:hover:not(.is-active) {
      color: #2563eb;
      background: transparent;
    }
    .supplier-info-block {
      display: flex;
      align-items: center;
      gap: 16px;
      margin-bottom: 16px;
      padding-bottom: 16px;
      border-bottom: 1px solid #e2e8f0;
    }
    .supplier-info-avatar {
      width: 72px;
      height: 72px;
      border-radius: 10px;
      background: linear-gradient(135deg, #eff6ff, #dbeafe);
      color: #2563eb;
      font-weight: 800;
      font-size: 18px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    .supplier-info-main h2 {
      margin: 0 0 4px;
      font-size: 18px;
      color: #0f172a;
    }
    .supplier-info-main p { margin: 0 0 8px; font-size: 13px; }
    .supplier-info-tags { display: flex; flex-wrap: wrap; gap: 6px; }

    .supplier-detail-fields {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 14px 20px;
      margin: 0;
    }
    .supplier-detail-field-full { grid-column: 1 / -1; }
    .supplier-inline-edit-error {
      margin-top: 16px;
      padding: 10px 12px;
      border: 1px solid #fecdca;
      border-radius: 6px;
      background: #fff1f0;
      color: #b42318;
      font-size: 13px;
    }

    .supplier-pane-toolbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 10px;
      margin-bottom: 12px;
    }
    .supplier-import-wrap{position:relative;display:inline-flex}
    .supplier-import-menu{position:absolute;top:calc(100% + 6px);right:0;min-width:180px;display:none;z-index:20;border:1px solid #d0d5dd;border-radius:8px;background:#fff;box-shadow:0 14px 30px rgba(16,24,40,.15);overflow:hidden}
    .supplier-import-menu.is-open{display:block}
    .supplier-import-menu button,.supplier-import-menu a{display:block;width:100%;border:0;background:#fff;text-align:left;padding:10px 14px;font-size:13px;color:#111827;text-decoration:none;cursor:pointer}
    .supplier-import-menu button:hover,.supplier-import-menu a:hover{background:#f8fafc}
    .supplier-import-menu a + button{border-top:1px solid #f2f4f7}
    .supplier-debt-toolbar { margin-bottom: 14px; }
    .supplier-debt-summary {
      display: flex;
      align-items: baseline;
      gap: 8px;
    }
    .supplier-debt-summary-label {
      font-size: 13px;
      color: #64748b;
      font-weight: 600;
    }
    .supplier-debt-summary-value {
      font-size: 18px;
      color: #dc2626;
      font-weight: 800;
    }
    .supplier-debt-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      justify-content: flex-end;
    }

    .supplier-pane-table-wrap {
      border: 1px solid #e2e8f0;
      border-radius: 8px;
      overflow: auto;
      background: #fff;
    }
    .supplier-pane-table-wrap .admin-table { margin-bottom: 0; }
    .supplier-pane-table-wrap thead th {
      background: #f8fafc;
      font-size: 12px;
      white-space: nowrap;
    }
    .supplier-pane-table-wrap .text-center {
      text-align: center;
    }
    .supplier-pane-table-wrap .empty-cell {
      padding: 32px 16px !important;
      text-align: center;
      color: #64748b;
    }
    .supplier-muted-cell { color: #475569; }
    .supplier-history-filter { margin: 0 0 12px; justify-content: flex-start; }
    .supplier-history-filter .form-control { width: auto; min-width: 150px; }
    .supplier-history-filter input { flex: 1; }
    .supplier-history-code { display: inline-flex; align-items: center; gap: 6px; }
    .supplier-history-source-number { display: inline-flex; align-items: center; justify-content: center; width: 20px; height: 20px; flex-shrink: 0; box-sizing: border-box; border: 1px solid currentColor; border-radius: 50%; color: #667085; font-size: 12px; font-weight: 600; line-height: 1; }
    .supplier-purchase-history .lot-detail-row > td { padding: 12px 16px !important; }
    .supplier-purchase-history .lot-detail-row .supplier-history-code { padding-left: 28px; }

    .supplier-address-expand { background: #f8fafc !important; }
    .supplier-address-expand-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 12px 16px;
      padding: 14px 16px;
    }
    .supplier-address-expand-grid label {
      display: block;
      margin-bottom: 4px;
      font-size: 12px;
      font-weight: 700;
      color: #475569;
    }
    .supplier-address-expand-grid .span-2 { grid-column: span 2; }
    .supplier-address-default-check {
      display: flex;
      align-items: center;
    }
    .supplier-address-default-check label {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      margin: 0;
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
    }

    .supplier-detail-footer {
      display: flex;
      justify-content: flex-end;
      align-items: center;
      flex-wrap: wrap;
      gap: 8px;
      padding: 12px 18px;
      border-top: 1px solid #e2e8f0;
      background: #fbfdff;
    }

    .debt-period-modal-overlay {
      display: none;
      position: fixed;
      inset: 0;
      z-index: 1200;
      background: rgba(15, 23, 42, 0.45);
      align-items: center;
      justify-content: center;
      padding: 16px;
    }
    .debt-period-modal-overlay.is-open { display: flex; }
    .supplier-advance-link {
      border: 0;
      background: transparent;
      padding: 0;
      color: #2563eb;
      font: inherit;
      font-weight: 700;
      cursor: pointer;
      text-decoration: underline;
      text-underline-offset: 2px;
    }
    .supplier-advance-link:hover { color: #1d4ed8; }
    .supplier-advance-modal-overlay {
      display: none;
      position: fixed;
      inset: 0;
      z-index: 1300;
      background: rgba(15, 23, 42, 0.45);
      align-items: flex-start;
      justify-content: center;
      padding: 24px 16px;
      overflow: auto;
    }
    .supplier-advance-modal-overlay.is-open { display: flex; }
    .supplier-advance-modal {
      width: min(1100px, 100%);
      background: #fff;
      border-radius: 10px;
      box-shadow: 0 20px 50px rgba(15, 23, 42, 0.2);
      overflow: hidden;
      margin-top: 24px;
    }
    .supplier-advance-modal__header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 14px 16px;
      border-bottom: 1px solid #e2e8f0;
    }
    .supplier-advance-modal__header h3 { margin: 0; font-size: 16px; }
    .supplier-advance-modal__close {
      border: none;
      background: transparent;
      font-size: 22px;
      line-height: 1;
      cursor: pointer;
      color: #64748b;
    }
    .supplier-advance-modal__body { padding: 16px; }
    .supplier-advance-modal__toolbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 12px;
    }
    .supplier-advance-modal__desc {
      margin: 0;
      color: #64748b;
      font-size: 13px;
      flex: 1 1 auto;
      min-width: 0;
    }
    .supplier-advance-modal__actions {
      display: flex;
      align-items: center;
      gap: 8px;
      flex: 0 0 auto;
    }
    .supplier-advance-modal__table-wrap {
      overflow: auto;
      max-height: min(520px, calc(100vh - 220px));
      border: 1px solid #e2e8f0;
      border-radius: 8px;
    }
    .supplier-advance-modal__table {
      width: 100%;
      border-collapse: collapse;
      font-size: 13px;
    }
    .supplier-advance-modal__table th,
    .supplier-advance-modal__table td {
      padding: 10px 12px;
      border-bottom: 1px solid #eef2f7;
      text-align: left;
      white-space: nowrap;
    }
    .supplier-advance-modal__table th {
      background: #f8fafc;
      color: #475569;
      font-weight: 700;
      position: sticky;
      top: 0;
      z-index: 1;
    }
    .supplier-advance-modal__table td.num,
    .supplier-advance-modal__table th.num { text-align: right; }
    .supplier-advance-modal__table th.note,
    .supplier-advance-modal__table td.note {
      width: 180px;
      max-width: 180px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .supplier-advance-modal__table th.actions,
    .supplier-advance-modal__table td.actions {
      width: 64px;
      text-align: center;
      overflow: visible;
      white-space: normal;
    }
    .supplier-advance-action-menu {
      position: relative;
      display: inline-flex;
      justify-content: center;
      width: 100%;
    }
    .supplier-advance-more-btn {
      width: 32px;
      height: 32px;
      border: 1px solid #cfd8e3;
      background: #fff;
      color: #344054;
      border-radius: 6px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      font-size: 18px;
      line-height: 1;
      padding: 0;
    }
    .supplier-advance-more-btn:hover,
    .supplier-advance-action-menu.is-open .supplier-advance-more-btn {
      border-color: #0070f4;
      color: #006dff;
      background: #eff6ff;
    }
    .supplier-advance-more-btn:disabled {
      opacity: .45;
      cursor: not-allowed;
    }
    .supplier-advance-action-dropdown {
      position: fixed;
      top: 0;
      left: 0;
      z-index: 1500;
      display: none;
      min-width: 168px;
      padding: 6px;
      border: 1px solid #d9e2ec;
      border-radius: 7px;
      background: #fff;
      box-shadow: 0 12px 24px rgba(15, 23, 42, .16);
    }
    .supplier-advance-action-menu.is-open .supplier-advance-action-dropdown { display: block; }
    .supplier-advance-menu-item {
      width: 100%;
      min-height: 34px;
      border: 0;
      border-radius: 5px;
      background: transparent;
      color: #1f2937;
      padding: 0 9px;
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 13px;
      font-weight: 700;
      text-align: left;
      cursor: pointer;
      white-space: nowrap;
    }
    .supplier-advance-menu-item:hover { background: #f1f5f9; color: #006dff; }
    .supplier-advance-modal__empty {
      padding: 28px 16px;
      text-align: center;
      color: #94a3b8;
    }
    .supplier-advance-modal__footer {
      display: flex;
      justify-content: flex-end;
      padding: 12px 16px;
      border-top: 1px solid #e2e8f0;
      background: #f8fafc;
    }
    .supplier-advance-create-overlay {
      display: none;
      position: fixed;
      inset: 0;
      z-index: 1400;
      background: rgba(15, 23, 42, 0.45);
      align-items: flex-start;
      justify-content: center;
      padding: 24px 16px;
      overflow: auto;
    }
    .supplier-advance-create-overlay.is-open { display: flex; }
    .supplier-advance-create-modal {
      width: min(560px, 100%);
      background: #fff;
      border-radius: 10px;
      box-shadow: 0 20px 50px rgba(15, 23, 42, 0.2);
      overflow: hidden;
      margin-top: 40px;
    }
    .supplier-advance-create-modal__header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 14px 16px;
      border-bottom: 1px solid #e2e8f0;
    }
    .supplier-advance-create-modal__header h3 { margin: 0; font-size: 16px; }
    .supplier-advance-create-modal__close {
      border: none;
      background: transparent;
      font-size: 22px;
      line-height: 1;
      cursor: pointer;
      color: #64748b;
    }
    .supplier-advance-create-modal__body {
      padding: 16px;
      display: grid;
      gap: 12px;
    }
    .supplier-advance-create-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }
    .supplier-advance-create-grid label {
      display: flex;
      flex-direction: column;
      gap: 6px;
      font-size: 13px;
      color: #475569;
    }
    .supplier-advance-create-grid label.full { grid-column: 1 / -1; }
    .supplier-advance-create-grid input,
    .supplier-advance-create-grid select,
    .supplier-advance-create-grid textarea {
      height: 36px;
      border: 1px solid #cfd8e3;
      border-radius: 6px;
      padding: 0 10px;
      font-size: 13px;
    }
    .supplier-advance-create-grid textarea {
      height: 72px;
      padding: 8px 10px;
      resize: vertical;
    }
    .supplier-advance-create-modal__footer {
      display: flex;
      justify-content: flex-end;
      gap: 8px;
      padding: 12px 16px;
      border-top: 1px solid #e2e8f0;
      background: #f8fafc;
    }
    .supplier-advance-action-overlay {
      display: none;
      position: fixed;
      inset: 0;
      z-index: 1450;
      background: rgba(15, 23, 42, 0.45);
      align-items: flex-start;
      justify-content: center;
      padding: 24px 16px;
      overflow: auto;
    }
    .supplier-advance-action-overlay.is-open { display: flex; }
    .supplier-advance-offset-modal {
      width: min(980px, 100%);
      background: #fff;
      border-radius: 10px;
      box-shadow: 0 20px 50px rgba(15, 23, 42, 0.2);
      overflow: hidden;
      margin-top: 24px;
    }
    .supplier-advance-offset-body { padding: 16px; }
    .supplier-advance-offset-hint {
      margin: 12px 0 8px;
      color: #64748b;
      font-size: 12px;
    }
    .supplier-advance-offset-table-wrap {
      max-height: min(360px, 45vh);
      overflow: auto;
      border: 1px solid #e5e7eb;
      border-radius: 8px;
    }
    .supplier-advance-offset-table th,
    .supplier-advance-offset-table td {
      vertical-align: middle;
      white-space: nowrap;
    }
    .supplier-advance-offset-table td.text-right {
      font-variant-numeric: tabular-nums;
    }
    .supplier-advance-offset-code-cell {
      min-width: 118px;
    }
    .supplier-advance-offset-code {
      display: block;
      font-weight: 700;
      color: #111827;
      line-height: 1.25;
      letter-spacing: 0.01em;
    }
    .supplier-advance-offset-type {
      display: block;
      margin-top: 2px;
      font-size: 11px;
      font-weight: 500;
      color: #94a3b8;
      line-height: 1.2;
    }
    .supplier-advance-offset-form .supplier-advance-create-grid {
      margin-bottom: 0;
    }
    #supplierAdvanceCreateAmount,
    #supplierAdvanceOffsetAmount,
    #supplierAdvanceOffsetRemain,
    #supplierAdvanceRefundRemain,
    #supplierAdvanceRefundAmount {
      background: #f8fafc;
      color: #0f172a;
      font-weight: 700;
      cursor: default;
    }
    @media (max-width: 640px) {
      .supplier-advance-create-grid { grid-template-columns: 1fr; }
    }
    .debt-period-modal {
      width: min(420px, 100%);
      background: #fff;
      border-radius: 10px;
      box-shadow: 0 20px 50px rgba(15, 23, 42, 0.2);
      overflow: hidden;
    }
    .debt-period-modal__header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 14px 16px;
      border-bottom: 1px solid #e2e8f0;
    }
    .debt-period-modal__header h3 { margin: 0; font-size: 16px; }
    .debt-period-modal__close {
      border: none;
      background: transparent;
      font-size: 22px;
      line-height: 1;
      cursor: pointer;
      color: #64748b;
    }
    .debt-period-modal__body { padding: 16px; display: grid; gap: 12px; }
    .debt-period-option {
      display: flex;
      align-items: center;
      gap: 8px;
      font-weight: 600;
      cursor: pointer;
    }
    .debt-period-range {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      padding: 10px 12px;
      border: 1px solid #e2e8f0;
      border-radius: 8px;
      background: #f8fafc;
    }
    .debt-period-field { display: grid; gap: 4px; font-size: 13px; }
    .debt-period-field input[type="date"] {
      border: 1px solid #cbd5e1;
      border-radius: 6px;
      padding: 6px 8px;
      font: inherit;
    }
    .debt-period-modal__footer {
      display: flex;
      justify-content: flex-end;
      gap: 8px;
      padding: 12px 16px;
      border-top: 1px solid #e2e8f0;
    }

    .address-type-list{display:grid;gap:8px;max-height:280px;overflow:auto}
    .address-type-row{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:8px;align-items:center;border:1px solid #e2e8f0;border-radius:6px;padding:8px}
    .address-type-row.is-default{background:#f8fafc}
    .address-type-name{font-weight:700;color:#111827}
    .address-type-code{font-size:11px;color:#64748b;margin-top:2px}
    .address-type-form-panel{display:grid;gap:14px;align-self:start}
    .address-type-actions{display:flex;gap:6px}
    .address-type-badge{display:inline-flex;align-items:center;height:24px;border-radius:999px;background:#eaf2ff;color:#0058d4;font-size:11px;font-weight:800;padding:0 8px}
    #addressTypeModalOverlay .group-modal{width:min(760px,calc(100vw - 96px));max-width:calc(100vw - 96px)}
    #addressTypeModalOverlay .group-modal-body{grid-template-columns:minmax(0,1.2fr) minmax(0,1fr);align-items:start;gap:14px 18px}
    #addressTypeModalOverlay .address-type-list{grid-row:span 2;max-height:420px}
    #addressTypeModalOverlay .address-type-row{padding:12px}
    #addressTypeModalOverlay .group-modal-footer{justify-content:space-between}
    @media (max-width:900px){
      #addressTypeModalOverlay .group-modal{width:min(520px,calc(100vw - 24px));max-width:calc(100vw - 24px)}
      #addressTypeModalOverlay .group-modal-body{grid-template-columns:1fr}
      #addressTypeModalOverlay .address-type-list{grid-row:auto;max-height:280px}
      .address-type-form-panel{gap:10px}
      #addressTypeModalOverlay .group-modal-footer{justify-content:flex-end}
    }

    .supplier-pay-modal-overlay {
      position: fixed;
      inset: 0;
      z-index: 2100;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 24px;
      background: rgba(17, 24, 39, .54);
    }
    .supplier-pay-modal-overlay.is-open { display: flex; }
    .supplier-pay-modal {
      width: min(900px, calc(100vw - 48px));
      max-height: calc(100vh - 48px);
      display: flex;
      flex-direction: column;
      overflow: hidden;
      background: #fff;
      border-radius: 10px;
      box-shadow: 0 24px 70px rgba(15, 23, 42, .28);
    }
    .supplier-pay-header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 16px;
      padding: 18px 24px 10px;
    }
    .supplier-pay-title { margin: 0 0 4px; font-size: 18px; color: #111827; }
    .supplier-pay-subtitle { display: flex; gap: 8px; align-items: center; color: #64748b; font-size: 12px; }
    .supplier-pay-debt-badge { padding: 2px 7px; border-radius: 4px; background: #f1f5f9; color: #334155; font-weight: 700; }
    .supplier-pay-close { border: 0; background: transparent; color: #4b5563; font-size: 30px; line-height: 1; cursor: pointer; }
    .supplier-pay-body { padding: 0 24px 12px; overflow: auto; }
    .supplier-pay-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px 22px; }
    .supplier-pay-field { display: flex; flex-direction: column; gap: 5px; font-size: 12px; color: #374151; }
    .supplier-pay-field-full { grid-column: 1 / -1; }
    .supplier-pay-input-wrap { position: relative; }
    .supplier-pay-field input,
    .supplier-pay-field select,
    .supplier-pay-field textarea {
      width: 100%;
      min-height: 30px;
      border: 1px solid #cfd8e3;
      border-radius: 6px;
      padding: 5px 12px;
      font-size: 13px;
      background: #fff;
      outline: none;
    }
    .supplier-pay-field textarea { min-height: 48px; resize: vertical; }
    .supplier-pay-field:has(select[name="phuong_thuc_thanh_toan"]),
    .supplier-pay-field:has(select[name="so_quy_id"]) { display: none; }
    .supplier-pay-field input:focus,
    .supplier-pay-field select:focus,
    .supplier-pay-field textarea:focus { border-color: #0070f4; box-shadow: 0 0 0 1px #0070f4; }
    .supplier-pay-mismatch-alert { border: 1px solid #fde68a; background: #fffbeb; color: #92400e; border-radius: 6px; padding: 10px 12px; margin-bottom: 12px; font-size: 13px; }
    .supplier-pay-mismatch-grid { display: grid; grid-template-columns: 160px 1fr; gap: 4px 12px; margin-top: 8px; color: #334155; }
    .supplier-pay-mismatch-grid b { color: #111827; }
    .supplier-pay-readonly { background: #f1f5f9 !important; text-align: right; color: #111827; }
    .supplier-pay-icons { position: absolute; right: 10px; top: 50%; transform: translateY(-50%); display: flex; gap: 10px; color: #4b5563; }
    .supplier-pay-check { display: inline-flex; align-items: center; gap: 8px; margin: 14px 0 6px; font-weight: 500; color: #1f2937; font-size: 13px; }
    .supplier-pay-check input { width: 14px; height: 14px; accent-color: #0070f4; }
    .supplier-pay-reconcile-note { margin: 0 0 8px; color: #64748b; font-size: 12px; }
    .supplier-pay-reconcile-note strong { color: #111827; }
    .supplier-pay-table-wrap { border-top: 0; min-height: 150px; background: #fff; }
    .supplier-pay-table-wrap table { min-width: 820px; }
    .supplier-pay-table-wrap th { background: #f1f3f5 !important; height: 38px; color: #374151; font-size: 12px; }
    .supplier-pay-table-wrap td { height: 40px; font-size: 13px; }
    .supplier-pay-row-input { width: 88px; height: 22px; border: 1px solid #cfd8e3; border-radius: 6px; text-align: right; padding: 2px 8px; font-size: 13px; outline: none; }
    .supplier-pay-row-input:focus { border-color: #0070f4; box-shadow: 0 0 0 1px #0070f4; }
    .supplier-pay-total-row td { font-weight: 800; border-top: 1px solid #e5e7eb; }
    .supplier-pay-unallocated-row td { border-bottom: 0; font-size: 13px; }
    .supplier-pay-empty { display: grid; place-items: center; gap: 14px; min-height: 210px; color: #1f2937; font-weight: 700; }
    .supplier-pay-empty-icon { width: 92px; height: 92px; border-radius: 50%; display: grid; place-items: center; background: #eff6ff; color: #1d7ff5; font-size: 42px; }
    .supplier-pay-footer {
      display: flex;
      justify-content: flex-end;
      gap: 10px;
      padding: 12px 24px;
      border-top: 1px solid #e5e7eb;
      background: #fff;
    }
    .supplier-pay-footer button:disabled { opacity: .5; cursor: not-allowed; }
    .supplier-pagination {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 12px 14px;
      border-top: 1px solid #e5e7eb;
      background: #fff;
      color: #475467;
      font-size: 14px;
    }
    .supplier-pagination__actions {
      display: flex;
      align-items: center;
      gap: 6px;
      flex-wrap: wrap;
    }
    .supplier-page-link {
      min-width: 32px;
      height: 30px;
      padding: 0 10px;
      border: 1px solid #cbd5e1;
      border-radius: 6px;
      background: #fff;
      color: #0f172a;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
    }
    .supplier-page-link.is-active {
      border-color: #0070f4;
      background: #0070f4;
      color: #fff;
    }
    .supplier-page-link.is-disabled {
      color: #94a3b8;
      background: #f8fafc;
      pointer-events: none;
    }

    @media (max-width: 1100px) {
      .supplier-detail-fields { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .supplier-address-expand-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }
  </style>
</head>
<body class="admin-body">
  <div id="appRoot">
    <%- include('../partials/header', { activeMenu: activeMenu, user: user }) %>

    <main class="admin-shell store-page supplier-page">
    <%- include('../partials/flash-message', { flash: flash }) %>
    <% filterQueryString = filterQueryString || ''; %>

    <div class="store-toolbar">
      <h1>Nhà cung cấp</h1>
      <div class="store-search">
        <span>⌕</span>
        <input type="search" placeholder="Theo mã, tên nhà cung cấp">
      </div>
      <div class="page-actions">
        <button class="btn btn-primary" type="button" id="openAddSupplierModal">+ Tạo mới</button>
        <div class="supplier-import-wrap">
          <button class="btn btn-light" type="button" id="supplierImportToggle" aria-haspopup="true" aria-expanded="false">Thêm bằng file ▾</button>
          <div class="supplier-import-menu" id="supplierImportMenu" role="menu" aria-label="Thêm bằng file">
            <a href="/nha-cung-cap/import/template.xlsx" role="menuitem">Lấy file mẫu</a>
            <button type="button" id="supplierImportPickBtn" role="menuitem">Thêm</button>
          </div>
        </div>
        <form id="supplierImportForm" method="post" action="/nha-cung-cap/import" enctype="multipart/form-data" hidden>
          <input type="file" name="file" id="supplierImportFile" accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet">
        </form>
        <a class="btn btn-light" href="/nha-cung-cap/export.xlsx?<%= filterQueryString || '' %>">Xuất file</a>
        <button class="btn btn-danger" type="submit" form="bulkDeleteSuppliersForm" onclick="return confirm('Xóa các nhà cung cấp đã chọn?')">Xóa đã chọn</button>
      </div>
    </div>

    <div id="addSupplierModalOverlay" class="modal-overlay" data-auto-open="<%= formMode === 'create' ? '1' : '0' %>">
      <div class="modal-content customer-create-modal supplier-create-modal">
        <div class="modal-header">
          <h3>Tạo nhà cung cấp</h3>
          <button type="button" class="modal-close" id="addSupplierModalClose" aria-label="Đóng">×</button>
        </div>
        <form class="modal-body store-form-grid supplier-create-form" method="post" action="/nha-cung-cap/add" id="supplierCreateForm">
          <label><span>Mã NCC</span><input name="ma_ncc" placeholder="Tự động nếu bỏ trống"></label>
          <label><span>Tên nhà cung cấp *</span><input name="ten_ncc" placeholder="Nhập tên nhà cung cấp" required></label>
          <label><span>Điện thoại</span><input name="sdt" placeholder="Nhập số điện thoại"></label>
          <label><span>Email</span><input name="email" type="email" placeholder="email@example.com"></label>
          <label><span>Tên công ty</span><input name="ten_cong_ty" placeholder="Nhập tên công ty"></label>
          <label><span>Mã số thuế</span><input name="ma_so_thue" placeholder="Nhập mã số thuế"></label>
          <label><span>Tổng nợ</span><strong class="supplier-metric-readonly">0</strong>
            <span class="supplier-metric-hint"> — Tự động tính từ công nợ phiếu nhập</span>
          </label>
          <label><span>Tổng mua</span><strong class="supplier-metric-readonly">0</strong>
            <span class="supplier-metric-hint"> — Tự động tính từ phiếu đã nhập hàng</span>
          </label>
          <label class="span-2"><span>Ghi chú</span><input name="ghi_chu" placeholder="Nhập ghi chú"></label>
          <label><span>Trạng thái</span>
            <select name="trang_thai">
              <option value="active" selected>Đang hoạt động</option>
              <option value="inactive">Ngừng hoạt động</option>
            </select>
          </label>
        </form>
        <div class="page-actions modal-footer">
          <button class="btn btn-light" type="button" id="addSupplierModalCancel">Bỏ qua</button>
          <button class="btn btn-primary" type="submit" form="supplierCreateForm">Lưu</button>
        </div>
      </div>
    </div>

    <div class="store-layout">
      <aside class="store-filter-panel">
        <form method="get" action="/nha-cung-cap" class="store-filter-form">
          <section class="customer-filter-section">
            <div class="customer-filter-title-row">
              <h4>Nhóm nhà cung cấp</h4>
              <button class="filter-link-btn" type="button" id="supplierGroupAddBtn">Tạo mới</button>
            </div>
            <% var selectedSupplierGroup = (supplierGroups || []).find(function(group) { return filter.groupId === String(group._id); }); %>
            <div class="group-manage-wrapper" id="supplierGroupManageSidebar">
              <div class="group-manage-header">
                <button class="group-manage-trigger" type="button" id="supplierGroupFilterTrigger">
                  <span id="supplierGroupFilterLabel"><%= selectedSupplierGroup ? selectedSupplierGroup.ten_nhom_ncc : 'Tất cả các nhóm' %></span>
                  <span>▾</span>
                </button>
              </div>
              <input type="hidden" name="groupId" id="supplierGroupFilterValue" value="<%= filter.groupId || 'all' %>">
              <div class="group-manage-dropdown" id="supplierGroupFilterDropdown">
                <div class="group-manage-item <%= (!filter.groupId || filter.groupId === 'all') ? 'is-active' : '' %>" data-id="" data-value="all" data-name="Tất cả các nhóm" data-desc="">
                  <button class="group-manage-option" type="button">Tất cả các nhóm</button>
                </div>
                <% (supplierGroups || []).forEach(function(group) { %>
                  <div class="group-manage-item <%= filter.groupId === String(group._id) ? 'is-active' : '' %>" data-id="<%= group._id %>" data-value="<%= group._id %>" data-name="<%= group.ten_nhom_ncc || '---' %>" data-desc="<%= group.mo_ta || '' %>">
                    <button class="group-manage-option" type="button"><%= group.ten_nhom_ncc || '---' %></button>
                    <div class="group-manage-actions">
                      <button class="group-manage-action-edit" type="button">Sửa</button>
                      <button class="group-manage-action-delete" type="button">Xóa</button>
                    </div>
                  </div>
                <% }) %>
              </div>
            </div>
            <input type="hidden" name="debtDaySort" id="debtDaySortInput" value="<%= filter.debtDaySort || '' %>">
            <h4 style="margin-top:16px">Sắp xếp theo ngày nợ</h4>
            <label class="filter-check-row">
              <input type="checkbox" id="debtSortOldest" value="oldest" <%= filter.debtDaySort === 'oldest' ? 'checked' : '' %>>
              <span>Số ngày nợ xa nhất</span>
            </label>
            <label class="filter-check-row">
              <input type="checkbox" id="debtSortNewest" value="newest" <%= filter.debtDaySort === 'newest' ? 'checked' : '' %>>
              <span>Số ngày nợ gần nhất</span>
            </label>
            <h4 style="margin-top:16px">Lọc cảnh báo nợ</h4>
            <label class="filter-check-row">
              <input type="checkbox" name="warnOnly" value="1" id="warnOnlyCheckbox" <%= filter.warnOnly === '1' ? 'checked' : '' %>>
              <span>Chỉ hiện NCC có cảnh báo</span>
            </label>
            <div class="filter-range-stack">
              <label>
                <span>Quá số ngày</span>
                <input type="number" min="0" step="1" name="warnMinDays" value="<%= filter.warnMinDays || debtWarnDefaultDays || 10 %>">
              </label>
              <label>
                <span>Quá số tiền (VNĐ)</span>
                <input type="text" inputmode="numeric" class="js-vn-money-filter" name="warnMinAmount" value="<%= typeof formatFilterMoney === 'function' ? formatFilterMoney(filter.warnMinAmount) : (filter.warnMinAmount || '') %>" placeholder="Không giới hạn" autocomplete="off">
              </label>
            </div>
          </section>
        </form>
      </aside>

      <section class="store-table-panel supplier-list-panel">
        <div class="table-wrap">
          <form id="bulkDeleteSuppliersForm" method="post" action="/nha-cung-cap/delete-selected"></form>
          <%
            var supplierSummaryTotals = (suppliers || []).reduce(function(sum, s) {
              sum.totalPurchase += Number(s.tong_mua || 0);
              sum.totalPaid += Number(s.da_thanh_toan || 0);
              sum.totalDebt += Number(s.tong_no || 0);
              sum.totalAdvance += Number(s.tam_ung || 0);
              sum.totalFinalDebt += Number(s.tong_no_cuoi != null ? s.tong_no_cuoi : (Number(s.tong_no || 0) - Number(s.tam_ung || 0)));
              return sum;
            }, { totalPurchase: 0, totalPaid: 0, totalDebt: 0, totalAdvance: 0, totalFinalDebt: 0 });
          %>
          <table class="admin-table store-table" data-kv-master="nha-cung-cap">
            <thead>
              <tr>
                <th class="check-cell"><input id="selectAllSuppliers" type="checkbox" aria-label="Chọn tất cả"></th>
                <th>Mã NCC</th><th>Tên nhà cung cấp</th><th>Điện thoại</th><th>Email</th><th>Tổng mua</th><th>Đã thanh toán</th><th>Tổng nợ</th><th>Tạm ứng</th><th>Tổng nợ cuối</th><th>Trạng thái</th>
              </tr>
            </thead>
            <tbody>
              <tr class="customer-summary-row">
                <td class="check-cell"></td>
                <td colspan="4" style="text-align: right; font-weight: bold; color: #1e293b;">Tổng cộng:</td>
                <td data-summary-field="tong-mua"><strong><%= Number(supplierSummaryTotals.totalPurchase || 0).toLocaleString('vi-VN') %></strong></td>
                <td data-summary-field="da-thanh-toan"><strong><%= Number(supplierSummaryTotals.totalPaid || 0).toLocaleString('vi-VN') %></strong></td>
                <td data-summary-field="tong-no"><strong class="<%= Number(supplierSummaryTotals.totalDebt || 0) > 0 ? 'supplier-money-positive' : (Number(supplierSummaryTotals.totalDebt || 0) < 0 ? 'supplier-money-negative' : '') %>"><%= Number(supplierSummaryTotals.totalDebt || 0).toLocaleString('vi-VN') %></strong></td>
                <td data-summary-field="tam-ung"><strong><%= Number(supplierSummaryTotals.totalAdvance || 0).toLocaleString('vi-VN') %></strong></td>
                <td data-summary-field="tong-no-cuoi"><strong class="<%= Number(supplierSummaryTotals.totalFinalDebt || 0) > 0 ? 'supplier-money-positive' : (Number(supplierSummaryTotals.totalFinalDebt || 0) < 0 ? 'supplier-money-negative' : '') %>"><%= Number(supplierSummaryTotals.totalFinalDebt || 0).toLocaleString('vi-VN') %></strong></td>
                <td></td>
              </tr>
              <% if (suppliers.length === 0) { %>
                <tr><td colspan="11" class="empty-cell">Không có nhà cung cấp phù hợp với bộ lọc.</td></tr>
              <% } %>
              <% suppliers.forEach(function(supplier) { %>
                <% var listBase = typeof buildSupplierPageUrl === 'function' ? buildSupplierPageUrl(pagination ? pagination.page : 1) : ('/nha-cung-cap' + (filterQueryString ? ('?' + filterQueryString) : '')); %>
                <% var tamUng = Number(supplier.tam_ung || 0); %>
                <% var tongNoCuoi = supplier.tong_no_cuoi != null ? Number(supplier.tong_no_cuoi) : (Number(supplier.tong_no || 0) - tamUng); %>
                <tr
                  class="supplier-row"
                  data-kv-detail-id="<%= supplier._id %>"
                  data-supplier-id="<%= supplier._id %>"
                  data-metrics-loading="<%= supplier.metrics_pending ? 'true' : 'false' %>"
                  data-metric-tong-mua="<%= Number(supplier.tong_mua || 0) %>"
                  data-metric-da-thanh-toan="<%= Number(supplier.da_thanh_toan || 0) %>"
                  data-metric-tong-no="<%= Number(supplier.tong_no || 0) %>"
                  data-metric-tam-ung="<%= tamUng %>"
                  data-metric-tong-no-cuoi="<%= tongNoCuoi %>"
                >
                  <td class="check-cell" onclick="event.stopPropagation()"><input class="supplier-checkbox" type="checkbox" name="ids" value="<%= supplier._id %>" form="bulkDeleteSuppliersForm" aria-label="Chọn nhà cung cấp"></td>
                  <td><a class="table-code-link kv-detail-code-link" href="<%= listBase %>"><%= supplier.ma_ncc || '---' %></a></td>
                  <td><strong><a class="table-code-link kv-detail-code-link" href="<%= listBase %>"><%= supplier.ten_ncc || '---' %></a></strong></td>
                  <td><%= supplier.sdt || '---' %></td>
                  <td><%= supplier.email || '---' %></td>
                  <td data-field="tong-mua" class="<%= supplier.metrics_pending ? 'supplier-metrics-loading' : '' %>"><%= Number(supplier.tong_mua || 0).toLocaleString('vi-VN') %></td>
                  <td data-field="da-thanh-toan" class="<%= supplier.metrics_pending ? 'supplier-metrics-loading' : '' %>"><%= Number(supplier.da_thanh_toan || 0).toLocaleString('vi-VN') %></td>
                  <td data-field="tong-no" class="<%= supplier.metrics_pending ? 'supplier-metrics-loading' : '' %>">
                    <div class="supplier-debt-cell">
                      <span data-debt-value class="<%= Number(supplier.tong_no || 0) > 0 ? 'supplier-money-positive' : (Number(supplier.tong_no || 0) < 0 ? 'supplier-money-negative' : '') %>"><%= Number(supplier.tong_no || 0).toLocaleString('vi-VN') %></span>
                      <% if (supplier.debt_warning) { %>
                        <button
                          type="button"
                          class="supplier-debt-warn-btn js-supplier-debt-warn"
                          data-supplier-id="<%= supplier._id %>"
                          aria-label="Cảnh báo nợ quá hạn"
                        >⚠️
                          <span class="supplier-debt-warn-tip">
                            NCC có khoản nợ quá hạn <strong><%= Number(supplier.so_ngay_no_xa || 0).toLocaleString('vi-VN') %></strong> ngày.<br>
                            Tổng nợ còn lại: <strong><%= Number(supplier.tong_no || 0).toLocaleString('vi-VN') %> VNĐ</strong>.<br>
                            <% if (supplier.no_xa_nhat_ma_phieu) { %>
                              Khoản nợ lâu nhất: <strong><%= supplier.no_xa_nhat_ma_phieu %></strong> (<%= Number(supplier.no_xa_nhat_tien || 0).toLocaleString('vi-VN') %> VNĐ).
                            <% } %>
                          </span>
                        </button>
                      <% } %>
                    </div>
                  </td>
                  <td data-field="tam-ung" class="<%= supplier.metrics_pending ? 'supplier-metrics-loading' : '' %>">
                    <button
                      type="button"
                      class="supplier-advance-link js-supplier-advance-link"
                      data-supplier-id="<%= supplier._id %>"
                      data-supplier-code="<%= supplier.ma_ncc || '' %>"
                      data-supplier-name="<%= supplier.ten_ncc || '' %>"
                    ><%= tamUng.toLocaleString('vi-VN') %></button>
                  </td>
                  <td data-field="tong-no-cuoi" class="<%= supplier.metrics_pending ? 'supplier-metrics-loading' : '' %>">
                    <span data-final-debt-value class="<%= tongNoCuoi > 0 ? 'supplier-money-positive' : (tongNoCuoi < 0 ? 'supplier-money-negative' : '') %>"><%= tongNoCuoi.toLocaleString('vi-VN') %></span>
                  </td>
                  <td><span class="status-pill <%= supplier.trang_thai === 'active' ? 'is-active' : '' %>"><%= supplier.trang_thai === 'active' ? 'Hoạt động' : 'Ngừng hoạt động' %></span></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <% if (pagination) { %>
          <div class="supplier-pagination">
            <div>Hiển thị <strong><%= pagination.from %>-<%= pagination.to %></strong> / <strong><%= pagination.total %></strong> nhà cung cấp</div>
            <div class="supplier-pagination__actions" aria-label="Phân trang nhà cung cấp">
