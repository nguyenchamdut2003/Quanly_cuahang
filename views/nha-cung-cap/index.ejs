      function syncSupplierPayAllocationJson(form) {
        var hidden = form ? form.querySelector('.js-supplier-pay-allocations-json') : null;
        if (hidden) hidden.value = JSON.stringify(getSupplierPayRowAllocations(form));
        var amountInput = form ? form.querySelector('.js-supplier-pay-amount') : null;
        var overpaymentInput = form ? form.querySelector('.js-supplier-pay-overpayment') : null;
        if (overpaymentInput) {
          var amount = syncSupplierPayV2Total(form) || parseSupplierMoneyAmount(amountInput ? amountInput.value : 0);
          var payableDebt = Math.max(0, Number(form.getAttribute('data-current-debt') || 0));
          overpaymentInput.value = String(Math.max(0, amount - payableDebt));
