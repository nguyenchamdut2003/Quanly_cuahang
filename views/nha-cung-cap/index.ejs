<!doctype html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <link rel="stylesheet" href="/stylesheets/style.css">
  <link rel="stylesheet" href="/stylesheets/responsive.css">
  <style>
    .detail-pane{display:none}
    .detail-pane.is-active{display:block}
    .text-right { text-align: right; }
    .status-pill {
      display: inline-flex;
      align-items: center;
      height: 24px;
      padding: 0 10px;
      border-radius: 5px;
      font-size: 11px;
      font-weight: 700;
      white-space: nowrap;
    }
    .status-pill.is-active { background: #dcfce7; color: #166534; }
    .status-pill.is-draft { background: #fef9c3; color: #854d0e; }
    .status-pill.is-cancelled { background: #fee2e2; color: #991b1b; }
    .filter-check-row {
      display: flex;
      align-items: center;
      gap: 8px;
      margin: 8px 0;
      font-size: 13px;
      color: #344054;
      cursor: pointer;
      user-select: none;
    }
    .filter-check-row input { width: 15px; height: 15px; accent-color: #0070f4; cursor: pointer; }
    .supplier-debt-cell { display: inline-flex; align-items: center; justify-content: flex-end; gap: 6px; width: 100%; position: relative; }
    .supplier-debt-warn-btn {
      border: 0;
      background: transparent;
      color: #dc6803;
      font-size: 15px;
      line-height: 1;
      cursor: pointer;
      padding: 0;
      position: relative;
      flex: 0 0 auto;
    }
    .supplier-debt-warn-btn:hover { color: #b54708; }
    .supplier-debt-warn-tip {
      display: none;
      position: fixed;
      z-index: 12000;
      width: min(300px, calc(100vw - 24px));
      padding: 10px 12px;
      border-radius: 8px;
      border: 1px solid #fecdca;
      background: #fff7ed;
      color: #7a2e0e;
      font-size: 12px;
      line-height: 1.45;
      text-align: left;
      box-shadow: 0 10px 28px rgba(15, 23, 42, .18);
      font-weight: 500;
      white-space: normal;
      pointer-events: none;
    }
    .supplier-debt-warn-tip.is-visible { display: block; }
    .supplier-debt-warn-tip strong { color: #b42318; font-weight: 800; }
    .supplier-metrics-loading { color: #64748b; }
    .supplier-metrics-error { color: #b42318; font-weight: 700; }
    .supplier-list-panel {
      overflow: visible;
    }
    .supplier-list-panel > .table-wrap {
      overflow-x: auto;
      overflow-y: visible;
    }
    .supplier-list-panel .store-table td,
    .supplier-list-panel .store-table th {
      overflow: visible;
    }
    .filter-range-stack { display: grid; gap: 8px; margin-top: 8px; }
    .filter-range-stack label span { display: block; font-size: 12px; color: #667085; margin-bottom: 4px; }
    .filter-range-stack input {
      width: 100%;
      height: 31px;
      border: 1px solid #cfd8e3;
      border-radius: 7px;
      padding: 0 10px;
      font-size: 13px;
    }
    .supplier-debt-row-overdue td { background: #fff1f0 !important; color: #b42318; }
    .supplier-debt-row-overdue td strong { color: #b42318; }
    .supplier-debt-row-paid td { color: #667085; }
    .supplier-debt-sort-check {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      margin-right: 8px;
      font-size: 12px;
      color: #344054;
      white-space: nowrap;
      user-select: none;
      cursor: pointer;
    }
    .supplier-debt-sort-check input { accent-color: #0070f4; }
    .supplier-debt-actions { flex-wrap: wrap; }
    .table-code-link {
      color: #0070f4;
      text-decoration: none;
      font-weight: 600;
      display: inline-flex;
      align-items: center;
      gap: 5px;
    }
    .table-code-link:hover { text-decoration: underline; }
    .history-type-icon { font-size: 14px; width: 16px; text-align: center; color: #2563eb; }
    .history-type-icon--return { color: #ef4444; }
    .history-amount { font-weight: 700; font-size: 14px; }
    .history-amount.is-return { color: #ef4444; }
    .history-creator { display: flex; align-items: center; gap: 6px; }
    .history-creator-avatar {
      width: 24px;
      height: 24px;
      border-radius: 50%;
      background: #f1f5f9;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 10px;
      font-weight: 700;
      color: #64748b;
      flex-shrink: 0;
    }
    .supplier-metric-readonly { font-size: 14px; font-weight: 700; color: #111827; }
    .supplier-metric-hint { font-size: 11px; color: #64748b; margin-top: 2px; font-weight: 400; }
    .supplier-create-modal { max-width: 760px; }
    .supplier-create-form.modal-body { max-height: 70vh; overflow: auto; padding: 20px 24px; }
    .supplier-readonly-input { background: transparent !important; border: none !important; cursor: default; }

    .supplier-page .product-detail-row > td {
      padding: 0 !important;
      background: #f8fbff !important;
      border: 1px solid #dbeafe !important;
    }
    .supplier-page tr.is-selected > td { background: #eff6ff; }

    .supplier-detail {
      border: 1px solid #dbeafe;
      border-radius: 8px;
      margin: 10px;
      background: #fff;
      overflow: hidden;
    }
    .supplier-detail-body { padding: 14px 16px 16px; }

    .supplier-detail .detail-tabs {
      padding: 0 14px;
      min-height: 44px;
      height: auto;
      border-bottom: 1px solid #e2e8f0;
      background: #f8fafc;
    }
    .supplier-detail .detail-tab-list { gap: 18px; flex-wrap: wrap; }
    .supplier-detail .detail-tab {
      height: 44px;
      border: 0;
      border-bottom: 2px solid transparent;
      border-radius: 0;
      background: transparent;
      color: #64748b;
      font-size: 13px;
      font-weight: 700;
    }
    .supplier-detail .detail-tab.is-active {
      color: #2563eb;
      border-bottom-color: #2563eb;
      background: transparent;
      box-shadow: none;
    }
    .supplier-detail .detail-tab:hover:not(.is-active) {
      color: #2563eb;
      background: transparent;
    }
    .supplier-info-block {
      display: flex;
      align-items: center;
      gap: 16px;
      margin-bottom: 16px;
      padding-bottom: 16px;
      border-bottom: 1px solid #e2e8f0;
    }
    .supplier-info-avatar {
      width: 72px;
      height: 72px;
      border-radius: 10px;
      background: linear-gradient(135deg, #eff6ff, #dbeafe);
      color: #2563eb;
      font-weight: 800;
      font-size: 18px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    .supplier-info-main h2 {
      margin: 0 0 4px;
      font-size: 18px;
      color: #0f172a;
    }
    .supplier-info-main p { margin: 0 0 8px; font-size: 13px; }
    .supplier-info-tags { display: flex; flex-wrap: wrap; gap: 6px; }

    .supplier-detail-fields {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 14px 20px;
      margin: 0;
    }
    .supplier-detail-field-full { grid-column: 1 / -1; }

    .supplier-pane-toolbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 10px;
      margin-bottom: 12px;
    }
    .supplier-import-wrap{position:relative;display:inline-flex}
    .supplier-import-menu{position:absolute;top:calc(100% + 6px);right:0;min-width:180px;display:none;z-index:20;border:1px solid #d0d5dd;border-radius:8px;background:#fff;box-shadow:0 14px 30px rgba(16,24,40,.15);overflow:hidden}
    .supplier-import-menu.is-open{display:block}
    .supplier-import-menu button,.supplier-import-menu a{display:block;width:100%;border:0;background:#fff;text-align:left;padding:10px 14px;font-size:13px;color:#111827;text-decoration:none;cursor:pointer}
    .supplier-import-menu button:hover,.supplier-import-menu a:hover{background:#f8fafc}
    .supplier-import-menu a + button{border-top:1px solid #f2f4f7}
    .supplier-debt-toolbar { margin-bottom: 14px; }
    .supplier-debt-summary {
      display: flex;
      align-items: baseline;
      gap: 8px;
    }
    .supplier-debt-summary-label {
      font-size: 13px;
      color: #64748b;
      font-weight: 600;
    }
    .supplier-debt-summary-value {
      font-size: 18px;
      color: #dc2626;
      font-weight: 800;
    }
    .supplier-debt-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      justify-content: flex-end;
    }

    .supplier-pane-table-wrap {
      border: 1px solid #e2e8f0;
      border-radius: 8px;
      overflow: auto;
      background: #fff;
    }
    .supplier-pane-table-wrap .admin-table { margin-bottom: 0; }
    .supplier-pane-table-wrap thead th {
      background: #f8fafc;
      font-size: 12px;
      white-space: nowrap;
    }
    .supplier-pane-table-wrap .text-center {
      text-align: center;
    }
    .supplier-pane-table-wrap .empty-cell {
      padding: 32px 16px !important;
      text-align: center;
      color: #64748b;
    }
    .supplier-muted-cell { color: #475569; }

    .supplier-address-expand { background: #f8fafc !important; }
    .supplier-address-expand-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 12px 16px;
      padding: 14px 16px;
    }
    .supplier-address-expand-grid label {
      display: block;
      margin-bottom: 4px;
      font-size: 12px;
      font-weight: 700;
      color: #475569;
    }
    .supplier-address-expand-grid .span-2 { grid-column: span 2; }
    .supplier-address-default-check {
      display: flex;
      align-items: center;
    }
    .supplier-address-default-check label {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      margin: 0;
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
    }

    .supplier-detail-footer {
      display: flex;
      justify-content: flex-end;
      align-items: center;
      flex-wrap: wrap;
      gap: 8px;
      padding: 12px 18px;
      border-top: 1px solid #e2e8f0;
      background: #fbfdff;
    }

    .debt-period-modal-overlay {
      display: none;
      position: fixed;
      inset: 0;
      z-index: 1200;
      background: rgba(15, 23, 42, 0.45);
      align-items: center;
      justify-content: center;
      padding: 16px;
    }
    .debt-period-modal-overlay.is-open { display: flex; }
    .debt-period-modal {
      width: min(420px, 100%);
      background: #fff;
      border-radius: 10px;
      box-shadow: 0 20px 50px rgba(15, 23, 42, 0.2);
      overflow: hidden;
    }
    .debt-period-modal__header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 14px 16px;
      border-bottom: 1px solid #e2e8f0;
    }
    .debt-period-modal__header h3 { margin: 0; font-size: 16px; }
    .debt-period-modal__close {
      border: none;
      background: transparent;
      font-size: 22px;
      line-height: 1;
      cursor: pointer;
      color: #64748b;
    }
    .debt-period-modal__body { padding: 16px; display: grid; gap: 12px; }
    .debt-period-option {
      display: flex;
      align-items: center;
      gap: 8px;
      font-weight: 600;
      cursor: pointer;
    }
    .debt-period-range {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      padding: 10px 12px;
      border: 1px solid #e2e8f0;
      border-radius: 8px;
      background: #f8fafc;
    }
    .debt-period-field { display: grid; gap: 4px; font-size: 13px; }
    .debt-period-field input[type="date"] {
      border: 1px solid #cbd5e1;
      border-radius: 6px;
      padding: 6px 8px;
      font: inherit;
    }
    .debt-period-modal__footer {
      display: flex;
      justify-content: flex-end;
      gap: 8px;
      padding: 12px 16px;
      border-top: 1px solid #e2e8f0;
    }

    .address-type-list{display:grid;gap:8px;max-height:280px;overflow:auto}
    .address-type-row{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:8px;align-items:center;border:1px solid #e2e8f0;border-radius:6px;padding:8px}
    .address-type-row.is-default{background:#f8fafc}
    .address-type-name{font-weight:700;color:#111827}
    .address-type-code{font-size:11px;color:#64748b;margin-top:2px}
    .address-type-form-panel{display:grid;gap:14px;align-self:start}
    .address-type-actions{display:flex;gap:6px}
    .address-type-badge{display:inline-flex;align-items:center;height:24px;border-radius:999px;background:#eaf2ff;color:#0058d4;font-size:11px;font-weight:800;padding:0 8px}
    #addressTypeModalOverlay .group-modal{width:min(760px,calc(100vw - 96px));max-width:calc(100vw - 96px)}
    #addressTypeModalOverlay .group-modal-body{grid-template-columns:minmax(0,1.2fr) minmax(0,1fr);align-items:start;gap:14px 18px}
    #addressTypeModalOverlay .address-type-list{grid-row:span 2;max-height:420px}
    #addressTypeModalOverlay .address-type-row{padding:12px}
    #addressTypeModalOverlay .group-modal-footer{justify-content:space-between}
    @media (max-width:900px){
      #addressTypeModalOverlay .group-modal{width:min(520px,calc(100vw - 24px));max-width:calc(100vw - 24px)}
      #addressTypeModalOverlay .group-modal-body{grid-template-columns:1fr}
      #addressTypeModalOverlay .address-type-list{grid-row:auto;max-height:280px}
      .address-type-form-panel{gap:10px}
      #addressTypeModalOverlay .group-modal-footer{justify-content:flex-end}
    }

    .supplier-pay-modal-overlay {
      position: fixed;
      inset: 0;
      z-index: 2100;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 24px;
      background: rgba(17, 24, 39, .54);
    }
    .supplier-pay-modal-overlay.is-open { display: flex; }
    .supplier-pay-modal {
      width: min(900px, calc(100vw - 48px));
      max-height: calc(100vh - 48px);
      display: flex;
      flex-direction: column;
      overflow: hidden;
      background: #fff;
      border-radius: 10px;
      box-shadow: 0 24px 70px rgba(15, 23, 42, .28);
    }
    .supplier-pay-header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 16px;
      padding: 18px 24px 10px;
    }
    .supplier-pay-title { margin: 0 0 4px; font-size: 18px; color: #111827; }
    .supplier-pay-subtitle { display: flex; gap: 8px; align-items: center; color: #64748b; font-size: 12px; }
    .supplier-pay-debt-badge { padding: 2px 7px; border-radius: 4px; background: #f1f5f9; color: #334155; font-weight: 700; }
    .supplier-pay-close { border: 0; background: transparent; color: #4b5563; font-size: 30px; line-height: 1; cursor: pointer; }
    .supplier-pay-body { padding: 0 24px 12px; overflow: auto; }
    .supplier-pay-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px 22px; }
    .supplier-pay-field { display: flex; flex-direction: column; gap: 5px; font-size: 12px; color: #374151; }
    .supplier-pay-field-full { grid-column: 1 / -1; }
    .supplier-pay-input-wrap { position: relative; }
    .supplier-pay-field input,
    .supplier-pay-field select,
    .supplier-pay-field textarea {
      width: 100%;
      min-height: 30px;
      border: 1px solid #cfd8e3;
      border-radius: 6px;
      padding: 5px 12px;
      font-size: 13px;
      background: #fff;
      outline: none;
    }
    .supplier-pay-field textarea { min-height: 48px; resize: vertical; }
    .supplier-pay-field input:focus,
    .supplier-pay-field select:focus,
    .supplier-pay-field textarea:focus { border-color: #0070f4; box-shadow: 0 0 0 1px #0070f4; }
    .supplier-pay-mismatch-alert { border: 1px solid #fde68a; background: #fffbeb; color: #92400e; border-radius: 6px; padding: 10px 12px; margin-bottom: 12px; font-size: 13px; }
    .supplier-pay-mismatch-grid { display: grid; grid-template-columns: 160px 1fr; gap: 4px 12px; margin-top: 8px; color: #334155; }
    .supplier-pay-mismatch-grid b { color: #111827; }
    .supplier-pay-readonly { background: #f1f5f9 !important; text-align: right; color: #111827; }
    .supplier-pay-icons { position: absolute; right: 10px; top: 50%; transform: translateY(-50%); display: flex; gap: 10px; color: #4b5563; }
    .supplier-pay-check { display: inline-flex; align-items: center; gap: 8px; margin: 14px 0 6px; font-weight: 500; color: #1f2937; font-size: 13px; }
    .supplier-pay-check input { width: 14px; height: 14px; accent-color: #0070f4; }
    .supplier-pay-reconcile-note { margin: 0 0 8px; color: #64748b; font-size: 12px; }
    .supplier-pay-reconcile-note strong { color: #111827; }
    .supplier-pay-table-wrap { border-top: 0; min-height: 150px; background: #fff; }
    .supplier-pay-table-wrap table { min-width: 820px; }
    .supplier-pay-table-wrap th { background: #f1f3f5 !important; height: 38px; color: #374151; font-size: 12px; }
    .supplier-pay-table-wrap td { height: 40px; font-size: 13px; }
    .supplier-pay-row-input { width: 88px; height: 22px; border: 1px solid #cfd8e3; border-radius: 6px; text-align: right; padding: 2px 8px; font-size: 13px; outline: none; }
    .supplier-pay-row-input:focus { border-color: #0070f4; box-shadow: 0 0 0 1px #0070f4; }
    .supplier-pay-total-row td { font-weight: 800; border-top: 1px solid #e5e7eb; }
    .supplier-pay-unallocated-row td { border-bottom: 0; font-size: 13px; }
    .supplier-pay-empty { display: grid; place-items: center; gap: 14px; min-height: 210px; color: #1f2937; font-weight: 700; }
    .supplier-pay-empty-icon { width: 92px; height: 92px; border-radius: 50%; display: grid; place-items: center; background: #eff6ff; color: #1d7ff5; font-size: 42px; }
    .supplier-pay-footer {
      display: flex;
      justify-content: flex-end;
      gap: 10px;
      padding: 12px 24px;
      border-top: 1px solid #e5e7eb;
      background: #fff;
    }
    .supplier-pay-footer button:disabled { opacity: .5; cursor: not-allowed; }

    @media (max-width: 1100px) {
      .supplier-detail-fields { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .supplier-address-expand-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }
  </style>
</head>
<body class="admin-body">
  <%- include('../partials/header', { activeMenu: activeMenu, user: user }) %>

  <main class="admin-shell store-page supplier-page">
    <%- include('../partials/flash-message', { flash: flash }) %>
    <% filterQueryString = filterQueryString || ''; %>

    <div class="store-toolbar">
      <h1>Nhà cung cấp</h1>
      <div class="store-search">
        <span>⌕</span>
        <input type="search" placeholder="Theo mã, tên nhà cung cấp">
      </div>
      <div class="page-actions">
        <button class="btn btn-primary" type="button" id="openAddSupplierModal">+ Tạo mới</button>
        <div class="supplier-import-wrap">
          <button class="btn btn-light" type="button" id="supplierImportToggle" aria-haspopup="true" aria-expanded="false">Thêm bằng file ▾</button>
          <div class="supplier-import-menu" id="supplierImportMenu" role="menu" aria-label="Thêm bằng file">
            <a href="/nha-cung-cap/import/template.xlsx" role="menuitem">Lấy file mẫu</a>
            <button type="button" id="supplierImportPickBtn" role="menuitem">Thêm</button>
          </div>
        </div>
        <form id="supplierImportForm" method="post" action="/nha-cung-cap/import" enctype="multipart/form-data" hidden>
          <input type="file" name="file" id="supplierImportFile" accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet">
        </form>
        <a class="btn btn-light" href="/nha-cung-cap/export.xlsx?<%= filterQueryString || '' %>">Xuất file</a>
        <button class="btn btn-danger" type="submit" form="bulkDeleteSuppliersForm" onclick="return confirm('Xóa các nhà cung cấp đã chọn?')">Xóa đã chọn</button>
      </div>
    </div>

    <div id="addSupplierModalOverlay" class="modal-overlay" data-auto-open="<%= formMode === 'create' ? '1' : '0' %>">
      <div class="modal-content customer-create-modal supplier-create-modal">
        <div class="modal-header">
          <h3>Tạo nhà cung cấp</h3>
          <button type="button" class="modal-close" id="addSupplierModalClose" aria-label="Đóng">×</button>
        </div>
        <form class="modal-body store-form-grid supplier-create-form" method="post" action="/nha-cung-cap/add" id="supplierCreateForm">
          <label><span>Mã NCC</span><input name="ma_ncc" placeholder="Tự động nếu bỏ trống"></label>
          <label><span>Tên nhà cung cấp *</span><input name="ten_ncc" placeholder="Nhập tên nhà cung cấp" required></label>
          <label><span>Điện thoại</span><input name="sdt" placeholder="Nhập số điện thoại"></label>
          <label><span>Email</span><input name="email" type="email" placeholder="email@example.com"></label>
          <label><span>Tên công ty</span><input name="ten_cong_ty" placeholder="Nhập tên công ty"></label>
          <label><span>Mã số thuế</span><input name="ma_so_thue" placeholder="Nhập mã số thuế"></label>
          <label><span>Tổng nợ</span><strong class="supplier-metric-readonly">0</strong>
            <span class="supplier-metric-hint"> — Tự động tính từ công nợ phiếu nhập</span>
          </label>
          <label><span>Tổng mua</span><strong class="supplier-metric-readonly">0</strong>
            <span class="supplier-metric-hint"> — Tự động tính từ phiếu đã nhập hàng</span>
          </label>
          <label class="span-2"><span>Ghi chú</span><input name="ghi_chu" placeholder="Nhập ghi chú"></label>
          <label><span>Trạng thái</span>
            <select name="trang_thai">
              <option value="active" selected>Đang hoạt động</option>
              <option value="inactive">Ngừng hoạt động</option>
            </select>
          </label>
        </form>
        <div class="page-actions modal-footer">
          <button class="btn btn-light" type="button" id="addSupplierModalCancel">Bỏ qua</button>
          <button class="btn btn-primary" type="submit" form="supplierCreateForm">Lưu</button>
        </div>
      </div>
    </div>

    <div class="store-layout">
      <aside class="store-filter-panel">
        <form method="get" action="/nha-cung-cap" class="store-filter-form">
          <section class="customer-filter-section">
            <div class="customer-filter-title-row">
              <h4>Nhóm nhà cung cấp</h4>
              <button class="filter-link-btn" type="button" id="supplierGroupAddBtn">Tạo mới</button>
            </div>
            <% var selectedSupplierGroup = (supplierGroups || []).find(function(group) { return filter.groupId === String(group._id); }); %>
            <div class="group-manage-wrapper" id="supplierGroupManageSidebar">
              <div class="group-manage-header">
                <button class="group-manage-trigger" type="button" id="supplierGroupFilterTrigger">
                  <span id="supplierGroupFilterLabel"><%= selectedSupplierGroup ? selectedSupplierGroup.ten_nhom_ncc : 'Tất cả các nhóm' %></span>
                  <span>▾</span>
                </button>
              </div>
              <input type="hidden" name="groupId" id="supplierGroupFilterValue" value="<%= filter.groupId || 'all' %>">
              <div class="group-manage-dropdown" id="supplierGroupFilterDropdown">
                <div class="group-manage-item <%= (!filter.groupId || filter.groupId === 'all') ? 'is-active' : '' %>" data-id="" data-value="all" data-name="Tất cả các nhóm" data-desc="">
                  <button class="group-manage-option" type="button">Tất cả các nhóm</button>
                </div>
                <% (supplierGroups || []).forEach(function(group) { %>
                  <div class="group-manage-item <%= filter.groupId === String(group._id) ? 'is-active' : '' %>" data-id="<%= group._id %>" data-value="<%= group._id %>" data-name="<%= group.ten_nhom_ncc || '---' %>" data-desc="<%= group.mo_ta || '' %>">
                    <button class="group-manage-option" type="button"><%= group.ten_nhom_ncc || '---' %></button>
                    <div class="group-manage-actions">
                      <button class="group-manage-action-edit" type="button">Sửa</button>
                      <button class="group-manage-action-delete" type="button">Xóa</button>
                    </div>
                  </div>
                <% }) %>
              </div>
            </div>
            <input type="hidden" name="debtDaySort" id="debtDaySortInput" value="<%= filter.debtDaySort || '' %>">
            <h4 style="margin-top:16px">Sắp xếp theo ngày nợ</h4>
            <label class="filter-check-row">
              <input type="checkbox" id="debtSortOldest" value="oldest" <%= filter.debtDaySort === 'oldest' ? 'checked' : '' %>>
              <span>Số ngày nợ xa nhất</span>
            </label>
            <label class="filter-check-row">
              <input type="checkbox" id="debtSortNewest" value="newest" <%= filter.debtDaySort === 'newest' ? 'checked' : '' %>>
              <span>Số ngày nợ gần nhất</span>
            </label>
            <h4 style="margin-top:16px">Lọc cảnh báo nợ</h4>
            <label class="filter-check-row">
              <input type="checkbox" name="warnOnly" value="1" id="warnOnlyCheckbox" <%= filter.warnOnly === '1' ? 'checked' : '' %>>
              <span>Chỉ hiện NCC có cảnh báo</span>
            </label>
            <div class="filter-range-stack">
              <label>
                <span>Quá số ngày</span>
                <input type="number" min="0" step="1" name="warnMinDays" value="<%= filter.warnMinDays || debtWarnDefaultDays || 10 %>">
              </label>
              <label>
                <span>Quá số tiền (VNĐ)</span>
                <input type="text" inputmode="numeric" class="js-vn-money-filter" name="warnMinAmount" value="<%= typeof formatFilterMoney === 'function' ? formatFilterMoney(filter.warnMinAmount) : (filter.warnMinAmount || '') %>" placeholder="Không giới hạn" autocomplete="off">
              </label>
            </div>
          </section>
        </form>
      </aside>

      <section class="store-table-panel supplier-list-panel">
        <div class="table-wrap">
          <form id="bulkDeleteSuppliersForm" method="post" action="/nha-cung-cap/delete-selected"></form>
          <%
            var supplierSummaryTotals = (suppliers || []).reduce(function(sum, s) {
              sum.totalPurchase += Number(s.tong_mua || 0);
              sum.totalPaid += Number(s.da_thanh_toan || 0);
              sum.totalDebt += Number(s.tong_no || 0);
              return sum;
            }, { totalPurchase: 0, totalPaid: 0, totalDebt: 0 });
          %>
          <table class="admin-table store-table" data-kv-master="nha-cung-cap">
            <thead>
              <tr>
                <th class="check-cell"><input id="selectAllSuppliers" type="checkbox" aria-label="Chọn tất cả"></th>
                <th>Mã NCC</th><th>Tên nhà cung cấp</th><th>Điện thoại</th><th>Email</th><th>Tổng mua</th><th>Đã thanh toán</th><th>Tổng nợ</th><th>Trạng thái</th>
              </tr>
            </thead>
            <tbody>
              <tr class="customer-summary-row">
                <td class="check-cell"></td>
                <td colspan="4" style="text-align: right; font-weight: bold; color: #1e293b;">Tổng cộng:</td>
                <td data-summary-field="tong-mua"><strong><%= Number(supplierSummaryTotals.totalPurchase || 0).toLocaleString('vi-VN') %></strong></td>
                <td data-summary-field="da-thanh-toan"><strong><%= Number(supplierSummaryTotals.totalPaid || 0).toLocaleString('vi-VN') %></strong></td>
                <td data-summary-field="tong-no"><strong><%= Number(supplierSummaryTotals.totalDebt || 0).toLocaleString('vi-VN') %></strong></td>
                <td></td>
              </tr>
              <% if (suppliers.length === 0) { %>
                <tr><td colspan="9" class="empty-cell">Không có nhà cung cấp phù hợp với bộ lọc.</td></tr>
              <% } %>
              <% suppliers.forEach(function(supplier) { %>
                <% var listBase = '/nha-cung-cap' + (filterQueryString ? ('?' + filterQueryString) : ''); %>
                <tr
                  class="supplier-row"
                  data-kv-detail-id="<%= supplier._id %>"
                  data-supplier-id="<%= supplier._id %>"
                  data-metrics-loading="<%= supplier.metrics_pending ? 'true' : 'false' %>"
                  data-metric-tong-mua="<%= Number(supplier.tong_mua || 0) %>"
                  data-metric-da-thanh-toan="<%= Number(supplier.da_thanh_toan || 0) %>"
                  data-metric-tong-no="<%= Number(supplier.tong_no || 0) %>"
                >
                  <td class="check-cell" onclick="event.stopPropagation()"><input class="supplier-checkbox" type="checkbox" name="ids" value="<%= supplier._id %>" form="bulkDeleteSuppliersForm" aria-label="Chọn nhà cung cấp"></td>
                  <td><a class="table-code-link kv-detail-code-link" href="<%= listBase %>"><%= supplier.ma_ncc || '---' %></a></td>
                  <td><strong><a class="table-code-link kv-detail-code-link" href="<%= listBase %>"><%= supplier.ten_ncc || '---' %></a></strong></td>
                  <td><%= supplier.sdt || '---' %></td>
                  <td><%= supplier.email || '---' %></td>
                  <td data-field="tong-mua" class="<%= supplier.metrics_pending ? 'supplier-metrics-loading' : '' %>"><%= Number(supplier.tong_mua || 0).toLocaleString('vi-VN') %></td>
                  <td data-field="da-thanh-toan" class="<%= supplier.metrics_pending ? 'supplier-metrics-loading' : '' %>"><%= Number(supplier.da_thanh_toan || 0).toLocaleString('vi-VN') %></td>
                  <td data-field="tong-no" class="<%= supplier.metrics_pending ? 'supplier-metrics-loading' : '' %>">
                    <div class="supplier-debt-cell">
                      <span data-debt-value><%= Number(supplier.tong_no || 0).toLocaleString('vi-VN') %></span>
                      <% if (supplier.debt_warning) { %>
                        <button
                          type="button"
                          class="supplier-debt-warn-btn js-supplier-debt-warn"
                          data-supplier-id="<%= supplier._id %>"
                          aria-label="Cảnh báo nợ quá hạn"
                        >⚠️
                          <span class="supplier-debt-warn-tip">
                            NCC có khoản nợ quá hạn <strong><%= Number(supplier.so_ngay_no_xa || 0).toLocaleString('vi-VN') %></strong> ngày.<br>
                            Tổng nợ còn lại: <strong><%= Number(supplier.tong_no || 0).toLocaleString('vi-VN') %> VNĐ</strong>.<br>
                            <% if (supplier.no_xa_nhat_ma_phieu) { %>
                              Khoản nợ lâu nhất: <strong><%= supplier.no_xa_nhat_ma_phieu %></strong> (<%= Number(supplier.no_xa_nhat_tien || 0).toLocaleString('vi-VN') %> VNĐ).
                            <% } %>
                          </span>
                        </button>
                      <% } %>
                    </div>
                  </td>
                  <td><span class="status-pill <%= supplier.trang_thai === 'active' ? 'is-active' : '' %>"><%= supplier.trang_thai === 'active' ? 'Đang hoạt động' : 'Ngừng hoạt động' %></span></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </section>
    </div>
  </main>
  <div id="supplierGroupModalOverlay" class="group-modal-overlay">
    <div class="group-modal">
      <div class="group-modal-header">
        <h3 id="supplierGroupModalTitle">Sửa nhóm nhà cung cấp</h3>
        <button type="button" class="group-modal-close" id="supplierGroupModalClose">×</button>
      </div>
      <div class="group-modal-body">
        <label>
          <span>Tên nhóm</span>
          <input id="supplierGroupNameInput" type="text" placeholder="Nhập tên nhóm">
        </label>
        <label>
          <span>Ghi chú</span>
          <input id="supplierGroupDescInput" type="text" placeholder="Nhập ghi chú">
        </label>
      </div>
      <div class="page-actions group-modal-footer">
        <button class="btn btn-light btn-sm" type="button" id="supplierGroupModalCancel">Bỏ qua</button>
        <button class="btn btn-primary btn-sm" type="button" id="supplierGroupModalSubmit">Lưu</button>
      </div>
    </div>
  </div>
  <%- include('../partials/address-type-modal', { addressTypeListId: 'addressTypeList' }) %>
  <script id="supplierGroupsSeed" type="application/json"><%- JSON.stringify(supplierGroups || []) %></script>
  <script id="addressTypesSeed" type="application/json"><%- JSON.stringify(addressTypes || []) %></script>
  <%- include('../partials/debt-period-export-modal') %>
  <script src="/js/debt-period-export.js"></script>
  <script src="/js/kv-inline-detail.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      var openAddSupplierModalBtn = document.getElementById('openAddSupplierModal');
      var addSupplierModalOverlay = document.getElementById('addSupplierModalOverlay');
      var addSupplierModalClose = document.getElementById('addSupplierModalClose');
      var addSupplierModalCancel = document.getElementById('addSupplierModalCancel');
      var supplierCreateForm = document.getElementById('supplierCreateForm');

      function openAddSupplierModal() {
        if (!addSupplierModalOverlay) return;
        if (supplierCreateForm) supplierCreateForm.reset();
        addSupplierModalOverlay.classList.add('is-visible');
      }

      function closeAddSupplierModal() {
        if (!addSupplierModalOverlay) return;
        addSupplierModalOverlay.classList.remove('is-visible');
        if (window.location.search.indexOf('mode=create') >= 0) {
          var url = new URL(window.location.href);
          url.searchParams.delete('mode');
          window.history.replaceState({}, '', url.pathname + (url.searchParams.toString() ? '?' + url.searchParams.toString() : ''));
        }
      }

      if (openAddSupplierModalBtn) openAddSupplierModalBtn.addEventListener('click', openAddSupplierModal);
      if (addSupplierModalClose) addSupplierModalClose.addEventListener('click', closeAddSupplierModal);
      if (addSupplierModalCancel) addSupplierModalCancel.addEventListener('click', closeAddSupplierModal);
      if (addSupplierModalOverlay && addSupplierModalOverlay.getAttribute('data-auto-open') === '1') {
        openAddSupplierModal();
      }

      function parseSupplierMoney(value) {
        var normalized = String(value || '').replace(/\./g, '').replace(/,/g, '').trim();
        if (normalized === '') return '';
        var number = Number(normalized);
        return Number.isFinite(number) && number >= 0 ? Math.floor(number) : '';
      }
      function formatSupplierMoney(value) {
        if (value === '' || value == null) return '';
        var number = Math.max(0, Math.floor(Number(value || 0)));
        return number.toLocaleString('vi-VN');
      }
      function bindVnMoneyFilterInputs(root) {
        var scope = root || document;
        scope.querySelectorAll('.js-vn-money-filter').forEach(function(input) {
          if (input.getAttribute('data-vn-money-bound') === '1') return;
          input.setAttribute('data-vn-money-bound', '1');
          input.addEventListener('input', function() {
            var digits = String(input.value || '').replace(/\D/g, '');
            input.value = digits === '' ? '' : formatSupplierMoney(digits);
          });
        });
      }
      var supplierFilterForm = document.querySelector('.store-filter-form');
      if (supplierFilterForm) {
        bindVnMoneyFilterInputs(supplierFilterForm);
        supplierFilterForm.addEventListener('submit', function() {
          supplierFilterForm.querySelectorAll('.js-vn-money-filter').forEach(function(input) {
            var parsed = parseSupplierMoney(input.value);
            input.value = parsed === '' ? '' : String(parsed);
          });
        });
      }

      var debtDaySortInput = document.getElementById('debtDaySortInput');
      var debtSortOldest = document.getElementById('debtSortOldest');
      var debtSortNewest = document.getElementById('debtSortNewest');
      function bindDebtSortCheckbox(box, otherBox, sortValue) {
        if (!box) return;
        box.addEventListener('change', function() {
          if (box.checked) {
            if (otherBox) otherBox.checked = false;
            if (debtDaySortInput) debtDaySortInput.value = sortValue;
          } else if (!otherBox || !otherBox.checked) {
            if (debtDaySortInput) debtDaySortInput.value = '';
          }
          if (supplierFilterForm) supplierFilterForm.submit();
        });
      }
      bindDebtSortCheckbox(debtSortOldest, debtSortNewest, 'oldest');
      bindDebtSortCheckbox(debtSortNewest, debtSortOldest, 'newest');

      var warnOnlyCheckbox = document.getElementById('warnOnlyCheckbox');
      if (warnOnlyCheckbox && supplierFilterForm) {
        warnOnlyCheckbox.addEventListener('change', function() {
          supplierFilterForm.submit();
        });
      }
      var warnMinDaysInput = supplierFilterForm ? supplierFilterForm.querySelector('input[name="warnMinDays"]') : null;
      if (warnMinDaysInput && supplierFilterForm) {
        warnMinDaysInput.addEventListener('change', function() {
          supplierFilterForm.submit();
        });
      }

      document.addEventListener('click', function(event) {
        var warnBtn = event.target.closest('.js-supplier-debt-warn');
        if (!warnBtn || !kvSupplier) return;
        event.preventDefault();
        event.stopPropagation();
        var supplierId = warnBtn.getAttribute('data-supplier-id');
        if (!supplierId) return;
        window.__openSupplierDebtTab = true;
        kvSupplier.openById(supplierId);
      });

      function positionSupplierDebtWarnTip(btn, tip) {
        if (!btn || !tip) return;
        var rect = btn.getBoundingClientRect();
        var tipWidth = Math.min(300, window.innerWidth - 24);
        var left = Math.max(12, rect.right - tipWidth);
        var top = rect.bottom + 8;
        if (top + tip.offsetHeight > window.innerHeight - 12) {
          top = Math.max(12, rect.top - tip.offsetHeight - 8);
        }
        tip.style.width = tipWidth + 'px';
        tip.style.left = left + 'px';
        tip.style.top = top + 'px';
      }
      function bindSupplierDebtWarnTips(root) {
        var scope = root || document;
        scope.querySelectorAll('.js-supplier-debt-warn').forEach(function(btn) {
          if (btn.dataset.warnTipBound === '1') return;
          btn.dataset.warnTipBound = '1';
          var tip = btn.querySelector('.supplier-debt-warn-tip');
          if (!tip) return;
          function showTip() {
            tip.classList.add('is-visible');
            positionSupplierDebtWarnTip(btn, tip);
          }
          function hideTip() {
            tip.classList.remove('is-visible');
          }
          btn.addEventListener('mouseenter', showTip);
          btn.addEventListener('mouseleave', hideTip);
          btn.addEventListener('focus', showTip);
          btn.addEventListener('blur', hideTip);
          window.addEventListener('scroll', hideTip, true);
          window.addEventListener('resize', function() {
            if (tip.classList.contains('is-visible')) positionSupplierDebtWarnTip(btn, tip);
          });
        });
      }
      bindSupplierDebtWarnTips(document);

      function setSupplierMetricsCell(row, field, value) {
        var cell = row.querySelector('[data-field="' + field + '"]');
        if (!cell) return;
        cell.classList.remove('supplier-metrics-loading', 'supplier-metrics-error');
        if (field === 'tong-no') {
          var debtValue = cell.querySelector('[data-debt-value]');
          if (debtValue) {
            debtValue.textContent = formatSupplierMoney(value);
            return;
          }
        }
        cell.textContent = formatSupplierMoney(value);
      }

      function renderSupplierDebtWarning(row, metric) {
        var cell = row.querySelector('[data-field="tong-no"]');
        var wrap = cell ? cell.querySelector('.supplier-debt-cell') : null;
        if (!wrap) return;
        wrap.querySelectorAll('.js-supplier-debt-warn').forEach(function(btn) {
          btn.remove();
        });
        if (!metric || !metric.debt_warning) return;
        var button = document.createElement('button');
        button.type = 'button';
        button.className = 'supplier-debt-warn-btn js-supplier-debt-warn';
        button.setAttribute('data-supplier-id', metric.id || row.dataset.supplierId || '');
        button.setAttribute('aria-label', 'Cảnh báo nợ quá hạn');
        button.innerHTML = '&#9888;<span class="supplier-debt-warn-tip">NCC có khoản nợ quá hạn <strong>' +
          formatSupplierMoney(metric.so_ngay_no_xa || 0) +
          '</strong> ngày.<br>Tổng nợ còn lại: <strong>' +
          formatSupplierMoney(metric.tong_no || 0) +
          ' VNĐ</strong>.' +
          (metric.no_xa_nhat_ma_phieu
            ? '<br>Khoản nợ lâu nhất: <strong>' + escapeHtml(metric.no_xa_nhat_ma_phieu) + '</strong> (' + formatSupplierMoney(metric.no_xa_nhat_tien || 0) + ' VNĐ).'
            : '') +
          '</span>';
        wrap.appendChild(button);
        bindSupplierDebtWarnTips(wrap);
      }

      function updateSupplierSummaryTotals(rows) {
        var totals = rows.reduce(function(sum, row) {
          sum.tongMua += Number(row.dataset.metricTongMua || 0);
          sum.daThanhToan += Number(row.dataset.metricDaThanhToan || 0);
          sum.tongNo += Number(row.dataset.metricTongNo || 0);
          return sum;
        }, { tongMua: 0, daThanhToan: 0, tongNo: 0 });
        var totalPurchaseCell = document.querySelector('[data-summary-field="tong-mua"] strong');
        var totalPaidCell = document.querySelector('[data-summary-field="da-thanh-toan"] strong');
        var totalDebtCell = document.querySelector('[data-summary-field="tong-no"] strong');
        if (totalPurchaseCell) totalPurchaseCell.textContent = formatSupplierMoney(totals.tongMua);
        if (totalPaidCell) totalPaidCell.textContent = formatSupplierMoney(totals.daThanhToan);
        if (totalDebtCell) totalDebtCell.textContent = formatSupplierMoney(totals.tongNo);
      }

      function markSupplierMetricsError(rows) {
        rows.forEach(function(row) {
          row.dataset.metricsLoading = 'false';
          row.dataset.metricsError = 'true';
          ['tong-mua', 'da-thanh-toan', 'tong-no'].forEach(function(field) {
            var cell = row.querySelector('[data-field="' + field + '"]');
            if (!cell) return;
            cell.classList.remove('supplier-metrics-loading');
            cell.classList.add('supplier-metrics-error');
          });
        });
      }

      function loadSupplierTableMetrics() {
        var pendingRows = Array.prototype.slice.call(document.querySelectorAll('.supplier-row[data-supplier-id][data-metrics-loading="true"]'));
        if (!pendingRows.length) return;
        var rowMap = new Map();
        pendingRows.forEach(function(row) {
          rowMap.set(row.dataset.supplierId, row);
        });
        function fetchMetricBatch(batchRows) {
          var url = new URL('/nha-cung-cap/api/table-metrics' + window.location.search, window.location.origin);
          url.searchParams.set('ids', batchRows.map(function(row) {
            return row.dataset.supplierId;
          }).join(','));
          return fetch(url.toString(), { headers: { Accept: 'application/json' } })
            .then(function(response) {
              return response.text().then(function(text) {
                var json = null;
                try {
                  json = text ? JSON.parse(text) : null;
                } catch (err) {
                  throw new Error('Response metrics khong phai JSON hop le.');
                }
                if (!response.ok || !json || json.success === false) {
                  throw new Error((json && json.message) || 'Khong the tai so lieu tong hop NCC.');
                }
                return json;
              });
            })
            .then(function(payload) {
              (payload.rows || []).forEach(function(metric) {
                var row = rowMap.get(String(metric.id || ''));
                if (!row) return;
                row.dataset.metricsLoading = 'false';
                row.dataset.metricTongMua = String(Number(metric.tong_mua || 0));
                row.dataset.metricDaThanhToan = String(Number(metric.da_thanh_toan || 0));
                row.dataset.metricTongNo = String(Number(metric.tong_no || 0));
                setSupplierMetricsCell(row, 'tong-mua', metric.tong_mua);
                setSupplierMetricsCell(row, 'da-thanh-toan', metric.da_thanh_toan);
                setSupplierMetricsCell(row, 'tong-no', metric.tong_no);
                renderSupplierDebtWarning(row, metric);
              });
              batchRows.forEach(function(row) {
                if (row.dataset.metricsLoading === 'true') {
                  row.dataset.metricsLoading = 'false';
                  ['tong-mua', 'da-thanh-toan', 'tong-no'].forEach(function(field) {
                    var cell = row.querySelector('[data-field="' + field + '"]');
                    if (cell) cell.classList.remove('supplier-metrics-loading');
                  });
                }
              });
            })
            .catch(function(error) {
              console.error('[SupplierMetrics]', error);
              markSupplierMetricsError(batchRows);
            });
        }
        var batches = [];
        for (var i = 0; i < pendingRows.length; i += 100) {
          batches.push(pendingRows.slice(i, i + 100));
        }
        Promise.all(batches.map(fetchMetricBatch)).then(function() {
          updateSupplierSummaryTotals(Array.prototype.slice.call(document.querySelectorAll('.supplier-row[data-supplier-id]')));
        });
      }
      loadSupplierTableMetrics();

      var selectAll = document.getElementById('selectAllSuppliers');
      var checkboxes = Array.prototype.slice.call(document.querySelectorAll('.supplier-checkbox'));
      if (selectAll) {
        selectAll.addEventListener('change', function () { checkboxes.forEach(function (checkbox) { checkbox.checked = selectAll.checked; }); });
      }
      checkboxes.forEach(function (checkbox) {
        checkbox.addEventListener('change', function () {
          if (!selectAll) return;
          selectAll.checked = checkboxes.length > 0 && checkboxes.every(function (item) { return item.checked; });
        });
      });

      var kvSupplierTable = document.querySelector('table[data-kv-master="nha-cung-cap"]');
      var kvSupplier = null;
      function bindSupplierInlinePanel(rootEl) {
        var wrap = rootEl.classList.contains('supplier-inline-detail') ? rootEl : rootEl.querySelector('.supplier-inline-detail');
        if (!wrap) return;
        if (window.KvDebtPeriodExport) window.KvDebtPeriodExport.bind(wrap);
      }
      if (kvSupplierTable && typeof KvInlineDetail !== 'undefined') {
        kvSupplier = new KvInlineDetail({
          table: kvSupplierTable,
          colspan: 9,
          buildUrl: function(id) {
            return '/nha-cung-cap/api/' + encodeURIComponent(id) + '/detail';
          },
          onOpen: function(id, root) {
            bindSupplierInlinePanel(root);
            if (window.__openSupplierDebtTab) {
              var debtTab = root.querySelector('[data-detail-tab="debt"]');
              if (debtTab) debtTab.click();
              window.__openSupplierDebtTab = false;
            }
          }
        });
        if (/^#s-/.test(location.hash)) {
          var sid = decodeURIComponent(location.hash.slice(3));
          if (sid) {
            kvSupplier.openById(sid);
            var clean = location.pathname + (location.search || '');
            history.replaceState(null, '', clean);
          }
        }
      }

      function parseSupplierMoneyAmount(value) {
        var parsed = parseSupplierMoney(value);
        return parsed === '' ? 0 : parsed;
      }
      function formatSupplierMoneyDisplay(value) {
        return formatSupplierMoney(value);
      }
      function formatSupplierSignedMoney(value) {
        var number = Math.floor(Number(value || 0));
        return number.toLocaleString('vi-VN');
      }
      function setSupplierPayInputValue(input, value) {
        if (input) input.value = formatSupplierMoney(value);
      }
      function syncSupplierPayV2Total(form) {
        if (!form) return 0;
        var cash = parseSupplierMoneyAmount((form.querySelector('.js-supplier-pay-cash') || {}).value);
        var transfer = parseSupplierMoneyAmount((form.querySelector('.js-supplier-pay-transfer') || {}).value);
        var total = cash + transfer;
        var amountInput = form.querySelector('.js-supplier-pay-amount');
        if (amountInput) amountInput.value = total ? formatSupplierMoney(total) : '';
        var cashBook = form.querySelector('.js-supplier-pay-cash-book');
        var bankBook = form.querySelector('.js-supplier-pay-bank-book');
        if (cashBook) cashBook.disabled = cash <= 0;
        if (bankBook) bankBook.disabled = transfer <= 0;
        return total;
      }
      function getSupplierPayRowAllocations(form) {
        var rows = [];
        Array.prototype.slice.call(form.querySelectorAll('.js-supplier-pay-row-paid-input')).forEach(function(input) {
          var paid = parseSupplierMoneyAmount(input.value);
          if (paid <= 0) return;
          rows.push({
            phieu_nhap_id: input.getAttribute('data-purchase-id') || '',
            ma_phieu_nhap: input.getAttribute('data-purchase-code') || '',
            so_tien: paid
          });
        });
        return rows;
      }
      function syncSupplierPayAllocationJson(form) {
        var hidden = form ? form.querySelector('.js-supplier-pay-allocations-json') : null;
        if (hidden) hidden.value = JSON.stringify(getSupplierPayRowAllocations(form));
        var amountInput = form ? form.querySelector('.js-supplier-pay-amount') : null;
        var overpaymentInput = form ? form.querySelector('.js-supplier-pay-overpayment') : null;
        if (overpaymentInput) {
          var amount = syncSupplierPayV2Total(form) || parseSupplierMoneyAmount(amountInput ? amountInput.value : 0);
          var payableDebt = Math.max(0, Number(form.getAttribute('data-current-debt') || 0));
          overpaymentInput.value = String(Math.max(0, amount - payableDebt));
        }
      }
      function updateSupplierPayAllocation(form, source) {
        if (!form) return;
        var debt = Number(form.getAttribute('data-current-debt') || 0);
        var payableDebt = Math.max(0, debt);
        var allowOverpayment = !!form.querySelector('.js-supplier-pay-allow-overpayment:checked');
        var amountInput = form.querySelector('.js-supplier-pay-amount');
        var amount = syncSupplierPayV2Total(form) || parseSupplierMoneyAmount(amountInput ? amountInput.value : 0);
        if (!allowOverpayment) amount = Math.min(amount, payableDebt);
        if (source === 'amount') {
          if (amountInput) amountInput.value = amount ? formatSupplierMoney(amount) : '';
          var rest = Math.min(amount, payableDebt);
          Array.prototype.slice.call(form.querySelectorAll('.js-supplier-pay-row')).forEach(function(row) {
            var rowDebt = Number(row.getAttribute('data-debt') || 0);
            var paid = Math.min(rest, rowDebt);
            rest -= paid;
            setSupplierPayInputValue(row.querySelector('.js-supplier-pay-row-paid-input'), paid);
          });
        } else {
          amount = 0;
          var rowBudget = payableDebt;
          Array.prototype.slice.call(form.querySelectorAll('.js-supplier-pay-row-paid-input')).forEach(function(input) {
            var rowDebt = Number(input.getAttribute('data-debt') || 0);
            var paid = Math.min(parseSupplierMoneyAmount(input.value), rowDebt, Math.max(0, rowBudget - amount));
            amount += paid;
            setSupplierPayInputValue(input, paid);
          });
          if (amountInput) amountInput.value = amount ? formatSupplierMoney(amount) : '';
        }
        var totalPaid = 0;
        var totalRowDebt = 0;
        var totalRowLeft = 0;
        Array.prototype.slice.call(form.querySelectorAll('.js-supplier-pay-row')).forEach(function(row) {
          var rowDebt = Number(row.getAttribute('data-debt') || 0);
          var input = row.querySelector('.js-supplier-pay-row-paid-input');
          var paid = Math.min(parseSupplierMoneyAmount(input ? input.value : 0), rowDebt);
          totalPaid += paid;
          totalRowDebt += rowDebt;
          totalRowLeft += Math.max(0, rowDebt - paid);
          var leftCell = row.querySelector('.js-supplier-pay-row-left');
          if (leftCell) leftCell.textContent = formatSupplierMoney(rowDebt - paid);
        });
        var remainingInput = form.querySelector('.js-supplier-pay-remaining');
        if (remainingInput) remainingInput.value = formatSupplierSignedMoney(debt - amount);
        var totalPaidCell = form.querySelector('.js-supplier-pay-total-paid');
        var totalDebtCell = form.querySelector('.js-supplier-pay-total-debt');
        var totalLeftCell = form.querySelector('.js-supplier-pay-total-left');
        var unallocatedCell = form.querySelector('.js-supplier-pay-unallocated');
        var unallocatedLabel = form.querySelector('.js-supplier-pay-unallocated-label');
        if (totalDebtCell) totalDebtCell.textContent = formatSupplierMoney(totalRowDebt);
        if (totalPaidCell) totalPaidCell.textContent = formatSupplierMoney(totalPaid);
        if (totalLeftCell) totalLeftCell.textContent = formatSupplierMoney(totalRowLeft);
        if (unallocatedCell) unallocatedCell.textContent = formatSupplierMoney(Math.max(0, amount - totalPaid));
        if (unallocatedLabel) unallocatedLabel.textContent = amount > payableDebt ? 'Trả dư / ứng trước NCC:' : 'Tiền chưa gắn phiếu nhập:';
        syncSupplierPayAllocationJson(form);
      }
      function openSupplierPayModal(modal) {
        if (!modal) return;
        modal.classList.add('is-open');
        modal.setAttribute('aria-hidden', 'false');
        var form = modal.querySelector('.supplier-pay-form');
        var amountInput = form ? form.querySelector('.js-supplier-pay-amount') : null;
        if (amountInput) {
          amountInput.value = '';
          amountInput.focus();
        }
        Array.prototype.slice.call(form.querySelectorAll('.js-supplier-pay-row-paid-input')).forEach(function(input) {
          input.value = '0';
        });
        updateSupplierPayAllocation(form, 'row');
      }
      function closeSupplierPayModal(modal) {
        if (!modal) return;
        modal.classList.remove('is-open');
        modal.setAttribute('aria-hidden', 'true');
      }
      function updateSupplierDiscountRemaining(form) {
        if (!form) return;
        var debt = Number(form.getAttribute('data-current-debt') || 0);
        var amountInput = form.querySelector('.js-supplier-discount-amount');
        var amount = parseSupplierMoneyAmount(amountInput ? amountInput.value : 0);
        if (amountInput && amount) amountInput.value = formatSupplierMoney(amount);
        var remaining = form.querySelector('.js-supplier-discount-remaining');
        if (remaining) remaining.textContent = formatSupplierMoney(Math.max(0, debt - amount));
      }
      function openSupplierDiscountModal(modal) {
        if (!modal) return;
        modal.classList.add('is-open');
        modal.setAttribute('aria-hidden', 'false');
        var form = modal.querySelector('.supplier-discount-form');
        var amountInput = form ? form.querySelector('.js-supplier-discount-amount') : null;
        if (amountInput) {
          amountInput.value = '';
          amountInput.focus();
        }
        updateSupplierDiscountRemaining(form);
      }
      function closeSupplierDiscountModal(modal) {
        if (!modal) return;
        modal.classList.remove('is-open');
        modal.setAttribute('aria-hidden', 'true');
      }

      document.addEventListener('click', function(event) {
        var openBtn = event.target.closest('.js-open-supplier-pay-modal');
        if (openBtn) {
          event.preventDefault();
          event.stopPropagation();
          openSupplierPayModal(document.getElementById(openBtn.getAttribute('data-modal-id')));
          return;
        }
        var openDiscountBtn = event.target.closest('.js-open-supplier-discount-modal');
        if (openDiscountBtn) {
          event.preventDefault();
          event.stopPropagation();
          openSupplierDiscountModal(document.getElementById(openDiscountBtn.getAttribute('data-modal-id')));
          return;
        }
        var closeBtn = event.target.closest('.js-close-supplier-pay-modal');
        if (closeBtn) {
          event.preventDefault();
          event.stopPropagation();
          closeSupplierPayModal(closeBtn.closest('.js-supplier-pay-overlay'));
          return;
        }
        var closeDiscountBtn = event.target.closest('.js-close-supplier-discount-modal');
        if (closeDiscountBtn) {
          event.preventDefault();
          event.stopPropagation();
          closeSupplierDiscountModal(closeDiscountBtn.closest('.js-supplier-discount-overlay'));
          return;
        }
        var discountSubmitBtn = event.target.closest('.js-submit-supplier-discount-modal');
        if (discountSubmitBtn) {
          event.preventDefault();
          event.stopPropagation();
          var discountForm = document.getElementById(discountSubmitBtn.getAttribute('data-form-id'));
          if (!discountForm || discountSubmitBtn.disabled) return;
          var discountAmount = parseSupplierMoneyAmount((discountForm.querySelector('[name="gia_tri"]') || {}).value);
          var discountDebt = Math.max(0, Number(discountForm.getAttribute('data-current-debt') || 0));
          if (discountAmount <= 0) return alert('Vui lòng nhập số tiền chiết khấu.');
          if (discountAmount > discountDebt) return alert('Số tiền chiết khấu không được vượt quá nợ hiện tại.');
          var discountPayload = new URLSearchParams(new FormData(discountForm));
          discountSubmitBtn.disabled = true;
          fetch(discountForm.getAttribute('data-action'), {
            method: 'POST',
            headers: {
              'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8',
              'X-Requested-With': 'XMLHttpRequest',
              'Accept': 'application/json'
            },
            body: discountPayload.toString()
          })
            .then(function(response) {
              return response.json().catch(function() {
                return { success: false, message: 'Server không trả về JSON hợp lệ.' };
              });
            })
            .then(function(data) {
              if (!data || !data.success) {
                alert((data && data.message) || 'Không tạo được chiết khấu thanh toán.');
                return;
              }
              window.location.reload();
            })
            .catch(function(error) {
              alert((error && error.message) || 'Có lỗi khi tạo chiết khấu thanh toán.');
            })
            .finally(function() {
              discountSubmitBtn.disabled = false;
            });
          return;
        }
        var submitBtn = event.target.closest('.js-submit-supplier-pay-modal');
        if (!submitBtn) return;
        event.preventDefault();
        event.stopPropagation();
        var form = document.getElementById(submitBtn.getAttribute('data-form-id'));
        if (!form || submitBtn.disabled) return;
        var amount = syncSupplierPayV2Total(form) || parseSupplierMoneyAmount((form.querySelector('[name="gia_tri"]') || {}).value);
        var payableDebt = Math.max(0, Number(form.getAttribute('data-current-debt') || 0));
        var allowOverpayment = !!form.querySelector('.js-supplier-pay-allow-overpayment:checked');
        if (amount <= 0) return alert('Vui lòng nhập số tiền thanh toán.');
        if (!allowOverpayment && amount > payableDebt) return alert('Số tiền trả không được vượt quá nợ theo sổ công nợ. Bật trả dư / ứng trước NCC nếu muốn chi vượt.');
        var cash = parseSupplierMoneyAmount((form.querySelector('.js-supplier-pay-cash') || {}).value);
        var transfer = parseSupplierMoneyAmount((form.querySelector('.js-supplier-pay-transfer') || {}).value);
        var v2CashBook = form.querySelector('.js-supplier-pay-cash-book');
        var v2BankBook = form.querySelector('.js-supplier-pay-bank-book');
        if (cash > 0 && (!v2CashBook || !v2CashBook.value)) return alert('Vui lòng chọn sổ tiền mặt.');
        if (transfer > 0 && (!v2BankBook || !v2BankBook.value)) return alert('Vui lòng chọn tài khoản chuyển khoản.');
        var cashBook = { value: 'v2' };
        if (!cashBook || !cashBook.value) return alert('Vui lòng chọn sổ quỹ.');

        syncSupplierPayAllocationJson(form);
        var allocations = getSupplierPayRowAllocations(form);
        var allocatedTotal = allocations.reduce(function(sum, row) { return sum + Number(row.so_tien || 0); }, 0);
        if (allocatedTotal > Math.min(amount, payableDebt)) return alert('Tổng tiền phân bổ không được vượt quá nợ theo sổ công nợ.');
        var payload = new URLSearchParams(new FormData(form));
        submitBtn.disabled = true;
        fetch(form.getAttribute('data-action'), {
          method: 'POST',
          headers: {
            'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8',
            'X-Requested-With': 'XMLHttpRequest',
            'Accept': 'application/json'
          },
          body: payload.toString()
        })
          .then(function(response) {
            return response.json().catch(function() {
              return { success: false, message: 'Server không trả về JSON hợp lệ.' };
            });
          })
          .then(function(data) {
            if (!data || !data.success) {
              alert((data && data.message) || 'Không tạo được phiếu chi.');
              return;
            }
            if (submitBtn.getAttribute('data-print') === '1' && data.data && data.data.receipt && data.data.receipt._id) {
              window.open('/so-quy/phieu-thu-chi/' + data.data.receipt._id, '_blank');
            }
            window.location.reload();
          })
          .catch(function(error) {
            alert((error && error.message) || 'Có lỗi khi tạo phiếu chi.');
          })
          .finally(function() {
            submitBtn.disabled = false;
          });
      });

      document.addEventListener('input', function(event) {
        var discountAmountInput = event.target.closest('.js-supplier-discount-amount');
        if (discountAmountInput) {
          updateSupplierDiscountRemaining(discountAmountInput.closest('.supplier-discount-form'));
          return;
        }
        var amountInput = event.target.closest('.js-supplier-pay-amount');
        if (amountInput) {
          var form = amountInput.closest('.supplier-pay-form');
          updateSupplierPayAllocation(form, 'amount');
          return;
        }
        var v2PayInput = event.target.closest('.js-supplier-pay-cash,.js-supplier-pay-transfer');
        if (v2PayInput) {
          var v2Form = v2PayInput.closest('.supplier-pay-form');
          updateSupplierPayAllocation(v2Form, 'amount');
          return;
        }
        var rowInput = event.target.closest('.js-supplier-pay-row-paid-input');
        if (!rowInput) return;
        updateSupplierPayAllocation(rowInput.closest('.supplier-pay-form'), 'row');
      });
      document.addEventListener('change', function(event) {
        var overpaymentToggle = event.target.closest('.js-supplier-pay-allow-overpayment');
        if (!overpaymentToggle) return;
        updateSupplierPayAllocation(overpaymentToggle.closest('.supplier-pay-form'), 'amount');
      });

      document.addEventListener('click', function(e) {
        var refA = e.target.closest('a.ref-link[href^="/nha-cung-cap/"]');
        if (!refA || (window.location.pathname || '') !== '/nha-cung-cap') return;
        var href = refA.getAttribute('href') || '';
        var m = href.match(/^\/nha-cung-cap\/([a-f0-9]{24})\/?$/i);
        if (!m || !kvSupplier) return;
        e.preventDefault();
        kvSupplier.openById(m[1]);
      });

      var createdFilterRadios = Array.prototype.slice.call(document.querySelectorAll('input[name="created"]'));
      var customDateRange = document.getElementById('customDateRange');
      if (customDateRange && createdFilterRadios.length) {
        function toggleCustomDateRange() {
          var selectedCreated = createdFilterRadios.find(function(radio) { return radio.checked; });
          customDateRange.classList.toggle('is-visible', selectedCreated && selectedCreated.value === 'custom');
        }
        createdFilterRadios.forEach(function(radio) {
          radio.addEventListener('change', toggleCustomDateRange);
        });
        toggleCustomDateRange();
      }

      var pillButtons = Array.prototype.slice.call(document.querySelectorAll('.pill-btn'));
      pillButtons.forEach(function(btn) {
        btn.addEventListener('click', function() {
          var targetInputId = btn.getAttribute('data-target-input');
          var value = btn.getAttribute('data-value');
          var input = document.getElementById(targetInputId);
          if (!input) return;
          input.value = value;
          var siblings = Array.prototype.slice.call(btn.parentElement.querySelectorAll('.pill-btn'));
          siblings.forEach(function(item) { item.classList.remove('is-active'); });
          btn.classList.add('is-active');
        });
      });

      var supplierGroupFilterTrigger = document.getElementById('supplierGroupFilterTrigger');
      var supplierGroupFilterLabel = document.getElementById('supplierGroupFilterLabel');
      var supplierGroupFilterValue = document.getElementById('supplierGroupFilterValue');
      var supplierGroupFilterDropdown = document.getElementById('supplierGroupFilterDropdown');
      var supplierGroupAddBtn = document.getElementById('supplierGroupAddBtn');
      var supplierGroupModalOverlay = document.getElementById('supplierGroupModalOverlay');
      var supplierGroupModalTitle = document.getElementById('supplierGroupModalTitle');
      var supplierGroupModalClose = document.getElementById('supplierGroupModalClose');
      var supplierGroupModalCancel = document.getElementById('supplierGroupModalCancel');
      var supplierGroupModalSubmit = document.getElementById('supplierGroupModalSubmit');
      var supplierGroupNameInput = document.getElementById('supplierGroupNameInput');
      var supplierGroupDescInput = document.getElementById('supplierGroupDescInput');
      var supplierGroupModalMode = 'add';
      var activeSupplierGroupItem = null;

      function bindSupplierGroupItems() {
        var groupItems = Array.prototype.slice.call(document.querySelectorAll('#supplierGroupFilterDropdown .group-manage-item'));
        groupItems.forEach(function(item) {
          var optionBtn = item.querySelector('.group-manage-option');
          var editBtn = item.querySelector('.group-manage-action-edit');
          var deleteBtn = item.querySelector('.group-manage-action-delete');

          if (optionBtn) {
            optionBtn.addEventListener('click', function() {
              groupItems.forEach(function(node) { node.classList.remove('is-active'); });
              item.classList.add('is-active');
              if (supplierGroupFilterValue) supplierGroupFilterValue.value = item.getAttribute('data-value') || 'all';
              if (supplierGroupFilterLabel) supplierGroupFilterLabel.textContent = item.getAttribute('data-name') || 'Tất cả các nhóm';
              if (supplierGroupFilterDropdown) supplierGroupFilterDropdown.classList.remove('is-open');
              if (supplierFilterForm) supplierFilterForm.submit();
            });
          }

          if (editBtn) {
            editBtn.addEventListener('click', function(event) {
              event.stopPropagation();
              activeSupplierGroupItem = item;
              openSupplierGroupModal('edit');
            });
          }

          if (deleteBtn) {
            deleteBtn.addEventListener('click', function(event) {
              event.stopPropagation();
              var groupId = item.getAttribute('data-id') || '';
              if (!groupId) {
                alert('Vui lòng chọn nhóm cần xóa.');
                return;
              }
              if (!confirm('Bạn có chắc muốn xóa nhóm nhà cung cấp này không?')) return;
              requestSupplierGroups('/nha-cung-cap/groups/' + groupId + '/delete', {}, '');
            });
          }
        });
      }

      function renderSupplierGroupList(selectedValue) {
        if (!supplierGroupFilterDropdown) return;
        var groups = window.__supplierGroups || [];
        var rows = [];
        rows.push(
          '<div class="group-manage-item ' + ((selectedValue === 'all' || !selectedValue) ? 'is-active' : '') + '" data-id="" data-value="all" data-name="Tất cả các nhóm" data-desc="">' +
            '<button class="group-manage-option" type="button">Tất cả các nhóm</button>' +
          '</div>'
        );
        groups.forEach(function(group) {
          var id = String(group._id || '');
          var isActive = id === String(selectedValue || '');
          rows.push(
            '<div class="group-manage-item ' + (isActive ? 'is-active' : '') + '" data-id="' + id + '" data-value="' + id + '" data-name="' + (group.ten_nhom_ncc || '').replace(/"/g, '&quot;') + '" data-desc="' + (group.mo_ta || '').replace(/"/g, '&quot;') + '">' +
              '<button class="group-manage-option" type="button">' + (group.ten_nhom_ncc || '') + '</button>' +
              '<div class="group-manage-actions">' +
                '<button class="group-manage-action-edit" type="button">Sửa</button>' +
                '<button class="group-manage-action-delete" type="button">Xóa</button>' +
              '</div>' +
            '</div>'
          );
        });
        supplierGroupFilterDropdown.innerHTML = rows.join('');
        bindSupplierGroupItems();
      }

      function refreshSupplierGroupWidget(selectedId) {
        var selected = selectedId || (supplierGroupFilterValue ? supplierGroupFilterValue.value : 'all') || 'all';
        renderSupplierGroupList(selected);
        if (supplierGroupFilterDropdown && supplierGroupFilterLabel) {
          var activeItem = supplierGroupFilterDropdown.querySelector('.group-manage-item.is-active');
          supplierGroupFilterLabel.textContent = activeItem ? (activeItem.getAttribute('data-name') || 'Tất cả các nhóm') : 'Tất cả các nhóm';
          if (supplierGroupFilterValue) supplierGroupFilterValue.value = activeItem ? (activeItem.getAttribute('data-value') || 'all') : 'all';
        }
      }

      function requestSupplierGroups(url, payload, selectedId) {
        var formBody = Object.keys(payload).map(function(key) {
          return encodeURIComponent(key) + '=' + encodeURIComponent(payload[key]);
        }).join('&');

        fetch(url, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8',
            'X-Requested-With': 'XMLHttpRequest',
            'Accept': 'application/json'
          },
          body: formBody
        })
          .then(function(response) {
            return response.json().catch(function() {
              return { success: false, message: 'Server không trả về JSON hợp lệ.' };
            });
          })
          .then(function(data) {
            if (!data || !data.success) {
              alert((data && data.message) || 'Không thể xử lý nhóm nhà cung cấp.');
              return;
            }
            if (Array.isArray(data.supplierGroups)) {
              window.__supplierGroups = data.supplierGroups;
            } else if (data.data && data.data._id) {
              window.__supplierGroups = (window.__supplierGroups || []).filter(function(group) {
                return String(group._id) !== String(data.data._id);
              });
              window.__supplierGroups.push(data.data);
            }
            refreshSupplierGroupWidget(data.selectedId || (data.data && data.data._id) || selectedId || '');
            closeSupplierGroupModal();
          })
          .catch(function(error) {
            alert((error && error.message) || 'Có lỗi khi xử lý nhóm nhà cung cấp.');
          });
      }

      function openSupplierGroupModal(mode) {
        supplierGroupModalMode = mode;
        if (!supplierGroupModalOverlay || !supplierGroupModalTitle) return;
        if (mode === 'add') {
          supplierGroupModalTitle.textContent = 'Thêm nhóm nhà cung cấp';
          if (supplierGroupNameInput) supplierGroupNameInput.value = '';
          if (supplierGroupDescInput) supplierGroupDescInput.value = '';
        } else {
          supplierGroupModalTitle.textContent = 'Sửa nhóm nhà cung cấp';
          if (supplierGroupNameInput) supplierGroupNameInput.value = activeSupplierGroupItem ? (activeSupplierGroupItem.getAttribute('data-name') || '') : '';
          if (supplierGroupDescInput) supplierGroupDescInput.value = activeSupplierGroupItem ? (activeSupplierGroupItem.getAttribute('data-desc') || '') : '';
        }
        supplierGroupModalOverlay.classList.add('is-open');
      }

      function closeSupplierGroupModal() {
        if (!supplierGroupModalOverlay) return;
        supplierGroupModalOverlay.classList.remove('is-open');
      }

      if (supplierGroupFilterTrigger && supplierGroupFilterDropdown) {
        supplierGroupFilterTrigger.addEventListener('click', function() {
          supplierGroupFilterDropdown.classList.toggle('is-open');
        });
      }
      if (supplierGroupAddBtn) {
        supplierGroupAddBtn.addEventListener('click', function() {
          openSupplierGroupModal('add');
        });
      }
      if (supplierGroupModalClose) supplierGroupModalClose.addEventListener('click', closeSupplierGroupModal);
      if (supplierGroupModalCancel) supplierGroupModalCancel.addEventListener('click', closeSupplierGroupModal);

      if (supplierGroupModalSubmit) {
        supplierGroupModalSubmit.addEventListener('click', function() {
          if (!supplierGroupNameInput || !supplierGroupNameInput.value.trim()) {
            alert('Vui lòng nhập tên nhóm nhà cung cấp.');
            return;
          }
          if (supplierGroupModalMode === 'add') {
            requestSupplierGroups('/nha-cung-cap/groups/add', {
              ten_nhom_ncc: supplierGroupNameInput.value.trim(),
              mo_ta: supplierGroupDescInput ? supplierGroupDescInput.value.trim() : ''
            }, '');
            return;
          }
          var groupId = activeSupplierGroupItem ? (activeSupplierGroupItem.getAttribute('data-id') || '') : '';
          if (!groupId) {
            alert('Vui lòng chọn nhóm cần sửa.');
            return;
          }
          requestSupplierGroups('/nha-cung-cap/groups/' + groupId + '/update', {
            ten_nhom_ncc: supplierGroupNameInput.value.trim(),
            mo_ta: supplierGroupDescInput ? supplierGroupDescInput.value.trim() : ''
          }, groupId);
        });
      }

      var supplierGroupsSeed = document.getElementById('supplierGroupsSeed');
      window.__supplierGroups = supplierGroupsSeed ? JSON.parse(supplierGroupsSeed.textContent || '[]') : [];
      refreshSupplierGroupWidget((supplierGroupFilterValue && supplierGroupFilterValue.value) || 'all');

      var addressTypesSeed = document.getElementById('addressTypesSeed');
      window.__addressTypes = addressTypesSeed ? JSON.parse(addressTypesSeed.textContent || '[]') : [];
      var addressTypeModalOverlay = document.getElementById('addressTypeModalOverlay');
      var addressTypeModalTitle = document.getElementById('addressTypeModalTitle');
      var addressTypeModalClose = document.getElementById('addressTypeModalClose');
      var addressTypeModalCancel = document.getElementById('addressTypeModalCancel');
      var addressTypeModalSubmit = document.getElementById('addressTypeModalSubmit');
      var addressTypeNameInput = document.getElementById('addressTypeNameInput');
      var addressTypeCodeInput = document.getElementById('addressTypeCodeInput');
      var addressTypeList = document.getElementById('addressTypeList');
      var activeAddressTypeItem = null;
      var addressTypeMode = 'add';

      function escapeHtml(value) {
        return String(value || '').replace(/[&<>"']/g, function(ch) {
          return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[ch];
        });
      }

      function isDefaultAddressTypeCode(value) {
        return String(value || '').toLowerCase() === 'khac';
      }

      function setAddressTypeFormMode(mode, item) {
        addressTypeMode = mode === 'edit' ? 'edit' : 'add';
        activeAddressTypeItem = item || null;
        if (addressTypeModalTitle) addressTypeModalTitle.textContent = addressTypeMode === 'edit' ? 'Sửa loại địa chỉ' : 'Thêm loại địa chỉ';
        if (addressTypeModalSubmit) addressTypeModalSubmit.textContent = addressTypeMode === 'edit' ? 'Lưu' : 'Thêm';
        if (addressTypeNameInput) addressTypeNameInput.value = activeAddressTypeItem ? (activeAddressTypeItem.getAttribute('data-name') || '') : '';
        if (addressTypeCodeInput) {
          addressTypeCodeInput.value = activeAddressTypeItem ? (activeAddressTypeItem.getAttribute('data-code') || '') : '';
          if (addressTypeMode === 'edit') {
            addressTypeCodeInput.setAttribute('disabled', 'disabled');
          } else {
            addressTypeCodeInput.removeAttribute('disabled');
          }
        }
        if (addressTypeNameInput) addressTypeNameInput.focus();
      }

      function renderAddressTypeSelects(selectedCode) {
        var types = window.__addressTypes || [];
        document.querySelectorAll('.js-address-type-select').forEach(function(select) {
          var current = selectedCode || select.value || 'khac';
          var html = '<option value="khac">Khác</option>';
          types.forEach(function(type) {
            if (isDefaultAddressTypeCode(type.ma_loai)) return;
            html += '<option value="' + escapeHtml(type.ma_loai || '') + '">' + escapeHtml(type.ten_loai || '') + '</option>';
          });
          select.innerHTML = html;
          select.value = types.some(function(type) { return String(type.ma_loai) === String(current); }) || current === 'khac'
            ? current
            : 'khac';
        });
      }

      function bindAddressTypeRows() {
        if (!addressTypeList) return;
        Array.prototype.slice.call(addressTypeList.querySelectorAll('.address-type-row')).forEach(function(row) {
          var editBtn = row.querySelector('.js-address-type-edit');
          var deleteBtn = row.querySelector('.js-address-type-delete');
          if (editBtn) {
            editBtn.addEventListener('click', function() {
              if (isDefaultAddressTypeCode(row.getAttribute('data-code'))) {
                alert('Không thể sửa loại địa chỉ mặc định.');
                return;
              }
              setAddressTypeFormMode('edit', row);
            });
          }
          if (deleteBtn) {
            deleteBtn.addEventListener('click', function() {
              var id = row.getAttribute('data-id') || '';
              if (isDefaultAddressTypeCode(row.getAttribute('data-code'))) {
                alert('Không thể xóa loại địa chỉ mặc định.');
                return;
              }
              if (!id) return;
              if (!confirm('Xóa loại địa chỉ này? Các địa chỉ đang dùng sẽ chuyển về Khác.')) return;
              requestAddressTypes('/nha-cung-cap/address-types/' + id + '/delete', {}, 'khac');
            });
          }
        });
      }

      function renderAddressTypeList() {
        if (!addressTypeList) return;
        var types = window.__addressTypes || [];
        if (!types.length) {
          addressTypeList.innerHTML = '<div class="empty-cell">Chưa có loại địa chỉ.</div>';
          return;
        }
        addressTypeList.innerHTML = types.map(function(type) {
          var isDefault = isDefaultAddressTypeCode(type.ma_loai);
          return '<div class="address-type-row' + (isDefault ? ' is-default' : '') + '" data-id="' + escapeHtml(type._id || '') + '" data-code="' + escapeHtml(type.ma_loai || '') + '" data-name="' + escapeHtml(type.ten_loai || '') + '">' +
            '<div><div class="address-type-name">' + escapeHtml(type.ten_loai || '') + '</div><div class="address-type-code">' + escapeHtml(type.ma_loai || '') + '</div></div>' +
            '<div class="address-type-actions">' +
              (isDefault ? '<span class="address-type-badge">Mặc định</span>' : '<button class="btn btn-light btn-sm js-address-type-edit" type="button">Sửa</button><button class="btn btn-danger btn-sm js-address-type-delete" type="button">Xóa</button>') +
            '</div>' +
          '</div>';
        }).join('');
        bindAddressTypeRows();
      }

      function openAddressTypeModal() {
        renderAddressTypeList();
        if (addressTypeModalOverlay) addressTypeModalOverlay.classList.add('is-open');
        setAddressTypeFormMode('add', null);
      }

      function closeAddressTypeModal() {
        if (addressTypeModalOverlay) addressTypeModalOverlay.classList.remove('is-open');
      }

      function requestAddressTypes(url, payload, selectedCode) {
        var formBody = Object.keys(payload).map(function(key) {
          return encodeURIComponent(key) + '=' + encodeURIComponent(payload[key]);
        }).join('&');

        fetch(url, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8',
            'X-Requested-With': 'XMLHttpRequest',
            'Accept': 'application/json'
          },
          body: formBody
        })
          .then(function(response) {
            return response.json().catch(function() {
              return { success: false, message: 'Server không trả về JSON hợp lệ.' };
            });
          })
          .then(function(data) {
            if (!data || !data.success) {
              alert((data && data.message) || 'Không thể xử lý loại địa chỉ.');
              return;
            }
            if (Array.isArray(data.addressTypes)) window.__addressTypes = data.addressTypes;
            renderAddressTypeList();
            renderAddressTypeSelects(data.selectedCode || selectedCode || '');
            setAddressTypeFormMode('add', null);
          })
          .catch(function(error) {
            alert((error && error.message) || 'Có lỗi khi xử lý loại địa chỉ.');
          });
      }

      document.addEventListener('click', function(ev) {
        if (!ev.target.closest('.js-open-address-type-modal')) return;
        ev.preventDefault();
        openAddressTypeModal();
      });
      if (addressTypeModalClose) addressTypeModalClose.addEventListener('click', closeAddressTypeModal);
      if (addressTypeModalCancel) addressTypeModalCancel.addEventListener('click', closeAddressTypeModal);
      if (addressTypeModalSubmit) {
        addressTypeModalSubmit.addEventListener('click', function() {
          if (!addressTypeNameInput || !addressTypeNameInput.value.trim()) {
            alert('Vui lòng nhập tên loại địa chỉ.');
            return;
          }
          if (addressTypeMode === 'edit') {
            var typeId = activeAddressTypeItem ? activeAddressTypeItem.getAttribute('data-id') : '';
            if (!typeId) return alert('Vui lòng chọn loại địa chỉ cần sửa.');
            requestAddressTypes('/nha-cung-cap/address-types/' + typeId + '/update', {
              ten_loai: addressTypeNameInput.value.trim()
            }, activeAddressTypeItem.getAttribute('data-code') || '');
            return;
          }
          requestAddressTypes('/nha-cung-cap/address-types/add', {
            ten_loai: addressTypeNameInput.value.trim(),
            ma_loai: addressTypeCodeInput && addressTypeCodeInput.value ? addressTypeCodeInput.value.trim() : ''
          }, '');
        });
      }
      renderAddressTypeSelects();

      function submitSupplierAddressForm(action, formId, confirmMessage) {
        if (!action || !formId) return;
        if (confirmMessage && !confirm(confirmMessage)) return;

        var tempForm = document.createElement('form');
        tempForm.method = 'post';
        tempForm.action = action;
        tempForm.style.display = 'none';

        var fields = document.querySelectorAll('[data-address-form="' + formId + '"]');
        fields.forEach(function(field) {
          if (!field.name) return;
          if ((field.type === 'checkbox' || field.type === 'radio') && !field.checked) return;
          var input = document.createElement('input');
          input.type = 'hidden';
          input.name = field.name;
          input.value = field.value || '';
          tempForm.appendChild(input);
        });

        document.body.appendChild(tempForm);
        tempForm.submit();
      }

      document.addEventListener('click', function(event) {
        var submitBtn = event.target.closest('.js-supplier-address-submit');
        if (submitBtn) {
          event.preventDefault();
          event.stopPropagation();
          submitSupplierAddressForm(
            submitBtn.getAttribute('data-action'),
            submitBtn.getAttribute('data-form-id'),
            submitBtn.getAttribute('data-confirm')
          );
          return;
        }
        var delBtn = event.target.closest('.js-supplier-address-delete');
        if (delBtn) {
          event.preventDefault();
          event.stopPropagation();
          if (!confirm('Bạn có chắc muốn xóa địa chỉ này không?')) return;

          var tempForm = document.createElement('form');
          tempForm.method = 'post';
          tempForm.action = delBtn.getAttribute('data-action');
          tempForm.style.display = 'none';

          var returnQuery = document.createElement('input');
          returnQuery.type = 'hidden';
          returnQuery.name = 'returnQuery';
          returnQuery.value = delBtn.getAttribute('data-return-query') || '';
          tempForm.appendChild(returnQuery);

          document.body.appendChild(tempForm);
          tempForm.submit();
        }
      });

      document.addEventListener('click', function(event) {
        if (!supplierGroupFilterDropdown || !supplierGroupFilterTrigger) return;
        if (supplierGroupFilterDropdown.contains(event.target)) return;
        if (supplierGroupFilterTrigger.contains(event.target)) return;
        supplierGroupFilterDropdown.classList.remove('is-open');
      });

      var supplierImportToggle = document.getElementById('supplierImportToggle');
      var supplierImportMenu = document.getElementById('supplierImportMenu');
      var supplierImportPickBtn = document.getElementById('supplierImportPickBtn');
      var supplierImportForm = document.getElementById('supplierImportForm');
      var supplierImportFile = document.getElementById('supplierImportFile');

      function closeSupplierImportMenu() {
        if (!supplierImportMenu || !supplierImportToggle) return;
        supplierImportMenu.classList.remove('is-open');
        supplierImportToggle.setAttribute('aria-expanded', 'false');
      }

      function isSupplierExcelFile(file) {
        if (!file) return false;
        var name = String(file.name || '').toLowerCase();
        return /\.xlsx$/i.test(name);
      }

      if (supplierImportToggle && supplierImportMenu) {
        supplierImportToggle.addEventListener('click', function(event) {
          event.stopPropagation();
          var isOpen = supplierImportMenu.classList.toggle('is-open');
          supplierImportToggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
        });
      }

      if (supplierImportPickBtn && supplierImportFile) {
        supplierImportPickBtn.addEventListener('click', function() {
          closeSupplierImportMenu();
          supplierImportFile.value = '';
          supplierImportFile.click();
        });
      }

      if (supplierImportFile && supplierImportForm) {
        supplierImportFile.addEventListener('change', function() {
          var file = supplierImportFile.files && supplierImportFile.files[0];
          if (!file) return;

          if (!isSupplierExcelFile(file)) {
            alert('Chỉ chấp nhận file Excel (.xlsx). Vui lòng dùng file mẫu.');
            supplierImportFile.value = '';
            return;
          }

          supplierImportForm.submit();
        });
      }

      document.addEventListener('click', function(event) {
        if (!supplierImportMenu || !supplierImportToggle) return;
        if (supplierImportMenu.contains(event.target)) return;
        if (supplierImportToggle.contains(event.target)) return;
        closeSupplierImportMenu();
      });
    });
  </script>
</body>
</html>
