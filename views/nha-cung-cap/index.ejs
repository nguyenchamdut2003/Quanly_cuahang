      function getSupplierPayRowAllocations(form) {
        var rows = [];
        Array.prototype.slice.call(form.querySelectorAll('.js-supplier-pay-row-paid-input')).forEach(function(input) {
          var paid = parseSupplierMoneyAmount(input.value);
