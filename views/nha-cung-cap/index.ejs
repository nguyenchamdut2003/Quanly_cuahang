      function renderSupplierGroupList(selectedValue) {
        if (!supplierGroupFilterDropdown) return;
        var groups = window.__supplierGroups || [];
        var rows = [];
        rows.push(
          '<div class="group-manage-item ' + ((selectedValue === 'all' || !selectedValue) ? 'is-active' : '') + '" data-id="" data-value="all" data-name="Tất cả các nhóm" data-desc="">' +
            '<button class="group-manage-option" type="button">Tất cả các nhóm</button>' +
          '</div>'
        );
        groups.forEach(function(group) {
          var id = String(group._id || '');
          var isActive = id === String(selectedValue || '');
          rows.push(
            '<div class="group-manage-item ' + (isActive ? 'is-active' : '') + '" data-id="' + id + '" data-value="' + id + '" data-name="' + (group.ten_nhom_ncc || '').replace(/"/g, '&quot;') + '" data-desc="' + (group.mo_ta || '').replace(/"/g, '&quot;') + '">' +
              '<button class="group-manage-option" type="button">' + (group.ten_nhom_ncc || '') + '</button>' +
              '<div class="group-manage-actions">' +
                '<button class="group-manage-action-edit" type="button">Sửa</button>' +
                '<button class="group-manage-action-delete" type="button">Xóa</button>' +
              '</div>' +
            '</div>'
          );
        });
        supplierGroupFilterDropdown.innerHTML = rows.join('');
        bindSupplierGroupItems();
      }

      function refreshSupplierGroupWidget(selectedId) {
        var selected = selectedId || (supplierGroupFilterValue ? supplierGroupFilterValue.value : 'all') || 'all';
        renderSupplierGroupList(selected);
        if (supplierGroupFilterDropdown && supplierGroupFilterLabel) {
          var activeItem = supplierGroupFilterDropdown.querySelector('.group-manage-item.is-active');
          supplierGroupFilterLabel.textContent = activeItem ? (activeItem.getAttribute('data-name') || 'Tất cả các nhóm') : 'Tất cả các nhóm';
          if (supplierGroupFilterValue) supplierGroupFilterValue.value = activeItem ? (activeItem.getAttribute('data-value') || 'all') : 'all';
        }
      }

      function requestSupplierGroups(url, payload, selectedId) {
        var formBody = Object.keys(payload).map(function(key) {
          return encodeURIComponent(key) + '=' + encodeURIComponent(payload[key]);
        }).join('&');

        fetch(url, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8',
            'X-Requested-With': 'XMLHttpRequest',
            'Accept': 'application/json'
          },
          body: formBody
        })
          .then(function(response) {
            return response.json().catch(function() {
              return { success: false, message: 'Server không trả về JSON hợp lệ.' };
            });
          })
          .then(function(data) {
            if (!data || !data.success) {
              alert((data && data.message) || 'Không thể xử lý nhóm nhà cung cấp.');
              return;
            }
            if (Array.isArray(data.supplierGroups)) {
              window.__supplierGroups = data.supplierGroups;
            } else if (data.data && data.data._id) {
              window.__supplierGroups = (window.__supplierGroups || []).filter(function(group) {
                return String(group._id) !== String(data.data._id);
              });
              window.__supplierGroups.push(data.data);
            }
            refreshSupplierGroupWidget(data.selectedId || (data.data && data.data._id) || selectedId || '');
            closeSupplierGroupModal();
          })
          .catch(function(error) {
            alert((error && error.message) || 'Có lỗi khi xử lý nhóm nhà cung cấp.');
          });
      }

      function openSupplierGroupModal(mode) {
        supplierGroupModalMode = mode;
        if (!supplierGroupModalOverlay || !supplierGroupModalTitle) return;
        if (mode === 'add') {
          supplierGroupModalTitle.textContent = 'Thêm nhóm nhà cung cấp';
          if (supplierGroupNameInput) supplierGroupNameInput.value = '';
          if (supplierGroupDescInput) supplierGroupDescInput.value = '';
        } else {
          supplierGroupModalTitle.textContent = 'Sửa nhóm nhà cung cấp';
          if (supplierGroupNameInput) supplierGroupNameInput.value = activeSupplierGroupItem ? (activeSupplierGroupItem.getAttribute('data-name') || '') : '';
          if (supplierGroupDescInput) supplierGroupDescInput.value = activeSupplierGroupItem ? (activeSupplierGroupItem.getAttribute('data-desc') || '') : '';
        }
        supplierGroupModalOverlay.classList.add('is-open');
      }

      function closeSupplierGroupModal() {
        if (!supplierGroupModalOverlay) return;
        supplierGroupModalOverlay.classList.remove('is-open');
      }

      if (supplierGroupFilterTrigger && supplierGroupFilterDropdown) {
        supplierGroupFilterTrigger.addEventListener('click', function() {
          supplierGroupFilterDropdown.classList.toggle('is-open');
        });
      }
      if (supplierGroupAddBtn) {
        supplierGroupAddBtn.addEventListener('click', function() {
          openSupplierGroupModal('add');
        });
      }
      if (supplierGroupModalClose) supplierGroupModalClose.addEventListener('click', closeSupplierGroupModal);
      if (supplierGroupModalCancel) supplierGroupModalCancel.addEventListener('click', closeSupplierGroupModal);

      if (supplierGroupModalSubmit) {
        supplierGroupModalSubmit.addEventListener('click', function() {
          if (!supplierGroupNameInput || !supplierGroupNameInput.value.trim()) {
            alert('Vui lòng nhập tên nhóm nhà cung cấp.');
            return;
          }
          if (supplierGroupModalMode === 'add') {
            requestSupplierGroups('/nha-cung-cap/groups/add', {
              ten_nhom_ncc: supplierGroupNameInput.value.trim(),
              mo_ta: supplierGroupDescInput ? supplierGroupDescInput.value.trim() : ''
            }, '');
            return;
          }
          var groupId = activeSupplierGroupItem ? (activeSupplierGroupItem.getAttribute('data-id') || '') : '';
          if (!groupId) {
            alert('Vui lòng chọn nhóm cần sửa.');
            return;
          }
          requestSupplierGroups('/nha-cung-cap/groups/' + groupId + '/update', {
            ten_nhom_ncc: supplierGroupNameInput.value.trim(),
            mo_ta: supplierGroupDescInput ? supplierGroupDescInput.value.trim() : ''
          }, groupId);
        });
      }

      var supplierGroupsSeed = document.getElementById('supplierGroupsSeed');
      window.__supplierGroups = supplierGroupsSeed ? JSON.parse(supplierGroupsSeed.textContent || '[]') : [];
      refreshSupplierGroupWidget((supplierGroupFilterValue && supplierGroupFilterValue.value) || 'all');

      var addressTypesSeed = document.getElementById('addressTypesSeed');
      window.__addressTypes = addressTypesSeed ? JSON.parse(addressTypesSeed.textContent || '[]') : [];
      var addressTypeModalOverlay = document.getElementById('addressTypeModalOverlay');
      var addressTypeModalTitle = document.getElementById('addressTypeModalTitle');
      var addressTypeModalClose = document.getElementById('addressTypeModalClose');
      var addressTypeModalCancel = document.getElementById('addressTypeModalCancel');
      var addressTypeModalSubmit = document.getElementById('addressTypeModalSubmit');
      var addressTypeNameInput = document.getElementById('addressTypeNameInput');
      var addressTypeCodeInput = document.getElementById('addressTypeCodeInput');
      var addressTypeList = document.getElementById('addressTypeList');
      var activeAddressTypeItem = null;
      var addressTypeMode = 'add';

      function escapeHtml(value) {
        return String(value || '').replace(/[&<>"']/g, function(ch) {
          return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[ch];
        });
      }

      function normalizeAddressText(value) {
        return String(value || '').trim().toLowerCase();
      }

      var ghnProvinceCache = null;
      var ghnWardCache = {};

      function fetchAddressItems(url) {
        return fetch(url, { headers: { Accept: 'application/json' } })
          .then(function(response) { return response.json(); })
          .then(function(data) {
            if (!data || !data.success) throw new Error((data && data.message) || 'Không lấy được danh mục địa chỉ.');
            return Array.isArray(data.items) ? data.items : [];
          });
      }

      function getGhnProvinces() {
        if (ghnProvinceCache) return Promise.resolve(ghnProvinceCache);
        return fetchAddressItems('/api/address/provinces').then(function(items) {
          ghnProvinceCache = items;
          return items;
        });
      }

      function getGhnWardsByProvince(provinceId) {
        if (!provinceId) return Promise.resolve([]);
        if (ghnWardCache[provinceId]) return Promise.resolve(ghnWardCache[provinceId]);
        return fetchAddressItems('/api/address/wards-by-province?province_id=' + encodeURIComponent(provinceId)).then(function(items) {
          ghnWardCache[provinceId] = items;
          return items;
        });
      }

      function findAddressItem(items, id, name, idKey, nameKey) {
        var selectedId = String(id || '');
        var selectedName = normalizeAddressText(name);
        return items.find(function(item) { return selectedId && String(item[idKey]) === selectedId; })
          || items.find(function(item) { return selectedName && normalizeAddressText(item[nameKey]) === selectedName; })
          || null;
      }

      function selectedProvinceFromSelect(select) {
        var option = select && select.options ? select.options[select.selectedIndex] : null;
        return option && option.getAttribute('data-id')
          ? { province_id: option.getAttribute('data-id'), province_name: select.value }
          : null;
      }

      function renderProvinceSelect(select, items) {
        var selected = findAddressItem(items, select.getAttribute('data-selected-id'), select.getAttribute('data-selected-name') || select.value, 'province_id', 'province_name');
        var currentName = select.getAttribute('data-selected-name') || select.value || '';
        select.innerHTML = '<option value="">Chọn Tỉnh/Thành</option>' + items.map(function(item) {
          return '<option value="' + escapeHtml(item.province_name) + '" data-id="' + escapeHtml(item.province_id) + '">' + escapeHtml(item.province_name) + '</option>';
        }).join('');
        if (selected) {
          select.value = selected.province_name;
          select.setAttribute('data-selected-id', selected.province_id);
          select.setAttribute('data-selected-name', selected.province_name);
        } else if (currentName) {
          select.innerHTML = '<option value="' + escapeHtml(currentName) + '" selected>' + escapeHtml(currentName) + '</option>' + select.innerHTML;
          select.value = currentName;
        }
      }

      function renderWardSelect(select, items) {
        if (!select) return;
        var selected = findAddressItem(items, select.getAttribute('data-selected-id'), select.getAttribute('data-selected-name') || select.value, 'ward_code', 'ward_name');
        var currentName = select.getAttribute('data-selected-name') || select.value || '';
        select.innerHTML = '<option value="">Chọn Phường/Xã</option>' + items.map(function(item) {
          var label = item.ward_name + (item.district_name ? ' - ' + item.district_name : '');
          return '<option value="' + escapeHtml(item.ward_name) + '" data-code="' + escapeHtml(item.ward_code) + '">' + escapeHtml(label) + '</option>';
        }).join('');
        if (selected) {
          select.value = selected.ward_name;
          select.setAttribute('data-selected-id', selected.ward_code);
          select.setAttribute('data-selected-name', selected.ward_name);
        } else if (currentName) {
          select.innerHTML = '<option value="' + escapeHtml(currentName) + '" selected>' + escapeHtml(currentName) + '</option>' + select.innerHTML;
          select.value = currentName;
        }
      }

      function enhanceAddressSelect(select, placeholder) {
        if (!select || select.getAttribute('data-combobox-bound') === '1') return;
        select.setAttribute('data-combobox-bound', '1');
        select.classList.add('address-native-select');

        var wrapper = document.createElement('div');
        wrapper.className = 'address-combobox';
        wrapper.innerHTML = '<input class="address-combobox-input" type="text" autocomplete="off"><button class="address-combobox-toggle" type="button" aria-label="Mở danh sách">▾</button><div class="address-combobox-menu"></div>';
        select.parentNode.insertBefore(wrapper, select.nextSibling);

        var input = wrapper.querySelector('.address-combobox-input');
        var toggle = wrapper.querySelector('.address-combobox-toggle');
        var menu = wrapper.querySelector('.address-combobox-menu');
        input.placeholder = placeholder || '';

        function options() {
          return Array.prototype.slice.call(select.options).filter(function(option) { return option.value !== ''; });
        }

        function syncInput() {
          var option = select.options[select.selectedIndex] || null;
          input.value = option && option.value ? option.textContent : '';
        }

        function renderMenu() {
          var term = normalizeAddressText(input.value);
          var rows = options().filter(function(option) {
            return !term || normalizeAddressText(option.textContent).indexOf(term) !== -1 || normalizeAddressText(option.value).indexOf(term) !== -1;
          }).slice(0, 80);
          menu.innerHTML = rows.length
            ? rows.map(function(option) {
              return '<button type="button" class="address-combobox-option" data-value="' + escapeHtml(option.value) + '">' + escapeHtml(option.textContent) + '</button>';
            }).join('')
            : '<div class="address-combobox-empty">Không có dữ liệu phù hợp</div>';
        }

        function closeMenu() {
          wrapper.classList.remove('is-open');
        }

        function choose(value) {
          select.value = value;
          syncInput();
          closeMenu();
          select.dispatchEvent(new Event('change', { bubbles: true }));
        }

        function chooseMatchingOption() {
          var term = normalizeAddressText(input.value);
          if (!term) {
            if (select.value) choose('');
            return;
          }
          var matched = options().find(function(option) {
            return normalizeAddressText(option.textContent) === term || normalizeAddressText(option.value) === term;
          }) || options().find(function(option) {
            return normalizeAddressText(option.textContent).indexOf(term) !== -1 || normalizeAddressText(option.value).indexOf(term) !== -1;
          });
          if (matched && select.value !== matched.value) choose(matched.value);
        }

        input.addEventListener('focus', function() {
          renderMenu();
          wrapper.classList.add('is-open');
        });
        input.addEventListener('input', function() {
          renderMenu();
          wrapper.classList.add('is-open');
        });
        input.addEventListener('blur', function() {
          window.setTimeout(chooseMatchingOption, 120);
        });
        input.addEventListener('keydown', function(event) {
          if (event.key !== 'Enter') return;
          var firstOption = menu.querySelector('.address-combobox-option');
          event.preventDefault();
          if (firstOption) choose(firstOption.getAttribute('data-value') || '');
          else chooseMatchingOption();
        });
        toggle.addEventListener('click', function() {
          input.focus();
          wrapper.classList.toggle('is-open');
          if (wrapper.classList.contains('is-open')) renderMenu();
        });
        menu.addEventListener('mousedown', function(event) {
          event.preventDefault();
          var option = event.target.closest('.address-combobox-option');
          if (option) choose(option.getAttribute('data-value') || '');
        });
        document.addEventListener('click', function(event) {
          if (!wrapper.contains(event.target)) closeMenu();
        });

        select._addressComboboxRefresh = function() {
          syncInput();
          renderMenu();
        };
        syncInput();
      }

      function refreshAddressSelect(select) {
        if (select && typeof select._addressComboboxRefresh === 'function') select._addressComboboxRefresh();
      }

      function initGhnAddressSelects(root) {
        var scope = root || document;
        scope.querySelectorAll('.js-ghn-province').forEach(function(provinceSelect) {
          if (provinceSelect.getAttribute('data-ghn-bound') === '1') return;
          provinceSelect.setAttribute('data-ghn-bound', '1');
          var formId = provinceSelect.getAttribute('data-address-form');
          var wardSelect = formId ? document.querySelector('.js-ghn-ward[data-address-form="' + formId + '"]') : null;
          var useNativeAddressSelect = !!provinceSelect.closest('.supplier-address-table');
          if (!useNativeAddressSelect) {
            enhanceAddressSelect(provinceSelect, 'Tìm hoặc chọn tỉnh/thành');
            enhanceAddressSelect(wardSelect, 'Tìm hoặc chọn phường/xã');
          }

          getGhnProvinces().then(function(provinces) {
            renderProvinceSelect(provinceSelect, provinces);
            refreshAddressSelect(provinceSelect);
            var province = selectedProvinceFromSelect(provinceSelect);
            if (province && wardSelect) {
              return getGhnWardsByProvince(province.province_id).then(function(wards) {
                renderWardSelect(wardSelect, wards);
                refreshAddressSelect(wardSelect);
              });
            }
          }).catch(function(error) {
            console.warn('[GHN_ADDRESS]', error && error.message ? error.message : error);
          });

          provinceSelect.addEventListener('change', function() {
            var province = selectedProvinceFromSelect(provinceSelect);
            if (wardSelect) {
              wardSelect.innerHTML = '<option value="">Chọn Phường/Xã</option>';
              wardSelect.value = '';
              wardSelect.setAttribute('data-selected-id', '');
              wardSelect.setAttribute('data-selected-name', '');
              refreshAddressSelect(wardSelect);
            }
            if (!province || !wardSelect) return;
            getGhnWardsByProvince(province.province_id).then(function(wards) {
              renderWardSelect(wardSelect, wards);
              refreshAddressSelect(wardSelect);
            }).catch(function(error) {
              console.warn('[GHN_ADDRESS]', error && error.message ? error.message : error);
            });
          });
        });
      }

      function isDefaultAddressTypeCode(value) {
        return String(value || '').toLowerCase() === 'khac';
      }

      function setAddressTypeFormMode(mode, item) {
        addressTypeMode = mode === 'edit' ? 'edit' : 'add';
        activeAddressTypeItem = item || null;
        if (addressTypeModalTitle) addressTypeModalTitle.textContent = addressTypeMode === 'edit' ? 'Sửa loại địa chỉ' : 'Thêm loại địa chỉ';
        if (addressTypeModalSubmit) addressTypeModalSubmit.textContent = addressTypeMode === 'edit' ? 'Lưu' : 'Thêm';
        if (addressTypeNameInput) addressTypeNameInput.value = activeAddressTypeItem ? (activeAddressTypeItem.getAttribute('data-name') || '') : '';
        if (addressTypeCodeInput) {
          addressTypeCodeInput.value = activeAddressTypeItem ? (activeAddressTypeItem.getAttribute('data-code') || '') : '';
          if (addressTypeMode === 'edit') {
            addressTypeCodeInput.setAttribute('disabled', 'disabled');
          } else {
            addressTypeCodeInput.removeAttribute('disabled');
          }
        }
        if (addressTypeNameInput) addressTypeNameInput.focus();
      }

      function renderAddressTypeSelects(selectedCode) {
        var types = window.__addressTypes || [];
        document.querySelectorAll('.js-address-type-select').forEach(function(select) {
          var current = selectedCode || select.value || 'khac';
          var html = '<option value="khac">Khác</option>';
          types.forEach(function(type) {
            if (isDefaultAddressTypeCode(type.ma_loai)) return;
            html += '<option value="' + escapeHtml(type.ma_loai || '') + '">' + escapeHtml(type.ten_loai || '') + '</option>';
          });
          select.innerHTML = html;
          select.value = types.some(function(type) { return String(type.ma_loai) === String(current); }) || current === 'khac'
            ? current
            : 'khac';
        });
      }

      function syncAddressTypesFromDetail(root) {
        var scope = root || document;
        if (!Array.isArray(window.__addressTypes)) window.__addressTypes = [];
        var known = {};
        (window.__addressTypes || []).forEach(function(type) {
          known[String(type.ma_loai || '')] = true;
        });
        scope.querySelectorAll('.js-address-type-select option').forEach(function(option) {
          var code = String(option.value || '').trim();
          if (!code || known[code]) return;
          known[code] = true;
          window.__addressTypes.push({
            _id: '',
            ma_loai: code,
            ten_loai: option.textContent || code
          });
        });
      }

      function bindAddressTypeRows() {
        if (!addressTypeList) return;
        Array.prototype.slice.call(addressTypeList.querySelectorAll('.address-type-row')).forEach(function(row) {
          var editBtn = row.querySelector('.js-address-type-edit');
          var deleteBtn = row.querySelector('.js-address-type-delete');
          if (editBtn) {
            editBtn.addEventListener('click', function() {
              if (isDefaultAddressTypeCode(row.getAttribute('data-code'))) {
                alert('Không thể sửa loại địa chỉ mặc định.');
                return;
              }
              setAddressTypeFormMode('edit', row);
            });
          }
          if (deleteBtn) {
            deleteBtn.addEventListener('click', function() {
              var id = row.getAttribute('data-id') || '';
              if (isDefaultAddressTypeCode(row.getAttribute('data-code'))) {
                alert('Không thể xóa loại địa chỉ mặc định.');
                return;
              }
              if (!id) return;
              if (!confirm('Xóa loại địa chỉ này? Các địa chỉ đang dùng sẽ chuyển về Khác.')) return;
              requestAddressTypes('/nha-cung-cap/address-types/' + id + '/delete', {}, 'khac');
            });
          }
        });
      }

      function renderAddressTypeList() {
        if (!addressTypeList) return;
        var types = window.__addressTypes || [];
        if (!types.length) {
          addressTypeList.innerHTML = '<div class="empty-cell">Chưa có loại địa chỉ.</div>';
          return;
        }
        addressTypeList.innerHTML = types.map(function(type) {
          var isDefault = isDefaultAddressTypeCode(type.ma_loai);
          return '<div class="address-type-row' + (isDefault ? ' is-default' : '') + '" data-id="' + escapeHtml(type._id || '') + '" data-code="' + escapeHtml(type.ma_loai || '') + '" data-name="' + escapeHtml(type.ten_loai || '') + '">' +
            '<div><div class="address-type-name">' + escapeHtml(type.ten_loai || '') + '</div><div class="address-type-code">' + escapeHtml(type.ma_loai || '') + '</div></div>' +
            '<div class="address-type-actions">' +
              (isDefault ? '<span class="address-type-badge">Mặc định</span>' : '<button class="btn btn-light btn-sm js-address-type-edit" type="button">Sửa</button><button class="btn btn-danger btn-sm js-address-type-delete" type="button">Xóa</button>') +
            '</div>' +
          '</div>';
        }).join('');
        bindAddressTypeRows();
      }

      function openAddressTypeModal() {
        renderAddressTypeList();
        if (addressTypeModalOverlay) addressTypeModalOverlay.classList.add('is-open');
        setAddressTypeFormMode('add', null);
      }

      function closeAddressTypeModal() {
        if (addressTypeModalOverlay) addressTypeModalOverlay.classList.remove('is-open');
      }

      function requestAddressTypes(url, payload, selectedCode) {
        var formBody = Object.keys(payload).map(function(key) {
          return encodeURIComponent(key) + '=' + encodeURIComponent(payload[key]);
        }).join('&');

        fetch(url, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8',
            'X-Requested-With': 'XMLHttpRequest',
            'Accept': 'application/json'
          },
          body: formBody
        })
          .then(function(response) {
            return response.json().catch(function() {
              return { success: false, message: 'Server không trả về JSON hợp lệ.' };
            });
          })
          .then(function(data) {
            if (!data || !data.success) {
              alert((data && data.message) || 'Không thể xử lý loại địa chỉ.');
              return;
            }
            if (Array.isArray(data.addressTypes)) window.__addressTypes = data.addressTypes;
            renderAddressTypeList();
            renderAddressTypeSelects(data.selectedCode || selectedCode || '');
            setAddressTypeFormMode('add', null);
          })
          .catch(function(error) {
            alert((error && error.message) || 'Có lỗi khi xử lý loại địa chỉ.');
          });
      }

      document.addEventListener('click', function(ev) {
        if (!ev.target.closest('.js-open-address-type-modal')) return;
        ev.preventDefault();
        openAddressTypeModal();
      });
      if (addressTypeModalClose) addressTypeModalClose.addEventListener('click', closeAddressTypeModal);
      if (addressTypeModalCancel) addressTypeModalCancel.addEventListener('click', closeAddressTypeModal);
      if (addressTypeModalSubmit) {
        addressTypeModalSubmit.addEventListener('click', function() {
          if (!addressTypeNameInput || !addressTypeNameInput.value.trim()) {
            alert('Vui lòng nhập tên loại địa chỉ.');
            return;
          }
          if (addressTypeMode === 'edit') {
            var typeId = activeAddressTypeItem ? activeAddressTypeItem.getAttribute('data-id') : '';
            if (!typeId) return alert('Vui lòng chọn loại địa chỉ cần sửa.');
            requestAddressTypes('/nha-cung-cap/address-types/' + typeId + '/update', {
              ten_loai: addressTypeNameInput.value.trim()
            }, activeAddressTypeItem.getAttribute('data-code') || '');
            return;
          }
          requestAddressTypes('/nha-cung-cap/address-types/add', {
            ten_loai: addressTypeNameInput.value.trim(),
            ma_loai: addressTypeCodeInput && addressTypeCodeInput.value ? addressTypeCodeInput.value.trim() : ''
          }, '');
        });
      }
      renderAddressTypeSelects();
      initGhnAddressSelects(document);

      function submitSupplierAddressForm(action, formId, confirmMessage) {
        if (!action || !formId) return;
        if (confirmMessage && !confirm(confirmMessage)) return;

        var tempForm = document.createElement('form');
        tempForm.method = 'post';
        tempForm.action = action;
        tempForm.style.display = 'none';

        var fields = document.querySelectorAll('[data-address-form="' + formId + '"]');
        fields.forEach(function(field) {
          if (!field.name) return;
          if ((field.type === 'checkbox' || field.type === 'radio') && !field.checked) return;
          var input = document.createElement('input');
          input.type = 'hidden';
          input.name = field.name;
          input.value = field.value || '';
          tempForm.appendChild(input);
        });

        document.body.appendChild(tempForm);
        tempForm.submit();
      }

      document.addEventListener('click', function(event) {
        var profitBtn = event.target.closest('.js-supplier-address-profit-toggle');
        if (profitBtn) {
          event.preventDefault();
          event.stopPropagation();
          var addressId = profitBtn.getAttribute('data-address-id') || '';
          var row = addressId ? document.querySelector('[data-address-profit-row="' + addressId + '"]') : null;
          if (!row) return;
          var isOpen = row.style.display !== 'none';
          row.style.display = isOpen ? 'none' : 'table-row';
          profitBtn.textContent = isOpen ? 'Chi tiết' : 'Ẩn';
          return;
        }

        var submitBtn = event.target.closest('.js-supplier-address-submit');
        if (submitBtn) {
          event.preventDefault();
          event.stopPropagation();
          submitSupplierAddressForm(
            submitBtn.getAttribute('data-action'),
            submitBtn.getAttribute('data-form-id'),
            submitBtn.getAttribute('data-confirm')
          );
          return;
        }
        var delBtn = event.target.closest('.js-supplier-address-delete');
        if (delBtn) {
          event.preventDefault();
          event.stopPropagation();
          if (!confirm('Bạn có chắc muốn xóa địa chỉ này không?')) return;

          var tempForm = document.createElement('form');
          tempForm.method = 'post';
          tempForm.action = delBtn.getAttribute('data-action');
          tempForm.style.display = 'none';

          var returnQuery = document.createElement('input');
          returnQuery.type = 'hidden';
          returnQuery.name = 'returnQuery';
          returnQuery.value = delBtn.getAttribute('data-return-query') || '';
          tempForm.appendChild(returnQuery);

          document.body.appendChild(tempForm);
          tempForm.submit();
        }
      });

      document.addEventListener('click', function(event) {
        if (!supplierGroupFilterDropdown || !supplierGroupFilterTrigger) return;
        if (supplierGroupFilterDropdown.contains(event.target)) return;
        if (supplierGroupFilterTrigger.contains(event.target)) return;
        supplierGroupFilterDropdown.classList.remove('is-open');
      });

      var supplierImportToggle = document.getElementById('supplierImportToggle');
      var supplierImportMenu = document.getElementById('supplierImportMenu');
      var supplierImportPickBtn = document.getElementById('supplierImportPickBtn');
      var supplierImportForm = document.getElementById('supplierImportForm');
      var supplierImportFile = document.getElementById('supplierImportFile');

      function closeSupplierImportMenu() {
        if (!supplierImportMenu || !supplierImportToggle) return;
        supplierImportMenu.classList.remove('is-open');
        supplierImportToggle.setAttribute('aria-expanded', 'false');
      }

      function isSupplierExcelFile(file) {
        if (!file) return false;
        var name = String(file.name || '').toLowerCase();
        return /\.xlsx$/i.test(name);
      }

      if (supplierImportToggle && supplierImportMenu) {
        supplierImportToggle.addEventListener('click', function(event) {
          event.stopPropagation();
          var isOpen = supplierImportMenu.classList.toggle('is-open');
          supplierImportToggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
        });
      }

      if (supplierImportPickBtn && supplierImportFile) {
        supplierImportPickBtn.addEventListener('click', function() {
          closeSupplierImportMenu();
          supplierImportFile.value = '';
          supplierImportFile.click();
        });
      }

      if (supplierImportFile && supplierImportForm) {
        supplierImportFile.addEventListener('change', function() {
          var file = supplierImportFile.files && supplierImportFile.files[0];
          if (!file) return;

          if (!isSupplierExcelFile(file)) {
            alert('Chỉ chấp nhận file Excel (.xlsx). Vui lòng dùng file mẫu.');
            supplierImportFile.value = '';
            return;
          }

          if (window.showGlobalLoading && window.showGlobalLoading('Đang thêm nhà cung cấp từ file...') === false) {
            return;
          }
          supplierImportForm.submit();
        });
      }

      document.addEventListener('click', function(event) {
        if (!supplierImportMenu || !supplierImportToggle) return;
        if (supplierImportMenu.contains(event.target)) return;
        if (supplierImportToggle.contains(event.target)) return;
        closeSupplierImportMenu();
      });
    });
  </script>
</body>
</html>
