  <script src="/javascripts/global-loading.js"></script>
  <script src="/js/debt-period-export.js"></script>
  <script src="/js/kv-inline-detail.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      var openAddSupplierModalBtn = document.getElementById('openAddSupplierModal');
      var addSupplierModalOverlay = document.getElementById('addSupplierModalOverlay');
      var addSupplierModalClose = document.getElementById('addSupplierModalClose');
      var addSupplierModalCancel = document.getElementById('addSupplierModalCancel');
      var supplierCreateForm = document.getElementById('supplierCreateForm');

      function openAddSupplierModal() {
        if (!addSupplierModalOverlay) return;
        if (supplierCreateForm) supplierCreateForm.reset();
        addSupplierModalOverlay.classList.add('is-visible');
      }

      function closeAddSupplierModal() {
        if (!addSupplierModalOverlay) return;
        addSupplierModalOverlay.classList.remove('is-visible');
        if (window.location.search.indexOf('mode=create') >= 0) {
          var url = new URL(window.location.href);
          url.searchParams.delete('mode');
          window.history.replaceState({}, '', url.pathname + (url.searchParams.toString() ? '?' + url.searchParams.toString() : ''));
        }
      }

      if (openAddSupplierModalBtn) openAddSupplierModalBtn.addEventListener('click', openAddSupplierModal);
      if (addSupplierModalClose) addSupplierModalClose.addEventListener('click', closeAddSupplierModal);
      if (addSupplierModalCancel) addSupplierModalCancel.addEventListener('click', closeAddSupplierModal);
      if (addSupplierModalOverlay && addSupplierModalOverlay.getAttribute('data-auto-open') === '1') {
        openAddSupplierModal();
      }

      if (supplierCreateForm) {
        supplierCreateForm.addEventListener('submit', function(event) {
          if (typeof supplierCreateForm.checkValidity === 'function' && !supplierCreateForm.checkValidity()) return;
          if (window.showGlobalLoading && window.showGlobalLoading('Đang thêm nhà cung cấp...') === false) {
            event.preventDefault();
          }
        });
      }

      function showSupplierEditError(form, field) {
        var error = form.querySelector('[data-supplier-edit-error]');
        if (!error) return;
        if (!field) {
          error.hidden = true;
          error.textContent = '';
          return;
        }
        if (field.name === 'ten_ncc' && field.validity.valueMissing) {
          error.textContent = 'Vui lòng nhập tên nhà cung cấp trước khi lưu.';
        } else if (field.name === 'email' && field.validity.typeMismatch) {
          error.textContent = 'Email chưa đúng định dạng. Vui lòng kiểm tra lại trước khi lưu.';
        } else {
          error.textContent = field.validationMessage || 'Vui lòng kiểm tra lại thông tin nhà cung cấp trước khi lưu.';
        }
        error.hidden = false;
      }

      document.addEventListener('invalid', function(event) {
        var form = event.target.form;
        if (!form || !form.classList.contains('supplier-inline-edit-form')) return;
        showSupplierEditError(form, form.querySelector(':invalid') || event.target);
      }, true);

      document.addEventListener('input', function(event) {
        var form = event.target.form;
        if (form && form.classList.contains('supplier-inline-edit-form') && !form.querySelector(':invalid')) {
          showSupplierEditError(form, null);
        }
      });

      document.addEventListener('submit', function(event) {
        if (!event.target.classList.contains('supplier-inline-edit-form')) return;
        showSupplierEditError(event.target, null);
        if (window.showGlobalLoading && window.showGlobalLoading('Đang lưu thông tin nhà cung cấp...') === false) {
          event.preventDefault();
        }
      });

      function parseSupplierMoney(value) {
        var normalized = String(value || '')
          .replace(/[.\s\u00a0\u202f]/g, '')
          .replace(/,/g, '')
          .trim();
        if (normalized === '') return '';
        var number = Number(normalized);
        return Number.isFinite(number) && number >= 0 ? Math.floor(number) : '';
      }
      function formatSupplierMoney(value) {
        if (value === '' || value == null) return '';
        var number = Math.max(0, Math.floor(Number(value || 0)));
        if (!Number.isFinite(number)) return '';
        return String(number).replace(/\B(?=(\d{3})+(?!\d))/g, '.');
      }
      function formatSupplierSignedMoney(value) {
        if (value === '' || value == null) return '';
        var number = Math.floor(Number(value || 0));
        if (!Number.isFinite(number)) return '';
        var absText = String(Math.abs(number)).replace(/\B(?=(\d{3})+(?!\d))/g, '.');
        return number < 0 ? ('-' + absText) : absText;
      }
      function setSupplierMoneyTone(element, value) {
        if (!element) return;
        var number = Number(value || 0);
        element.classList.remove('supplier-money-positive', 'supplier-money-negative');
        if (number > 0) element.classList.add('supplier-money-positive');
        if (number < 0) element.classList.add('supplier-money-negative');
      }
      function bindVnMoneyFilterInputs(root) {
        var scope = root || document;
        scope.querySelectorAll('.js-vn-money-filter').forEach(function(input) {
          if (input.getAttribute('data-vn-money-bound') === '1') return;
          input.setAttribute('data-vn-money-bound', '1');
          input.addEventListener('input', function() {
            var digits = String(input.value || '').replace(/\D/g, '');
