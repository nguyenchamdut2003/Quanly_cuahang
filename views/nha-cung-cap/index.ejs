        if (!overpaymentToggle) return;
        updateSupplierPayAllocation(overpaymentToggle.closest('.supplier-pay-form'), 'amount');
      });

      document.addEventListener('click', function(e) {
        var refA = e.target.closest('a.ref-link[href^="/nha-cung-cap/"]');
        if (!refA || (window.location.pathname || '') !== '/nha-cung-cap') return;
