                  <input type="hidden" name="overpayment_amount" class="js-supplier-pay-overpayment" value="0">
                  <input type="hidden" name="payment_v2" value="1">
                  <input type="hidden" name="chi_tiet_thanh_toan[tien_tra_khach]" value="0">
                  <% if (debtCheck.hasDebtMismatch) { %>
                    <div class="supplier-pay-mismatch-alert">
                      <strong>Nợ theo phiếu nhập đang lệch với sổ công nợ. Nợ hiện tại phía trên là số tiền tối đa cần
                        trả; nợ theo phiếu nhập chỉ dùng để phân bổ vào hóa đơn.</strong>
                      <div class="supplier-pay-mismatch-grid">
                        <span>Nợ theo phiếu nhập</span><b>
                          <%= Number(debtCheck.debtByInvoices || 0).toLocaleString('vi-VN') %>
                        </b>
                        <span>Nợ theo sổ công nợ</span><b>
                          <%= Number(debtCheck.debtByLedger || 0).toLocaleString('vi-VN') %>
                        </b>
                        <span>Chênh lệch</span><b>
                          <%= Number(debtCheck.debtDiff || 0).toLocaleString('vi-VN') %>
                        </b>
                      </div>
                    </div>
                    <% } %>
                      <div class="supplier-pay-grid">
                        <label class="supplier-pay-field">
                          <span>Thời gian</span>
                          <span class="supplier-pay-input-wrap">
                            <input name="ngay_lap_display" type="text"
                              value="<%= new Date().toLocaleString('vi-VN', { day:'2-digit', month:'2-digit', year:'numeric', hour:'2-digit', minute:'2-digit', hour12:false }) %>"
                              readonly>
                            <span class="supplier-pay-icons"><i class="fa-regular fa-calendar"></i><i
                                class="fa-regular fa-clock"></i></span>
                          </span>
                        </label>
                        <label class="supplier-pay-field">
                          <span>Người chi</span>
                          <select name="nguoi_chi_display" disabled>
                            <option selected>
                              <%= currentUserName || 'test' %>
                            </option>
                          </select>
                        </label>
                        <label class="supplier-pay-field">
                          <span>Phương thức thanh toán</span>
                          <select name="phuong_thuc_thanh_toan">
                            <option value="tien_mat">Tiền mặt</option>
                            <option value="chuyen_khoan">Chuyển khoản</option>
                            <option value="vi_dien_tu">Ví điện tử</option>
                            <option value="khac">Khác</option>
                          </select>
                        </label>
                        <label class="supplier-pay-field">
                          <span>Sổ quỹ</span>
                          <select name="so_quy_id" required>
                            <% if (!(cashBooks || []).length) { %>
                              <option value="">Chưa có sổ quỹ</option>
                              <% } %>
                                <% (cashBooks || []).forEach(function(cashBook) { %>
                                  <option value="<%= cashBook._id %>">
                                    <%= cashBook.ten_so_quy || 'Sổ quỹ' %>
                                  </option>
                                  <% }) %>
                          </select>
                        </label>
                        <label class="supplier-pay-field">
                          <span>Số tiền</span>
                          <input class="js-supplier-pay-cash" name="chi_tiet_thanh_toan[tien_mat]" inputmode="numeric"
                            autocomplete="off" value="" placeholder="Tiền mặt">
                        </label>
                        <label class="supplier-pay-field">
                          <span>Sổ tiền mặt</span>
                          <select class="js-supplier-pay-cash-book" name="chi_tiet_thanh_toan[so_quy_tien_mat_id]">
                            <option value="">— Chọn sổ tiền mặt —</option>
                            <% (cashBooks || []).filter(function(cashBook) { return (cashBook.loai_so_quy || 'tien_mat'
                              )==='tien_mat' ; }).forEach(function(cashBook) { %>
                              <option value="<%= cashBook._id %>" <%=cashBook.mac_dinh ? 'selected' : '' %>><%=
                                  cashBook.ten_so_quy || 'Sổ tiền mặt' %>
                              </option>
                              <% }) %>
                          </select>
                        </label>
                        <label class="supplier-pay-field">
                          <span>Chuyển khoản</span>
                          <input class="js-supplier-pay-transfer" name="chi_tiet_thanh_toan[chuyen_khoan]"
                            inputmode="numeric" autocomplete="off" value="" placeholder="Chuyển khoản">
                        </label>
                        <label class="supplier-pay-field">
                          <span>Tài khoản ngân hàng</span>
                                                    <select class="js-supplier-pay-bank-book" name="chi_tiet_thanh_toan[so_quy_chuyen_khoan_id]">
                            <option value="">-- Chọn tài khoản chuyển khoản --</option>
                            <% (cashBooks || []).filter(function(cashBook) { return cashBook.loai_so_quy === 'chuyen_khoan'; }).forEach(function(cashBook) { %>
                              <% var bankInfo = cashBook.thong_tin_ngan_hang || {}; %>
                              <option value="<%= cashBook._id %>" <%= cashBook.mac_dinh ? 'selected' : '' %>><%= (bankInfo.ten_ngan_hang || cashBook.ten_so_quy || 'Tài khoản') + (bankInfo.so_tai_khoan ? (' - ' + bankInfo.so_tai_khoan) : '') %></option>
                            <% }) %>
                          </select>
                  </label>
                  <label class="supplier-pay-field">
                    <span>Tổng thanh toán</span>
                    <input class="js-supplier-pay-amount" name="gia_tri" inputmode="numeric" autocomplete="off" value="" readonly>
                  </label>
                  <label class="supplier-pay-field">
                    <span>Nợ còn</span>
                    <input class="supplier-pay-readonly js-supplier-pay-remaining" type="text" value="<%= Number(selectedSupplier.tong_no || 0).toLocaleString('vi-VN') %>" readonly>
                        </label>
                        <label class="supplier-pay-field supplier-pay-field-full">
                          <span>Ghi chú</span>
                          <textarea name="ghi_chu" placeholder="Nhập ghi chú"></textarea>
                        </label>
                      </div>
                      <label class="supplier-pay-check">
                        <input type="checkbox" checked disabled>
                        <span>Phân bổ vào phiếu nhập và phiếu mua dịch vụ</span>
                      </label>
                      <label class="supplier-pay-check">
                        <input type="checkbox" name="enable_overpayment" class="js-supplier-pay-allow-overpayment">
                        <span>Cho phép trả dư / ứng trước NCC</span>
                      </label>
                      <% var supplierUnpaidPurchaseDebtTotal=Number((supplierUnpaidPurchases || []).reduce(function(sum,
                        p) { return sum + Number(p.con_no_ncc || 0); }, 0)); %>
                        <% if (supplierUnpaidPurchaseDebtTotal !==Number(selectedSupplier.tong_no || 0)) { %>
                          <div class="supplier-pay-reconcile-note">
                            Nợ theo phiếu nhập: <strong>
                              <%= supplierUnpaidPurchaseDebtTotal.toLocaleString('vi-VN') %>
                            </strong>.
                            Nợ hiện tại theo sổ công nợ: <strong>
                              <%= Number(selectedSupplier.tong_no || 0).toLocaleString('vi-VN') %> VNĐ
                            </strong>.
                          </div>
                          <% } %>
                            <div class="supplier-pay-table-wrap table-wrap">
                              <table class="admin-table warehouse-table">
                                <thead>
                                  <tr>
                                    <th>Mã hóa đơn</th>
                                    <th>Thời gian</th>
                                    <th class="text-right">Giá trị phiếu nhập</th>
                                    <th class="text-right">Đã trả trước</th>
                                    <th class="text-right">Còn cần trả <i class="fa-regular fa-circle-question"></i>
                                    </th>
                                    <th class="text-right">Tiền trả</th>
                                    <th class="text-right">Còn nợ</th>
                                  </tr>
                                </thead>
                                <tbody>
                                  <% if (!(supplierUnpaidPurchases || []).length) { %>
                                    <tr>
                                      <td colspan="7">
                                        <div class="supplier-pay-empty">
                                          <span class="supplier-pay-empty-icon"><i
                                              class="fa-regular fa-inbox"></i></span>
                                          <span>Không có kết quả phù hợp</span>
                                        </div>
                                      </td>
                                    </tr>
                                    <% } %>
                                      <% (supplierUnpaidPurchases || []).forEach(function(purchase) { %>
                                        <tr class="js-supplier-pay-row"
                                          data-debt="<%= Number(purchase.con_no_ncc || 0) %>">
                                          <td>
                                            <%= purchase.ma_phieu_nhap || '--' %>
                                          </td>
                                          <td>
                                            <%= formatDate(purchase.ngay_nhap || purchase.created_at) %>
                                          </td>
                                          <td class="text-right">
                                            <%= Number(purchase.can_tra_ncc || purchase.tong_tien ||
                                              0).toLocaleString('vi-VN') %>
                                          </td>
                                          <td class="text-right">
                                            <%= Number(purchase.da_tra_ncc || 0).toLocaleString('vi-VN') %>
                                          </td>
                                          <td class="text-right">
                                            <%= Number(purchase.con_no_ncc || 0).toLocaleString('vi-VN') %>
                                          </td>
                                          <td class="text-right">
                                            <input class="supplier-pay-row-input js-supplier-pay-row-paid-input"
                                              inputmode="numeric" autocomplete="off" value="0"
                                              data-purchase-id="<%= purchase._id %>"
                                              data-purchase-code="<%= purchase.ma_phieu_nhap || '' %>"
                                              data-debt="<%= Number(purchase.con_no_ncc || 0) %>">
                                          </td>
                                          <td class="text-right js-supplier-pay-row-left">
                                            <%= Number(purchase.con_no_ncc || 0).toLocaleString('vi-VN') %>
                                          </td>
                                        </tr>
                                        <% }) %>
                                </tbody>
                                <% if ((supplierUnpaidPurchases || []).length) { %>
                                  <tfoot>
                                    <tr class="supplier-pay-total-row">
                                      <td colspan="4"></td>
                                      <td class="text-right js-supplier-pay-total-debt">
                                        <%= supplierUnpaidPurchaseDebtTotal.toLocaleString('vi-VN') %>
                                      </td>
                                      <td class="text-right js-supplier-pay-total-paid">0</td>
                                      <td class="text-right js-supplier-pay-total-left">
                                        <%= supplierUnpaidPurchaseDebtTotal.toLocaleString('vi-VN') %>
                                      </td>
                                    </tr>
                                    <tr class="supplier-pay-unallocated-row">
                                      <td colspan="5"></td>
                                      <td class="js-supplier-pay-unallocated-label">Tiền chưa gắn phiếu nhập:</td>
                                      <td class="text-right js-supplier-pay-unallocated">0</td>
                                    </tr>
                                  </tfoot>
                                  <% } %>
                              </table>
                            </div>
                </form>
              </div>
              <div class="supplier-pay-footer">
                <button class="btn btn-light js-close-supplier-pay-modal" type="button">Bỏ qua</button>
                <button class="btn btn-light js-submit-supplier-pay-modal" type="button" data-print="1"
                  data-form-id="supplierPayForm_<%= selectedSupplier._id %>">Tạo phiếu chi & In</button>
                <button class="btn btn-primary js-submit-supplier-pay-modal" type="button"
                  data-form-id="supplierPayForm_<%= selectedSupplier._id %>">Tạo phiếu chi</button>
              </div>
            </div>
        </div>
        <div class="supplier-pay-modal-overlay js-supplier-discount-overlay"
          id="supplierDiscountModal_<%= selectedSupplier._id %>" aria-hidden="true">
          <div class="supplier-pay-modal" role="dialog" aria-modal="true"
            aria-labelledby="supplierDiscountTitle_<%= selectedSupplier._id %>">
            <div class="supplier-pay-header">
              <div>
                <h3 class="supplier-pay-title" id="supplierDiscountTitle_<%= selectedSupplier._id %>">Chiết khấu thanh
                  toán</h3>
                <div class="supplier-pay-subtitle">
                  <span>
                    <%= selectedSupplier.ten_cong_ty || selectedSupplier.ten_ncc || 'Nhà cung cấp' %>
                  </span>
                  <span>·</span>
                  <span class="supplier-pay-debt-badge">Nợ hiện tại: <%= Number(selectedSupplier.tong_no ||
                      0).toLocaleString('vi-VN') %> VNĐ</span>
                </div>
              </div>
              <button class="supplier-pay-close js-close-supplier-discount-modal" type="button"
                aria-label="Đóng">×</button>
            </div>
            <div class="supplier-pay-body">
              <form id="supplierDiscountForm_<%= selectedSupplier._id %>" class="supplier-discount-form"
                data-action="/nha-cung-cap/<%= selectedSupplier._id %>/discount-debt"
                data-current-debt="<%= Number(selectedSupplier.tong_no || 0) %>">
                <div class="supplier-pay-grid">
                  <label class="supplier-pay-field">
                    <span>Thời gian</span>
                    <span class="supplier-pay-input-wrap">
                      <input name="ngay_giao_dich_display" type="text"
                        value="<%= new Date().toLocaleString('vi-VN', { day:'2-digit', month:'2-digit', year:'numeric', hour:'2-digit', minute:'2-digit', hour12:false }) %>"
                        readonly>
                      <span class="supplier-pay-icons"><i class="fa-regular fa-calendar"></i><i
                          class="fa-regular fa-clock"></i></span>
                    </span>
                  </label>
                  <label class="supplier-pay-field">
                    <span>Người thực hiện</span>
                    <select name="nguoi_thuc_hien_display" disabled>
                      <option selected>
                        <%= currentUserName || 'test' %>
                      </option>
                    </select>
                  </label>
                  <label class="supplier-pay-field supplier-pay-field-full">
                    <span>Chiết khấu từ nhà cung cấp</span>
                    <input class="js-supplier-discount-amount" name="gia_tri" inputmode="numeric" autocomplete="off"
                      value="">
                    <small class="supplier-pay-remaining-hint">Còn nợ: <span class="js-supplier-discount-remaining">
                        <%= Number(selectedSupplier.tong_no || 0).toLocaleString('vi-VN') %>
                      </span></small>
                  </label>
                  <label class="supplier-pay-field supplier-pay-field-full">
                    <span>Ghi chú</span>
                    <textarea name="ghi_chu" placeholder="Nhập ghi chú"></textarea>
                  </label>
                </div>
                <label class="supplier-pay-check" style="display: none;">
                  <input type="checkbox" name="phan_bo_phieu_nhap" value="1">
                  <span>Phân bổ vào phiếu nhập hàng</span>
                </label>
              </form>
            </div>
            <div class="supplier-pay-footer">
              <button class="btn btn-light js-close-supplier-discount-modal" type="button">Bỏ qua</button>
              <button class="btn btn-primary js-submit-supplier-discount-modal" type="button"
                data-form-id="supplierDiscountForm_<%= selectedSupplier._id %>">Tạo phiếu</button>
            </div>
          </div>
        </div>
