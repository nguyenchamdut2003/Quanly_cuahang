        <div class="supplier-pane-toolbar supplier-debt-toolbar">
          <div class="supplier-debt-summary">
            <span class="supplier-debt-summary-label">Nợ hiện tại</span>
            <strong class="supplier-debt-summary-value">
              <%= Number(selectedSupplier.tong_no || 0).toLocaleString('vi-VN') %> VNĐ
            </strong>
          </div>
          <div class="supplier-debt-actions">
            <label class="supplier-debt-sort-check" title="Ưu tiên phiếu còn nợ, nợ lâu nhất lên đầu">
              <input type="checkbox" class="js-supplier-debt-sort-oldest" disabled>
              <span>Nợ lâu nhất trước</span>
            </label>
            <button class="btn btn-light btn-sm js-open-supplier-pay-modal" type="button"
              data-modal-id="supplierPayModal_<%= selectedSupplier._id %>">Thanh toán</button>
            <button class="btn btn-light btn-sm js-open-supplier-discount-modal" type="button"
              data-modal-id="supplierDiscountModal_<%= selectedSupplier._id %>">Chiết khấu thanh toán</button>
            <button type="button" class="btn btn-primary btn-sm js-debt-export-trigger" data-export-kind="both"
              data-export-base="/nha-cung-cap/<%= selectedSupplier._id %>/export/debt"
              data-extra-qs="<%= filterQueryString || '' %>">Xuất công nợ</button>
            <button type="button" class="btn btn-light btn-sm js-debt-export-trigger" data-export-kind="quan-tri"
              data-export-base="/nha-cung-cap/<%= selectedSupplier._id %>/export/debt"
              data-extra-qs="<%= filterQueryString || '' %>">Quản trị</button>
            <button type="button" class="btn btn-light btn-sm js-debt-export-trigger supplier-partner-export-btn"
              data-export-kind="doi-tac" data-export-base="/nha-cung-cap/<%= selectedSupplier._id %>/export/debt"
              data-extra-qs="<%= filterQueryString || '' %>" title="Xuất file báo cáo excel cho đối tác"
              aria-label="Xuất file báo cáo excel cho đối tác">Xuất file báo cáo excel cho đối tác</button>
          </div>
        </div>
        <div class="supplier-pane-table-wrap table-wrap">
          <table class="admin-table warehouse-table" id="supplierDebtHistoryTable_<%= selectedSupplier._id %>"
            data-warn-days="<%= Number(debtWarnMinDays || debtWarnDefaultDays || 10) %>">
            <thead>
              <tr>
                <th class="text-center">Mã phiếu</th>
                <th class="text-center">Thời gian</th>
                <th class="text-center">Loại chứng từ</th>
                <th class="text-center">Giá trị</th>
                <th class="text-center">Đã thanh toán</th>
                <th class="text-center">Còn lại</th>
                <th class="text-center">Tổng nợ</th>
              </tr>
            </thead>
            <tbody>
              <% if ((supplierDebtHistory || []).length===0) { %>
                <tr>
                  <td colspan="7" class="empty-cell">Chưa có lịch sử công nợ.</td>
                </tr>
                <% } %>
                  <% (supplierDebtHistory || []).forEach(function(row) { %>
                    <tr
                      class="js-supplier-debt-row<%= row.is_debt_overdue ? ' supplier-debt-row-overdue' : '' %><%= !row.co_no_con_lai ? ' supplier-debt-row-paid' : '' %>"
                      data-has-debt="<%= row.co_no_con_lai ? '1' : '0' %>"
                      data-debt-days="<%= row.so_ngay_no != null ? row.so_ngay_no : '' %>"
                      data-debt-time="<%= row.thoi_gian ? new Date(row.thoi_gian).getTime() : 0 %>">
                                            <td class="text-center">
                        <% if (row.phieu_tra_nhap_id) { %>
                          <a class="table-code-link" href="/tra-hang-nhap/<%= encodeURIComponent(String(row.phieu_tra_nhap_id._id || row.phieu_tra_nhap_id)) %>"><%= row.ma_phieu || '--' %></a>
                        <% } else if (row.phieu_nhap_id) { %>
                          <%- refLink('purchase', row.phieu_nhap_id, row.ma_phieu || '--') %>
                        <% } else if (row.nhap_vat_chua_id) { %>
                          <a class="table-code-link" href="/vat-chua?nhap_vat_chua=<%= encodeURIComponent(String(row.nhap_vat_chua_id._id || row.nhap_vat_chua_id)) %>"><%= row.ma_phieu || '--' %></a>
                        <% } else if (row.xuat_vat_chua_id) { %>
                          <a class="table-code-link" href="/vat-chua?xuat_vat_chua=<%= encodeURIComponent(String(row.xuat_vat_chua_id._id || row.xuat_vat_chua_id)) %>"><%= row.ma_phieu || '--' %></a>
                        <% } else if (row.phieu_thu_chi_id) { %>
                          <%- refLink('receipt', row.phieu_thu_chi_id, row.ma_phieu || '--') %>
                        <% } else { %>
                          <%= row.ma_phieu || '--' %>
                        <% } %>
                      </td>
                      <td class="supplier-muted-cell text-center">
                        <%= formatDate(row.thoi_gian) %>
                          <% if (row.co_no_con_lai && row.so_ngay_no !=null) { %>
                            <div style="font-size:11px;color:#b42318;margin-top:2px">
                              <%= row.so_ngay_no %> ngày
                            </div>
                            <% } %>
                      </td>
                      <td class="text-center">
                        <%= row.loai_chung_tu || '--' %>
                      </td>
                      <td class="text-center">
                        <%= Number(row.gia_tri || 0).toLocaleString('vi-VN') %> VNĐ
                      </td>
                      <td class="text-center">
                        <%= Number(row.da_thanh_toan || 0).toLocaleString('vi-VN') %> VNĐ
                      </td>
                      <td class="text-center">
                        <%= Number(row.con_lai || 0).toLocaleString('vi-VN') %> VNĐ
                      </td>
                      <td class="text-center"><strong>
                          <%= Number(row.tong_no || 0).toLocaleString('vi-VN') %> VNĐ
                        </strong></td>
                    </tr>
                    <% }) %>
            </tbody>
          </table>
        </div>
        <div class="supplier-pay-modal-overlay js-supplier-pay-overlay"
          id="supplierPayModal_<%= selectedSupplier._id %>" aria-hidden="true">
          <% var debtCheck=debtReconciliation || { debtByInvoices: 0, debtByLedger: Number(selectedSupplier.tong_no ||
            0), debtDiff: 0, hasDebtMismatch: false }; %>
            <div class="supplier-pay-modal" role="dialog" aria-modal="true"
              aria-labelledby="supplierPayTitle_<%= selectedSupplier._id %>">
              <div class="supplier-pay-header">
                <div>
                  <h3 class="supplier-pay-title" id="supplierPayTitle_<%= selectedSupplier._id %>">Thanh toán</h3>
                  <div class="supplier-pay-subtitle">
                    <span>
                      <%= selectedSupplier.ten_cong_ty || selectedSupplier.ten_ncc || 'Nhà cung cấp' %>
                    </span>
                    <span>·</span>
                    <span class="supplier-pay-debt-badge">Nợ hiện tại: <%= Number(selectedSupplier.tong_no ||
                        0).toLocaleString('vi-VN') %> VNĐ</span>
                  </div>
                </div>
                <button class="supplier-pay-close js-close-supplier-pay-modal" type="button"
                  aria-label="Đóng">×</button>
              </div>
              <div class="supplier-pay-body">
                <form id="supplierPayForm_<%= selectedSupplier._id %>" class="supplier-pay-form"
                  data-action="/nha-cung-cap/<%= selectedSupplier._id %>/pay-debt"
                  data-current-debt="<%= Number(selectedSupplier.tong_no || 0) %>"
                  data-has-debt-mismatch="<%= debtCheck.hasDebtMismatch ? '1' : '0' %>">
