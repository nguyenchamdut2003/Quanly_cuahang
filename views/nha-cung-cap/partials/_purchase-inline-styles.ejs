    .supplier-purchase-inline-row .lot-group-title { margin: 10px 0 6px; font-size: 13px; font-weight: 800; }
    .supplier-purchase-inline-row .lot-group-title:first-child { margin-top: 0; }
    .supplier-purchase-inline-row .grouped-lot-table .attr-cell { min-width: 140px; }
    .supplier-purchase-inline-row .grouped-lot-table .lot-total-cell { width: 120px; text-align: right; vertical-align: middle; font-weight: 800; color: #006dff; }
    .supplier-purchase-inline-row .grouped-lot-table .group-total-row td { background: #ffe900; color: #111827; font-weight: 800; }
    .supplier-purchase-inline-row .summary-card { align-self: start; border: 1px solid #e4eaf2; border-radius: 6px; padding: 10px; }
    .supplier-purchase-inline-row .summary-line { display: flex; justify-content: space-between; gap: 12px; margin: 6px 0; font-size: 12px; }
    .supplier-purchase-inline-row .summary-line b { font-size: 13px; text-align: right; }
    .supplier-purchase-inline-row .purchase-vat-chua-box { margin-bottom: 12px; border: 1px solid #bfdbfe; background: #eff6ff; border-radius: 6px; padding: 10px 12px; }
    .supplier-purchase-inline-row .purchase-vat-chua-title { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; font-size: 13px; font-weight: 800; }
    @media(max-width:1350px) { .supplier-purchase-inline-row .detail-body { grid-template-columns: minmax(0, 1fr); } }
    @media(max-width:900px) { .supplier-purchase-inline-row .detail-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .supplier-purchase-inline-row .detail-grid .item[style*="grid-column"] { grid-column: auto !important; } }
    @media(max-width:520px) { .supplier-purchase-inline-row .detail-grid { grid-template-columns: 1fr; } }
    .supplier-purchase-history { container-type: inline-size; }
