              <button class="btn btn-light js-submit-supplier-pay-modal" type="button" data-print="1" data-form-id="supplierPayForm_<%= selectedSupplier._id %>">Tạo phiếu chi & In</button>
              <button class="btn btn-primary js-submit-supplier-pay-modal" type="button" data-form-id="supplierPayForm_<%= selectedSupplier._id %>">Tạo phiếu chi</button>
            </div>
          </div>
        </div>
        <div class="supplier-pay-modal-overlay js-supplier-discount-overlay" id="supplierDiscountModal_<%= selectedSupplier._id %>" aria-hidden="true">
