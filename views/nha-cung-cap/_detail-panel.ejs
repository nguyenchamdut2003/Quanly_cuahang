                    </thead>
                    <tbody>
                      <% if (!(supplierUnpaidPurchases || []).length) { %>
                        <tr>
                          <td colspan="7">
                            <div class="supplier-pay-empty">
                              <span class="supplier-pay-empty-icon"><i class="fa-regular fa-inbox"></i></span>
                              <span>Không có kết quả phù hợp</span>
