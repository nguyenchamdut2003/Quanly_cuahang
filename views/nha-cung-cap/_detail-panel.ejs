<div class="kv-detail-panel product-detail supplier-inline-detail">
  <div class="supplier-detail" data-supplier-detail>
    <div class="detail-tabs">
      <div class="detail-tab-list">
        <button class="detail-tab is-active" type="button" data-detail-tab="info">Thông tin nhà cung cấp</button>
        <button class="detail-tab" type="button" data-detail-tab="address">Danh sách địa chỉ</button>
        <button class="detail-tab" type="button" data-detail-tab="history">Nhập/trả hàng hóa</button>
        <button class="detail-tab" type="button" data-detail-tab="vat-chua">Nhập/trả vật chứa</button>
        <button class="detail-tab" type="button" data-detail-tab="debt">Nợ cần trả nhà cung cấp</button>
        <button class="detail-tab" type="button" data-detail-tab="xnb">Xuất dùng nội bộ</button>
      </div>
    </div>

    <div class="supplier-detail-body">
      <div class="detail-pane is-active" data-detail-pane="info">
        <%- include('partials/_tab-info') %>
      </div>

      <div class="detail-pane" data-detail-pane="address" data-lazy-tab="address" data-lazy-tab-url="/nha-cung-cap/api/<%= selectedSupplier._id %>/tab/address">
        <div class="empty-cell supplier-lazy-tab-placeholder">Chọn tab để tải danh sách địa chỉ.</div>
      </div>

      <div class="detail-pane" data-detail-pane="history" data-lazy-tab="history" data-lazy-tab-url="/nha-cung-cap/api/<%= selectedSupplier._id %>/tab/history">
        <div class="empty-cell supplier-lazy-tab-placeholder">Chọn tab để tải nhập/trả hàng hóa.</div>
      </div>

      <div class="detail-pane" data-detail-pane="vat-chua" data-lazy-tab="vat-chua" data-lazy-tab-url="/nha-cung-cap/api/<%= selectedSupplier._id %>/tab/vat-chua">
        <div class="empty-cell supplier-lazy-tab-placeholder">Chọn tab để tải nhập/trả vật chứa.</div>
      </div>

      <div class="detail-pane" data-detail-pane="debt" data-lazy-tab="debt" data-lazy-tab-url="/nha-cung-cap/api/<%= selectedSupplier._id %>/tab/debt">
        <div class="empty-cell supplier-lazy-tab-placeholder">Chọn tab để tải nợ cần trả nhà cung cấp.</div>
      </div>

      <div class="detail-pane" data-detail-pane="xnb" data-lazy-tab="xnb" data-lazy-tab-url="/nha-cung-cap/api/<%= selectedSupplier._id %>/tab/xnb">
        <div class="empty-cell supplier-lazy-tab-placeholder">Chọn tab để tải xuất dùng nội bộ.</div>
      </div>

    </div>

    <form id="supplierInlineDel_<%= selectedSupplier._id %>" method="post"
      action="/nha-cung-cap/<%= selectedSupplier._id %>/delete" style="display:none" aria-hidden="true"></form>
  </div>
</div>
<script>
  (function () {
    document.querySelectorAll('[id^="supplierDebtHistoryTable_"]').forEach(function (table) {
      var tbody = table.querySelector('tbody');
      var warnDays = Number(table.getAttribute('data-warn-days') || 10);
      var panel = table.closest('[data-supplier-detail]') || table.closest('.supplier-detail');
      var sortCheck = panel ? panel.querySelector('.js-supplier-debt-sort-oldest') : null;
      if (sortCheck) {
        sortCheck.addEventListener('change', function () {
          sortCheck.checked = false;
        });
        sortCheck.checked = false;
      }
      if (tbody) {
        tbody.querySelectorAll('.js-supplier-debt-row').forEach(function (row) {
          var days = Number(row.getAttribute('data-debt-days'));
          var hasDebt = row.getAttribute('data-has-debt') === '1';
          if (hasDebt && Number.isFinite(days) && days >= warnDays) {
            row.classList.add('supplier-debt-row-overdue');
          }
        });
      }
    });
  })();
</script>
