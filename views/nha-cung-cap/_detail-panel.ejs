            </div>
            <div class="supplier-pay-body">
              <form id="supplierDiscountForm_<%= selectedSupplier._id %>" class="supplier-discount-form" data-action="/nha-cung-cap/<%= selectedSupplier._id %>/discount-debt" data-current-debt="<%= Number(selectedSupplier.tong_no || 0) %>">
                <div class="supplier-pay-grid">
                  <label class="supplier-pay-field">
                    <span>Thời gian</span>
                    <span class="supplier-pay-input-wrap">
                      <input name="ngay_giao_dich_display" type="text" value="<%= new Date().toLocaleString('vi-VN', { day:'2-digit', month:'2-digit', year:'numeric', hour:'2-digit', minute:'2-digit', hour12:false }) %>" readonly>
                      <span class="supplier-pay-icons"><i class="fa-regular fa-calendar"></i><i class="fa-regular fa-clock"></i></span>
                    </span>
                  </label>
                  <label class="supplier-pay-field">
                    <span>Người thực hiện</span>
                    <select name="nguoi_thuc_hien_display" disabled>
                      <option selected><%= currentUserName || 'test' %></option>
                    </select>
                  </label>
                  <label class="supplier-pay-field supplier-pay-field-full">
                    <span>Chiết khấu từ nhà cung cấp</span>
                    <input class="js-supplier-discount-amount" name="gia_tri" inputmode="numeric" autocomplete="off" value="">
                    <small class="supplier-pay-remaining-hint">Còn nợ: <span class="js-supplier-discount-remaining"><%= Number(selectedSupplier.tong_no || 0).toLocaleString('vi-VN') %></span></small>
