                          <td class="text-right"><%= Number(purchase.can_tra_ncc || purchase.tong_tien || 0).toLocaleString('vi-VN') %></td>
                          <td class="text-right"><%= Number(purchase.da_tra_ncc || 0).toLocaleString('vi-VN') %></td>
                          <td class="text-right"><%= Number(purchase.con_no_ncc || 0).toLocaleString('vi-VN') %></td>
                          <td class="text-right">
                            <input
                              class="supplier-pay-row-input js-supplier-pay-row-paid-input"
                              inputmode="numeric"
                              autocomplete="off"
                              value="0"
                              data-purchase-id="<%= purchase._id %>"
                              data-purchase-code="<%= purchase.ma_phieu_nhap || '' %>"
                              data-debt="<%= Number(purchase.con_no_ncc || 0) %>"
                            >
                          </td>
                          <td class="text-right js-supplier-pay-row-left"><%= Number(purchase.con_no_ncc || 0).toLocaleString('vi-VN') %></td>
                        </tr>
                      <% }) %>
                    </tbody>
                    <% if ((supplierUnpaidPurchases || []).length) { %>
                      <tfoot>
                        <tr class="supplier-pay-total-row">
                          <td colspan="4"></td>
                          <td class="text-right js-supplier-pay-total-debt"><%= supplierUnpaidPurchaseDebtTotal.toLocaleString('vi-VN') %></td>
                          <td class="text-right js-supplier-pay-total-paid">0</td>
                          <td class="text-right js-supplier-pay-total-left"><%= supplierUnpaidPurchaseDebtTotal.toLocaleString('vi-VN') %></td>
                        </tr>
                        <tr class="supplier-pay-unallocated-row">
                          <td colspan="5"></td>
                          <td class="js-supplier-pay-unallocated-label">Tiền chưa gắn phiếu nhập:</td>
                          <td class="text-right js-supplier-pay-unallocated">0</td>
                        </tr>
                      </tfoot>
                    <% } %>
                  </table>
                </div>
