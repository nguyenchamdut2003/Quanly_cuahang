                  <td class="supplier-muted-cell text-center"><%= formatDate(row.thoi_gian) %><% if (row.co_no_con_lai && row.so_ngay_no != null) { %><div style="font-size:11px;color:#b42318;margin-top:2px"><%= row.so_ngay_no %> ngày</div><% } %></td>
                                      <td class="text-center"><%= row.loai_chung_tu || '--' %></td>
                  <td class="text-center"><%= Number(row.gia_tri || 0).toLocaleString('vi-VN') %> VNĐ</td>
                  <td class="text-center"><%= Number(row.da_thanh_toan || 0).toLocaleString('vi-VN') %> VNĐ</td>
                  <td class="text-center"><%= Number(row.con_lai || 0).toLocaleString('vi-VN') %> VNĐ</td>
                  <td class="text-center"><strong><%= Number(row.tong_no || 0).toLocaleString('vi-VN') %> VNĐ</strong></td>
                                    </tr>
                                  <% }) %>
