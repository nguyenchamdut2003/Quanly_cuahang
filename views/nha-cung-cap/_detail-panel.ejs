<div class="kv-detail-panel product-detail supplier-inline-detail">
  <div class="supplier-detail" data-supplier-detail>
                        <div class="detail-tabs">
                          <div class="detail-tab-list">
                            <button class="detail-tab is-active" type="button" data-detail-tab="info">Thông tin nhà cung cấp</button>
                            <button class="detail-tab" type="button" data-detail-tab="address">Danh sách địa chỉ</button>
                            <button class="detail-tab" type="button" data-detail-tab="history">Nhập/trả hàng hóa</button>
                            <button class="detail-tab" type="button" data-detail-tab="vat-chua">Nhập/trả vật chứa</button>
                            <button class="detail-tab" type="button" data-detail-tab="debt">Nợ cần trả nhà cung cấp</button>
            <button class="detail-tab" type="button" data-detail-tab="xnb">Xuất dùng nội bộ</button>
                          </div>
                        </div>

    <div class="supplier-detail-body">
                          <div class="detail-pane is-active" data-detail-pane="info">
        <div class="supplier-info-block">
          <div class="supplier-info-avatar">NCC</div>
          <div class="supplier-info-main">
                              <h2><%= selectedSupplier.ten_ncc || 'Nhà cung cấp' %></h2>
                              <p><%- refLink('supplier', selectedSupplier, selectedSupplier.ma_ncc || '---') %></p>
            <div class="supplier-info-tags">
              <span class="tag">Nhà cung cấp</span>
              <span class="tag tag-green"><%= selectedSupplier.trang_thai === 'active' ? 'Đang hoạt động' : 'Ngừng hoạt động' %></span>
            </div>
                            </div>
                          </div>
                          <form id="supplierInlineEdit_<%= selectedSupplier._id %>" method="post" action="/nha-cung-cap/<%= selectedSupplier._id %>/update" class="supplier-inline-edit-form">
          <div class="store-fields supplier-detail-fields">
                            <div><span>Mã NCC</span><input name="ma_ncc" value="<%= selectedSupplier.ma_ncc || '' %>"></div>
                            <div><span>Tên nhà cung cấp *</span><input name="ten_ncc" value="<%= selectedSupplier.ten_ncc || '' %>" required></div>
                            <div><span>Điện thoại</span><input name="sdt" value="<%= selectedSupplier.sdt || '' %>"></div>
                            <div><span>Email</span><input name="email" type="email" value="<%= selectedSupplier.email || '' %>"></div>
                            <div><span>Tên công ty</span><input name="ten_cong_ty" value="<%= selectedSupplier.ten_cong_ty || '' %>"></div>
                            <div><span>Mã số thuế</span><input name="ma_so_thue" value="<%= selectedSupplier.ma_so_thue || '' %>"></div>
                            <div><span>Tổng mua</span>
                              <div>
                                <strong class="supplier-metric-readonly"><%= Number(selectedSupplier.tong_mua || 0).toLocaleString('vi-VN') %></strong>
                                <div class="supplier-metric-hint">Tự động tính từ phiếu đã nhập hàng</div>
                              </div>
                            </div>
                            <div><span>Đã thanh toán</span>
                              <div>
                                <strong class="supplier-metric-readonly"><%= Number(selectedSupplier.da_thanh_toan || 0).toLocaleString('vi-VN') %></strong>
                                <div class="supplier-metric-hint">Tổng mua − Tổng nợ (hoặc từ sổ thanh toán)</div>
                              </div>
                            </div>
                            <div><span>Tổng nợ</span>
                              <div>
                                <strong class="supplier-metric-readonly"><%= Number(selectedSupplier.tong_no || 0).toLocaleString('vi-VN') %></strong>
                                <div class="supplier-metric-hint">Tự động tính từ sổ công nợ NCC</div>
                              </div>
                            </div>
                            <div><span>Trạng thái</span>
                              <select name="trang_thai">
                                <option value="active" <%= selectedSupplier.trang_thai !== 'inactive' ? 'selected' : '' %>>Đang hoạt động</option>
                                <option value="inactive" <%= selectedSupplier.trang_thai === 'inactive' ? 'selected' : '' %>>Ngừng hoạt động</option>
                              </select>
                            </div>
                            <div><span>Thời gian tạo</span><strong><%= formatDate(selectedSupplier.created_at) %></strong></div>
            <div class="supplier-detail-field-full"><span>Ghi chú</span><input name="ghi_chu" value="<%= selectedSupplier.ghi_chu || '' %>"></div>
                          </div>
                          </form>
    <div class="supplier-detail-footer">
      <a
        class="btn btn-primary btn-sm"
        href="/nha-cung-cap/<%= selectedSupplier._id %>/export/hoa-don-gop"
        target="_blank"
        rel="noopener"
      >Xuất chi tiết SP (hóa đơn gộp)</a>
      <a
        class="btn btn-light btn-sm"
        href="/nha-cung-cap/<%= selectedSupplier._id %>/export/hang-hoa"
        target="_blank"
        rel="noopener"
      >Xuất danh mục hàng</a>
      <a
        class="btn btn-light btn-sm"
        href="/nha-cung-cap/<%= selectedSupplier._id %>/export/info"
        target="_blank"
        rel="noopener"
      >Xuất thông tin</a>
      <button class="btn btn-danger btn-sm" type="submit" form="supplierInlineDel_<%= selectedSupplier._id %>" onclick="return confirm('Bạn có chắc muốn xóa nhà cung cấp này không?')">Xóa</button>
      <button class="btn btn-success btn-sm" type="submit" form="supplierInlineEdit_<%= selectedSupplier._id %>" onclick="return confirm('Bạn có muốn lưu thay đổi nhà cung cấp này không?')">Chỉnh sửa</button>
    </div>
                          </div>

                          <div class="detail-pane" data-detail-pane="address">
                            <% var supplierAddressReturnQuery = filterQueryString || ''; %>
        <div class="warehouse-section">
          <div class="warehouse-heading">
            <div class="detail-actions">
              <button class="btn btn-light js-open-address-type-modal" type="button">Loại địa chỉ</button>
            </div>
          </div>
                              <table class="admin-table warehouse-table supplier-address-table">
                                <thead>
                                  <tr>
                                    <th>Mã địa chỉ</th>
                                    <th>Tên người nhận</th>
                                    <th>SĐT</th>
                                    <th>Địa chỉ</th>
                                    <th>Phường/xã</th>
                                    <th>Tỉnh/thành</th>
                                    <th>Loại địa chỉ</th>
                                    <th>Mặc định</th>
                                    <th>Tạo lúc</th>
                                  </tr>
                                </thead>
                                <tbody>
                                  <% var supplierAddressAddFormId = 'supplierAddressAdd_' + String(selectedSupplier._id); %>
                                  <tr class="warehouse-edit-row warehouse-add-row">
                                    <td>
                                      <input data-address-form="<%= supplierAddressAddFormId %>" name="returnQuery" type="hidden" value="<%= supplierAddressReturnQuery %>">
                  <input data-address-form="<%= supplierAddressAddFormId %>" name="ma_dia_chi" placeholder="Tự động" readonly class="supplier-readonly-input">
                                    </td>
                                    <td><input data-address-form="<%= supplierAddressAddFormId %>" name="ten_nguoi_nhan" placeholder="Tên người nhận"></td>
                                    <td><input data-address-form="<%= supplierAddressAddFormId %>" name="sdt_nguoi_nhan" placeholder="SĐT"></td>
                                    <td><input data-address-form="<%= supplierAddressAddFormId %>" name="dia_chi_chi_tiet" placeholder="Địa chỉ chi tiết"></td>
                                    <td><input data-address-form="<%= supplierAddressAddFormId %>" name="phuong_xa" placeholder="Phường/xã"></td>
                                    <td><input data-address-form="<%= supplierAddressAddFormId %>" name="tinh_thanh" placeholder="Tỉnh/thành"></td>
                                    <td>
                                      <select class="js-address-type-select" data-address-form="<%= supplierAddressAddFormId %>" name="loai_dia_chi">
                                        <option value="khac">Khác</option>
                                        <% (addressTypes || []).filter(function(type) { return type.ma_loai !== 'khac'; }).forEach(function(type) { %>
                                          <option value="<%= type.ma_loai %>"><%= type.ten_loai %></option>
                                        <% }) %>
                                      </select>
                                    </td>
                                    <td>
                                      <select data-address-form="<%= supplierAddressAddFormId %>" name="mac_dinh">
                                        <option value="">Không</option>
                                        <option value="true">Có</option>
                                      </select>
                                    </td>
                                    <td class="warehouse-action-cell">
                                      <div class="warehouse-action-meta">--</div>
                                      <button
                                        class="btn btn-primary btn-sm js-supplier-address-submit"
                                        type="button"
                                        data-form-id="<%= supplierAddressAddFormId %>"
                                        data-action="/nha-cung-cap/<%= selectedSupplier._id %>/dia-chi"
                                        data-confirm="Bạn có muốn thêm địa chỉ mới không?"
                                      >✨ Thêm</button>
                                    </td>
                                  </tr>
                                  <% if (!supplierAddresses || supplierAddresses.length === 0) { %>
                                    <tr><td colspan="9" class="empty-cell">Nhà cung cấp này chưa có địa chỉ.</td></tr>
                                  <% } %>
                                  <% (supplierAddresses || []).forEach(function(address) { %>
                                    <% var supplierAddressFormId = 'supplierAddressForm_' + String(address._id); %>
                                    <tr class="warehouse-edit-row">
                                      <td>
                                        <input data-address-form="<%= supplierAddressFormId %>" name="returnQuery" type="hidden" value="<%= supplierAddressReturnQuery %>">
                    <input data-address-form="<%= supplierAddressFormId %>" name="ma_dia_chi" value="<%= address.ma_dia_chi || '' %>" readonly class="supplier-readonly-input">
                                      </td>
                                      <td><input data-address-form="<%= supplierAddressFormId %>" name="ten_nguoi_nhan" value="<%= address.ten_nguoi_nhan || '' %>"></td>
                                      <td><input data-address-form="<%= supplierAddressFormId %>" name="sdt_nguoi_nhan" value="<%= address.sdt_nguoi_nhan || '' %>"></td>
                                      <td><input data-address-form="<%= supplierAddressFormId %>" name="dia_chi_chi_tiet" value="<%= address.dia_chi_chi_tiet || address.so_nha || address.dia_chi_day_du || '' %>"></td>
                                      <td><input data-address-form="<%= supplierAddressFormId %>" name="phuong_xa" value="<%= address.phuong_xa || '' %>"></td>
                                      <td><input data-address-form="<%= supplierAddressFormId %>" name="tinh_thanh" value="<%= address.tinh_thanh || '' %>"></td>
                                      <td>
                                        <select class="js-address-type-select" data-address-form="<%= supplierAddressFormId %>" name="loai_dia_chi">
                                          <option value="khac" <%= address.loai_dia_chi === 'khac' ? 'selected' : '' %>>Khác</option>
                                          <% (addressTypes || []).filter(function(type) { return type.ma_loai !== 'khac'; }).forEach(function(type) { %>
                                            <option value="<%= type.ma_loai %>" <%= address.loai_dia_chi === type.ma_loai ? 'selected' : '' %>><%= type.ten_loai %></option>
                                          <% }) %>
                                        </select>
                                      </td>
                                      <td>
                                        <select data-address-form="<%= supplierAddressFormId %>" name="mac_dinh">
                                          <option value="" <%= address.mac_dinh ? '' : 'selected' %>>Không</option>
                                          <option value="true" <%= address.mac_dinh ? 'selected' : '' %>>Có</option>
                                        </select>
                                      </td>
                                      <td class="warehouse-action-cell">
                                        <div class="warehouse-action-meta"><%= formatDate(address.created_at) %></div>
                                        <div class="warehouse-action-buttons">
                                          <button
                                            class="btn btn-light btn-sm js-supplier-address-submit"
                                            type="button"
                                            data-form-id="<%= supplierAddressFormId %>"
                                            data-action="/nha-cung-cap/dia-chi/<%= address._id %>/update"
                                            data-confirm="Bạn có muốn lưu chỉnh sửa địa chỉ này không?"
                                          >Lưu</button>
                                          <button
                                            class="btn btn-danger btn-sm js-supplier-address-delete"
                                            type="button"
                                            data-return-query="<%= supplierAddressReturnQuery %>"
                                            data-action="/nha-cung-cap/dia-chi/<%= address._id %>/delete"
                                          >Xóa</button>
                                        </div>
                                      </td>
                                    </tr>
                                  <% }) %>
                                </tbody>
                              </table>
                            </div>
                          </div>

                          <div class="detail-pane" data-detail-pane="history">
        <div class="supplier-pane-table-wrap table-wrap">
          <%
            var supplierPurchaseHistoryTotal = (supplierPurchaseHistory || []).reduce(function(sum, row) {
              var sign = row.loai === 'tra' ? -1 : 1;
              return sum + sign * Number(row.tong_cong || 0);
            }, 0);
          %>
          <table class="admin-table warehouse-table">
            <thead>
              <tr>
                <th class="text-center">Mã phiếu</th>
                                    <th class="text-center">Thời gian</th>
                                    <th class="text-center">Người tạo</th>
                                    <th class="text-center">
                                      Tổng cộng
                                      <% if ((supplierPurchaseHistory || []).length > 0) { %>
                                        <div class="supplier-column-total <%= supplierPurchaseHistoryTotal < 0 ? 'is-return' : '' %>"><%= supplierPurchaseHistoryTotal.toLocaleString('vi-VN') %> VNĐ</div>
                                      <% } %>
                                    </th>
                <th class="text-center">Trạng thái</th>
                                  </tr>
                                </thead>
                                <tbody>
                                  <% if ((supplierPurchaseHistory || []).length === 0) { %>
                <tr><td colspan="5" class="empty-cell">Chưa có lịch sử nhập/trả hàng hóa.</td></tr>
                                  <% } %>
                                  <% (supplierPurchaseHistory || []).forEach(function(row) { %>
                                    <%
                                      var isReturnHistory = row.loai === 'tra';
                                      var historyHref = '#';
                                      if (row.loai === 'nhap' && row.phieu_nhap_id) historyHref = refUrl('purchase', row.phieu_nhap_id);
                                      else if (row.loai === 'tra' && row.phieu_tra_hang_nhap_id) historyHref = '/tra-hang-nhap/' + row.phieu_tra_hang_nhap_id;
                                      var historyTypeLabel = typeof mapSupplierPurchaseHistoryType === 'function' ? mapSupplierPurchaseHistoryType(row.loai) : (isReturnHistory ? 'Trả hàng hóa' : 'Nhập hàng hóa');
                                    %>
                                    <tr>
                                      <td class="text-center">
                                        <a href="<%= historyHref %>" class="table-code-link ref-link">
                                          <% if (!isReturnHistory) { %>
                                            <i class="fa-solid fa-file-import history-type-icon" title="Nhập hàng"></i>
                                          <% } else { %>
                        <i class="fa-solid fa-arrow-rotate-left history-type-icon history-type-icon--return" title="Trả hàng"></i>
                                          <% } %>
                                          <%= row.ma_phieu || '--' %>
                                        </a>
                                      </td>
                  <td class="supplier-muted-cell text-center"><%= formatDate(row.thoi_gian) %></td>
                  <td class="text-center">
                    <div class="history-creator">
                      <span class="history-creator-avatar"><%= (row.nguoi_tao || 'U').charAt(0).toUpperCase() %></span>
                                          <%= row.nguoi_tao || '--' %>
                                        </div>
                                      </td>
                                      <td class="text-center">
                                        <span class="history-amount <%= isReturnHistory ? 'is-return' : '' %>">
                                          <%= isReturnHistory ? '-' : '' %><%= Number(row.tong_cong || 0).toLocaleString('vi-VN') %> VNĐ
                                        </span>
                                      </td>
                                      <td class="text-center">
                                        <% 
                      var statusClass = 'status-pill';
                      var statusLabelText = historyTypeLabel;
                                          if (row.trang_thai === 'completed') statusClass += ' is-active';
                                          else if (row.trang_thai === 'active') statusClass += ' is-active';
                                          else if (row.trang_thai === 'draft') statusClass += ' is-draft';
                                          else if (row.trang_thai === 'cancelled') statusClass += ' is-cancelled';
                                        %>
                                        <span class="<%= statusClass %>"><%= statusLabelText %></span>
                                      </td>
                                    </tr>
                                  <% }) %>
                                </tbody>
                              </table>
                            </div>
                          </div>

                          <div class="detail-pane" data-detail-pane="vat-chua">
        <div class="supplier-pane-table-wrap table-wrap">
          <%
            var supplierVatChuaTotalQty = (supplierVatChuaHistory || []).reduce(function(sum, row) {
              var sign = row.loai === 'tra_vat_chua' ? -1 : 1;
              return sum + sign * Number(row.so_luong || 0);
            }, 0);
            var supplierVatChuaTotalMoney = (supplierVatChuaHistory || []).reduce(function(sum, row) {
              var sign = row.loai === 'tra_vat_chua' ? -1 : 1;
              return sum + sign * Number(row.tong_cong || 0);
            }, 0);
          %>
          <table class="admin-table warehouse-table">
            <thead>
              <tr>
                <th class="text-center">Mã phiếu</th>
                <th class="text-center">Thời gian</th>
                <th class="text-center">Người tạo</th>
                <th class="text-center">
                  Số lượng
                  <% if ((supplierVatChuaHistory || []).length > 0) { %>
                    <div class="supplier-column-total <%= supplierVatChuaTotalQty < 0 ? 'is-return' : '' %>"><%= supplierVatChuaTotalQty.toLocaleString('vi-VN') %></div>
                  <% } %>
                </th>
                <th class="text-center">
                  Tổng tiền
                  <% if ((supplierVatChuaHistory || []).length > 0) { %>
                    <div class="supplier-column-total <%= supplierVatChuaTotalMoney < 0 ? 'is-return' : '' %>"><%= supplierVatChuaTotalMoney.toLocaleString('vi-VN') %> VNĐ</div>
                  <% } %>
                </th>
                <th class="text-center">Trạng thái</th>
              </tr>
            </thead>
            <tbody>
              <% if ((supplierVatChuaHistory || []).length === 0) { %>
                <tr><td colspan="6" class="empty-cell">Chưa có lịch sử nhập/trả vật chứa.</td></tr>
              <% } %>
              <% (supplierVatChuaHistory || []).forEach(function(row) { %>
                <%
                  var isReturnVatChua = row.loai === 'tra_vat_chua';
                  var vatChuaHref = '#';
                  if (row.loai === 'nhap_vat_chua' && row.nhap_vat_chua_id) vatChuaHref = '/vat-chua?nhap_vat_chua=' + encodeURIComponent(String(row.nhap_vat_chua_id));
                  else if (row.loai === 'tra_vat_chua') vatChuaHref = '/vat-chua';
                  var vatChuaTypeLabel = typeof mapSupplierPurchaseHistoryType === 'function' ? mapSupplierPurchaseHistoryType(row.loai) : (isReturnVatChua ? 'Trả vật chứa' : 'Nhập vật chứa');
                  var vatChuaStatusClass = 'status-pill';
                  if (row.trang_thai === 'completed') vatChuaStatusClass += ' is-active';
                  else if (row.trang_thai === 'active') vatChuaStatusClass += ' is-active';
                  else if (row.trang_thai === 'draft') vatChuaStatusClass += ' is-draft';
                  else if (row.trang_thai === 'cancelled') vatChuaStatusClass += ' is-cancelled';
                %>
                <tr>
                  <td class="text-center">
                    <a href="<%= vatChuaHref %>" class="table-code-link ref-link">
                      <% if (!isReturnVatChua) { %>
                        <i class="fa-solid fa-file-import history-type-icon" title="Nhập vật chứa"></i>
                      <% } else { %>
                        <i class="fa-solid fa-arrow-rotate-left history-type-icon history-type-icon--return" title="Trả vật chứa"></i>
                      <% } %>
                      <%= row.ma_phieu || '--' %>
                    </a>
                  </td>
                  <td class="supplier-muted-cell text-center"><%= formatDate(row.thoi_gian) %></td>
                  <td class="text-center">
                    <div class="history-creator">
                      <span class="history-creator-avatar"><%= (row.nguoi_tao || 'U').charAt(0).toUpperCase() %></span>
                      <%= row.nguoi_tao || '--' %>
                    </div>
                  </td>
                  <td class="text-center">
                    <span class="history-amount <%= isReturnVatChua ? 'is-return' : '' %>">
                      <%= isReturnVatChua ? '-' : '' %><%= Number(row.so_luong || 0).toLocaleString('vi-VN') %>
                    </span>
                  </td>
                  <td class="text-center">
                    <span class="history-amount <%= isReturnVatChua ? 'is-return' : '' %>">
                      <%= isReturnVatChua ? '-' : '' %><%= Number(row.tong_cong || 0).toLocaleString('vi-VN') %> VNĐ
                    </span>
                  </td>
                  <td class="text-center"><span class="<%= vatChuaStatusClass %>"><%= vatChuaTypeLabel %></span></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
                          </div>

                          <div class="detail-pane" data-detail-pane="debt">
        <div class="supplier-pane-toolbar supplier-debt-toolbar">
          <div class="supplier-debt-summary">
            <span class="supplier-debt-summary-label">Nợ hiện tại</span>
            <strong class="supplier-debt-summary-value"><%= Number(selectedSupplier.tong_no || 0).toLocaleString('vi-VN') %> VNĐ</strong>
          </div>
          <div class="supplier-debt-actions">
            <label class="supplier-debt-sort-check" title="Ưu tiên phiếu còn nợ, nợ lâu nhất lên đầu">
              <input type="checkbox" class="js-supplier-debt-sort-oldest" disabled>
              <span>Nợ lâu nhất trước</span>
            </label>
            <button
              class="btn btn-light btn-sm js-open-supplier-pay-modal"
              type="button"
              data-modal-id="supplierPayModal_<%= selectedSupplier._id %>"
            >Thanh toán</button>
            <button
              class="btn btn-light btn-sm js-open-supplier-discount-modal"
              type="button"
              data-modal-id="supplierDiscountModal_<%= selectedSupplier._id %>"
            >Chiết khấu thanh toán</button>
            <button
              type="button"
              class="btn btn-primary btn-sm js-debt-export-trigger"
              data-export-kind="both"
              data-export-base="/nha-cung-cap/<%= selectedSupplier._id %>/export/debt"
              data-extra-qs="<%= filterQueryString || '' %>"
            >Xuất công nợ</button>
            <button
              type="button"
              class="btn btn-light btn-sm js-debt-export-trigger"
              data-export-kind="quan-tri"
              data-export-base="/nha-cung-cap/<%= selectedSupplier._id %>/export/debt"
              data-extra-qs="<%= filterQueryString || '' %>"
            >Quản trị</button>
            <button
              type="button"
              class="btn btn-light btn-sm js-debt-export-trigger"
              data-export-kind="doi-tac"
              data-export-base="/nha-cung-cap/<%= selectedSupplier._id %>/export/debt"
              data-extra-qs="<%= filterQueryString || '' %>"
            >Gửi đối tác</button>
          </div>
        </div>
        <div class="supplier-pane-table-wrap table-wrap">
          <table class="admin-table warehouse-table" id="supplierDebtHistoryTable_<%= selectedSupplier._id %>" data-warn-days="<%= Number(debtWarnMinDays || debtWarnDefaultDays || 10) %>">
                                <thead>
                                  <tr>
                                    <th class="text-center">Mã phiếu</th>
                                    <th class="text-center">Thời gian</th>
                                    <th class="text-center">Loại chứng từ</th>
                <th class="text-center">Giá trị</th>
                <th class="text-center">Đã thanh toán</th>
                <th class="text-center">Còn lại</th>
                <th class="text-center">Tổng nợ</th>
                                  </tr>
                                </thead>
                                <tbody>
                                  <% if ((supplierDebtHistory || []).length === 0) { %>
                                    <tr><td colspan="7" class="empty-cell">Chưa có lịch sử công nợ.</td></tr>
                                  <% } %>
                                  <% (supplierDebtHistory || []).forEach(function(row) { %>
                                    <tr
                                      class="js-supplier-debt-row<%= row.is_debt_overdue ? ' supplier-debt-row-overdue' : '' %><%= !row.co_no_con_lai ? ' supplier-debt-row-paid' : '' %>"
                                      data-has-debt="<%= row.co_no_con_lai ? '1' : '0' %>"
                                      data-debt-days="<%= row.so_ngay_no != null ? row.so_ngay_no : '' %>"
