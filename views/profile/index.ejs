<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Thông tin cá nhân</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/stylesheets/style.css">
  <link rel="stylesheet" href="/stylesheets/personal-info.css">
</head>
<body>
  <%- include('../partials/header') %>
  <%
    var profileUser = user || {};
    var editable = locals.canEdit === true;
    var profileRole = ({super_admin:'Quản trị cao nhất',admin:'Quản lý',quan_ly:'Quản lý',nhan_vien:'Nhân viên',user:'Khách'})[profileUser.vai_tro] || profileUser.vai_tro || '---';
    var profileStatus = ({active:'Đang hoạt động',inactive:'Ngừng hoạt động',blocked:'Đã khóa'})[profileUser.trang_thai] || profileUser.trang_thai || '---';
  %>
  <main class="personal-profile-page">
    <section class="personal-profile-panel">
      <h1>Thông tin cá nhân</h1>
      <p class="personal-info-role"><%= profileRole %> · <%= profileStatus %></p>
      <% if (locals.profileError) { %><p class="personal-info-status is-error" role="alert"><%= locals.profileError %></p><% } %>
      <% if (locals.profileSuccess) { %><p class="personal-info-status is-success" role="status"><%= locals.profileSuccess %></p><% } %>
      <% if (editable) { %>
        <form action="/profile/update" method="post" class="personal-info-form">
          <div class="personal-info-grid">
            <label class="personal-info-field"><span>Tài khoản đăng nhập *</span><input type="text" name="email" value="<%= profileUser.email || '' %>" autocomplete="username" maxlength="254" required></label>
            <label class="personal-info-field"><span>Họ và tên *</span><input type="text" name="ho_ten" value="<%= profileUser.ho_ten || '' %>" autocomplete="name" maxlength="150" required></label>
            <label class="personal-info-field"><span>Số điện thoại</span><input type="tel" name="sdt" value="<%= profileUser.sdt || '' %>" autocomplete="tel" maxlength="30"></label>
            <label class="personal-info-field is-wide"><span>Địa chỉ chi tiết</span><input type="text" name="dia_chi_chi_tiet" value="<%= profileUser.dia_chi_chi_tiet || '' %>" autocomplete="street-address" maxlength="500"></label>
            <label class="personal-info-field"><span>Phường/Xã</span><input type="text" name="phuong_xa" value="<%= profileUser.phuong_xa || '' %>" maxlength="150"></label>
            <label class="personal-info-field"><span>Tỉnh/Thành phố</span><input type="text" name="tinh_thanh" value="<%= profileUser.tinh_thanh || '' %>" autocomplete="address-level1" maxlength="150"></label>
            <label class="personal-info-field is-wide"><span>Mật khẩu hiện tại</span><input type="password" name="current_password" autocomplete="current-password"><small>Chỉ cần nhập khi thay đổi tài khoản đăng nhập.</small></label>
          </div>
          <div class="personal-info-actions"><button type="submit" class="personal-info-button is-primary">Lưu thông tin</button></div>
        </form>
      <% } else { %>
        <p class="personal-info-note">Chỉ quản trị cao nhất được chỉnh sửa thông tin tài khoản.</p>
        <dl class="personal-info-readonly">
          <dt>Tài khoản đăng nhập</dt><dd><%= profileUser.email || '---' %></dd>
          <dt>Họ và tên</dt><dd><%= profileUser.ho_ten || '---' %></dd>
          <dt>Số điện thoại</dt><dd><%= profileUser.sdt || '---' %></dd>
          <dt>Địa chỉ chi tiết</dt><dd><%= profileUser.dia_chi_chi_tiet || '---' %></dd>
          <dt>Phường/Xã</dt><dd><%= profileUser.phuong_xa || '---' %></dd>
          <dt>Tỉnh/Thành phố</dt><dd><%= profileUser.tinh_thanh || '---' %></dd>
          <dt>Vai trò</dt><dd><%= profileRole %></dd>
        </dl>
      <% } %>
    </section>
    <section class="personal-profile-panel">
      <h2>Đổi mật khẩu</h2>
      <p class="personal-info-status" id="profilePasswordMessage" role="status" hidden></p>
      <form action="/profile/change-password" method="post" class="personal-info-form">
        <label class="personal-info-field"><span>Mật khẩu hiện tại *</span><input type="password" name="current_password" autocomplete="current-password" required></label>
        <label class="personal-info-field"><span>Mật khẩu mới *</span><input type="password" name="password" autocomplete="new-password" minlength="8" pattern="(?=.*[A-Za-z])(?=.*\d).{8,}" required></label>
        <label class="personal-info-field"><span>Xác nhận mật khẩu mới *</span><input type="password" name="confirm_password" autocomplete="new-password" minlength="8" pattern="(?=.*[A-Za-z])(?=.*\d).{8,}" required></label>
        <div class="personal-info-actions"><button type="submit" class="personal-info-button is-primary">Lưu mật khẩu</button></div>
      </form>
    </section>
  </main>
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      var params = new URLSearchParams(window.location.search), passwordMessage = document.getElementById('profilePasswordMessage');
      if (params.get('success') === '1' && !document.querySelector('.personal-profile-panel .is-success')) {
        var note = document.createElement('p'); note.className = 'personal-info-status is-success'; note.setAttribute('role', 'status'); note.textContent = 'Đã cập nhật thông tin cá nhân.'; document.querySelector('.personal-profile-panel').prepend(note);
      }
      if (params.get('password_success') === '1' || params.get('password_error')) {
        var code = params.get('password_error'); passwordMessage.hidden = false;
        passwordMessage.className = 'personal-info-status ' + (code ? 'is-error' : 'is-success');
        passwordMessage.textContent = code ? (code === 'current' ? 'Mật khẩu hiện tại không đúng.' : code === 'weak' ? 'Mật khẩu mới phải có ít nhất 8 ký tự, gồm chữ và số.' : 'Xác nhận mật khẩu mới không khớp.') : 'Đổi mật khẩu thành công!';
      }
      if (params.has('success') || params.has('password_success') || params.has('password_error')) window.history.replaceState(null, '', window.location.pathname);
    });
  </script>
</body>
</html>
