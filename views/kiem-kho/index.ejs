<!DOCTYPE html>
<html>
  <head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Phiếu kiểm kho</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/stylesheets/style.css">
  <link rel="stylesheet" href="/stylesheets/responsive.css">
    <style>
      body{background:#f8fafc;overflow-x:hidden}
      .kk-page{height:calc(100vh - 58px);display:grid;grid-template-columns:240px minmax(0,1fr);gap:0;padding:0;background:#f8fafc}
      .kk-sidebar{background:#f8fafc;padding:16px 12px;overflow:auto;border-right:1px solid #e2e8f0}
      .kk-main{min-width:0;display:flex;flex-direction:column;padding:10px 12px;background:#f8fafc}
      .kk-top{min-height:36px;display:grid;grid-template-columns:220px minmax(280px,400px) minmax(0,1fr) auto;align-items:center;gap:12px;margin-bottom:8px}
      .kk-title{font-size:22px;font-weight:800;color:#1e293b;line-height:1.2;white-space:nowrap}
      .kk-search{height:36px;border:1px solid #cbd5e1;border-radius:8px;background:#fff;display:flex;align-items:center;padding:0 14px;gap:10px;transition:all .2s}
      .kk-search:focus-within{border-color:#3b82f6;box-shadow:0 0 0 3px rgba(59,130,246,.1)}
      .kk-search input{border:0;outline:0;flex:1;min-width:0;font-size:14px}
      .kk-search button{border:0;background:transparent;color:#344054;cursor:pointer}
      .kk-actions{display:flex;align-items:center;justify-content:flex-end;gap:8px;min-width:0}
      .kk-btn{height:36px;border:1px solid #c7d0dc;background:#fff;border-radius:8px;color:#1f2937;padding:0 13px;font-weight:700;text-decoration:none;display:inline-flex;align-items:center;gap:8px;cursor:pointer;white-space:nowrap}
      .kk-btn.primary{border-color:#006dff;color:#006dff}
      .kk-btn.danger{border-color:#fecdca;color:#b42318}
      .kk-btn:disabled{opacity:.55;cursor:not-allowed}
      .kk-actions .kk-delete-btn{display:inline-flex!important;background:#d92d20!important;color:#fff!important;border-color:#d92d20!important;visibility:visible!important;opacity:1!important}
      .kk-actions .kk-delete-btn:hover:not(:disabled){background:#b42318!important;border-color:#b42318!important}
      .kk-actions .kk-delete-btn:disabled{opacity:.55!important}
      .filter-title{font-size:13px;font-weight:700;margin:0 0 8px;color:#475569}
      .filter-block{display:grid;gap:8px;margin-bottom:16px;padding-bottom:16px;border-bottom:1px solid #f1f5f9}
      .filter-block:last-child{border-bottom:0}
      .radio-row,.check-row{display:flex;align-items:center;gap:8px;margin:0;font-size:13px;font-weight:500;color:#334155}
      .radio-row input,.check-row input{width:14px;height:14px;accent-color:#3b82f6;margin:0;flex:0 0 auto}
      .check-row{min-height:28px}
      .filter-line{height:36px;border:1px solid #cbd5e1;border-radius:6px;background:#fff;display:flex;align-items:center;justify-content:space-between;padding:0 12px;color:#1e293b;min-width:0}
      .filter-line:focus-within{border-color:#3b82f6;box-shadow:0 0 0 3px rgba(59,130,246,.1)}
      .filter-line input,.filter-line select{border:0;outline:0;width:100%;height:34px;background:transparent;color:#667085}
      .date-range{display:none;margin:8px 0 0 23px;gap:6px}
      .date-range.show{display:grid}
      .kk-table-wrap{background:#fff;flex:1;overflow-x:hidden!important;overflow-y:auto;border:1px solid #dbe4ef;border-radius:10px 10px 0 0;box-shadow:0 2px 8px rgba(15,23,42,.05);max-width:100%}
      .kk-table{width:100%;table-layout:fixed;border-collapse:collapse;font-size:13px}
      .kk-table th{height:38px;background:#f1f6fb;border-bottom:1px solid #dbe4ef;text-align:left;color:#334155;font-size:12px;font-weight:800;padding:0 10px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
      .kk-table td{height:42px;border-bottom:1px solid #edf2f7;padding:0 10px;vertical-align:middle;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
      .kk-table tbody tr:hover td{background:#f9fbfe}
      .kk-table .num{text-align:right}
      .kk-table th:nth-child(1),.kk-table td:nth-child(1){width:34px}
      .kk-table th:nth-child(2),.kk-table td:nth-child(2){width:14%}
      .kk-table th:nth-child(3),.kk-table td:nth-child(3){width:12%}
      .kk-table th:nth-child(4),.kk-table td:nth-child(4){width:12%}
      .kk-table th:nth-child(5),.kk-table td:nth-child(5){width:9%}
      .kk-table th:nth-child(6),.kk-table td:nth-child(6){width:11%}
      .kk-table th:nth-child(7),.kk-table td:nth-child(7){width:12%}
      .kk-table th:nth-child(8),.kk-table td:nth-child(8){width:10%}
      .kk-table th:nth-child(9),.kk-table td:nth-child(9){width:10%}
      .kk-table th:nth-child(10),.kk-table td:nth-child(10){width:auto}
      .select-col{text-align:center}
      .row-check{width:14px;height:14px;accent-color:#0070f4}
      .ticket-row{cursor:pointer}
      .ticket-row.active td{background:#f4f9ff;border-top:1px solid #bfdbfe;border-bottom:1px solid #bfdbfe}
      .note-cell{line-height:20px}
      .detail-row{display:none}
      .detail-row.open{display:table-row}
      .detail-cell{padding:0!important;border:0!important;background:#fff;overflow:visible!important;white-space:normal!important}
      .detail-panel{margin:0;background:#fff;padding:0;max-width:100%;overflow:visible}
      .detail-tab{display:inline-flex;height:42px;align-items:center;border-bottom:2px solid #1677ff;color:#1677ff;font-size:13px;font-weight:700;margin:0 18px}
      .detail-title{display:flex;align-items:center;gap:10px;font-size:18px;font-weight:800;margin:16px 18px 14px;min-width:0;color:#1e293b}
      .detail-title span:first-child{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
      .status-pill{font-size:13px;color:#047857;background:#dcfce7;border-radius:4px;padding:3px 7px;font-weight:700}
      .detail-info-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px 24px;margin:0 18px 18px}
      .detail-info-item{min-width:0;border-bottom:1px solid #e2e8f0;padding-bottom:8px}
      .detail-info-item span{display:block;color:#475569;font-size:13px;margin-bottom:6px}
      .detail-info-item strong{display:block;color:#0f172a;font-size:14px;font-weight:400;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
      .detail-info-item.is-note{grid-column:span 2}
      .detail-meta,.detail-bottom{display:none}
      .detail-table{width:calc(100% - 36px);max-width:calc(100% - 36px);table-layout:fixed;border-collapse:collapse;margin:22px 18px 0;font-size:13px}
      .detail-table th{height:34px;background:#f1f6fb;border-bottom:1px solid #dbe4ef;text-align:left;padding:0 10px;color:#334155;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
      .detail-table td{height:39px;border-bottom:0;padding:0 10px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
      .detail-table .num{text-align:right}
      .detail-table th:nth-child(1),.detail-table td:nth-child(1){width:16%!important}
      .detail-table th:nth-child(2),.detail-table td:nth-child(2){width:18%!important}
      .detail-table th:nth-child(3),.detail-table td:nth-child(3){width:12%!important}
      .detail-table th:nth-child(4),.detail-table td:nth-child(4){width:10%!important}
      .detail-table th:nth-child(5),.detail-table td:nth-child(5){width:11%!important}
      .detail-table th:nth-child(6),.detail-table td:nth-child(6){width:10%!important}
      .detail-table th:nth-child(7),.detail-table td:nth-child(7){width:9%!important}
      .detail-table th:nth-child(8),.detail-table td:nth-child(8){width:14%!important}
      .product-code{color:#006dff;text-decoration:none}
      .detail-link-btn{min-height:32px;border:1px solid #cbd5e1;background:#fff;border-radius:7px;color:#111827;font-weight:700;display:inline-flex;gap:7px;align-items:center;cursor:pointer;text-decoration:none!important;white-space:nowrap;padding:0 12px}
      .detail-link-btn:hover{text-decoration:none!important}
      .small-outline{min-height:32px;border:1px solid #cbd5e1;background:#fff;border-radius:7px;padding:0 12px;display:inline-flex;align-items:center;gap:7px;font-weight:700;text-decoration:none!important;white-space:nowrap}
      .small-outline:hover{text-decoration:none!important}
      .detail-actions{gap:10px;flex-wrap:wrap;margin:16px 18px 0;align-items:center;justify-content:flex-end!important;overflow:visible;max-width:calc(100% - 36px);box-sizing:border-box}
      .detail-action-left,.detail-action-right{display:flex;align-items:center;justify-content:flex-end;gap:10px;flex-wrap:wrap;min-width:0;margin:0!important}
      .detail-action-right{flex:0 1 auto}
      .detail-action-left{flex:0 1 auto}
      .kk-footer{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:12px 14px;border:1px solid #dbe4ef;border-top:0;border-radius:0 0 10px 10px;background:#fff;color:#475467;font-size:14px;flex-wrap:wrap}
      .kk-page-size{font-weight:600;color:#475569}
      .kk-pagination{display:flex;align-items:center;gap:6px;flex-wrap:wrap}
      .kk-page-link{min-width:34px;height:34px;padding:0 10px;border:1px solid #d0d5dd;border-radius:6px;background:#fff;color:#344054;text-decoration:none;display:inline-flex;align-items:center;justify-content:center;font-weight:700}
      .kk-page-link.is-disabled{color:#94a3b8;background:#f8fafc;cursor:not-allowed}
      .kk-page-current{display:inline-flex;align-items:center;gap:6px;font-weight:700;color:#1f2937}
      .page-size{height:24px;border:1px solid #cbd5e1;border-radius:7px;background:#fff;padding:0 25px 0 8px}
      .empty-row{height:140px!important;text-align:center;color:#667085}
      @media (max-width:1200px){
        .kk-page{grid-template-columns:240px minmax(0,1fr)}
        .kk-top{grid-template-columns:1fr;align-items:stretch}
        .kk-actions{justify-content:flex-start;flex-wrap:wrap}
        .detail-info-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
        .detail-info-item.is-note{grid-column:span 2}
      }
      .kk-export-overlay{display:none;position:fixed;inset:0;background:rgba(15,23,42,.45);z-index:1200;align-items:center;justify-content:center;padding:20px}
      .kk-export-modal{background:#fff;border-radius:10px;width:min(720px,calc(100vw - 32px));max-height:calc(100vh - 40px);display:flex;flex-direction:column;box-shadow:0 18px 44px rgba(15,23,42,.28)}
      .kk-export-head{display:flex;align-items:flex-start;justify-content:space-between;padding:20px 24px 12px;border-bottom:1px solid #e5e9ee}
      .kk-export-head h3{margin:0;font-size:18px;font-weight:800;color:#111827}
      .kk-export-head p{margin:6px 0 0;font-size:13px;color:#667085}
      .kk-export-close{border:0;background:none;font-size:24px;line-height:1;cursor:pointer;color:#667085}
      .kk-export-body{padding:16px 24px;overflow:auto;flex:1}
      .kk-export-group{margin-bottom:18px}
      .kk-export-group-title{display:flex;align-items:center;justify-content:space-between;font-size:14px;font-weight:800;color:#111827;margin-bottom:10px}
      .kk-export-group-count{font-size:12px;font-weight:700;color:#667085}
      .kk-export-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px 24px}
      .kk-export-grid label{display:flex;align-items:center;gap:8px;font-size:13px;color:#344054;cursor:pointer}
      .kk-export-foot{display:flex;align-items:center;justify-content:space-between;padding:14px 24px 20px;border-top:1px solid #e5e9ee}
      .kk-export-error{color:#d92d20;font-size:13px;margin:0 0 10px;display:none}
      .kk-trash-overlay{display:none;position:fixed;inset:0;background:rgba(15,23,42,.45);z-index:1450;align-items:center;justify-content:center;padding:16px}
      .kk-trash-overlay.is-open{display:flex}
      .kk-trash-modal{width:min(420px,calc(100vw - 24px));max-height:calc(100vh - 32px);background:#fff;border-radius:12px;box-shadow:0 20px 60px rgba(15,23,42,.28);display:flex;flex-direction:column;overflow:hidden}
      .kk-trash-head{display:flex;align-items:center;justify-content:space-between;padding:18px 22px 12px;border-bottom:1px solid #e5e9ee}
      .kk-trash-head h3{margin:0;font-size:18px;font-weight:800;color:#111827}
      .kk-trash-close{border:0;background:transparent;color:#667085;font-size:26px;line-height:1;cursor:pointer}
      .kk-trash-body{padding:14px 22px 18px;overflow:auto}
      .kk-trash-desc{margin:0 0 12px;font-size:13px;line-height:1.5;color:#475467}
      .kk-trash-alert{border-radius:8px;padding:10px 12px;font-size:13px;line-height:1.45;margin-bottom:12px}
      .kk-trash-alert.is-error{border:1px solid #fecdca;background:#fffbfa;color:#b42318}
      .kk-trash-alert.is-warn{border:1px solid #fedf89;background:#fffaeb;color:#93370d}
      .kk-trash-selected{margin:0 0 12px;padding:0;list-style:none}
      .kk-trash-selected li{font-size:13px;color:#111827;padding:4px 0;border-bottom:1px dashed #eef2f6}
      .kk-trash-table{width:100%;border-collapse:collapse;font-size:13px}
      .kk-trash-table th{background:#f8fafc;border-bottom:1px solid #e4eaf2;padding:8px 10px;text-align:left;font-size:12px;color:#475467}
      .kk-trash-table td{border-bottom:1px solid #eef2f6;padding:8px 10px;color:#111827}
      .kk-trash-table .num{text-align:right;font-weight:700}
      .kk-trash-foot{display:flex!important;align-items:center;justify-content:flex-end;gap:8px;padding:12px 22px 18px;border-top:1px solid #e5e9ee;flex:0 0 auto;background:#fff}
      .kk-trash-foot .btn{display:inline-flex!important;align-items:center;justify-content:center;min-width:74px;visibility:visible!important;opacity:1!important}
      .kk-trash-foot .btn.danger{background:#d92d20;color:#fff;border-color:#d92d20}
      .kk-trash-action{height:31px;min-width:74px;border:1px solid #cfd8e3;background:#fff;border-radius:6px;padding:0 12px;color:#111827;font-size:13px;font-weight:700;display:inline-flex!important;align-items:center;justify-content:center;gap:7px;cursor:pointer;text-decoration:none;visibility:visible!important;opacity:1}
      .kk-trash-action.danger{background:#d92d20;border-color:#d92d20;color:#fff}
      .kk-trash-action.danger:hover:not(:disabled){background:#b42318;border-color:#b42318}
      .kk-trash-action:disabled{opacity:.55!important;cursor:not-allowed}
      .kk-trash-loading{text-align:center;padding:28px 12px;color:#667085;font-size:13px}
    </style>
  </head>
  <body>
    <%- include('../partials/header') %>
    <%
      const safeFilters = locals.filters || {};
      const safePagination = locals.pagination || { page: 1, totalPages: 1, total: 0, from: 0, to: 0, limit: 10 };
      const pageHref = page => {
        const query = typeof qs === 'function' ? qs({ page }) : '';
        return '/kiem-kho' + (query ? '?' + query : '');
      };
      const selectedStatuses = safeFilters.trang_thai || [];
      const fmtNumber = n => Number(n || 0).toLocaleString('vi-VN');
      const fmtDateTime = d => d ? new Date(d).toLocaleString('vi-VN', { day:'2-digit', month:'2-digit', year:'numeric', hour:'2-digit', minute:'2-digit' }) : '';
    %>
    <form id="kkFilterForm" class="kk-page" method="GET" action="/kiem-kho">
      <input type="hidden" name="page" value="<%= safePagination.page %>">
      <aside class="kk-sidebar">
        <div class="filter-block">
          <div class="filter-title">Ngày tạo</div>
          <label class="radio-row">
            <input type="radio" name="date_mode" value="this_month" <%= safeFilters.date_mode !== 'custom' ? 'checked' : '' %> onchange="toggleDateRange();this.form.submit()">
            <span class="filter-line" style="flex:1">Tháng này <i class="fa-solid fa-chevron-right"></i></span>
          </label>
          <label class="radio-row">
            <input type="radio" name="date_mode" value="custom" <%= safeFilters.date_mode === 'custom' ? 'checked' : '' %> onchange="toggleDateRange()">
            <span class="filter-line" style="flex:1">Tùy chỉnh <i class="fa-regular fa-calendar-days"></i></span>
          </label>
          <div id="dateRange" class="date-range <%= safeFilters.date_mode === 'custom' ? 'show' : '' %>">
            <div class="filter-line"><input type="date" name="from_date" value="<%= safeFilters.from_date || '' %>"></div>
            <div class="filter-line"><input type="date" name="to_date" value="<%= safeFilters.to_date || '' %>"></div>
          </div>
        </div>

        <div class="filter-block">
          <div class="filter-title">Trạng thái</div>
          <label class="check-row"><input type="checkbox" name="trang_thai" value="pending" <%= selectedStatuses.includes('pending') ? 'checked' : '' %> onchange="this.form.submit()"> Phiếu tạm</label>
          <label class="check-row"><input type="checkbox" name="trang_thai" value="completed" <%= selectedStatuses.includes('completed') ? 'checked' : '' %> onchange="this.form.submit()"> Đã cân bằng kho</label>
          <label class="check-row"><input type="checkbox" name="trang_thai" value="cancelled" <%= selectedStatuses.includes('cancelled') ? 'checked' : '' %> onchange="this.form.submit()"> Đã hủy</label>
        </div>

        <div class="filter-block">
          <div class="filter-title">Người tạo</div>
          <div class="filter-line">
            <select name="nguoi_tao_id" onchange="this.form.submit()">
              <option value="">Chọn người tạo</option>
              <% (users || []).forEach(u => { %>
                <option value="<%= u._id %>" <%= String(safeFilters.nguoi_tao_id || '') === String(u._id) ? 'selected' : '' %>><%= u.ho_ten || u.username || u.email %></option>
              <% }) %>
            </select>
          </div>
        </div>
      </aside>

      <main class="kk-main">
        <div class="kk-top">
          <div class="kk-title">Phiếu kiểm kho</div>
          <div class="kk-search">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input name="q" value="<%= safeFilters.q || '' %>" placeholder="Theo mã phiếu kiểm">
            <button type="submit"><i class="fa-solid fa-sliders"></i></button>
          </div>
          <div></div>
          <div class="kk-actions">
            <button type="button" class="kk-btn danger kk-delete-btn" id="openKkTrashModal" disabled><i class="fa-solid fa-trash-can"></i> Xóa</button>
            <a class="kk-btn primary" href="/kiem-kho/create"><i class="fa-solid fa-plus"></i> Kiểm kho</a>
            <button type="button" class="kk-btn" id="openKkExportModal"><i class="fa-solid fa-file-export"></i> Xuất file <i class="fa-solid fa-chevron-down" style="font-size:10px"></i></button>
          </div>
        </div>

        <div class="kk-table-wrap">
          <table class="kk-table">
            <thead>
              <tr>
                <th class="select-col"><input class="row-check" id="kkSelectAll" type="checkbox"></th>
                <th>Mã kiểm kho</th>
                <th>Thời gian</th>
                <th>Ngày cân bằng</th>
                <th class="num">SL thực tế</th>
                <th class="num">Tổng thực tế</th>
                <th class="num">Tổng chênh lệch</th>
                <th class="num">SL lệch tăng</th>
                <th class="num">SL lệch giảm</th>
                <th>Ghi chú</th>
              </tr>
            </thead>
            <tbody>
              <% if (!tickets.length) { %>
                <tr><td class="empty-row" colspan="10">Không tìm thấy phiếu kiểm kho phù hợp</td></tr>
              <% } %>
              <% tickets.forEach((t, index) => {
                const summary = t.summary || {};
                const detailItems = summary.items || [];
                const statusCompleted = t.trang_thai === 'completed';
                const creatorName = t.nguoi_tao_id ? (t.nguoi_tao_id.ho_ten || t.nguoi_tao_id.username || t.nguoi_tao_id.email || '') : '';
                const statusText = statusCompleted ? 'Đã cân bằng kho' : (t.trang_thai === 'cancelled' ? 'Đã hủy' : 'Phiếu tạm');
              %>
                <tr class="ticket-row <%= index === 0 ? 'active' : '' %>" data-detail-id="detail-<%= t._id %>" onclick="toggleTicketDetail('<%= t._id %>')">
                  <td class="select-col"><input class="row-check kk-select-check" type="checkbox" value="<%= t._id %>" onclick="event.stopPropagation()"></td>
                  <td><%= t.ma_kiem_kho || '' %></td>
                  <td><%= fmtDateTime(t.ngay_kiem || t.created_at) %></td>
                  <td><%= statusCompleted ? fmtDateTime(t.updated_at || t.ngay_kiem || t.created_at) : '' %></td>
                  <td class="num"><%= fmtNumber(t.tong_so_luong_thuc_te || summary.actual) %></td>
                  <td class="num"><%= fmtNumber(t.tong_gia_tri_thuc_te || 0) %></td>
                  <td class="num"><%= fmtNumber(t.tong_so_luong_lech || 0) %></td>
                  <td class="num"><%= fmtNumber(summary.positive || 0) %></td>
                  <td class="num"><%= fmtNumber(summary.negative || 0) %></td>
                  <td class="note-cell"><%= t.ghi_chu || '' %></td>
                </tr>
                <tr id="detail-<%= t._id %>" class="detail-row <%= index === 0 ? 'open' : '' %>">
                  <td class="detail-cell" colspan="10">
                    <div class="detail-panel">
                      <div class="detail-tab">Thông tin</div>
                      <div class="detail-title">
                        <span><%= t.ma_kiem_kho || '' %></span>
                        <span class="status-pill"><%= statusText %></span>
                      </div>
                      <div class="detail-info-grid">
                        <div class="detail-info-item"><span>Người tạo</span><strong><%= creatorName || 'N/A' %></strong></div>
                        <div class="detail-info-item"><span>Ngày tạo</span><strong><%= fmtDateTime(t.ngay_kiem || t.created_at) || '---' %></strong></div>
                        <div class="detail-info-item"><span>Người cân bằng</span><strong><%= statusCompleted ? (creatorName || 'N/A') : '---' %></strong></div>
                        <div class="detail-info-item"><span>Ngày cân bằng</span><strong><%= statusCompleted ? (fmtDateTime(t.updated_at || t.ngay_kiem || t.created_at) || '---') : '---' %></strong></div>
                        <div class="detail-info-item"><span>SL thực tế</span><strong><%= fmtNumber(t.tong_so_luong_thuc_te || summary.actual) %></strong></div>
                        <div class="detail-info-item"><span>Tổng thực tế</span><strong><%= fmtNumber(t.tong_gia_tri_thuc_te || 0) %></strong></div>
                        <div class="detail-info-item"><span>SL lệch tăng</span><strong><%= fmtNumber(summary.positive || 0) %></strong></div>
                        <div class="detail-info-item"><span>SL lệch giảm</span><strong><%= fmtNumber(summary.negative || 0) %></strong></div>
                        <div class="detail-info-item"><span>Tổng chênh lệch</span><strong><%= fmtNumber(t.tong_so_luong_lech || 0) %></strong></div>
                        <div class="detail-info-item"><span>Giá trị lệch</span><strong><%= fmtNumber(t.tong_gia_tri_lech || summary.value || 0) %></strong></div>
                        <div class="detail-info-item is-note"><span>Ghi chú</span><strong><%= t.ghi_chu || '---' %></strong></div>
                      </div>
                      <div class="detail-meta">
                        <span>Người tạo: <strong><%= creatorName || 'N/A' %></strong></span>
                        <span class="meta-sep"></span>
                        <span>Ngày tạo: <%= fmtDateTime(t.ngay_kiem || t.created_at) %></span>
                      </div>
                      <div class="detail-meta">
                        <span>Người cân bằng: <strong><%= statusCompleted ? (creatorName || 'N/A') : '' %></strong></span>
                        <span class="meta-sep"></span>
                        <span>Ngày cân bằng: <%= statusCompleted ? fmtDateTime(t.updated_at || t.ngay_kiem || t.created_at) : '' %></span>
                      </div>

                      <table class="detail-table">
                        <thead>
                          <tr>
                            <th style="width:200px">Mã hàng</th>
                            <th>Tên hàng</th>
                            <th style="width:140px">Tên lô</th>
                            <th style="width:140px">Thuộc tính</th>
                            <th class="num" style="width:120px">Tồn kho</th>
                            <th class="num" style="width:120px">Thực tế</th>
                            <th class="num" style="width:120px">SL lệch</th>
                            <th class="num" style="width:140px">Giá trị lệch</th>
                          </tr>
                        </thead>
                        <tbody>
                          <% detailItems.forEach(item => {
                            const product = item.hang_hoa_id || {};
                            const lot = item.lo_hang_id || {};
                            const tenLo = String(lot.ten_lo || '').trim();
                            const maLo = String(lot.ma_lo || '').trim();
                            const lotName = tenLo || maLo || (lot._id || item.lo_hang_id ? 'Lô không tên' : '');
                          %>
                            <tr>
                              <td><a class="product-code" href="/hang-hoa"><%= product.ma_hang || '' %></a></td>
                              <td><%= product.ten_hang || '' %></td>
                              <td><%= lotName %></td>
                              <td><%= item.ten_quy_cach || '' %></td>
                              <td class="num"><%= fmtNumber(item.ton_kho_he_thong || 0) %></td>
                              <td class="num"><%= fmtNumber(item.so_luong_thuc_te || 0) %></td>
                              <td class="num"><%= fmtNumber(item.so_luong_lech || 0) %></td>
                              <td class="num"><%= fmtNumber(item.gia_tri_lech || 0) %></td>
                            </tr>
                          <% }) %>
                        </tbody>
                      </table>

                      <div class="detail-bottom">
                        <div class="detail-note"><%= t.ghi_chu || 'Ghi chú...' %></div>
                        <div class="detail-total">
                          <span>Tổng thực tế (<%= fmtNumber(t.tong_so_luong_thuc_te || summary.actual) %>):</span><strong class="num"><%= fmtNumber(t.tong_gia_tri_thuc_te || 0) %></strong>
                          <span>Tổng lệch tăng (<%= fmtNumber(summary.positive || 0) %>):</span><strong class="num"><%= fmtNumber(0) %></strong>
                          <span>Tổng lệch giảm (<%= fmtNumber(summary.negative || 0) %>):</span><strong class="num"><%= fmtNumber(0) %></strong>
                          <span>Tổng chênh lệch (<%= fmtNumber(t.tong_so_luong_lech || 0) %>):</span><strong class="num"><%= fmtNumber(t.tong_gia_tri_lech || summary.value || 0) %></strong>
                        </div>
                      </div>

                      <div class="page-actions page-actions--split page-actions--bordered detail-actions">
                        <div class="page-actions__left detail-action-left">
                          <button class="detail-link-btn" type="button" onclick="cancelKiemKho('<%= t._id %>')" <%= t.trang_thai === 'cancelled' ? 'disabled' : '' %>><i class="fa-regular fa-trash-can"></i> Hủy</button>
                          <a class="detail-link-btn" href="/kiem-kho/create?copy_from=<%= t._id %>"><i class="fa-regular fa-copy"></i> Sao chép</a>
                          <a class="detail-link-btn" href="/kiem-kho/<%= t._id %>/export.csv"><i class="fa-solid fa-file-export"></i> Xuất file</a>
                        </div>
                        <div class="page-actions__right detail-action-right">
                          <a class="small-outline" href="/chung-tu-kho/kiem-kho/<%= t._id %>?variant=thuc-te" target="_blank" rel="noopener"><i class="fa-solid fa-print"></i> In SL thực tế</a>
                          <a class="small-outline" href="/chung-tu-kho/kiem-kho/<%= t._id %>?variant=gia-tri-kho" target="_blank" rel="noopener"><i class="fa-solid fa-print"></i> In giá trị kho</a>
                          <a class="small-outline" href="/chung-tu-kho/kiem-kho/<%= t._id %>" target="_blank"><i class="fa-solid fa-file-lines"></i> Chứng từ đầy đủ</a>
                        </div>
                      </div>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>

        <div class="kk-footer">
          <span class="kk-page-size">Hiển thị 10 dòng/trang</span>
          <nav class="kk-pagination" aria-label="Phân trang kiểm kho">
            <% if (safePagination.page > 1) { %>
              <a class="kk-page-link" href="<%= pageHref(1) %>">Đầu</a>
              <a class="kk-page-link" href="<%= pageHref(safePagination.page - 1) %>">Trước</a>
            <% } else { %>
              <span class="kk-page-link is-disabled">Đầu</span>
              <span class="kk-page-link is-disabled">Trước</span>
            <% } %>
            <span class="kk-page-current"><%= safePagination.page %> / <%= safePagination.totalPages %></span>
            <% if (safePagination.page < safePagination.totalPages) { %>
              <a class="kk-page-link" href="<%= pageHref(safePagination.page + 1) %>">Sau</a>
              <a class="kk-page-link" href="<%= pageHref(safePagination.totalPages) %>">Cuối</a>
            <% } else { %>
              <span class="kk-page-link is-disabled">Sau</span>
              <span class="kk-page-link is-disabled">Cuối</span>
            <% } %>
          </nav>
          <span><%= safePagination.from %> - <%= safePagination.to %> trong <%= safePagination.total %> phiếu</span>
        </div>
      </main>
    </form>

    <div id="kkTrashModalOverlay" class="kk-trash-overlay" aria-hidden="true">
      <div class="kk-trash-modal" role="dialog" aria-labelledby="kkTrashModalTitle" aria-modal="true">
        <div class="kk-trash-head">
          <h3 id="kkTrashModalTitle">Xóa phiếu kiểm kho</h3>
          <button type="button" class="kk-trash-close" id="kkTrashModalClose" aria-label="Đóng">×</button>
        </div>
        <div class="kk-trash-body">
          <p class="kk-trash-desc">Bạn có chắc chắn muốn xóa các phiếu kiểm kho đã chọn không?</p>
          <div id="kkTrashAlert"></div>
          <ul class="kk-trash-selected" id="kkTrashSelectedList" style="display:none"></ul>
          <table class="kk-trash-table" style="display:none">
            <thead>
              <tr>
                <th>Dữ liệu liên quan</th>
                <th class="num" style="width:110px">Số lượng</th>
              </tr>
            </thead>
            <tbody id="kkTrashImpactRows">
              <tr><td colspan="2" class="kk-trash-loading">Chưa tải dữ liệu</td></tr>
            </tbody>
          </table>
        </div>
        <div class="kk-trash-foot">
          <button type="button" class="btn" id="kkTrashCancel">Không</button>
          <button type="button" class="btn danger" id="kkTrashConfirm">Có</button>
        </div>
      </div>
    </div>

    <div id="kkCancelModalOverlay" class="kk-trash-overlay" aria-hidden="true">
      <div class="kk-trash-modal" role="dialog" aria-labelledby="kkCancelModalTitle" aria-modal="true">
        <div class="kk-trash-head">
          <h3 id="kkCancelModalTitle">Hủy phiếu kiểm kho</h3>
          <button type="button" class="kk-trash-close" id="kkCancelModalClose" aria-label="Đóng">×</button>
        </div>
        <div class="kk-trash-body">
          <p class="kk-trash-desc">Bạn có chắc chắn muốn hủy phiếu kiểm kho này không?</p>
        </div>
        <div class="kk-trash-foot">
          <button type="button" class="btn" id="kkCancelModalCancel">Không</button>
          <button type="button" class="btn danger" id="kkCancelModalConfirm">Có</button>
        </div>
      </div>
    </div>

    <div id="kkExportModalOverlay" class="kk-export-overlay">
      <div class="kk-export-modal" role="dialog" aria-labelledby="kkExportModalTitle">
        <div class="kk-export-head">
          <div>
            <h3 id="kkExportModalTitle">Tùy chọn cột hiển thị</h3>
            <p>Chọn ít nhất 1 cột để xuất file</p>
          </div>
          <button type="button" class="kk-export-close" id="kkExportModalClose" aria-label="Đóng">×</button>
        </div>
        <div class="kk-export-body">
          <% (exportColumnGroups || []).forEach(function(group) { %>
            <div class="kk-export-group" data-export-group="<%= group.id %>">
              <div class="kk-export-group-title">
                <span><%= group.title %></span>
                <span class="kk-export-group-count" data-export-group-count="<%= group.id %>">0/<%= group.columns.length %></span>
              </div>
              <div class="kk-export-grid">
                <% group.columns.forEach(function(col) { %>
                  <label>
                    <input type="checkbox" class="kk-export-col-cb" value="<%= col.key %>" data-export-group="<%= group.id %>"<%= col.default ? ' checked' : '' %>>
                    <%= col.header %>
                  </label>
                <% }) %>
              </div>
            </div>
          <% }) %>
          <p id="kkExportError" class="kk-export-error">Vui lòng chọn ít nhất 1 cột.</p>
        </div>
        <div class="kk-export-foot">
          <button type="button" class="kk-btn" id="kkExportDeselectAll">Bỏ chọn tất cả</button>
          <div style="display:flex;gap:8px">
            <button type="button" class="kk-btn" id="kkExportCancel">Bỏ qua</button>
            <button type="button" class="kk-btn primary" id="kkExportSubmit">Xuất file</button>
          </div>
