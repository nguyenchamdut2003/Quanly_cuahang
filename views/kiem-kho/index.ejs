    <form id="kkExportForm" method="POST" action="/kiem-kho/export-excel" style="display:none">
      <div id="kkExportFormInputs"></div>
      <input type="hidden" name="q" value="<%= safeFilters.q || '' %>">
      <input type="hidden" name="date_mode" value="<%= safeFilters.date_mode || 'this_month' %>">
      <input type="hidden" name="from_date" value="<%= safeFilters.from_date || '' %>">
      <input type="hidden" name="to_date" value="<%= safeFilters.to_date || '' %>">
      <input type="hidden" name="nguoi_tao_id" value="<%= safeFilters.nguoi_tao_id || '' %>">
      <% selectedStatuses.forEach(function(status) { %>
        <input type="hidden" name="trang_thai" value="<%= status %>">
      <% }) %>
    </form>

    <script>
      var pendingCancelKiemKhoId = '';
      function cancelKiemKho(id) {
        pendingCancelKiemKhoId = String(id || '');
        var overlay = document.getElementById('kkCancelModalOverlay');
        var confirmBtn = document.getElementById('kkCancelModalConfirm');
        if (confirmBtn) confirmBtn.disabled = false;
        if (overlay) {
          overlay.classList.add('is-open');
          overlay.setAttribute('aria-hidden', 'false');
        }
      }

      function closeKkCancelModal() {
        var overlay = document.getElementById('kkCancelModalOverlay');
        if (overlay) {
          overlay.classList.remove('is-open');
          overlay.setAttribute('aria-hidden', 'true');
        }
        pendingCancelKiemKhoId = '';
      }

      async function confirmKkCancelModal() {
        if (!pendingCancelKiemKhoId) return;
        var confirmBtn = document.getElementById('kkCancelModalConfirm');
        if (confirmBtn) confirmBtn.disabled = true;
        try {
          const res = await fetch('/kiem-kho/' + pendingCancelKiemKhoId + '/cancel', { method: 'POST', headers: { 'Content-Type': 'application/json' } });
          const data = await res.json();
          if (!data.success) throw new Error(data.message || 'Không hủy được phiếu kiểm kho');
          location.reload();
        } catch (error) {
          alert(error.message || 'Không hủy được phiếu kiểm kho');
          if (confirmBtn) confirmBtn.disabled = false;
        }
      }
      function toggleDateRange() {
        const custom = document.querySelector('input[name="date_mode"][value="custom"]').checked;
        document.getElementById('dateRange').classList.toggle('show', custom);
      }
      function toggleTicketDetail(id) {
        const detail = document.getElementById('detail-' + id);
        const row = document.querySelector(`[data-detail-id="detail-${id}"]`);
        if (!detail || !row) return;
        const willOpen = !detail.classList.contains('open');
        document.querySelectorAll('.detail-row.open').forEach(item => item.classList.remove('open'));
        document.querySelectorAll('.ticket-row.active').forEach(item => item.classList.remove('active'));
        if (willOpen) {
          detail.classList.add('open');
          row.classList.add('active');
        }
      }

      (function initKkCancelModal() {
        var overlay = document.getElementById('kkCancelModalOverlay');
        var closeBtn = document.getElementById('kkCancelModalClose');
        var cancelBtn = document.getElementById('kkCancelModalCancel');
        var confirmBtn = document.getElementById('kkCancelModalConfirm');
        if (closeBtn) closeBtn.addEventListener('click', closeKkCancelModal);
        if (cancelBtn) cancelBtn.addEventListener('click', closeKkCancelModal);
        if (confirmBtn) confirmBtn.addEventListener('click', confirmKkCancelModal);
        if (overlay) {
          overlay.addEventListener('click', function(event) {
            if (event.target === overlay) closeKkCancelModal();
          });
        }
        document.addEventListener('keydown', function(event) {
          if (event.key === 'Escape' && overlay && overlay.classList.contains('is-open')) closeKkCancelModal();
        });
      })();

    (function initKkTrashModal() {
      var openBtn = document.getElementById('openKkTrashModal');
      var overlay = document.getElementById('kkTrashModalOverlay');
      var closeBtn = document.getElementById('kkTrashModalClose');
      var cancelBtn = document.getElementById('kkTrashCancel');
      var confirmBtn = document.getElementById('kkTrashConfirm');
      var alertBox = document.getElementById('kkTrashAlert');
      var selectedList = document.getElementById('kkTrashSelectedList');
      var impactBody = document.getElementById('kkTrashImpactRows');
      var selectAll = document.getElementById('kkSelectAll');
      var rowChecks = Array.prototype.slice.call(document.querySelectorAll('.kk-select-check'));
      var pendingIds = [];

      function escapeHtml(value) {
        return String(value == null ? '' : value).replace(/[&<>"']/g, function(char) {
          return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[char];
        });
      }

      function getSelectedIds() {
        return rowChecks.filter(function(cb) { return cb.checked; }).map(function(cb) {
          return String(cb.value || '').trim();
        }).filter(Boolean);
      }

      function updateSelectionState() {
        var selectedIds = getSelectedIds();
        if (openBtn) openBtn.disabled = selectedIds.length === 0;
        if (selectAll) {
          selectAll.checked = rowChecks.length > 0 && rowChecks.every(function(cb) { return cb.checked; });
          selectAll.indeterminate = rowChecks.some(function(cb) { return cb.checked; }) && !selectAll.checked;
        }
      }

      function closeTrashModal() {
        if (!overlay) return;
        overlay.classList.remove('is-open');
        overlay.setAttribute('aria-hidden', 'true');
        pendingIds = [];
        if (confirmBtn) confirmBtn.disabled = true;
      }

      function renderAlert(preview) {
        if (!alertBox) return;
        var html = '';
        (preview.items || []).forEach(function(item) {
          if (!item.can_trash && item.block_reason) {
            html += '<div class="kk-trash-alert is-error">' + escapeHtml(item.ma_kiem_kho || item.phieu_kiem_kho_id) + ': ' + escapeHtml(item.block_reason) + '</div>';
          }
          (item.warnings || []).forEach(function(warn) {
            html += '<div class="kk-trash-alert is-warn">' + escapeHtml(item.ma_kiem_kho || '') + (item.ma_kiem_kho ? ' - ' : '') + escapeHtml(warn) + '</div>';
          });
        });
        alertBox.innerHTML = html;
      }

      function renderSelectedList(ids) {
        if (!selectedList) return;
        selectedList.innerHTML = ids.map(function(id) {
          var cb = document.querySelector('.kk-select-check[value="' + id + '"]');
          var row = cb ? cb.closest('tr') : null;
          var codeCell = row ? row.children[1] : null;
          return '<li>' + escapeHtml(codeCell ? codeCell.textContent.trim() : id) + '</li>';
        }).join('');
      }

      function renderImpactRows(preview) {
        if (!impactBody) return;
        var groups = preview.aggregate_groups || [];
        if (!groups.length) {
          impactBody.innerHTML = '<tr><td colspan="2">Không có dữ liệu liên quan đáng kể.</td></tr>';
          return;
        }
        impactBody.innerHTML = groups.map(function(group) {
          return '<tr>'
            + '<td>' + escapeHtml(group.label || group.entity_type) + '</td>'
            + '<td class="num">' + escapeHtml(String(group.count || 0)) + '</td>'
            + '</tr>';
        }).join('');
      }

      function openTrashModal() {
        var ids = getSelectedIds();
        if (!ids.length) {
          alert('Vui lòng chọn ít nhất một phiếu kiểm kho.');
          return;
        }
        pendingIds = ids.slice();
        if (overlay) {
          overlay.classList.add('is-open');
          overlay.setAttribute('aria-hidden', 'false');
        }
        if (alertBox) alertBox.innerHTML = '';
        renderSelectedList(pendingIds);
        if (confirmBtn) confirmBtn.disabled = false;
      }

      function parseJsonResponse(res) {
        return res.text().then(function(text) {
          var data = {};
          try {
            data = JSON.parse(text || '{}');
          } catch (error) {
            throw new Error('ENDPOINT_NOT_JSON');
          }
          if (!res.ok) throw new Error(data.message || 'Khong xoa duoc phieu kiem kho');
          return data;
        });
      }

      function fallbackCancelSelected(ids) {
        return ids.reduce(function(chain, id) {
          return chain.then(function() {
            return fetch('/kiem-kho/' + encodeURIComponent(id) + '/cancel', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' }
            }).then(parseJsonResponse);
          });
        }, Promise.resolve()).then(function() {
          return { success: true, message: 'Da xoa phieu kiem kho' };
        });
      }

      function confirmTrash() {
        if (!pendingIds.length) return;
        if (confirmBtn) confirmBtn.disabled = true;
        fetch('/kiem-kho/trash/move', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ phieu_kiem_kho_ids: pendingIds })
        })
          .then(parseJsonResponse)
          .catch(function(err) {
            if (err && err.message === 'ENDPOINT_NOT_JSON') return fallbackCancelSelected(pendingIds);
            throw err;
          })
          .then(function(data) {
            if (!data.success) throw new Error(data.message || 'Khong xoa duoc phieu kiem kho');
            alert(data.message || 'Da xoa phieu kiem kho');
            window.location.reload();
          })
          .catch(function(err) {
            alert(err.message || 'Khong xoa duoc phieu kiem kho');
            if (confirmBtn) confirmBtn.disabled = false;
          });
      }
      if (selectAll) {
        selectAll.addEventListener('click', function(e) {
          e.stopPropagation();
          rowChecks.forEach(function(cb) { cb.checked = selectAll.checked; });
          updateSelectionState();
        });
      }
      rowChecks.forEach(function(cb) {
        cb.addEventListener('change', updateSelectionState);
      });
      if (openBtn) openBtn.addEventListener('click', openTrashModal);
      if (closeBtn) closeBtn.addEventListener('click', closeTrashModal);
      if (cancelBtn) cancelBtn.addEventListener('click', closeTrashModal);
      if (confirmBtn) confirmBtn.addEventListener('click', confirmTrash);
      if (overlay) {
        overlay.addEventListener('click', function(e) {
          if (e.target === overlay) closeTrashModal();
        });
      }
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && overlay && overlay.classList.contains('is-open')) closeTrashModal();
      });
      updateSelectionState();
    })();

    (function initKkExportModal() {
      const overlay = document.getElementById('kkExportModalOverlay');
      const openBtn = document.getElementById('openKkExportModal');
      const closeBtn = document.getElementById('kkExportModalClose');
      const cancelBtn = document.getElementById('kkExportCancel');
      const deselectBtn = document.getElementById('kkExportDeselectAll');
      const submitBtn = document.getElementById('kkExportSubmit');
      const errorEl = document.getElementById('kkExportError');
      const form = document.getElementById('kkExportForm');
      const formInputs = document.getElementById('kkExportFormInputs');

      function updateGroupCounts() {
        document.querySelectorAll('[data-export-group-count]').forEach(function(counter) {
          const groupId = counter.getAttribute('data-export-group-count');
          const total = document.querySelectorAll('.kk-export-col-cb[data-export-group="' + groupId + '"]').length;
          const checked = document.querySelectorAll('.kk-export-col-cb[data-export-group="' + groupId + '"]:checked').length;
          counter.textContent = checked + '/' + total;
        });
      }

      function openModal() {
        if (!overlay) return;
        overlay.style.display = 'flex';
        if (errorEl) errorEl.style.display = 'none';
        updateGroupCounts();
      }

      function closeModal() {
        if (overlay) overlay.style.display = 'none';
      }

      if (openBtn) openBtn.addEventListener('click', openModal);
      if (closeBtn) closeBtn.addEventListener('click', closeModal);
      if (cancelBtn) cancelBtn.addEventListener('click', closeModal);
      if (overlay) {
        overlay.addEventListener('click', function(e) {
          if (e.target === overlay) closeModal();
        });
      }
      if (deselectBtn) {
        deselectBtn.addEventListener('click', function() {
          document.querySelectorAll('.kk-export-col-cb').forEach(function(cb) { cb.checked = false; });
          updateGroupCounts();
        });
      }
      document.querySelectorAll('.kk-export-col-cb').forEach(function(cb) {
        cb.addEventListener('change', updateGroupCounts);
      });
      updateGroupCounts();

      if (submitBtn) {
        submitBtn.addEventListener('click', function() {
          const selected = Array.from(document.querySelectorAll('.kk-export-col-cb')).filter(function(cb) { return cb.checked; });
          if (!selected.length) {
            if (errorEl) errorEl.style.display = 'block';
            return;
          }
          if (errorEl) errorEl.style.display = 'none';
          if (formInputs) {
            formInputs.innerHTML = '';
            selected.forEach(function(cb) {
              const input = document.createElement('input');
              input.type = 'hidden';
              input.name = 'columns';
              input.value = cb.value;
              formInputs.appendChild(input);
            });
          }
          if (form) form.submit();
        });
      }

      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && overlay && overlay.style.display === 'flex') closeModal();
      });
    })();
    </script>
  </body>
</html>
