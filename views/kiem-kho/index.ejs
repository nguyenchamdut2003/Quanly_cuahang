<!DOCTYPE html>
<html>
  <head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Phiếu kiểm kho</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/stylesheets/style.css">
  <link rel="stylesheet" href="/stylesheets/responsive.css">
    <style>
      body{background:#f2f4f7}
      .kk-page{height:calc(100vh - 98px);display:grid;grid-template-columns:302px minmax(0,1fr);gap:14px;padding:10px 30px 0}
      .kk-sidebar{background:#fff;border-radius:8px;padding:18px 14px;overflow:auto;border:1px solid #edf0f5}
      .kk-main{min-width:0;display:flex;flex-direction:column}
      .kk-top{min-height:44px;display:grid;grid-template-columns:240px minmax(320px,590px) 1fr auto;align-items:center;gap:10px;margin-bottom:6px}
      .kk-title{font-size:22px;font-weight:800;color:#050505;line-height:1.2}
      .kk-search{height:36px;border:1px solid #c7d0dc;border-radius:8px;background:#fff;display:flex;align-items:center;padding:0 12px;gap:10px}
      .kk-search input{border:0;outline:0;flex:1;font-size:14px}
      .kk-search button{border:0;background:transparent;color:#344054;cursor:pointer}
      .kk-actions{display:flex;align-items:center;gap:8px}
      .kk-btn{height:36px;border:1px solid #c7d0dc;background:#fff;border-radius:8px;color:#1f2937;padding:0 13px;font-weight:700;text-decoration:none;display:inline-flex;align-items:center;gap:8px;cursor:pointer;white-space:nowrap}
      .kk-btn.primary{border-color:#006dff;color:#006dff}
      .kk-btn.danger{border-color:#fecdca;color:#b42318}
      .kk-btn:disabled{opacity:.55;cursor:not-allowed}
      .filter-title{font-size:14px;font-weight:800;margin:0 0 10px;color:#050505}
      .filter-block{margin-bottom:20px}
      .radio-row,.check-row{display:flex;align-items:center;gap:8px;margin:10px 0;font-size:14px;color:#111827}
      .radio-row input,.check-row input{width:15px;height:15px;accent-color:#0070f4}
      .filter-line{height:36px;border:1px solid #cbd5e1;border-radius:8px;background:#fff;display:flex;align-items:center;justify-content:space-between;padding:0 10px;color:#111827}
      .filter-line input,.filter-line select{border:0;outline:0;width:100%;height:34px;background:transparent;color:#667085}
      .date-range{display:none;margin:8px 0 0 23px;gap:6px}
      .date-range.show{display:grid}
      .kk-table-wrap{background:#fff;flex:1;overflow:auto;border:1px solid #e5e7eb;border-radius:8px 8px 0 0}
      .kk-table{width:100%;min-width:1180px;border-collapse:collapse;font-size:13px}
      .kk-table th{height:37px;background:#e8f3ff;border-bottom:1px solid #a8cdfc;text-align:left;color:#050505;font-weight:800;padding:0 10px;white-space:nowrap}
      .kk-table td{height:42px;border-bottom:1px solid #e5e7eb;padding:0 10px;vertical-align:middle}
      .kk-table .num{text-align:right}
      .select-col{width:26px;text-align:center}
      .row-check{width:14px;height:14px;accent-color:#0070f4}
      .ticket-row{cursor:pointer}
      .ticket-row.active{outline:2px solid #006dff;outline-offset:-2px}
      .star{color:#8391a7;font-size:16px}
      .note-cell{max-width:120px;white-space:normal;line-height:20px;padding-top:8px!important}
      .detail-row{display:none}
      .detail-row.open{display:table-row}
      .detail-cell{padding:0!important;border:2px solid #006dff!important;border-top:0!important;background:#fff}
      .detail-panel{padding:16px 24px 18px}
      .detail-tab{display:inline-flex;height:28px;align-items:center;border-bottom:2px solid #006dff;color:#006dff;font-weight:700;margin-bottom:14px}
      .detail-title{display:flex;align-items:center;gap:10px;font-size:18px;font-weight:800;margin:0 0 14px}
      .status-pill{font-size:13px;color:#047857;background:#dcfce7;border-radius:4px;padding:3px 7px;font-weight:700}
      .detail-meta{display:flex;gap:12px;align-items:center;font-size:14px;margin:8px 0;color:#111827}
      .meta-sep{height:14px;width:1px;background:#d1d5db}
      .detail-table{width:100%;border-collapse:collapse;margin-top:22px;font-size:13px}
      .detail-table th{height:34px;background:#f0f1f3;border-bottom:1px solid #cfd5dd;text-align:left;padding:0 10px}
      .detail-table td{height:39px;border-bottom:0;padding:0 10px}
      .detail-table .num{text-align:right}
      .filter-input{height:30px;border:1px solid #cbd5e1;border-radius:6px;padding:0 10px;color:#667085;width:100%;max-width:200px}
      .product-code{color:#006dff;text-decoration:none}
      .detail-bottom{display:grid;grid-template-columns:minmax(360px,1fr) 330px;gap:28px;margin-top:14px;align-items:start}
      .detail-note{height:92px;border:1px solid #cbd5e1;border-radius:7px;padding:10px 12px;color:#667085}
      .detail-total{display:grid;grid-template-columns:1fr 90px;gap:12px;font-size:14px;line-height:30px}
      .detail-link-btn{border:0;background:transparent;color:#111827;font-weight:700;display:inline-flex;gap:7px;align-items:center;cursor:pointer;text-decoration:none}
      .small-outline{height:32px;border:1px solid #cbd5e1;background:#fff;border-radius:7px;padding:0 12px;display:inline-flex;align-items:center;gap:7px;font-weight:700}
      .kk-footer{min-height:38px;display:flex;align-items:center;justify-content:space-between;gap:10px;font-size:13px;color:#344054;flex-wrap:wrap;padding:8px 2px 0}
      .kk-page-size{font-weight:600;color:#475569}
      .kk-pagination{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
      .kk-page-link{min-width:46px;height:28px;padding:0 10px;border:1px solid #cbd5e1;border-radius:6px;background:#fff;color:#0f172a;text-decoration:none;display:inline-flex;align-items:center;justify-content:center;font-weight:700}
      .kk-page-link.is-disabled{color:#94a3b8;background:#f8fafc;cursor:not-allowed}
      .kk-page-current{display:inline-flex;align-items:center;gap:6px;font-weight:700;color:#1f2937}
      .page-size{height:24px;border:1px solid #cbd5e1;border-radius:7px;background:#fff;padding:0 25px 0 8px}
      .empty-row{height:140px!important;text-align:center;color:#667085}
      @media (max-width:1200px){
        .kk-page{grid-template-columns:260px minmax(0,1fr)}
        .kk-top{grid-template-columns:1fr;align-items:stretch}
        .kk-actions{justify-content:flex-start;flex-wrap:wrap}
      }
      .kk-export-overlay{display:none;position:fixed;inset:0;background:rgba(15,23,42,.45);z-index:1200;align-items:center;justify-content:center;padding:20px}
      .kk-export-modal{background:#fff;border-radius:10px;width:min(720px,calc(100vw - 32px));max-height:calc(100vh - 40px);display:flex;flex-direction:column;box-shadow:0 18px 44px rgba(15,23,42,.28)}
      .kk-export-head{display:flex;align-items:flex-start;justify-content:space-between;padding:20px 24px 12px;border-bottom:1px solid #e5e9ee}
      .kk-export-head h3{margin:0;font-size:18px;font-weight:800;color:#111827}
      .kk-export-head p{margin:6px 0 0;font-size:13px;color:#667085}
      .kk-export-close{border:0;background:none;font-size:24px;line-height:1;cursor:pointer;color:#667085}
      .kk-export-body{padding:16px 24px;overflow:auto;flex:1}
      .kk-export-group{margin-bottom:18px}
      .kk-export-group-title{display:flex;align-items:center;justify-content:space-between;font-size:14px;font-weight:800;color:#111827;margin-bottom:10px}
      .kk-export-group-count{font-size:12px;font-weight:700;color:#667085}
      .kk-export-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px 24px}
      .kk-export-grid label{display:flex;align-items:center;gap:8px;font-size:13px;color:#344054;cursor:pointer}
      .kk-export-foot{display:flex;align-items:center;justify-content:space-between;padding:14px 24px 20px;border-top:1px solid #e5e9ee}
      .kk-export-error{color:#d92d20;font-size:13px;margin:0 0 10px;display:none}
      .kk-trash-overlay{display:none;position:fixed;inset:0;background:rgba(15,23,42,.45);z-index:1450;align-items:center;justify-content:center;padding:16px}
      .kk-trash-overlay.is-open{display:flex}
      .kk-trash-modal{width:min(720px,calc(100vw - 24px));max-height:calc(100vh - 32px);background:#fff;border-radius:12px;box-shadow:0 20px 60px rgba(15,23,42,.28);display:flex;flex-direction:column;overflow:hidden}
      .kk-trash-head{display:flex;align-items:center;justify-content:space-between;padding:18px 22px 12px;border-bottom:1px solid #e5e9ee}
      .kk-trash-head h3{margin:0;font-size:18px;font-weight:800;color:#111827}
      .kk-trash-close{border:0;background:transparent;color:#667085;font-size:26px;line-height:1;cursor:pointer}
      .kk-trash-body{padding:14px 22px 18px;overflow:auto}
      .kk-trash-desc{margin:0 0 12px;font-size:13px;line-height:1.5;color:#475467}
      .kk-trash-alert{border-radius:8px;padding:10px 12px;font-size:13px;line-height:1.45;margin-bottom:12px}
      .kk-trash-alert.is-error{border:1px solid #fecdca;background:#fffbfa;color:#b42318}
      .kk-trash-alert.is-warn{border:1px solid #fedf89;background:#fffaeb;color:#93370d}
      .kk-trash-selected{margin:0 0 12px;padding:0;list-style:none}
      .kk-trash-selected li{font-size:13px;color:#111827;padding:4px 0;border-bottom:1px dashed #eef2f6}
      .kk-trash-table{width:100%;border-collapse:collapse;font-size:13px}
      .kk-trash-table th{background:#f8fafc;border-bottom:1px solid #e4eaf2;padding:8px 10px;text-align:left;font-size:12px;color:#475467}
      .kk-trash-table td{border-bottom:1px solid #eef2f6;padding:8px 10px;color:#111827}
      .kk-trash-table .num{text-align:right;font-weight:700}
      .kk-trash-foot{display:flex;align-items:center;justify-content:flex-end;gap:8px;padding:12px 22px 18px;border-top:1px solid #e5e9ee}
      .kk-trash-loading{text-align:center;padding:28px 12px;color:#667085;font-size:13px}
    </style>
  </head>
  <body>
    <%- include('../partials/header') %>
    <%
      const safeFilters = locals.filters || {};
      const safePagination = locals.pagination || { page: 1, totalPages: 1, total: 0, from: 0, to: 0, limit: 10 };
      const pageHref = page => {
        const query = typeof qs === 'function' ? qs({ page }) : '';
        return '/kiem-kho' + (query ? '?' + query : '');
      };
      const selectedStatuses = safeFilters.trang_thai || [];
      const fmtNumber = n => Number(n || 0).toLocaleString('vi-VN');
      const fmtDateTime = d => d ? new Date(d).toLocaleString('vi-VN', { day:'2-digit', month:'2-digit', year:'numeric', hour:'2-digit', minute:'2-digit' }) : '';
    %>
    <form id="kkFilterForm" class="kk-page" method="GET" action="/kiem-kho">
      <input type="hidden" name="page" value="<%= safePagination.page %>">
      <aside class="kk-sidebar">
        <div class="filter-block">
          <div class="filter-title">Ngày tạo</div>
          <label class="radio-row">
            <input type="radio" name="date_mode" value="this_month" <%= safeFilters.date_mode !== 'custom' ? 'checked' : '' %> onchange="toggleDateRange();this.form.submit()">
            <span class="filter-line" style="flex:1">Tháng này <i class="fa-solid fa-chevron-right"></i></span>
          </label>
          <label class="radio-row">
            <input type="radio" name="date_mode" value="custom" <%= safeFilters.date_mode === 'custom' ? 'checked' : '' %> onchange="toggleDateRange()">
            <span class="filter-line" style="flex:1">Tùy chỉnh <i class="fa-regular fa-calendar-days"></i></span>
          </label>
          <div id="dateRange" class="date-range <%= safeFilters.date_mode === 'custom' ? 'show' : '' %>">
            <div class="filter-line"><input type="date" name="from_date" value="<%= safeFilters.from_date || '' %>"></div>
            <div class="filter-line"><input type="date" name="to_date" value="<%= safeFilters.to_date || '' %>"></div>
          </div>
        </div>

        <div class="filter-block">
          <div class="filter-title">Trạng thái</div>
          <label class="check-row"><input type="checkbox" name="trang_thai" value="pending" <%= selectedStatuses.includes('pending') ? 'checked' : '' %> onchange="this.form.submit()"> Phiếu tạm</label>
          <label class="check-row"><input type="checkbox" name="trang_thai" value="completed" <%= selectedStatuses.includes('completed') ? 'checked' : '' %> onchange="this.form.submit()"> Đã cân bằng kho</label>
          <label class="check-row"><input type="checkbox" name="trang_thai" value="cancelled" <%= selectedStatuses.includes('cancelled') ? 'checked' : '' %> onchange="this.form.submit()"> Đã hủy</label>
        </div>

        <div class="filter-block">
          <div class="filter-title">Người tạo</div>
          <div class="filter-line">
            <select name="nguoi_tao_id" onchange="this.form.submit()">
              <option value="">Chọn người tạo</option>
              <% (users || []).forEach(u => { %>
                <option value="<%= u._id %>" <%= String(safeFilters.nguoi_tao_id || '') === String(u._id) ? 'selected' : '' %>><%= u.ho_ten || u.username || u.email %></option>
              <% }) %>
            </select>
          </div>
        </div>
      </aside>

      <main class="kk-main">
        <div class="kk-top">
          <div class="kk-title">Phiếu kiểm kho</div>
          <div class="kk-search">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input name="q" value="<%= safeFilters.q || '' %>" placeholder="Theo mã phiếu kiểm">
            <button type="submit"><i class="fa-solid fa-sliders"></i></button>
          </div>
          <div></div>
          <div class="kk-actions">
            <button type="button" class="kk-btn danger" id="openKkTrashModal" disabled><i class="fa-regular fa-trash-can"></i> Xóa</button>
            <a class="kk-btn primary" href="/kiem-kho/create"><i class="fa-solid fa-plus"></i> Kiểm kho</a>
            <button type="button" class="kk-btn" id="openKkExportModal"><i class="fa-solid fa-file-export"></i> Xuất file <i class="fa-solid fa-chevron-down" style="font-size:10px"></i></button>
          </div>
        </div>

        <div class="kk-table-wrap">
          <table class="kk-table">
            <thead>
              <tr>
                <th class="select-col"><input class="row-check" id="kkSelectAll" type="checkbox"></th>
                <th style="width:36px"><i class="fa-regular fa-star star"></i></th>
                <th>Mã kiểm kho</th>
                <th>Thời gian</th>
                <th>Ngày cân bằng</th>
                <th class="num">SL thực tế</th>
                <th class="num">Tổng thực tế</th>
                <th class="num">Tổng chênh lệch</th>
                <th class="num">SL lệch tăng</th>
                <th class="num">SL lệch giảm</th>
                <th>Ghi chú</th>
              </tr>
            </thead>
            <tbody>
              <% if (!tickets.length) { %>
                <tr><td class="empty-row" colspan="11">Không tìm thấy phiếu kiểm kho phù hợp</td></tr>
              <% } %>
              <% tickets.forEach((t, index) => {
                const summary = t.summary || {};
                const detailItems = summary.items || [];
                const statusCompleted = t.trang_thai === 'completed';
                const creatorName = t.nguoi_tao_id ? (t.nguoi_tao_id.ho_ten || t.nguoi_tao_id.username || t.nguoi_tao_id.email || '') : '';
                const statusText = statusCompleted ? 'Đã cân bằng kho' : (t.trang_thai === 'cancelled' ? 'Đã hủy' : 'Phiếu tạm');
              %>
                <tr class="ticket-row <%= index === 0 ? 'active' : '' %>" data-detail-id="detail-<%= t._id %>" onclick="toggleTicketDetail('<%= t._id %>')">
                  <td class="select-col"><input class="row-check kk-select-check" type="checkbox" value="<%= t._id %>" onclick="event.stopPropagation()"></td>
                  <td><i class="fa-regular fa-star star"></i></td>
                  <td><%= t.ma_kiem_kho || '' %></td>
                  <td><%= fmtDateTime(t.ngay_kiem || t.created_at) %></td>
                  <td><%= statusCompleted ? fmtDateTime(t.updated_at || t.ngay_kiem || t.created_at) : '' %></td>
                  <td class="num"><%= fmtNumber(t.tong_so_luong_thuc_te || summary.actual) %></td>
                  <td class="num"><%= fmtNumber(t.tong_gia_tri_thuc_te || 0) %></td>
                  <td class="num"><%= fmtNumber(t.tong_so_luong_lech || 0) %></td>
                  <td class="num"><%= fmtNumber(summary.positive || 0) %></td>
                  <td class="num"><%= fmtNumber(summary.negative || 0) %></td>
                  <td class="note-cell"><%= t.ghi_chu || '' %></td>
                </tr>
                <tr id="detail-<%= t._id %>" class="detail-row <%= index === 0 ? 'open' : '' %>">
                  <td class="detail-cell" colspan="11">
                    <div class="detail-panel">
                      <div class="detail-tab">Thông tin</div>
                      <div class="detail-title">
                        <span><%= t.ma_kiem_kho || '' %></span>
                        <span class="status-pill"><%= statusText %></span>
                      </div>
                      <div class="detail-meta">
                        <span>Người tạo: <strong><%= creatorName || 'N/A' %></strong></span>
                        <span class="meta-sep"></span>
                        <span>Ngày tạo: <%= fmtDateTime(t.ngay_kiem || t.created_at) %></span>
                      </div>
                      <div class="detail-meta">
                        <span>Người cân bằng: <strong><%= statusCompleted ? (creatorName || 'N/A') : '' %></strong></span>
                        <span class="meta-sep"></span>
                        <span>Ngày cân bằng: <%= statusCompleted ? fmtDateTime(t.updated_at || t.ngay_kiem || t.created_at) : '' %></span>
                      </div>

                      <table class="detail-table">
                        <thead>
                          <tr>
                            <th style="width:200px">Mã hàng</th>
                            <th>Tên hàng</th>
                            <th style="width:140px">Tên lô</th>
                            <th style="width:140px">Thuộc tính</th>
                            <th class="num" style="width:120px">Tồn kho</th>
                            <th class="num" style="width:120px">Thực tế</th>
                            <th class="num" style="width:120px">SL lệch</th>
                            <th class="num" style="width:140px">Giá trị lệch</th>
                          </tr>
                        </thead>
                        <tbody>
                          <tr>
                            <td><input class="filter-input" placeholder="Tìm mã hàng"></td>
                            <td><input class="filter-input" placeholder="Tìm tên hàng"></td>
                            <td></td><td></td><td></td><td></td><td></td><td></td>
                          </tr>
                          <% detailItems.forEach(item => {
                            const product = item.hang_hoa_id || {};
                            const lot = item.lo_hang_id || {};
                            const tenLo = String(lot.ten_lo || '').trim();
                            const maLo = String(lot.ma_lo || '').trim();
                            const lotName = tenLo || maLo || (lot._id || item.lo_hang_id ? 'Lô không tên' : '');
                          %>
                            <tr>
                              <td><a class="product-code" href="/hang-hoa"><%= product.ma_hang || '' %></a></td>
                              <td><%= product.ten_hang || '' %></td>
                              <td><%= lotName %></td>
                              <td><%= item.ten_quy_cach || '' %></td>
                              <td class="num"><%= fmtNumber(item.ton_kho_he_thong || 0) %></td>
                              <td class="num"><%= fmtNumber(item.so_luong_thuc_te || 0) %></td>
                              <td class="num"><%= fmtNumber(item.so_luong_lech || 0) %></td>
                              <td class="num"><%= fmtNumber(item.gia_tri_lech || 0) %></td>
                            </tr>
                          <% }) %>
                        </tbody>
                      </table>

                      <div class="detail-bottom">
                        <div class="detail-note"><%= t.ghi_chu || 'Ghi chú...' %></div>
                        <div class="detail-total">
                          <span>Tổng thực tế (<%= fmtNumber(t.tong_so_luong_thuc_te || summary.actual) %>):</span><strong class="num"><%= fmtNumber(t.tong_gia_tri_thuc_te || 0) %></strong>
                          <span>Tổng lệch tăng (<%= fmtNumber(summary.positive || 0) %>):</span><strong class="num"><%= fmtNumber(0) %></strong>
                          <span>Tổng lệch giảm (<%= fmtNumber(summary.negative || 0) %>):</span><strong class="num"><%= fmtNumber(0) %></strong>
                          <span>Tổng chênh lệch (<%= fmtNumber(t.tong_so_luong_lech || 0) %>):</span><strong class="num"><%= fmtNumber(t.tong_gia_tri_lech || summary.value || 0) %></strong>
                        </div>
                      </div>

                      <div class="page-actions page-actions--split page-actions--bordered detail-actions">
                        <div class="page-actions__left detail-action-left">
                          <button class="detail-link-btn" type="button" onclick="cancelKiemKho('<%= t._id %>')" <%= t.trang_thai === 'cancelled' ? 'disabled' : '' %>><i class="fa-regular fa-trash-can"></i> Hủy</button>
                          <a class="detail-link-btn" href="/kiem-kho/create?copy_from=<%= t._id %>"><i class="fa-regular fa-copy"></i> Sao chép</a>
                          <a class="detail-link-btn" href="/kiem-kho/<%= t._id %>/export.csv"><i class="fa-solid fa-file-export"></i> Xuất file</a>
                        </div>
                        <div class="page-actions__right detail-action-right">
                          <button class="small-outline" type="button"><i class="fa-regular fa-floppy-disk"></i> Lưu</button>
                          <a class="small-outline" href="/chung-tu-kho/kiem-kho/<%= t._id %>?variant=thuc-te" target="_blank" rel="noopener"><i class="fa-solid fa-print"></i> In SL thực tế</a>
                          <a class="small-outline" href="/chung-tu-kho/kiem-kho/<%= t._id %>?variant=gia-tri-kho" target="_blank" rel="noopener"><i class="fa-solid fa-print"></i> In giá trị kho</a>
                          <a class="small-outline" href="/chung-tu-kho/kiem-kho/<%= t._id %>" target="_blank"><i class="fa-solid fa-file-lines"></i> Chứng từ đầy đủ</a>
                        </div>
                      </div>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>

        <div class="kk-footer">
          <span class="kk-page-size">Hiển thị 10 dòng/trang</span>
          <nav class="kk-pagination" aria-label="Phân trang kiểm kho">
            <% if (safePagination.page > 1) { %>
              <a class="kk-page-link" href="<%= pageHref(1) %>">Đầu</a>
              <a class="kk-page-link" href="<%= pageHref(safePagination.page - 1) %>">Trước</a>
            <% } else { %>
              <span class="kk-page-link is-disabled">Đầu</span>
              <span class="kk-page-link is-disabled">Trước</span>
            <% } %>
            <span class="kk-page-current"><%= safePagination.page %> / <%= safePagination.totalPages %></span>
            <% if (safePagination.page < safePagination.totalPages) { %>
              <a class="kk-page-link" href="<%= pageHref(safePagination.page + 1) %>">Sau</a>
              <a class="kk-page-link" href="<%= pageHref(safePagination.totalPages) %>">Cuối</a>
            <% } else { %>
              <span class="kk-page-link is-disabled">Sau</span>
              <span class="kk-page-link is-disabled">Cuối</span>
            <% } %>
          </nav>
          <span><%= safePagination.from %> - <%= safePagination.to %> trong <%= safePagination.total %> phiếu</span>
        </div>
      </main>
    </form>

    <div id="kkTrashModalOverlay" class="kk-trash-overlay" aria-hidden="true">
      <div class="kk-trash-modal" role="dialog" aria-labelledby="kkTrashModalTitle" aria-modal="true">
        <div class="kk-trash-head">
          <h3 id="kkTrashModalTitle">Đưa phiếu kiểm kho vào thùng rác</h3>
          <button type="button" class="kk-trash-close" id="kkTrashModalClose" aria-label="Đóng">×</button>
        </div>
        <div class="kk-trash-body">
          <p class="kk-trash-desc">Phiếu kiểm kho được chọn sẽ được đưa vào thùng rác, coi như đã xóa khỏi hệ thống và không còn tính vào hàng hóa/tồn kho. Dữ liệu chỉ bị xóa khỏi DB khi quá 30 ngày hoặc khi xóa vĩnh viễn trong Thùng rác.</p>
          <div id="kkTrashAlert"></div>
          <ul class="kk-trash-selected" id="kkTrashSelectedList"></ul>
          <table class="kk-trash-table">
            <thead>
              <tr>
                <th>Dữ liệu liên quan</th>
                <th class="num" style="width:110px">Số lượng</th>
              </tr>
            </thead>
            <tbody id="kkTrashImpactRows">
              <tr><td colspan="2" class="kk-trash-loading">Chưa tải dữ liệu</td></tr>
            </tbody>
          </table>
        </div>
        <div class="kk-trash-foot">
          <button type="button" class="kk-btn" id="kkTrashCancel">Bỏ qua</button>
          <button type="button" class="kk-btn danger" id="kkTrashConfirm" disabled>Đưa vào thùng rác</button>
        </div>
      </div>
    </div>

    <div id="kkExportModalOverlay" class="kk-export-overlay">
      <div class="kk-export-modal" role="dialog" aria-labelledby="kkExportModalTitle">
        <div class="kk-export-head">
          <div>
            <h3 id="kkExportModalTitle">Tùy chọn cột hiển thị</h3>
            <p>Chọn ít nhất 1 cột để xuất file</p>
          </div>
          <button type="button" class="kk-export-close" id="kkExportModalClose" aria-label="Đóng">×</button>
        </div>
        <div class="kk-export-body">
          <% (exportColumnGroups || []).forEach(function(group) { %>
            <div class="kk-export-group" data-export-group="<%= group.id %>">
              <div class="kk-export-group-title">
                <span><%= group.title %></span>
                <span class="kk-export-group-count" data-export-group-count="<%= group.id %>">0/<%= group.columns.length %></span>
              </div>
              <div class="kk-export-grid">
                <% group.columns.forEach(function(col) { %>
                  <label>
                    <input type="checkbox" class="kk-export-col-cb" value="<%= col.key %>" data-export-group="<%= group.id %>"<%= col.default ? ' checked' : '' %>>
                    <%= col.header %>
                  </label>
                <% }) %>
              </div>
            </div>
          <% }) %>
          <p id="kkExportError" class="kk-export-error">Vui lòng chọn ít nhất 1 cột.</p>
        </div>
        <div class="kk-export-foot">
          <button type="button" class="kk-btn" id="kkExportDeselectAll">Bỏ chọn tất cả</button>
          <div style="display:flex;gap:8px">
            <button type="button" class="kk-btn" id="kkExportCancel">Bỏ qua</button>
            <button type="button" class="kk-btn primary" id="kkExportSubmit">Xuất file</button>
          </div>
        </div>
      </div>
    </div>

    <form id="kkExportForm" method="POST" action="/kiem-kho/export-excel" style="display:none">
      <div id="kkExportFormInputs"></div>
      <input type="hidden" name="q" value="<%= safeFilters.q || '' %>">
      <input type="hidden" name="date_mode" value="<%= safeFilters.date_mode || 'this_month' %>">
      <input type="hidden" name="from_date" value="<%= safeFilters.from_date || '' %>">
      <input type="hidden" name="to_date" value="<%= safeFilters.to_date || '' %>">
      <input type="hidden" name="nguoi_tao_id" value="<%= safeFilters.nguoi_tao_id || '' %>">
      <% selectedStatuses.forEach(function(status) { %>
        <input type="hidden" name="trang_thai" value="<%= status %>">
      <% }) %>
    </form>

    <script>
      async function cancelKiemKho(id) {
        if (!confirm('Hủy phiếu kiểm kho này? Hệ thống sẽ đảo lại chênh lệch tồn kho đã ghi nhận.')) return;
        const res = await fetch('/kiem-kho/' + id + '/cancel', { method: 'POST', headers: { 'Content-Type': 'application/json' } });
        const data = await res.json();
        if (!data.success) return alert(data.message || 'Không hủy được phiếu kiểm kho');
        location.reload();
      }
      function toggleDateRange() {
        const custom = document.querySelector('input[name="date_mode"][value="custom"]').checked;
        document.getElementById('dateRange').classList.toggle('show', custom);
      }
      function toggleTicketDetail(id) {
        const detail = document.getElementById('detail-' + id);
        const row = document.querySelector(`[data-detail-id="detail-${id}"]`);
        if (!detail || !row) return;
        const willOpen = !detail.classList.contains('open');
        document.querySelectorAll('.detail-row.open').forEach(item => item.classList.remove('open'));
        document.querySelectorAll('.ticket-row.active').forEach(item => item.classList.remove('active'));
        if (willOpen) {
          detail.classList.add('open');
          row.classList.add('active');
        }
      }

    (function initKkTrashModal() {
      var openBtn = document.getElementById('openKkTrashModal');
      var overlay = document.getElementById('kkTrashModalOverlay');
      var closeBtn = document.getElementById('kkTrashModalClose');
      var cancelBtn = document.getElementById('kkTrashCancel');
      var confirmBtn = document.getElementById('kkTrashConfirm');
      var alertBox = document.getElementById('kkTrashAlert');
      var selectedList = document.getElementById('kkTrashSelectedList');
      var impactBody = document.getElementById('kkTrashImpactRows');
      var selectAll = document.getElementById('kkSelectAll');
      var rowChecks = Array.prototype.slice.call(document.querySelectorAll('.kk-select-check'));
      var pendingIds = [];
      var previewData = null;

      function escapeHtml(value) {
        return String(value == null ? '' : value).replace(/[&<>"']/g, function(char) {
          return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[char];
        });
      }

      function getSelectedIds() {
        return rowChecks.filter(function(cb) { return cb.checked; }).map(function(cb) {
          return String(cb.value || '').trim();
        }).filter(Boolean);
      }

      function updateSelectionState() {
        var selectedIds = getSelectedIds();
        if (openBtn) openBtn.disabled = selectedIds.length === 0;
        if (selectAll) {
          selectAll.checked = rowChecks.length > 0 && rowChecks.every(function(cb) { return cb.checked; });
          selectAll.indeterminate = rowChecks.some(function(cb) { return cb.checked; }) && !selectAll.checked;
        }
      }

      function closeTrashModal() {
        if (!overlay) return;
        overlay.classList.remove('is-open');
        overlay.setAttribute('aria-hidden', 'true');
        pendingIds = [];
        previewData = null;
        if (confirmBtn) confirmBtn.disabled = true;
      }

      function renderAlert(preview) {
        if (!alertBox) return;
        var html = '';
        (preview.items || []).forEach(function(item) {
          if (!item.can_trash && item.block_reason) {
            html += '<div class="kk-trash-alert is-error">' + escapeHtml(item.ma_kiem_kho || item.phieu_kiem_kho_id) + ': ' + escapeHtml(item.block_reason) + '</div>';
          }
          (item.warnings || []).forEach(function(warn) {
            html += '<div class="kk-trash-alert is-warn">' + escapeHtml(item.ma_kiem_kho || '') + (item.ma_kiem_kho ? ' - ' : '') + escapeHtml(warn) + '</div>';
          });
        });
        alertBox.innerHTML = html;
      }

      function renderSelectedList(preview) {
        if (!selectedList) return;
        selectedList.innerHTML = (preview.items || []).map(function(item) {
          var label = [item.ma_kiem_kho, item.kho].filter(Boolean).join(' - ');
          return '<li>' + escapeHtml(label || item.phieu_kiem_kho_id) + '</li>';
        }).join('');
      }

      function renderImpactRows(preview) {
        if (!impactBody) return;
        var groups = preview.aggregate_groups || [];
        if (!groups.length) {
          impactBody.innerHTML = '<tr><td colspan="2">Không có dữ liệu liên quan đáng kể.</td></tr>';
          return;
        }
        impactBody.innerHTML = groups.map(function(group) {
          return '<tr>'
            + '<td>' + escapeHtml(group.label || group.entity_type) + '</td>'
            + '<td class="num">' + escapeHtml(String(group.count || 0)) + '</td>'
            + '</tr>';
        }).join('');
      }

      function openTrashModal() {
        var ids = getSelectedIds();
        if (!ids.length) {
          alert('Vui lòng chọn ít nhất một phiếu kiểm kho.');
          return;
        }
        pendingIds = ids.slice();
        if (overlay) {
          overlay.classList.add('is-open');
          overlay.setAttribute('aria-hidden', 'false');
        }
        if (impactBody) impactBody.innerHTML = '<tr><td colspan="2" class="kk-trash-loading">Đang kiểm tra dữ liệu liên quan...</td></tr>';
        if (alertBox) alertBox.innerHTML = '';
        if (selectedList) selectedList.innerHTML = '';
        if (confirmBtn) confirmBtn.disabled = true;

        fetch('/kiem-kho/trash/preview', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ phieu_kiem_kho_ids: pendingIds })
        })
          .then(function(res) { return res.json(); })
          .then(function(data) {
            if (!data.success) throw new Error(data.message || 'Không tải được thông tin xóa');
            previewData = data.data;
            renderSelectedList(previewData);
            renderAlert(previewData);
            renderImpactRows(previewData);
            if (confirmBtn) confirmBtn.disabled = !previewData.can_proceed;
          })
          .catch(function(err) {
            if (impactBody) impactBody.innerHTML = '<tr><td colspan="2">' + escapeHtml(err.message || 'Lỗi') + '</td></tr>';
            alert(err.message || 'Không tải được thông tin xóa');
          });
      }

      function confirmTrash() {
        if (!previewData || !previewData.can_proceed || !pendingIds.length) return;
        if (confirmBtn) confirmBtn.disabled = true;
        fetch('/kiem-kho/trash/move', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ phieu_kiem_kho_ids: pendingIds })
        })
          .then(function(res) { return res.json(); })
          .then(function(data) {
            if (!data.success) throw new Error(data.message || 'Không xóa được phiếu kiểm kho');
            alert(data.message || 'Đã xóa phiếu kiểm kho');
            window.location.reload();
          })
          .catch(function(err) {
            alert(err.message || 'Không xóa được phiếu kiểm kho');
            if (confirmBtn) confirmBtn.disabled = false;
          });
      }

      if (selectAll) {
        selectAll.addEventListener('click', function(e) {
          e.stopPropagation();
          rowChecks.forEach(function(cb) { cb.checked = selectAll.checked; });
          updateSelectionState();
        });
      }
      rowChecks.forEach(function(cb) {
        cb.addEventListener('change', updateSelectionState);
      });
      if (openBtn) openBtn.addEventListener('click', openTrashModal);
      if (closeBtn) closeBtn.addEventListener('click', closeTrashModal);
      if (cancelBtn) cancelBtn.addEventListener('click', closeTrashModal);
      if (confirmBtn) confirmBtn.addEventListener('click', confirmTrash);
      if (overlay) {
        overlay.addEventListener('click', function(e) {
          if (e.target === overlay) closeTrashModal();
        });
      }
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && overlay && overlay.classList.contains('is-open')) closeTrashModal();
      });
      updateSelectionState();
    })();

    (function initKkExportModal() {
      const overlay = document.getElementById('kkExportModalOverlay');
      const openBtn = document.getElementById('openKkExportModal');
      const closeBtn = document.getElementById('kkExportModalClose');
      const cancelBtn = document.getElementById('kkExportCancel');
      const deselectBtn = document.getElementById('kkExportDeselectAll');
      const submitBtn = document.getElementById('kkExportSubmit');
      const errorEl = document.getElementById('kkExportError');
      const form = document.getElementById('kkExportForm');
      const formInputs = document.getElementById('kkExportFormInputs');

      function updateGroupCounts() {
        document.querySelectorAll('[data-export-group-count]').forEach(function(counter) {
          const groupId = counter.getAttribute('data-export-group-count');
          const total = document.querySelectorAll('.kk-export-col-cb[data-export-group="' + groupId + '"]').length;
          const checked = document.querySelectorAll('.kk-export-col-cb[data-export-group="' + groupId + '"]:checked').length;
          counter.textContent = checked + '/' + total;
        });
      }

      function openModal() {
        if (!overlay) return;
        overlay.style.display = 'flex';
        if (errorEl) errorEl.style.display = 'none';
        updateGroupCounts();
      }

      function closeModal() {
        if (overlay) overlay.style.display = 'none';
      }

      if (openBtn) openBtn.addEventListener('click', openModal);
      if (closeBtn) closeBtn.addEventListener('click', closeModal);
      if (cancelBtn) cancelBtn.addEventListener('click', closeModal);
      if (overlay) {
        overlay.addEventListener('click', function(e) {
          if (e.target === overlay) closeModal();
        });
      }
      if (deselectBtn) {
        deselectBtn.addEventListener('click', function() {
          document.querySelectorAll('.kk-export-col-cb').forEach(function(cb) { cb.checked = false; });
          updateGroupCounts();
        });
      }
      document.querySelectorAll('.kk-export-col-cb').forEach(function(cb) {
        cb.addEventListener('change', updateGroupCounts);
      });
      updateGroupCounts();

      if (submitBtn) {
        submitBtn.addEventListener('click', function() {
          const selected = Array.from(document.querySelectorAll('.kk-export-col-cb')).filter(function(cb) { return cb.checked; });
          if (!selected.length) {
            if (errorEl) errorEl.style.display = 'block';
            return;
          }
          if (errorEl) errorEl.style.display = 'none';
          if (formInputs) {
            formInputs.innerHTML = '';
            selected.forEach(function(cb) {
              const input = document.createElement('input');
              input.type = 'hidden';
              input.name = 'columns';
              input.value = cb.value;
              formInputs.appendChild(input);
            });
          }
          if (form) form.submit();
        });
      }

      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && overlay && overlay.style.display === 'flex') closeModal();
      });
    })();
    </script>
  </body>
</html>
