<!DOCTYPE html>
<html>
  <head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Kiểm kho mới</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel='stylesheet' href='/stylesheets/style.css' />
    <link rel="stylesheet" href="/stylesheets/global-loading.css">
    <style>
      .kiemkho-container {
        display: grid;
        grid-template-columns: 1fr 350px;
        gap: 20px;
        padding: 20px;
        background-color: #f0f2f5;
        min-height: calc(100vh - 100px);
      }
      .left-panel, .right-panel {
        background: #fff;
        border-radius: 8px;
        padding: 20px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
      }
      .search-box {
        position: relative;
        margin-bottom: 20px;
      }
      .search-box input {
        width: 100%;
        padding: 12px 40px;
        border: 1px solid #ddd;
        border-radius: 6px;
      }
      .search-box i {
        position: absolute;
        left: 15px;
        top: 15px;
        color: #999;
      }
      .kk-table {
        width: 100%;
        border-collapse: collapse;
      }
      .kk-table th {
        background: #f8f9fa;
        padding: 10px;
        text-align: left;
        border-bottom: 2px solid #eee;
      }
      .kk-table td {
        padding: 12px 10px;
        border-bottom: 1px solid #eee;
      }
      .input-thuc-te {
        width: 80px;
        padding: 6px;
        border: 1px solid #ddd;
        border-radius: 4px;
        text-align: right;
        background: #fffbe6;
      }
      .lech-positive { color: #52c41a; font-weight: bold; }
      .lech-negative { color: #ff4d4f; font-weight: bold; }
      .search-results {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        background: #fff;
        border: 1px solid #ddd;
        z-index: 1000;
        max-height: 250px;
        overflow-y: auto;
        display: none;
      }
      .search-item {
        padding: 10px 15px;
        cursor: pointer;
        border-bottom: 1px solid #f0f0f0;
      }
      .search-item:hover { background: #e6f7ff; }
      .btn-finish {
        width: 100%;
        padding: 15px;
        background: #52c41a;
        color: #fff;
        border: none;
        border-radius: 6px;
        font-size: 16px;
        font-weight: bold;
        cursor: pointer;
        margin-top: 20px;
      }
      .btn-finish:disabled {
        opacity: 0.75;
        cursor: wait;
      }
      .btn-print-ton {
        width: 100%;
        padding: 12px;
        background: #fff;
        color: #1677ff;
        border: 1px solid #1677ff;
        border-radius: 6px;
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
        margin-top: 14px;
      }
      .btn-print-ton:hover { background: #e6f4ff; }
      .btn-print-gia-tri {
        width: 100%;
        padding: 12px;
        background: #fff;
        color: #389e0d;
        border: 1px solid #389e0d;
        border-radius: 6px;
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
        margin-top: 10px;
      }
      .btn-print-gia-tri:hover { background: #f6ffed; }
      .kk-groups { display: flex; flex-direction: column; gap: 14px; }
      .kk-product-group { margin-bottom: 4px; }
      .lot-group-title {
        font-size: 14px;
        font-weight: 800;
        color: #111827;
        margin: 0 0 8px;
      }
      .lot-group-title:first-child { margin-top: 0; }
      .grouped-lot-table { margin-bottom: 10px; }
      .grouped-lot-table th,
      .grouped-lot-table td { vertical-align: middle; }
      .grouped-lot-table .lot-cell {
        width: 140px;
        max-width: 180px;
        color: #111827;
        font-weight: 700;
        vertical-align: top;
      }
      .grouped-lot-table .attr-cell { min-width: 100px; }
      .kk-empty {
        text-align: center;
        color: #777;
        padding: 40px 16px;
        border: 1px dashed #ddd;
        border-radius: 6px;
      }
      .kk-list-loading {
        min-height: 128px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        color: #666;
        border: 1px dashed #ddd;
        border-radius: 6px;
        padding: 40px 16px;
      }
      .kk-list-loading i {
        color: #1677ff;
        font-size: 18px;
      }
      .kk-date-input {
        width: 150px;
        padding: 6px 8px;
        border: 1px solid #ddd;
        border-radius: 6px;
        font-size: 14px;
      }
    </style>
  </head>
  <body>
    <%- include('../partials/header') %>

    <div id="appRoot">
    <div class="kiemkho-container">
      <div class="left-panel">
        <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 20px;">
          <a href="/kiem-kho" style="color: #666;"><i class="fa-solid fa-arrow-left"></i></a>
          <h2 style="margin: 0;">Kiểm kho</h2>
        </div>

        <div class="search-box">
          <i class="fa-solid fa-magnifying-glass"></i>
          <input type="text" id="kkSearch" placeholder="Tìm hàng hóa theo mã hoặc tên...">
          <div id="kkResults" class="search-results"></div>
        </div>

        <div id="kkBody" class="kk-groups">
          <!-- Nhóm theo sản phẩm / lô -->
        </div>
      </div>

      <div class="right-panel">
        <div style="display: flex; justify-content: space-between; margin-bottom: 20px;">
          <span><strong>Người tạo:</strong> <%= user.ho_ten %></span>
          <input id="ngayKiem" class="kk-date-input" type="datetime-local" value="<%= todayValue %>">
        </div>

        <div class="form-group">
          <label>Cửa hàng kiểm</label>
          <select id="storeId" class="form-control" style="width: 100%; padding: 8px; margin-top: 5px;">
            <% stores.forEach(s => { %>
              <option value="<%= s._id %>"><%= s.ten_cua_hang %></option>
            <% }) %>
          </select>
        </div>

        <div class="form-group" style="margin-top: 15px;">
          <label>Kho kiểm</label>
          <select id="khoId" class="form-control" style="width: 100%; padding: 8px; margin-top: 5px;" disabled>
            <option value="">Vui lòng chọn cửa hàng trước</option>
          </select>
        </div>

        <div class="form-group" style="margin-top: 15px;">
          <label>Ghi chú</label>
          <textarea id="ghiChu" style="width: 100%; padding: 8px; margin-top: 5px; height: 80px;"></textarea>
        </div>

        <div style="margin-top: 30px; border-top: 1px dashed #ddd; padding-top: 20px;">
          <div style="display: flex; justify-content: space-between; margin-bottom: 10px;">
            <span>Tổng SL thực tế:</span>
            <span id="totalThucTe" style="font-weight: bold;">0</span>
          </div>
          <div style="display: flex; justify-content: space-between;">
            <span>Tổng lệch:</span>
            <span id="totalLech" style="font-weight: bold;">0</span>
          </div>
        </div>

        <button type="button" class="btn-print-ton" onclick="printTonHeThong()">
          <i class="fa-solid fa-print"></i> In phiếu số lượng hiện tại (tồn hệ thống)
        </button>

        <button type="button" class="btn-print-gia-tri" onclick="printGiaTriKho()">
          <i class="fa-solid fa-print"></i> In phiếu giá trị kho
        </button>

        <button class="btn-finish" onclick="saveKiemKho()">
          <i class="fa-solid fa-check-double"></i> HOÀN THÀNH
        </button>
      </div>
    </div>
    </div>

    <% if (typeof copyDraftJson === 'string' && copyDraftJson) { %>
    <script id="copy-draft-embed" type="application/json"><%- copyDraftJson %></script>
    <% } %>
    <%- include('../partials/global-loading') %>
    <script src="/javascripts/global-loading.js"></script>
    <script>
      let copyDraft = null;
      (function() {
        const el = document.getElementById('copy-draft-embed');
        if (el) {
          try { copyDraft = JSON.parse(el.textContent || 'null'); } catch (e) { copyDraft = null; }
        }
      })();
      const copyFromError = <%- JSON.stringify(copyFromError || '') %>;
      let kkItems = [];

      const searchInput = document.getElementById('kkSearch');
      const resultsDiv = document.getElementById('kkResults');
      const storeSelect = document.getElementById('storeId');
      const khoSelect = document.getElementById('khoId');
      const finishButton = document.querySelector('.btn-finish');
      let hangKiemKhoLoadToken = 0;

      function rowKey(item) {
        return String(item.hang_hoa_id || '') + '::' + String(item.lo_hang_id || '') + '::' + String(item.ten_quy_cach || '');
      }

      function formatLotName(item) {
        const ten = String(item.ten_lo || '').trim();
        const ma = String(item.ma_lo || '').trim();
        if (ten) return ten;
        if (ma) return ma;
        if (item.lo_hang_id) return 'Lô không tên';
        return '';
      }

      function formatDate(value) {
        if (!value) return '';
        var date = new Date(value);
        if (isNaN(date.getTime())) return '';
        return date.toLocaleDateString('vi-VN');
      }

      function escapeHtml(value) {
        return String(value || '')
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;');
      }

      function escapeAttr(value) {
        return String(value || '').replace(/\\/g, '\\\\').replace(/'/g, "\\'");
      }

      function formatLotLabel(item) {
        const lotName = formatLotName(item);
        const hsd = formatDate(item.han_su_dung);
        if (!lotName) return hsd ? ('HSD: ' + hsd) : 'Không theo lô';
        return hsd ? (lotName + ' - HSD: ' + hsd) : lotName;
      }

      function buildKiemKhoDisplayGroups(items) {
        const productGroups = [];
        const productIndex = {};

        (items || []).forEach(item => {
          const productId = String(item.hang_hoa_id || '');
          if (!productIndex[productId]) {
            productIndex[productId] = {
              ma_hang: item.ma_hang || '',
              ten_hang: item.ten_hang || '',
              don_vi_tinh: item.don_vi_tinh || '',
              lotGroups: [],
              lotIndex: {}
            };
            productGroups.push(productIndex[productId]);
          }

          const productGroup = productIndex[productId];
          const lotId = item.lo_hang_id ? String(item.lo_hang_id) : 'no-lot';
          if (!productGroup.lotIndex[lotId]) {
            productGroup.lotIndex[lotId] = {
              lot_label: formatLotLabel(item),
              items: []
            };
            productGroup.lotGroups.push(productGroup.lotIndex[lotId]);
          }
          productGroup.lotIndex[lotId].items.push(item);
        });

        return productGroups;
      }

      async function loadKhoByStore() {
        const storeId = storeSelect.value;
        hangKiemKhoLoadToken += 1;
        khoSelect.innerHTML = '<option value="">Chọn kho</option>';
        khoSelect.disabled = true;
        kkItems = [];
        renderKK();

        if (!storeId) return;

        try {
          const res = await fetch('/api/cua-hang/' + encodeURIComponent(storeId) + '/kho');
          const result = await res.json();
          const warehouses = result.success ? (result.data || []) : [];
          khoSelect.innerHTML = '<option value="">Chọn kho</option>' + warehouses.map(k => `<option value="${k._id}">${k.ten_kho || k.ma_kho || ''}</option>`).join('');
          khoSelect.disabled = false;
        } catch (error) {
          khoSelect.innerHTML = '<option value="">Không tải được kho</option>';
        }
      }

      async function loadHangKiemKho() {
        const loadToken = ++hangKiemKhoLoadToken;
        kkItems = [];

        if (!khoSelect.value) {
          renderKK();
          return;
        }

        renderKKLoading();

        try {
          const res = await fetch('/api/kho/' + encodeURIComponent(khoSelect.value) + '/hang-kiem-kho');
          const result = await res.json();
          if (loadToken !== hangKiemKhoLoadToken) return;
          if (!result.success) {
            renderKK();
            alert(result.message || 'Không tải được hàng kiểm kho.');
            return;
          }
          kkItems = (result.data || []).map(row => ({
            key: rowKey(row),
            hang_hoa_id: row.hang_hoa_id,
            lo_hang_id: row.lo_hang_id || null,
            ma_hang: row.ma_hang || '',
            ten_hang: row.ten_hang || '',
            don_vi_tinh: row.don_vi_tinh || '',
            ma_lo: row.ma_lo || '',
            ten_lo: row.ten_lo || '',
            lo_hang_label: row.lo_hang_label || formatLotName(row),
            ten_quy_cach: row.ten_quy_cach || '',
            han_su_dung: row.han_su_dung || '',
            don_gia_von: Number(row.don_gia_von || 0),
            ten_ncc: row.ten_ncc || '---',
            gia_tri_kho: Number(row.gia_tri_kho || 0),
            ton_kho_he_thong: Number(row.ton_kho_he_thong || 0),
            so_luong_thuc_te: Number(row.ton_kho_he_thong || 0),
            nguyen_nhan_lech: ''
          }));
          renderKK();
        } catch (error) {
          if (loadToken !== hangKiemKhoLoadToken) return;
          renderKK();
          alert('Không tải được hàng kiểm kho.');
        }
      }

      function overlayCopyDraftItems() {
        if (!copyDraft || !Array.isArray(copyDraft.items) || !copyDraft.items.length) return;
        const draftMap = new Map(copyDraft.items.map(row => [
          String(row.hang_hoa_id || '') + '::' + String(row.lo_hang_id || '') + '::' + String(row.ten_quy_cach || ''),
          row
        ]));
        kkItems.forEach(item => {
          const draft = draftMap.get(item.key);
          if (!draft) return;
          item.so_luong_thuc_te = Number(draft.so_luong_thuc_te ?? item.so_luong_thuc_te);
          item.nguyen_nhan_lech = draft.nguyen_nhan_lech || '';
        });
        renderKK();
      }

      async function applyCopyDraft() {
        if (!copyDraft) return;
        if (copyDraft.ghi_chu) document.getElementById('ghiChu').value = copyDraft.ghi_chu;
        if (copyDraft.cua_hang_id) storeSelect.value = copyDraft.cua_hang_id;
        await loadKhoByStore();
        if (copyDraft.kho_id) {
          khoSelect.value = copyDraft.kho_id;
          await loadHangKiemKho();
          overlayCopyDraftItems();
        }
      }

      storeSelect.addEventListener('change', loadKhoByStore);
      khoSelect.addEventListener('change', loadHangKiemKho);
      document.addEventListener('DOMContentLoaded', async () => {
        await loadKhoByStore();
        if (copyFromError) alert(copyFromError);
        if (copyDraft) await applyCopyDraft();
      });

      function renderSearchResults() {
        const query = searchInput.value.trim().toLowerCase();
        if (!query) {
          resultsDiv.style.display = 'none';
          return;
        }
        const filtered = kkItems.filter(item =>
          String(item.ten_hang || '').toLowerCase().includes(query) ||
          String(item.ma_hang || '').toLowerCase().includes(query) ||
          String(item.ten_lo || '').toLowerCase().includes(query) ||
          String(item.ma_lo || '').toLowerCase().includes(query)
        ).slice(0, 30);

        resultsDiv.innerHTML = filtered.map(item => `
          <div class="search-item" onclick="focusKKItem('${item.key}')">
            <span>${item.ten_hang} (${item.ma_hang})${formatLotName(item) ? ' - Lô ' + formatLotName(item) : ''}${item.ten_quy_cach ? ' - ' + item.ten_quy_cach : ''}</span>
            <span style="float: right; color: #999;">Tồn: ${item.ton_kho_he_thong}</span>
          </div>
        `).join('') || '<div class="search-item"><span>Không có hàng phù hợp</span></div>';
        resultsDiv.style.display = 'block';
      }

      searchInput.addEventListener('focus', renderSearchResults);
      searchInput.addEventListener('click', renderSearchResults);
      searchInput.addEventListener('input', renderSearchResults);

      function focusKKItem(key) {
        const row = document.querySelector('[data-row-key="' + key + '"]');
        if (row) row.scrollIntoView({ block: 'center', behavior: 'smooth' });
        searchInput.value = '';
        resultsDiv.style.display = 'none';
      }

      function renderKKLoading() {
        const body = document.getElementById('kkBody');
        body.innerHTML = '<div class="kk-list-loading" role="status" aria-live="polite"><i class="fa-solid fa-spinner fa-spin"></i><span>Đang tải danh sách mặt hàng...</span></div>';
        document.getElementById('totalThucTe').innerText = 0;
        document.getElementById('totalLech').innerText = 0;
      }

      function renderKK() {
        const body = document.getElementById('kkBody');
        let totalTT = 0;
        let totalL = 0;
        let stt = 0;

        if (!kkItems.length) {
          body.innerHTML = '<div class="kk-empty">Chọn kho để tải hàng hóa đang có tồn.</div>';
          document.getElementById('totalThucTe').innerText = 0;
          document.getElementById('totalLech').innerText = 0;
          return;
        }

        const productGroups = buildKiemKhoDisplayGroups(kkItems);
        let html = '';

        productGroups.forEach(productGroup => {
          const titleParts = [
            escapeHtml(productGroup.ma_hang),
            escapeHtml(productGroup.ten_hang)
          ].filter(Boolean).join(' - ');
          const dvt = productGroup.don_vi_tinh ? ' (' + escapeHtml(productGroup.don_vi_tinh) + ')' : '';

          html += '<div class="kk-product-group">';
          html += '<div class="lot-group-title">' + (titleParts || '--') + dvt + '</div>';

          productGroup.lotGroups.forEach(lotGroup => {
            const rowCount = lotGroup.items.length;
            html += `
              <table class="kk-table grouped-lot-table">
                <thead>
                  <tr>
                    <th width="40">STT</th>
                    <th width="140">Lô</th>
                    <th width="120">Thuộc tính</th>
                    <th width="100" style="text-align: right;">Hệ thống</th>
                    <th width="100" style="text-align: right;">Thực tế</th>
                    <th width="100" style="text-align: right;">Lệch</th>
                    <th width="220">Nguyên nhân lệch</th>
                  </tr>
                </thead>
                <tbody>
            `;

            lotGroup.items.forEach((item, rowIndex) => {
              const lech = Number(item.so_luong_thuc_te || 0) - Number(item.ton_kho_he_thong || 0);
              totalTT += Number(item.so_luong_thuc_te || 0);
              totalL += lech;
              stt += 1;
              const keyAttr = escapeAttr(item.key);
              const lechClass = lech > 0 ? 'lech-positive' : (lech < 0 ? 'lech-negative' : '');
              const lechText = lech > 0 ? ('+' + lech) : String(lech);
              const reasonPlaceholder = lech !== 0 ? 'Bắt buộc khi lệch' : '';

              html += '<tr data-row-key="' + escapeHtml(item.key) + '">';
              html += '<td>' + stt + '</td>';
              if (rowIndex === 0) {
                html += '<td class="lot-cell" rowspan="' + rowCount + '">' + escapeHtml(lotGroup.lot_label) + '</td>';
              }
              html += '<td class="attr-cell">' + escapeHtml(item.ten_quy_cach || '--') + '</td>';
              html += '<td style="text-align: right;">' + item.ton_kho_he_thong + '</td>';
              html += '<td style="text-align: right;"><input type="number" min="0" class="input-thuc-te" value="' + item.so_luong_thuc_te + '" onchange="updateTT(\'' + keyAttr + '\', this.value)"></td>';
              html += '<td style="text-align: right;" class="' + lechClass + '">' + lechText + '</td>';
              html += '<td><input class="input-thuc-te" style="width: 100%; text-align: left;" value="' + escapeHtml(item.nguyen_nhan_lech || '') + '" placeholder="' + escapeHtml(reasonPlaceholder) + '" onchange="updateReason(\'' + keyAttr + '\', this.value)"></td>';
              html += '</tr>';
            });

            html += '</tbody></table>';
          });

          html += '</div>';
        });

        body.innerHTML = html;
        document.getElementById('totalThucTe').innerText = totalTT;
        document.getElementById('totalLech').innerText = totalL;
      }

      function updateTT(key, val) {
        const item = kkItems.find(i => i.key === key);
        const nextValue = Number(val);
        if (item) item.so_luong_thuc_te = Number.isFinite(nextValue) && nextValue >= 0 ? nextValue : 0;
        renderKK();
      }

      function updateReason(key, val) {
        const item = kkItems.find(i => i.key === key);
        if (item) item.nguyen_nhan_lech = val || '';
      }

      async function printGiaTriKho() {
        if (!khoSelect.value) return alert('Vui lòng chọn kho.');
        if (!kkItems.length) return alert('Không có hàng để in.');
        try {
          const res = await fetch('/kiem-kho/preview-gia-tri-kho', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            credentials: 'same-origin',
            body: JSON.stringify({
              cua_hang_id: document.getElementById('storeId').value,
              kho_id: khoSelect.value,
              ghi_chu: document.getElementById('ghiChu').value,
              items: kkItems.map(item => ({
                ma_hang: item.ma_hang,
                ten_hang: item.ten_hang,
                don_vi_tinh: item.don_vi_tinh,
                ma_lo: item.ma_lo,
                ten_lo: item.ten_lo,
                lo_hang_label: formatLotName(item),
                han_su_dung: item.han_su_dung,
                ten_quy_cach: item.ten_quy_cach,
                ton_kho_he_thong: item.ton_kho_he_thong,
                don_gia_von: item.don_gia_von,
                ten_ncc: item.ten_ncc,
                gia_tri_kho: Number(item.ton_kho_he_thong || 0) * Number(item.don_gia_von || 0)
              }))
            })
          });
          const result = await res.json().catch(() => ({}));
          if (!result.success) return alert(result.message || 'Không tạo được phiếu in.');
          window.open(result.url, '_blank', 'noopener');
        } catch (err) {
          alert('Không kết nối được máy chủ.');
        }
      }

      async function printTonHeThong() {
        if (!khoSelect.value) return alert('Vui lòng chọn kho.');
        if (!kkItems.length) return alert('Không có hàng để in.');
        try {
          const res = await fetch('/kiem-kho/preview-ton-he-thong', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            credentials: 'same-origin',
            body: JSON.stringify({
              cua_hang_id: document.getElementById('storeId').value,
              kho_id: khoSelect.value,
              ghi_chu: document.getElementById('ghiChu').value,
              items: kkItems.map(item => ({
                ma_hang: item.ma_hang,
                ten_hang: item.ten_hang,
                don_vi_tinh: item.don_vi_tinh,
                ma_lo: item.ma_lo,
                ten_lo: item.ten_lo,
                lo_hang_label: formatLotName(item),
                han_su_dung: item.han_su_dung,
                ten_quy_cach: item.ten_quy_cach,
                ton_kho_he_thong: item.ton_kho_he_thong
              }))
            })
          });
          const result = await res.json().catch(() => ({}));
          if (!result.success) return alert(result.message || 'Không tạo được phiếu in.');
          window.open(result.url, '_blank', 'noopener');
        } catch (err) {
          alert('Không kết nối được máy chủ.');
        }
      }

      async function saveKiemKho() {
        if (!document.getElementById('khoId').value) return alert('Vui lòng chọn kho.');
        if (kkItems.length === 0) return alert('Kho không có hàng hóa còn tồn để kiểm.');
        const missingReason = kkItems.find(item => {
          const lech = Number(item.so_luong_thuc_te || 0) - Number(item.ton_kho_he_thong || 0);
          return lech !== 0 && !String(item.nguyen_nhan_lech || '').trim();
        });
        if (missingReason) return alert('Vui lòng nhập nguyên nhân lệch cho hàng hóa có chênh lệch.');

        const data = {
          cua_hang_id: document.getElementById('storeId').value,
          kho_id: document.getElementById('khoId').value,
          ngay_kiem: document.getElementById('ngayKiem').value,
          ghi_chu: document.getElementById('ghiChu').value,
          items: kkItems.map(item => ({
            hang_hoa_id: item.hang_hoa_id,
            lo_hang_id: item.lo_hang_id || null,
            ten_quy_cach: item.ten_quy_cach || '',
            ton_kho_he_thong: item.ton_kho_he_thong,
            so_luong_thuc_te: item.so_luong_thuc_te,
            nguyen_nhan_lech: item.nguyen_nhan_lech || ''
          }))
        };

        const loadingShown = window.showGlobalLoading && window.showGlobalLoading('Đang hoàn thành phiếu kiểm kho...');
        if (loadingShown === false) return;
        if (finishButton) finishButton.disabled = true;

        try {
          const res = await fetch('/kiem-kho', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
          });
          const result = await res.json();
          if (result.success) {
            if (result.print_url) {
              window.open(result.print_url + '?variant=thuc-te', '_blank', 'noopener');
            }
            alert(result.message);
            window.location.href = '/kiem-kho';
          } else {
            if (loadingShown) window.hideGlobalLoading();
            if (finishButton) finishButton.disabled = false;
            alert(result.message || 'Không thể lưu phiếu kiểm kho.');
          }
        } catch (err) {
          if (loadingShown) window.hideGlobalLoading();
          if (finishButton) finishButton.disabled = false;
          alert('Lỗi khi lưu phiếu kiểm kho');
        }
      }
    </script>
  </body>
</html>
