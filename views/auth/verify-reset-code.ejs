<!DOCTYPE html>
<html lang="vi">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Xác nhận mã OTP</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/stylesheets/auth.css">
  </head>
  <body>
    <main class="auth-page">
      <section class="auth-card">
        <div class="auth-brand">
          <div>
            <h1>Xác nhận mã OTP</h1>
            <p>Mã 6 số đã được gửi đến <strong><%= emailMasked || 'email của bạn' %></strong>.</p>
          </div>
        </div>

        <% if (error) { %>
          <div class="auth-alert auth-alert--error"><%= error %></div>
        <% } %>
        <% if (success) { %>
          <div class="auth-alert auth-alert--success"><%= success %></div>
        <% } %>

        <form method="post" action="/verify-reset-code" class="auth-form" data-auth-form>
          <label>
            <span>Mã OTP</span>
            <input class="auth-otp-input" type="text" name="code" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="one-time-code" required autofocus data-otp-input>
          </label>
          <button type="submit" class="auth-primary" data-submit-text="Xác nhận">Xác nhận</button>
        </form>

        <form method="post" action="/resend-reset-code" class="auth-resend-form">
          <button type="submit" class="auth-link-button" data-resend-button data-resend-after="<%= resendAfter ? new Date(resendAfter).toISOString() : '' %>">Gửi lại mã</button>
          <span class="auth-countdown" data-resend-countdown></span>
        </form>

        <p class="auth-switch">
          <a href="/forgot-password">Dùng email khác</a>
        </p>
      </section>
    </main>
    <script src="/javascripts/auth.js"></script>
  </body>
</html>
