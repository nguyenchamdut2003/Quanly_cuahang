<!DOCTYPE html>
<html lang="vi">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= title || 'Đặt lại mật khẩu' %></title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/stylesheets/auth.css">
  </head>
  <body>
    <main class="auth-page">
      <section class="auth-card">
        <div class="auth-brand">
          <div>
            <h1>Đặt lại mật khẩu</h1>
            <p>Mật khẩu mới cần tối thiểu 8 ký tự, có chữ và số.</p>
          </div>
        </div>

        <% if (error) { %>
          <div class="auth-alert auth-alert--error"><%= error %></div>
        <% } %>

        <form method="post" action="/reset-password" class="auth-form" data-auth-form>
          <label>
            <span>Mật khẩu mới</span>
            <span class="auth-password-field">
              <input type="password" name="password" autocomplete="new-password" minlength="8" pattern="(?=.*[A-Za-z])(?=.*\d).{8,}" required data-password-input>
              <button type="button" class="auth-password-toggle" data-password-toggle aria-label="Hiện mật khẩu">
                <i class="fa-solid fa-eye" aria-hidden="true"></i>
              </button>
            </span>
          </label>
          <label>
            <span>Nhập lại mật khẩu</span>
            <span class="auth-password-field">
              <input type="password" name="confirm_password" autocomplete="new-password" minlength="8" pattern="(?=.*[A-Za-z])(?=.*\d).{8,}" required data-password-input>
              <button type="button" class="auth-password-toggle" data-password-toggle aria-label="Hiện mật khẩu">
                <i class="fa-solid fa-eye" aria-hidden="true"></i>
              </button>
            </span>
          </label>
          <button type="submit" class="auth-primary" data-submit-text="Đổi mật khẩu">Đổi mật khẩu</button>
        </form>
      </section>
    </main>
    <script src="/javascripts/auth.js"></script>
  </body>
</html>
