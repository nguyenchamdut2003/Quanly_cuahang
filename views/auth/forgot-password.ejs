<!DOCTYPE html>
<html lang="vi">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= title || 'Quên mật khẩu' %></title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/stylesheets/auth.css">
  </head>
  <body>
    <main class="auth-page">
      <section class="auth-card">
        <div class="auth-brand">
          <div>
            <h1>Quên mật khẩu</h1>
            <p>Nhập email để nhận mã xác nhận đặt lại mật khẩu.</p>
          </div>
        </div>

        <% if (error) { %>
          <div class="auth-alert auth-alert--error"><%= error %></div>
        <% } %>
        <% if (success) { %>
          <div class="auth-alert auth-alert--success"><%= success %></div>
        <% } %>

        <form method="post" action="/forgot-password" class="auth-form" data-auth-form>
          <label>
            <span>Email</span>
            <input type="email" name="email" value="<%= email || '' %>" autocomplete="email" required autofocus>
          </label>
          <button type="submit" class="auth-primary" data-submit-text="Gửi mã">Gửi mã</button>
        </form>

        <p class="auth-switch">
          <a href="/login">Quay lại đăng nhập</a>
        </p>
      </section>
    </main>
    <script src="/javascripts/auth.js"></script>
  </body>
</html>
