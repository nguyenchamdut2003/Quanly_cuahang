<!doctype html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Vật chứa</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
  <link rel="stylesheet" href="/stylesheets/style.css">
  <link rel="stylesheet" href="/stylesheets/responsive.css">
  <style>
    #addVatChuaModalOverlay,
    #importVatChuaModalOverlay {
      z-index: 4000 !important;
    }
    .customer-search i { color: #667085; font-size: 14px; flex: 0 0 auto; }
    #addVatChuaModalOverlay:not(.is-visible),
    #importVatChuaModalOverlay:not(.is-visible) {
      display: none !important;
      pointer-events: none !important;
      visibility: hidden !important;
    }
    #addVatChuaModalOverlay.is-visible,
    #importVatChuaModalOverlay.is-visible {
      display: flex !important;
      pointer-events: auto !important;
      visibility: visible !important;
    }
    .vc-payment-block { border-top: 1px solid #e5e9ee; margin-top: 12px; padding-top: 10px; }
    .vc-payment-title { font-size: 12px; font-weight: 800; color: #344054; text-transform: uppercase; letter-spacing: .02em; margin-bottom: 8px; }
    .vc-summary-line { display: grid; grid-template-columns: 1fr 172px; align-items: center; min-height: 40px; font-size: 13px; color: #111827; gap: 8px; }
    .vc-summary-line strong { font-weight: 700; }
    .vc-summary-line .num { text-align: right; color: #006dff; font-weight: 700; }
    .vc-paid-combo { display: flex; gap: 6px; justify-content: flex-end; }
    .vc-discount-input { width: 100%; height: 30px; border: 1px solid #cfd8e3; border-radius: 7px; text-align: right; padding: 0 10px; font-size: 13px; }
    .vc-side-input { width: 100%; height: 30px; border: 1px solid #cfd8e3; border-radius: 7px; padding: 0 8px; font-size: 13px; }
    .vc-side-input.field-invalid { border-color: #d92d20; box-shadow: 0 0 0 1px #fda29b; }
    .vc-btn-pay-all { height: 30px; border: 1px solid #0070f4; background: #fff; color: #0070f4; border-radius: 7px; padding: 0 10px; font-size: 12px; font-weight: 600; cursor: pointer; white-space: nowrap; }
    .vc-form-error { display: none; margin: 8px 0 0; padding: 8px 10px; border: 1px solid #fda29b; background: #fff1f3; color: #b42318; border-radius: 7px; font-size: 13px; line-height: 1.35; }
    #vcDocumentModalOverlay { z-index: 4100 !important; }
    #vcDocumentModalOverlay:not(.is-visible) {
      display: none !important;
      pointer-events: none !important;
      visibility: hidden !important;
    }
    #vcDocumentModalOverlay.is-visible {
      display: flex !important;
      pointer-events: auto !important;
      visibility: visible !important;
    }
    #vcDocumentModalOverlay .modal-content { width: min(920px, 96%); max-height: 88vh; }
    .vc-doc-open-btn {
      background: none;
      border: none;
      padding: 0;
      font: inherit;
      font-weight: 700;
      cursor: pointer;
      color: #006dff;
      text-align: left;
    }
    .vc-doc-open-btn:hover { text-decoration: underline; }
    .vc-doc-action-btn { border: 1px solid #cfd8e3; background: #fff; color: #344054; min-height: 30px; border-radius: 6px; padding: 0 9px; font-size: 12px; font-weight: 700; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; white-space: nowrap; }
    .vc-doc-action-btn.primary { border-color: #0070f4; color: #006dff; }
    .vc-doc-action-btn.primary:hover { background: #eff6ff; }
    .vc-doc-action-btn.danger { border-color: #fda29b; color: #b42318; }
    .vc-doc-action-btn.danger:hover { background: #fff1f3; }
    .vc-doc-action-menu { position: relative; display: inline-flex; justify-content: flex-end; width: 100%; }
    .vc-doc-more-btn { width: 32px; height: 32px; border: 1px solid #cfd8e3; background: #fff; color: #344054; border-radius: 6px; display: inline-flex; align-items: center; justify-content: center; cursor: pointer; }
    .vc-doc-more-btn:hover,
    .vc-doc-action-menu.is-open .vc-doc-more-btn { border-color: #0070f4; color: #006dff; background: #eff6ff; }
    .vc-doc-action-dropdown { position: fixed; top: 0; left: 0; z-index: 4300; display: none; min-width: 160px; padding: 6px; border: 1px solid #d9e2ec; border-radius: 7px; background: #fff; box-shadow: 0 12px 24px rgba(15, 23, 42, .16); }
    .vc-doc-action-menu.is-open .vc-doc-action-dropdown { display: block; }
    .vc-doc-menu-item { width: 100%; min-height: 34px; border: 0; border-radius: 5px; background: transparent; color: #1f2937; padding: 0 9px; display: flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 700; text-align: left; cursor: pointer; white-space: nowrap; }
    .vc-doc-menu-item:hover { background: #f1f5f9; color: #006dff; }
    .vc-doc-menu-item.danger { color: #b42318; }
    .vc-doc-menu-item.danger:hover { background: #fff1f3; color: #b42318; }
    .vc-doc-modal-grid { margin-bottom: 12px; }
    .vc-doc-modal-table-wrap { margin-top: 4px; }
    .vc-doc-modal-loading,
    .vc-doc-modal-error { padding: 20px 4px; color: #64748b; font-size: 14px; }
    .vc-doc-modal-error { color: #b42318; }
    #addVatChuaModalOverlay .product-create-modal,
    #importVatChuaModalOverlay .product-create-modal { width: min(640px, 96vw); }
    .vc-status-tag {
      display: inline-flex;
      align-items: center;
      height: 24px;
      padding: 0 8px;
      border-radius: 4px;
      font-size: 12px;
      font-weight: 700;
      white-space: nowrap;
    }
    .vc-status-tag.is-active { background: #ecfdf3; color: #047857; }
    .vc-status-tag.is-inactive { background: #f1f5f9; color: #64748b; }
    .vc-money-suffix { margin-left: 4px; color: #667085; font-size: 12px; font-weight: 600; }
    .vc-stock-modal-table { width: 100%; border-collapse: collapse; table-layout: fixed; }
    .vc-stock-modal-table th { height: 34px; background: #f3f6fa; color: #1f2937; font-size: 12px; text-align: left; padding: 0 8px; border-bottom: 1px solid #d9e2ec; }
    .vc-stock-modal-table td { height: 42px; border-bottom: 1px solid #eef2f6; padding: 6px 8px; font-size: 13px; }
    .vc-stock-modal-table input { width: 100%; height: 32px; border: 1px solid #cfd8e3; border-radius: 7px; padding: 0 8px; text-align: right; }
    .vc-stock-modal-table .text-right { text-align: right; }
    .vc-stock-modal-summary { margin-top: 10px; padding: 10px 12px; border: 1px solid #bfdbfe; background: #eff6ff; border-radius: 8px; color: #0f172a; font-weight: 800; }
    #vcImportTrashModalOverlay { z-index: 4200 !important; }
    #vcImportTrashModalOverlay:not(.is-visible) { display: none !important; pointer-events: none !important; visibility: hidden !important; }
    #vcImportTrashModalOverlay.is-visible { display: flex !important; pointer-events: auto !important; visibility: visible !important; }
    #vcImportTrashModalOverlay .modal-content { width: min(760px, 96%); max-height: 88vh; }
    #vcImportEditModalOverlay { z-index: 4210 !important; }
    #vcImportEditModalOverlay:not(.is-visible) { display: none !important; pointer-events: none !important; visibility: hidden !important; }
    #vcImportEditModalOverlay.is-visible { display: flex !important; pointer-events: auto !important; visibility: visible !important; }
    #vcImportEditModalOverlay .modal-content { width: min(720px, 96%); max-height: 90vh; }
    #vcImportReturnModalOverlay { z-index: 4220 !important; }
    #vcImportReturnModalOverlay:not(.is-visible) { display: none !important; pointer-events: none !important; visibility: hidden !important; }
    #vcImportReturnModalOverlay.is-visible { display: flex !important; pointer-events: auto !important; visibility: visible !important; }
    #vcImportReturnModalOverlay .modal-content { width: min(620px, 96%); max-height: 88vh; }
    .vc-trash-desc { margin: 0 0 12px; color: #475467; font-size: 13px; line-height: 1.45; }
    .vc-trash-alert { border-radius: 8px; padding: 10px 12px; font-size: 13px; line-height: 1.45; margin-bottom: 10px; }
    .vc-trash-alert.is-warn { border: 1px solid #fedf89; background: #fffaeb; color: #93370d; }
    .vc-trash-alert.is-error { border: 1px solid #fecdca; background: #fffbfa; color: #b42318; }
    .vc-trash-list { margin: 0 0 12px; padding: 0; list-style: none; border: 1px solid #e5e9ee; border-radius: 8px; overflow: hidden; }
    .vc-trash-list li { display: flex; justify-content: space-between; gap: 10px; padding: 9px 12px; border-bottom: 1px solid #eef2f6; font-size: 13px; }
    .vc-trash-list li:last-child { border-bottom: 0; }
    .vc-trash-groups { margin: 0; padding-left: 18px; color: #344054; font-size: 13px; }
    .vc-trash-loading { text-align: center; padding: 24px 8px; color: #667085; font-size: 13px; }
    .vc-documents-wrap { width: 100%; max-width: 100%; overflow-x: auto !important; overflow-y: hidden; padding-bottom: 8px; scrollbar-gutter: stable; }
    .vc-documents-table { table-layout: fixed; width: 1250px; min-width: 1250px; }
    .vc-documents-table th,
    .vc-documents-table td { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .vc-documents-table td > a,
    .vc-documents-table td > button:not(.vc-doc-action-btn),
    .vc-documents-table td > strong { max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; vertical-align: middle; }
    .vc-documents-table td > button:not(.vc-doc-action-btn) { display: inline-block; }
    .vc-documents-table td > a,
    .vc-documents-table td > strong { display: inline-block; }
    .vc-documents-table th:nth-child(1) { width: 132px; }
    .vc-documents-table th:nth-child(2) { width: 126px; }
    .vc-documents-table th:nth-child(3) { width: 104px; }
    .vc-documents-table th:nth-child(4) { width: 150px; }
    .vc-documents-table th:nth-child(5) { width: 136px; }
    .vc-documents-table th:nth-child(6) { width: 86px; }
    .vc-documents-table th:nth-child(7) { width: 112px; }
    .vc-documents-table th:nth-child(8) { width: 130px; }
    .vc-documents-table th:nth-child(9) { width: 142px; }
    .vc-documents-table th:nth-child(10) { width: 128px; }
    .vc-documents-table .vc-doc-actions-cell { overflow: visible; white-space: normal; }
    .vat-chua-pagination{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:12px 14px;border-top:1px solid #e5e7eb;background:#fff;color:#475467;font-size:14px}
    .vat-chua-pagination__actions{display:flex;align-items:center;gap:6px;flex-wrap:wrap}
    .vat-chua-page-link{min-width:34px;height:34px;border:1px solid #d0d5dd;border-radius:6px;background:#fff;color:#344054;text-decoration:none;display:inline-flex;align-items:center;justify-content:center;padding:0 10px;font-weight:700}
    .vat-chua-page-link.is-active{background:#0070f4;border-color:#0070f4;color:#fff}
    .vat-chua-page-link.is-disabled{pointer-events:none;opacity:.45}
    table[data-kv-master="vat-chua"] .product-detail-row > td {
      max-width: calc(100vw - 300px);
      overflow: hidden;
    }
    table[data-kv-master="vat-chua"] .product-detail {
      width: 100%;
      max-width: calc(100vw - 300px);
      min-width: 0;
      overflow: hidden;
    }
    table[data-kv-master="vat-chua"] .product-detail-body,
    table[data-kv-master="vat-chua"] .detail-pane {
      min-width: 0;
      max-width: 100%;
      overflow: hidden;
    }
    table[data-kv-master="vat-chua"] .vc-documents-wrap {
      display: block;
      width: 100%;
      max-width: 100%;
      overflow-x: scroll !important;
      overflow-y: hidden;
    }
    @media (max-width: 900px) {
      .customer-toolbar { flex-wrap: wrap; }
      .customer-toolbar-actions { width: 100%; justify-content: flex-end; }
      .vc-summary-line { grid-template-columns: 1fr; gap: 4px; }
      .vc-summary-line .num,
      .vc-paid-combo,
      .vc-side-input { justify-self: stretch; }

      /* Vật chứa — mobile layout (desktop giữ nguyên) */
      main.customer-page.admin-shell {
        width: 100% !important;
        max-width: 100% !important;
        padding: 8px !important;
      }
      main.customer-page .customer-shell {
        display: flex !important;
        flex-direction: column !important;
        min-height: 0 !important;
        grid-template-columns: none !important;
      }
      main.customer-page .customer-filter {
        width: 100%;
        padding: 12px;
        border-right: 0;
        border-bottom: 1px solid #e2e8f0;
      }
      main.customer-page .customer-filter-section {
        padding-bottom: 10px;
        margin-bottom: 10px;
      }
      main.customer-page .customer-filter form {
        gap: 6px;
      }
      main.customer-page .pill-row {
        flex-direction: column;
        align-items: stretch;
      }
      main.customer-page .pill-btn {
        width: 100%;
        min-height: 36px;
      }
      main.customer-page .customer-content {
        width: 100%;
        min-width: 0;
        padding: 10px 0 20px;
      }
      main.customer-page .customer-toolbar {
        flex-direction: column;
        align-items: stretch;
        gap: 10px;
      }
      main.customer-page .customer-search {
        width: 100% !important;
        max-width: none;
      }
      main.customer-page .customer-toolbar-actions {
        width: 100%;
        flex-wrap: wrap;
        justify-content: flex-start;
        gap: 8px;
      }
      main.customer-page .customer-toolbar-actions .btn {
        flex: 1 1 calc(50% - 4px);
        min-width: 0;
      }
      main.customer-page .customer-table-wrap {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
      }
      main.customer-page .custom-date-range {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>
<body class="admin-body">
  <%- include('../partials/header', { activeMenu: activeMenu, user: user }) %>

  <main class="admin-shell customer-page">
    <%
      function buildVatChuaPageUrl(pageNumber) {
        var parts = [];
        if (filterQueryString) parts.push(filterQueryString);
        if (pageNumber > 1) parts.push('page=' + encodeURIComponent(pageNumber));
        return '/vat-chua' + (parts.length ? '?' + parts.join('&') : '');
      }
    %>
    <% const vcFlash = typeof flash !== 'undefined' ? flash : {}; %>
    <% const vcFlashForGeneric = Object.assign({}, vcFlash); %>
    <% if (['created', 'imported', 'deleted', 'import_deleted', 'import_updated', 'returned', 'stocktake', 'destroyed'].indexOf(String(vcFlash.success || '')) >= 0) { delete vcFlashForGeneric.success; } %>
    <% if (['missing_store', 'missing_name', 'duplicate_code', 'no_selection', 'import_failed'].indexOf(String(vcFlash.error || '')) >= 0) { delete vcFlashForGeneric.error; } %>
    <%- include('../partials/flash-message', { flash: vcFlashForGeneric }) %>
    <% if (vcFlash.error === 'missing_store') { %>
      <div class="flash-message flash-error">Chưa chọn cửa hàng làm việc. Vui lòng chọn cửa hàng ở góc phải trên.</div>
    <% } else if (vcFlash.error === 'missing_name') { %>
      <div class="flash-message flash-error">Vui lòng nhập tên vật chứa.</div>
    <% } else if (vcFlash.error === 'duplicate_code') { %>
      <div class="flash-message flash-error">Mã vật chứa đã tồn tại. Vui lòng thử lại.</div>
    <% } else if (vcFlash.error === 'no_selection') { %>
      <div class="flash-message flash-error">Vui lòng chọn ít nhất một vật chứa.</div>
    <% } else if (vcFlash.error === 'import_failed') { %>
      <div class="flash-message flash-error">Nhập vật chứa thất bại. Vui lòng kiểm tra lại thông tin.</div>
    <% } %>
    <% if (vcFlash.success === 'created') { %>
      <div class="flash-message flash-success">Đã tạo vật chứa mới.</div>
    <% } else if (vcFlash.success === 'imported') { %>
      <div class="flash-message flash-success">Đã nhập vật chứa thành công.</div>
    <% } else if (vcFlash.success === 'deleted') { %>
      <div class="flash-message flash-success">Đã ngừng sử dụng các vật chứa đã chọn.</div>
    <% } else if (vcFlash.success === 'import_deleted') { %>
      <div class="flash-message flash-success">Đã đưa phiếu nhập vật chứa vào thùng rác.</div>
    <% } else if (vcFlash.success === 'import_updated') { %>
      <div class="flash-message flash-success">Đã cập nhật phiếu nhập vật chứa.</div>
    <% } else if (vcFlash.success === 'returned') { %>
      <div class="flash-message flash-success">Đã trả vật chứa thành công.</div>
    <% } else if (vcFlash.success === 'stocktake') { %>
      <div class="flash-message flash-success">Đã kiểm kho và cân bằng tồn vật chứa.</div>
    <% } else if (vcFlash.success === 'destroyed') { %>
      <div class="flash-message flash-success">Đã xuất hủy vật chứa.</div>
    <% } %>

    <div class="customer-shell">
      <aside class="customer-filter">
        <h2>Vật chứa</h2>
        <form method="get" action="/vat-chua" id="vatChuaFilterForm">
          <section class="customer-filter-section">
            <h4>Tồn kho</h4>
            <div class="range-stack">
              <div class="range-row"><span>Từ</span><input type="number" min="0" name="stockFrom" value="<%= filter.stockFrom || '' %>" placeholder="Nhập giá trị"></div>
              <div class="range-row"><span>Đến</span><input type="number" min="0" name="stockTo" value="<%= filter.stockTo || '' %>" placeholder="Nhập giá trị"></div>
            </div>
          </section>

          <section class="customer-filter-section">
            <h4>Thời gian tạo</h4>
            <label class="filter-radio-row">
              <input type="radio" name="created" value="all" <%= filter.created !== 'custom' ? 'checked' : '' %>>
              <span>Toàn thời gian</span>
            </label>
            <label class="filter-radio-row">
              <input type="radio" name="created" value="custom" <%= filter.created === 'custom' ? 'checked' : '' %>>
              <span>Tùy chỉnh</span>
            </label>
            <div class="custom-date-range <%= filter.created === 'custom' ? 'is-visible' : '' %>" id="customDateRange">
              <label><span>Từ ngày</span><input type="date" name="createdFrom" value="<%= filter.createdFrom || '' %>"></label>
              <label><span>Đến ngày</span><input type="date" name="createdTo" value="<%= filter.createdTo || '' %>"></label>
            </div>
          </section>

          <section class="customer-filter-section">
            <h4>Trạng thái</h4>
            <div class="pill-row">
              <button class="pill-btn <%= filter.status === 'all' ? 'is-active' : '' %>" type="button" data-target-input="vatChuaStatusInput" data-value="all">Tất cả</button>
              <button class="pill-btn <%= (filter.status === 'active' || !filter.status) ? 'is-active' : '' %>" type="button" data-target-input="vatChuaStatusInput" data-value="active">Đang sử dụng</button>
              <button class="pill-btn <%= filter.status === 'inactive' ? 'is-active' : '' %>" type="button" data-target-input="vatChuaStatusInput" data-value="inactive">Ngừng sử dụng</button>
            </div>
            <input type="hidden" id="vatChuaStatusInput" name="status" value="<%= filter.status || 'active' %>">
            <div class="customer-filter-actions">
              <button class="btn btn-primary" type="submit">Áp dụng lọc</button>
              <a class="btn btn-light" href="/vat-chua">Xóa lọc</a>
            </div>
          </section>
        </form>
      </aside>

      <section class="customer-content">
        <% if (missingStore) { %>
          <div class="flash-message flash-error">Chưa chọn cửa hàng làm việc. Vui lòng chọn cửa hàng ở góc phải trên.</div>
        <% } %>

        <div class="customer-toolbar">
          <div class="customer-search">
            <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
            <input type="search" name="keyword" form="vatChuaFilterForm" value="<%= filter.keyword || '' %>" placeholder="Theo mã, tên vật chứa">
          </div>
          <div class="customer-toolbar-actions">
            <button class="btn btn-light" type="button" id="openVatChuaStocktakeModal" <%= missingStore ? 'disabled' : '' %>><i class="fa-solid fa-clipboard-check"></i> Kiểm kho</button>
            <button class="btn btn-light" type="button" id="openVatChuaDestroyModal" <%= missingStore ? 'disabled' : '' %>><i class="fa-solid fa-trash-arrow-up"></i> Xuất hủy</button>
            <button class="btn btn-primary" type="button" id="openAddVatChuaModal" <%= missingStore ? 'disabled' : '' %>>+ Tạo mới</button>
            <button class="btn btn-light" type="button" id="openImportVatChuaModal" <%= missingStore ? 'disabled' : '' %>>Nhập vật chứa</button>
            <button class="btn btn-danger" type="submit" form="bulkDeleteVatChuaForm" onclick="return confirm('Ngừng sử dụng các vật chứa đã chọn?')">Ngừng sử dụng</button>
          </div>
        </div>

        <div class="customer-table-wrap">
            <table class="admin-table customer-table" data-kv-master="vat-chua">
              <thead>
                <tr>
                  <th class="check-cell"><input id="selectAllVatChua" type="checkbox" aria-label="Chọn tất cả"></th>
                  <th>Mã vật chứa</th>
                  <th>Tên vật chứa</th>
                  <th class="text-right">Giá vốn</th>
                  <th class="text-right">Tồn kho</th>
                  <th>Trạng thái</th>
                  <th>Thời gian tạo</th>
                </tr>
              </thead>
              <tbody>
                <% if (!items || items.length === 0) { %>
                  <tr>
                    <td colspan="7" class="empty-cell">Không có vật chứa phù hợp với bộ lọc.</td>
                  </tr>
                <% } %>
                <% var listBase = buildVatChuaPageUrl(pagination ? pagination.page : 1); %>
                <% (items || []).forEach(function(item) { %>
                  <tr data-kv-detail-id="<%= item._id %>" data-vc-row data-vc-id="<%= item._id %>" data-vc-code="<%= item.ma_vat_chua || '' %>" data-vc-name="<%= item.ten_vat_chua || '' %>" data-vc-stock="<%= Number(item.so_luong_ton || 0) %>" data-vc-cost="<%= Number(item.gia_von_trung_binh || 0) %>" data-vc-active="<%= item.trang_thai === 'active' ? '1' : '0' %>">
                    <td class="check-cell"><input class="vat-chua-checkbox" type="checkbox" name="ids" value="<%= item._id %>" form="bulkDeleteVatChuaForm" aria-label="Chọn vật chứa"></td>
                    <td><a class="table-code-link kv-detail-code-link" href="<%= listBase %>"><%= item.ma_vat_chua || '---' %></a></td>
                    <td><strong><a class="table-code-link kv-detail-code-link" href="<%= listBase %>"><%= item.ten_vat_chua || '---' %></a></strong></td>
                    <td class="text-right"><%= Number(item.gia_von_trung_binh || 0).toLocaleString('vi-VN') %></td>
                    <td class="text-right"><%= Number(item.so_luong_ton || 0).toLocaleString('vi-VN') %></td>
                    <td>
                      <% if (item.trang_thai === 'inactive') { %>
                        <span class="vc-status-tag is-inactive">Ngừng sử dụng</span>
                      <% } else { %>
                        <span class="vc-status-tag is-active">Đang sử dụng</span>
                      <% } %>
                    </td>
                    <td><%= formatDate(item.created_at) %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          <% if (pagination && pagination.totalPages > 1) { %>
            <div class="vat-chua-pagination">
              <div>Hiển thị <strong><%= pagination.from %>-<%= pagination.to %></strong> / <strong><%= pagination.total %></strong> vật chứa</div>
              <div class="vat-chua-pagination__actions" aria-label="Phân trang vật chứa">
                <a class="vat-chua-page-link <%= pagination.page <= 1 ? 'is-disabled' : '' %>" href="<%= buildVatChuaPageUrl(Math.max(1, pagination.page - 1)) %>">‹</a>
                <% for (var pageNumber = 1; pageNumber <= pagination.totalPages; pageNumber++) { %>
                  <a class="vat-chua-page-link <%= pageNumber === pagination.page ? 'is-active' : '' %>" href="<%= buildVatChuaPageUrl(pageNumber) %>"><%= pageNumber %></a>
                <% } %>
                <a class="vat-chua-page-link <%= pagination.page >= pagination.totalPages ? 'is-disabled' : '' %>" href="<%= buildVatChuaPageUrl(Math.min(pagination.totalPages, pagination.page + 1)) %>">›</a>
              </div>
            </div>
          <% } else if (pagination) { %>
            <div class="vat-chua-pagination">
              <div>Hiển thị <strong><%= pagination.from %>-<%= pagination.to %></strong> / <strong><%= pagination.total %></strong> vật chứa</div>
            </div>
          <% } %>
          <form id="bulkDeleteVatChuaForm" method="post" action="/vat-chua/delete-selected" style="display:none" aria-hidden="true"></form>
        </div>
      </section>
    </div>

