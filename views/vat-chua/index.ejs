      function refreshStocktakeSummary() {
        var lines = Array.prototype.slice.call(document.querySelectorAll('[data-vc-stocktake-line]'));
        var inc = 0;
        var dec = 0;
        lines.forEach(function(line) {
          var stock = Math.max(0, Number(line.dataset.stock || 0));
          var actual = Math.max(0, Math.floor(Number(line.querySelector('[data-actual]')?.value || 0)));
          var diff = actual - stock;
          var diffEl = line.querySelector('[data-diff]');
          if (diffEl) diffEl.textContent = diff > 0 ? ('+' + fmt(diff)) : fmt(diff);
          if (diff > 0) inc += diff;
          if (diff < 0) dec += Math.abs(diff);
        });
        if (stocktakeSummary) {
          stocktakeSummary.textContent = (inc || dec)
            ? ('Lệch tăng: ' + fmt(inc) + ' | Lệch giảm: ' + fmt(dec))
            : 'Chưa có chênh lệch';
        }
      }
