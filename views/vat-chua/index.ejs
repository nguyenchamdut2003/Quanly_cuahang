      async function openEditImportModal(id) {
        if (!editImportOverlay || !id) return;
        showEditImportError('');
        if (editImportSave) editImportSave.disabled = true;
        if (editImportId) editImportId.value = id;
        editImportOverlay.classList.add('is-visible');
        try {
          await ensureEditPaymentCashBooks();
          var res = await fetch('/vat-chua/nhap/' + encodeURIComponent(id) + '/edit', {
            credentials: 'same-origin',
            headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' }
          });
          var json = await res.json();
          if (!res.ok || !json || !json.success) throw new Error((json && json.message) || 'Không tải được phiếu nhập vật chứa.');
          var row = json.data || {};
          if (editImportSupplier) editImportSupplier.value = row.nha_cung_cap_id || '';
          if (editImportVatChua) editImportVatChua.value = row.vat_chua_id || '';
          if (editImportQty) editImportQty.value = row.so_luong || '';
          if (editImportGiaVon) editImportGiaVon.value = row.gia_von ? fmt(row.gia_von) : '';
          if (editImportNote) editImportNote.value = row.ghi_chu || '';
          var payment = row.payment || {};
          if (editImportCash) editImportCash.value = fmt(payment.tien_mat || 0);
          if (editImportTransfer) editImportTransfer.value = fmt(payment.chuyen_khoan || 0);
          if (editImportCashBook) editImportCashBook.value = payment.so_quy_tien_mat_id || '';
          if (editImportBankBook) editImportBankBook.value = payment.so_quy_chuyen_khoan_id || '';
          renderEditImportPaymentSummary();
          if (editImportSave) editImportSave.disabled = false;
        } catch (error) {
          showEditImportError(error && error.message ? error.message : 'Không tải được phiếu nhập vật chứa.');
        }
      }

      async function submitEditImport() {
        renderEditImportPaymentSummary();
        if (!validateEditImport()) return;
        var id = String(editImportId ? editImportId.value : '').trim();
        if (!id) return;
        if (editImportSave) editImportSave.disabled = true;
        var payload = {
          nha_cung_cap_id: editImportSupplier ? editImportSupplier.value : '',
          vat_chua_id: editImportVatChua ? editImportVatChua.value : '',
          so_luong: editImportQty ? editImportQty.value : '',
          gia_von: String(numeric(editImportGiaVon ? editImportGiaVon.value : 0)),
          ghi_chu: editImportNote ? editImportNote.value : '',
          payment_v2: '1',
          chi_tiet_thanh_toan: {
            tien_mat: numeric(editImportCash ? editImportCash.value : 0),
            so_quy_tien_mat_id: editImportCashBook ? editImportCashBook.value : '',
            chuyen_khoan: numeric(editImportTransfer ? editImportTransfer.value : 0),
            so_quy_chuyen_khoan_id: editImportBankBook ? editImportBankBook.value : '',
            tien_tra_khach: 0
          }
        };
        try {
          var res = await fetch('/vat-chua/nhap/' + encodeURIComponent(id) + '/edit', {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
            body: JSON.stringify(payload)
          });
          var json = await res.json();
          if (!res.ok || !json || !json.success) throw new Error((json && json.message) || 'Không cập nhật được phiếu nhập vật chứa.');
          window.location.href = '/vat-chua?success=import_updated&nhap_vat_chua=' + encodeURIComponent(id);
        } catch (error) {
          showEditImportError(error && error.message ? error.message : 'Không cập nhật được phiếu nhập vật chứa.');
          if (editImportSave) editImportSave.disabled = false;
        }
      }

