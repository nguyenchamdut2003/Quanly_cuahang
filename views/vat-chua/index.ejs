      function getReturnImportTotal() {
        var qty = Math.max(0, Math.floor(Number(returnImportQty ? returnImportQty.value : 0) || 0));
        var price = numeric(returnImportPrice ? returnImportPrice.value : 0);
        return Math.round(qty * price);
      }
      function renderReturnImportSummary() {
        var total = getReturnImportTotal();
        if (returnImportTotal) returnImportTotal.textContent = fmtMoney(total);
        var tienMat = numeric(returnImportCash ? returnImportCash.value : 0);
        var chuyenKhoan = numeric(returnImportTransfer ? returnImportTransfer.value : 0);
        if (tienMat + chuyenKhoan > total && total > 0) {
          var overflow = tienMat + chuyenKhoan - total;
          if (chuyenKhoan >= overflow) chuyenKhoan -= overflow;
          else {
            tienMat = Math.max(0, tienMat - (overflow - chuyenKhoan));
            chuyenKhoan = 0;
          }
        }
        if (returnImportCash) returnImportCash.value = fmt(tienMat);
        if (returnImportTransfer) returnImportTransfer.value = fmt(chuyenKhoan);
        var cashRequired = tienMat > 0;
        var bankRequired = chuyenKhoan > 0;
        if (returnImportCashBook) {
          returnImportCashBook.disabled = !cashRequired;
          if (!cashRequired) returnImportCashBook.value = '';
          if (cashRequired && !returnImportCashBook.value) returnImportCashBook.value = autoSelectCashBook(cashBookOptions);
          returnImportCashBook.classList.toggle('field-invalid', cashRequired && !String(returnImportCashBook.value || '').trim());
        }
        if (returnImportBankBook) {
          returnImportBankBook.disabled = !bankRequired;
          if (!bankRequired) returnImportBankBook.value = '';
          if (bankRequired && !returnImportBankBook.value) returnImportBankBook.value = autoSelectCashBook(bankBookOptions);
          returnImportBankBook.classList.toggle('field-invalid', bankRequired && !String(returnImportBankBook.value || '').trim());
        }
        if (returnImportCashBookRequired) returnImportCashBookRequired.style.display = cashRequired ? 'inline' : 'none';
        if (returnImportBankRequired) returnImportBankRequired.style.display = bankRequired ? 'inline' : 'none';
        if (returnImportDebt) returnImportDebt.textContent = fmtMoney(Math.max(total - tienMat - chuyenKhoan, 0));
      }
      function validateImportPayment() {
        showImportPaymentError('');
        var grandTotal = getImportGrandTotal();
        if (grandTotal <= 0) {
          showImportPaymentError('Vui lòng nhập giá vốn và số lượng hợp lệ.');
          return false;
        }
        var tienMat = numeric(importPaymentCash ? importPaymentCash.value : 0);
        var chuyenKhoan = numeric(importPaymentTransfer ? importPaymentTransfer.value : 0);
        var daTra = tienMat + chuyenKhoan;
        if (daTra > grandTotal) {
          showImportPaymentError('Số tiền thanh toán không được vượt tổng tiền.');
          return false;
        }
        if (tienMat > 0 && !String(importCashBookId ? importCashBookId.value : '').trim()) {
          showImportPaymentError('Vui lòng chọn sổ tiền mặt.');
          if (importCashBookId) importCashBookId.focus();
          return false;
        }
        if (chuyenKhoan > 0 && !String(importBankBookId ? importBankBookId.value : '').trim()) {
          showImportPaymentError('Vui lòng chọn tài khoản chuyển khoản.');
          if (importBankBookId) importBankBookId.focus();
          return false;
        }
        return true;
      }
      function validateEditImport() {
        showEditImportError('');
        var grandTotal = getEditImportGrandTotal();
        if (!String(editImportSupplier ? editImportSupplier.value : '').trim()) {
          showEditImportError('Vui lòng chọn nhà cung cấp.');
          if (editImportSupplier) editImportSupplier.focus();
          return false;
        }
        if (!String(editImportVatChua ? editImportVatChua.value : '').trim()) {
          showEditImportError('Vui lòng chọn vật chứa.');
          if (editImportVatChua) editImportVatChua.focus();
          return false;
        }
        if (grandTotal <= 0) {
          showEditImportError('Vui lòng nhập số lượng và giá vốn hợp lệ.');
          return false;
        }
        var tienMat = numeric(editImportCash ? editImportCash.value : 0);
        var chuyenKhoan = numeric(editImportTransfer ? editImportTransfer.value : 0);
        if (tienMat + chuyenKhoan > grandTotal) {
          showEditImportError('Số tiền thanh toán không được vượt tổng tiền.');
          return false;
        }
        if (tienMat > 0 && !String(editImportCashBook ? editImportCashBook.value : '').trim()) {
          showEditImportError('Vui lòng chọn sổ tiền mặt.');
          if (editImportCashBook) editImportCashBook.focus();
          return false;
        }
        if (chuyenKhoan > 0 && !String(editImportBankBook ? editImportBankBook.value : '').trim()) {
          showEditImportError('Vui lòng chọn tài khoản chuyển khoản.');
          if (editImportBankBook) editImportBankBook.focus();
          return false;
        }
        return true;
      }

