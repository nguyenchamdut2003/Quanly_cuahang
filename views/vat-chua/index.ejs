      function renderVcImportTrashPreview(preview) {
        if (!vcImportTrashBody) return;
        var items = Array.isArray(preview && preview.items) ? preview.items : [];
        var groups = Array.isArray(preview && preview.aggregate_groups) ? preview.aggregate_groups : [];
        if (vcImportTrashConfirm) vcImportTrashConfirm.disabled = !(preview && preview.can_proceed);
        var html = '<p class="vc-trash-desc">Phiếu nhập vật chứa sẽ được đưa vào thùng rác. Tồn vật chứa được trừ lại và phiếu chi liên quan trong sổ quỹ sẽ bị đưa vào thùng rác cùng phiếu.</p>';
        items.forEach(function(item) {
          if (!item.can_trash && item.block_reason) {
            html += '<div class="vc-trash-alert is-error">' + escapeHtml(item.ma_nhap_vat_chua || item.nhap_vat_chua_id) + ': ' + escapeHtml(item.block_reason) + '</div>';
          }
          (item.warnings || []).forEach(function(warn) {
            html += '<div class="vc-trash-alert is-warn">' + escapeHtml(item.ma_nhap_vat_chua || '') + (item.ma_nhap_vat_chua ? ' - ' : '') + escapeHtml(warn) + '</div>';
          });
        });
        html += '<ul class="vc-trash-list">' + items.map(function(item) {
          var status = item.can_trash ? 'Có thể xóa' : escapeHtml(item.block_reason || 'Không thể xóa');
          var label = [item.ma_nhap_vat_chua, item.doi_tuong_ten].filter(Boolean).join(' - ');
          return '<li><span><strong>' + escapeHtml(label || item.nhap_vat_chua_id) + '</strong><br>Số lượng: ' + fmt(item.tong_so_luong || 0) + ' · Tổng tiền: ' + fmtMoney(item.tong_tien || 0) + '</span><b>' + status + '</b></li>';
        }).join('') + '</ul>';
        if (groups.length) {
          html += '<ul class="vc-trash-groups">' + groups.map(function(group) {
            var samples = Array.isArray(group.samples) && group.samples.length ? ' (' + escapeHtml(group.samples.join(', ')) + ')' : '';
            return '<li>' + escapeHtml(group.label || 'Dữ liệu liên quan') + ': <strong>' + fmt(group.count || 0) + '</strong>' + samples + '</li>';
          }).join('') + '</ul>';
        } else {
          html += '<p class="vc-trash-desc">Không có phiếu chi bị kéo theo.</p>';
        }
        vcImportTrashBody.innerHTML = html;
      }
      async function openVcImportTrashModal(id) {
        if (!vcImportTrashOverlay || !vcImportTrashBody || !id) return;
        vcImportTrashIds = [id];
        vcImportTrashPreview = null;
        if (vcImportTrashConfirm) vcImportTrashConfirm.disabled = true;
        vcImportTrashBody.innerHTML = '<p class="vc-trash-loading">Đang kiểm tra dữ liệu liên quan...</p>';
        vcImportTrashOverlay.classList.add('is-visible');
        try {
          var res = await fetch('/vat-chua/nhap/trash/preview', {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
            body: JSON.stringify({ nhap_vat_chua_ids: vcImportTrashIds })
          });
          var json = await res.json();
          if (!res.ok || !json || !json.success) throw new Error((json && json.message) || 'Không kiểm tra được dữ liệu liên quan.');
          vcImportTrashPreview = json.data;
          renderVcImportTrashPreview(vcImportTrashPreview);
        } catch (error) {
          vcImportTrashBody.innerHTML = '<div class="vc-trash-alert is-error">' + escapeHtml(error && error.message ? error.message : 'Không kiểm tra được dữ liệu liên quan.') + '</div>';
        }
      }
      async function confirmVcImportTrash() {
        if (!vcImportTrashPreview || !vcImportTrashPreview.can_proceed || !vcImportTrashIds.length || !vcImportTrashConfirm) return;
        vcImportTrashConfirm.disabled = true;
        try {
          var res = await fetch('/vat-chua/nhap/trash/move', {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
            body: JSON.stringify({ nhap_vat_chua_ids: vcImportTrashIds })
          });
          var json = await res.json();
          if (!res.ok || !json || !json.success) throw new Error((json && json.message) || 'Không đưa được phiếu nhập vật chứa vào thùng rác.');
          window.location.href = '/vat-chua?success=import_deleted';
        } catch (error) {
          vcImportTrashBody.innerHTML = '<div class="vc-trash-alert is-error">' + escapeHtml(error && error.message ? error.message : 'Không đưa được phiếu nhập vật chứa vào thùng rác.') + '</div>';
          vcImportTrashConfirm.disabled = false;
        }
      }
      function closeVcDocActionMenus(exceptMenu) {
        document.querySelectorAll('.vc-doc-action-menu.is-open').forEach(function(menu) {
          if (exceptMenu && menu === exceptMenu) return;
          menu.classList.remove('is-open');
          var toggle = menu.querySelector('[data-vc-doc-menu-toggle]');
          if (toggle) toggle.setAttribute('aria-expanded', 'false');
        });
      }
      function positionVcDocActionMenu(menu) {
        if (!menu) return;
        var toggle = menu.querySelector('[data-vc-doc-menu-toggle]');
        var dropdown = menu.querySelector('.vc-doc-action-dropdown');
        if (!toggle || !dropdown) return;
        var rect = toggle.getBoundingClientRect();
        var width = dropdown.offsetWidth || 160;
        var height = dropdown.offsetHeight || 120;
        var left = Math.min(window.innerWidth - width - 8, Math.max(8, rect.right - width));
        var top = rect.bottom + 4;
        if (top + height > window.innerHeight - 8) top = Math.max(8, rect.top - height - 4);
        dropdown.style.left = left + 'px';
        dropdown.style.top = top + 'px';
      }
      async function returnVcImport(btn) {
        if (!btn) return;
        var id = btn.getAttribute('data-vc-import-id') || '';
        var vatChuaId = btn.getAttribute('data-vc-id') || '';
        var maxQty = Math.max(0, Number(btn.getAttribute('data-vc-import-qty') || 0));
        var answer = window.prompt('Nhập số lượng vật chứa cần trả', maxQty ? String(maxQty) : '');
        if (answer == null) return;
        var qty = Math.max(0, Math.floor(Number(String(answer).replace(/\./g, '').replace(/,/g, '').replace(/[^\d]/g, '').trim()) || 0));
        if (!id || !vatChuaId || qty <= 0) {
          alert('Vui lòng nhập số lượng trả hợp lệ.');
          return;
        }
        try {
          var res = await fetch('/vat-chua/nhap/' + encodeURIComponent(id) + '/return', {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
            body: JSON.stringify({ vat_chua_id: vatChuaId, so_luong: qty })
          });
          var json = await res.json();
          if (!res.ok || !json || !json.success) throw new Error((json && json.message) || 'Không trả được vật chứa.');
          window.location.href = '/vat-chua?nhap_vat_chua=' + encodeURIComponent(id) + '&success=returned';
        } catch (error) {
          alert(error && error.message ? error.message : 'Không trả được vật chứa.');
        }
      }

      async function openReturnImportModal(btn) {
        if (!returnImportOverlay || !btn) return;
        var id = btn.getAttribute('data-vc-import-id') || '';
        var vatChuaId = btn.getAttribute('data-vc-id') || '';
        if (!id || !vatChuaId) return;
        await ensureReturnCashBooks();
        returnImportMode = 'create';
        returnEditSourceId = id;
        if (vcImportReturnModalTitle) vcImportReturnModalTitle.textContent = 'Trả vật chứa';
        showReturnImportError('');
        if (returnImportId) returnImportId.value = id;
        if (returnVatChuaId) returnVatChuaId.value = vatChuaId;
        if (returnImportCode) returnImportCode.textContent = 'Phiếu nhập ' + (btn.getAttribute('data-vc-import-code') || '');
        if (returnImportQty) returnImportQty.value = Math.max(1, Math.floor(Number(btn.getAttribute('data-vc-import-qty') || 1) || 1));
        if (returnImportPrice) returnImportPrice.value = fmt(Math.max(0, Number(btn.getAttribute('data-vc-import-price') || 0)));
        if (returnImportCash) returnImportCash.value = '0';
        if (returnImportTransfer) returnImportTransfer.value = '0';
        renderReturnImportSummary();
        returnImportOverlay.classList.add('is-visible');
      }
      async function openReturnEditModal(id) {
        if (!returnImportOverlay || !id) return;
        await ensureReturnCashBooks();
        returnImportMode = 'edit';
        returnEditSourceId = '';
        showReturnImportError('');
        if (returnImportSave) returnImportSave.disabled = true;
        if (vcImportReturnModalTitle) vcImportReturnModalTitle.textContent = 'Chỉnh sửa trả vật chứa';
        returnImportOverlay.classList.add('is-visible');
        try {
          var res = await fetch('/vat-chua/xuat/' + encodeURIComponent(id) + '/edit', {
            credentials: 'same-origin',
            headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' }
          });
          var json = await res.json();
          if (!res.ok || !json || !json.success) throw new Error((json && json.message) || 'Không tải được phiếu trả vật chứa.');
          var data = json.data || {};
          returnEditSourceId = data.source_id || '';
          if (returnImportId) returnImportId.value = data._id || id;
          if (returnVatChuaId) returnVatChuaId.value = data.vat_chua_id || '';
          if (returnImportCode) returnImportCode.textContent = 'Phiếu trả ' + (data.ma_xuat_vat_chua || '');
          if (returnImportQty) returnImportQty.value = Math.max(1, Math.floor(Number(data.so_luong || 1) || 1));
          if (returnImportPrice) returnImportPrice.value = fmt(Math.max(0, Number(data.gia_tra || 0)));
          var payment = data.payment || {};
          if (returnImportCash) returnImportCash.value = fmt(payment.tien_mat || 0);
          if (returnImportTransfer) returnImportTransfer.value = fmt(payment.chuyen_khoan || 0);
          if (returnImportCashBook) returnImportCashBook.value = payment.so_quy_tien_mat_id || '';
          if (returnImportBankBook) returnImportBankBook.value = payment.so_quy_chuyen_khoan_id || '';
          renderReturnImportSummary();
          if (returnImportSave) returnImportSave.disabled = false;
        } catch (error) {
          showReturnImportError(error && error.message ? error.message : 'Không tải được phiếu trả vật chứa.');
          if (returnImportSave) returnImportSave.disabled = false;
        }
      }
      async function deleteReturnVatChua(btn) {
        if (!btn) return;
        var id = String(btn.getAttribute('data-vc-return-id') || '').trim();
        var code = String(btn.getAttribute('data-vc-return-code') || '').trim();
        if (!id) return;
        if (!window.confirm('Xóa phiếu trả vật chứa ' + (code || '') + '? Tồn kho sẽ được hoàn lại và phiếu thu liên quan sẽ bị hủy.')) return;
        try {
          var res = await fetch('/vat-chua/xuat/' + encodeURIComponent(id) + '/delete', {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
            body: JSON.stringify({})
          });
          var json = await res.json();
          if (!res.ok || !json || !json.success) throw new Error((json && json.message) || 'Không xóa được phiếu trả vật chứa.');
          window.location.href = '/vat-chua?success=returned';
        } catch (error) {
          alert(error && error.message ? error.message : 'Không xóa được phiếu trả vật chứa.');
        }
      }
      function validateReturnImport() {
        showReturnImportError('');
        var total = getReturnImportTotal();
        var qty = Math.max(0, Math.floor(Number(returnImportQty ? returnImportQty.value : 0) || 0));
        var price = numeric(returnImportPrice ? returnImportPrice.value : 0);
        var tienMat = numeric(returnImportCash ? returnImportCash.value : 0);
        var chuyenKhoan = numeric(returnImportTransfer ? returnImportTransfer.value : 0);
        var received = tienMat + chuyenKhoan;
        if (qty <= 0) {
          showReturnImportError('Vui lòng nhập số lượng trả hợp lệ.');
          if (returnImportQty) returnImportQty.focus();
          return false;
        }
        if (price <= 0 || total <= 0) {
          showReturnImportError('Vui lòng nhập giá trả hợp lệ.');
          if (returnImportPrice) returnImportPrice.focus();
          return false;
        }
        if (received > total) {
          showReturnImportError('Số tiền thu không được vượt tổng giá trị trả.');
          if (returnImportTransfer && chuyenKhoan > 0) returnImportTransfer.focus();
          else if (returnImportCash) returnImportCash.focus();
          return false;
        }
        if (tienMat > 0 && !String(returnImportCashBook ? returnImportCashBook.value : '').trim()) {
          showReturnImportError('Vui lòng chọn sổ tiền mặt.');
          if (returnImportCashBook) returnImportCashBook.focus();
          return false;
        }
        if (chuyenKhoan > 0 && !String(returnImportBankBook ? returnImportBankBook.value : '').trim()) {
          showReturnImportError('Vui lòng chọn tài khoản chuyển khoản.');
          if (returnImportBankBook) returnImportBankBook.focus();
          return false;
        }
        return true;
      }
      async function submitReturnImport() {
        renderReturnImportSummary();
        if (!validateReturnImport()) return;
        var id = String(returnImportId ? returnImportId.value : '').trim();
        var vatChuaId = String(returnVatChuaId ? returnVatChuaId.value : '').trim();
        if (!id || !vatChuaId) return;
        if (returnImportSave) returnImportSave.disabled = true;
        try {
          var endpoint = returnImportMode === 'edit'
            ? '/vat-chua/xuat/' + encodeURIComponent(id) + '/edit'
            : '/vat-chua/nhap/' + encodeURIComponent(id) + '/return';
          var res = await fetch(endpoint, {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
            body: JSON.stringify({
              vat_chua_id: vatChuaId,
              so_luong: returnImportQty ? returnImportQty.value : '',
              gia_tra: numeric(returnImportPrice ? returnImportPrice.value : 0),
              payment_v2: '1',
              chi_tiet_thanh_toan: {
                tien_mat: numeric(returnImportCash ? returnImportCash.value : 0),
                so_quy_tien_mat_id: returnImportCashBook ? returnImportCashBook.value : '',
                chuyen_khoan: numeric(returnImportTransfer ? returnImportTransfer.value : 0),
                so_quy_chuyen_khoan_id: returnImportBankBook ? returnImportBankBook.value : '',
                tien_tra_khach: 0
              }
            })
          });
          var json = await res.json();
          if (!res.ok || !json || !json.success) throw new Error((json && json.message) || 'Không trả được vật chứa.');
          var focusId = returnImportMode === 'edit' ? (returnEditSourceId || '') : id;
          window.location.href = '/vat-chua' + (focusId ? ('?nhap_vat_chua=' + encodeURIComponent(focusId) + '&') : '?') + 'success=returned';
        } catch (error) {
          showReturnImportError(error && error.message ? error.message : 'Không trả được vật chứa.');
          if (returnImportSave) returnImportSave.disabled = false;
        }
      }

      document.addEventListener('click', function(e) {
        var menuToggle = e.target.closest('[data-vc-doc-menu-toggle]');
        if (menuToggle) {
          e.preventDefault();
          var menu = menuToggle.closest('.vc-doc-action-menu');
          var willOpen = menu && !menu.classList.contains('is-open');
          closeVcDocActionMenus(menu);
          if (menu && willOpen) {
            menu.classList.add('is-open');
            menuToggle.setAttribute('aria-expanded', 'true');
            positionVcDocActionMenu(menu);
          }
          return;
        }
        var editBtn = e.target.closest('[data-vc-import-edit]');
        if (editBtn) {
          e.preventDefault();
          closeVcDocActionMenus();
          openEditImportModal(editBtn.getAttribute('data-vc-import-id'));
          return;
        }
        var trashBtn = e.target.closest('[data-vc-import-trash]');
        if (trashBtn) {
          e.preventDefault();
          closeVcDocActionMenus();
          openVcImportTrashModal(trashBtn.getAttribute('data-vc-import-id'));
          return;
        }
        var returnBtn = e.target.closest('[data-vc-import-return]');
        if (returnBtn) {
          e.preventDefault();
          closeVcDocActionMenus();
          openReturnImportModal(returnBtn);
          return;
        }
        var returnEditBtn = e.target.closest('[data-vc-return-edit]');
        if (returnEditBtn) {
          e.preventDefault();
          closeVcDocActionMenus();
          openReturnEditModal(returnEditBtn.getAttribute('data-vc-return-id'));
          return;
        }
        var returnDeleteBtn = e.target.closest('[data-vc-return-delete]');
        if (returnDeleteBtn) {
          e.preventDefault();
          closeVcDocActionMenus();
          deleteReturnVatChua(returnDeleteBtn);
          return;
        }
        var openBtn = e.target.closest('[data-vc-doc-open]');
        if (openBtn) {
          e.preventDefault();
          closeVcDocActionMenus();
          openVcDocumentModal(openBtn.getAttribute('data-vc-doc-kind'), openBtn.getAttribute('data-vc-doc-id'));
          return;
        }
        closeVcDocActionMenus();
        if (vcDocumentOverlay && e.target === vcDocumentOverlay) closeVcDocumentModal();
        if (editImportOverlay && e.target === editImportOverlay) closeEditImportModal();
        if (returnImportOverlay && e.target === returnImportOverlay) closeReturnImportModal();
        if (vcImportTrashOverlay && e.target === vcImportTrashOverlay) closeVcImportTrashModal();
      });
      if (vcDocumentClose) vcDocumentClose.addEventListener('click', closeVcDocumentModal);
      if (vcImportTrashClose) vcImportTrashClose.addEventListener('click', closeVcImportTrashModal);
      if (vcImportTrashCancel) vcImportTrashCancel.addEventListener('click', closeVcImportTrashModal);
      if (vcImportTrashConfirm) vcImportTrashConfirm.addEventListener('click', confirmVcImportTrash);
      window.addEventListener('resize', function() { closeVcDocActionMenus(); });
      window.addEventListener('scroll', function() { closeVcDocActionMenus(); }, true);
    });
  </script>
</body>
</html>
