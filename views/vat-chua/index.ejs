        });
        var json = await response.json();
        if (!json || !json.success) throw new Error((json && json.message) || 'Không tải được danh sách sổ quỹ.');
        return (Array.isArray(json.items) ? json.items : [])
          .filter(function(book) { return String(book.trang_thai || 'active') === 'active'; })
          .map(function(book) { return Object.assign({}, book, { _id: String(book._id || '') }); })
          .filter(function(book) { return book._id; });
      }
