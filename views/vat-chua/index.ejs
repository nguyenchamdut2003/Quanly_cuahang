        var source = checked.length
          ? checked.map(function(cb) { return cb.closest('[data-vc-row]'); })
          : Array.prototype.slice.call(document.querySelectorAll('[data-vc-row]'));
        return source.filter(function(row) {
          return row && row.dataset.vcActive === '1';
        }).map(function(row) {
          return {
            id: row.dataset.vcId || '',
            code: row.dataset.vcCode || '',
            name: row.dataset.vcName || '',
            stock: Math.max(0, Number(row.dataset.vcStock || 0)),
            cost: Math.max(0, Number(row.dataset.vcCost || 0))
          };
        });
      }
